// Vista CadenaSegura del payload primario (slot1) del nodo de salida.
// El puntero es PRESTADO (apunta a la arena _TR_* o al buffer de la
// fuente _SQ_*); no liberar.
funcion trad_texto(i: entero) -> texto:
    requiere:
        i >= 0
    garantiza:
        verdadero
    inseguro:
        let s: texto = ""
        asm("struct NodoAST* _o = (struct NodoAST*)trad_nodos(); int* _h = (int*)trad_hi(); if (i < 65536 && _o[i].len_str > 0) { uintptr_t _p = ((uintptr_t)(unsigned)_h[i] << 32) | (unsigned)_o[i].ptr_str; CadenaSegura _cs; _cs.longitud = _o[i].len_str; _cs.datos = (char*)_p; s = _cs; }")
        retornar s
    retornar ""

// ---- Allocación en la salida ----
funcion trad_nuevo(tipo: entero, linea: entero, col: entero) -> entero:
    requiere:
        tipo > 0
    garantiza:
        _resultado_ >= -1
    inseguro:
        i = -1
        asm("int* _tc = (int*)trad_meta(); struct NodoAST* _tn = (struct NodoAST*)trad_nodos(); if (*_tc < 65536) { i = *_tc; memset(&_tn[i], 0, sizeof(struct NodoAST)); _tn[i].tipo_nodo = tipo; _tn[i].linea = linea; _tn[i].columna = col; *_tc = i + 1; } else { i = -1; }")
        retornar i
    retornar -1

// Copia payload escalar + hi + spans slot2 del nodo fuente al destino.
funcion trad_copiar_payload(src: entero, dst: entero) -> nulo:
    requiere:
        src >= 0
    garantiza:
        verdadero
    inseguro:
        asm("struct NodoAST* _in = (struct NodoAST*)parser_nodos(); struct NodoAST* _out = (struct NodoAST*)trad_nodos(); int _tot = *((int*)parser_meta()); if (src < _tot && dst >= 0 && dst < 65536) { _out[dst].valor_int = _in[src].valor_int; _out[dst].valor_dec = _in[src].valor_dec; _out[dst].ptr_str = _in[src].ptr_str; _out[dst].len_str = _in[src].len_str; _out[dst].ptr_extra = _in[src].ptr_extra; int* _ih = (int*)sq_tokens_hi(); int* _oh = (int*)trad_hi(); if (_ih && _oh) { _oh[dst] = _ih[src]; } int* _sp = (int*)parser_str2_ptr(); int* _sh = (int*)parser_str2_hi(); int* _sl = (int*)parser_str2_len(); int* _dp = (int*)trad_s2p(); int* _dh = (int*)trad_s2h(); int* _dl = (int*)trad_s2l(); if (_sp && _dp) { _dp[dst] = _sp[src]; } if (_sh && _dh) { _dh[dst] = _sh[src]; } if (_sl && _dl) { _dl[dst] = _sl[src]; } }")

// ---- Marcado de ownership (F4: Manual 4 §3.1/§4.3/§5.2) ----
// Lee el span de tipo (slot2) del nodo de salida y marca valor_int con los
// bits de ownership: bit0=rc, bit1=arc, bit2=débil. Solo aplica a
// NODO_LET / NODO_DECLARACION / NODO_PARAMETRO (los que llevan tipo).
// Esto alimenta a _a_analizar_bloque (memory.c) y a analizar_ciclos
// (analizador_alcance.syq), que dependen de estos bits (F4 cierra la
// conexion frontend<->analizador).
funcion trad_set_ownership(n: entero) -> nulo:
    requiere:
        n >= 0
    garantiza:
        verdadero
    inseguro:
        asm("{ int _nt = -1; { struct NodoAST* _on = (struct NodoAST*)trad_nodos(); if (_on && n >= 0 && n < 65536) _nt = _on[n].tipo_nodo; } if (_nt == NODO_LET || _nt == NODO_DECLARACION || _nt == NODO_PARAMETRO) { int* _s2p = (int*)trad_s2p(); int* _s2h = (int*)trad_s2h(); int* _s2l = (int*)trad_s2l(); if (_s2p && _s2h && _s2l && n >= 0 && n < 65536) { uintptr_t _p = ((uintptr_t)(unsigned)_s2h[n] << 32) | (unsigned)_s2p[n]; int _len = _s2l[n]; struct NodoAST* _on = (struct NodoAST*)trad_nodos(); int _bits = 0; if (_len >= 2) { char _c0 = ((char*)_p)[0]; char _c1 = ((char*)_p)[1]; if (_c0 == 114 && _c1 == 99) { _bits |= 1; } else if (_c0 == 97 && _c1 == 114) { if (_len >= 3 && ((char*)_p)[2] == 99) _bits |= 2; } else if (_c0 == 100) { if (_len >= 5 && ((char*)_p)[2] == 98) _bits |= 4; if (_len >= 6 && ((char*)_p)[3] == 98) _bits |= 4; } } _on[n].valor_int |= _bits; } } }")
    retornar

// ---- Arena de cadenas (nombres decorados y spans reconstruidos) ----
funcion trad_arena_escribir(lo: entero, hi_bits: entero, len: entero) -> entero:
    requiere:
        len >= 0
    garantiza:
        _resultado_ >= -1
    inseguro:
        off = -1
        asm("char* _ar = (char*)trad_arena(); int* _au = (int*)trad_arena_usada(); uintptr_t _src = ((uintptr_t)(unsigned)hi_bits << 32) | (unsigned)lo; if (len >= 0 && *_au + len < 262144) { memcpy(_ar + *_au, (const void*)_src, (size_t)len); off = *_au; *_au += len; }")
        retornar off
    retornar -1

funcion trad_arena_byte(b: entero) -> entero:
    requiere:
        b >= 0
    garantiza:
        _resultado_ >= -1
    inseguro:
        off = -1
        asm("char* _ar = (char*)trad_arena(); int* _au = (int*)trad_arena_usada(); if (*_au + 1 < 262144) { _ar[*_au] = (char)b; off = *_au; *_au += 1; }")
        retornar off
    retornar -1

// Escribe en el nodo dst el nombre (off,len) de la arena (slot1 + hi).
funcion trad_fijar_nombre_arena(dst: entero, off: entero, len: entero) -> nulo:
    requiere:
        dst >= 0
    garantiza:
        verdadero
    inseguro:
        asm("if (dst >= 0 && dst < 65536 && off >= 0) { struct NodoAST* _o = (struct NodoAST*)trad_nodos(); char* _ar = (char*)trad_arena(); uintptr_t _p = (uintptr_t)(_ar + off); _o[dst].ptr_str = (int)(_p & 0xFFFFFFFFu); _o[dst].len_str = len; int* _th = (int*)trad_hi(); if (_th) { _th[dst] = (int)(_p >> 32); } }")

// ---- Accessores de ENTRADA (árbol Syquex de sq_programa) ----
funcion tr_lo(n: entero) -> entero:
    inseguro:
        r = 0
        asm("struct NodoAST* _in = (struct NodoAST*)parser_nodos(); if (n >= 0 && n < 65536) r = _in[n].ptr_str;")
        retornar r
    retornar 0

funcion tr_hi(n: entero) -> entero:
    inseguro:
        r = 0
        asm("int* _ih = (int*)sq_tokens_hi(); if (_ih && n >= 0 && n < 65536) r = _ih[n];")
        retornar r
    retornar 0

