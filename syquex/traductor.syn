// cumple Manual 1 5: nucleo del compilador Synapse
#lang: es

// ============================================================
// syquex/traductor.syn — Traductor Syquex -> SemNodo[] (R88)
// Manual 6 §1.3 ("El traductor convierte el AST de Syquex en
// SemNodo[]; biyectiva en cuanto a semántica") y Manual 3 §11.1
// (mapeo de nodos clave) / §11.2 (preservación de metadatos
// archivo/línea/columna). DECISIÓN D-F22-A: escrito en Synapse.
//
// ENTRADA: NodoAST[] plano producido por sq_programa() (parser R87,
// buffers parser_nodos()/sq_tokens_hi()/parser_str2_*).
// SALIDA: SemNodo[] canónico ABI v1 (R85, nucleo/ast_abi.syn) en
// buffers propios _TR_*; PROGRAMA reservado en el índice 0 (contrato
// del puente puente_construir_programa, que lee _an[0].hijo_izq).
//
// Transformaciones (M6 §1.3 L103-117):
//   - MetodoDef -> NODO_FUNCION hoistada con nombre "Struct_metodo"
//     y self como primer parámetro (el self lo antepone el parser);
//     ConstructorDef -> NODO_FUNCION "__init__" hoistada (L107-108).
//     Orden en la salida: métodos ANTES de su estructura (algoritmo
//     §1.3 L146-150); la ESTRUCTURA conserva SOLO campos PARAMETRO.
//   - NODO_BLOQUE_SQ(58, extensión D-F22-C) se desenrolla en todas
//     las posiciones de cuerpo: forma canónica = cadena de sentencias
//     enlazada por hermano (paridad parser Synapse R22).
//   - CASO de coincidir: patrón reconstruido como SPAN slot1
//     ("ctor(var)", "_", literal — paridad parsear_coincidir R11/R22)
//     y cuerpo como cadena en hijo_izq.
//   - Contratos: la cadena Syquex (un CONTRATO por bloque con
//     valor_int=clase T_REQUIERE/T_GARANTIZA) se FUSIONA en un único
//     CONTRATO canónico (hijo_izq=requiere, hijo_der=garantiza,
//     valor_int=cuenta_req; paridad parsear_contratos del parser
//     Synapse, parser.syn L294-300).
//   - Metadatos: linea/columna copiados nodo a nodo (M3 §11.2); los
//     payloads de cadena apuntan al buffer estable de la fuente.
//
// Extensiones ABI D-F22-C preservadas aditivamente (54 INTENTO,
// 55 LISTA_LIT, 56 MAPA_LIT, 57 PARA_EN): sus CUERPOS se desenrollan;
// el cableado backend es alcance R89.
//
// Códigos de retorno negativos (funciones de traducción):
//   -1 desborde de nodos · -2 desborde de arena · -3 límite de guardas
//   -4 patrón/estructura inválida
// ============================================================

importar parser_constantes
importar parser_base
importar lexer

// ---- Buffers de salida (SemNodo[] canónico) ----
funcion trad_nodos() -> puntero:
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        let r: puntero = nulo
        asm("static struct NodoAST _TR_out[65536];")
        asm("r = (void*)_TR_out;")
        retornar r

funcion trad_hi() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_hi[65536];")
        asm("r = (void*)_TR_hi;")
        retornar r

funcion trad_s2p() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_s2p[65536];")
        asm("r = (void*)_TR_s2p;")
        retornar r

funcion trad_s2h() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_s2h[65536];")
        asm("r = (void*)_TR_s2h;")
        retornar r

funcion trad_s2l() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_s2l[65536];")
        asm("r = (void*)_TR_s2l;")
        retornar r

funcion trad_meta() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_total = 0;")
        asm("r = (void*)&_TR_total;")
        retornar r

funcion trad_arena() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static char _TR_arena[262144];")
        asm("r = (void*)_TR_arena;")
        retornar r

funcion trad_arena_usada() -> puntero:
    inseguro:
        let r: puntero = nulo
        asm("static int _TR_ausada = 0;")
        asm("r = (void*)&_TR_ausada;")
        retornar r

// ---- Accessores de salida ----
funcion trad_reset() -> nulo:
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        asm("*((int*)trad_meta()) = 0;")
        asm("*((int*)trad_arena_usada()) = 0;")

funcion trad_obtener_total() -> entero:
    requiere:
        verdadero
    garantiza:
        _resultado_ >= 0
    inseguro:
        r = 0
        asm("r = *((int*)trad_meta());")
        retornar r

funcion trad_nodo_tipo(i: entero) -> entero:
    requiere:
        i >= 0
    garantiza:
        verdadero
    inseguro:
        r = 0
        asm("struct NodoAST* _n = (struct NodoAST*)trad_nodos(); if (_n && i < 65536) r = _n[i].tipo_nodo;")
        retornar r

funcion trad_nodo_linea(i: entero) -> entero:
    requiere:
        i >= 0
    garantiza:
        verdadero
    inseguro:
        r = 0
        asm("struct NodoAST* _n = (struct NodoAST*)trad_nodos(); if (_n && i < 65536) r = _n[i].linea;")
        retornar r
    retornar 0

