#lang: es

// ============================================================
// syquex/syq_main.syn — Entrada CLI del frontend Syquex (R90)
// Manual 1 §3.1/§8: el .syq se compila con frontend propio y
// continúa por el backend compartido. Este ejecutable recibe:
//   syq_frontend.exe <fuente.syq>
// y emite a stdout el JSON plano del SemNodo[] canónico
// (esquema en syq_json.syn). Código de salida: 0 OK; negativo
// según la cabecera del traductor; -10 sin argumentos;
// -11 fuente ilegible. El puente Python valida rc antes de
// parsear stdout.
// ============================================================

importar parser_constantes
importar parser_base
importar lexer
importar traductor
importar syq_json

// Longitud de una cadena (el campo .longitud solo se lee desde asm).
funcion sj_long_cadena(t: cadena) -> entero:
    requiere:
        verdadero
    garantiza:
        _resultado_ >= 0
    inseguro:
        r = 0
        asm("r = (t.datos != 0) ? t.longitud : 0;")
        retornar r
    retornar 0

// Copia del patrón argv_str de nucleo/principal.syn (builtin _argv).
funcion sm_argv(i: entero) -> cadena:
    requiere:
        i >= 0
    garantiza:
        verdadero
    inseguro:
        let r: cadena = ""
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; } else { r = _argv(i); }")
        retornar r
    retornar ""

// Lee TODO el archivo a un buffer estático (1 MB) — el builtin
// leer_archivo no tiene declaración visible en este harness.
funcion sm_leer_archivo(ruta: cadena) -> cadena:
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        let r: cadena = ""
        asm("{ static char _sm_buf[1048576]; FILE* _sm_f = fopen(ruta.datos, \"rb\"); if (_sm_f) { size_t _sm_n = fread(_sm_buf, 1, sizeof(_sm_buf), _sm_f); fclose(_sm_f); r = (CadenaSegura){(int)_sm_n, _sm_buf}; } else { r = (CadenaSegura){0,(char*)\"\"}; } }")
        retornar r
    retornar ""

funcion principal() -> entero:
    requiere:
        verdadero
    garantiza:
        _resultado_ <= 0
    inseguro:
        si _argc() < 2:
            escribir_linea("SYQ_JSON_ERROR=-10")
            retornar -10
    ruta = sm_argv(1)
    fuente = sm_leer_archivo(ruta)
    si sj_long_cadena(fuente) <= 0:
        escribir_linea("SYQ_JSON_ERROR=-11")
        retornar -11
    prog = sq_programa(fuente)
    si prog < 0:
        escribir_linea(concat("SYQ_JSON_ERROR=", entero_a_texto(prog)))
        retornar prog
    r = traducir_programa(prog)
    si r < 0:
        escribir_linea(concat("SYQ_JSON_ERROR=", entero_a_texto(r)))
        retornar r
    j = syq_json_emitir(r)
    si j < 0:
        retornar j
    retornar 0
