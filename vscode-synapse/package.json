{
    "name": "synapse",
    "displayName": "Synapse Language",
    "description": "Synapse language support for VS Code — LSP nativo + IA local. CERO telemetría, 100% privacidad.",
    "version": "5.1.1-industrial",
    "publisher": "synapse-lang",
    "license": "MIT",
    "engines": {
        "vscode": "^1.60.0"
    },
    "categories": [
        "Programming Languages",
        "Snippets",
        "Linters",
        "Formatters"
    ],
    "activationEvents": [
        "onLanguage:synapse"
    ],
    "main": "./extension.js",
    "dependencies": {
        "vscode-languageclient": "^8.0.0"
    },
    "__metadata": {
        "privacy": {
            "telemetry": "NONE",
            "policy": "Zero Telemetry — No data is collected, transmitted, or stored externally. All processing happens 100% locally on the user's machine.",
            "ai": {
                "opt_in": true,
                "local_only": true,
                "hardware_gated": true
            }
        }
    },
    "contributes": {
        "languages": [
            {
                "id": "synapse",
                "extensions": [".syn"],
                "aliases": ["Synapse"]
            }
        ],
        "grammars": [
            {
                "language": "synapse",
                "scopeName": "source.synapse",
                "path": "./syntaxes/synapse.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "synapse",
                "path": "./snippets/synapse.code-snippets"
            }
        ],
        "commands": [
            {
                "command": "synapse.aiStatus",
                "title": "Synapse: Verificar estado de IA local"
            },
            {
                "command": "synapse.aiExplain",
                "title": "Synapse: Explicar código con IA local"
            },
            {
                "command": "synapse.aiComplete",
                "title": "Synapse: Generar código con IA local"
            }
        ],
        "configuration": {
            "title": "Synapse",
            "properties": {
                "synapse.lsp.nativeBinary": {
                    "type": "string",
                    "default": "",
                    "description": "Ruta al binario LSP nativo de Synapse. Si está vacío, busca automáticamente en instalación, PATH y workspace."
                },
                "synapse.lsp.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Habilitar/deshabilitar el servidor LSP de Synapse"
                },
                "synapse.ai.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Habilitar funciones de IA local (Hardware-gated: se desactiva automáticamente si RAM < 8GB)"
                },
                "synapse.trace.server": {
                    "type": "string",
                    "enum": ["off", "messages", "verbose"],
                    "default": "off",
                    "description": "Traza la comunicación entre VS Code y el servidor LSP de Synapse"
                }
            }
        }
    }
}
