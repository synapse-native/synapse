#lang: es
// e2e_concurrencia.syn - Prueba de integracion de concurrencia bidireccional
// Lanza dos fibras que se comunican usando Canal<T>
// Verifica: ausencia de deadlocks, ownership strict, paso de mensajes correcto
// F4.4: usa la API NATIVA del lenguaje (Manual 5 S3): canal(T,N), <-, ->,
// cerrar_canal, lanzar (fibras M:N) - la API de std.concurrencia con externs
// inventados _syn_canal_* fue eliminada (regla 5/8, hallazgo d2 de R51).
// NOTA (hallazgo F4-6 de R51): el valor 0 es indistinguible del cierre en
// canales Canal<entero> (el boxeo (void*)(intptr_t)v hace 0 -> NULL, el
// mismo centinela del cierre) - se usan valores 1..3 a la espera del fix
// (receive como Resultado<T, Error>, Manual 5 S3.6).

importar std.io

funcion productor(ch: Canal<entero>, total: entero) -> nulo:
    i = 1
    mientras i <= total:
        v = i
        ch <- v
        i = i + 1
    cerrar_canal(ch)
    retornar

funcion consumidor(ch: Canal<entero>) -> nulo:
    escuchar ch:
        mensaje = ch ->
        si mensaje == nulo:
            romper
        escribir_linea(entero_a_texto(mensaje))
    retornar

funcion principal() -> nulo:
    ch = canal(entero, 10)
    lanzar productor(ch, 3)
    consumidor(ch)
    consumidor(ch)
    consumidor(ch)
    retornar
