#lang: es
// R90 corte 3 - fixture de compilacion e2e por el pipeline S1:
// ejercita SOLO constructos con backend compartido disponible
// (sin call-sites OOP: metodos/constructores quedan pendientes
// del lowering H-R90-5). Funciones libres + coincidir (H-R90-6
// sobre primitivos) + enum + constante + externo + export +
// si/mientras (sin para..en, que requiere lowering H-R90-5).
// Salida esperada al ejecutar:
//   cero
//   3
//   7

enumeracion Color:
    rojo
    verde

constante LIMITE = 10

@export(python) funcion visible(v: entero) -> entero:
    retornar v * 2

funcion clasifica(n: entero) -> entero:
    // H-R90-6 RESUELTO: coincidir sobre primitivos ahora tiene codegen
    // compartido (switch sobre valor directo, case literal).
    coincidir n:
        0 => escribir_linea("cero")
        _ => escribir_linea("otro")
    retornar n

funcion suma_hasta(lim: entero) -> entero:
    let acc = 0
    let i = 0
    mientras i < lim:
        acc = acc + i
        i = i + 1
    retornar acc

funcion principal() -> entero:
    let r = clasifica(0)
    let s = suma_hasta(4)
    escribir_linea(entero_a_texto(s))
    let v = visible(3)
    escribir_linea(entero_a_texto(v))
    si s < LIMITE:
        retornar 0
    retornar 1
