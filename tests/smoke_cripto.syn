#lang: es
importar std.cripto

funcion principal() -> nulo:
    hash = sha256_texto("hola")
    log("SHA-256 de hola: ", hash)
    si len(hash) == 64:
        log("sha256 longitud OK")
    sino:
        log("FALLO sha256 longitud")
    si hash == "b221d9dbb083a7f33428d7c2a3c3198ae925614d70210e28716ccaa7cd4ddb79":
        log("sha256 valor OK")
    sino:
        log("FALLO sha256 valor: ", hash)
    log("FIN")
