#lang: es

// M21.5: Test fixture for ERR_MEM_LIFETIME_MISMATCH
// NOTA: La deteccion completa via pipeline .syn requiere que
// ExprObtenerDireccion genere lifetimes con ambito real (no hardcoded).
// Por ahora, la validacion se hace via tests/test_lifetimes.py (Python unit).

funcion test_prestamo_invalido() -> entero:
    r = 0
    si verdadero:
        x = 42
        r = &x  # x vive en scope interior, prestamo asignado a scope exterior
    retornar *r
