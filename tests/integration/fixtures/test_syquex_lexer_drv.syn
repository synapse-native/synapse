#lang: es
// R86 — driver de verificación del lexer Syquex (se CONCATENA con
// syquex/lexer.syn por tests/unit/test_syquex_lexer.py).
// Tokeniza la muestra M3 (OOP + intentar/atrapar + rango/paso + lista/mapa
// + \uXXXX + exponente) y emite "NOMBRE|linea|lexema" por token.

funcion nombre_token(t: entero) -> cadena:
    si t == T_METODO:
        retornar "METODO"
    si t == T_CREAR:
        retornar "CREAR"
    si t == T_INTENTAR:
        retornar "INTENTAR"
    si t == T_ATRAPAR:
        retornar "ATRAPAR"
    si t == T_LISTA:
        retornar "LISTA"
    si t == T_MAPA:
        retornar "MAPA"
    si t == T_ENUMERACION:
        retornar "ENUMERACION"
    si t == T_ARENA:
        retornar "ARENA"
    si t == T_EN:
        retornar "EN"
    si t == T_PASO:
        retornar "PASO"
    si t == T_PUNTOPUNTO:
        retornar "RANGO"
    si t == T_CORCH_IZQ:
        retornar "CORCH_IZQ"
    si t == T_CORCH_DER:
        retornar "CORCH_DER"
    si t == T_LLAVE_IZQ:
        retornar "LLAVE_IZQ"
    si t == T_LLAVE_DER:
        retornar "LLAVE_DER"
    si t == T_IDENTIFICADOR:
        retornar "ID"
    si t == T_NUMERO:
        retornar "NUM"
    si t == T_FLOTANTE:
        retornar "FLOT"
    si t == T_CADENA:
        retornar "STR"
    si t == T_FUNCION:
        retornar "FUNCION"
    si t == T_ESTRUCTURA:
        retornar "ESTRUCTURA"
    si t == T_DEBIL:
        retornar "DEBIL"
    si t == T_INTERROGACION:
        retornar "Q"
    si t == T_NULO:
        retornar "NULO"
    si t == T_DOSPUNTOS:
        retornar "DOSPTOS"
    retornar "?"

funcion principal() -> entero:
    // M3 §6/§13: muestra representativa del lenguaje
    fuente = "#lang: es\nestructura Punto:\n    x: entero\n    crear(px: entero):\n        self.x = px\n    metodo desplazar(d: entero):\n        self.x = self.x + d\n\nenumeracion Color:\n    rojo\n    verde\n\nfuncion principal() -> entero:\n    let l = lista<entero>()\n    let m = mapa<texto, entero>()\n    para i = 0 .. 10 paso 2:\n        l.agregar(i * 2e1)\n    para v en l:\n        let z = v\n    intentar:\n        m[\"clave\"] = 7\n    atrapar e:\n        retornar 1\n    let s = \"A\\u00e9\\n\"\n    let w = débil<Punto>(nulo)\n    retornar 0\n"

    total = tokenizar_syquex(fuente)
    escribir_linea(concat("TOTAL=", entero_a_texto(total)))
    si total < 0:
        escribir_linea("LEX_ERROR")
        retornar 1

    i = 0
    mientras i < total:
        p1 = concat(nombre_token(sq_token_tipo(i)), "|")
        p2 = concat(p1, entero_a_texto(sq_token_linea(i)))
        p3 = concat(p2, "|")
        p4 = concat(p3, sq_token_lexema(i))
        escribir_linea(p4)
        i = i + 1
    escribir_linea("FIN_DUMP")
    retornar 0
