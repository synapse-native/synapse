#lang: es
// smoke_backend.syn — Test de integracion del Sysroot completo
// Prueba: HTTP + JSON + SHA-256 + Tiempo
//
// Compilar: synapse construir tests/smoke_backend.syn
// Ejecutar: ./smoke_backend
// Probar: curl http://localhost:8080/

importar std.http
importar std.json
importar std.tiempo
importar std.cripto

funcion principal() -> nulo:
    log("Iniciando servidor smoke_backend en puerto 8080...")
    fd_servidor = iniciar_servidor(8080)
    si fd_servidor < 0:
        log("ERROR: No se pudo iniciar el servidor")
        retornar

    log("Servidor listo. Presiona Ctrl+C para detener.")

    mientras verdadero:
        log("Esperando peticion...")
        fd_cliente = aceptar(fd_servidor)
        si fd_cliente < 0:
            dormir_ms(10)
            continuar

        peticion = leer_peticion(fd_cliente)
        si peticion == "":
            cerrar_cliente(fd_cliente)
            continuar

        inicio = ahora_ms()

        // Calcular SHA-256 de una cadena estatica
        hash = sha256_texto("Synapse v2.0 - Test de Integracion del Sysroot")
        fin_hash = ahora_ms()

        tiempo_ms = fin_hash - inicio

        // Construir JSON de respuesta
        cuerpo = "{"
        cuerpo = cuerpo + "\"status\": \"ok\""
        cuerpo = cuerpo + ", \"algoritmo\": \"SHA-256\""
        cuerpo = cuerpo + ", \"hash\": \"" + hash + "\""
        cuerpo = cuerpo + ", \"tiempo_hash_ms\": " + entero_a_texto(tiempo_ms)
        cuerpo = cuerpo + "}"

        responder(fd_cliente, 200, "application/json", cuerpo)
        log("Respuesta enviada: hash=", hash, " tiempo=", entero_a_texto(tiempo_ms), "ms")
