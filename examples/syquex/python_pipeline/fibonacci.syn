#lang: es

importar std.io

# examples/syquex/python_pipeline/fibonacci.py
# Script de ejemplo para el pipeline Python -> Syquex
# Calcula los primeros 10 números de Fibonacci

funcion fibonacci(n: entero) -> entero:
    si n <= 1:
        retornar n
    retornar fibonacci(n - 1) + fibonacci(n - 2)

funcion main() -> entero:
    escribir_linea("Fibonacci sequence:")
    para i = 0 mientras i < 10:
        result = fibonacci(i)
        escribir_linea(result)

        i = i + 1


funcion principal() -> entero:
    main()
    retornar 0