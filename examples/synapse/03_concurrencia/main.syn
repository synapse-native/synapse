#lang: es

funcion productor(ch: Canal<entero>) -> nulo:
    dato1 = 42
    ch <- dato1
    dato2 = 99
    ch <- dato2
    cerrar_canal(ch)

funcion consumidor(ch: Canal<entero>) -> nulo:
    escuchar ch:
        mensaje = ch ->
        si mensaje == nulo:
            romper
        escribir_linea(entero_a_texto(mensaje))

funcion principal() -> entero:
    ch = canal(entero, 5)
    lanzar consumidor(ch)
    lanzar productor(ch)
    retornar 0