#lang: es

funcion productor(ch: CanalConcurrencia*, n: entero) -> nulo:
    para i = 0; i < n; i = i + 1:
        canal_enviar(ch, i)
    cerrar_canal(ch)

funcion consumidor(ch: CanalConcurrencia*) -> nulo:
    escuchar ch -> recibido()

funcion recibido() -> nulo:
    nulo = 0

funcion principal() -> entero:
    ch: CanalConcurrencia* = canal_crear(5)
    lanzar consumidor(ch)
    canal_enviar(ch, 42)
    canal_enviar(ch, 99)
    cerrar_canal(ch)
    retornar 0