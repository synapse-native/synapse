# Synapse v5.1.1-industrial — .gitignore oficial
# =====================================================
# CLASE A: Secretos — NUNCA trackear
*.pem
*.hex
*.key
# La clave PÚBLICA de release sí es un artefacto de confianza del producto.
!release_keys/public.pem

# CLASE B: Binarios
*.exe
*.dll
*.so
*.dylib
*.wasm
*.gguf

# CLASE C: Objetos compilados
*.o
*.obj
*.lib
*.a

# CLASE C2: Artefactos de cobertura
.coverage
.coverage.*
htmlcov/

# CLASE D: C generado intermedio (no fuente)
synapse_unity.c
_*.c
_*.c.o
_*.h
*.syn.json
# C generado por el compilador Synapse a partir de .syn fuente (ej: lsp_v3.syn -> lsp_v3.c)
nucleo/lsp_v3.c
# Scratch/drivers temporales de verificacion (no fuente definitiva)
nucleo/_tmp_*.syn
tests/fixtures/tmp_*.syn
# CLASE D1: C generado al lado de .syn fuente (ej: hola.syn → hola.c)
examples/**/*.c
tests/fixtures/*.c
tests/fixtures/*/*.c
std/**/*.c
opensyn/*.c

# CLASE D2: Artefactos de prueba en raíz (auditoría Fase 0)
prueba_*.c
prueba_*.syn.json
prueba_*.c.json

# CLASE E: Directorios temporales de tests
_test_*/
__pycache__/
.pytest_cache/
*.pyc

# CLASE F: Logs y artefactos de ejecución
*.log
stage2_*.txt
stdout.log
stderr.log
pipeline.err
pipeline.out
--output
--output.exe
-o
-o.exe

# CLASE G: Cachés
.synapse/
.axon_cache/

# CLASE H: DLLs/Dynamic
runtime_linked.dll

# CLASE I: Directorios de build/toolchain (no fuente)
toolchain_gcc12/
build/
bootstrap_tmp/

# CLASE J: Directorios de distribución (artefactos generados por workflows/instalador)
dist/
distbin/

# CLASE K: Bootstrap binaries (generados por pipeline)
synapse_v*.exe
synapse_v*.exe.sig
synapse_v*.exe.pub

# CLASE L: Artefactos de fuzzing
tests/fuzz/tmp*
tests/fuzz/crashes/
tests/fuzz/corpus/

# CLASE M: Stubs y archivos de prueba en raíz
programa.c
runtime_stubs.c
test_toolchain.c
tests/dummy_main.c
tests/validate_borrow_abort.c
tests/validate_borrow_abort.syn.json

# CLASE M2: Artefactos de ejecución de tests en raíz
test_*.txt
test_*.c
test_*.syn
_out_*.txt
*.out
hola.c

# CLASE N: Paquetes locales Axon
paquetes_oficiales/

# CLASE O: Directorios residuales de pruebas
_test_*_cluster/
_test_migration_*/

# CLASE P: Archivos varios residuales
nul

# CLASE S: Dependencias Node.js
node_modules/

# CLASE T: Vendor de skills de agente (deps/agent-skills v0.6.8, MIT — pin d2c37ef;
# origen https://github.com/addyosmani/agent-skills; base adaptada en std/agent_skills.syn
# para las skills /tdd /revisar /plan /skills de OpenSyn, Manual 7 §6). Archivos
# internos del proyecto upstream que NO son fuente de Synapse:
deps/agent-skills/evals/
deps/agent-skills/.kilo/

# CLASE Q: Archivos binarios LSP
test_lsp_bin.oculto
test_lsp_bin

# CLASE R: Firmas y attestaciones
*.sig
*.pub
*.attestation.json

# CLASE R2: Artefactos públicos de release (checksums y changelog — NO son secretos)
!CHANGELOG_v*.md
!*.sha256

# CLASE R3: Artefactos de perfilamiento PGO
*.profdata
*.profraw

# Estándar Python
*.egg-info/
.venv/
venv/
.venv-1/
keep/
tests/probe_f46.c
tests/probe_f46.syn.json

# Estado local de agentes de edicion (kilo)
.kilo/

# VS Code Synapse extension dependencies
vscode-synapse/node_modules/

# Logs
logs/
pipeline.log
