# Synapse v5.1.1-industrial — .gitignore oficial
# =====================================================
# CLASE A: Secretos — NUNCA trackear
*.pem
*.hex
*.key

# CLASE B: Binarios
*.exe
*.dll
*.so
*.dylib
*.wasm

# CLASE C: Objetos compilados
*.o
*.obj
*.lib
*.a

# CLASE C2: Artefactos de cobertura
.coverage
.coverage.*
htmlcov/

# CLASE D: C generado intermedio (no fuente)
synapse_unity.c
synapse_llvm.c
_*.c
_*.c.o
_*.h

# CLASE D2: Artefactos de prueba en raíz (auditoría Fase 0)
prueba_*.c
prueba_*.syn.json
prueba_*.c.json

# CLASE E: Directorios temporales de tests
_test_*/
__pycache__/
.pytest_cache/
*.pyc

# CLASE F: Logs y artefactos de ejecución
*.log
stage2_*.txt
stdout.log
stderr.log
--output
--output.exe
-o
-o.exe

# CLASE G: Cachés
.synapse/
.axon_cache/

# CLASE H: DLLs/Dynamic
runtime_linked.dll

# CLASE I: Directorios de build/toolchain (no fuente)
toolchain_gcc12/
build/
bootstrap_tmp/

# CLASE J: Directorios de distribución (artefactos generados por workflows/instalador)
dist/
distbin/

# CLASE K: Bootstrap binaries (generados por pipeline)
synapse_v*.exe
synapse_v*.exe.sig
synapse_v*.exe.pub

# CLASE L: Artefactos de fuzzing
tests/fuzz/tmp*
tests/fuzz/crashes/
tests/fuzz/corpus/

# CLASE M: Stubs y archivos de prueba en raíz
programa.c
runtime_stubs.c
test_toolchain.c
tests/dummy_main.c
tests/validate_borrow_abort.c
tests/validate_borrow_abort.syn.json

# CLASE M2: Artefactos de ejecución de tests en raíz
test_*.txt

# CLASE N: Paquetes locales Axon
paquetes_oficiales/

# CLASE O: Directorios residuales de pruebas
_test_*_cluster/
_test_migration_*/

# CLASE P: Archivos varios residuales
nul

# CLASE Q: Archivos binarios LSP
test_lsp_bin.oculto
test_lsp_bin

# CLASE R: Firmas y attestaciones
*.sig
*.pub
*.attestation.json

# CLASE R2: Artefactos públicos de release (checksums y changelog — NO son secretos)
!CHANGELOG_v*.md
!*.sha256

# Estándar Python
*.egg-info/
.venv/
venv/
tests/probe_f46.c
tests/probe_f46.syn.json
