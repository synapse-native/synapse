#lang: es
// std.math — Operaciones tensoriales para IA nativa
// Integrante de la Biblioteca Estandar de Synapse.
// Cumple Manual 2 §12: contratos requiere/garantiza en todas las funciones públicas.
//
// Uso desde Synapse:
//   importar std.math
//   a = crear_tensor(2, 2)
//   b = crear_tensor(2, 2)
//   c = suma_tensor(a, b)
//   d = producto_punto(a, b)
//   e = relu(c)

funcion crear_tensor(filas: entero, columnas: entero) -> tensor
    requiere:
        filas > 0
    requiere:
        columnas > 0
    retornar 0

funcion suma_tensor(a: tensor, b: tensor) -> tensor
    requiere:
        longitud(a) > 0
    requiere:
        longitud(b) > 0
    retornar 0

funcion producto_punto(a: tensor, b: tensor) -> tensor
    requiere:
        longitud(a) > 0
    requiere:
        longitud(b) > 0
    retornar 0

funcion relu(a: tensor) -> tensor
    requiere:
        longitud(a) > 0
    retornar 0
