// Declaraciones externas de Cuantización (implementadas en quantization.c)
// ============================================================

// --- Ciclo de vida ---
externo funcion _syn_qt_iniciar(formato: entero, block_size: entero) -> puntero
externo funcion _syn_qt_cerrar(sesion: puntero) -> nulo

// --- Gestión de tensores ---
externo funcion _syn_qt_agregar_tensor(sesion: puntero, datos: puntero, filas: entero, columnas: entero, nombre: texto) -> entero
externo funcion _syn_qt_cuantizar_tensor(sesion: puntero, idx: entero) -> entero
externo funcion _syn_qt_cuantizar_todos(sesion: puntero) -> entero

// --- Descuantización ---
externo funcion _syn_qt_descuantizar_tensor(sesion: puntero, idx: entero) -> puntero

// --- FP16 ↔ FP32 ---
externo funcion _syn_qt_fp16_a_fp32(src: puntero, dst: puntero, n: entero) -> nulo
externo funcion _syn_qt_fp32_a_fp16(src: puntero, dst: puntero, n: entero) -> nulo

// --- Persistencia ---
externo funcion _syn_qt_guardar(sesion: puntero, ruta: texto) -> entero
externo funcion _syn_qt_cargar(sesion: puntero, ruta: texto) -> entero

// --- Selección dinámica ---
externo funcion _syn_qt_seleccionar_formato(ram_mb: entero) -> entero
externo funcion _syn_qt_estimar_tamano_modelo(params_m: entero, formato: entero) -> decimal

// ============================================================
// Wrappers públicos de Cuantización (Synapse idiomático)
// ============================================================

// Inicia una sesión de cuantización
funcion qt_iniciar(formato: entero, block_size: entero) -> puntero:
    retornar _syn_qt_iniciar(formato, block_size)

// Cierra la sesión y libera recursos
funcion qt_cerrar(sesion: puntero) -> nulo:
    _syn_qt_cerrar(sesion)
    retornar

// Agrega un tensor FP32 a la sesión
funcion qt_agregar_tensor(sesion: puntero, datos: puntero, filas: entero, columnas: entero, nombre: texto) -> entero:
    retornar _syn_qt_agregar_tensor(sesion, datos, filas, columnas, nombre)

// Cuantiza un tensor específico
funcion qt_cuantizar_tensor(sesion: puntero, idx: entero) -> entero:
    retornar _syn_qt_cuantizar_tensor(sesion, idx)

// Cuantiza todos los tensores
funcion qt_cuantizar_todos(sesion: puntero) -> entero:
    retornar _syn_qt_cuantizar_todos(sesion)

// Descuantiza un tensor a FP32
funcion qt_descuantizar_tensor(sesion: puntero, idx: entero) -> puntero:
    retornar _syn_qt_descuantizar_tensor(sesion, idx)

// Convierte FP16 ↔ FP32
funcion qt_fp16_a_fp32(src: puntero, dst: puntero, n: entero) -> nulo:
    _syn_qt_fp16_a_fp32(src, dst, n)
    retornar

funcion qt_fp32_a_fp16(src: puntero, dst: puntero, n: entero) -> nulo:
    _syn_qt_fp32_a_fp16(src, dst, n)
    retornar

// Guarda/Carga sesión cuantizada
funcion qt_guardar(sesion: puntero, ruta: texto) -> entero:
    retornar _syn_qt_guardar(sesion, ruta)

funcion qt_cargar(sesion: puntero, ruta: texto) -> entero:
    retornar _syn_qt_cargar(sesion, ruta)

// Selecciona formato óptimo según RAM disponible
funcion qt_seleccionar_formato(ram_mb: entero) -> entero:
    retornar _syn_qt_seleccionar_formato(ram_mb)

// Estima tamaño de modelo cuantizado
funcion qt_estimar_tamano_modelo(params_m: entero, formato: entero) -> decimal:
    retornar _syn_qt_estimar_tamano_modelo(params_m, formato)

// ============================================================
// Funciones helper de alto nivel
// ============================================================

// argmax: retorna el índice del valor máximo en un tensor de logits
// Equivalente a: argmax(logits) -> token_id
funcion argmax(logits: tensor) -> entero:
    inseguro:
        asm("float* _d = logits.datos;")
        asm("int _n = (int)(logits.columnas);")
        asm("if (!_d || _n <= 0) return -1;")
        asm("float _max = _d[0];")
        asm("int _idx = 0;")
        asm("for (int _i = 1; _i < _n; _i++) {")
        asm("    if (_d[_i] > _max) { _max = _d[_i]; _idx = _i; }")
        asm("}")
        asm("return _idx;")

// muestra_logits: imprime los primeros N logits para depuración
funcion muestra_logits(logits: tensor, n: entero) -> nulo:
    inseguro:
        asm("float* _d = logits.datos;")
        asm("int _max = n < (int)logits.columnas ? n : (int)logits.columnas;")
        asm("fprintf(stderr, \"[Modelo] Logits (primeros %d): \", _max);")
        asm("for (int _i = 0; _i < _max; _i++) {")
        asm("    fprintf(stderr, \"%.4f \", _d[_i]);")
        asm("}")
        asm("fprintf(stderr, \"\\n\");")
        retornar

// generar_texto_simple: genera texto con parámetros por defecto
// temperatura=0.7, top_k=40, top_p=0.9
funcion generar_texto_simple(ctx: puntero, prompt: texto, max_tokens: entero) -> texto:
    retornar _syn_modelo_generar_texto(ctx, prompt, max_tokens, 0.7, 40, 0.9)

// ============================================================
// Declaraciones externas de Destilación (implementadas en distillation.c)
// ============================================================

// --- Ciclo de vida ---
externo funcion _syn_kd_iniciar(temperatura: decimal, alpha: decimal, vocab_size: entero) -> puntero
externo funcion _syn_kd_cerrar(sesion: puntero) -> nulo

// --- Gestión de dataset ---
externo funcion _syn_kd_agregar_par(sesion: puntero, logits_t: puntero, logits_s: puntero, target_id: entero, peso: decimal) -> entero

// --- Cómputo de pérdida ---
externo funcion _syn_kd_divergencia_kl(logits_p: puntero, logits_q: puntero, n: entero, temperatura: decimal) -> decimal
externo funcion _syn_kd_perdida_combinada(logits_t: puntero, logits_s: puntero, target_id: entero, vocab_size: entero, temperatura: decimal, alpha: decimal) -> decimal

// --- Destilación ---
externo funcion _syn_kd_paso_destilacion(sesion: puntero) -> decimal
externo funcion _syn_kd_destilar(sesion: puntero) -> decimal

// --- Persistencia ---
externo funcion _syn_kd_guardar(sesion: puntero, ruta: texto) -> entero
externo funcion _syn_kd_cargar(sesion: puntero, ruta: texto) -> entero

// --- Integración ---
externo funcion _syn_kd_estimar_reduccion(teacher_m: entero, student_m: entero, fmt: entero) -> decimal

// ============================================================
// Wrappers públicos de Destilación (Synapse idiomático)
// ============================================================

// Inicia una sesión de destilación
funcion kd_iniciar(temperatura: decimal, alpha: decimal, vocab_size: entero) -> puntero:
    retornar _syn_kd_iniciar(temperatura, alpha, vocab_size)

// Cierra la sesión y libera recursos
funcion kd_cerrar(sesion: puntero) -> nulo:
    _syn_kd_cerrar(sesion)
    retornar

// Agrega un par de logits (teacher + student) para destilación
funcion kd_agregar_par(sesion: puntero, logits_t: puntero, logits_s: puntero, target_id: entero, peso: decimal) -> entero:
    retornar _syn_kd_agregar_par(sesion, logits_t, logits_s, target_id, peso)

// Computa la divergencia KL entre dos distribuciones
funcion kd_divergencia_kl(logits_p: puntero, logits_q: puntero, n: entero, temperatura: decimal) -> decimal:
    retornar _syn_kd_divergencia_kl(logits_p, logits_q, n, temperatura)

// Computa la pérdida combinada (soft + hard) para destilación
funcion kd_perdida_combinada(logits_t: puntero, logits_s: puntero, target_id: entero, vocab_size: entero, temperatura: decimal, alpha: decimal) -> decimal:
    retornar _syn_kd_perdida_combinada(logits_t, logits_s, target_id, vocab_size, temperatura, alpha)

// Ejecuta un paso de destilación sobre el dataset
funcion kd_paso_destilacion(sesion: puntero) -> decimal:
    retornar _syn_kd_paso_destilacion(sesion)

// Ejecuta destilación completa
funcion kd_destilar(sesion: puntero) -> decimal:
    retornar _syn_kd_destilar(sesion)

// Guarda el estado de destilación a archivo
funcion kd_guardar(sesion: puntero, ruta: texto) -> entero:
    retornar _syn_kd_guardar(sesion, ruta)

// Carga el estado de destilación desde archivo
funcion kd_cargar(sesion: puntero, ruta: texto) -> entero:
    retornar _syn_kd_cargar(sesion, ruta)

// Estima la reducción teacher → student con cuantización
funcion kd_estimar_reduccion(teacher_m: entero, student_m: entero, fmt: entero) -> decimal:
    retornar _syn_kd_estimar_reduccion(teacher_m, student_m, fmt)
