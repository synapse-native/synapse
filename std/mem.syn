#lang: es
// std.mem — Gestion de memoria con semantica de transferencia
// Integrante de la Biblioteca Estandar de Sinaplink OS.
//
// Uso desde Synapse:
//   importar std.mem
//   bloque = reserva(1024)
//   libera(-> bloque)

funcion reserva(tamano: int) -> tensor:
    // cumple Manual 2 §5.1: tamaño positivo; bloque no vacío garantizado
    requiere:
        tamano > 0
    garantiza:
        longitud(_resultado_) >= tamano
    retornar 0

funcion libera(bloque: tensor) -> nulo:
    // cumple Manual 2 §5.1: bloque no vacío para liberar
    requiere:
        longitud(bloque) > 0
    retornar
