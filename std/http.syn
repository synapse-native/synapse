#lang: es
// std.http — Servidor HTTP minimalista síncrono
//
// Uso desde Synapse:
//   importar std.http
//   importar std.tiempo
//   importar std.json
//
//   fd_srv = iniciar_servidor(8080)
//   mientras verdadero:
//       fd_cli = aceptar(fd_srv)
//       peticion = leer_peticion(fd_cli)
//       responder(fd_cli, 200, "text/plain", "OK")

importar std.err

estructura RespuestaHttp:
    codigo: entero
    tipo_contenido: texto
    cuerpo: texto
    longitud: entero

externo funcion _syn_servidor_escuchar(puerto: entero) -> entero
externo funcion _syn_servidor_aceptar(fd_servidor: entero) -> entero
externo funcion _syn_http_leer_peticion(fd_cliente: entero) -> texto
externo funcion _syn_http_enviar_respuesta(fd_cliente: entero, respuesta: texto) -> entero
externo funcion _syn_http_cerrar_cliente(fd_cliente: entero) -> nulo
externo funcion _syn_http_respuesta_ok(codigo: entero, tipo: char*, cuerpo: char*, lon: entero) -> texto
externo funcion _syn_iniciar_red() -> entero
externo funcion _syn_cerrar_socket(fd: entero) -> entero

funcion iniciar_servidor(puerto: entero) -> entero:
    _syn_iniciar_red()
    fd = _syn_servidor_escuchar(puerto)
    retornar fd

funcion aceptar(fd_servidor: entero) -> entero:
    fd_cliente = _syn_servidor_aceptar(fd_servidor)
    retornar fd_cliente

funcion leer_peticion(fd_cliente: entero) -> texto:
    retornar _syn_http_leer_peticion(fd_cliente)

funcion responder(fd_cliente: entero, codigo: entero, tipo: texto, cuerpo: texto):
    res = _syn_http_respuesta_ok(codigo, tipo, cuerpo, cuerpo.longitud)
    _syn_http_enviar_respuesta(fd_cliente, res)
    _syn_http_cerrar_cliente(fd_cliente)
    retornar

funcion cerrar_cliente(fd_cliente: entero) -> nulo:
    _syn_http_cerrar_cliente(fd_cliente)
    retornar

funcion cerrar_servidor(fd_servidor: entero) -> nulo:
    _syn_cerrar_socket(fd_servidor)
    retornar
