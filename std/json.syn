#lang: es
// std.json — Deserializador JSON mediante Tipos Algebraicos (ADT)
// Integrante de la Biblioteca Estandar de Synapse v1.5.0
// Cumple Manual 2 §12: contratos requiere/garantiza en todas las funciones públicas.

importar std.err

estructura ParJson:
    clave: texto
    valor: NodoJson

estructura NodoJson:
    tipo: entero
    valor_bool: entero
    valor_num: decimal
    valor_str: texto
    arreglo_hijos: NodoJson
    objeto_pares: ParJson
    longitud: entero

// Constantes de tipo (usar enteros literales: 0=Nulo, 1=Booleano, etc.)

externo funcion _json_parse(entrada: texto) -> NodoJson
externo funcion _json_nodo_new() -> NodoJson
externo funcion _json_nodo_liberar(n: NodoJson) -> nulo
externo funcion _json_array_get(nodo: NodoJson, indice: entero) -> NodoJson
externo funcion _json_object_get(nodo: NodoJson, clave: texto) -> NodoJson
externo funcion _json_a_texto(nodo: NodoJson) -> texto

funcion desde_texto(entrada: cadena) -> NodoJson
    requiere:
        longitud(entrada) > 0
    garantiza:
        resultado.tipo >= 0
    retornar _json_parse(entrada)

funcion liberar_nodo(-> n: NodoJson) -> nulo
    requiere:
        verdadero
    _json_nodo_liberar(n)
    retornar

funcion obtener_elemento(nodo: NodoJson, indice: entero) -> NodoJson
    requiere:
        indice >= 0
    requiere:
        indice < nodo.longitud
    retornar _json_array_get(nodo, indice)

funcion obtener_campo(nodo: NodoJson, clave: cadena) -> NodoJson
    requiere:
        longitud(clave) > 0
    retornar _json_object_get(nodo, clave)

funcion a_texto(nodo: NodoJson) -> cadena
    garantiza:
        longitud(resultado) >= 0
    retornar _json_a_texto(nodo)
