#lang: es
// std.cripto — Funciones criptográficas (SHA-256 + Ed25519)
// Integrante de la Biblioteca Estandar de Synapse.
//
// Uso desde Synapse:
//   importar std.cripto
//   hash = sha256_texto("datos")
//   log("SHA-256: ", hash)
//
//   // Verificar firma Ed25519
//   si ed25519_verificar(mensaje, firma, clave_publica) == 0:
//       log("Firma valida")
//   sino:
//       log("Firma invalida")

externo funcion _syn_sha256_texto(datos: texto) -> texto
externo funcion _syn_ed25519_verificar(mensaje: texto, firma: texto, clave_publica: texto) -> entero

funcion sha256_texto(datos: texto) -> texto:
    retornar _syn_sha256_texto(datos)

funcion ed25519_verificar(mensaje: texto, firma: texto, clave_publica: texto) -> entero:
    retornar _syn_ed25519_verificar(mensaje, firma, clave_publica)
