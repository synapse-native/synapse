#lang: es
// std.cluster — Red de Nodos Synapse (M8.1 + M8.2)
// Transporte UDP cifrado con autenticación mutua Ed25519
// Canales remotos asíncronos para comunicación entre nodos
// Scheduler distribuido Work-Stealing (M8.2)

importar std.err

// ============================================================
// ParEd25519 — Par de claves criptográficas
// ============================================================
estructura ParEd25519:
    clave_publica: texto
    clave_privada: texto

// ============================================================
// NodoCluster — Representación de un nodo remoto
// ============================================================
estructura NodoCluster:
    id: texto
    direccion: texto
    puerto: entero
    clave_publica: texto
    estado: entero  // 0=DESCONECTADO, 1=CONECTADO, 2=AUTENTICADO

// ============================================================
// CanalRemoto — Canal de comunicación asíncrono entre nodos
// ============================================================
estructura CanalRemoto:
    id: entero
    id_destino: texto
    direccion: texto
    puerto: entero
    estado: entero  // 0=ABIERTO, 1=CERRADO

// ============================================================
// Funciones Externas — M8.1 (Transporte + Criptografía)
// ============================================================

// generar_par_claves — Genera un nuevo par Ed25519
// Retorna "clave_publica_hex:clave_privada_hex"
externo funcion cluster_generar_par_claves() -> texto

// firmar_mensaje — Firma texto con clave privada (hex)
// Retorna firma de 128 caracteres hex
externo funcion cluster_firmar_mensaje(mensaje: texto, clave_privada_hex: texto) -> texto

// verificar_firma — Verifica firma Ed25519 (0=valida, -1=invalida)
externo funcion cluster_verificar_firma(mensaje: texto, firma_hex: texto, clave_publica_hex: texto) -> entero

// iniciar_nodo — Inicializa socket UDP en puerto
externo funcion cluster_iniciar_nodo(puerto: entero) -> entero

// detener_nodo — Cierra socket UDP y libera recursos
externo funcion cluster_detener_nodo() -> entero

// enviar_hello — Envía mensaje HELLO handshake
externo funcion cluster_enviar_hello(ip: texto, puerto: entero, id_origen: texto, pubkey_hex: texto) -> entero

// canal_remoto_enviar — Envía datos por canal remoto
externo funcion cluster_canal_remoto_enviar(ip: texto, puerto: entero, datos: texto, lon: entero, chan_id: entero) -> entero

// recibir_paquete — Recibe datagrama (no bloqueante). Retorna texto vacío si no hay datos.
externo funcion cluster_recibir_paquete(timeout_ms: entero) -> texto

// ============================================================
// Funciones Externas — M8.2 (Work-Stealing Scheduler)
// ============================================================

// ws_inicializar — Inicializa la cola local de tareas
externo funcion ws_inicializar(capacidad: entero) -> entero

// ws_encolar — Agrega tarea a la cola local (por el fondo)
//   id: identificador entero de la tarea
//   datos: payload de la tarea
//   Retorna 0 si ok, -1 si cola llena
externo funcion ws_encolar(id: entero, datos: texto) -> entero

// ws_desencolar — Extrae tarea de la cola local (por el fondo, LIFO)
//   Retorna "id:datos" o vacío si no hay tareas
externo funcion ws_desencolar() -> texto

// ws_profundidad — Retorna cantidad de tareas en cola local
externo funcion ws_profundidad() -> entero

// ws_carga_estimada — Retorna estimación de carga 0-100
externo funcion ws_carga_estimada() -> entero

// ws_enviar_solicitud_robo — Envía solicitud WSTEAL a nodo remoto
//   Retorna número de secuencia o -1 si error
externo funcion ws_enviar_solicitud_robo(ip: texto, puerto: entero) -> entero

// ws_procesar_mensaje — Procesa paquete entrante para protocolo de robo
//   Si es WSTEAL: desencola tarea local y devuelve "ATENDIDO:WSTOLEN:..."
//   Si es WSTOLEN: almacena tarea robada y devuelve "ROBADA:id:datos"
//   Si es WNONE: devuelve "VACIA"
//   Si no es mensaje de robo: devuelve el paquete original
externo funcion ws_procesar_mensaje(paquete: texto) -> texto

// ws_ultima_robada — Recupera la última tarea robada
//   Retorna "id:datos" o vacío
externo funcion ws_ultima_robada() -> texto

// ws_reenviar_respuesta — Reenvía respuesta de robo al solicitante
//   (usado en simulación para routing de mensajes)
externo funcion ws_reenviar_respuesta(ip: texto, puerto: entero, respuesta: texto) -> entero

// ============================================================
// Funciones Externas — M8.3 (Raft Consensus)
// ============================================================

// raft_inicializar — Inicializa estado Raft para un nodo
//   node_id: identificador del nodo (0-N)
//   num_nodes: total de nodos en el cluster
//   seed: semilla para timeouts aleatorios
externo funcion raft_inicializar(node_id: entero, num_nodes: entero, seed: entero) -> entero

// raft_iniciar — Inicia nodo como seguidor (follower)
//   tiempo_actual_ns: timestamp actual en nanosegundos
externo funcion raft_iniciar(tiempo_actual_ns: entero, node_id: entero) -> entero

// raft_tick — Avanza el tiempo Raft (llamar periódicamente)
//   Retorna: 0=sin evento, 1=elección iniciada, 2=heartbeat enviado
externo funcion raft_tick(tiempo_actual_ns: entero, node_id: entero) -> entero

// raft_procesar_solicitud_voto — Procesa solicitud de voto (RequestVote)
//   voter_id: nodo que recibe la solicitud
//   candidate_term: término del candidato
//   candidate_id: ID del candidato
//   Retorna: 1=votó, 0=rechazó
externo funcion raft_procesar_solicitud_voto(voter_id: entero, candidate_term: entero, candidate_id: entero, candidate_last_log: entero) -> entero

// raft_procesar_respuesta_voto — Procesa respuesta a solicitud de voto
//   Retorna: 1=líder electo, 0=continúa como candidato
externo funcion raft_procesar_respuesta_voto(candidate_id: entero, responder_term: entero, responder_id: entero, granted: entero) -> entero

// raft_procesar_heartbeat — Procesa latido del líder (AppendEntries)
//   Retorna: 1=aceptado, 0=rechazado
externo funcion raft_procesar_heartbeat(follower_id: entero, leader_term: entero, leader_id: entero, leader_commit: entero) -> entero

// raft_estado — Retorna estado del nodo (0=follower, 1=candidate, 2=leader)
externo funcion raft_estado(node_id: entero) -> entero

// raft_term_actual — Retorna término actual del nodo
externo funcion raft_term_actual(node_id: entero) -> entero

// raft_lider_actual — Retorna ID del líder actual (-1 si no hay)
externo funcion raft_lider_actual(node_id: entero) -> entero

// raft_log_entradas — Retorna cantidad de entradas en el log
externo funcion raft_log_entradas(node_id: entero) -> entero

// raft_commit_index — Retorna índice de commit actual
externo funcion raft_commit_index(node_id: entero) -> entero

// raft_forzar_abdicacion — Fuerza abdicación del líder (para tests)
externo funcion raft_forzar_abdicacion(node_id: entero) -> entero

// raft_agregar_entrada — Agrega entrada al log del líder
externo funcion raft_agregar_entrada(node_id: entero) -> entero

// raft_reiniciar_nodo — Reinicia estado de un nodo (para tests)
externo funcion raft_reiniciar_nodo(node_id: entero) -> entero

// raft_info — Retorna string diagnóstico "term,state,leader,log,commit"
externo funcion raft_info(node_id: entero) -> texto

// ============================================================
// Funciones Externas — M8.4 (Checkpoint/Restore — Migración Live)
// ============================================================

// cm_inicializar — Inicializa el subsistema de checkpoint
externo funcion cm_inicializar() -> entero

// cm_serializar_checkpoint — Serializa tarea a formato CKPT
//   Retorna "CKPT:<id>:<seq>:<checksum_hex>:<data_len>:<data>"
externo funcion cm_serializar_checkpoint(task_id: entero, datos: texto) -> texto

// cm_deserializar_checkpoint — Deserializa y verifica un checkpoint
//   Retorna los datos de la tarea, o vacío si corrupto
externo funcion cm_deserializar_checkpoint(checkpoint_str: texto) -> texto

// cm_verificar_integridad — Verifica checksum del checkpoint
//   Retorna 0 si válido, -1 si corrupto
externo funcion cm_verificar_integridad(checkpoint_str: texto) -> entero

// cm_restaurar_checkpoint — Restaura tarea desde checkpoint en la cola WS
//   Retorna 0 si ok, -1 si error
externo funcion cm_restaurar_checkpoint(checkpoint_str: texto) -> entero

// cm_migrar_tarea — Migración completa: checkpoint + ownership transfer
//   Retorna el checkpoint generado, o vacío si falla
externo funcion cm_migrar_tarea(datos_debug: texto) -> texto

// cm_migrar_entre_nodos — Simula migración entre dos nodos del cluster
//   Retorna 0 si ok, -1 si error
externo funcion cm_migrar_entre_nodos(ip_destino: texto, puerto_destino: entero) -> entero

// cm_ultima_migracion — Retorna info de la última migración
externo funcion cm_ultima_migracion() -> texto

// cm_migraciones_completadas — Retorna número de migraciones exitosas
externo funcion cm_migraciones_completadas() -> entero

// cm_migraciones_fallidas — Retorna número de migraciones fallidas
externo funcion cm_migraciones_fallidas() -> entero

// ============================================================
// Funciones Externas — M8.5 (Auto-Discovery & Membership)
// ============================================================

// descubrimiento_inicializar — Inicializa la tabla de membresía
//   max_nodos: capacidad máxima de la tabla (máx 64)
//   Retorna 0 si ok
externo funcion cluster_descubrimiento_inicializar(max_nodos: entero) -> entero

// descubrimiento_detener — Detiene el subsistema y limpia la tabla
externo funcion cluster_descubrimiento_detener() -> entero

// registrar_nodo — Registra o actualiza un nodo en la tabla de membresía
//   Retorna índice del nodo (0+) o -1 si tabla llena
externo funcion cluster_registrar_nodo(id: texto, ip: texto, puerto: entero, pubkey: texto) -> entero

// eliminar_nodo — Elimina un nodo de la tabla por ID
//   Retorna 0 si ok, -1 si no se encontró
externo funcion cluster_eliminar_nodo(id: texto) -> entero

// nodos_activos — Retorna número de nodos con estado VIVO
externo funcion cluster_nodos_activos() -> entero

// total_nodos — Retorna número total de nodos en la tabla
externo funcion cluster_total_nodos() -> entero

// obtener_nodo — Obtiene info de un nodo por índice
//   Retorna "id:ip:puerto:pubkey:estado:heartbeats" o vacío
externo funcion cluster_obtener_nodo(indice: entero) -> texto

// heartbeat_inicializar — Configura el subsistema de heartbeats
//   intervalo_s: segundos entre ticks de heartbeat
//   timeout_s: segundos sin heartbeat para marcar caída
externo funcion cluster_heartbeat_inicializar(intervalo_s: entero, timeout_s: entero) -> entero

// tick_heartbeat — Procesa heartbeats y purga nodos caídos
//   tiempo_actual_s: timestamp UNIX actual en segundos
//   Retorna cantidad de nodos purgados
externo funcion cluster_tick_heartbeat(tiempo_actual_s: entero) -> entero

// recibir_heartbeat — Registra heartbeat de un nodo (actualiza estado a VIVO)
//   Retorna 0 si ok, -1 si nodo no encontrado
externo funcion cluster_recibir_heartbeat(id: texto) -> entero

// generar_anuncio — Genera paquete de descubrimiento SYNCLUSTER
//   Formato: "SYNCLUSTER:id:ip:puerto:pubkey"
externo funcion cluster_generar_anuncio(id: texto, ip: texto, puerto: entero, pubkey: texto) -> texto

// procesar_anuncio — Procesa paquete SYNCLUSTER entrante
//   Retorna 0 si se registró correctamente, -1 si inválido
externo funcion cluster_procesar_anuncio(paquete: texto) -> entero

// info_membresia_como_texto — Retorna tabla de membresía como texto
//   Formato: "id:ip:puerto:estado|..."
externo funcion cluster_info_membresia_como_texto() -> texto

// verificar_salud_nodo — Verifica salud de un nodo por ID
//   Retorna: 1=VIVO, 2=SOSPECHOSO, 3=MUERTO, -1=desconocido
externo funcion cluster_verificar_salud_nodo(id: texto) -> entero

// ultimo_tick_heartbeat — Retorna timestamp del último tick
externo funcion cluster_ultimo_tick_heartbeat() -> entero

// info_heartbeat — Retorna configuración de heartbeat
//   "intervalo:timeout"
externo funcion cluster_info_heartbeat() -> texto