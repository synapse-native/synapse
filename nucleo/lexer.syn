#lang: es

// --- Token ID constants ---
// AUDITORIA F1 (H23): nombres alineados al Manual 2 §3 (T_SI/T_SINO).
// AUDITORIA FASE A (A2.1): numeración CANÓNICA de nucleo/tokens.syn. El
// frontend embebido _P_* usa su propia numeración divergente (brecha P1 #5 de
// docs/reportes/FASE_A_A1.md); al unificar, la canónica manda.
constante T_SI = 1
constante T_SINO = 2
constante T_FUNCION = 3
constante T_RETORNAR = 4
constante T_LANZAR = 5
constante T_RECUPERAR = 6
constante T_ESCUCHAR = 7
constante T_MIENTRAS = 8
constante T_IMPORTAR = 9
constante T_ESTRUCTURA = 10
constante T_ROMPER = 11
constante T_SIGUIENTE = 12
constante T_PUNTO = 13
constante T_Y = 14
constante T_O = 15
constante T_NO = 16
constante T_VERDADERO = 17
constante T_FALSO = 18
constante T_IDENTIFICADOR = 19
constante T_NUMERO = 20
constante T_FLOTANTE = 21
constante T_CADENA = 22
constante T_MAYOR = 23
constante T_MENOR = 24
constante T_IGUAL = 25
constante T_DISTINTO = 26
constante T_MENOR_IGUAL = 27
constante T_MAYOR_IGUAL = 28
constante T_ASIGNAR = 29
constante T_MAS = 30
constante T_MENOS = 31
constante T_POR = 32
constante T_DIV = 33
constante T_MOD = 34
constante T_FLECHA = 35
constante T_COINCIDIR = 36
constante T_FLECHA_DER = 37
constante T_PAREN_IZQ = 38
constante T_PAREN_DER = 39
constante T_DOSPUNTOS = 40
constante T_COMA = 41
constante T_NUEVALINEA = 42
constante T_INDENTAR = 43
constante T_DESINDENTAR = 44
constante T_AMPERSAND = 45
constante T_INSEGURO = 46
constante T_IMPORTAR_C = 47
constante T_EXTERNO = 48
constante T_FLECHA_IZQ = 49
constante T_REQUIERE = 50
constante T_GARANTIZA = 51
constante T_CANAL = 52
constante T_ASM = 53
constante T_CONSTANTE = 54
constante T_PUNTOCOMA = 55
constante T_PARA = 56
constante T_FIN = 57
constante T_ERROR = 58
// AUDITORIA F1 (D-F1 RESUELTA): los 7 keywords contextuales (tipo, tensor, nulo,
// ok, err, algun, ninguno) quedan ACTIVADOS en este lexer (Manual 2 §3, tabla
// es/en/fr/pt) con soporte contextual del parser (ver token_es_nombre en
// parser_base.syn).
constante T_LET = 59
constante T_TIPO = 60
constante T_TENSOR = 61
constante T_NULO = 62
constante T_OK = 63
constante T_ERR = 64
constante T_ALGUN = 65
constante T_NINGUNO = 66
constante T_MODULO = 67
constante T_DELEGAR = 68
constante T_EXPORT = 69
constante T_RC = 70
constante T_ARC = 71
constante T_DEBIL = 72
// AUDITORIA F1 (D-F1): '|' (T_PIPE) para declaraciones ADT `tipo X = A | B` (Manual 2 §3).
constante T_PIPE = 73

// --- Language IDs (Manual 2 S2.3) ---
constante IDIOMA_ES = 0
constante IDIOMA_EN = 1
constante IDIOMA_FR = 2
constante IDIOMA_PT = 3

// --- Token struct ---
estructura TokenLex:
    tipo: entero
    linea: entero
    columna: entero
    valor: cadena

// --- String helpers (via asm to avoid semantic analyzer field access on cadena) ---
funcion str_len(s: cadena) -> entero:
    inseguro:
        r = 0
        asm("r = s.longitud")
        retornar r

funcion str_char(s: cadena, i: entero) -> entero:
    inseguro:
        r = 0
        asm("r = (i >= 0 && i < s.longitud) ? (unsigned char)s.datos[i] : 0")
        retornar r

funcion str_char_at(ptr: puntero, i: entero) -> entero:
    inseguro:
        r = 0
        asm("r = (unsigned char)((const char*)ptr)[i]")
        retornar r

funcion str_eq(a: cadena, b: cadena) -> entero:
    inseguro:
        r = 0
        asm("if (a.longitud != b.longitud) { r = 0; } else { r = 1; for (int _si = 0; _si < a.longitud; _si++) { if (a.datos[_si] != b.datos[_si]) { r = 0; break; } } }")
        retornar r

funcion str_len_ptr(ptr: puntero) -> entero:
    inseguro:
        r = 0
        asm("r = (int)strlen((const char*)ptr)")
        retornar r

// --- Keyword dictionary lookup (multi-idioma, Manual 2 S2.3) ---
// AUDITORIA FASE A (A2.1): activados let/delegar/rc/arc/débil/modulo
// (Manual 2 §3: T_LET, T_DELEGAR, T_RC, T_ARC, T_DEBIL, T_MODULO), keywords
// contextuales que conservan el lexema para el parser (paridad con _P_*).
funcion keyword_token_es(palabra: cadena) -> entero:
    si str_eq(palabra, "si") == 1:
        retornar T_SI
    si str_eq(palabra, "sino") == 1:
        retornar T_SINO
    si str_eq(palabra, "funcion") == 1:
        retornar T_FUNCION
    si str_eq(palabra, "retornar") == 1:
        retornar T_RETORNAR
    si str_eq(palabra, "lanzar") == 1:
        retornar T_LANZAR
    si str_eq(palabra, "recuperar") == 1:
        retornar T_RECUPERAR
    si str_eq(palabra, "escuchar") == 1:
        retornar T_ESCUCHAR
    si str_eq(palabra, "mientras") == 1:
        retornar T_MIENTRAS
    si str_eq(palabra, "importar") == 1:
        retornar T_IMPORTAR
    si str_eq(palabra, "romper") == 1:
        retornar T_ROMPER
    si str_eq(palabra, "siguiente") == 1:
        retornar T_SIGUIENTE
    si str_eq(palabra, "estructura") == 1:
        retornar T_ESTRUCTURA
    si str_eq(palabra, "y") == 1:
        retornar T_Y
    si str_eq(palabra, "o") == 1:
        retornar T_O
    si str_eq(palabra, "no") == 1:
        retornar T_NO
    si str_eq(palabra, "verdadero") == 1:
        retornar T_VERDADERO
    si str_eq(palabra, "falso") == 1:
        retornar T_FALSO
    si str_eq(palabra, "inseguro") == 1:
        retornar T_INSEGURO
    si str_eq(palabra, "importar_c") == 1:
        retornar T_IMPORTAR_C
    si str_eq(palabra, "externo") == 1:
        retornar T_EXTERNO
    si str_eq(palabra, "coincidir") == 1:
        retornar T_COINCIDIR
    si str_eq(palabra, "requiere") == 1:
        retornar T_REQUIERE
    si str_eq(palabra, "garantiza") == 1:
        retornar T_GARANTIZA
    si str_eq(palabra, "canal") == 1:
        retornar T_CANAL
    si str_eq(palabra, "asm") == 1:
        retornar T_ASM
    si str_eq(palabra, "constante") == 1:
        retornar T_CONSTANTE
    si str_eq(palabra, "para") == 1:
        retornar T_PARA
    // AUDITORIA F1 (D-F1): Manual 2 §3 — keywords contextuales activados
    si str_eq(palabra, "tipo") == 1:
        retornar T_TIPO
    si str_eq(palabra, "tensor") == 1:
        retornar T_TENSOR
    si str_eq(palabra, "nulo") == 1:
        retornar T_NULO
    si str_eq(palabra, "ok") == 1:
        retornar T_OK
    si str_eq(palabra, "err") == 1:
        retornar T_ERR
    si str_eq(palabra, "algun") == 1:
        retornar T_ALGUN
    si str_eq(palabra, "ninguno") == 1:
        retornar T_NINGUNO
    // AUDITORIA FASE A (A2.1): Manual 2 §3 — let/delegar/rc/arc/débil/modulo
    si str_eq(palabra, "let") == 1:
        retornar T_LET
    si str_eq(palabra, "delegar") == 1:
        retornar T_DELEGAR
    si str_eq(palabra, "rc") == 1:
        retornar T_RC
    si str_eq(palabra, "arc") == 1:
        retornar T_ARC
    si str_eq(palabra, "débil") == 1:
        retornar T_DEBIL
    si str_eq(palabra, "modulo") == 1:
        retornar T_MODULO
    retornar 0

