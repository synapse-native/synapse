#lang: es

funcion parsear_expresion(est: ParserEst) -> entero:
    retornar parsear_logica(est)

funcion parsear_logica(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_comparacion(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_Y:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_comparacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 100")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_O:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_comparacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 101")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        r = 0
    retornar izq

funcion parsear_comparacion(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_adicion(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_MAYOR:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 200")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_MENOR:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 201")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_IGUAL:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 202")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_DISTINTO:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 203")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_MENOR_IGUAL:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 204")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_MAYOR_IGUAL:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 205")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        r = 0
    retornar izq

funcion parsear_adicion(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_multiplicacion(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_MAS:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_multiplicacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 300")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_MENOS:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_multiplicacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 301")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        r = 0
    retornar izq

funcion parsear_multiplicacion(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_unario(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_POR:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_unario(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 400")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_DIV:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_unario(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 401")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        si t == T_MOD:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_unario(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            inseguro:
                asm("est->nodos[nodo].valor_int = 402")
                asm("est->nodos[nodo].hijo_izq = izq")
                asm("est->nodos[nodo].hijo_der = der")
            izq = nodo
            siguiente
        r = 0
    retornar izq

funcion parsear_unario(est: ParserEst) -> entero:
    linea = 0
    col = 0
    expr = 0
    nodo = 0
    t = token_mirar(est)
    si t == T_MENOS:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_UNARIA, linea, col)
        inseguro:
            asm("est->nodos[nodo].valor_int = 500")
            asm("est->nodos[nodo].hijo_izq = expr")
        retornar nodo
    si t == T_NO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_UNARIA, linea, col)
        inseguro:
            asm("est->nodos[nodo].valor_int = 501")
            asm("est->nodos[nodo].hijo_izq = expr")
        retornar nodo
    si t == T_AMPERSAND:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        // Manual 4 §4.2: &mut x (préstamo mutable) — consumir la palabra 'mut'
        // FASE A (A3.0, fix del revisor): 64-bit-safe via LexerBuffers (CadenaSegura
        // real) — antes token_ptr_valor() truncaba a 32 bits y dereferenciar
        // (const char*)ptr_m segfault en x64 (misma clase que el bug &mut de A2.3b,
        // ahora en EXPRESIONES — el fix A2.3c solo cubria parametros).
        es_mut = 0
        si token_mirar(est) == T_IDENTIFICADOR:
            inseguro:
                asm("struct LexerBuffers* _lb_u = (struct LexerBuffers*)lexer_buffers();")
                asm("if (_lb_u && est->posicion >= 0 && est->posicion < _lb_u->ntks) {")
                asm("    CadenaSegura _lv_u = ((struct TokenLex*)_lb_u->tokens)[est->posicion].valor;")
                asm("    if (_lv_u.longitud == 3 && _lv_u.datos && _lv_u.datos[0]=='m' && _lv_u.datos[1]=='u' && _lv_u.datos[2]=='t') { est->posicion++; es_mut = 1; }")
                asm("}")
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_PUNTERO, linea, col)
        inseguro:
            asm("est->nodos[nodo].hijo_izq = expr")
            asm("est->nodos[nodo].valor_int = es_mut")
        retornar nodo
    si t == T_POR:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_DEREF, linea, col)
        inseguro:
            asm("est->nodos[nodo].hijo_izq = expr")
        retornar nodo
    retornar parsear_primario(est)

funcion parsear_primario(est: ParserEst) -> entero:
    linea = 0
    col = 0
    nodo = 0
    t = token_mirar(est)
    si t == T_NUMERO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        pos_num = est.posicion
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_NUMERO, linea, col)
        // FASE A (A3.0): payload del literal (lexema del token en la fuente) —
        // el puente plano->tipado (A3) lo convierte a LiteralNumero.valor.
        nodo_guardar_token(est, nodo, pos_num)
        retornar nodo
    si t == T_FLOTANTE:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        pos_dec = est.posicion
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_DECIMAL, linea, col)
        nodo_guardar_token(est, nodo, pos_dec)
        retornar nodo
    si t == T_CADENA:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        pos_cad = est.posicion
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_CADENA_LIT, linea, col)
        // FASE A (A3.0): payload de la cadena YA DECODIFICADA por el lexer
        // (sbuf acumulativo, puntero estable) — paridad _P_* LiteralCadena.valor.
        nodo_guardar_token(est, nodo, pos_cad)
        retornar nodo
    si t == T_VERDADERO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_BOOLEANO, linea, col)
        inseguro:
            asm("est->nodos[nodo].valor_int = 1")
        retornar nodo
    si t == T_FALSO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_BOOLEANO, linea, col)
        inseguro:
            asm("est->nodos[nodo].valor_int = 0")
        retornar nodo
    // AUDITORIA FASE A (A2.2): nulo -> LiteralNulo (Manual 2 §2 L160, §4.1)
    si t == T_NULO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_NULO, linea, col)
        retornar nodo
    // AUDITORIA FASE A (A2.2): tensor(filas, columnas) -> ExprTensor (Manual 2 §2 L194-195)
    // T_TENSOR también puede ser tipo contextual (tensor: tensor), se decide tras '('.
    si t == T_TENSOR y token_tipo(est, est.posicion + 1) == T_PAREN_IZQ:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        token_esperar(est, T_PAREN_IZQ)
        filas = parsear_expresion(est)
        token_esperar(est, T_COMA)
        columnas = parsear_expresion(est)
        token_esperar(est, T_PAREN_DER)
        nodo = parser_nuevo_nodo(est, NODO_TENSOR, linea, col)
        inseguro:
            asm("est->nodos[nodo].hijo_izq = filas")
            asm("est->nodos[nodo].hijo_der = columnas")
        // AUDITORIA FASE A (A5/D-6): operador '?' postfijo (Manual 3 §7 L331-342).
        // `expr?` propaga el err del Resultado (retorna) y desempaqueta el valor ok.
        mientras token_mirar(est) == T_INTERROGACION:
            linea_q = token_linea(est, est.posicion)
            col_q = token_columna(est, est.posicion)
            token_avanzar(est)
            nodo_q = parser_nuevo_nodo(est, NODO_PROPAGAR, linea_q, col_q)
            inseguro:
                asm("est->nodos[nodo_q].hijo_izq = nodo")
            nodo = nodo_q
        retornar nodo
    // AUDITORIA F1 (D-F1): keywords contextuales como identificadores en expresiones
    // (tipo/tensor/nulo como variables; ok/err/algun/ninguno como constructores ADT).
    si token_es_nombre(t) == 1:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        pos_id = est.posicion
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_IDENTIFICADOR, linea, col)
        // FASE A (A3.0): payload del nombre (identificador o llamada) —
        // el puente lo convierte a Identificador.nombre / LlamadaFuncion.nombre.
        nodo_guardar_token(est, nodo, pos_id)
        t2 = token_mirar(est)
        si t2 == T_PAREN_IZQ:
            inseguro:
                asm("est->nodos[nodo].tipo_nodo = 14")
            token_esperar(est, T_PAREN_IZQ)
            // FASE A (A3.1): los argumentos se ENLAZAN al nodo de llamada
            // (hijo_der = primer argumento, cadena hermano) — antes se parseaban
            // y se DESCARTABAN (LlamadaFuncion.argumentos del puente estaria
            // vacio). Paridad _P_* args (ListaNodo) en _parser.c _P_prim.
            r = 1
            primer_arg = 0
            ultimo_arg = 0
            mientras r == 1:
                si token_mirar(est) == T_PAREN_DER:
                    romper
                arg = parsear_expresion(est)
                si arg != 0:
                    si primer_arg == 0:
                        primer_arg = arg
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo_arg].hermano = arg")
                    ultimo_arg = arg
                si token_mirar(est) == T_COMA:
                    token_avanzar(est)
                    siguiente
                sino:
                    si arg == 0:
                        romper
                r = 1
            si primer_arg > 0:
                inseguro:
                    asm("est->nodos[nodo].hijo_der = primer_arg")
            token_esperar(est, T_PAREN_DER)
        si t2 == T_PUNTO:
            si token_mirar(est) == T_PUNTO:
                token_avanzar(est)
                tok_campo = token_mirar(est)
                linea2 = token_linea(est, est.posicion)
                col2 = token_columna(est, est.posicion)
                // AUDITORIA F1 (D-F1): keyword tras '.' como nombre de campo (x.tipo)
                si token_es_nombre(tok_campo) == 1:
                    pos_campo = est.posicion
                    token_avanzar(est)
                    nodo2 = parser_nuevo_nodo(est, NODO_ACCESO_CAMPO, linea2, col2)
                    // FASE A (A3.0): payload del nombre de campo
                    nodo_guardar_token(est, nodo2, pos_campo)
                    inseguro:
                        asm("est->nodos[nodo2].hijo_izq = nodo")
                    nodo = nodo2
        // AUDITORIA FASE A (A5/D-6): operador '?' postfijo (Manual 3 §7 L331-342).
        // `expr?` propaga el err del Resultado (retorna) y desempaqueta el valor ok.
        mientras token_mirar(est) == T_INTERROGACION:
            linea_q = token_linea(est, est.posicion)
            col_q = token_columna(est, est.posicion)
            token_avanzar(est)
            nodo_q = parser_nuevo_nodo(est, NODO_PROPAGAR, linea_q, col_q)
            inseguro:
                asm("est->nodos[nodo_q].hijo_izq = nodo")
            nodo = nodo_q
        retornar nodo
    si t == T_CANAL:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        si token_mirar(est) == T_PAREN_IZQ:
            nodo = parser_nuevo_nodo(est, NODO_CANAL_CREAR, linea, col)
            token_esperar(est, T_PAREN_IZQ)
            si token_es_nombre(token_mirar(est)) == 1:
                // FASE A (A3.0): payload del tipo de contenido (ExprCrearCanal.tipo_contenido)
                pos_canal = est.posicion
                token_avanzar(est)
                nodo_guardar_token(est, nodo, pos_canal)
            si token_mirar(est) == T_COMA:
                token_avanzar(est)
                expr = parsear_expresion(est)
                inseguro:
                    asm("est->nodos[nodo].hijo_izq = expr")
            token_esperar(est, T_PAREN_DER)
            retornar nodo
        parser_error(est, "Se esperaba ( despues de canal", linea, col)
        retornar 0
    si t == T_PAREN_IZQ:
        token_avanzar(est)
        expr = parsear_expresion(est)
        token_esperar(est, T_PAREN_DER)
        nodo = expr
        // AUDITORIA FASE A (A5/D-6): operador '?' postfijo (Manual 3 §7 L331-342).
        // `expr?` propaga el err del Resultado (retorna) y desempaqueta el valor ok.
        mientras token_mirar(est) == T_INTERROGACION:
            linea_q = token_linea(est, est.posicion)
            col_q = token_columna(est, est.posicion)
            token_avanzar(est)
            nodo_q = parser_nuevo_nodo(est, NODO_PROPAGAR, linea_q, col_q)
            inseguro:
                asm("est->nodos[nodo_q].hijo_izq = nodo")
            nodo = nodo_q
        retornar nodo
    parser_error(est, "Expresion inesperada", token_linea(est, est.posicion), token_columna(est, est.posicion))
    retornar 0

// ---- Statement parsing ----
// Helper: Parse simple statements (break, continue, indent, etc.)
