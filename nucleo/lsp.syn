#lang: es

// nucleo/lsp.syn — Servidor LSP Nativo (JSON-RPC 2.0 sobre stdin/stdout)
//
// Segun Documento Maestro Parte VI: binario secundario que se comunica
// mediante JSON-RPC sobre stdin/stdout. Diagnostica codigo Synapse en
// tiempo real usando el pipeline nativo (tokenizar + parsear + _P_p_err).
//
// Compilacion:
//   python main.py nucleo/lsp.syn            # -> synapse_lsp.exe
//   ./synapse_bootstrap.exe nucleo/lsp.syn    # -> synapse_lsp.exe (self-hosted)

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar resolvedor_axon
importar std.json  // Provee NodoJson, ParJson, _json_parse, _json_object_get, etc.

// --- Constants ---
constante _LSP_BUF_SIZE = 262144
constante _LSP_MAX_URI = 1024
constante _LSP_MAX_TEXT = 131072

// --- LSP Server Entry Point ---
funcion principal() -> entero:
    r = 0
    inseguro:
        asm("fprintf(stderr, \"[Synapse-LSP] v0.1.0 iniciando...\\n\");")
        asm("")
        asm("char _lsp_uri[_LSP_MAX_URI] = {0};")
        asm("int _lsp_run = 1;")
        asm("char _lsp_buf[_LSP_BUF_SIZE];")
        asm("")
        asm("while (_lsp_run) {")
        asm("    // ---- Transport: leer Content-Length ----")
        asm("    int _cl = 0;")
        asm("    int _hp = 0;")
        asm("    int _hd = 0;")
        asm("    while (!_hd) {")
        asm("        int _c = fgetc(stdin);")
        asm("        if (_c == EOF) { _lsp_run = 0; break; }")
        asm("        if (_hp < _LSP_BUF_SIZE - 1) { _lsp_buf[_hp++] = (char)_c; }")
        asm("        _lsp_buf[_hp] = 0;")
        asm("        if (_hp >= 4) {")
        asm("            char* _x = _lsp_buf + _hp - 4;")
        asm("            if (_x[0]==13 && _x[1]==10 && _x[2]==13 && _x[3]==10) { _hd = 1; }")
        asm("        }")
        asm("        if (_hp > 4096) { _hd = 1; break; }")
        asm("    }")
        asm("    if (!_lsp_run) break;")
        asm("")
        asm("    char* _cm = strstr(_lsp_buf, \"Content-Length:\");")
        asm("    if (!_cm) { _cm = strstr(_lsp_buf, \"content-length:\"); }")
        asm("    if (_cm) { _cm += 15; while (*_cm==' '||*_cm==9) { _cm++; } _cl = atoi(_cm); }")
        asm("    if (_cl <= 0 || _cl > _LSP_BUF_SIZE - 64) {")
        asm("        fprintf(stderr, \"[LSP] CL invalido: %d\\n\", _cl);")
        asm("        continue;")
        asm("    }")
        asm("")
        asm("    int _br = 0;")
        asm("    while (_br < _cl) {")
        asm("        int _n = (int)fread(_lsp_buf + _br, 1, _cl - _br, stdin);")
        asm("        if (_n <= 0) { _lsp_run = 0; break; }")
        asm("        _br += _n;")
        asm("    }")
        asm("    if (!_lsp_run) break;")
        asm("    _lsp_buf[_cl] = 0;")
        asm("")
        asm("    // Parsear JSON via std.json nativo")
        asm("    CadenaSegura _ji = { .longitud = _cl, .datos = _lsp_buf };")
        asm("    NodoJson _msg = _json_parse(_ji);")
        asm("    if (_msg.tipo < 0) {")
        asm("        fprintf(stderr, \"[LSP] JSON error\\n\");")
        asm("        _json_nodo_liberar(_msg);")
        asm("        continue;")
        asm("    }")
        asm("")
        asm("    NodoJson _method = _json_object_get(_msg, (CadenaSegura){6,\"method\"});")
        asm("    NodoJson _id = _json_object_get(_msg, (CadenaSegura){2,\"id\"});")
        asm("    NodoJson _params = _json_object_get(_msg, (CadenaSegura){6,\"params\"});")
        asm("")
        asm("    const char* _ms = (_method.tipo == 3) ? _method.valor_str.datos : \"\";")
        asm("    int _is_notif = (_id.tipo < 0);")
        asm("")
        asm("    // ---- initialize ----")
        asm("    if (strcmp(_ms, \"initialize\") == 0) {")
        asm("        const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"result\\\":{\\\"capabilities\\\":{\\\"textDocumentSync\\\":{\\\"openClose\\\":true,\\\"change\\\":1,\\\"save\\\":{\\\"includeText\\\":true}}},\\\"serverInfo\\\":{\\\"name\\\":\\\"synapse-lsp-native\\\",\\\"version\\\":\\\"0.1.0\\\"}}}\";")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("        fflush(stdout);")
        asm("        fprintf(stderr, \"[LSP] initialize -> OK\\n\");")
        asm("    }")
        asm("")
        asm("    // ---- initialized ----")
        asm("    else if (strcmp(_ms, \"initialized\") == 0) {")
        asm("        fprintf(stderr, \"[LSP] initialized\\n\");")
        asm("    }")
        asm("")
        asm("    // ---- shutdown ----")
        asm("    else if (strcmp(_ms, \"shutdown\") == 0) {")
        asm("        const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":null,\\\"result\\\":null}\";")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("        fflush(stdout);")
        asm("        _lsp_run = 0;")
        asm("        fprintf(stderr, \"[LSP] shutdown -> OK\\n\");")
        asm("    }")
        asm("")
        asm("    // ---- exit ----")
        asm("    else if (strcmp(_ms, \"exit\") == 0) {")
        asm("        _lsp_run = 0;")
        asm("    }")
        asm("")
        asm("    // ---- didOpen / didChange / didSave ----")
        asm("    else if (strcmp(_ms, \"textDocument/didOpen\") == 0 ||")
        asm("             strcmp(_ms, \"textDocument/didChange\") == 0 ||")
        asm("             strcmp(_ms, \"textDocument/didSave\") == 0) {")
        asm("")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){11,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0};")
        asm("        char _text[_LSP_MAX_TEXT] = {0};")
        asm("")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3 && _un.valor_str.datos)")
        asm("                strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("")
        asm("            NodoJson _tn = _json_object_get(_td, (CadenaSegura){4,\"text\"});")
        asm("            if (_tn.tipo == 3 && _tn.valor_str.datos)")
        asm("                strncpy(_text, _tn.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("            _json_nodo_liberar(_tn);")
        asm("")
        asm("            NodoJson _cc = _json_object_get(_params, (CadenaSegura){14,\"contentChanges\"});")
        asm("            if (_cc.tipo == 4 && _cc.longitud > 0) {")
        asm("                NodoJson _lc = _json_array_get(_cc, _cc.longitud-1);")
        asm("                if (_lc.tipo == 5) {")
        asm("                    NodoJson _ct = _json_object_get(_lc, (CadenaSegura){4,\"text\"});")
        asm("                    if (_ct.tipo == 3 && _ct.valor_str.datos)")
        asm("                        strncpy(_text, _ct.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("                    _json_nodo_liberar(_ct);")
        asm("                }")
        asm("                _json_nodo_liberar(_lc);")
        asm("            }")
        asm("            _json_nodo_liberar(_cc);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("")
        asm("        if (_uri[0] == 0 || _text[0] == 0) {")
        asm("            fprintf(stderr, \"[LSP] URI o texto vacio\\n\");")
        asm("            _json_nodo_liberar(_method); _json_nodo_liberar(_id);")
        asm("            _json_nodo_liberar(_params); _json_nodo_liberar(_msg);")
        asm("            continue;")
        asm("        }")
        asm("")
        asm("        strncpy(_lsp_uri, _uri, _LSP_MAX_URI-1);")
        asm("        fprintf(stderr, \"[LSP] Validando: %s (%d bytes)\\n\", _uri, (int)strlen(_text));")
        asm("")
        asm("        // ---- Pipeline nativa: tokenizar + parsear ----")
        asm("        CadenaSegura _fs = { .longitud = (int)strlen(_text), .datos = _text };")
        asm("        int _diag_count = 0;")
        asm("        char _diag_json[_LSP_BUF_SIZE/2]; _diag_json[0] = 0;")
        asm("")
        asm("        extern int tokenizar(CadenaSegura);")
        asm("        int _nt = tokenizar(_fs);")
        asm("        if (_nt < 0) {")
        asm("            _diag_count = 1;")
        asm("            snprintf(_diag_json, sizeof(_diag_json),")
        asm("                \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":0,\\\"character\\\":0},\\\"end\\\":{\\\"line\\\":0,\\\"character\\\":1}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_LEX\\\",\\\"source\\\":\\\"synapse\\\",\\\"message\\\":\\\"Error lexico\\\"}]\");")
        asm("        } else {")
        asm("            extern struct Programa parsear(CadenaSegura);")
        asm("            struct Programa _ast = parsear(_fs);")
        asm("            extern int _P_p_err;")
        asm("            if (_P_p_err != 0) {")
        asm("                _diag_count = 1;")
        asm("                snprintf(_diag_json, sizeof(_diag_json),")
        asm("                    \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":0,\\\"character\\\":0},\\\"end\\\":{\\\"line\\\":0,\\\"character\\\":1}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_SYNTAX\\\",\\\"source\\\":\\\"synapse\\\",\\\"message\\\":\\\"Error sintactico\\\"}]\");")
        asm("            } else {")
        asm("                strcpy(_diag_json, \"[]\");")
        asm("            }")
        asm("        }")
        asm("")
        asm("        int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE,")
        asm("            \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"textDocument/publishDiagnostics\\\",\\\"params\\\":{\\\"uri\\\":\\\"%s\\\",\\\"diagnostics\\\":%s}}\",")
        asm("            _uri, _diag_json);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("        fprintf(stderr, \"[LSP] publishDiagnostics: %d errores\\n\", _diag_count);")
        asm("    }")
        asm("")
        asm("    // ---- didClose ----")
        asm("    else if (strcmp(_ms, \"textDocument/didClose\") == 0) {")
        asm("        int _n = snprintf(_lsp_buf, _LSP_BUF_SIZE,")
        asm("            \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"textDocument/publishDiagnostics\\\",\\\"params\\\":{\\\"uri\\\":\\\"%s\\\",\\\"diagnostics\\\":[]}}\", _lsp_uri);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _n, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("        _lsp_uri[0] = 0;")
        asm("    }")
        asm("")
        asm("    // ---- metodo desconocido ----")
        asm("    else {")
        asm("        if (!_is_notif) {")
        asm("            const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":null,\\\"error\\\":{\\\"code\\\":-32601,\\\"message\\\":\\\"Method not found\\\"}}\";")
        asm("            fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("            fflush(stdout);")
        asm("        }")
        asm("        fprintf(stderr, \"[LSP] Metodo no soportado: %s\\n\", _ms);")
        asm("    }")
        asm("")
        asm("    // ---- cleanup ----")
        asm("    _json_nodo_liberar(_method);")
        asm("    _json_nodo_liberar(_id);")
        asm("    _json_nodo_liberar(_params);")
        asm("    _json_nodo_liberar(_msg);")
        asm("}")
        asm("")
        asm("fprintf(stderr, \"[Synapse-LSP] Servidor finalizado\\n\");")
    retornar r
