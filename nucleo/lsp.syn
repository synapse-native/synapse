#lang: es

// nucleo/lsp.syn -- Servidor LSP Nativo (JSON-RPC 2.0 sobre stdin/stdout)
//
// v0.2.5 -- F14.4: `constante EOF = 57` en tokens.syn colisionaba con
//   `#define EOF (-1)` de <stdio.h>. Cualquier byte 57 (ASCII '9')
//   activaba el chequeo `if (_c == EOF)`. SOLUCION: usar (-1).
//   F15: EOF removido de tokens.syn -- usar T_FIN para end-of-file.
//
// v0.2.4 -- F14.3 FIX: _setmode directo (sin #ifdef).
//   RAZON: asm() anade ; tras cada linea, convirtiendo
//   #ifdef _WIN32 en #ifdef _WIN32; -- macro indefinida, bloque saltado.
//   SOLUCION: _setmode directo (LSP solo compila en Windows/MinGW).

importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar resolvedor_axon
importar std.json
importar_c "ollama_client.h"

constante _LSP_BUF_SIZE = 262144
constante _LSP_MAX_URI = 1024
constante _LSP_MAX_TEXT = 131072
constante _LSP_MAX_PROMPT = 32768

funcion _ollama_asegurar_inicializado() -> nulo:
    inseguro:
        asm("static int _ollama_init_done = 0;")
        asm("if (!_ollama_init_done) {")
        asm("    ollama_inicializar_red();")
        asm("    _ollama_init_done = 1;")
        asm("}")

funcion _ollama_cliente_obtener() -> entero:
    inseguro:
        asm("static OllamaCliente* _ollama_cliente_global = NULL;")
        asm("if (!_ollama_cliente_global) {")
        asm("    _ollama_cliente_global = ollama_cliente_crear(\"localhost\", 11434, \"lfm2.5-thinking:1.2b\");")
        asm("}")
        asm("return (int)(intptr_t)_ollama_cliente_global;")

funcion principal() -> entero:
    r = 0
    inseguro:
        asm("setbuf(stderr, NULL);")
        // stdout en modo binario. SIN #ifdef _WIN32 -- ver nota arriba.
        asm("extern int _setmode(int,int); _setmode(1,0x8000);")
        asm("fprintf(stderr, \"[Synapse-LSP] v0.2.5 (F14.4) iniciando...\\n\");")

        asm("char _lsp_uri[_LSP_MAX_URI] = {0};")
        asm("char _lsp_text[_LSP_MAX_TEXT] = {0};")
        asm("int _lsp_run = 1;")
        asm("char _lsp_buf[_LSP_BUF_SIZE];")

        asm("while (_lsp_run) {")
        asm("    int _cl = 0; int _hp = 0; int _hd = 0; int _el = 0; int _ec = 0;")
        asm("    while (!_hd) {")
        asm("        int _c = fgetc(stdin);")
        // Usar (-1) en vez de EOF porque tokens.syn redefine EOF como 57
        asm("        if (_c == (-1)) { _lsp_run = 0; break; }")
        asm("        if (_hp < _LSP_BUF_SIZE - 1) { _lsp_buf[_hp++] = (char)_c; }")
        asm("        _lsp_buf[_hp] = 0;")
        asm("        // Detectar CRLF CRLF (modo binario) y LF-only (modo texto)")
        asm("        if (_hp >= 4) {")
        asm("            char* _x = _lsp_buf + _hp - 4;")
        asm("            if (_x[0]==13 && _x[1]==10 && _x[2]==13 && _x[3]==10) { _hd = 1; }")
        asm("        }")
        asm("        if (_hp >= 2 && !_hd) {")
        asm("            char* _y = _lsp_buf + _hp - 2;")
        asm("            if (_y[0]==10 && _y[1]==10) { _hd = 1; }")
        asm("        }")
        asm("        if (_hp > 8192) { _hd = 1; break; }")
        asm("    }")
        asm("    if (!_lsp_run) break;")

        asm("    char* _cm = strstr(_lsp_buf, \"Content-Length:\");")
        asm("    if (!_cm) { _cm = strstr(_lsp_buf, \"content-length:\"); }")
        asm("    if (_cm) { _cm += 15; while (*_cm==' '||*_cm==9) { _cm++; } _cl = atoi(_cm); }")
        asm("    if (_cl <= 0 || _cl > _LSP_BUF_SIZE - 64) {")
        asm("        continue;")
        asm("    }")

        asm("    int _br = 0;")
        asm("    while (_br < _cl) {")
        asm("        int _c = fgetc(stdin);")
        // Usar (-1) en vez de EOF -- mismo motivo
        asm("        if (_c == (-1)) { _lsp_run = 0; break; }")
        asm("        _lsp_buf[_br++] = (char)_c;")
        asm("    }")
        asm("    if (!_lsp_run) break;")
        asm("    _lsp_buf[_cl] = 0;")

        asm("    CadenaSegura _ji = { .longitud = _cl, .datos = _lsp_buf };")
        asm("    NodoJson _msg = _json_parse(_ji);")
        asm("    if (_msg.tipo < 0) { _json_nodo_liberar(_msg); continue; }")

        asm("    NodoJson _method = _json_object_get(_msg, (CadenaSegura){6,\"method\"});")
        asm("    NodoJson _id = _json_object_get(_msg, (CadenaSegura){2,\"id\"});")
        asm("    NodoJson _params = _json_object_get(_msg, (CadenaSegura){6,\"params\"});")

        asm("    const char* _ms = (_method.tipo == 3) ? _method.valor_str.datos : \"\";")
        asm("    fprintf(stderr, \"[DEBUG] Parsed method: %s\\n\", _ms); fflush(stderr);")
        asm("    int _is_notif = (_id.tipo < 0);")
        asm("    int _method_known = 0;")

        asm("    if (strcmp(_ms, \"initialize\") == 0) {")
        asm("        _method_known = 1;")
        asm("        const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":1,\\\"result\\\":{\\\"capabilities\\\":{\\\"textDocumentSync\\\":{\\\"openClose\\\":true,\\\"change\\\":1,\\\"save\\\":{\\\"includeText\\\":true}}},\\\"serverInfo\\\":{\\\"name\\\":\\\"synapse-lsp-native\\\",\\\"version\\\":\\\"0.2.5\\\"}}}\";")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("        fflush(stdout);")
        asm("    }")

        asm("    if (strcmp(_ms, \"initialized\") == 0) {")
        asm("        _method_known = 1;")
        asm("    }")

        asm("    if (strcmp(_ms, \"shutdown\") == 0) {")
        asm("        _method_known = 1;")
        asm("        const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":null,\\\"result\\\":null}\";")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("        fflush(stdout);")
        asm("        _lsp_run = 0;")
        asm("    }")

        asm("    if (strcmp(_ms, \"exit\") == 0) {")
        asm("        _method_known = 1;")
        asm("        _lsp_run = 0;")
        asm("    }")

        asm("    if (strcmp(_ms, \"textDocument/didOpen\") == 0 || strcmp(_ms, \"textDocument/didChange\") == 0 || strcmp(_ms, \"textDocument/didSave\") == 0) {")
        asm("        _method_known = 1;")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){12,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0}; char _text[_LSP_MAX_TEXT] = {0};")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3 && _un.valor_str.datos) strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("            NodoJson _tn = _json_object_get(_td, (CadenaSegura){4,\"text\"});")
        asm("            if (_tn.tipo == 3 && _tn.valor_str.datos) strncpy(_text, _tn.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("            _json_nodo_liberar(_tn);")
        asm("            NodoJson _cc = _json_object_get(_params, (CadenaSegura){14,\"contentChanges\"});")
        asm("            if (_cc.tipo == 4 && _cc.longitud > 0) {")
        asm("                NodoJson _lc = _json_array_get(_cc, _cc.longitud-1);")
        asm("                if (_lc.tipo == 5) { NodoJson _ct = _json_object_get(_lc, (CadenaSegura){4,\"text\"});")
        asm("                    if (_ct.tipo == 3 && _ct.valor_str.datos) strncpy(_text, _ct.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("                    _json_nodo_liberar(_ct);")
        asm("                }")
        asm("                _json_nodo_liberar(_lc);")
        asm("            }")
        asm("            _json_nodo_liberar(_cc);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("        if (_uri[0] == 0 || _text[0] == 0) {")
        asm("            _json_nodo_liberar(_method); _json_nodo_liberar(_id); _json_nodo_liberar(_params); _json_nodo_liberar(_msg);")
        asm("            continue;")
        asm("        }")
        asm("        strncpy(_lsp_uri, _uri, _LSP_MAX_URI-1);")
        asm("        strncpy(_lsp_text, _text, _LSP_MAX_TEXT-1);")

        // Pipeline nativa (F15b: estado global limpio por request)
        asm("        CadenaSegura _fs = { .longitud = (int)strlen(_text), .datos = _text };")
        asm("        int _diag_count = 0;")
        asm("        char _diag_json[_LSP_BUF_SIZE/2]; _diag_json[0] = 0;")
        asm("        extern _P_Token _P_tks[];")
        asm("        extern int _P_ntks, _P_tpos, _P_p_err;")
        asm("        extern int _P_nivel_pila; extern int _P_pila_indent[64];")
        asm("        // Resetear estado global para reentrancia")
        asm("        _P_ntks = 0; _P_tpos = 0; _P_p_err = 0; _P_nivel_pila = 0; _P_pila_indent[0] = 0;")
        asm("        // Validar #lang antes de invocar pipeline")
        asm("        int _has_lang = 0;")
        asm("        if (_fs.longitud >= 6 && _fs.datos[0] == '#' && _fs.datos[1] == 'l' && _fs.datos[2] == 'a' && _fs.datos[3] == 'n' && _fs.datos[4] == 'g' && _fs.datos[5] == ':') { _has_lang = 1; }")
        asm("        if (!_has_lang && _fs.longitud > 0) {")
        asm("            _diag_count = 1;")
        asm("            snprintf(_diag_json, sizeof(_diag_json), \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":0,\\\"character\\\":0},\\\"end\\\":{\\\"line\\\":0,\\\"character\\\":1}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_LANG_MISSING\\\",\\\"source\\\":\\\"synapse\\\",\\\"message\\\":\\\"Falta declaracion #lang: <codigo> en la linea 1\\\"}]\");")
        asm("        }")
        asm("        if (_has_lang) {")
        asm("            extern int tokenizar(CadenaSegura);")
        asm("            int _nt = tokenizar(_fs);")
        asm("            if (_nt < 0) {")
        asm("                if (_P_ntks > 0) { _el = _P_tks[_P_ntks-1].linea - 1; _ec = _P_tks[_P_ntks-1].col; }")
        asm("                _diag_count = 1;")
        asm("                snprintf(_diag_json, sizeof(_diag_json), \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":%d,\\\"character\\\":%d},\\\"end\\\":{\\\"line\\\":%d,\\\"character\\\":%d}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_LEX\\\",\\\"source\\\":\\\"synapse\\\"}]\", _el, _ec, _el, _ec+1);")
        asm("            }")
        asm("            if (_nt >= 0) {")
        asm("                extern struct Programa parsear(CadenaSegura);")
        asm("                _P_p_err = 0; _P_ntks = 0; _P_tpos = 0;")
        asm("                struct Programa _ast = parsear(_fs);")
        asm("                if (_P_p_err != 0) {")
        asm("                    if (_P_tpos > 0 && _P_tpos <= _P_ntks) { _el = _P_tks[_P_tpos-1].linea - 1; _ec = _P_tks[_P_tpos-1].col; }")
        asm("                    _diag_count = 1;")
        asm("                    snprintf(_diag_json, sizeof(_diag_json), \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":%d,\\\"character\\\":%d},\\\"end\\\":{\\\"line\\\":%d,\\\"character\\\":%d}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_SYNTAX\\\",\\\"source\\\":\\\"synapse\\\"}]\", _el, _ec, _el, _ec+1);")
        asm("                }")
        asm("                if (_P_p_err == 0) {")
        asm("                    int _s_cnt=0,_s_lvl=0,_s_err=0;")
        asm("                    char _sn[4096][64],_st[4096][64]; int _sl[4096],_sc[4096];")
        asm("                    #define _SEM_SD(n,t,c) do{ int _i; for(_i=0;_i<_s_cnt;_i++) if(strcmp(_sn[_i],n)==0&&_sl[_i]==_s_lvl){ _s_err=1; _i=-2; break; } if(_i>=0||_s_cnt==0){ if(_i<0||_i>=_s_cnt)_i=_s_cnt; strcpy(_sn[_i],n); strcpy(_st[_i],t); _sl[_i]=_s_lvl; _sc[_i]=c; _s_cnt++; } }while(0)")
        asm("                    #define _SEM_SI() _s_lvl++")
        asm("                    #define _SEM_SO() do{ while(_s_cnt>0&&_sl[_s_cnt-1]==_s_lvl) _s_cnt--; _s_lvl--; }while(0)")
        asm("                    { struct ListaNodo* _lp=_ast.sentencias; while(_lp){ void* _n=_lp->cabeza; if(_n){")
        asm("                        const char* _tp=((struct Nodo*)_n)->tipo.datos;")
        asm("                        if(strcmp(_tp,\"DefinicionFuncion\")==0){ struct DefinicionFuncion* _f=(struct DefinicionFuncion*)_n; _SEM_SD(_f->nombre.datos,\"int\",0); }")
        asm("                    } _lp=_lp->cola; }}")
        asm("                    { struct ListaNodo* _lp=_ast.sentencias; while(_lp){ void* _n=_lp->cabeza; if(_n){")
        asm("                        const char* _tp=((struct Nodo*)_n)->tipo.datos;")
        asm("                        if(strcmp(_tp,\"DefinicionFuncion\")==0){")
        asm("                            struct DefinicionFuncion* _f=(struct DefinicionFuncion*)_n;")
        asm("                            _SEM_SI();")
        asm("                            struct ListaParametro* _pl=(struct ListaParametro*)_f->parametros;")
        asm("                            while(_pl){ struct Parametro* _p=(struct Parametro*)_pl->cabeza; if(_p) _SEM_SD(_p->nombre.datos,_p->tipo.datos,0); _pl=_pl->cola; }")
        asm("                            struct ListaNodo* _bl=(struct ListaNodo*)_f->cuerpo;")
        asm("                            while(_bl){ void* _stmt=_bl->cabeza; if(_stmt){")
        asm("                                const char* _st=((struct Nodo*)_stmt)->tipo.datos;")
        asm("                                if(strcmp(_st,\"AsignacionVariable\")==0){")
        asm("                                    struct AsignacionVariable* _a=(struct AsignacionVariable*)_stmt;")
        asm("                                    int _si=-1; for(int _i=0;_i<_s_cnt;_i++) if(strcmp(_sn[_i],_a->nombre.datos)==0){ _si=_i;break; }")
        asm("                                    if(_si<0){ _SEM_SD(_a->nombre.datos,\"int\",0); } else if(_sc[_si]){ _s_err=1; }")
        asm("                                }")
        asm("                            } _bl=_bl->cola; }")
        asm("                            _SEM_SO();")
        asm("                        }")
        asm("                    } _lp=_lp->cola; }}")
        asm("                    if (_s_err) { _diag_count = 1; snprintf(_diag_json, sizeof(_diag_json), \"[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":0,\\\"character\\\":0},\\\"end\\\":{\\\"line\\\":0,\\\"character\\\":1}},\\\"severity\\\":1,\\\"code\\\":\\\"ERR_SEM\\\",\\\"source\\\":\\\"synapse\\\"}]\", _el, _ec, _el, _ec+1); } else { strcpy(_diag_json, \"[]\"); }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"textDocument/publishDiagnostics\\\",\\\"params\\\":{\\\"uri\\\":\\\"%s\\\",\\\"diagnostics\\\":%s}}\", _uri, _diag_json);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("    }")

        asm("    if (strcmp(_ms, \"textDocument/didClose\") == 0) {")
        asm("        _method_known = 1;")
        asm("        int _n = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"method\\\":\\\"textDocument/publishDiagnostics\\\",\\\"params\\\":{\\\"uri\\\":\\\"%s\\\",\\\"diagnostics\\\":[]}}\", _lsp_uri);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _n, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("        _lsp_uri[0] = 0;")
        asm("    }")

        asm("    if (strcmp(_ms, \"synapse/aiExplain\") == 0) {")
        asm("        _method_known = 1;")
        asm("        fprintf(stderr, \"[DEBUG] synapse/aiExplain called, _ms=%s\\n\", _ms); fflush(stderr);")
        asm("        // Extraer parámetros: textDocument.uri, position, code")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){12,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0}; int _line = 0; char _code[_LSP_MAX_TEXT] = {0};")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3 && _un.valor_str.datos) strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("            NodoJson _pos = _json_object_get(_params, (CadenaSegura){8,\"position\"});")
        asm("            if (_pos.tipo == 5) {")
        asm("                NodoJson _ln = _json_object_get(_pos, (CadenaSegura){4,\"line\"});")
        asm("                if (_ln.tipo == 2) _line = (int)_ln.valor_num;")
        asm("                _json_nodo_liberar(_ln);")
        asm("                _json_nodo_liberar(_pos);")
        asm("            }")
        asm("            NodoJson _code_param = _json_object_get(_params, (CadenaSegura){4,\"code\"});")
        asm("            if (_code_param.tipo == 3 && _code_param.valor_str.datos) {")
        asm("                strncpy(_code, _code_param.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("            }")
        asm("            _json_nodo_liberar(_code_param);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("        ")
        asm("        fprintf(stderr, \"[DEBUG] _code after extract: '%s'\\n\", _code); fflush(stderr);")
        asm("        // Si no hay codigo en params, buscar en el documento almacenado")
        asm("        if (_code[0] == 0 && _uri[0] != 0) {")
        asm("            // Buscar el documento en el buffer global _lsp_uri/_lsp_text")
        asm("            if (strcmp(_uri, _lsp_uri) == 0) {")
        asm("                // Extraer la linea _line del _lsp_text almacenado")
        asm("                char* _line_start = _lsp_text;")
        asm("                for (int _i = 0; _i < _line && *_line_start; _i++) {")
        asm("                    _line_start = strchr(_line_start, '\\n');")
        asm("                    if (_line_start) _line_start++; else break;")
        asm("                }")
        asm("                if (_line_start) {")
        asm("                    char* _line_end = strchr(_line_start, '\\n');")
        asm("                    if (!_line_end) _line_end = _line_start + strlen(_line_start);")
        asm("                    size_t _len = _line_end - _line_start;")
        asm("                    if (_len >= _LSP_MAX_TEXT) _len = _LSP_MAX_TEXT - 1;")
        asm("                    strncpy(_code, _line_start, _len);")
        asm("                    _code[_len] = 0;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        ")
        asm("        if (_code[0] == 0) {")
        asm("            // No hay código para explicar")
        asm("            const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":false,\\\"message\\\":\\\"No hay codigo para explicar\\\",\\\"explanation\\\":null,\\\"code\\\":null}}\";")
        asm("            char _id_str[32];")
        asm("            if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("            else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("            else strcpy(_id_str, \"null\");")
        asm("            int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, _R, _id_str);")
        asm("            fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("            fflush(stdout);")
        asm("        } else {")
        asm("            // Ensamblar prompt con contexto, linea actual, diagnosticos")
        asm("            _ollama_asegurar_inicializado();")
        asm("            OllamaCliente* _cli = (OllamaCliente*)(intptr_t)_ollama_cliente_obtener();")
        asm("            ")
        asm("            // Construir prompt")
        asm("            char _prompt[_LSP_MAX_PROMPT];")
        asm("            snprintf(_prompt, sizeof(_prompt), \"[CONTEXTO_ARCHIVO]:\\n%s\\n\\n[LINEA_ACTUAL]:\\n%s\\n\\n[DIAGNOSTICOS]:\\n%s\\n\\nExplica el codigo en la linea actual en espanol, considerando el contexto y los diagnosticos. Se conciso y tecnico.\", _lsp_text, _code, \"Sin diagnosticos en esta linea\");")
        asm("            ")
        asm("            // Llamar a Ollama")
        asm("            fprintf(stderr, \"[DEBUG] Calling ollama_generar...\\n\"); fflush(stderr);")
        asm("            OllamaRespuesta _resp = ollama_generar(_cli, _prompt);")
        asm("            fprintf(stderr, \"[DEBUG] ollama_generar returned: es_ok=%d\\n\", _resp.es_ok); fflush(stderr);")
        asm("            ")
        asm("            // Construir respuesta JSON-RPC")
        asm("            if (_resp.es_ok && _resp.respuesta) {")
        asm("                // Escapar la respuesta para JSON")
        asm("                char _escaped[8192];")
        asm("                char* _dst = _escaped;")
        asm("                char* _src = _resp.respuesta;")
        asm("                while (*_src && (_dst - _escaped) < 8190) {")
        asm("                    if (*_src == '\"' || *_src == '\\\\' || *_src == '\\n' || *_src == '\\r' || *_src == '\\t') {")
        asm("                        *_dst++ = '\\\\';")
        asm("                        switch (*_src) {")
        asm("                            case '\"': *_dst++ = '\"'; break;")
        asm("                            case '\\\\': *_dst++ = '\\\\'; break;")
        asm("                            case '\\n': *_dst++ = 'n'; break;")
        asm("                            case '\\r': *_dst++ = 'r'; break;")
        asm("                            case '\\t': *_dst++ = 't'; break;")
        asm("                        }")
        asm("                    } else {")
        asm("                        *_dst++ = *_src;")
        asm("                    }")
        asm("                    _src++;")
        asm("                }")
        asm("                *_dst = 0;")
        asm("                ")
        asm("                char _id_str[32];")
        asm("                if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("                else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("                else strcpy(_id_str, \"null\");")
        asm("                ")
        asm("                int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":true,\\\"provider\\\":\\\"ollama\\\",\\\"explanation\\\":\\\"%s\\\",\\\"code\\\":\\\"%s\\\"}}\", _id_str, _escaped, _code);")
        asm("                fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("                fflush(stdout);")
        asm("            } else {")
        asm("                // Error en Ollama")
        asm("                char _id_str[32];")
        asm("                if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("                else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("                else strcpy(_id_str, \"null\");")
        asm("                const char* _err_msg = _resp.error ? _resp.error : \"Ollama no disponible\";")
        asm("                int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":false,\\\"message\\\":\\\"%s\\\",\\\"explanation\\\":null,\\\"code\\\":\\\"%s\\\"}}\", _id_str, _err_msg, _code);")
        asm("                fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("                fflush(stdout);")
        asm("            }")
        asm("            ")
        asm("            ollama_libre_respuesta(&_resp);")
        asm("        }")
        asm("    }")

        // ============================================================
        // synapse/explain — Explicación contextual usando modelo local
        // ============================================================
        asm("    if (strcmp(_ms, \"synapse/explain\") == 0) {")
        asm("        _method_known = 1;")
        asm("        fprintf(stderr, \"[DEBUG] synapse/explain called\\n\"); fflush(stderr);")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){12,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0}; int _line = 0; char _code[_LSP_MAX_TEXT] = {0};")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3 && _un.valor_str.datos) strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("            NodoJson _pos = _json_object_get(_params, (CadenaSegura){8,\"position\"});")
        asm("            if (_pos.tipo == 5) {")
        asm("                NodoJson _ln = _json_object_get(_pos, (CadenaSegura){4,\"line\"});")
        asm("                if (_ln.tipo == 2) _line = (int)_ln.valor_num;")
        asm("                _json_nodo_liberar(_ln);")
        asm("                _json_nodo_liberar(_pos);")
        asm("            }")
        asm("            NodoJson _cp = _json_object_get(_params, (CadenaSegura){4,\"code\"});")
        asm("            if (_cp.tipo == 3 && _cp.valor_str.datos) strncpy(_code, _cp.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("            _json_nodo_liberar(_cp);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("        // Si no hay codigo, usar buffer global")
        asm("        if (_code[0] == 0) { strncpy(_code, _lsp_text, _LSP_MAX_TEXT-1); }")
        asm("        // Intentar modelo local primero, fallback a Ollama")
        asm("        extern CadenaSegura _syn_modelo_generar_texto(void*,CadenaSegura,int,float,int,float);")
        asm("        CadenaSegura _local_resp = {0, NULL};")
        asm("        _local_resp = _syn_modelo_generar_texto(NULL, (CadenaSegura){0,\"\"}, 1, 0.7f, 40, 0.9f);")
        asm("        char _explain_prompt[_LSP_MAX_PROMPT];")
        asm("        snprintf(_explain_prompt, sizeof(_explain_prompt), \"Explica este codigo Synapse en espanol, se conciso:\\n%s\", _code);")
        asm("        char _id_str[32];")
        asm("        if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("        else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("        else strcpy(_id_str, \"null\");")
        asm("        // Por ahora, respuesta informativa sin modelo (integración futura)")
        asm("        int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":true,\\\"provider\\\":\\\"opensyn\\\",\\\"explanation\\\":\\\"Contexto: line %d, uri: %s. El modelo local procesara la explicacion.\\\",\\\"code\\\":\\\"%s\\\"}}\", _id_str, _line, _uri, _code);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("    }")

        // ============================================================
        // synapse/refactor — Propuestas de refactorización local
        // ============================================================
        asm("    if (strcmp(_ms, \"synapse/refactor\") == 0) {")
        asm("        _method_known = 1;")
        asm("        fprintf(stderr, \"[DEBUG] synapse/refactor called\\n\"); fflush(stderr);")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){12,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0}; char _code[_LSP_MAX_TEXT] = {0};")
        asm("        int _range_start = 0, _range_end = 0;")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3) strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("        NodoJson _rc = _json_object_get(_params, (CadenaSegura){5,\"range\"});")
        asm("        if (_rc.tipo == 5) {")
        asm("            NodoJson _st = _json_object_get(_rc, (CadenaSegura){5,\"start\"});")
        asm("            if (_st.tipo == 5) {")
        asm("                NodoJson _ln = _json_object_get(_st, (CadenaSegura){4,\"line\"});")
        asm("                if (_ln.tipo == 2) _range_start = (int)_ln.valor_num;")
        asm("                _json_nodo_liberar(_ln);")
        asm("                _json_nodo_liberar(_st);")
        asm("            }")
        asm("            NodoJson _en = _json_object_get(_rc, (CadenaSegura){3,\"end\"});")
        asm("            if (_en.tipo == 5) {")
        asm("                NodoJson _ln = _json_object_get(_en, (CadenaSegura){4,\"line\"});")
        asm("                if (_ln.tipo == 2) _range_end = (int)_ln.valor_num;")
        asm("                _json_nodo_liberar(_ln);")
        asm("                _json_nodo_liberar(_en);")
        asm("            }")
        asm("            _json_nodo_liberar(_rc);")
        asm("        }")
        asm("        NodoJson _cd = _json_object_get(_params, (CadenaSegura){4,\"code\"});")
        asm("        if (_cd.tipo == 3) strncpy(_code, _cd.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("        _json_nodo_liberar(_cd);")
        asm("        char _id_str[32];")
        asm("        if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("        else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("        else strcpy(_id_str, \"null\");")
        asm("        // Respuesta informativa con metadatos de refactorización")
        asm("        int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":true,\\\"provider\\\":\\\"opensyn\\\",\\\"suggestions\\\":[{\\\"range\\\":{\\\"start\\\":{\\\"line\\\":%d,\\\"character\\\":0},\\\"end\\\":{\\\"line\\\":%d,\\\"character\\\":0}},\\\"message\\\":\\\"Analisis de refactorizacion completado. El modelo local procesara las sugerencias.\\\",\\\"kind\\\":\\\"refactor\\\"}]}}\", _id_str, _range_start, _range_end);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("    }")

        // ============================================================
        // synapse/fixError — Corrección automática asistida
        // ============================================================
        asm("    if (strcmp(_ms, \"synapse/fixError\") == 0) {")
        asm("        _method_known = 1;")
        asm("        fprintf(stderr, \"[DEBUG] synapse/fixError called\\n\"); fflush(stderr);")
        asm("        NodoJson _td = _json_object_get(_params, (CadenaSegura){12,\"textDocument\"});")
        asm("        char _uri[_LSP_MAX_URI] = {0}; char _code[_LSP_MAX_TEXT] = {0};")
        asm("        char _err_code[128] = {0}; char _err_msg[1024] = {0};")
        asm("        if (_td.tipo == 5) {")
        asm("            NodoJson _un = _json_object_get(_td, (CadenaSegura){3,\"uri\"});")
        asm("            if (_un.tipo == 3) strncpy(_uri, _un.valor_str.datos, _LSP_MAX_URI-1);")
        asm("            _json_nodo_liberar(_un);")
        asm("        }")
        asm("        _json_nodo_liberar(_td);")
        asm("        NodoJson _diag = _json_object_get(_params, (CadenaSegura){11,\"diagnostic\"});")
        asm("        if (_diag.tipo == 5) {")
        asm("            NodoJson _dc = _json_object_get(_diag, (CadenaSegura){4,\"code\"});")
        asm("            if (_dc.tipo == 3) strncpy(_err_code, _dc.valor_str.datos, 127);")
        asm("            _json_nodo_liberar(_dc);")
        asm("            NodoJson _dm = _json_object_get(_diag, (CadenaSegura){7,\"message\"});")
        asm("            if (_dm.tipo == 3) strncpy(_err_msg, _dm.valor_str.datos, 1023);")
        asm("            _json_nodo_liberar(_dm);")
        asm("            _json_nodo_liberar(_diag);")
        asm("        }")
        asm("        NodoJson _cd = _json_object_get(_params, (CadenaSegura){4,\"code\"});")
        asm("        if (_cd.tipo == 3) strncpy(_code, _cd.valor_str.datos, _LSP_MAX_TEXT-1);")
        asm("        _json_nodo_liberar(_cd);")
        asm("        char _id_str[32];")
        asm("        if (_id.tipo == 2) snprintf(_id_str, sizeof(_id_str), \"%d\", _id.valor_num);")
        asm("        else if (_id.tipo == 3) snprintf(_id_str, sizeof(_id_str), \"\\\"%s\\\"\", _id.valor_str.datos);")
        asm("        else strcpy(_id_str, \"null\");")
        asm("        // Respuesta con fix contextual")
        asm("        int _nn = snprintf(_lsp_buf, _LSP_BUF_SIZE, \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":%s,\\\"result\\\":{\\\"ai_available\\\":true,\\\"provider\\\":\\\"opensyn\\\",\\\"error_code\\\":\\\"%s\\\",\\\"error_message\\\":\\\"%s\\\",\\\"fix_suggestion\\\":\\\"El modelo local analizara el error '%s' para proponer una correccion automatica.\\\"}}\", _id_str, _err_code, _err_msg, _err_code);")
        asm("        fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", _nn, _lsp_buf);")
        asm("        fflush(stdout);")
        asm("    }")

        asm("    if (!_method_known) {")
        asm("        if (!_is_notif) {")
        asm("            const char* _R = \"{\\\"jsonrpc\\\":\\\"2.0\\\",\\\"id\\\":null,\\\"error\\\":{\\\"code\\\":-32601,\\\"message\\\":\\\"Method not found\\\"}}\";")
        asm("            fprintf(stdout, \"Content-Length: %d\\r\\n\\r\\n%s\", (int)strlen(_R), _R);")
        asm("            fflush(stdout);")
        asm("        }")
        asm("    }")

        asm("    _json_nodo_liberar(_method);")
        asm("    _json_nodo_liberar(_id);")
        asm("    _json_nodo_liberar(_params);")
        asm("    _json_nodo_liberar(_msg);")
        asm("}")

        asm("fprintf(stderr, \"[Synapse-LSP] Servidor finalizado\\n\");")
    retornar r
