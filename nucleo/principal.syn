        asm("    if (_rt_n == 0) { strcpy(_rt_dir, \".\"); } else { char* _rt_sl = strrchr(_rt_dir, '\\\\'); if (_rt_sl) *_rt_sl = 0; }")
        asm("    { char _rt_probe[1200]; snprintf(_rt_probe, 1200, \"%s\\\\synapse_rt.c\", _rt_dir); FILE* _rt_f = fopen(_rt_probe, \"rb\"); if (!_rt_f) { strcpy(_rt_dir, \".\"); } else { fclose(_rt_f); } }")
        asm("#else")
