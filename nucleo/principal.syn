        asm("            }")
        asm("            free(_sfbuf);")
        asm("        } else { fclose(_sf); }")
        asm("    }")
        asm("}")
        asm("// ME-R5: link desde fuente del runtime modular (Manual 3 S3.1, Manual 9 S9.1).")
        asm("// Antes: synapse_rt.o synapse_rt_memory.o synapse_rt_concurrency.o tweetnacl.o (inexistentes en instalacion limpia).")
        asm("// ME-R6: rutas absolutas del runtime (Manual 9 S9.9.1; dependencia de instalacion).")
        asm("// Binario instalado (C:\\Synapse\\bin): fuentes del runtime junto al ejecutable, resueltas via")
        asm("// GetModuleFileNameA; checkout de desarrollo (fuentes en CWD): usa '.' (comportamiento ME-R5).")
        asm("// Portabilidad: GetModuleFileNameA/__stdcall solo existen en Windows (guard _WIN32);")
        asm("// en Linux/macOS el compilador nativo usa '.' (CWD), como ME-R5.")
        asm("#ifdef _WIN32")
        asm("extern unsigned long __stdcall GetModuleFileNameA(void*, char*, unsigned long);")
        asm("#endif")
        asm("{")
        asm("    char _rt_dir[1024];")
        asm("#ifdef _WIN32")
        asm("    unsigned long _rt_n = GetModuleFileNameA(0, _rt_dir, 1024);")
        asm("    if (_rt_n == 0) { strcpy(_rt_dir, \".\"); } else { char* _rt_sl = strrchr(_rt_dir, '\\\\'); if (_rt_sl) *_rt_sl = 0; }")
        asm("    // H-R275-1 (cumple Manual 8 §4.1): la base del runtime no siempre esta junto al")
        asm("    // ejecutable. En un checkout `dist/bin/synapse.exe` las fuentes estan 2 niveles")
        asm("    // arriba; antes se caia a '.' y compilar desde otro cwd fallaba con")
        asm("    // 'synapse_rt.c: No such file or directory'. Se prueba el dir del exe, su")
        asm("    // padre y su abuelo, y solo si ninguno tiene el runtime se usa el cwd.")
        asm("    { char _rt_base[1024]; strncpy(_rt_base, _rt_dir, 1023); _rt_base[1023] = 0;")
        asm("      char _rt_up[32]; _rt_up[0] = 0; int _rt_hallado = 0;")
        asm("      for (int _rt_lvl = 0; _rt_lvl < 3 && !_rt_hallado; _rt_lvl++) {")
        asm("          char _rt_probe[2200]; snprintf(_rt_probe, 2200, \"%s/%ssynapse_rt.c\", _rt_base, _rt_up);")
        asm("          FILE* _rt_f = fopen(_rt_probe, \"rb\");")
        asm("          if (_rt_f) { fclose(_rt_f); _rt_hallado = 1;")
        asm("              if (_rt_up[0]) { snprintf(_rt_dir, 1024, \"%s/%s\", _rt_base, _rt_up); size_t _rt_l = strlen(_rt_dir); if (_rt_l > 0 && _rt_dir[_rt_l - 1] == '/') _rt_dir[_rt_l - 1] = 0; }")
        asm("          } else { strcat(_rt_up, \"../\"); }")
        asm("      }")
        asm("      if (!_rt_hallado) strcpy(_rt_dir, \".\");")
        asm("    }")
        asm("#else")
        asm("    strcpy(_rt_dir, \".\");")
        asm("#endif")
        asm("    _rt_dir[200] = 0;")
        asm("    // D-9(d) resuelta / regla 13 (sin hardcoding): la lista de fuentes del")
        asm("    // runtime NO se hardcodea en el comando gcc. Se escanea el directorio")
        asm("    // runtime/core/ con opendir/readdir (paridad pipeline.py _RT_CORE_FUENTES):")
        asm("    // cualquier .c nuevo en runtime/core/ se enlaza automaticamente en el")
        asm("    // compilador nativo — mismo comportamiento que el S1. Orden estable por")
        asm("    // qsort alfabetico (determinismo S2==S3, Manual 9 S9.7).")
        // cumple Manual 8 §4.1 (ME r236, H-R234-1): el comando documentado
        // `synapse <archivo>` sigue compilando a binario; solo cambia que el
        // compilador C se localiza por cercania al ejecutable en vez del PATH.
        // cumple Manual 1 §6 (ME r270, H-R252-4): en win32 el enlace nativo usa
        // -static para igualar la emision S1 y no depender de DLLs del toolchain.
        // cumple Manual 9 §6.2 (ME r270): el enlace nativo se sella con S2==S3.
        // cumple Manual 9 §6.2 (r316): --no-insert-timestamp, --stack y -lws2_32
        // son de MinGW; en ELF/macOS ld.bfd los rechaza y el bootstrap no enlazaba.
        asm("    const char* _static_flag = \"\";")
        asm("    const char* _win_ld = \"\";")
        asm("    const char* _win_libs = \"\";")
        // cumple Manual 9 §6.2 (r320): el ld64 de macOS no conoce
        // --allow-multiple-definition (ld: unknown options) y el enlace nativo
        // se hace en unity; en darwin no se pasa el flag.
        asm("    const char* _dup_flag = \"-Wl,--allow-multiple-definition\";")
        asm("#ifdef __APPLE__")
        asm("    _dup_flag = \"\";")
        asm("#endif")
        asm("#ifdef _WIN32")
        asm("    _static_flag = \"-static \";")
        asm("    _win_ld = \"-Wl,--no-insert-timestamp -Wl,--stack,8388608 \";")
        asm("    _win_libs = \"-lws2_32 \";")
        asm("#endif")
        asm("    snprintf(_cmd, 4096, \"gcc %s %s %s%s-fno-ident -Wl,--gc-sections -I\\\"%s\\\" \\\"synapse_unity.c\\\"\", _gcc_opt, _gcc_flags, _win_ld, _static_flag, _rt_dir);")
        // cumple Manual 8 §4.1 (ME r281, H-R279-2): la lista de fuentes del
        // runtime se materializa primero; despues se decide si se enlaza desde
        // fuente o desde los .o que pipeline.py cachea (mismo binario).
        asm("    {")
        asm("        char _fuentes[96][1600]; int _nf = 0;")
        asm("        snprintf(_fuentes[_nf++], 1600, \"%s/synapse_rt.c\", _rt_dir);")
        asm("        char _rc_dir[1200]; snprintf(_rc_dir, 1200, \"%s/runtime/core/\", _rt_dir);")
        asm("#ifdef _WIN32")
        asm("        struct _finddata_t _rfd;")
        asm("        char _rc_pat[1400]; snprintf(_rc_pat, 1400, \"%s*.c\", _rc_dir);")
        asm("        intptr_t _rfind = _findfirst(_rc_pat, &_rfd);")
        asm("        if (_rfind != -1) {")
        asm("            do {")
        asm("                if ((_rfd.attrib & _A_SUBDIR) == 0 && _nf < 96) { snprintf(_fuentes[_nf++], 1600, \"%s%s\", _rc_dir, _rfd.name); }")
        asm("            } while (_findnext(_rfind, &_rfd) == 0);")
        asm("            _findclose(_rfind);")
        asm("        }")
        asm("#else")
        asm("        DIR* _rd = opendir(_rc_dir);")
        asm("        if (_rd) {")
        asm("            struct dirent* _rde;")
        asm("            while ((_rde = readdir(_rd)) != 0) {")
        asm("                size_t _rlen = strlen(_rde->d_name);")
        asm("                if (_rlen > 2 && strcmp(_rde->d_name + _rlen - 2, \".c\") == 0 && _nf < 96) { snprintf(_fuentes[_nf++], 1600, \"%s%s\", _rc_dir, _rde->d_name); }")
        asm("            }")
        asm("            closedir(_rd);")
        asm("        }")
        asm("#endif")
        asm("        snprintf(_fuentes[_nf++], 1600, \"%s/axon/tweetnacl.c\", _rt_dir);")
        asm("        snprintf(_fuentes[_nf++], 1600, \"%s/vendor/sqlite3/sqlite3.c\", _rt_dir);")
        asm("        { const char* _ias[] = { \"nucleo/fine_tuning.c\", \"nucleo/distillation.c\", \"nucleo/quantization.c\" }; for (int _ii = 0; _ii < 3 && _nf < 96; _ii++) { char _ip[1800]; snprintf(_ip, 1800, \"%s/%s\", _rt_dir, _ias[_ii]); FILE* _if = fopen(_ip, \"rb\"); if (_if) { fclose(_if); snprintf(_fuentes[_nf++], 1600, \"%s\", _ip); } } }")
        asm("        snprintf(_fuentes[_nf++], 1600, \"%s/nucleo/federated.c\", _rt_dir);")
        // cumple Manual 8 §4.2 (ME r281): --release/--debug/--profile no
        // reutilizan objetos; solo la optimizacion por defecto -O2.
        asm("        int _cache_ok = (strcmp(_gcc_opt, \"-O2\") == 0);")
        asm("        char _cdir[1200]; _cdir[0] = 0;")
        asm("        const char* _h = getenv(\"USERPROFILE\"); if (!_h || !_h[0]) _h = getenv(\"HOME\");")
        asm("        if (!_h || !_h[0]) { _cache_ok = 0; } else { snprintf(_cdir, 1200, \"%s/.synapse/cache/runtime_obj\", _h); }")
        asm("        extern CadenaSegura _syn_sha256_archivo(const char*);")
        asm("        char _nombres[96][160];")
        asm("        for (int _fi = 0; _fi < _nf && _cache_ok; _fi++) {")
        asm("            const char* _bs = strrchr(_fuentes[_fi], '/');")
        asm("            snprintf(_nombres[_fi], 160, \"%s\", _bs ? _bs + 1 : _fuentes[_fi]);")
        asm("            char* _dot = strrchr(_nombres[_fi], '.'); if (_dot) *_dot = 0;")
        asm("            char _op[2400]; snprintf(_op, 2400, \"%s/%s.o\", _cdir, _nombres[_fi]);")
        asm("            FILE* _of = fopen(_op, \"rb\"); if (!_of) { _cache_ok = 0; break; } fclose(_of);")
        asm("            char _sp[2400]; snprintf(_sp, 2400, \"%s.sha\", _op);")
        asm("            FILE* _sf = fopen(_sp, \"rb\"); if (!_sf) { _cache_ok = 0; break; }")
        asm("            char _sb[256]; _sb[0] = 0;")
        asm("            if (!fgets(_sb, 256, _sf)) { fclose(_sf); _cache_ok = 0; break; } fclose(_sf);")
        asm("            // El objeto solo sirve si lo compilo ESTE toolchain (2do campo del sidecar).")
        asm("            char _sc[1200]; _sc[0] = 0;")
        asm("            const char* _p1 = strchr(_sb, '|');")
        asm("            if (_p1) { const char* _p2 = strchr(_p1 + 1, '|'); if (_p2) { size_t _sl = (size_t)(_p2 - _p1 - 1); if (_sl < 1200) { memcpy(_sc, _p1 + 1, _sl); _sc[_sl] = 0; } } }")
        asm("            int _abs = !(_gcc_exe[0] == 'g' && _gcc_exe[1] == 'c' && _gcc_exe[2] == 'c');")
        asm("            if (!_abs || strcmp(_sc, _gcc_exe) != 0) { _cache_ok = 0; break; }")
        // cumple Manual 9 §6.2 (ME r281): el .o reutilizado es identico al
        // recien compilado (SHA-256 del fuente en el sidecar) -> S2==S3.
        asm("            CadenaSegura _sh = _syn_sha256_archivo(_fuentes[_fi]);")
        asm("            if (_sh.longitud != 64 || strncmp(_sb, _sh.datos, 64) != 0) { _cache_ok = 0; break; }")
        asm("        }")
        asm("        for (int _fi = 0; _fi < _nf; _fi++) {")
        asm("            char _q[2500];")
        asm("            if (_cache_ok) { char _op[2400]; snprintf(_op, 2400, \"%s/%s.o\", _cdir, _nombres[_fi]); snprintf(_q, 2500, \" \\\"%s\\\"\", _op); }")
        asm("            else { snprintf(_q, 2500, \" \\\"%s\\\"\", _fuentes[_fi]); }")
        asm("            strncat(_cmd, _q, 4095 - strlen(_cmd));")
        asm("        }")
        asm("    }")
        asm("    char _cmd_tail[1600]; snprintf(_cmd_tail, 1600, \" -o \\\"%s\\\" -lpthread -lm %s%s\", salida.datos, _win_libs, _dup_flag);")
        asm("    strncat(_cmd, _cmd_tail, 4095 - strlen(_cmd));")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] GCC: %s\\n\", _cmd);")
        asm("int _gcc_rc = system(_cmd);")
        asm("if (_gcc_rc != 0) {")
        asm("    fprintf(stderr, \"[Synapse] ERROR: GCC fallo con codigo %d\\n\", _gcc_rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] Compilacion nativa exitosa\\n\");")
    retornar etapa_ok()

// --- Backend real de los subcomandos lint/fmt/test (R4, H-R152-4 ratificado) ---
// r153 R4 (Manual 8 §4.1): los backends canónicos son los módulos nucleo/
// lint.syn, formatter.syn y reports.syn (compilan en AMBAS capas, probe r153);
// cli_lint/cli_fmt/cli_test delegan en ellos. El C embebido se conserva SOLO
// donde los módulos no cubren: mensajes a stderr (_cli_err, el escribir de
// runtime imprime a stdout) y en cli_test la medición de tiempo/invocación del
// exe compilado (capacidades del compilador, no del API de módulos).
// _cli_err: imprime a stderr (paridad con los fprintf(stderr) de r152).
funcion _cli_err(msg: texto) -> nulo:
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        asm("fprintf(stderr, \"%s\\n\", msg.datos); fflush(stderr);")

// cumple Manual 8 §4.1: `synapse lint` ejecuta el linter nativo sobre el codigo fuente
funcion cli_lint(ruta: texto, con_fix: booleano) -> entero:
    requiere:
        ruta.longitud > 0
    garantiza:
        _resultado_ >= 0
    // cumple Manual 7 §7.3 (ME r198b3_fmt_lint, H-R198b2-2): el compilador lee
    // la ruta NOMBRADA por el usuario en argv — toma el modo CLI del sandbox
    // (M8 §4.1: el código usuario corre como subproceso, nunca en este proceso).
    inseguro:
        asm("extern void _syn_sandbox_set(int64_t); _syn_sandbox_set(0);")
    // Delega en nucleo/lint.syn (backend canonico R4)
    si con_fix:
        let corregido = lint_fix(ruta)
        si longitud(corregido) == 0:
            _cli_err("[Lint] ERROR: no se pudo leer " + ruta)
            retornar 1
        _cli_err("[Lint] Archivo corregido")
        retornar 0
    let ads = lint_archivo(ruta)
    // H-R153-2: lint_archivo reporta "archivo vacio o ilegible" (linea 0) cuando
    // el runtime no puede leer la ruta (paridad con el check del bloque C de r152).
    // H-R153-17: detección con helper for-en — .obtener(0).linea (método+campo
    // en cadena) no tiene emisión en la ruta unity nativa (probe r153).
    si longitud(ads) == 1 y lint_tiene_aviso_en_linea(ads, 0):
        _cli_err("[Lint] ERROR: no se pudo leer " + ruta)
        retornar 1
    si longitud(ads) > 0:
        para a en ads:
            _cli_err("[Lint] " + a.archivo + ":" + entero_a_texto(a.linea) + ": " + a.mensaje)
        _cli_err("[Lint] " + entero_a_texto(longitud(ads)) + " advertencia(s) encontrada(s)")
        retornar 1
    _cli_err("[Lint] Sin advertencias")
    retornar 0

// cumple Manual 8 §4.1: `synapse fmt` ejecuta el formateador nativo
funcion cli_fmt(ruta: texto, check: booleano) -> entero:
    requiere:
        ruta.longitud > 0
    garantiza:
        _resultado_ >= 0
    // cumple Manual 7 §7.3 (ME r198b3_fmt_lint, H-R198b2-2): modo CLI del
    // sandbox — el compilador lee las rutas NOMBRADAS por el usuario en argv
    // (M8 §4.1; código usuario siempre en subproceso con su propio sandbox).
    inseguro:
        asm("extern void _syn_sandbox_set(int64_t); _syn_sandbox_set(0);")
    // cumple Manual 8 §4.1 (ME r244): una ruta ilegible es un error de uso, no
    // un archivo bien formateado. Antes de r244 `synapse fmt no_existe.syn`
    // respondia "[Fmt] formato correcto" con rc=0 porque fmt_archivo()
    // devuelve `falso` tanto para "sin cambios" como para "no se pudo leer".
    si longitud(leer_archivo(ruta)) == 0:
        _cli_err("[Fmt] ERROR: no se pudo leer " + ruta)
        retornar 1
    // Delega en nucleo/formatter.syn (backend canonico R4)
    si check:
        let ok = verificar_formato(ruta)
        si ok:
            _cli_err("[Fmt] formato correcto")
            retornar 0
        _cli_err("[Fmt] formato incorrecto")
        retornar 1
    let cambio = fmt_archivo(ruta)
    si cambio:
        _cli_err("[Fmt] archivo reformateado")
    sino:
        _cli_err("[Fmt] formato correcto")
    retornar 0

// cumple Manual 8 §4.2 (ME check_cli R1): backend del subcomando `check` —
// ejecuta el pipeline en modo de validación (solo sintaxis + semántica, sin
// generar código de salida); el rc del análisis (0 válido / 1 inválido) es el
// rc del comando.
funcion cli_check(ruta: cadena) -> entero:
    requiere:
        ruta.longitud > 0
    garantiza:
        _resultado_ >= 0
    // cumple Manual 7 §7.3 (ME r198b3_fmt_lint, H-R198b2-2): modo CLI del
    // sandbox — la validación lee el fuente NOMBRADO por el usuario (M8 §4.1).
    inseguro:
        asm("extern void _syn_sandbox_set(int64_t); _syn_sandbox_set(0);")
    let re = generar_etapa(ruta, ruta, 1)
    si re.tag != 0:
        _cli_err("[Check] ERROR de validacion")
        let _rcf_r243 = fallo_etapa(re.valor)
        retornar 1
    _cli_err("[Check] validacion exitosa")
    retornar 0

// cumple Manual 9 §6.2: reportes junit/json para CI/CD (bootstrap verificable)
// cumple Manual 8 §4.1: `synapse test` compila y ejecuta la suite (reportes en paridad con reports.syn)
funcion cli_test(ruta: texto, formato: entero) -> entero:
    requiere:
        ruta.longitud > 0
    garantiza:
        _resultado_ >= 0
    // cumple Manual 7 §7.3 (ME r198b3_fmt_lint, H-R198b2-2): modo CLI del
    // sandbox — el compilador lee el fuente argv del usuario (M8 §4.1); el
    // probe compilado corre como SUBPROCESO con su sandbox estricto default.
    inseguro:
        asm("extern void _syn_sandbox_set(int64_t); _syn_sandbox_set(0);")
    // Ejecuta la suite: compila el archivo con la pipeline del compilador y
    // ejecuta el exe (bloque C de r152 conservado SOLO aqui: medición de
    // tiempo e invocación del proceso — capacidades del compilador, R4) y
    // escribe los reportes con los generadores canónicos de reports.syn (R4).
    let _rc = 0
    let _seg = 0.0
    // cumple Manual 8 §4.2 (ME coverage_aristas, H-R152-1): con --coverage la
    // compilación genera el C instrumentado (cov_iniciar lee esta variable;
    // generar_etapa corre EN PROCESO) y el probe vuelca su JSON al salir.
    si formato == 3:
        inseguro:
            asm("#ifdef _WIN32")
            asm("_putenv(\"SYNAPSE_COVERAGE=1\");")
            asm("#else")
            asm("setenv(\"SYNAPSE_COVERAGE\", \"1\", 1);")
            asm("#endif")
    inseguro:
        asm("{ char _sal_buf[1024]; snprintf(_sal_buf, sizeof(_sal_buf), \"%s.exe\", ruta.datos);")
        asm("CadenaSegura _salida = { .longitud = (int)strlen(_sal_buf), .datos = _sal_buf };")
        asm("struct ResultadoEtapa _re = generar_etapa(ruta, _salida, 0);")
        asm("if(_re.tag != 0){ _rc = 2; _seg = 0.0; goto _ct_fin; }")
        // Workaround cmd.exe: comillas dobles para rutas con espacios
        asm("char _exe_cmd[1040]; snprintf(_exe_cmd, sizeof(_exe_cmd), \"\\\"\\\"%s\\\"\\\"\", _sal_buf);")
        asm("unsigned long long _t0 = 0;")
        asm("#ifdef _WIN32")
        asm("unsigned long long __stdcall GetTickCount64(void);")
        asm("_t0 = GetTickCount64();")
        asm("_rc = (int)system(_exe_cmd);")
        asm("_seg = (double)(GetTickCount64() - _t0) / 1000.0;")
        asm("#else")
        asm("_rc = (int)system(_exe_cmd);")
        asm("_seg = 0.0;")
        asm("#endif")
        asm("_ct_fin:; }")
    // Reportes canónicos: delegan en nucleo/reports.syn (R4, Manual 9 §6.2).
    // Lista de un elemento construida con la stdlib (Manual 2 §4.3).
    let lst = Lista<ResultadoTest>()
    let estado = "passed"
    let mensaje = ""
    si _rc == 2:
        _cli_err("[Test] ERROR: compilacion fallo")
        retornar 1
    si _rc != 0:
        estado = "failed"
        mensaje = "proceso termino con codigo " + entero_a_texto(_rc)
    lst.agregar(ResultadoTest(ruta, ruta, estado, mensaje, _seg))
    si formato == 1:
        escribir_reporte(ruta + ".junit.xml", generar_junit(lst))
    sino:
        si formato == 2:
            escribir_reporte(ruta + ".json", generar_json(lst))
        sino:
            si formato == 3:
                // ME coverage_aristas (H-R152-1 CERRADO): el JSON del probe
                // (volcado atexit de runtime/core/coverage.c) → informe HTML
                // de aristas reales con % y no-ejecutadas (nucleo/coverage.syn).
                // El probe hereda el cwd del compilador (system) y el runtime
                // escribe <nom>.coverage.json en SU cwd: buscar aquí, no junto
                // al fuente (que puede estar en otra carpeta).
                // prototipos de coverage.syn (emisión alfabética: cli_test se
                // emite antes que covrep_*/coverage_* en el unity nativo — el
                // implicit declaration rompería el retorno CadenaSegura).
                inseguro:
                    asm("extern int64_t covrep_parsear(CadenaSegura);")
                    asm("extern CadenaSegura coverage_generar_html(CadenaSegura);")
                let nombre_base: texto = ruta
                let pos_barra = -1
                let ib = 0
                mientras ib < longitud(nombre_base):
                    si subcadena(nombre_base, ib, 1) == "/" o subcadena(nombre_base, ib, 1) == "\\":
                        pos_barra = ib
                    ib = ib + 1
                si pos_barra >= 0:
                    nombre_base = subcadena(nombre_base, pos_barra + 1, longitud(nombre_base) - pos_barra - 1)
                let rj = covrep_parsear(nombre_base + ".coverage.json")
                si rj != 0:
                    _cli_err("[Test] --coverage: el probe no volco el JSON de aristas")
                    retornar 1
                let html_cov: texto = coverage_generar_html(ruta)
                let ign_rc = escribir_reporte(ruta + ".coverage.html", html_cov)
                _cli_err("[Test] Informe de cobertura: " + ruta + ".coverage.html")
    si _rc != 0:
        _cli_err("[Test] FALLO: el proceso de pruebas termino con codigo " + entero_a_texto(_rc))
        retornar 1
    _cli_err("[Test] todos los tests pasaron")
    retornar 0

// ===========================================================================
// Módulo 31.5: CI/CD Reporting (Manual 9 §6.2)
// Genera reportes en formatos estándar para integración con CI/CD.
// comando: synapse test --junit | --coverage | --json
//
// NOTA: generar_junit, generar_json, generar_coverage y estructura
// ResultadoTest están definidas en nucleo/reports.syn (referencia/canónico).
// principal.syn expone escribir_reporte (esta función es nueva, no existe en
// reports.syn) para escribir cualquier reporte a disco.
// ===========================================================================

// cumple Manual 9 §6.2: escribir reporte a archivo (coverage.html, etc.)
funcion escribir_reporte(ruta: texto, contenido: texto) -> entero:
    requiere:
        ruta.longitud > 0
    garantiza:
        _resultado_ >= 0
    inseguro:
        asm("FILE *f = fopen(ruta.datos, \"wb\");")
        asm("if (!f) { fprintf(stderr, \"[Reportes] ERROR: no se pudo crear %s\\n\", ruta.datos); return 1; }")
        asm("fwrite(contenido.datos, 1, contenido.longitud, f);")
        asm("fclose(f);")
        asm("fprintf(stderr, \"[Reportes] Reporte escrito: %s (%d bytes)\\n\", ruta.datos, (int)contenido.longitud);")
    retornar 0

funcion principal() -> entero:
    r = 0
    // --- R183d R1: --version / --help como flags globales (Manual 8 §4.2) ---
    // Antes: principal() trataba argv(1) como ARCHIVO a compilar: synapse.exe
    // --version/--help entraban a la pipeline y abortaban con rc=2 (hallazgo
    // REAL-1 de las pruebas de operación como usuario, reporte R182c). El
    // dispatcher Python de cli.py sí los soporta; el nativo los rechazaba.
    // Ahora: impresión de uso + versión canónica desde el archivo VERSION
    // (única fuente de verdad, misma convención M6/R150 del cli.py).
    // cumple Manual 8 §4.2
    inseguro:
        asm("{ CadenaSegura _f1=_argv(1); if(_argc()>1 && _f1.datos && strcmp(_f1.datos,\"--version\")==0){ FILE* _vf=fopen(\"VERSION\",\"rb\"); char _vb[128]=\"8.1.0-industrial\"; if(_vf){ int _vn=(int)fread(_vb,1,sizeof(_vb)-1,_vf); fclose(_vf); if(_vn>0){ while(_vn>0 && (_vb[_vn-1]=='\\n' || _vb[_vn-1]=='\\r' || _vb[_vn-1]==' ')) _vn--; _vb[_vn]=0; } } printf(\"Synapse Compiler %s\\n\",_vb); r=0; return r; } }")
        asm("{ CadenaSegura _f1=_argv(1); if(_argc()>1 && _f1.datos && strcmp(_f1.datos,\"--help\")==0){ fprintf(stderr, \"Uso: %s <archivo.syn> [-o <salida.exe>] | subcomando [flags] [archivo]\\n\", _argv(0).datos); fprintf(stderr, \"  %s axon fetch    - Leer y validar axon.toml\\n\", _argv(0).datos); fprintf(stderr, \"  %s lint <arch>   - Linting con --fix\\n\", _argv(0).datos); fprintf(stderr, \"  %s fmt <arch>    - Formatear con --check\\n\", _argv(0).datos); fprintf(stderr, \"  %s test <arch>   - Ejecutar tests\\n\", _argv(0).datos); fprintf(stderr, \"  %s check <arch>  - Validar sin generar binario\\n\", _argv(0).datos); fprintf(stderr, \"  %s opensyn <sub> - Comandos de OpenSyn (status, doctor...)\\n\", _argv(0).datos); fprintf(stderr, \"  %s update [--version <v>] [--check] - Actualizar Synapse\\n\", _argv(0).datos); fprintf(stderr, \"  %s --version     - Mostrar version\\n\", _argv(0).datos); r=0; return r; } }")
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %s <archivo.syn> [-o <salida.exe>]\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s axon fetch    - Leer y validar axon.toml\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s lint <arch>   - Linting con --fix\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s fmt <arch>    - Formatear con --check\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s test <arch>   - Ejecutar tests\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s opensyn <sub> - Comandos de OpenSyn (status, doctor...)\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s update [--version <v>] [--check] - Actualizar Synapse\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    cmd = argv_str(1)
    // --- Subcomando: axon (single asm block to avoid ; between if/else) ---
    inseguro:
        asm("typedef struct { CadenaSegura clave; void* valor; } _AxnPar; typedef struct { int tipo; CadenaSegura valor_str; _AxnPar* pares; int longitud; } _AxnRoot; extern void _syn_axon_limpiar_toml(void*); extern int _syn_axon_buscar_local(const char*,const char*,char*,int,char*,int);")
        asm("if(strcmp(cmd.datos,\"axon\")==0){ if(_argc()<3){fprintf(stderr,\"Uso: %%s axon fetch\\n\",_argv(0).datos);r=1;return r;} CadenaSegura _sub=_argv(2);")
        asm("if(strcmp(_sub.datos,\"fetch\")==0){")
        asm("    fprintf(stderr,\"[Axon] Leyendo axon.toml...\\n\");")
        asm("    FILE*_f=fopen(\"axon.toml\",\"rb\"); if(!_f){fprintf(stderr,\"[Axon] ERROR: axon.toml no encontrado\\n\");r=1;return r;}")
        asm("    fseek(_f,0,SEEK_END);long _sz=ftell(_f);fseek(_f,0,SEEK_SET);")
        asm("    char*_b=(char*)malloc((size_t)_sz+1); if(!_b){fclose(_f);fprintf(stderr,\"[Axon] ERROR: malloc fallo\\n\");r=1;return r;}")
        asm("    size_t _rd=fread(_b,1,(size_t)_sz,_f);fclose(_f);_b[_rd]=0;")
        asm("    NodoToml _rt_n=_toml_parse((CadenaSegura){.longitud=(int)_rd,.datos=_b}); _AxnRoot _rt; memcpy(&_rt, &_rt_n, sizeof(_AxnRoot));")
        asm("    if(_rt.tipo<0){fprintf(stderr,\"[Axon] ERROR: TOML invalido\\n\");free(_b);r=1;return r;}")
        asm("    fprintf(stderr,\"[Axon] TOML: %%d secciones\\n\",_rt.longitud);")
        asm("    // Create cache directory")
        // cumple Manual 9 §6.2: sin redireccion `2>nul` (solo cmd.exe); el
        // redirect posix creaba un archivo llamado `nul` en el cwd.
        asm("    system(\"mkdir .axon_cache\"); system(\"mkdir axon_modules\");")
        asm("    // Parse --online flag (default: offline strict)")
        asm("    int _online = 0; for(int _ai=3;_ai<_argc();_ai++){ CadenaSegura _a=_argv(_ai); if(strcmp(_a.datos,\"--online\")==0){ _online=1; break; } }")
        asm("    fprintf(stderr,\"[Axon] Modo: %s\\n\",_online?\"online\":\"offline (air-gapped)\");")
        asm("    // Extract autor (Ed25519 public key) from [paquete] section")
        asm("    char autor[128]=\"\";")
        asm("    for(int _ta=0;_ta<_rt.longitud;_ta++){")
        asm("        if(strcmp(_rt.pares[_ta].clave.datos,\"paquete\")==0){")
        asm("            _AxnRoot*_paq=(_AxnRoot*)_rt.pares[_ta].valor;")
        asm("            for(int _tb=0;_tb<_paq->longitud;_tb++){")
        asm("                if(strcmp(_paq->pares[_tb].clave.datos,\"autor\")==0){")
        asm("                    strncpy(autor,((_AxnRoot*)_paq->pares[_tb].valor)->valor_str.datos,127);")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if(*autor){ fprintf(stderr,\"[Axon] Autor: %s\\n\",autor); }")
        asm("    if(!*autor || strlen(autor)<64){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: clave publica Ed25519 invalida o ausente\\n\"); free(_b); r=1; return r; }")
        asm("    // Iterate dependencies section")
        asm("    for(int _ti=0;_ti<_rt.longitud;_ti++){")
        asm("        if(strcmp(_rt.pares[_ti].clave.datos,\"dependencias\")==0){")
        asm("            _AxnRoot*_dep=(_AxnRoot*)_rt.pares[_ti].valor;")
        asm("            fprintf(stderr,\"[Axon] %%d dependencias encontradas\\n\",_dep->longitud);")
        asm("            for(int _tj=0;_tj<_dep->longitud;_tj++){")
        asm("                CadenaSegura _pkg=_dep->pares[_tj].clave;")
        asm("                _AxnRoot*_pkg_val=(_AxnRoot*)_dep->pares[_tj].valor;")
        asm("                // Extract version from inline table")
        asm("                char _ver[64]=\"\";")
        asm("                for(int _tk=0;_tk<_pkg_val->longitud;_tk++){")
        asm("                    if(strcmp(_pkg_val->pares[_tk].clave.datos,\"version\")==0){")
        asm("                        strncpy(_ver,((_AxnRoot*)_pkg_val->pares[_tk].valor)->valor_str.datos,63);")
        asm("                    }")
        asm("                }")
        asm("                fprintf(stderr,\"[Axon] Procesando: '%%s' v%%s\\n\",_pkg.datos,_ver);")
        asm("                // Build download URL: github.com/synapse-native/PKG/archive/refs/heads/main.tar")
        asm("                char _tar_url[512], _tar_path[512], _extract_dir[512], _lock_path[512];")
        asm("                snprintf(_tar_url,sizeof(_tar_url),\"/synapse-native/%%s/archive/refs/heads/main.tar\",_pkg.datos);")
        asm("                snprintf(_tar_path,sizeof(_tar_path),\".axon_cache/%%s.tar\",_pkg.datos);")
        asm("                snprintf(_extract_dir,sizeof(_extract_dir),\"axon_modules/%%s\",_pkg.datos);")
        asm("                snprintf(_lock_path,sizeof(_lock_path),\"axon.lock\");")
        asm("                extern int _syn_http_get_archivo(CadenaSegura,int,CadenaSegura,const char*);")
        asm("                extern int _syn_axon_verificar_lock(const char*,const char*,const char*,const char*);")
        asm("                extern int _syn_tar_extraer(const char*,const char*);")
        asm("                extern int _syn_axon_verificar_firma(const char*,const char*,const char*); extern int _syn_axon_escribir_lock(const char*,const char*,const char*);")
        asm("                // Step 0: Try local resolution first (offline-first)")
        asm("                int _local_st = _syn_axon_buscar_local(_pkg.datos,_ver,_tar_path,512,_extract_dir,512);")
        asm("                if(_local_st < 0){")
        asm("                    if(!_online){")
        asm("                        fprintf(stderr,\"[Axon] ERR_AXON_NOT_FOUND: %%s v%%s no encontrado localmente (use --online)\n\",_pkg.datos,_ver);")
        asm("                        r=1; free(_b); return r;")
        asm("                    }")
        asm("                    // Online mode: download from HTTP")
        asm("                    fprintf(stderr,\"[Axon] Descargando %%s...\\n\",_pkg.datos);")
        asm("                    CadenaSegura _gh_host={.longitud=14,.datos=\"github.com\"};")
        asm("                    CadenaSegura _gh_path={.longitud=(int)strlen(_tar_url),.datos=_tar_url};")
        asm("                    int _dl=_syn_http_get_archivo(_gh_host,443,_gh_path,_tar_path);")
        asm("                    if(_dl<0){")
        asm("                        fprintf(stderr,\"[Axon] ERROR: No se pudo descargar %%s\\n\",_pkg.datos);")
        asm("                        fprintf(stderr,\"[Axon] ERR_AXON_NOT_FOUND: %%s v%%s (red no disponible)\n\",_pkg.datos,_ver);")
        asm("                        r=1; free(_b); return r;")
        asm("                    }")
        asm("                    fprintf(stderr,\"[Axon] Descargado: %%s\\n\",_tar_path);")
        asm("                }else{")
        asm("                    if(_local_st==0){")
        asm("                        // Already installed, skip")
        asm("                        fprintf(stderr,\"[Axon] Ya instalado: %%s\\n\",_pkg.datos);")
        asm("                        continue;")
        asm("                    }")
        asm("                    fprintf(stderr,\"[Axon] Local: %%s\\n\",_tar_path);")
        asm("                }")
        asm("                // Step 1.5: Verify Ed25519 (mandatory: zero-tolerance, before lock/extract)")
        asm("                char sig_path[512];")
        asm("                FILE* _sf=NULL;")
        asm("                // Try .sig at: 1) alongside tar_path (paquetes_oficiales/), 2) .axon_cache/<pkg>.tar.sig, 3) HTTP")
        asm("                snprintf(sig_path,sizeof(sig_path),\"%s.sig\",_tar_path); _sf=fopen(sig_path,\"rb\");")
        asm("                if(!_sf){ snprintf(sig_path,sizeof(sig_path),\".axon_cache/%s.tar.sig\",_pkg.datos); _sf=fopen(sig_path,\"rb\"); }")
        asm("                if(!_sf && _online){")
        asm("                    char sig_url[512];")
        asm("                    CadenaSegura _gh_host_sig={.longitud=14,.datos=\"github.com\"};")
        asm("                    snprintf(sig_url,sizeof(sig_url),\"/synapse-native/%s/archive/refs/heads/main.tar.sig\",_pkg.datos);")
        asm("                    CadenaSegura _gh_path_sig={.longitud=(int)strlen(sig_url),.datos=sig_url};")
        asm("                    if(_syn_http_get_archivo(_gh_host_sig,443,_gh_path_sig,sig_path)>=0) _sf=fopen(sig_path,\"rb\");")
        asm("                }")
        asm("                // Zero-tolerance: if autor is set but no .sig, abort")
        asm("                if(!_sf && *autor){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: .sig no encontrado\\n\"); remove(_tar_path); r=1; free(_b); return r; }")
        asm("                // Mandatory verification before lock+extract")
        asm("                if(_sf){ fclose(_sf); fprintf(stderr,\"[Axon] Verificando firma Ed25519...\\n\"); int _vf=_syn_axon_verificar_firma(_tar_path,sig_path,autor); if(_vf<0){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: firma Ed25519 invalida\\n\"); remove(_tar_path); remove(sig_path); r=1; free(_b); return r; } fprintf(stderr,\"[Axon] Firma Ed25519 verificada correctamente\\n\"); }")
        asm("                // Step 2: Verify/Create lock")
        asm("                int _lk=_syn_axon_verificar_lock(_pkg.datos,_ver,_tar_path,_lock_path);")
        asm("                if(_lk<0){fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: hash mismatch\\n\");r=1;free(_b);return r;}")
        asm("                // Step 3: Extract TAR")
        asm("                fprintf(stderr,\"[Axon] Extrayendo a %%s...\\n\",_extract_dir);")
        asm("                _syn_tar_extraer(_tar_path,_extract_dir);")
        asm("                fprintf(stderr,\"[Axon] Instalado: %%s v%%s\\n\",_pkg.datos,_ver);")
        asm("extern CadenaSegura _syn_sha256_archivo(const char* ruta);")
        asm("                CadenaSegura _lk_hash=_syn_sha256_archivo(_tar_path); if(_lk_hash.datos&&_lk_hash.longitud>0){ _syn_axon_escribir_lock(_pkg.datos,_ver,_lk_hash.datos); free((void*)_lk_hash.datos); };")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _syn_axon_limpiar_toml((void*)&_rt); fprintf(stderr,\"[Axon] fetch completado\\n\"); free(_b); r=0; return r;")
        asm("}")
        asm("fprintf(stderr,\"Subcomando desconocido: '%%s'\\n\",_sub.datos); r=1; return r; }")
    // --- Subcomando: lint (Fase 31.3; backend real ME r152) ---
    // cumple Manual 8 §4.1: `synapse lint` ejecuta el linter nativo; orden
    // canónico `synapse lint --fix <archivo>` (flags antes de la ruta) y
    // también `synapse lint <archivo> --fix`.
    inseguro:
        asm("if(strcmp(cmd.datos,\"lint\")==0){ if(_argc()<3){ fprintf(stderr,\"Uso: %%s lint [--fix|--check] <archivo.syn> | lint <archivo.syn> [--fix|--check]\\n\",_argv(0).datos); r=1; return r; }")
        // cumple Manual 9 §6.2 (ME r244): `synapse lint --check <archivo>` es el
        // comando que el CI del manual ejecuta sobre el codigo del compilador.
        // Antes de r244 el primer token no-flag se tomaba como ruta, asi que
        // `--check` se convertia en la ruta ("no se pudo leer --check").
        asm("CadenaSegura _sub_ruta={0}; int _sub_flag=0; int _li=2;")
        asm("for(;_li<_argc();_li++){ CadenaSegura _la=_argv(_li); if(_la.longitud>0&&_la.datos&&_la.datos[0]=='-'){ if(_la.longitud==5&&strcmp(_la.datos,\"--fix\")==0){ _sub_flag=1; } continue; } if(_sub_ruta.longitud==0){ _sub_ruta=_la; } }")
        asm("if(_sub_ruta.longitud==0){ fprintf(stderr,\"[Lint] ERROR: falta el archivo\\n\"); r=1; return r; }")
        asm("r=cli_lint(_sub_ruta,_sub_flag); return r; }")
    // --- Subcomando: fmt (Fase 31.4; backend real ME r152) ---
    // cumple Manual 8 §4.1: `synapse fmt` ejecuta el formateador nativo; orden
    // canónico `synapse fmt --check <archivo>` (M8 §4.1: fmt --check src/)
    // y también `synapse fmt <archivo> --check`.
    inseguro:
        asm("if(strcmp(cmd.datos,\"fmt\")==0){ if(_argc()<3){ fprintf(stderr,\"Uso: %%s fmt [--check] <archivo.syn> | fmt <archivo.syn> [--check]\\n\",_argv(0).datos); r=1; return r; }")
        // cumple Manual 8 §5.5 (ME r244): `synapse fmt --check <archivo>` es la
        // forma que documenta el manual para verificar el formato; ningun token
        // con guion inicial puede convertirse en la ruta (antes de r244, un
        // flag desconocido se tomaba como archivo).
        asm("CadenaSegura _sub_ruta={0}; int _sub_flag=0; int _fi=2;")
        asm("for(;_fi<_argc();_fi++){ CadenaSegura _fa=_argv(_fi); if(_fa.longitud>0&&_fa.datos&&_fa.datos[0]=='-'){ if(_fa.longitud==7&&strcmp(_fa.datos,\"--check\")==0){ _sub_flag=1; } continue; } if(_sub_ruta.longitud==0){ _sub_ruta=_fa; } }")
        asm("if(_sub_ruta.longitud==0){ fprintf(stderr,\"[Fmt] ERROR: falta el archivo\\n\"); r=1; return r; }")
        asm("r=cli_fmt(_sub_ruta,_sub_flag); return r; }")
    // --- Subcomando: test (Fase 31.2; backend real ME r152) ---
    // cumple Manual 9 §6.2 (oración 5889882d25): `synapse test --junit --coverage`
    // genera los reportes de tests y cobertura que consume la validación
    // cruzada del CI; cumple Manual 8 §4.1: orden canónico (flags antes de la
    // ruta) y orden antiguo aceptados.
    inseguro:
        asm("if(strcmp(cmd.datos,\"test\")==0){ if(_argc()<3){ fprintf(stderr,\"Uso: %%s test [--junit|--json|--coverage] <archivo.syn> | test <archivo.syn> [--junit|--json|--coverage]\\n\",_argv(0).datos); r=1; return r; }")
        asm("CadenaSegura _sub_ruta={0}; int _sub_fmt=0; int _ti=2;")
        asm("for(;_ti<_argc();_ti++){ CadenaSegura _ta=_argv(_ti); if(_ta.longitud==7&&strcmp(_ta.datos,\"--junit\")==0){ _sub_fmt=1; } else if(_ta.longitud==6&&strcmp(_ta.datos,\"--json\")==0){ _sub_fmt=2; } else if(_ta.longitud==10&&strcmp(_ta.datos,\"--coverage\")==0){ _sub_fmt=3; } else if(_sub_ruta.longitud==0){ _sub_ruta=_ta; } }")
        asm("if(_sub_ruta.longitud==0){ fprintf(stderr,\"[Test] ERROR: falta el archivo\\n\"); r=1; return r; }")
        asm("r=cli_test(_sub_ruta,_sub_fmt); return r; }")
    // --- Subcomando: check (ME check_cli R1, Manual 8 §4.2) ---
    // cumple Manual 8 §4.2: `synapse check --no-emit <archivo>` — modo de
    // validación: solo verifica sintaxis y semántica, sin generar código de
    // salida; orden canónico (flags antes de la ruta) y orden antiguo aceptados.
    inseguro:
        asm("if(strcmp(cmd.datos,\"check\")==0){ if(_argc()<3){ fprintf(stderr,\"Uso: %%s check [--no-emit] [--release|--debug|--safe] <archivo.syn>\\n\",_argv(0).datos); r=1; return r; }")
        asm("CadenaSegura _sub_ruta={0}; int _ci2=2;")
        asm("for(;_ci2<_argc();_ci2++){ CadenaSegura _ca=_argv(_ci2); if(_ca.longitud>0&&_ca.datos[0]=='-'){ continue; } if(_sub_ruta.longitud==0){ _sub_ruta=_ca; } }")
        asm("if(_sub_ruta.longitud==0){ fprintf(stderr,\"[Check] ERROR: falta el archivo\\n\"); r=1; return r; }")
        asm("r=cli_check(_sub_ruta); return r; }")
    // --- Subcomando: update (ME r203_update_nativo, Manual 9 §3.1/§3.2) ---
    inseguro:
        asm("if(strcmp(cmd.datos,\"update\")==0){ CadenaSegura _obj={0,\"\"}; int _solo=0; int _ui=2;")
        asm("for(;_ui<_argc();_ui++){ CadenaSegura _ua=_argv(_ui);")
        asm("if(_ua.longitud==7&&strcmp(_ua.datos,\"--check\")==0){ _solo=1; }")
        asm("else if(_ua.longitud==9&&strcmp(_ua.datos,\"--version\")==0){ if(_ui+1>=_argc()){ fprintf(stderr,\"Uso: synapse update [--version <v>] [--check]\\n\"); r=1; return r; } _ui++; _obj=_argv(_ui); }")
        asm("else if((_ua.longitud==2&&strcmp(_ua.datos,\"-h\")==0)||(_ua.longitud==6&&strcmp(_ua.datos,\"--help\")==0)){ fprintf(stderr,\"Uso: synapse update [--version <v>] [--check]\\n\"); r=0; return r; }")
        asm("else { fprintf(stderr,\"[Update] ERROR: argumento desconocido: %%s\\n\",_ua.datos); r=2; return r; } }")
        asm("r=cli_update(_obj,_solo); return r; }")
    // --- Subcomando: opensyn (ME r242_native_opensyn_cli, Manual 8 §4.1) ---
    // cumple Manual 8 §4.1: `synapse opensyn <subcomando>` con los cinco
    // subcomandos que declara el manual (status, download, finetune, bindings,
    // transpile). Antes argv(1)=="opensyn" caia a la pipeline y el binario
    // intentaba COMPILAR el literal "opensyn" ("Compilando archivo: opensyn"
    // + "Error de compilacion"), asi que el producto distribuido no exponia
    // OpenSyn en absoluto (criterio 6 del PLAN_MAESTRO_INDUSTRIAL).
    // cumple Manual 8 §4.2: el subcomando se despacha ANTES del prescan de
    // flags, de modo que nunca llega a generar_etapa() como si fuera archivo.
    // status/doctor delegan en el binario OpenSyn nativo opensyn.exe que se
    // instala junto a synapse.exe ({app}\bin): una sola fuente de verdad para
    // el diagnostico local (Manual 7 §2.1), sin duplicar comprobaciones.
    inseguro:
        asm("if(strcmp(cmd.datos,\"opensyn\")==0){ CadenaSegura _osub={0,\"\"}; int _oi;")
        asm("for(_oi=2;_oi<_argc();_oi++){ CadenaSegura _oa=_argv(_oi); if(_oa.datos && _oa.datos[0]=='-'){ if(strcmp(_oa.datos,\"--help\")==0||strcmp(_oa.datos,\"-h\")==0){ _osub=(CadenaSegura){.longitud=4,.datos=\"help\"}; break; } continue; } _osub=_oa; break; }")
        asm("if(_osub.longitud==0||strcmp(_osub.datos,\"help\")==0){ fprintf(stderr,\"Comandos OpenSyn:\\n\"); fprintf(stderr,\"  synapse opensyn status              - Estado del orquestador\\n\"); fprintf(stderr,\"  synapse opensyn download <modelo>   - Descargar modelo\\n\"); fprintf(stderr,\"  synapse opensyn finetune <datos>    - Fine-tuning\\n\"); fprintf(stderr,\"  synapse opensyn bindings            - Generar bindings\\n\"); fprintf(stderr,\"  synapse opensyn transpile <archivo> - Transpilar Python a Syquex\\n\"); r=0; return r; }")
        asm("if(strcmp(_osub.datos,\"status\")==0||strcmp(_osub.datos,\"doctor\")==0||strcmp(_osub.datos,\"diagnostico\")==0){")
        asm("    char _opath[1024]; memset(_opath,0,sizeof(_opath)); CadenaSegura _a0=_argv(0); if(_a0.datos){ strncpy(_opath,_a0.datos,sizeof(_opath)-1); }")
        asm("    char* _sp1=strrchr(_opath,'/'); char* _sp2=strrchr(_opath,'\\\\'); char* _sp=(_sp1>_sp2)?_sp1:_sp2; if(_sp){ _sp[1]=0; } else { _opath[0]=0; }")
        asm("    strncat(_opath,\"opensyn.exe\",sizeof(_opath)-strlen(_opath)-1);")
        asm("    FILE* _ochk=fopen(_opath,\"rb\"); if(!_ochk){ fprintf(stderr,\"[OpenSyn] ERROR: no se encontro 'opensyn.exe' junto al binario (%s)\\n\",_opath); r=1; return r; } fclose(_ochk);")
        asm("    char _ocmd[1200]; snprintf(_ocmd,sizeof(_ocmd),\"\\\"%s\\\" %s\",_opath,_osub.datos); int _orc=system(_ocmd); r=(_orc==0)?0:1; return r; }")
        asm("if(strcmp(_osub.datos,\"download\")==0||strcmp(_osub.datos,\"finetune\")==0){ fprintf(stderr,\"[OpenSyn] ERROR: 'opensyn %s' requiere el servidor de inferencia local activo en http://127.0.0.1:8088 (ollama serve o llama-server)\\n\",_osub.datos); r=1; return r; }")
        asm("if(strcmp(_osub.datos,\"bindings\")==0){ fprintf(stderr,\"[OpenSyn] ERROR: 'opensyn bindings' requiere el generador opensyn/generate_runtime_bindings.py; usa el CLI Python: python cli.py opensyn bindings\\n\"); r=1; return r; }")
        asm("if(strcmp(_osub.datos,\"transpile\")==0){ fprintf(stderr,\"[OpenSyn] ERROR: 'opensyn transpile' requiere el transpilador opensyn/transpiler.py; usa el CLI Python: python cli.py opensyn transpile <archivo>\\n\"); r=1; return r; }")
        asm("fprintf(stderr,\"Subcomando OpenSyn desconocido: %s\\n\",_osub.datos); fprintf(stderr,\"Uso: %s opensyn <status|download|finetune|bindings|transpile>\\n\",_argv(0).datos); r=1; return r; }")
    // --- Subcomando: debug (Manual 8 §3.1-§3.4: time-travel debugger) ---
    // cumple Manual 8 §3.1: debugger nativo con time-travel y breakpoints reversibles.
    // cumple Manual 8 §3.4: CLI `synapse debug --load/--step/--reverse/--snapshots`.
    // cumple Manual 9 §6.2 (r241): subcomando debug despachado por el bootstrap nativo.
    // cumple Manual 8 §4.2 (r241): CLI unificado expone `debug`.
    // cumple Manual 8 §4.1 (r241): `synapse debug` listado entre los subcomandos.
        asm("extern CadenaSegura _syn_debug_cargar_traza(CadenaSegura); extern int _syn_debug_posicion_actual(void); extern void _syn_debug_posicion_guardar(int); extern int tr_reproducir_hasta(int); extern int rp_retroceder(int,int); extern int tr_total_eventos(void);")
        asm("if(strcmp(cmd.datos,\"debug\")==0){ CadenaSegura _dsub={0,\"\"}; if(_argc()>=3){ _dsub=_argv(2); }")
        asm("if(_dsub.longitud==0){ fprintf(stderr,\"Comandos debug (Manual 8 §3.4):\n\"); fprintf(stderr,\"  synapse debug --load <traza.trace>   - Cargar traza persistida\n\"); fprintf(stderr,\"  synapse debug --step                 - Avanzar un paso\n\"); fprintf(stderr,\"  synapse debug --reverse              - Retroceder un paso\n\"); fprintf(stderr,\"  synapse debug --snapshots            - Listar eventos/snapshots\n\"); r=0; return r; }")
        asm("if(strcmp(_dsub.datos,\"--help\")==0||strcmp(_dsub.datos,\"-h\")==0||strcmp(_dsub.datos,\"help\")==0){ fprintf(stderr,\"Comandos debug (Manual 8 §3.4):\n\"); fprintf(stderr,\"  synapse debug --load <traza.trace>   - Cargar traza persistida\n\"); fprintf(stderr,\"  synapse debug --step                 - Avanzar un paso\n\"); fprintf(stderr,\"  synapse debug --reverse              - Retroceder un paso\n\"); fprintf(stderr,\"  synapse debug --snapshots            - Listar eventos/snapshots\n\"); r=0; return r; }")
        asm("if(strcmp(_dsub.datos,\"--load\")==0){ CadenaSegura _dpath={0,\"\"}; if(_argc()>=4){ _dpath=_argv(3); } if(_dpath.longitud==0){ fprintf(stderr,\"Uso: %s debug --load <traza.trace>\n\",_argv(0).datos); r=1; return r; } CadenaSegura _did=_syn_debug_cargar_traza(_dpath); if(_did.longitud==0){ r=1; return r; } r=0; return r; }")
        asm("if(strcmp(_dsub.datos,\"--step\")==0){ int _pos=_syn_debug_posicion_actual(); int _rc=tr_reproducir_hasta(_pos+1); _syn_debug_posicion_guardar(_pos+1); fprintf(stderr,\"[Debug] posicion=%d (rc=%d)\n\",_pos+1,_rc); r=0; return r; }")
        asm("if(strcmp(_dsub.datos,\"--reverse\")==0){ int _pos=_syn_debug_posicion_actual(); int _rc=rp_retroceder(1,_pos); int _nuevo=_pos>0?_pos-1:0; _syn_debug_posicion_guardar(_nuevo); fprintf(stderr,\"[Debug] retrocedido (rc=%d)\n\",_rc); r=0; return r; }")
        asm("if(strcmp(_dsub.datos,\"--snapshots\")==0){ int _n=tr_total_eventos(); fprintf(stderr,\"[Debug] eventos en traza: %d\n\",_n); r=0; return r; }")
        asm("fprintf(stderr,\"Subcomando debug desconocido: %s\n\",_dsub.datos); fprintf(stderr,\"Uso: %s debug [--load <traza>|--step|--reverse|--snapshots] (Manual 8 §3.4)\n\",_argv(0).datos); r=1; return r; }")
    // cumple Manual 8 §3.4: fin subcomando debug
    // --- Subcomando: observabilidad local (Manual 1 §5.7; Manual 7 §7.3; Manual 32 §1.3) ---
    // Opt-in por defecto off; zero telemetría; diagnóstico local sin salir del hardware
    // cumple Manual 1 §5.7: cero telemetría y soberanía del usuario
    // cumple Manual 7 §7.3: diagnóstico local opt-in
    // cumple Manual 32 §1.3: agente de codificación avanzado - memoria persistente
    inseguro:
        asm("extern int _syn_health_check(void); extern int _syn_diagnostic_info(char* buffer, int bufsize);")
        asm("if(strcmp(cmd.datos,\"observability\")==0){ CadenaSegura _osub={0,\"\"}; int _oi;")
        asm("for(_oi=2;_oi<_argc();_oi++){ CadenaSegura _oa=_argv(_oi); if(_oa.datos&&_oa.datos[0]=='-'){ while(_oa.datos[0]=='-'){ _oa.datos++; _oa.longitud--; } } if(_oa.datos&&_oa.longitud>0){ _osub=_oa; break; } }")
        asm("if(_osub.longitud==0||strcmp(_osub.datos,\"help\")==0||strcmp(_osub.datos,\"h\")==0){ fprintf(stderr,\"Comando observabilidad (Manual 1 §5.7):\\n\"); fprintf(stderr,\"  synapse observability status   - Mostrar estado saludable (opt-in)\\n\"); fprintf(stderr,\"  synapse observability health   - Health check detallado (opt-in)\\n\"); fprintf(stderr,\"  synapse observability info     - Información de diagnóstico (opt-in)\\n\"); r=0; return r; }")
        asm("if(strcmp(_osub.datos,\"status\")==0){ int _h=_syn_health_check(); fprintf(stderr,\"[Observability] status: %s\\n\",_h!=0?\"OK\":\"ERROR\"); r=0; return r; }")
        asm("if(strcmp(_osub.datos,\"health\")==0){ char _buf[1024]={0}; int _rc=_syn_diagnostic_info(_buf,sizeof(_buf)); if(_rc==0) fprintf(stderr,\"[Observability] health:\\n%s\\n\",_buf); else fprintf(stderr,\"[Observability] health check fallo rc=%d\\n\",_rc); r=0; return r; }")
        asm("if(strcmp(_osub.datos,\"info\")==0){ fprintf(stderr,\"[Observability] info:\\n  modo: opt-in\\n  telemetry: off\\n  diagnostico: local (sin red)\\n\"); r=0; return r; }")
        asm("fprintf(stderr,\"Subcomando observabilidad desconocido: %s\\n\",_osub.datos); fprintf(stderr,\"Uso: %s observability [--help|status|health|info] (Manual 1 §5.7)\\n\",_argv(0).datos); r=1; return r; }")
    // cumple Manual 1 §5.7: fin subcomando observabilidad
    // --- Pipeline de compilacion normal ---
    // cumple Manual 1 §3.1: CLI debe aceptar -o
    // R183d R2: prescan de flags ANTES de tratar argv(1) como archivo (Manual
    // 8 §4.1: la forma canónica es `synapse build archivo.syn --target wasm`
    // y también `synapse build --release app.syn --target wasm` — el flag
    // global caía a la pipeline como ARCHIVO: "Archivo no encontrado: wasm"
    // (hallazgo REAL-4b de las pruebas de operación como usuario, R182c).
    // Ahora: escaneo argv completo, extraigo flags (--target X, --release,
    // --debug, --safe, --output X, -o X) y deja la primera no-flag como ruta;
    // si NO hay ruta es error de uso rc=1 (antes el flag era el archivo).
    // --release/--debug/--safe/--target se aceptan y marcan el modo; el
    // backend de targets (wasm/llvm) es npm build en pipeline.py — el
    // dispatcher nativo los valida y continúa native (comportamiento
    // declarado en R182a; forma canónica `build --target wasm` via cli.py).
    // cumple Manual 8 §4.2 sin inventar backends inexistentes.
    ruta = ""
    salida_ruta = ""
    inseguro:
        asm("{ CadenaSegura _rr={0,\"\"}; CadenaSegura _oo={0,\"\"}; int _pi3=1;")
        asm("for(_pi3=1;_pi3<_argc();_pi3++){ CadenaSegura _aa=_argv(_pi3); int _hit=0;")
        asm("if(_aa.datos[0]=='-' && _aa.longitud==2 && strcmp(_aa.datos,\"-o\")==0 && _pi3+1<_argc()){ _pi3++; CadenaSegura _nv=_argv(_pi3); char* _d=strdup(_nv.datos); if(_d){ _oo=(CadenaSegura){.longitud=_nv.longitud,.datos=_d}; } _hit=1; }")
        asm("if(!_hit && _aa.datos[0]=='-' && _aa.longitud==8 && strcmp(_aa.datos,\"--output\")==0 && _pi3+1<_argc()){ _pi3++; CadenaSegura _nv=_argv(_pi3); char* _d=strdup(_nv.datos); if(_d){ _oo=(CadenaSegura){.longitud=_nv.longitud,.datos=_d}; } _hit=1; }")
        asm("if(!_hit && _aa.datos[0]=='-' && _aa.longitud==8 && strcmp(_aa.datos,\"--target\")==0 && _pi3+1<_argc()){ _pi3++; CadenaSegura _tv=_argv(_pi3); if(!(strcmp(_tv.datos,\"native\")==0||strcmp(_tv.datos,\"wasm\")==0||strcmp(_tv.datos,\"llvm\")==0)){ fprintf(stderr,\"[Synapse] WARNING: --target %s no soportado por el dispatcher nativo (use cli.py)\\n\",_tv.datos); } _hit=1; }")
        asm("if(!_hit && _aa.datos[0]=='-' && (_aa.longitud==9&&strcmp(_aa.datos,\"--release\")==0 || _aa.longitud==7&&strcmp(_aa.datos,\"--debug\")==0 || _aa.longitud==6&&strcmp(_aa.datos,\"--safe\")==0)){ _hit=1; }")
        asm("if(!_hit && _aa.datos[0]=='-'){ fprintf(stderr,\"Flag no reconocido: %s\\n\",_aa.datos); r=1; return r; }")
        asm("if(!_hit){ if(_rr.longitud==0){ _rr=_aa; } else if(_oo.longitud==0){ _oo=_aa; } }")
        asm("}")
        asm("if(_rr.longitud==0){ fprintf(stderr,\"Uso: %s <archivo.syn> [-o <salida.exe>] | subcomando [flags] [archivo]\\n\",_argv(0).datos); r=1; return r; }")
        asm("char* _dupr=strdup(_rr.datos); if(_dupr){ ruta=(CadenaSegura){.longitud=_rr.longitud,.datos=_dupr}; }")
        asm("if(_oo.datos && _oo.longitud>0){ char* _dupe=strdup(_oo.datos); if(_dupe){ salida_ruta=(CadenaSegura){.longitud=_oo.longitud,.datos=_dupe}; } }")
        asm("}")
        asm("if (ruta.longitud == 0) { r = 1; return r; }")
        // cumple Manual 8 §4.2 (--output): fallback de salida
        asm("// R183d: el fallback predeterminado es <archivo>.exe (base del fuente),")
        asm("// NO synapse_stage2.exe: compilar sin -o sobrescribiria el propio")
        asm("// compilador autoalojado (destruye el bootstrap — detectado al probar")
        asm("// el ME). Manual 8 §4.2 --output/-o MANDA: el fallback SOLO aplica si")
        asm("// no se especifico salida (ni posicional ni flag).")
        asm("if(salida_ruta.longitud==0){")
        asm("  int _rl=(int)strlen(ruta.datos); char _base[512]={0}; int _ri=0, _rlast=-1;")
        asm("  for(_ri=0;_ri<_rl;_ri++){ if(ruta.datos[_ri]=='/'||ruta.datos[_ri]=='\\\\') _rlast=_ri; }")
        asm("  { int _bi=0; for(_ri=_rlast+1;_ri<_rl && _bi<505;_ri++) _base[_bi++]=ruta.datos[_ri]; _base[_bi]=0; }")
        // cumple Manual 9 §6.2: comparacion sin _stricmp (MSVC), que no existe
        // en glibc/macOS; se compara en minusculas sin depender de <strings.h>.
        asm("  int _bl=(int)strlen(_base); if(_bl>4){ const char* _ext=\".syn\"; int _ei=0; for(_ei=0;_ei<4;_ei++){ char _cx=_base[_bl-4+_ei]; if(_cx>='A'&&_cx<='Z') _cx=(char)(_cx+32); if(_cx!=_ext[_ei]) break; } if(_ei==4){ _bl-=4; _base[_bl]=0; } }")
        asm("  if(_bl>0){ char _out2[512]; snprintf(_out2,sizeof(_out2),\"%s.exe\",_base); char* _d=strdup(_out2); if(_d){ salida_ruta=(CadenaSegura){.longitud=(int)strlen(_out2),.datos=_d}; } }")
        asm("  if (salida_ruta.longitud == 0) { salida_ruta = (CadenaSegura){.longitud=19,.datos=\"synapse_stage2.exe\"}; }")
        asm("}")
    // Pipeline nativa: leer -> tokenizar -> parsear -> (F8 stub) -> generar -> GCC
    _resultado = generar_etapa(ruta, salida_ruta, 0)
    si _resultado.tag == 0:
        r = 0
    sino:
        r = fallo_etapa(_resultado.valor)
    retornar r
