        asm("                size_t _tail_len=strlen(_main_pos);")
        asm("                memmove(_main_pos+20,_main_pos,_tail_len+1);")
        asm("                memcpy(_main_pos,\"\\n    _G_safe_mode = 1;\\n    \",20);")
        asm("                FILE* _sfw=fopen(\"synapse_unity.c\",\"wb\"); if(_sfw){ fwrite(_sfbuf,1,strlen(_sfbuf),_sfw); fclose(_sfw); }")
        asm("            }")
        asm("            free(_sfbuf);")
        asm("        } else { fclose(_sf); }")
