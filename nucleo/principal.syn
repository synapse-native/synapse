        // vez, para que gcc y sus binarios auxiliares (as/ld, DLLs) se encuentren.
        asm("if (strcmp(_gcc_exe, \"gcc\") != 0) {")
        asm("    char _gdir[1200]; strcpy(_gdir, _gcc_exe); char* _gs = strrchr(_gdir, '\\\\'); if (_gs) *_gs = 0;")
        asm("    const char* _pv = getenv(\"PATH\");")
        asm("    if (_pv == 0 || strstr(_pv, _gdir) == 0) {")
