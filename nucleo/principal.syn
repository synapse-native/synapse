#lang: es

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar generator_pgo
importar resolvedor_axon
importar cache

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 4 (unico): Generate C code and compile into next-stage binary ---
// NATIVE pipeline: tokenizar -> parsear -> (F8) analizar -> generar -> GCC
funcion generar_etapa(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Pipeline nativa: Unity Build - leyendo nucleo...\\n\");")
        asm("// ORDEN 3 M17.2: Multi-file unity build")
        asm("extern int tokenizar(CadenaSegura); extern struct Programa parsear(CadenaSegura);")
        asm("struct Programa _ast; memset(&_ast,0,sizeof(_ast));")
        asm("struct ListaNodo* _merged = NULL;")
        asm("struct ListaNodo** _mcur = &_merged;")
        asm("int _is_usr = (ruta.longitud > 0 && ruta.datos != NULL && ruta.datos[0] != 0) ? 1 : 0;")
        asm("if (_is_usr) {")
        asm("    fprintf(stderr,\"[Synapse] Compilando archivo: %s...\\n\",ruta.datos);")
        asm("    _P_ntks=0;_P_tpos=0;_P_p_err=0;")
        asm("    FILE* _f=fopen(ruta.datos,\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;}")
        asm("    fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET);")
        asm("    if(_fsz>1048576){fprintf(stderr,\"FATAL: %s >1MB\\n\",ruta.datos);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;}")
        asm("    char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1);")
        asm("    fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0;")
        asm("    CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf};")
        asm("    int _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;}")
        asm("    struct Programa _prog=parsear(_fuente); free(_buf);")
        asm("    struct ListaNodo* _cur=_prog.sentencias;")
        asm("    while(_cur){if(_cur->cabeza){*_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));(*_mcur)->cabeza=_cur->cabeza;(*_mcur)->cola=NULL;_mcur=&(*_mcur)->cola;}_cur=_cur->cola;}")
        asm("} else {")
        asm("    fprintf(stderr,\"[Synapse] Pipeline nativa: Unity Build - leyendo nucleo...\\n\");")
        asm("    const char* _files[] = {\"nucleo/tokens.syn\",\"nucleo/lexer.syn\",\"nucleo/parser.syn\",\"nucleo/analizador_semantico.syn\",\"nucleo/generator.syn\",\"nucleo/principal.syn\",NULL};")
        asm("    for(int _fi=0;_files[_fi];_fi++){ _P_ntks=0;_P_tpos=0;_P_p_err=0; fprintf(stderr,\"[Synapse] Procesando %s...\\n\",_files[_fi]); FILE* _f=fopen(_files[_fi],\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;} fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET); if(_fsz>1048576){fprintf(stderr,\"FATAL:%%s >1MB\\n\",_files[_fi]);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;} char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1); fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0; CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf}; int _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;} struct Programa _prog=parsear(_fuente); free(_buf); struct ListaNodo* _cur=_prog.sentencias; while(_cur){if(_cur->cabeza){*_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));(*_mcur)->cabeza=_cur->cabeza;(*_mcur)->cola=NULL;_mcur=&(*_mcur)->cola;}_cur=_cur->cola;} }")
        asm("}")
        asm("_ast.sentencias = _merged;")
        asm("fprintf(stderr, \"[Synapse] Unity Build: AST fusionado\\n\");")
        asm("")
        asm("// 3b. F8: Convert linked-list AST to flat SemNodo array + run semantic analyzer")
        asm("fputs(\"[Synapse] F8: Analisis semantico\\n\",stderr);")
        asm("enum { F8_MAX_NODOS = 65536, F8_MAX_SYMS = 16384 }")
        asm("static struct SemNodo _f8_nodos[F8_MAX_NODOS];")
        asm("static int _f8_total = 0;")
        asm("static int _f8_ptr_hi[F8_MAX_NODOS]; // High 32 bits for ptr_str on 64-bit")
        asm("static struct SemSimbolo _f8_syms[F8_MAX_SYMS];")
        asm("static struct SemTablaSimbolos _f8_tabla = { .entradas = _f8_syms, .total_entradas = 0, .nivel_actual = 0 };")
        asm("static struct SemEstructuraInfo _f8_structs[64];")
        asm("/* Map string type tag to integer constant */")
        asm("int _f8_tipo(const char* t) {")
        asm("    if(strcmp(t,\"Programa\")==0) return 1;")
        asm("    if(strcmp(t,\"DefinicionFuncion\")==0) return 2;")
        asm("    if(strcmp(t,\"SentenciaSi\")==0) return 3;")
        asm("    if(strcmp(t,\"SentenciaMientras\")==0) return 4;")
        asm("    if(strcmp(t,\"SentenciaRetornar\")==0) return 5;")
        asm("    if(strcmp(t,\"SentenciaExpr\")==0) return 6;")
        asm("    if(strcmp(t,\"AsignacionVariable\")==0) return 7;")
        asm("    if(strcmp(t,\"Identificador\")==0) return 8;")
        asm("    if(strcmp(t,\"LiteralNumero\")==0) return 9;")
        asm("    if(strcmp(t,\"LiteralCadena\")==0) return 11;")
        asm("    if(strcmp(t,\"OpBinaria\")==0) return 12;")
        asm("    if(strcmp(t,\"LlamadaFuncion\")==0) return 14;")
        asm("    if(strcmp(t,\"Parametro\")==0) return 15;")
        asm("    if(strcmp(t,\"DefinicionEstructura\")==0) return 16;")
        asm("    if(strcmp(t,\"BloqueInseguro\")==0) return 24;")
        asm("    if(strcmp(t,\"DeclaracionExterna\")==0) return 26;")
        asm("    if(strcmp(t,\"DeclaracionVariable\")==0) return 34;")
        asm("    if(strcmp(t,\"LogLlamada\")==0) return 35;")
        asm("    return 0;")
        asm("}")
        asm("/* Recursive flatten: returns index of flattened node */")
        asm("int _f8_flatten(struct Nodo* n) {")
        asm("    if(!n) return 0;")
        asm("    if(_f8_total>=F8_MAX_NODOS){ fprintf(stderr,\"FATAL: F8_MAX_NODOS (%d) superado.\\n\",F8_MAX_NODOS); exit(1); }")
        asm("    int idx=_f8_total++;")
        asm("    memset(&_f8_nodos[idx],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[idx].tipo_nodo=_f8_tipo(n->tipo.datos);")
        asm("    const char* _t=n->tipo.datos;")
        asm("    if(strcmp(_t,\"DefinicionFuncion\")==0){")
        asm("        struct DefinicionFuncion* _f=(struct DefinicionFuncion*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_f->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_f->nombre.longitud;")
        asm("        // Params list at slot[6], body at slot[7]")
        asm("        int _pfirst=0,_pprev=0;")
        asm("        struct ListaParametro* _pc=_f->parametros;")
        asm("        while(_pc){ if(_pc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_pc->cabeza); if(_ci){ if(!_pfirst)_pfirst=_ci; if(_pprev)_f8_nodos[_pprev].hermano=_ci; _pprev=_ci; } } _pc=_pc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_pfirst;")
        asm("        int _bfirst=0,_bprev=0;")
        asm("        struct ListaNodo* _c=_f->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_bfirst)_bfirst=_ci; if(_bprev)_f8_nodos[_bprev].hermano=_ci; _bprev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_bfirst;")
        asm("    }else if(strcmp(_t,\"SentenciaSi\")==0){")
        asm("        struct SentenciaSi* _s=(struct SentenciaSi*)n;")
        asm("        // Condition at slot[6], body at slot[7], else at slot[8]")
        asm("        ((int*)&_f8_nodos[idx])[6]=_f8_flatten(_s->condicion);")
        asm("        int _first=0,_prev=0;")
        asm("        struct ListaNodo* _c=_s->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_first;")
        asm("        if(_s->cuerpo_sino){ int _sfirst=0,_sprev=0; _c=_s->cuerpo_sino; while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_sfirst)_sfirst=_ci; if(_sprev)_f8_nodos[_sprev].hermano=_ci; _sprev=_ci; } } _c=_c->cola; } _f8_nodos[idx].hijo_der=_sfirst; }")
        asm("    }else if(strcmp(_t,\"SentenciaMientras\")==0||strcmp(_t,\"BloqueInseguro\")==0){")
        asm("        if(strcmp(_t,\"SentenciaMientras\")==0){")
        asm("            struct SentenciaMientras* _sm=(struct SentenciaMientras*)n;")
        asm("            ((int*)&_f8_nodos[idx])[6]=_f8_flatten(_sm->condicion);")
        asm("            int _first=0,_prev=0;")
        asm("            struct ListaNodo* _c=_sm->cuerpo;")
        asm("            while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("            _f8_nodos[idx].hijo_izq=_first;")
        asm("        }else{")
        asm("            struct BloqueInseguro* _bi=(struct BloqueInseguro*)n;")
        asm("            int _first=0,_prev=0;")
        asm("            struct ListaNodo* _c=_bi->cuerpo;")
        asm("            while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("            ((int*)&_f8_nodos[idx])[6]=_first;")
        asm("        }")
        asm("    }else if(strcmp(_t,\"AsignacionVariable\")==0){")
        asm("        struct AsignacionVariable* _a=(struct AsignacionVariable*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_a->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        if(_a->expresion){ int _ci=_f8_flatten(_a->expresion); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"DeclaracionVariable\")==0){")
        asm("        struct DeclaracionVariable* _d=(struct DeclaracionVariable*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_d->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        if(_d->expresion){ int _ci=_f8_flatten(_d->expresion); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"SentenciaExpr\")==0){")
        asm("        struct SentenciaExpr* _e=(struct SentenciaExpr*)n;")
        asm("        if(_e->expr){ int _ci=_f8_flatten(_e->expr); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"AsignacionCampo\")==0){")
        asm("        struct AsignacionCampo* _ac=(struct AsignacionCampo*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_ac->nombre_campo.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_ac->nombre_campo.longitud;")
        asm("        if(_ac->objeto){ int _ci=_f8_flatten(_ac->objeto); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("        if(_ac->expresion){ int _ci=_f8_flatten(_ac->expresion); _f8_nodos[idx].hijo_izq=_ci; }")
        asm("    }else if(strcmp(_t,\"SentenciaRetornar\")==0){")
        asm("        struct SentenciaRetornar* _r=(struct SentenciaRetornar*)n;")
        asm("        if(_r->expr){ int _ci=_f8_flatten(_r->expr); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"LlamadaFuncion\")==0){")
        asm("        struct LlamadaFuncion* _l=(struct LlamadaFuncion*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_l->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        if(_l->argumentos){ int _first=0,_prev=0; struct ListaNodo* _c=_l->argumentos; while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; } ((int*)&_f8_nodos[idx])[6]=_first; }")
        asm("    }else if(strcmp(_t,\"OpBinaria\")==0){")
        asm("        struct OpBinaria* _o=(struct OpBinaria*)n;")
        asm("        int _ci_l=_f8_flatten(_o->izquierdo);")
        asm("        int _ci_r=_f8_flatten(_o->derecho);")
        asm("        if(_o->operador) _f8_nodos[idx].ptr_str=_o->operador->tipo;")
        asm("        ((int*)&_f8_nodos[idx])[6]=_ci_l;")
        asm("        _f8_nodos[idx].hijo_izq=_ci_r;")
        asm("    }else if(strcmp(_t,\"Identificador\")==0){")
        asm("        struct Identificador* _id=(struct Identificador*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_id->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_id->nombre.longitud;")
        asm("    }else if(strcmp(_t,\"ExprAccesoCampo\")==0){")
        asm("        struct ExprAccesoCampo* _eac=(struct ExprAccesoCampo*)n;")
        asm("        if(_eac->objeto){ int _ci=_f8_flatten(_eac->objeto); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("        { uintptr_t _tp=(uintptr_t)_eac->nombre_campo.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_eac->nombre_campo.longitud;")
        asm("    }")
        asm("    return idx;")
        asm("}")
        asm("/* Build flat array from top-level nodes */")
        asm("_f8_total=0;")
        asm("static struct SemSimbolo _f8_syms_data[F8_MAX_SYMS];")
        asm("memset(&_f8_syms_data,0,sizeof(_f8_syms_data));")
        asm("_f8_tabla.entradas=_f8_syms_data; _f8_tabla.total_entradas=0; _f8_tabla.nivel_actual=0;")
        asm("memset(&_f8_structs,0,sizeof(_f8_structs));")
        asm("{")
        asm("    int _first=0,_prev=0;")
        asm("    struct ListaNodo* _c=_ast.sentencias;")
        asm("    while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("    int _root=_f8_total;")
        asm("    memset(&_f8_nodos[_root],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[_root].tipo_nodo=1; _f8_nodos[_root].hijo_izq=_first;")
        asm("    _f8_total++;")
        asm("}")
        asm("fprintf(stderr,\"[Synapse] F8: %d nodos aplanados\\n\",_f8_total);")
        asm("/* Setup analyzer state and call analizar() */")
        asm("struct AnalizadorSemanticoEst _sem_est;")
        asm("memset(&_sem_est,0,sizeof(_sem_est));")
        asm("_sem_est.nodos=_f8_nodos;")
        asm("_sem_est.total_nodos=_f8_total;")
        asm("_sem_est.tabla=&_f8_tabla;")
        asm("_sem_est.info_estructuras=_f8_structs;")
        asm("_sem_est.func_retorno=(CadenaSegura){0,\"\"};")
        asm("_sem_est.func_actual=(CadenaSegura){0,\"\"};")
        asm("_sem_est.asignaciones_campos_campo=(CadenaSegura){.longitud=F8_MAX_NODOS,.datos=(char*)_f8_ptr_hi};")
        asm("analizar(_sem_est);")
        asm("fprintf(stderr,\"[Synapse] F8: Analisis completado\\n\");")
        asm("// 4. Generar codigo C desde AST")
        asm("extern int generar(struct Programa, CadenaSegura);")
        asm("CadenaSegura _salida_c = { .longitud = salida.longitud, .datos = salida.datos };")
        asm("int _gen_rc = generar(_ast, _salida_c);")
        asm("if (_gen_rc != 0) { struct ResultadoEtapa _e = {1, 4}; return _e; }")
        asm("")
        asm("// 5. Compilar con GCC")
        asm("char _cmd[4096];")
        asm("snprintf(_cmd, 4096, \"gcc -O2 -Wl,--stack,8388608 -Wl,--gc-sections -I. synapse_unity.c synapse_rt.o tweetnacl.o -o \\\"%s\\\" -lpthread -lm -lws2_32\", salida.datos);")
        asm("fprintf(stderr, \"[Synapse] GCC: %s\\n\", _cmd);")
        asm("int _gcc_rc = system(_cmd);")
        asm("if (_gcc_rc != 0) {")
        asm("    fprintf(stderr, \"[Synapse] ERROR: GCC fallo con codigo %d\\n\", _gcc_rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] Compilacion nativa exitosa\\n\");")
    retornar etapa_ok()

funcion principal() -> entero:
    r = 0
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %s <archivo.syn> [salida.exe]\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); fprintf(stderr, \"  %s axon fetch    - Leer y validar axon.toml\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    cmd = argv_str(1)
    // --- Subcomando: axon (single asm block to avoid ; between if/else) ---
    inseguro:
        asm("typedef struct { CadenaSegura clave; void* valor; } _AxnPar; typedef struct { int tipo; CadenaSegura valor_str; _AxnPar* pares; int longitud; } _AxnRoot; extern _AxnRoot _toml_parse(CadenaSegura); extern void _syn_axon_limpiar_toml(void*); extern int _syn_axon_buscar_local(const char*,const char*,char*,int,char*,int);")
        asm("if(strcmp(cmd.datos,\"axon\")==0){ if(_argc()<3){fprintf(stderr,\"Uso: %%s axon fetch\\n\",_argv(0).datos);r=1;return r;} CadenaSegura _sub=_argv(2);")
        asm("if(strcmp(_sub.datos,\"fetch\")==0){")
        asm("    fprintf(stderr,\"[Axon] Leyendo axon.toml...\\n\");")
        asm("    FILE*_f=fopen(\"axon.toml\",\"rb\"); if(!_f){fprintf(stderr,\"[Axon] ERROR: axon.toml no encontrado\\n\");r=1;return r;}")
        asm("    fseek(_f,0,SEEK_END);long _sz=ftell(_f);fseek(_f,0,SEEK_SET);")
        asm("    char*_b=(char*)malloc((size_t)_sz+1); if(!_b){fclose(_f);fprintf(stderr,\"[Axon] ERROR: malloc fallo\\n\");r=1;return r;}")
        asm("    size_t _rd=fread(_b,1,(size_t)_sz,_f);fclose(_f);_b[_rd]=0;")
        asm("    _AxnRoot _rt=_toml_parse((CadenaSegura){.longitud=(int)_rd,.datos=_b});")
        asm("    if(_rt.tipo<0){fprintf(stderr,\"[Axon] ERROR: TOML invalido\\n\");free(_b);r=1;return r;}")
        asm("    fprintf(stderr,\"[Axon] TOML: %%d secciones\\n\",_rt.longitud);")
        asm("    // Create cache directory")
        asm("    system(\"mkdir .axon_cache 2>nul\"); system(\"mkdir axon_modules 2>nul\");")
        asm("    // Parse --online flag (default: offline strict)")
        asm("    int _online = 0; for(int _ai=3;_ai<_argc();_ai++){ CadenaSegura _a=_argv(_ai); if(strcmp(_a.datos,\"--online\")==0){ _online=1; break; } }")
        asm("    fprintf(stderr,\"[Axon] Modo: %s\\n\",_online?\"online\":\"offline (air-gapped)\");")
        asm("    // Extract autor (Ed25519 public key) from [paquete] section")
        asm("    char autor[128]=\"\";")
        asm("    for(int _ta=0;_ta<_rt.longitud;_ta++){")
        asm("        if(strcmp(_rt.pares[_ta].clave.datos,\"paquete\")==0){")
        asm("            _AxnRoot*_paq=(_AxnRoot*)_rt.pares[_ta].valor;")
        asm("            for(int _tb=0;_tb<_paq->longitud;_tb++){")
        asm("                if(strcmp(_paq->pares[_tb].clave.datos,\"autor\")==0){")
        asm("                    strncpy(autor,((_AxnRoot*)_paq->pares[_tb].valor)->valor_str.datos,127);")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if(*autor){ fprintf(stderr,\"[Axon] Autor: %s\\n\",autor); }")
        asm("    if(!*autor || strlen(autor)<64){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: clave publica Ed25519 invalida o ausente\\n\"); free(_b); r=1; return r; }")
        asm("    // Iterate dependencies section")
        asm("    for(int _ti=0;_ti<_rt.longitud;_ti++){")
        asm("        if(strcmp(_rt.pares[_ti].clave.datos,\"dependencias\")==0){")
        asm("            _AxnRoot*_dep=(_AxnRoot*)_rt.pares[_ti].valor;")
        asm("            fprintf(stderr,\"[Axon] %%d dependencias encontradas\\n\",_dep->longitud);")
        asm("            for(int _tj=0;_tj<_dep->longitud;_tj++){")
        asm("                CadenaSegura _pkg=_dep->pares[_tj].clave;")
        asm("                _AxnRoot*_pkg_val=(_AxnRoot*)_dep->pares[_tj].valor;")
        asm("                // Extract version from inline table")
        asm("                char _ver[64]=\"\";")
        asm("                for(int _tk=0;_tk<_pkg_val->longitud;_tk++){")
        asm("                    if(strcmp(_pkg_val->pares[_tk].clave.datos,\"version\")==0){")
        asm("                        strncpy(_ver,((_AxnRoot*)_pkg_val->pares[_tk].valor)->valor_str.datos,63);")
        asm("                    }")
        asm("                }")
        asm("                fprintf(stderr,\"[Axon] Procesando: '%%s' v%%s\\n\",_pkg.datos,_ver);")
        asm("                // Build download URL: github.com/synapse-native/PKG/archive/refs/heads/main.tar")
        asm("                char _tar_url[512], _tar_path[512], _extract_dir[512], _lock_path[512];")
        asm("                snprintf(_tar_url,sizeof(_tar_url),\"/synapse-native/%%s/archive/refs/heads/main.tar\",_pkg.datos);")
        asm("                snprintf(_tar_path,sizeof(_tar_path),\".axon_cache/%%s.tar\",_pkg.datos);")
        asm("                snprintf(_extract_dir,sizeof(_extract_dir),\"axon_modules/%%s\",_pkg.datos);")
        asm("                snprintf(_lock_path,sizeof(_lock_path),\"axon.lock\");")
        asm("                extern int _syn_http_get_archivo(CadenaSegura,int,CadenaSegura,const char*);")
        asm("                extern int _syn_axon_verificar_lock(const char*,const char*,const char*,const char*);")
        asm("                extern int _syn_tar_extraer(const char*,const char*);")
        asm("                extern int _syn_axon_verificar_firma(const char*,const char*,const char*); extern int _syn_axon_escribir_lock(const char*,const char*,const char*);")
        asm("                // Step 0: Try local resolution first (offline-first)")
        asm("                int _local_st = _syn_axon_buscar_local(_pkg.datos,_ver,_tar_path,512,_extract_dir,512);")
        asm("                if(_local_st < 0){")
        asm("                    if(!_online){")
        asm("                        fprintf(stderr,\"[Axon] ERR_AXON_NOT_FOUND: %%s v%%s no encontrado localmente (use --online)\n\",_pkg.datos,_ver);")
        asm("                        r=1; free(_b); return r;")
        asm("                    }")
        asm("                    // Online mode: download from HTTP")
        asm("                    fprintf(stderr,\"[Axon] Descargando %%s...\\n\",_pkg.datos);")
        asm("                    CadenaSegura _gh_host={.longitud=14,.datos=\"github.com\"};")
        asm("                    CadenaSegura _gh_path={.longitud=(int)strlen(_tar_url),.datos=_tar_url};")
        asm("                    int _dl=_syn_http_get_archivo(_gh_host,443,_gh_path,_tar_path);")
        asm("                    if(_dl<0){")
        asm("                        fprintf(stderr,\"[Axon] ERROR: No se pudo descargar %%s\\n\",_pkg.datos);")
        asm("                        fprintf(stderr,\"[Axon] ERR_AXON_NOT_FOUND: %%s v%%s (red no disponible)\n\",_pkg.datos,_ver);")
        asm("                        r=1; free(_b); return r;")
        asm("                    }")
        asm("                    fprintf(stderr,\"[Axon] Descargado: %%s\\n\",_tar_path);")
        asm("                }else{")
        asm("                    if(_local_st==0){")
        asm("                        // Already installed, skip")
        asm("                        fprintf(stderr,\"[Axon] Ya instalado: %%s\\n\",_pkg.datos);")
        asm("                        continue;")
        asm("                    }")
        asm("                    fprintf(stderr,\"[Axon] Local: %%s\\n\",_tar_path);")
        asm("                }")
        asm("                // Step 1.5: Verify Ed25519 (mandatory: zero-tolerance, before lock/extract)")
        asm("                char sig_path[512];")
        asm("                FILE* _sf=NULL;")
        asm("                // Try .sig at: 1) alongside tar_path (paquetes_oficiales/), 2) .axon_cache/<pkg>.tar.sig, 3) HTTP")
        asm("                snprintf(sig_path,sizeof(sig_path),\"%s.sig\",_tar_path); _sf=fopen(sig_path,\"rb\");")
        asm("                if(!_sf){ snprintf(sig_path,sizeof(sig_path),\".axon_cache/%s.tar.sig\",_pkg.datos); _sf=fopen(sig_path,\"rb\"); }")
        asm("                if(!_sf && _online){")
        asm("                    char sig_url[512];")
        asm("                    CadenaSegura _gh_host_sig={.longitud=14,.datos=\"github.com\"};")
        asm("                    snprintf(sig_url,sizeof(sig_url),\"/synapse-native/%s/archive/refs/heads/main.tar.sig\",_pkg.datos);")
        asm("                    CadenaSegura _gh_path_sig={.longitud=(int)strlen(sig_url),.datos=sig_url};")
        asm("                    if(_syn_http_get_archivo(_gh_host_sig,443,_gh_path_sig,sig_path)>=0) _sf=fopen(sig_path,\"rb\");")
        asm("                }")
        asm("                // Zero-tolerance: if autor is set but no .sig, abort")
        asm("                if(!_sf && *autor){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: .sig no encontrado\\n\"); remove(_tar_path); r=1; free(_b); return r; }")
        asm("                // Mandatory verification before lock+extract")
        asm("                if(_sf){ fclose(_sf); fprintf(stderr,\"[Axon] Verificando firma Ed25519...\\n\"); int _vf=_syn_axon_verificar_firma(_tar_path,sig_path,autor); if(_vf<0){ fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: firma Ed25519 invalida\\n\"); remove(_tar_path); remove(sig_path); r=1; free(_b); return r; } fprintf(stderr,\"[Axon] Firma Ed25519 verificada correctamente\\n\"); }")
        asm("                // Step 2: Verify/Create lock")
        asm("                int _lk=_syn_axon_verificar_lock(_pkg.datos,_ver,_tar_path,_lock_path);")
        asm("                if(_lk<0){fprintf(stderr,\"[Axon] ERR_AXON_COMPROMISED: hash mismatch\\n\");r=1;free(_b);return r;}")
        asm("                // Step 3: Extract TAR")
        asm("                fprintf(stderr,\"[Axon] Extrayendo a %%s...\\n\",_extract_dir);")
        asm("                _syn_tar_extraer(_tar_path,_extract_dir);")
        asm("                fprintf(stderr,\"[Axon] Instalado: %%s v%%s\\n\",_pkg.datos,_ver);")
        asm("extern CadenaSegura _syn_sha256_archivo(const char* ruta);")
        asm("                CadenaSegura _lk_hash=_syn_sha256_archivo(_tar_path); if(_lk_hash.datos&&_lk_hash.longitud>0){ _syn_axon_escribir_lock(_pkg.datos,_ver,_lk_hash.datos); free((void*)_lk_hash.datos); };")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _syn_axon_limpiar_toml((void*)&_rt); fprintf(stderr,\"[Axon] fetch completado\\n\"); free(_b); r=0; return r;")
        asm("}")
        asm("fprintf(stderr,\"Subcomando desconocido: '%%s'\\n\",_sub.datos); r=1; return r; }")
    // --- Pipeline de compilacion normal ---
    ruta = argv_str(1)
    salida_ruta = argv_str(2)
    inseguro:
        asm("if (ruta.longitud == 0) { r = 1; return r; }")
        asm("if (salida_ruta.longitud == 0) { salida_ruta = (CadenaSegura){.longitud=19,.datos=\"synapse_stage2.exe\"}; }")
    // Pipeline nativa: leer -> tokenizar -> parsear -> (F8 stub) -> generar -> GCC
    _resultado = generar_etapa(ruta, salida_ruta)
    si _resultado.tag == 0:
        r = 0
    sino:
        r = fallo_etapa(_resultado.valor)
    retornar r
