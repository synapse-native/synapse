        asm("// 5. Compilar con GCC")
        asm("char _cmd[4096];")
        // cumple Manual 9 §6.2 (ME r236, H-R234-1): el compilador resuelve el
        // toolchain C por si mismo; antes emitia el literal "gcc" y dependia del
        // PATH, asi que en una instalacion limpia `check` funcionaba pero compilar
        // no (`"gcc" no se reconoce...`). Orden: SYNAPSE_GCC -> gcc junto al
        // binario -> tools\mingw64\bin -> mingw64\bin -> ..\toolchain_gcc12\mingw64\bin
        // (instalador) -> ..\..\toolchain_gcc12\mingw64\bin (checkout) -> "gcc".
        asm("char _gcc_exe[1200];")
        asm("{")
        asm("#ifdef _WIN32")
        asm("    extern unsigned long __stdcall GetModuleFileNameA(void*, char*, unsigned long);")
        asm("    const char* _gcc_env = getenv(\"SYNAPSE_GCC\");")
        asm("    if (_gcc_env && _gcc_env[0]) { snprintf(_gcc_exe, sizeof _gcc_exe, \"%s\", _gcc_env); }")
        asm("    else {")
        asm("        char _mdir[1024]; char _cand[1200]; int _found = 0;")
        asm("        unsigned long _mn = GetModuleFileNameA(0, _mdir, 1024);")
        asm("        if (_mn != 0) { char* _msl = strrchr(_mdir, '\\\\'); if (_msl) *_msl = 0; } else { strcpy(_mdir, \".\"); }")
        asm("        const char* _rel[] = { \"gcc.exe\", \"toolchain_gcc12\\\\mingw64\\\\bin\\\\gcc.exe\", \"tools\\\\mingw64\\\\bin\\\\gcc.exe\", \"mingw64\\\\bin\\\\gcc.exe\", \"..\\\\toolchain_gcc12\\\\mingw64\\\\bin\\\\gcc.exe\", \"..\\\\..\\\\toolchain_gcc12\\\\mingw64\\\\bin\\\\gcc.exe\", 0 };")
        asm("        for (int _ci = 0; _rel[_ci]; _ci++) { snprintf(_cand, sizeof _cand, \"%s\\\\%s\", _mdir, _rel[_ci]); FILE* _cf = fopen(_cand, \"rb\"); if (_cf) { fclose(_cf); snprintf(_gcc_exe, sizeof _gcc_exe, \"%s\", _cand); _found = 1; break; } }")
        asm("        if (!_found) strcpy(_gcc_exe, \"gcc\");")
        asm("    }")
        asm("#else")
        asm("    const char* _gcc_env = getenv(\"SYNAPSE_GCC\"); if (_gcc_env && _gcc_env[0]) { snprintf(_gcc_exe, sizeof _gcc_exe, \"%s\", _gcc_env); } else { strcpy(_gcc_exe, \"gcc\"); }")
        asm("#endif")
        // El compilador C se invoca como \"gcc\" sin comillas (paridad con el comando
        // historico y con las reglas de comillas de cmd.exe: citar el primer token
        // junto a -I\".\" hacia que cmd no resolviera la ruta). Lo que se ajusta es el
