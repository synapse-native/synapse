#lang: es

constante EXITO = 0
constante ERROR_CLI = 1
constante ERROR_LECTURA = 2
constante ERROR_LEXICO = 3
constante ERROR_SINTACTICO = 4
constante ERROR_SEMANTICO = 5
constante ERROR_GENERACION = 6

estructura ResultadoEtapa:
    tag: entero
    valor: entero

funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    r.valor = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

funcion tokenizar_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("char _cmd[2048];")
        asm("snprintf(_cmd, sizeof(_cmd), \"python -c \\\"import sys; sys.path.insert(0,'.'); from compilador.lexer2 import Lexer; l=Lexer(); f=open('%%s','r',encoding='utf-8'); s=f.read(); f.close(); l.tokenizar(s); print('OK')\\\" %%s\", ruta.datos, ruta.datos);")
        asm("int _rc = system(_cmd);")
        asm("if (_rc != 0) { struct ResultadoEtapa _e = {1, ERROR_LEXICO}; return _e; }")
    retornar etapa_ok()

funcion parsear_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("char _cmd[2048];")
        asm("snprintf(_cmd, sizeof(_cmd), \"python -c \\\"import sys; sys.path.insert(0,'.'); from compilador.parser2 import Parser; from compilador.lexer2 import Lexer; l=Lexer(); f=open('%%s','r',encoding='utf-8'); s=f.read(); f.close(); l.tokenizar(s); p=Parser(l); p.parsear(); print('OK')\\\" %%s\", ruta.datos, ruta.datos);")
        asm("int _rc = system(_cmd);")
        asm("if (_rc != 0) { struct ResultadoEtapa _e = {1, ERROR_SINTACTICO}; return _e; }")
    retornar etapa_ok()

funcion analizar_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("char _cmd[2048];")
        asm("snprintf(_cmd, sizeof(_cmd), \"python -c \\\"import sys; sys.path.insert(0,'.'); from main import compilar_desde_texto; compilar_desde_texto('%%s',set(),'.',False); print('OK')\\\" %%s\", ruta.datos, ruta.datos);")
        asm("int _rc = system(_cmd);")
        asm("if (_rc != 0) { struct ResultadoEtapa _e = {1, ERROR_SEMANTICO}; return _e; }")
    retornar etapa_ok()

funcion generar_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("char _cmd[2048];")
        asm("snprintf(_cmd, sizeof(_cmd), \"python main.py %%s\", ruta.datos);")
        asm("int _rc = system(_cmd);")
        asm("if (_rc != 0) { struct ResultadoEtapa _e = {1, ERROR_GENERACION}; return _e; }")
        asm("fprintf(stderr, \"Compilacion exitosa\\n\");")
    retornar etapa_ok()

funcion principal() -> entero:
    r = EXITO
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %%s <archivo.syn>\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    ruta = argv_str(1)
    inseguro:
        asm("if (ruta.longitud == 0) { r = ERROR_CLI; return r; }")
    coincidir tokenizar_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir parsear_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir analizar_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir generar_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    retornar r
