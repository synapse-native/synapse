        asm("int _is_release=0;")
        asm("for(int _pi=2;_pi<_argc();_pi++){ CadenaSegura _pa=_argv(_pi); if(_pa.longitud==9&&strcmp(_pa.datos,\"--release\")==0){ _is_release=1; break; } }")
        asm("// --debug: -O0 -g -fsanitize=address,undefined (Manual 8 §4.2)")
