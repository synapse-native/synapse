        asm("const char* _gcc_flags = \"\";")
        asm("const char* _gcc_defines = \"\";")
        asm("for(int _pi=2;_pi<_argc();_pi++){ CadenaSegura _pa=_argv(_pi); if(_pa.longitud>9&&strcmp(_pa.datos,\"--profile\")==0&&_pi<_argc()-1){ CadenaSegura _pv=_argv(_pi+1); if(strcmp(_pv.datos,\"release-pgo\")==0){ _gcc_flags=\"-fprofile-generate\"; }else if(strcmp(_pv.datos,\"release-pgo-use\")==0){ _gcc_flags=\"-fprofile-use -flto\"; }else{ fprintf(stderr,\"[Synapse] WARNING: perfil desconocido '%s', ignorado\\n\",_pv.datos); } break; } }")
        asm("// M22.5: --safe flag (lifetime assertions) — inyectar _G_safe_mode = 1 en el C generado")
        asm("int _synapse_safe=0;")
        asm("for(int _si=2;_si<_argc();_si++){ CadenaSegura _sa=_argv(_si); if(_sa.longitud==6&&strcmp(_sa.datos,\"--safe\")==0){ _synapse_safe=1; fprintf(stderr,\"[Synapse] --safe mode activado: inyectando _G_safe_mode = 1 en el C generado\\n\"); break; } }")
        asm("if(_synapse_safe){")
        asm("    FILE* _sf=fopen(\"synapse_unity.c\",\"rb\"); if(_sf){")
        asm("        fseek(_sf,0,SEEK_END); long _sfsz=ftell(_sf); fseek(_sf,0,SEEK_SET);")
        asm("        char* _sfbuf=(char*)malloc((size_t)_sfsz+1024); if(_sfbuf){")
        asm("            size_t _sfrd=fread(_sfbuf,1,(size_t)_sfsz,_sf); fclose(_sf);")
