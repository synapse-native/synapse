#lang: es

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar resolvedor_axon

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    r.valor = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 1: Tokenize ---
funcion tokenizar_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("FILE* _f = fopen(ruta.datos, \"rb\");")
        asm("if (!_f) { struct ResultadoEtapa _e = {1, 2}; return _e; }")
        asm("fseek(_f, 0, SEEK_END); long _fsz = ftell(_f); fseek(_f, 0, SEEK_SET);")
        asm("char* _buf = (char*)malloc((size_t)_fsz + 1);")
        asm("if (!_buf) { fclose(_f); struct ResultadoEtapa _e = {1, 2}; return _e; }")
        asm("fread(_buf, 1, (size_t)_fsz, _f); fclose(_f); _buf[_fsz] = 0;")
        asm("extern int tokenizar(CadenaSegura);")
        asm("CadenaSegura _cs = {.longitud=(int)_fsz,.datos=_buf}; int _ntok = tokenizar(_cs);")
        asm("free(_buf);")
        asm("if (_ntok < 0) { struct ResultadoEtapa _e = {1, 3}; return _e; }")
    retornar etapa_ok()

// --- Stage 2: Parse ---
funcion parsear_etapa(ruta: cadena) -> ResultadoEtapa:
    inseguro:
        asm("FILE* _f = fopen(ruta.datos, \"rb\");")
        asm("if (!_f) { struct ResultadoEtapa _e = {1, 2}; return _e; }")
        asm("fseek(_f, 0, SEEK_END); long _fsz = ftell(_f); fseek(_f, 0, SEEK_SET);")
        asm("char* _buf = (char*)malloc((size_t)_fsz + 1);")
        asm("fread(_buf, 1, (size_t)_fsz, _f); fclose(_f); _buf[_fsz] = 0;")
        asm("extern int tokenizar(CadenaSegura);")
        asm("CadenaSegura _cs = {.longitud=(int)_fsz,.datos=_buf}; int _ntok = tokenizar(_cs);")
        asm("free(_buf);")
        asm("if (_ntok < 0) { struct ResultadoEtapa _e = {1, 3}; return _e; }")
    retornar etapa_ok()

// --- Stage 3: Semantic Analysis ---
funcion analizar_etapa(ruta: cadena) -> ResultadoEtapa:
    retornar etapa_ok()

// --- Stage 4: Generate C code and compile into next-stage binary ---
// Delegates to the Python reference compiler for bootstrap.
// Once Stage2 == Stage3, the Python dependency is eliminated.
funcion generar_etapa(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Generando codigo C...\\n\");")
        asm("// Build command: python main.py <ruta>")
        asm("char _cmd[4096];")
        asm("snprintf(_cmd, 4096, \"python main.py \\\"%s\\\" -o \\\"%s\\\" 2>&1\", ruta.datos, salida.datos);")
        asm("fprintf(stderr, \"[Synapse] Ejecutando: %%s\\n\", _cmd);")
        asm("int _rc = system(_cmd);")
        asm("if (_rc != 0) {")
        asm("    fprintf(stderr, \"[Synapse] ERROR: Compilacion fallo con codigo %%d\\n\", _rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] Compilacion nativa exitosa\\n\");")
    retornar etapa_ok()

funcion principal() -> entero:
    r = 0
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %%s <archivo.syn> [salida.exe]\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    ruta = argv_str(1)
    salida_ruta = argv_str(2)
    inseguro:
        asm("if (ruta.longitud == 0) { r = 1; return r; }")
        asm("if (salida_ruta.longitud == 0) { salida_ruta = (CadenaSegura){.longitud=19,.datos=\"synapse_stage2.exe\"}; }")
    coincidir tokenizar_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir parsear_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir analizar_etapa(ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    coincidir generar_etapa(ruta, salida_ruta):
        OK(v) => r = 0
        ERR(cod) => retornar fallo_etapa(cod)
    retornar r
