#lang: es
// cumple Manual 2 §1.2: fuente UTF-8 sin BOM (el lexer rechaza BOM/caracteres inválidos).
// --- Imports for Unity Build ---
importar tokens
importar lexer
importar lexer_keywords
importar ast_nodes
importar errores
importar diagnostics
importar parser_constantes
importar parser_base
importar parser_expr
importar parser_stmt
importar parser
importar parser_sentencias
importar parser_declaraciones
importar parser_canales
// FASE A (A4.5): el pipeline Python (S1) tambien debe incluir el puente
// plano->tipado (puente_ast.syn) — paridad con la lista _files[] del unity
// build del SELF-HOSTED (generar_etapa, nucleo/principal.syn) que SI lo
// incluye. El espejo _P_* (retirado) construia el AST tipado directamente y
// ocultaba la ausencia del puente en S1: el wrapper nativo 'parsear' llama
// puente_construir_programa y S1 fallaba al link (implicit declaration).
importar puente_ast
importar tabla_simbolos
importar analizador_semantico
importar lifetimes
importar memoria
importar generator
importar generator_pgo
importar resolvedor_axon
importar cache
// cumple Manual 8 §4.1 (r153 R4, cumple Manual 1 §6, cumple Manual 9 §6.2): backend canónico de lint/fmt/test — los
// módulos nucleo/lint.syn, formatter.syn y reports.syn compilan en AMBAS capas
// (probe r153) y sustituyen a los bloques C embebidos de r152.
importar lint
importar formatter
importar reports
importar coverage
// cumple Manual 9 §3.1/§3.2 (ME r203_update_nativo): backend del comando update.
importar actualizador
// cumple Manual 9 §6.2 (ME coverage_aristas): informe HTML de aristas reales
// (covrep_parsear/coverage_generar_html) consumido por cli_test formato 3.
// M10.1: verificador formal nativo (modo --safe) — paridad S1
// compilador/verificador_formal.py. En el unity build tambien debe figurar en
// _files[] (mas abajo) para que stage1/2/3 lo incluyan al auto-compilarse.
importar verificador_formal

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
    // cumple Manual 8 §4.2 (ME r243): modo de validacion reporta la causa de la etapa.
    // cumple Manual 2 §10.2 (ME r243): mensaje explicativo por categoria de error.
        asm("switch((int)cod){")
        asm("case 1: fprintf(stderr, \"Error de compilacion: sin memoria\\n\"); break;")
        asm("case 2: fprintf(stderr, \"Error de compilacion: no se pudo abrir el archivo de entrada\\n\"); break;")
        asm("case 3: fprintf(stderr, \"Error de compilacion: fallo lexico (ver mensaje anterior)\\n\"); break;")
        asm("case 4: fprintf(stderr, \"Error de compilacion: fallo en la generacion de codigo\\n\"); break;")
        asm("case 5: fprintf(stderr, \"Error de compilacion: fallo del compilador C (GCC)\\n\"); break;")
        asm("case 6: fprintf(stderr, \"Error de compilacion: archivo de entrada mayor a 1MB\\n\"); break;")
        asm("case 7: fprintf(stderr, \"Error de compilacion: modulo importado no encontrado\\n\"); break;")
        asm("case 8: fprintf(stderr, \"Error de compilacion: error de sintaxis (ver mensaje anterior)\\n\"); break;")
        asm("case 9: fprintf(stderr, \"Error de compilacion: verificacion formal fallida\\n\"); break;")
        asm("case 10: fprintf(stderr, \"Error de compilacion: error de analisis semantico (ver mensaje anterior)\\n\"); break;")
        asm("default: fprintf(stderr, \"Error de compilacion (codigo %lld)\\n\", (long long)cod); break;")
        asm("}")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 4 (unico): Generate C code and compile into next-stage binary ---
// NATIVE pipeline: tokenizar -> parsear -> (F8) analizar -> generar -> GCC
// cumple Manual 8 §4.2 (ME check_cli R1): modo_validar=1 activa el modo de
// validación (--check/--no-emit): corta tras el análisis semántico y NUNCA
// genera C, invoca gcc ni escribe el archivo de salida (M8 §5.2: consumido
// por el bucle de corrección de OpenSyn/LSP).
funcion generar_etapa(ruta: cadena, salida: cadena, modo_validar: entero) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Pipeline nativa: Unity Build - leyendo nucleo...\\n\");")
        asm("// ORDEN 3 M17.2: Multi-file unity build")
        asm("extern int64_t tokenizar(CadenaSegura); extern struct Programa parsear(CadenaSegura);") // A5.2 D-7: entero -> int64_t
        asm("struct Programa _ast; memset(&_ast,0,sizeof(_ast));")
        asm("struct ListaNodo* _merged = NULL;")
        asm("struct ListaNodo** _mcur = &_merged;")
        asm("int _is_usr = (ruta.longitud > 0 && ruta.datos != NULL && ruta.datos[0] != 0) ? 1 : 0;")
        asm("const char* _files[] = {\"nucleo/tokens.syn\",\"nucleo/lexer.syn\",\"nucleo/lexer_keywords.syn\",\"nucleo/ast_nodes.syn\",\"nucleo/errores.syn\",\"nucleo/diagnostics.syn\",\"nucleo/parser_constantes.syn\",\"nucleo/parser_base.syn\",\"nucleo/parser_expr.syn\",\"nucleo/parser_stmt.syn\",\"nucleo/parser.syn\",\"nucleo/parser_sentencias.syn\",\"nucleo/parser_declaraciones.syn\",\"nucleo/parser_canales.syn\",\"nucleo/puente_ast.syn\",\"nucleo/tabla_simbolos.syn\",\"nucleo/analizador_semantico.syn\",\"nucleo/lifetimes.syn\",\"nucleo/memoria.syn\",\"nucleo/generator.syn\",\"nucleo/generator_pgo.syn\",\"nucleo/resolvedor_axon.syn\",\"nucleo/verificador_formal.syn\",\"nucleo/lint.syn\",\"nucleo/formatter.syn\",\"nucleo/reports.syn\",\"nucleo/coverage.syn\",\"std/json.syn\",\"std/texto.syn\",\"nucleo/actualizador.syn\",\"nucleo/principal.syn\",NULL};")
        asm("int _ya_incluido = 0;")
        asm("// Paridad pipeline.py:485 / Manual 9 S9.1: unity build SOLO para el compilador")
        asm("// (la ruta del usuario coincide con un modulo de _files[] o termina en principal.syn).")
        asm("// Programas de usuario: compilacion standalone (sin fusionar el nucleo).")
        asm("if (_is_usr) {")
        asm("    // Manual 9 S9.1 determinismo: normalizar separadores de ruta")
        asm("    // para evitar fusion doble con separadores mixtos")
        asm("    char _usr_norm[512]; { int _u=0; for(int _i=0; ruta.datos && ruta.datos[_i] && _u<511; _i++){ char _c=ruta.datos[_i]; if(_c=='\\\\') _c='/'; _usr_norm[_u++]=_c; } _usr_norm[_u]=0; }")
        asm("    for (int _fi2 = 0; _files[_fi2]; _fi2++) {")
        asm("        char _mod_norm[512]; int _m=0; for (int _i=0; _files[_fi2][_i] && _m<511; _i++){ char _c=_files[_fi2][_i]; if(_c=='\\\\') _c='/'; _mod_norm[_m++]=_c; } _mod_norm[_m]=0;")
        asm("        if (strcmp(_mod_norm, _usr_norm) == 0) { _ya_incluido = 1; break; }")
        asm("    }")
        asm("    // pipeline.py:485: ruta_base.endswith(principal) -> es el compilador")
        asm("    int _ul2 = (int)strlen(_usr_norm);")
        asm("    if (_ul2 >= 14 && strcmp(_usr_norm + _ul2 - 14, \"/principal.syn\") == 0) { _ya_incluido = 1; }")
        asm("}")
        asm("if (_ya_incluido) {")
        asm("    // Es el compilador (nucleo/principal.syn o modulo): unity build completo")
        asm("for(int _fi=0;_files[_fi];_fi++){ fprintf(stderr,\"[Synapse] Procesando %s...\\n\",_files[_fi]); FILE* _f=fopen(_files[_fi],\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;} fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET); if(_fsz>1048576){fprintf(stderr,\"FATAL:%%s >1MB\\n\",_files[_fi]);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;} char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1); fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0; CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf}; int _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;} struct Programa _prog=parsear(_fuente); if(_G_parse_error){free(_buf);struct ResultadoEtapa _e={1,8};return _e;} free(_buf); struct ListaNodo* _cur=_prog.sentencias; while(_cur){if(_cur->cabeza){*_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));(*_mcur)->cabeza=_cur->cabeza;(*_mcur)->cola=NULL;_mcur=&(*_mcur)->cola;}_cur=_cur->cola;} }")
        asm("        // R23 (hallazgo R21): dedup first-wins del AST fusionado del")
        asm("        // unity build — todos los simbolos son de MODULOS del compilador")
        asm("        // (tokens/lexer/parser_constantes/diagnostics/errores) y sus espejos")
        asm("        // son legitimos: primer-gana, igual que el dedup por profundidad de")
        asm("        // ME-B9.z (paridad pipeline.py). La REDEFINICION del archivo del")
        asm("        // usuario sigue siendo observable (ruta standalone).")
        asm("        char _seen_sym2[2048][64]; int _seen_sym2_n = 0;")
        asm("        struct ListaNodo* _nd2 = NULL; struct ListaNodo** _nd2cur = &_nd2;")
        asm("        struct ListaNodo* _cur2 = _merged;")
        asm("        while(_cur2){")
        asm("            struct Nodo* _h2 = _cur2->cabeza; struct ListaNodo* _nx2 = _cur2->cola;")
        asm("            int _keep2 = 1;")
        asm("            if(_h2 && _h2->tipo.datos){")
        asm("                const char* _tt2 = _h2->tipo.datos;")
        asm("                const char* _nm2 = 0;")
        asm("                if(strcmp(_tt2,\"DefinicionFuncion\")==0){ struct DefinicionFuncion* _f3=(struct DefinicionFuncion*)_h2; _nm2=_f3->nombre.datos; }")
        asm("                else if(strcmp(_tt2,\"DefinicionEstructura\")==0){ struct DefinicionEstructura* _d3=(struct DefinicionEstructura*)_h2; _nm2=_d3->nombre.datos; }")
        asm("                else if(strcmp(_tt2,\"DeclaracionExterna\")==0){ struct DeclaracionExterna* _x3=(struct DeclaracionExterna*)_h2; _nm2=_x3->nombre.datos; }")
        asm("                else if(strcmp(_tt2,\"AsignacionVariable\")==0){ struct AsignacionVariable* _av3=(struct AsignacionVariable*)_h2; _nm2=_av3->nombre.datos; }")
        asm("                if(_nm2 && _nm2[0]){")
        asm("                    int _dp2=0; for(int _s3=0;_s3<_seen_sym2_n;_s3++){ if(strcmp(_seen_sym2[_s3],_nm2)==0){_dp2=1;break;} }")
        asm("                    if(_dp2){ _keep2=0; }")
        asm("                    else if(_seen_sym2_n<2048){ strncpy(_seen_sym2[_seen_sym2_n],_nm2,63); _seen_sym2[_seen_sym2_n][63]=0; _seen_sym2_n++; }")
        asm("                }")
        asm("            }")
        asm("            if(_keep2){ _cur2->cola = NULL; *_nd2cur = _cur2; _nd2cur = &(*_nd2cur)->cola; }")
        asm("            _cur2 = _nx2;")
        asm("        }")
        asm("        _merged = _nd2;")
        asm("} else {")
        asm("    // Programa de usuario: standalone (Manual 3 S3.1 / paridad pipeline.py:485)")
        asm("        fprintf(stderr,\"[Synapse] Compilando archivo: %s...\\n\",ruta.datos);")
        asm("        FILE* _f=fopen(ruta.datos,\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;}")
        asm("        fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET);")
        asm("        if(_fsz>1048576){fprintf(stderr,\"FATAL: %s >1MB\\n\",ruta.datos);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;}")
        asm("        char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1);")
        asm("        fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0;")
        asm("        CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf};")
        asm("        int64_t _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;}") // A5.2 D-7: entero -> int64_t
        asm("        struct Programa _prog=parsear(_fuente); if(_G_parse_error){free(_buf);struct ResultadoEtapa _e={1,8};return _e;} free(_buf);")
        asm("        // ME-B9.z: _merged se construye inline desde _prog.sentencias (fusion abajo)")
        asm("// ME-B9.z: fusion INLINE de imports (paridad pipeline.py:327-383 / Manual 3 S3.1)")
        asm("// (reemplaza el orden usuario-primero por el orden inline de la referencia:")
        asm("//  cada modulo se expande en el punto de su importar; primero-gana)")
        // cumple Manual 9 §6.2 (ME r243): resolucion de imports relativa al modulo importador.
        asm("char _seen_imp[64][256]; int _seen_imp_n = 0;")
        asm("char _seen_sym[2048][64]; int _seen_sym_n = 0;")
        asm("struct ListaNodo* _stk[64]; char _dirstk[64][512]; int _stk_n = 0;")
        asm("_stk[0] = _prog.sentencias; _stk_n = 1; _dirstk[0][0]=0; { int _dl=-1; for(int _di=0; ruta.datos && ruta.datos[_di]; _di++){ if(ruta.datos[_di]==47||ruta.datos[_di]==92) _dl=_di; } if(_dl>=0){ int _cl=_dl<511?_dl:511; memcpy(_dirstk[0], ruta.datos, _cl); _dirstk[0][_cl]=0; } }")
        asm("while(_stk_n > 0){")
        asm("    struct ListaNodo* _sc = _stk[_stk_n - 1];")
        asm("    if(!_sc){ _stk_n--; continue; }")
        asm("    struct Nodo* _hd = _sc->cabeza;")
        asm("    _stk[_stk_n - 1] = _sc->cola;")
        asm("    if(!_hd || !_hd->tipo.datos) continue;")
        asm("    const char* _tt = _hd->tipo.datos;")
        asm("    if(strcmp(_tt, \"SentenciaImportar\") == 0){")
        asm("        struct SentenciaImportar* _imp = (struct SentenciaImportar*)_hd;")
        asm("        const char* _rt = _imp->ruta.datos;")
        asm("        if(!_rt || !_rt[0]) continue;")
        asm("        int _visto=0;")
        asm("        for(int _vi=0;_vi<_seen_imp_n;_vi++){ if(strcmp(_seen_imp[_vi],_rt)==0){_visto=1;break;} }")
        asm("        if(_visto) continue;")
        asm("        if(_seen_imp_n < 64){ strncpy(_seen_imp[_seen_imp_n],_rt,255); _seen_imp[_seen_imp_n][255]=0; _seen_imp_n++; }")
        asm("        char _path[512]=\"\";")
        asm("        int _res=0;")
        asm("        // H-R275-1 (cumple Manual 8 §4.1): un binario `synapse build` resuelve")
        asm("        // sus modulos tambien junto al ejecutable (dist/bin, dist, raiz), no")
        asm("        // solo en el cwd; antes compilar desde otro directorio fallaba con")
        asm("        // ERR_MODULE_NOT_FOUND aunque el modulo existiera en el repo.")
        asm("        char _exd[512]; _exd[0]=0;")
        asm("        extern char** _g_argv; extern int _g_argc;")
        asm("        if(_g_argc>0 && _g_argv && _g_argv[0]) {")
        asm("            snprintf(_exd,sizeof(_exd),\"%s\",_g_argv[0]);")
        asm("            for(int _ei=(int)strlen(_exd)-1;_ei>=0;_ei--){ if(_exd[_ei]=='/' || _exd[_ei]==92){ _exd[_ei]=0; break; } }")
        asm("        }")
        asm("        if(strncmp(_rt,\"std.\",4)==0){")
        asm("            char _subsl[256]; int _sk=0;")
        asm("            for(int _si=4;_rt[_si]&&_sk<255;_si++){ _subsl[_sk++]= (_rt[_si]=='.')?'/':_rt[_si]; } _subsl[_sk]=0;")
        asm("            const char* _lib = getenv(\"SYNAPSE_LIB_PATH\");")
        asm("            if(_lib && _lib[0]){")
        asm("                snprintf(_path,sizeof(_path),\"%s/%s.syn\",_lib,_subsl);")
        asm("                FILE* _tf=fopen(_path,\"rb\"); if(_tf){ fclose(_tf); _res=1; }")
        asm("                if(!_res){ snprintf(_path,sizeof(_path),\"%s/%s/principal.syn\",_lib,_subsl); FILE* _tf2=fopen(_path,\"rb\"); if(_tf2){ fclose(_tf2); _res=1; } }")
        asm("            }")
        asm("            if(!_res){ snprintf(_path,sizeof(_path),\"std/%s.syn\",_subsl); FILE* _tf=fopen(_path,\"rb\"); if(_tf){ fclose(_tf); _res=1; } }")
        asm("            if(!_res && _exd[0]){ snprintf(_path,sizeof(_path),\"%s/%s.syn\",_exd,_subsl); FILE* _tfe=fopen(_path,\"rb\"); if(_tfe){ fclose(_tfe); _res=1; } }")
        asm("            if(!_res && _exd[0]){ snprintf(_path,sizeof(_path),\"%s/../../std/%s.syn\",_exd,_subsl); FILE* _tfe2=fopen(_path,\"rb\"); if(_tfe2){ fclose(_tfe2); _res=1; } }")
        asm("            if(!_res && _exd[0]){ snprintf(_path,sizeof(_path),\"%s/../std/%s.syn\",_exd,_subsl); FILE* _tfe3=fopen(_path,\"rb\"); if(_tfe3){ fclose(_tfe3); _res=1; } }")
        asm("        } else {")
        asm("            char _rsub[256]; int _rk2=0;")
        asm("            for(int _si=0;_rt[_si]&&_rk2<255;_si++){ _rsub[_rk2++]= (_rt[_si]=='.')?'/':_rt[_si]; } _rsub[_rk2]=0;")
        asm("char _c0[512],_c1[512],_c2[512],_c3[512],_c4[512],_c5[512],_c6[512],_c7[512],_c8[512];")
        asm("_c6[0]=0; _c7[0]=0; _c8[0]=0;")
        asm("if(_exd[0]){ snprintf(_c6,sizeof(_c6),\"%s/%s.syn\",_exd,_rsub); snprintf(_c7,sizeof(_c7),\"%s/../../%s.syn\",_exd,_rsub); snprintf(_c8,sizeof(_c8),\"%s/../%s.syn\",_exd,_rsub); }")
        asm("const char* _cdir = _dirstk[_stk_n - 1];")
        asm("_c0[0]=0; _c1[0]=0;")
        asm("if(_cdir[0]){ snprintf(_c0,sizeof(_c0),\"%s/%s.syn\",_cdir,_rsub); snprintf(_c1,sizeof(_c1),\"%s/%s/principal.syn\",_cdir,_rsub); }")
        asm("snprintf(_c2,sizeof(_c2),\"axon_modules/%s/principal.syn\",_rsub);")
        asm("snprintf(_c3,sizeof(_c3),\"axon_modules/%s.syn\",_rsub);")
        asm("snprintf(_c4,sizeof(_c4),\"%s.syn\",_rsub);")
        asm("snprintf(_c5,sizeof(_c5),\"%s.syn\",_rt);")
        asm("const char* _cands[9]={_c0,_c1,_c2,_c3,_c4,_c5,_c6,_c7,_c8};")
        asm("for(int _ci=0;_ci<9;_ci++){")
        asm("if(!_cands[_ci][0]) continue;")
        asm("FILE* _tf=fopen(_cands[_ci],\"rb\"); if(_tf){ fclose(_tf); strncpy(_path,_cands[_ci],511); _path[511]=0; _res=1; break; }")
        asm("}")
        asm("        }")
        asm("        if(!_res){")
        asm("            fprintf(stderr,\"[Synapse] ERROR: modulo '%s' no encontrado (ERR_MODULE_NOT_FOUND)\\n\",_rt);")
        asm("            struct ResultadoEtapa _e = {1, 7}; return _e;")
        asm("        }")
        asm("        FILE* _mf=fopen(_path,\"rb\"); if(!_mf){ struct ResultadoEtapa _e={1,2}; return _e; }")
        asm("        fseek(_mf,0,SEEK_END); long _msz=ftell(_mf); fseek(_mf,0,SEEK_SET);")
        asm("        if(_msz>1048576){ fprintf(stderr,\"FATAL: %s >1MB\\n\",_path); fclose(_mf); struct ResultadoEtapa _e={1,6}; return _e; }")
        asm("        char* _mb=(char*)malloc((size_t)(_msz<1048576?1048576:_msz)+1);")
        asm("        if(!_mb){ fclose(_mf); struct ResultadoEtapa _e={1,1}; return _e; }")
        asm("        fread(_mb,1,(size_t)_msz,_mf); fclose(_mf); _mb[_msz]=0;")
        asm("        CadenaSegura _msrc={.longitud=(int)_msz,.datos=_mb};")
        asm("        int64_t _mnt=tokenizar(_msrc); if(_mnt<0){ free(_mb); struct ResultadoEtapa _e={1,3}; return _e; }") // A5.2 D-7: entero -> int64_t
        asm("        struct Programa _mprog=parsear(_msrc); if(_G_parse_error){free(_mb);struct ResultadoEtapa _e={1,8};return _e;} free(_mb);")
        asm("        fprintf(stderr,\"[Synapse] Importado: %s -> %s\\n\",_rt,_path);")
        asm("if(_stk_n < 64){")
        asm("int _pl=-1; for(int _pi=0; _path[_pi]; _pi++){ if(_path[_pi]==47||_path[_pi]==92) _pl=_pi; }")
        asm("if(_pl>=0){ int _cl=_pl<511?_pl:511; memcpy(_dirstk[_stk_n], _path, _cl); _dirstk[_stk_n][_cl]=0; } else { _dirstk[_stk_n][0]=0; }")
        asm("_stk[_stk_n] = _mprog.sentencias; _stk_n++;")
        asm("}")
        asm("        continue;")
        asm("    }")
        asm("    const char* _nm=0;")
        asm("    if(strcmp(_tt,\"DefinicionFuncion\")==0){ struct DefinicionFuncion* _f2=(struct DefinicionFuncion*)_hd; _nm=_f2->nombre.datos; }")
        asm("    else if(strcmp(_tt,\"DefinicionEstructura\")==0){ struct DefinicionEstructura* _d2=(struct DefinicionEstructura*)_hd; _nm=_d2->nombre.datos; }")
        asm("    else if(strcmp(_tt,\"DeclaracionExterna\")==0){ struct DeclaracionExterna* _x2=(struct DeclaracionExterna*)_hd; _nm=_x2->nombre.datos; }")
        asm("    // ME-B9.y: dedup de constantes globales top-level (paridad pipeline.py:374 StmtConstante)")
        asm("    else if(strcmp(_tt,\"AsignacionVariable\")==0){ struct AsignacionVariable* _av2=(struct AsignacionVariable*)_hd; _nm=_av2->nombre.datos; }")
        asm("    // R23 (hallazgo R21): el dedup first-wins SOLO aplica a los simbolos")
        asm("    // de MODULOS importados (espejos de constantes/helpers entre modulos")
        asm("    // del compilador: tokens/lexer/parser_constantes/diagnostics/errores).")
        asm("    // Los duplicados del PROPIO archivo del usuario NO se descartan: llegan")
        asm("    // al analizador y REDEFINICION (pasadas 1/2) los reporta con")
        asm("    // linea/columna reales. Profundidad del stack: 1 = archivo principal,")
        asm("    // >1 = modulo importado. Paridad S1 pipeline.py dedup (fix R23).")
        asm("    int _desde_modulo = (_stk_n > 1);")
        asm("    int _aceptar=1;")
        asm("    if(_nm && _nm[0]){")
        asm("        int _dup2=0; for(int _si2=0;_si2<_seen_sym_n;_si2++){ if(strcmp(_seen_sym[_si2],_nm)==0){_dup2=1;break;} }")
        asm("        if(_desde_modulo && _dup2){ _aceptar=0; }")
        asm("        else if(_seen_sym_n<2048){ strncpy(_seen_sym[_seen_sym_n],_nm,63); _seen_sym[_seen_sym_n][63]=0; _seen_sym_n++; }")
        asm("    }")
        asm("    if(_aceptar){")
        asm("        *_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));")
        asm("        (*_mcur)->cabeza=_hd; (*_mcur)->cola=NULL; _mcur=&(*_mcur)->cola;")
        asm("    }")
        asm("}")
        asm("}")
        asm("_ast.sentencias = _merged;")
        asm("fprintf(stderr, \"[Synapse] Unity Build: AST fusionado\\n\");")
        asm("")
        asm("// 3b. F8: Convert linked-list AST to flat SemNodo array + run semantic analyzer")
        asm("fputs(\"[Synapse] F8: Analisis semantico\\n\",stderr);")
        asm("enum { F8_MAX_NODOS = 65536, F8_MAX_SYMS = 65536 }")
        asm("static struct SemNodo _f8_nodos[F8_MAX_NODOS];")
        asm("static int _f8_total = 0;")
        asm("static int _f8_ptr_hi[F8_MAX_NODOS]; // High 32 bits for ptr_str on 64-bit")
        asm("static struct SemSimbolo _f8_syms[F8_MAX_SYMS];")
        asm("static struct SemTablaSimbolos _f8_tabla = { .entradas = _f8_syms, .total_entradas = 0, .nivel_actual = 0, .max_entradas = F8_MAX_SYMS };")
        asm("static struct SemEstructuraInfo _f8_structs[256];")
        asm("static struct SemPrestamo _f8_prestamos[F8_MAX_SYMS];")
        asm("static struct RegionConstraint _f8_rg_constraints[F8_MAX_SYMS];")
        asm("static struct RegionGraph _f8_rg;")
        asm("static int _f8_uf_parent[F8_MAX_SYMS];")
        asm("static int _f8_uf_rank[F8_MAX_SYMS];")
        asm("static struct UnionFind _f8_uf;")
        asm("static int _f8_lt_kind[F8_MAX_SYMS];")
        asm("static int _f8_lt_ambito[F8_MAX_SYMS];")
        asm("// 2.4 nativa: cadenas tipo_retorno/tipo de parametros (ptr_extra + _f8_ret_hi) y registro de ADTs")
        asm("static char _f8_retbuf[F8_MAX_NODOS][128];")
        asm("static int _f8_ret_hi[F8_MAX_NODOS];")
        asm("static struct SemAdtInfo _f8_adts[256];")
        asm("static struct SemFuncionInfo _f8_funciones[256]; // R1: registro de funciones (nombre -> nodo)")
        asm("/* Map string type tag to integer constant */")
        asm("int _f8_tipo(const char* t) {")
        asm("    if(strcmp(t,\"Programa\")==0) return 1;")
        asm("    if(strcmp(t,\"DefinicionFuncion\")==0) return 2;")
        asm("    if(strcmp(t,\"SentenciaSi\")==0) return 3;")
        asm("    if(strcmp(t,\"SentenciaMientras\")==0) return 4;")
        asm("    if(strcmp(t,\"SentenciaRetornar\")==0) return 5;")
        asm("    if(strcmp(t,\"SentenciaExpr\")==0) return 6;")
        asm("    if(strcmp(t,\"AsignacionVariable\")==0) return 7;")
        asm("    if(strcmp(t,\"Identificador\")==0) return 8;")
        asm("    if(strcmp(t,\"LiteralNumero\")==0) return 9;")
        asm("    if(strcmp(t,\"LiteralCadena\")==0) return 11;")
        asm("    if(strcmp(t,\"OpBinaria\")==0) return 12;")
        asm("    if(strcmp(t,\"LlamadaFuncion\")==0) return 14;")
        asm("    // R15: ArgumentoTransferido ->expr y SentenciaLanzar (Manual 4 S3.3)")
        asm("    if(strcmp(t,\"ArgumentoTransferido\")==0) return 30;")
        asm("    if(strcmp(t,\"SentenciaLanzar\")==0) return 18;")
        asm("    if(strcmp(t,\"Parametro\")==0) return 15;")
        asm("    if(strcmp(t,\"DefinicionEstructura\")==0) return 16;")
        asm("    if(strcmp(t,\"BloqueInseguro\")==0) return 24;")
        asm("    if(strcmp(t,\"DeclaracionExterna\")==0) return 26;")
        asm("    if(strcmp(t,\"DeclaracionVariable\")==0) return 34;")
        asm("    if(strcmp(t,\"LogLlamada\")==0) return 35;")
        asm("    if(strcmp(t,\"ExprObtenerDireccion\")==0) return 36;")
        asm("    if(strcmp(t,\"ExprDereferencia\")==0) return 37;")
        asm("    // R14: SentenciaEnviarCanal (use-after-move, Manual 4 S3.3)")
        asm("    if(strcmp(t,\"SentenciaEnviarCanal\")==0) return 42;")
        asm("    // R30 (Manual 2 §2.2 L108): SentenciaPara/Romper/Siguiente visibles")
        asm("    // al analizador (antes tipo 0 -> el cuerpo del para no se analizaba)")
        asm("    if(strcmp(t,\"SentenciaRomper\")==0) return 20;")
        asm("    if(strcmp(t,\"SentenciaSiguiente\")==0) return 21;")
        asm("    if(strcmp(t,\"SentenciaPara\")==0) return 45;")
        asm("    // 2.4 nativa (Fase 2): ADTs y constructores visibles al analizador")
        asm("    if(strcmp(t,\"DeclaracionTipo\")==0) return 51;")
        asm("    if(strcmp(t,\"ConstructorTipo\")==0) return 52;")
        asm("    // R11: NodoCoincidir/NodoCaso (exhaustividad Manual 2 S2.4)")
        asm("    if(strcmp(t,\"NodoCoincidir\")==0) return 38;")
        asm("    if(strcmp(t,\"NodoCaso\")==0) return 39;")
        asm("    return 0;")
        asm("}")
        asm("/* Recursive flatten: returns index of flattened node */")
        asm("int _f8_flatten(struct Nodo* n) {")
        asm("    if(!n) return 0;")
        asm("    if(_f8_total>=F8_MAX_NODOS){ fprintf(stderr,\"FATAL: F8_MAX_NODOS (%d) superado.\\n\",F8_MAX_NODOS); exit(1); }")
        asm("    int idx=_f8_total++;")
        asm("    memset(&_f8_nodos[idx],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[idx].tipo_nodo=_f8_tipo(n->tipo.datos);")
        asm("    const char* _t=n->tipo.datos;")
        asm("    if(strcmp(_t,\"DefinicionFuncion\")==0){")
        asm("        struct DefinicionFuncion* _f=(struct DefinicionFuncion*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_REDEFINICION pasada 2)")
        asm("        _f8_nodos[idx].linea=_f->linea;")
        asm("        _f8_nodos[idx].columna=_f->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_f->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_f->nombre.longitud;")
        asm("        // Params list at slot[6], body at slot[7]")
        asm("        int _pfirst=0,_pprev=0;")
        asm("        struct ListaParametro* _pc=_f->parametros;")
        asm("        while(_pc){ if(_pc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_pc->cabeza); if(_ci){ if(!_pfirst)_pfirst=_ci; if(_pprev)_f8_nodos[_pprev].hermano=_ci; _pprev=_ci; } } _pc=_pc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_pfirst;")
        asm("        int _bfirst=0,_bprev=0;")
        asm("        struct ListaNodo* _c=_f->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_bfirst)_bfirst=_ci; if(_bprev)_f8_nodos[_bprev].hermano=_ci; _bprev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_bfirst;")
        asm("        // 2.4 nativa: tipo_retorno en ptr_extra + _f8_ret_hi")
        asm("        if(_f->tipo_retorno.datos && _f->tipo_retorno.datos[0]){ strncpy(_f8_retbuf[idx],_f->tipo_retorno.datos,127); _f8_retbuf[idx][127]=0; uintptr_t _rp=(uintptr_t)_f8_retbuf[idx]; _f8_nodos[idx].ptr_extra=(int)(_rp&0xFFFFFFFFu); _f8_ret_hi[idx]=(int)(_rp>>32); }")
        asm("    }else if(strcmp(_t,\"DefinicionEstructura\")==0){")
        asm("        // Manual 3 S3.2: SemNodo aplanado - la estructura registra su nombre (ptr_str/ptr_hi)")
        asm("        struct DefinicionEstructura* _de=(struct DefinicionEstructura*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_REDEFINICION pasada 1)")
        asm("        _f8_nodos[idx].linea=_de->linea;")
        asm("        _f8_nodos[idx].columna=_de->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_de->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_de->nombre.longitud;")
        asm("        // Campos de la estructura aplanados como cadena de hermanos; primero en slot[6]")
        asm("        int _ffirst=0,_fprev=0;")
        asm("        struct ListaParametro* _fc=_de->campos;")
        asm("        while(_fc){ if(_fc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_fc->cabeza); if(_ci){ if(!_ffirst)_ffirst=_ci; if(_fprev)_f8_nodos[_fprev].hermano=_ci; _fprev=_ci; } } _fc=_fc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_ffirst;")
        asm("    }else if(strcmp(_t,\"Parametro\")==0){")
        asm("        // Parametro (campo de estructura o parametro de funcion): nombre en ptr_str/ptr_hi")
        asm("        struct Parametro* _pa=(struct Parametro*)n;")
        asm("        // R26: flag de transferencia de ownership -> en valor_int (paridad S1")
        asm("        // es_transferencia; Manual 2 L59-60). No afecta a campos de estructura.")
        asm("        _f8_nodos[idx].valor_int=_pa->es_transferencia;")
        asm("        // R21: linea/columna reales (validacion 2.4 aridad/base en parametros)")
        asm("        _f8_nodos[idx].linea=_pa->linea;")
        asm("        _f8_nodos[idx].columna=_pa->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_pa->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_pa->nombre.longitud;")
        asm("        // 2.4 nativa: tipo del parametro en ptr_extra + _f8_ret_hi (el puente lo guarda en tipo_param, no en tipo)")
        asm("        if(_pa->tipo_param.datos && _pa->tipo_param.datos[0]){ strncpy(_f8_retbuf[idx],_pa->tipo_param.datos,127); _f8_retbuf[idx][127]=0; uintptr_t _rp=(uintptr_t)_f8_retbuf[idx]; _f8_nodos[idx].ptr_extra=(int)(_rp&0xFFFFFFFFu); _f8_ret_hi[idx]=(int)(_rp>>32); }")
        asm("    }else if(strcmp(_t,\"DeclaracionExterna\")==0){")
        asm("        // Manual 3 S3.3 Pasada 2: la declaracion externa registra su nombre en la tabla de simbolos")
        asm("        struct DeclaracionExterna* _dext=(struct DeclaracionExterna*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_REDEFINICION pasada 2)")
        asm("        _f8_nodos[idx].linea=_dext->linea;")
        asm("        _f8_nodos[idx].columna=_dext->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_dext->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_dext->nombre.longitud;")
        asm("        if(_dext->parametros){ int _dfirst=0,_dprev=0; struct ListaParametro* _dc=_dext->parametros; while(_dc){ if(_dc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_dc->cabeza); if(_ci){ if(!_dfirst)_dfirst=_ci; if(_dprev)_f8_nodos[_dprev].hermano=_ci; _dprev=_ci; } } _dc=_dc->cola; } ((int*)&_f8_nodos[idx])[6]=_dfirst; }")
        asm("    }else if(strcmp(_t,\"DeclaracionTipo\")==0){")
        asm("        // 2.4 nativa: nombre en ptr_str/ptr_hi, parametros_tipo <T,E> en slot[6] (hermanos), constructores en hijo_izq")
        asm("        struct DeclaracionTipo* _dt=(struct DeclaracionTipo*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_REDEFINICION ADT)")
        asm("        _f8_nodos[idx].linea=_dt->linea;")
        asm("        _f8_nodos[idx].columna=_dt->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_dt->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_dt->nombre.longitud;")
        asm("        int _pfirst=0,_pprev=0;")
        asm("        struct ListaNodo* _pc=_dt->parametros_tipo;")
        asm("        while(_pc){ if(_pc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_pc->cabeza); if(_ci){ if(!_pfirst)_pfirst=_ci; if(_pprev)_f8_nodos[_pprev].hermano=_ci; _pprev=_ci; } } _pc=_pc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_pfirst;")
        asm("        int _cfirst=0,_cprev=0;")
        asm("        struct ListaNodo* _cc=_dt->constructores;")
        asm("        while(_cc){ if(_cc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_cc->cabeza); if(_ci){ if(!_cfirst)_cfirst=_ci; if(_cprev)_f8_nodos[_cprev].hermano=_ci; _cprev=_ci; } } _cc=_cc->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_cfirst;")
        asm("    }else if(strcmp(_t,\"ConstructorTipo\")==0){")
        asm("        // 2.4 nativa: nombre del constructor en ptr_str/ptr_hi, tipos payload en slot[6]")
        asm("        struct ConstructorTipo* _ct=(struct ConstructorTipo*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_ct->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_ct->nombre.longitud;")
        asm("        int _tfirst=0,_tprev=0;")
        asm("        struct ListaNodo* _tc=_ct->tipos;")
        asm("        while(_tc){ if(_tc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_tc->cabeza); if(_ci){ if(!_tfirst)_tfirst=_ci; if(_tprev)_f8_nodos[_tprev].hermano=_ci; _tprev=_ci; } } _tc=_tc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_tfirst;")
        asm("    }else if(strcmp(_t,\"SentenciaSi\")==0){")
        asm("        struct SentenciaSi* _s=(struct SentenciaSi*)n;")
        asm("        // Condition at slot[6], body at slot[7], else at slot[8]")
        asm("        ((int*)&_f8_nodos[idx])[6]=_f8_flatten(_s->condicion);")
        asm("        int _first=0,_prev=0;")
        asm("        struct ListaNodo* _c=_s->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_first;")
        asm("        if(_s->cuerpo_sino){ int _sfirst=0,_sprev=0; _c=_s->cuerpo_sino; while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_sfirst)_sfirst=_ci; if(_sprev)_f8_nodos[_sprev].hermano=_ci; _sprev=_ci; } } _c=_c->cola; } _f8_nodos[idx].hijo_der=_sfirst; }")
        asm("    }else if(strcmp(_t,\"SentenciaMientras\")==0||strcmp(_t,\"BloqueInseguro\")==0){")
        asm("        if(strcmp(_t,\"SentenciaMientras\")==0){")
        asm("            struct SentenciaMientras* _sm=(struct SentenciaMientras*)n;")
        asm("            ((int*)&_f8_nodos[idx])[6]=_f8_flatten(_sm->condicion);")
        asm("            int _first=0,_prev=0;")
        asm("            struct ListaNodo* _c=_sm->cuerpo;")
        asm("            while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("            _f8_nodos[idx].hijo_izq=_first;")
        asm("        }else{")
        asm("            struct BloqueInseguro* _bi=(struct BloqueInseguro*)n;")
        asm("            int _first=0,_prev=0;")
        asm("            struct ListaNodo* _c=_bi->cuerpo;")
        asm("            while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("            ((int*)&_f8_nodos[idx])[6]=_first;")
        asm("        }")
        asm("    }else if(strcmp(_t,\"SentenciaPara\")==0){")
        asm("        // R30 (Manual 2 §2.2 L108): para IDENT = init mientras cond: bloque")
        asm("        // init en slot[6], cond en hijo_der, cuerpo en hijo_izq (cadena de")
        asm("        // hermanos como mientras), nombre de la variable en ptr_str/len_str.")
        asm("        struct SentenciaPara* _sp=(struct SentenciaPara*)n;")
        asm("        _f8_nodos[idx].linea=_sp->linea;")
        asm("        _f8_nodos[idx].columna=_sp->columna;")
        asm("        if(_sp->nombre.datos){ uintptr_t _tp=(uintptr_t)_sp->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); _f8_nodos[idx].len_str=_sp->nombre.longitud; }")
        asm("        if(_sp->inicializacion){ int _ci=_f8_flatten(_sp->inicializacion); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("        if(_sp->condicion){ _f8_nodos[idx].hijo_der=_f8_flatten(_sp->condicion); }")
        asm("        if(_sp->cuerpo){ int _pfirst=0,_pprev=0; struct ListaNodo* _pc=(struct ListaNodo*)_sp->cuerpo; while(_pc){ if(_pc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_pc->cabeza); if(_ci){ if(!_pfirst)_pfirst=_ci; if(_pprev)_f8_nodos[_pprev].hermano=_ci; _pprev=_ci; } } _pc=_pc->cola; } _f8_nodos[idx].hijo_izq=_pfirst; }")
        asm("    }else if(strcmp(_t,\"SentenciaRomper\")==0||strcmp(_t,\"SentenciaSiguiente\")==0){")
        asm("        // R30: romper/siguiente (Manual 2 L115-116) — sin hijos; solo el")
        asm("        // mapeo de tipo_nodo (los structs tipados no llevan linea/columna).")
        asm("    }else if(strcmp(_t,\"AsignacionVariable\")==0){")
        asm("        struct AsignacionVariable* _a=(struct AsignacionVariable*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_CONSTANTE_INMUTABLE / REDEFINICION)")
        asm("        _f8_nodos[idx].linea=_a->linea;")
        asm("        _f8_nodos[idx].columna=_a->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_a->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        if(_a->expresion){ int _ci=_f8_flatten(_a->expresion); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("        // R9: marcador StmtConstante (puente AsignacionVariable.es_constante=1)")
        asm("        // -> SemNodo.hijo_der (R1 fix: valor_int colisiona con slot[6],")
        asm("        // la parte baja del int64 del campo valor_int, donde el flatten")
        asm("        // guarda la expresion via ((int*)&nodo)[6]; sobreescribir valor_int")
        asm("        // anulaba el RHS de TODA asignacion -> el analizador nunca veia")
        asm("        // las llamadas del RHS y la validacion generica quedaba inerte).")
        asm("        _f8_nodos[idx].hijo_der=_a->es_constante;")
        asm("    }else if(strcmp(_t,\"DeclaracionVariable\")==0){")
        asm("        struct DeclaracionVariable* _d=(struct DeclaracionVariable*)n;")
        asm("        // R21: linea/columna reales (ERR_SEM_REDEFINICION pasada 3)")
        asm("        _f8_nodos[idx].linea=_d->linea;")
        asm("        _f8_nodos[idx].columna=_d->columna;")
        asm("        { uintptr_t _tp=(uintptr_t)_d->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        if(_d->expresion){ int _ci=_f8_flatten(_d->expresion); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"SentenciaExpr\")==0){")
        asm("        struct SentenciaExpr* _e=(struct SentenciaExpr*)n;")
        asm("        if(_e->expr){ int _ci=_f8_flatten(_e->expr); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"SentenciaEnviarCanal\")==0){")
        asm("        // R14: canal (Identificador) en ptr_str/ptr_hi; valor en slot[6]")
        asm("        struct SentenciaEnviarCanal* _ec=(struct SentenciaEnviarCanal*)n;")
        asm("        // R14: linea/columna reales para el diagnostico de use-after-move")
        asm("        _f8_nodos[idx].linea=_ec->linea;")
        asm("        _f8_nodos[idx].columna=_ec->columna;")
        asm("        if(_ec->canal && ((struct Identificador*)_ec->canal)->nombre.datos){ struct Identificador* _cid=(struct Identificador*)_ec->canal; uintptr_t _tp=(uintptr_t)_cid->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        if(_ec->valor){ int _ci=_f8_flatten(_ec->valor); ((int*)&_f8_nodos[idx])[6]=_ci; }")
        asm("    }else if(strcmp(_t,\"SentenciaEscuchar\")==0){")
        asm("        // F3-7 (Manual 2 L113): canal en slot[6] (expresion), cuerpo en")
        asm("        // hijo_izq como cadena de hermanos (paridad SentenciaSi).")
