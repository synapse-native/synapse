#lang: es

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar resolvedor_axon

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 4 (unico): Generate C code and compile into next-stage binary ---
// NATIVE pipeline: tokenizar -> parsear -> (F8) analizar -> generar -> GCC
funcion generar_etapa(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Pipeline nativa: Unity Build - leyendo nucleo...\\n\");")
        asm("// ORDEN 3 M17.2: Multi-file unity build")
        asm("extern int tokenizar(CadenaSegura); extern struct Programa parsear(CadenaSegura);")
        asm("struct Programa _ast; memset(&_ast,0,sizeof(_ast));")
        asm("struct ListaNodo* _merged = NULL;")
        asm("struct ListaNodo** _mcur = &_merged;")
        asm("const char* _files[] = {\"nucleo/tokens.syn\",\"nucleo/lexer.syn\",\"nucleo/parser.syn\",\"nucleo/analizador_semantico.syn\",\"nucleo/generator.syn\",\"nucleo/principal.syn\",NULL};")
        asm("for(int _fi=0;_files[_fi];_fi++){ _P_ntks=0;_P_tpos=0;_P_p_err=0; fprintf(stderr,\"[Synapse] Procesando %%s...\\n\",_files[_fi]); FILE* _f=fopen(_files[_fi],\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;} fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET); if(_fsz>1048576){fprintf(stderr,\"FATAL:%%s >1MB\\n\",_files[_fi]);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;} char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1); fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0; CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf}; int _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;} struct Programa _prog=parsear(_fuente); free(_buf); struct ListaNodo* _cur=_prog.sentencias; while(_cur){if(_cur->cabeza){*_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));(*_mcur)->cabeza=_cur->cabeza;(*_mcur)->cola=NULL;_mcur=&(*_mcur)->cola;}_cur=_cur->cola;} }")
        asm("_ast.sentencias = _merged;")
        asm("fprintf(stderr, \"[Synapse] Unity Build: AST fusionado\\n\");")
        asm("")
        asm("// 3b. F8: Convert linked-list AST to flat SemNodo array + run semantic analyzer")
        asm("fputs(\"[Synapse] F8: Analisis semantico\\n\",stderr);")
        asm("enum { F8_MAX_NODOS = 65536, F8_MAX_SYMS = 16384 }")
        asm("static struct SemNodo _f8_nodos[F8_MAX_NODOS];")
        asm("static int _f8_total = 0;")
        asm("static int _f8_ptr_hi[F8_MAX_NODOS]; // High 32 bits for ptr_str on 64-bit")
        asm("static struct SemSimbolo _f8_syms[F8_MAX_SYMS];")
        asm("static struct SemTablaSimbolos _f8_tabla = { .entradas = _f8_syms, .total_entradas = 0, .nivel_actual = 0 };")
        asm("static struct SemEstructuraInfo _f8_structs[64];")
        asm("/* Map string type tag to integer constant */")
        asm("int _f8_tipo(const char* t) {")
        asm("    if(strcmp(t,\"Programa\")==0) return 1;")
        asm("    if(strcmp(t,\"DefinicionFuncion\")==0) return 2;")
        asm("    if(strcmp(t,\"SentenciaSi\")==0) return 3;")
        asm("    if(strcmp(t,\"SentenciaMientras\")==0) return 4;")
        asm("    if(strcmp(t,\"SentenciaRetornar\")==0) return 5;")
        asm("    if(strcmp(t,\"SentenciaExpr\")==0) return 6;")
        asm("    if(strcmp(t,\"AsignacionVariable\")==0) return 7;")
        asm("    if(strcmp(t,\"Identificador\")==0) return 8;")
        asm("    if(strcmp(t,\"LiteralNumero\")==0) return 9;")
        asm("    if(strcmp(t,\"LiteralCadena\")==0) return 11;")
        asm("    if(strcmp(t,\"OpBinaria\")==0) return 12;")
        asm("    if(strcmp(t,\"LlamadaFuncion\")==0) return 14;")
        asm("    if(strcmp(t,\"Parametro\")==0) return 15;")
        asm("    if(strcmp(t,\"DefinicionEstructura\")==0) return 16;")
        asm("    if(strcmp(t,\"BloqueInseguro\")==0) return 24;")
        asm("    if(strcmp(t,\"DeclaracionExterna\")==0) return 26;")
        asm("    if(strcmp(t,\"DeclaracionVariable\")==0) return 34;")
        asm("    if(strcmp(t,\"LogLlamada\")==0) return 35;")
        asm("    return 0;")
        asm("}")
        asm("/* Recursive flatten: returns index of flattened node */")
        asm("int _f8_flatten(struct Nodo* n) {")
        asm("    if(!n) return 0;")
        asm("    if(_f8_total>=F8_MAX_NODOS){ fprintf(stderr,\"FATAL: F8_MAX_NODOS (%d) superado.\\n\",F8_MAX_NODOS); exit(1); }")
        asm("    int idx=_f8_total++;")
        asm("    memset(&_f8_nodos[idx],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[idx].tipo_nodo=_f8_tipo(n->tipo.datos);")
        asm("    const char* _t=n->tipo.datos;")
        asm("    if(strcmp(_t,\"DefinicionFuncion\")==0){")
        asm("        struct DefinicionFuncion* _f=(struct DefinicionFuncion*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_f->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_f->nombre.longitud;")
        asm("        int _first=0,_prev=0;")
        asm("        struct ListaNodo* _c=_f->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_first;")
        asm("    }else if(strcmp(_t,\"SentenciaSi\")==0){")
        asm("        struct SentenciaSi* _s=(struct SentenciaSi*)n;")
        asm("        int _first=0,_prev=0;")
        asm("        struct ListaNodo* _c=_s->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("        if(_s->cuerpo_sino){ _c=_s->cuerpo_sino; while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; } }")
        asm("        _f8_nodos[idx].hijo_izq=_first;")
        asm("    }else if(strcmp(_t,\"SentenciaMientras\")==0||strcmp(_t,\"BloqueInseguro\")==0){")
        asm("        struct ListaNodo* _c=(strcmp(_t,\"SentenciaMientras\")==0)?((struct SentenciaMientras*)n)->cuerpo:((struct BloqueInseguro*)n)->cuerpo;")
        asm("        int _first=0,_prev=0;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_first;")
        asm("    }else if(strcmp(_t,\"DeclaracionVariable\")==0||strcmp(_t,\"AsignacionVariable\")==0){")
        asm("        struct AsignacionVariable* _a=(struct AsignacionVariable*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_a->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); ((int*)&_f8_nodos[idx])[10]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_a->nombre.longitud;")
        asm("    }")
        asm("    return idx;")
        asm("}")
        asm("/* Build flat array from top-level nodes */")
        asm("_f8_total=0;")
        asm("static struct SemSimbolo _f8_syms_data[F8_MAX_SYMS];")
        asm("memset(&_f8_syms_data,0,sizeof(_f8_syms_data));")
        asm("_f8_tabla.entradas=_f8_syms_data; _f8_tabla.total_entradas=0; _f8_tabla.nivel_actual=0;")
        asm("memset(&_f8_structs,0,sizeof(_f8_structs));")
        asm("{")
        asm("    int _first=0,_prev=0;")
        asm("    struct ListaNodo* _c=_ast.sentencias;")
        asm("    while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_first)_first=_ci; if(_prev)_f8_nodos[_prev].hermano=_ci; _prev=_ci; } } _c=_c->cola; }")
        asm("    int _root=_f8_total;")
        asm("    memset(&_f8_nodos[_root],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[_root].tipo_nodo=1; _f8_nodos[_root].hijo_izq=_first;")
        asm("    _f8_total++;")
        asm("}")
        asm("fprintf(stderr,\"[Synapse] F8: %d nodos aplanados\\n\",_f8_total);")
        asm("/* Setup analyzer state and call analizar() */")
        asm("struct AnalizadorSemanticoEst _sem_est;")
        asm("memset(&_sem_est,0,sizeof(_sem_est));")
        asm("_sem_est.nodos=_f8_nodos;")
        asm("_sem_est.total_nodos=_f8_total;")
        asm("_sem_est.tabla=&_f8_tabla;")
        asm("_sem_est.info_estructuras=_f8_structs;")
        asm("_sem_est.func_retorno=(CadenaSegura){0,\"\"};")
        asm("_sem_est.func_actual=(CadenaSegura){0,\"\"};")
        asm("_sem_est.asignaciones_campos_campo=(CadenaSegura){.longitud=F8_MAX_NODOS,.datos=(char*)_f8_ptr_hi};")
        asm("analizar(_sem_est);")
        asm("fprintf(stderr,\"[Synapse] F8: Analisis completado\\n\");")
        asm("// 4. Generar codigo C desde AST")
        asm("extern int generar(struct Programa, CadenaSegura);")
        asm("CadenaSegura _salida_c = { .longitud = salida.longitud, .datos = salida.datos };")
        asm("int _gen_rc = generar(_ast, _salida_c);")
        asm("if (_gen_rc != 0) { struct ResultadoEtapa _e = {1, 4}; return _e; }")
        asm("")
        asm("// 5. Compilar con GCC")
        asm("char _cmd[4096];")
        asm("snprintf(_cmd, 4096, \"gcc -O2 -Wl,--stack,8388608 -I. synapse_unity.c synapse_rt.o -o \\\"%s\\\" -lpthread -lm -lws2_32\", salida.datos);")
        asm("fprintf(stderr, \"[Synapse] GCC: %s\\n\", _cmd);")
        asm("int _gcc_rc = system(_cmd);")
        asm("if (_gcc_rc != 0) {")
        asm("    fprintf(stderr, \"[Synapse] ERROR: GCC fallo con codigo %d\\n\", _gcc_rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] Compilacion nativa exitosa\\n\");")
    retornar etapa_ok()

funcion principal() -> entero:
    r = 0
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %s <archivo.syn> [salida.exe]\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    ruta = argv_str(1)
    salida_ruta = argv_str(2)
    inseguro:
        asm("if (ruta.longitud == 0) { r = 1; return r; }")
        asm("if (salida_ruta.longitud == 0) { salida_ruta = (CadenaSegura){.longitud=19,.datos=\"synapse_stage2.exe\"}; }")
    // Pipeline nativa: leer -> tokenizar -> parsear -> (F8 stub) -> generar -> GCC
    _resultado = generar_etapa(ruta, salida_ruta)
    si _resultado.tag == 0:
        r = 0
    sino:
        r = fallo_etapa(_resultado.valor)
    retornar r
