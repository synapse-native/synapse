#lang: es

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser_constantes
importar parser_base
importar parser_expr
importar parser_stmt
importar parser
// FASE A (A4.5): el pipeline Python (S1) tambien debe incluir el puente
// plano->tipado (puente_ast.syn) — paridad con la lista _files[] del unity
// build del SELF-HOSTED (generar_etapa, nucleo/principal.syn) que SI lo
// incluye. El espejo _P_* (retirado) construia el AST tipado directamente y
// ocultaba la ausencia del puente en S1: el wrapper nativo 'parsear' llama
// puente_construir_programa y S1 fallaba al link (implicit declaration).
importar puente_ast
importar tabla_simbolos
importar analizador_semantico
importar lifetimes
importar memoria
importar generator
importar generator_pgo
importar resolvedor_axon
importar cache

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 4 (unico): Generate C code and compile into next-stage binary ---
// NATIVE pipeline: tokenizar -> parsear -> (F8) analizar -> generar -> GCC
funcion generar_etapa(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Pipeline nativa: Unity Build - leyendo nucleo...\\n\");")
        asm("// ORDEN 3 M17.2: Multi-file unity build")
        asm("extern int64_t tokenizar(CadenaSegura); extern struct Programa parsear(CadenaSegura);")  // A5.2 D-7: entero -> int64_t
        asm("struct Programa _ast; memset(&_ast,0,sizeof(_ast));")
        asm("struct ListaNodo* _merged = NULL;")
        asm("struct ListaNodo** _mcur = &_merged;")
        asm("int _is_usr = (ruta.longitud > 0 && ruta.datos != NULL && ruta.datos[0] != 0) ? 1 : 0;")
        asm("const char* _files[] = {\"nucleo/tokens.syn\",\"nucleo/lexer.syn\",\"nucleo/ast_nodes.syn\",\"nucleo/errores.syn\",\"nucleo/diagnostics.syn\",\"nucleo/parser_constantes.syn\",\"nucleo/parser_base.syn\",\"nucleo/parser_expr.syn\",\"nucleo/parser_stmt.syn\",\"nucleo/parser.syn\",\"nucleo/puente_ast.syn\",\"nucleo/tabla_simbolos.syn\",\"nucleo/analizador_semantico.syn\",\"nucleo/lifetimes.syn\",\"nucleo/memoria.syn\",\"nucleo/generator.syn\",\"nucleo/generator_pgo.syn\",\"nucleo/resolvedor_axon.syn\",\"nucleo/principal.syn\",NULL};")
        asm("int _ya_incluido = 0;")
        asm("// Paridad pipeline.py:485 / Manual 9 S9.1: unity build SOLO para el compilador")
        asm("// (la ruta del usuario coincide con un modulo de _files[] o termina en principal.syn).")
        asm("// Programas de usuario: compilacion standalone (sin fusionar el nucleo).")
        asm("if (_is_usr) {")
        asm("    // Manual 9 S9.1 determinismo: normalizar separadores de ruta")
        asm("    // para evitar fusion doble con separadores mixtos")
        asm("    char _usr_norm[512]; { int _u=0; for(int _i=0; ruta.datos && ruta.datos[_i] && _u<511; _i++){ char _c=ruta.datos[_i]; if(_c=='\\\\') _c='/'; _usr_norm[_u++]=_c; } _usr_norm[_u]=0; }")
        asm("    for (int _fi2 = 0; _files[_fi2]; _fi2++) {")
        asm("        char _mod_norm[512]; int _m=0; for (int _i=0; _files[_fi2][_i] && _m<511; _i++){ char _c=_files[_fi2][_i]; if(_c=='\\\\') _c='/'; _mod_norm[_m++]=_c; } _mod_norm[_m]=0;")
        asm("        if (strcmp(_mod_norm, _usr_norm) == 0) { _ya_incluido = 1; break; }")
        asm("    }")
        asm("    // pipeline.py:485: ruta_base.endswith(principal) -> es el compilador")
        asm("    int _ul2 = (int)strlen(_usr_norm);")
        asm("    if (_ul2 >= 14 && strcmp(_usr_norm + _ul2 - 14, \"/principal.syn\") == 0) { _ya_incluido = 1; }")
        asm("}")
        asm("if (_ya_incluido) {")
        asm("    // Es el compilador (nucleo/principal.syn o modulo): unity build completo")
        asm("for(int _fi=0;_files[_fi];_fi++){ fprintf(stderr,\"[Synapse] Procesando %s...\\n\",_files[_fi]); FILE* _f=fopen(_files[_fi],\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;} fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET); if(_fsz>1048576){fprintf(stderr,\"FATAL:%%s >1MB\\n\",_files[_fi]);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;} char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1); fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0; CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf}; int _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;} struct Programa _prog=parsear(_fuente); if(_G_parse_error){free(_buf);struct ResultadoEtapa _e={1,8};return _e;} free(_buf); struct ListaNodo* _cur=_prog.sentencias; while(_cur){if(_cur->cabeza){*_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));(*_mcur)->cabeza=_cur->cabeza;(*_mcur)->cola=NULL;_mcur=&(*_mcur)->cola;}_cur=_cur->cola;} }")
        asm("} else {")
        asm("    // Programa de usuario: standalone (Manual 3 S3.1 / paridad pipeline.py:485)")
        asm("        fprintf(stderr,\"[Synapse] Compilando archivo: %s...\\n\",ruta.datos);")
        asm("        FILE* _f=fopen(ruta.datos,\"rb\"); if(!_f){struct ResultadoEtapa _e={1,2};return _e;}")
        asm("        fseek(_f,0,SEEK_END);long _fsz=ftell(_f);fseek(_f,0,SEEK_SET);")
        asm("        if(_fsz>1048576){fprintf(stderr,\"FATAL: %s >1MB\\n\",ruta.datos);fclose(_f);struct ResultadoEtapa _e={1,6};return _e;}")
        asm("        char* _buf=(char*)malloc((size_t)(_fsz<1048576?1048576:_fsz)+1);")
        asm("        fread(_buf,1,(size_t)_fsz,_f);fclose(_f);_buf[_fsz]=0;")
        asm("        CadenaSegura _fuente={.longitud=(int)_fsz,.datos=_buf};")
        asm("        int64_t _ntok=tokenizar(_fuente); if(_ntok<0){free(_buf);struct ResultadoEtapa _e={1,3};return _e;}")  // A5.2 D-7: entero -> int64_t
        asm("        struct Programa _prog=parsear(_fuente); if(_G_parse_error){free(_buf);struct ResultadoEtapa _e={1,8};return _e;} free(_buf);")
        asm("        // ME-B9.z: _merged se construye inline desde _prog.sentencias (fusion abajo)")
        asm("// ME-B9.z: fusion INLINE de imports (paridad pipeline.py:327-383 / Manual 3 S3.1)")
        asm("// (reemplaza el orden usuario-primero por el orden inline de la referencia:")
        asm("//  cada modulo se expande en el punto de su importar; primero-gana)")
        asm("char _seen_imp[64][256]; int _seen_imp_n = 0;")
        asm("char _seen_sym[2048][64]; int _seen_sym_n = 0;")
        asm("struct ListaNodo* _stk[64]; int _stk_n = 0;")
        asm("_stk[0] = _prog.sentencias; _stk_n = 1;")
        asm("while(_stk_n > 0){")
        asm("    struct ListaNodo* _sc = _stk[_stk_n - 1];")
        asm("    if(!_sc){ _stk_n--; continue; }")
        asm("    struct Nodo* _hd = _sc->cabeza;")
        asm("    _stk[_stk_n - 1] = _sc->cola;")
        asm("    if(!_hd || !_hd->tipo.datos) continue;")
        asm("    const char* _tt = _hd->tipo.datos;")
        asm("    if(strcmp(_tt, \"SentenciaImportar\") == 0){")
        asm("        struct SentenciaImportar* _imp = (struct SentenciaImportar*)_hd;")
        asm("        const char* _rt = _imp->ruta.datos;")
        asm("        if(!_rt || !_rt[0]) continue;")
        asm("        int _visto=0;")
        asm("        for(int _vi=0;_vi<_seen_imp_n;_vi++){ if(strcmp(_seen_imp[_vi],_rt)==0){_visto=1;break;} }")
        asm("        if(_visto) continue;")
        asm("        if(_seen_imp_n < 64){ strncpy(_seen_imp[_seen_imp_n],_rt,255); _seen_imp[_seen_imp_n][255]=0; _seen_imp_n++; }")
        asm("        char _path[512]=\"\";")
        asm("        int _res=0;")
        asm("        if(strncmp(_rt,\"std.\",4)==0){")
        asm("            char _subsl[256]; int _sk=0;")
        asm("            for(int _si=4;_rt[_si]&&_sk<255;_si++){ _subsl[_sk++]= (_rt[_si]=='.')?'/':_rt[_si]; } _subsl[_sk]=0;")
        asm("            const char* _lib = getenv(\"SYNAPSE_LIB_PATH\");")
        asm("            if(_lib && _lib[0]){")
        asm("                snprintf(_path,sizeof(_path),\"%s/%s.syn\",_lib,_subsl);")
        asm("                FILE* _tf=fopen(_path,\"rb\"); if(_tf){ fclose(_tf); _res=1; }")
        asm("                if(!_res){ snprintf(_path,sizeof(_path),\"%s/%s/principal.syn\",_lib,_subsl); FILE* _tf2=fopen(_path,\"rb\"); if(_tf2){ fclose(_tf2); _res=1; } }")
        asm("            }")
        asm("            if(!_res){ snprintf(_path,sizeof(_path),\"std/%s.syn\",_subsl); FILE* _tf=fopen(_path,\"rb\"); if(_tf){ fclose(_tf); _res=1; } }")
        asm("        } else {")
        asm("            char _rsub[256]; int _rk2=0;")
        asm("            for(int _si=0;_rt[_si]&&_rk2<255;_si++){ _rsub[_rk2++]= (_rt[_si]=='.')?'/':_rt[_si]; } _rsub[_rk2]=0;")
        asm("            char _c0[512],_c1[512],_c2[512],_c3[512];")
        asm("            snprintf(_c0,sizeof(_c0),\"axon_modules/%s/principal.syn\",_rsub);")
        asm("            snprintf(_c1,sizeof(_c1),\"axon_modules/%s.syn\",_rsub);")
        asm("            snprintf(_c2,sizeof(_c2),\"%s.syn\",_rt);")
        asm("            snprintf(_c3,sizeof(_c3),\"%s.syn\",_rsub);")
        asm("            const char* _cands[4]={_c0,_c1,_c2,_c3};")
        asm("            for(int _ci=0;_ci<4;_ci++){")
        asm("                FILE* _tf=fopen(_cands[_ci],\"rb\"); if(_tf){ fclose(_tf); strncpy(_path,_cands[_ci],511); _path[511]=0; _res=1; break; }")
        asm("            }")
        asm("        }")
        asm("        if(!_res){")
        asm("            fprintf(stderr,\"[Synapse] ERROR: modulo '%s' no encontrado (ERR_MODULE_NOT_FOUND)\\n\",_rt);")
        asm("            struct ResultadoEtapa _e = {1, 7}; return _e;")
        asm("        }")
        asm("        FILE* _mf=fopen(_path,\"rb\"); if(!_mf){ struct ResultadoEtapa _e={1,2}; return _e; }")
        asm("        fseek(_mf,0,SEEK_END); long _msz=ftell(_mf); fseek(_mf,0,SEEK_SET);")
        asm("        if(_msz>1048576){ fprintf(stderr,\"FATAL: %s >1MB\\n\",_path); fclose(_mf); struct ResultadoEtapa _e={1,6}; return _e; }")
        asm("        char* _mb=(char*)malloc((size_t)(_msz<1048576?1048576:_msz)+1);")
        asm("        if(!_mb){ fclose(_mf); struct ResultadoEtapa _e={1,1}; return _e; }")
        asm("        fread(_mb,1,(size_t)_msz,_mf); fclose(_mf); _mb[_msz]=0;")
        asm("        CadenaSegura _msrc={.longitud=(int)_msz,.datos=_mb};")
        asm("        int64_t _mnt=tokenizar(_msrc); if(_mnt<0){ free(_mb); struct ResultadoEtapa _e={1,3}; return _e; }")  // A5.2 D-7: entero -> int64_t
        asm("        struct Programa _mprog=parsear(_msrc); if(_G_parse_error){free(_mb);struct ResultadoEtapa _e={1,8};return _e;} free(_mb);")
        asm("        fprintf(stderr,\"[Synapse] Importado: %s -> %s\\n\",_rt,_path);")
        asm("        if(_stk_n < 64){ _stk[_stk_n++] = _mprog.sentencias; }")
        asm("        continue;")
        asm("    }")
        asm("    const char* _nm=0;")
        asm("    if(strcmp(_tt,\"DefinicionFuncion\")==0){ struct DefinicionFuncion* _f2=(struct DefinicionFuncion*)_hd; _nm=_f2->nombre.datos; }")
        asm("    else if(strcmp(_tt,\"DefinicionEstructura\")==0){ struct DefinicionEstructura* _d2=(struct DefinicionEstructura*)_hd; _nm=_d2->nombre.datos; }")
        asm("    else if(strcmp(_tt,\"DeclaracionExterna\")==0){ struct DeclaracionExterna* _x2=(struct DeclaracionExterna*)_hd; _nm=_x2->nombre.datos; }")
        asm("    // ME-B9.y: dedup de constantes globales top-level (paridad pipeline.py:374 StmtConstante)")
        asm("    else if(strcmp(_tt,\"AsignacionVariable\")==0){ struct AsignacionVariable* _av2=(struct AsignacionVariable*)_hd; _nm=_av2->nombre.datos; }")
        asm("    int _aceptar=1;")
        asm("    if(_nm && _nm[0]){")
        asm("        int _dup2=0; for(int _si2=0;_si2<_seen_sym_n;_si2++){ if(strcmp(_seen_sym[_si2],_nm)==0){_dup2=1;break;} }")
        asm("        if(_dup2){ _aceptar=0; }")
        asm("        else if(_seen_sym_n<2048){ strncpy(_seen_sym[_seen_sym_n],_nm,63); _seen_sym[_seen_sym_n][63]=0; _seen_sym_n++; }")
        asm("    }")
        asm("    if(_aceptar){")
        asm("        *_mcur=(struct ListaNodo*)calloc(1,sizeof(struct ListaNodo));")
        asm("        (*_mcur)->cabeza=_hd; (*_mcur)->cola=NULL; _mcur=&(*_mcur)->cola;")
        asm("    }")
        asm("}")
        asm("}")
        asm("_ast.sentencias = _merged;")
        asm("fprintf(stderr, \"[Synapse] Unity Build: AST fusionado\\n\");")
        asm("")
        asm("// 3b. F8: Convert linked-list AST to flat SemNodo array + run semantic analyzer")
        asm("fputs(\"[Synapse] F8: Analisis semantico\\n\",stderr);")
        asm("enum { F8_MAX_NODOS = 65536, F8_MAX_SYMS = 65536 }")
        asm("static struct SemNodo _f8_nodos[F8_MAX_NODOS];")
        asm("static int _f8_total = 0;")
        asm("static int _f8_ptr_hi[F8_MAX_NODOS]; // High 32 bits for ptr_str on 64-bit")
        asm("static struct SemSimbolo _f8_syms[F8_MAX_SYMS];")
        asm("static struct SemTablaSimbolos _f8_tabla = { .entradas = _f8_syms, .total_entradas = 0, .nivel_actual = 0, .max_entradas = F8_MAX_SYMS };")
        asm("static struct SemEstructuraInfo _f8_structs[256];")
        asm("static struct SemPrestamo _f8_prestamos[F8_MAX_SYMS];")
        asm("static struct RegionConstraint _f8_rg_constraints[F8_MAX_SYMS];")
        asm("static struct RegionGraph _f8_rg;")
        asm("static int _f8_uf_parent[F8_MAX_SYMS];")
        asm("static int _f8_uf_rank[F8_MAX_SYMS];")
        asm("static struct UnionFind _f8_uf;")
        asm("static int _f8_lt_kind[F8_MAX_SYMS];")
        asm("static int _f8_lt_ambito[F8_MAX_SYMS];")
        asm("// 2.4 nativa: cadenas tipo_retorno/tipo de parametros (ptr_extra + _f8_ret_hi) y registro de ADTs")
        asm("static char _f8_retbuf[F8_MAX_NODOS][128];")
        asm("static int _f8_ret_hi[F8_MAX_NODOS];")
        asm("static struct SemAdtInfo _f8_adts[256];")
        asm("static struct SemFuncionInfo _f8_funciones[256]; // R1: registro de funciones (nombre -> nodo)")
        asm("/* Map string type tag to integer constant */")
        asm("int _f8_tipo(const char* t) {")
        asm("    if(strcmp(t,\"Programa\")==0) return 1;")
        asm("    if(strcmp(t,\"DefinicionFuncion\")==0) return 2;")
        asm("    if(strcmp(t,\"SentenciaSi\")==0) return 3;")
        asm("    if(strcmp(t,\"SentenciaMientras\")==0) return 4;")
        asm("    if(strcmp(t,\"SentenciaRetornar\")==0) return 5;")
        asm("    if(strcmp(t,\"SentenciaExpr\")==0) return 6;")
        asm("    if(strcmp(t,\"AsignacionVariable\")==0) return 7;")
        asm("    if(strcmp(t,\"Identificador\")==0) return 8;")
        asm("    if(strcmp(t,\"LiteralNumero\")==0) return 9;")
        asm("    if(strcmp(t,\"LiteralCadena\")==0) return 11;")
        asm("    if(strcmp(t,\"OpBinaria\")==0) return 12;")
        asm("    if(strcmp(t,\"LlamadaFuncion\")==0) return 14;")
        asm("    if(strcmp(t,\"Parametro\")==0) return 15;")
        asm("    if(strcmp(t,\"DefinicionEstructura\")==0) return 16;")
        asm("    if(strcmp(t,\"BloqueInseguro\")==0) return 24;")
        asm("    if(strcmp(t,\"DeclaracionExterna\")==0) return 26;")
        asm("    if(strcmp(t,\"DeclaracionVariable\")==0) return 34;")
        asm("    if(strcmp(t,\"LogLlamada\")==0) return 35;")
        asm("    if(strcmp(t,\"ExprObtenerDireccion\")==0) return 36;")
        asm("    if(strcmp(t,\"ExprDereferencia\")==0) return 37;")
        asm("    // 2.4 nativa (Fase 2): ADTs y constructores visibles al analizador")
        asm("    if(strcmp(t,\"DeclaracionTipo\")==0) return 51;")
        asm("    if(strcmp(t,\"ConstructorTipo\")==0) return 52;")
        asm("    // R11: NodoCoincidir/NodoCaso (exhaustividad Manual 2 S2.4)")
        asm("    if(strcmp(t,\"NodoCoincidir\")==0) return 38;")
        asm("    if(strcmp(t,\"NodoCaso\")==0) return 39;")
        asm("    return 0;")
        asm("}")
        asm("/* Recursive flatten: returns index of flattened node */")
        asm("int _f8_flatten(struct Nodo* n) {")
        asm("    if(!n) return 0;")
        asm("    if(_f8_total>=F8_MAX_NODOS){ fprintf(stderr,\"FATAL: F8_MAX_NODOS (%d) superado.\\n\",F8_MAX_NODOS); exit(1); }")
        asm("    int idx=_f8_total++;")
        asm("    memset(&_f8_nodos[idx],0,sizeof(struct SemNodo));")
        asm("    _f8_nodos[idx].tipo_nodo=_f8_tipo(n->tipo.datos);")
        asm("    const char* _t=n->tipo.datos;")
        asm("    if(strcmp(_t,\"DefinicionFuncion\")==0){")
        asm("        struct DefinicionFuncion* _f=(struct DefinicionFuncion*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_f->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_f->nombre.longitud;")
        asm("        // Params list at slot[6], body at slot[7]")
        asm("        int _pfirst=0,_pprev=0;")
        asm("        struct ListaParametro* _pc=_f->parametros;")
        asm("        while(_pc){ if(_pc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_pc->cabeza); if(_ci){ if(!_pfirst)_pfirst=_ci; if(_pprev)_f8_nodos[_pprev].hermano=_ci; _pprev=_ci; } } _pc=_pc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_pfirst;")
        asm("        int _bfirst=0,_bprev=0;")
        asm("        struct ListaNodo* _c=_f->cuerpo;")
        asm("        while(_c){ if(_c->cabeza){ int _ci=_f8_flatten(_c->cabeza); if(_ci){ if(!_bfirst)_bfirst=_ci; if(_bprev)_f8_nodos[_bprev].hermano=_ci; _bprev=_ci; } } _c=_c->cola; }")
        asm("        _f8_nodos[idx].hijo_izq=_bfirst;")
        asm("        // 2.4 nativa: tipo_retorno en ptr_extra + _f8_ret_hi")
        asm("        if(_f->tipo_retorno.datos && _f->tipo_retorno.datos[0]){ strncpy(_f8_retbuf[idx],_f->tipo_retorno.datos,127); _f8_retbuf[idx][127]=0; uintptr_t _rp=(uintptr_t)_f8_retbuf[idx]; _f8_nodos[idx].ptr_extra=(int)(_rp&0xFFFFFFFFu); _f8_ret_hi[idx]=(int)(_rp>>32); }")
        asm("    }else if(strcmp(_t,\"DefinicionEstructura\")==0){")
        asm("        // Manual 3 S3.2: SemNodo aplanado - la estructura registra su nombre (ptr_str/ptr_hi)")
        asm("        struct DefinicionEstructura* _de=(struct DefinicionEstructura*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_de->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_de->nombre.longitud;")
        asm("        // Campos de la estructura aplanados como cadena de hermanos; primero en slot[6]")
        asm("        int _ffirst=0,_fprev=0;")
        asm("        struct ListaParametro* _fc=_de->campos;")
        asm("        while(_fc){ if(_fc->cabeza){ int _ci=_f8_flatten((struct Nodo*)_fc->cabeza); if(_ci){ if(!_ffirst)_ffirst=_ci; if(_fprev)_f8_nodos[_fprev].hermano=_ci; _fprev=_ci; } } _fc=_fc->cola; }")
        asm("        ((int*)&_f8_nodos[idx])[6]=_ffirst;")
        asm("    }else if(strcmp(_t,\"Parametro\")==0){")
        asm("        // Parametro (campo de estructura o parametro de funcion): nombre en ptr_str/ptr_hi")
        asm("        struct Parametro* _pa=(struct Parametro*)n;")
        asm("        { uintptr_t _tp=(uintptr_t)_pa->nombre.datos; _f8_nodos[idx].ptr_str=(int)(_tp&0xFFFFFFFFu); _f8_ptr_hi[idx]=(int)(_tp>>32); }")
        asm("        _f8_nodos[idx].len_str=_pa->nombre.longitud;")
        asm("        // 2.4 nativa: tipo del parametro en ptr_extra + _f8_ret_hi (el puente lo guarda en tipo_param, no en tipo)")
        asm("        if(_pa->tipo_param.datos && _pa->tipo_param.datos[0]){ strncpy(_f8_retbuf[idx],_pa->tipo_param.datos,127); _f8_retbuf[idx][127]=0; uintptr_t _rp=(uintptr_t)_f8_retbuf[idx]; _f8_nodos[idx].ptr_extra=(int)(_rp&0xFFFFFFFFu); _f8_ret_hi[idx]=(int)(_rp>>32); }")
        asm("    }else if(strcmp(_t,\"DeclaracionExterna\")==0){")
