#lang: es

// --- Imports for Unity Build ---
importar tokens
importar lexer
importar ast_nodes
importar errores
importar diagnostics
importar parser
importar tabla_simbolos
importar analizador_semantico
importar memoria
importar generator
importar resolvedor_axon

// --- ADT for stage results ---
estructura ResultadoEtapa:
    tag: entero
    valor: entero

// Native pipeline entry point
funcion etapa_ok() -> ResultadoEtapa:
    r = ResultadoEtapa()
    r.tag = 0
    inseguro:
        asm("r.dato.valor = 0")
    retornar r

funcion fallo_etapa(cod: entero) -> entero:
    inseguro:
        asm("fprintf(stderr, \"Error de compilacion\\n\");")
    retornar cod

funcion argv_str(i: entero) -> cadena:
    r = ""
    inseguro:
        asm("if (i < 0 || i >= _argc()) { r = (CadenaSegura){0,(char*)\"\"}; return r; }")
        asm("CadenaSegura _as = _argv(i);")
        asm("r = (CadenaSegura){.longitud=_as.longitud,.datos=strdup(_as.datos)}")
    retornar r

// --- Stage 4 (unico): Generate C code and compile into next-stage binary ---
// NATIVE pipeline: tokenizar -> parsear -> (F8) analizar -> generar -> GCC
funcion generar_etapa(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fprintf(stderr, \"[Synapse] Pipeline nativa: leyendo fuente...\\n\");")
        asm("// 1. Read source file")
        asm("FILE* _f = fopen(ruta.datos, \"rb\");")
        asm("if (!_f) { struct ResultadoEtapa _e = {1, 2}; return _e; }")
        asm("fseek(_f, 0, SEEK_END); long _fsz = ftell(_f); fseek(_f, 0, SEEK_SET);")
        asm("char* _buf = (char*)malloc((size_t)_fsz + 1);")
        asm("fread(_buf, 1, (size_t)_fsz, _f); fclose(_f); _buf[_fsz] = 0;")
        asm("CadenaSegura _fuente = { .longitud = (int)_fsz, .datos = _buf };")
        asm("")
        asm("// 2. Tokenizar")
        asm("extern int tokenizar(CadenaSegura);")
        asm("int _ntok = tokenizar(_fuente);")
        asm("if (_ntok < 0) { free(_buf); struct ResultadoEtapa _e = {1, 3}; return _e; }")
        asm("")
        asm("// 3. Parsear (obtener AST)")
        asm("extern struct Programa parsear(CadenaSegura);")
        asm("struct Programa _ast = parsear(_fuente);")
        asm("")
        asm("// 3b. Analisis semantico nativo (Fase 8)")
        asm("fprintf(stderr, \"[Synapse] Analisis semantico: ejecutando...\\n\");")
        asm("int _s_cnt=0,_s_lvl=0,_s_err=0,_s_unsafe=0;")
        asm("char _sn[4096][64],_st[4096][64]; int _sl[4096],_sc[4096];")
        asm("#define _SEM_SD(n,t,c) do{ int _i; for(_i=0;_i<_s_cnt;_i++) if(strcmp(_sn[_i],n)==0&&_sl[_i]==_s_lvl){ fprintf(stderr,\"[SEM] Error: redef '%s'\\n\",n); _s_err=1; _i=-2; break; } if(_i>=0||_s_cnt==0){ if(_i<0||_i>=_s_cnt)_i=_s_cnt; strcpy(_sn[_i],n); strcpy(_st[_i],t); _sl[_i]=_s_lvl; _sc[_i]=c; _s_cnt++; } }while(0)")
        asm("#define _SEM_SI() _s_lvl++")
        asm("#define _SEM_SO() do{ while(_s_cnt>0&&_sl[_s_cnt-1]==_s_lvl) _s_cnt--; _s_lvl--; }while(0)")
        asm("// Pass 1: register top-level symbols")
        asm("{ struct ListaNodo* _lp=_ast.sentencias; while(_lp){ void* _n=_lp->cabeza; if(_n){")
        asm("    const char* _tp=((struct Nodo*)_n)->tipo.datos;")
        asm("    if(strcmp(_tp,\"DefinicionFuncion\")==0){ struct DefinicionFuncion* _f=(struct DefinicionFuncion*)_n; _SEM_SD(_f->nombre.datos,\"int\",0); }")
        asm("    if(strcmp(_tp,\"DeclaracionExterna\")==0){ struct DeclaracionExterna* _x=(struct DeclaracionExterna*)_n; _SEM_SD(_x->nombre.datos,\"int\",0); }")
        asm("} _lp=_lp->cola; }}")
        asm("// Pass 2: function body analysis")
        asm("{ struct ListaNodo* _lp=_ast.sentencias; while(_lp){ void* _n=_lp->cabeza; if(_n){")
        asm("    const char* _tp=((struct Nodo*)_n)->tipo.datos;")
        asm("    if(strcmp(_tp,\"DefinicionFuncion\")==0){")
        asm("        struct DefinicionFuncion* _f=(struct DefinicionFuncion*)_n;")
        asm("        _SEM_SI();")
        asm("        struct ListaParametro* _pl=(struct ListaParametro*)_f->parametros;")
        asm("        while(_pl){ struct Parametro* _p=(struct Parametro*)_pl->cabeza; if(_p) _SEM_SD(_p->nombre.datos,_p->tipo.datos,0); _pl=_pl->cola; }")
        asm("        struct ListaNodo* _bl=(struct ListaNodo*)_f->cuerpo;")
        asm("        while(_bl){")
        asm("            void* _stmt=_bl->cabeza; if(_stmt){")
        asm("            const char* _st=((struct Nodo*)_stmt)->tipo.datos;")
        asm("            if(strcmp(_st,\"AsignacionVariable\")==0){")
        asm("                struct AsignacionVariable* _a=(struct AsignacionVariable*)_stmt;")
        asm("                int _si=-1; for(int _i=0;_i<_s_cnt;_i++) if(strcmp(_sn[_i],_a->nombre.datos)==0){ _si=_i;break; }")
        asm("                if(_si<0){ _SEM_SD(_a->nombre.datos,\"int\",0); } else if(_sc[_si]){ fprintf(stderr,\"[SEM] Error: const '%s' no reasig\\n\",_a->nombre.datos); _s_err=1; }")
        asm("            }")
        asm("            if(strcmp(_st,\"SentenciaRetornar\")==0){ struct SentenciaRetornar* _r=(struct SentenciaRetornar*)_stmt; (void)_r; }")
        asm("            if(strcmp(_st,\"SentenciaExpr\")==0){ struct SentenciaExpr* _e=(struct SentenciaExpr*)_stmt; (void)_e; }")
        asm("            if(strcmp(_st,\"SentenciaLanzar\")==0){ struct SentenciaLanzar* _l=(struct SentenciaLanzar*)_stmt; (void)_l; }")
        asm("        } _bl=_bl->cola; }")
        asm("        _SEM_SO();")
        asm("    }")
        asm("} _lp=_lp->cola; }}")
        asm("if(_s_err){ fprintf(stderr,\"[Synapse] ERROR: Analisis semantico detecto errores\\n\"); free(_buf); struct ResultadoEtapa _e={1,3}; return _e; }")
        asm("fprintf(stderr,\"[Synapse] Analisis semantico: OK\\n\");")
        asm("// 4. Generar codigo C desde AST")
        asm("extern int generar(struct Programa, CadenaSegura);")
        asm("CadenaSegura _salida_c = { .longitud = salida.longitud, .datos = salida.datos };")
        asm("int _gen_rc = generar(_ast, _salida_c);")
        asm("if (_gen_rc != 0) { free(_buf); struct ResultadoEtapa _e = {1, 4}; return _e; }")
        asm("")
        asm("// 5. Compilar con GCC")
        asm("char _cmd[4096];")
        asm("snprintf(_cmd, 4096, \"gcc -O2 -I. synapse_unity.c synapse_rt.o -o \\\"%s\\\" -lpthread -lm -lws2_32\", salida.datos);")
        asm("fprintf(stderr, \"[Synapse] GCC: %s\\n\", _cmd);")
        asm("int _gcc_rc = system(_cmd);")
        asm("free(_buf);")
        asm("if (_gcc_rc != 0) {")
        asm("    fprintf(stderr, \"[Synapse] ERROR: GCC fallo con codigo %d\\n\", _gcc_rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Synapse] Compilacion nativa exitosa\\n\");")
    retornar etapa_ok()

funcion principal() -> entero:
    r = 0
    inseguro:
        asm("if (_argc() < 2) { fprintf(stderr, \"Uso: %s <archivo.syn> [salida.exe]\\n\", _argc() > 0 ? _argv(0).datos : \"synapse\"); r = 1; return r; }")
    ruta = argv_str(1)
    salida_ruta = argv_str(2)
    inseguro:
        asm("if (ruta.longitud == 0) { r = 1; return r; }")
        asm("if (salida_ruta.longitud == 0) { salida_ruta = (CadenaSegura){.longitud=19,.datos=\"synapse_stage2.exe\"}; }")
    // Pipeline nativa: leer -> tokenizar -> parsear -> (F8 stub) -> generar -> GCC
    _resultado = generar_etapa(ruta, salida_ruta)
    si _resultado.tag == 0:
        r = 0
    sino:
        r = fallo_etapa(_resultado.valor)
    retornar r
