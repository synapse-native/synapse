        asm("#ifdef _WIN32")
        asm("        char _np[3000]; snprintf(_np, sizeof _np, \"PATH=%s;%s\", _gdir, _pv ? _pv : \"\");")
        asm("        _putenv(_np);")
        asm("#else")
        asm("        char _np[3000]; snprintf(_np, sizeof _np, \"%s:%s\", _gdir, _pv ? _pv : \"\");")
        asm("        setenv(\"PATH\", _np, 1);")
