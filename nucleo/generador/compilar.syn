#lang: es

// ============================================================
// compilar.syn  —  Compilacion de archivo unico (nuevo generador)
// ============================================================
// NOTA: ResultadoEtapa y etapa_ok() estan definidos en principal.syn.
// ============================================================

funcion compilar_archivo(ruta: cadena, salida: cadena) -> ResultadoEtapa:
    inseguro:
        asm("fflush(stderr);")
        asm("fprintf(stderr, \"[Compilar] Leyendo %s...\\n\", ruta.datos); fflush(stderr);")
        // 1. Read input file
        asm("FILE* _f = fopen(ruta.datos, \"rb\");")
        asm("if (!_f) { fprintf(stderr, \"[Compilar] ERROR: No se puede abrir %s\\n\", ruta.datos); struct ResultadoEtapa _e = {1, 2}; return _e; }")
        asm("fseek(_f, 0, SEEK_END); long _sz = ftell(_f); fseek(_f, 0, SEEK_SET);")
        asm("if (_sz > 1048576) { fprintf(stderr, \"[Compilar] FATAL: %s > 1MB\\n\", ruta.datos); fclose(_f); struct ResultadoEtapa _e = {1, 6}; return _e; }")
        asm("char* _buf = (char*)malloc((size_t)_sz + 1);")
        asm("fread(_buf, 1, (size_t)_sz, _f); fclose(_f); _buf[_sz] = 0;")
        asm("CadenaSegura _fuente = {.longitud = (int)_sz, .datos = _buf};")

        // 2. Reset parser globals and tokenize
        asm("extern int _P_ntks, _P_tpos, _P_p_err;")
        asm("_P_ntks = 0; _P_tpos = 0; _P_p_err = 0;")
        asm("fprintf(stderr, \"[Compilar] Calling tokenizar...\\n\"); fflush(stderr);")
        asm("extern int tokenizar(CadenaSegura);")
        asm("int _ntok = tokenizar(_fuente);")
        asm("fprintf(stderr, \"[Compilar] Tokenizado: %d tokens\\n\", _ntok); fflush(stderr);")
        asm("if (_ntok < 0) { free(_buf); struct ResultadoEtapa _e = {1, 3}; return _e; }")

        // 3. Parse
        asm("fprintf(stderr, \"[Compilar] Calling parsear...\\n\"); fflush(stderr);")
        asm("extern struct Programa parsear(CadenaSegura);")
        asm("struct Programa _prog = parsear(_fuente);")
        asm("free(_buf);")
        asm("fprintf(stderr, \"[Compilar] Parseado exitosamente\\n\"); fflush(stderr);")

        // 4. Output path: build .c filename
        // DEBUG: print salida.datos
        asm("fprintf(stderr, \"[Compilar] DEBUG: salida.datos = '%s' (len=%d)\\n\", salida.datos, salida.longitud);")
        asm("char _out_c[1024];")
        asm("int _slen = (int)strlen(salida.datos);")
        asm("memcpy(_out_c, salida.datos, _slen);")
        asm("_out_c[_slen] = '.'; _out_c[_slen+1] = 'c'; _out_c[_slen+2] = 0;")
        asm("fprintf(stderr, \"[Compilar] DEBUG: _out_c = '%s'\\n\", _out_c);")
        asm("CadenaSegura _salida_c = {.longitud = (int)strlen(_out_c), .datos = _out_c};")

        // 5. Call new generar()
        asm("extern int generar(struct Programa, CadenaSegura);")
        asm("fprintf(stderr, \"[Compilar] Generando C...\\n\");")
        asm("int _gen_rc = generar(_prog, _salida_c);")
        asm("fprintf(stderr, \"[Compilar] generar() retorno: %d\\n\", _gen_rc);")
        asm("if (_gen_rc != 0) {")
        asm("    fprintf(stderr, \"[Compilar] ERROR: generar() fallo con codigo %d\\n\", _gen_rc);")
        asm("    struct ResultadoEtapa _e = {1, 4}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Compilar] C generado: %s\\n\", _out_c);")

        // 6. Compile with GCC
        asm("char _cmd[4096];")
        asm("snprintf(_cmd, 4096, \"gcc -O2 -Wl,--stack,8388608 -Wl,--gc-sections -I. \\\"%s\\\" axon_rt.o tweetnacl.o -o \\\"%s\\\" -lpthread -lm -lws2_32\", _out_c, salida.datos);")
        asm("fprintf(stderr, \"[Compilar] GCC: %s\\n\", _cmd);")
        asm("int _gcc_rc = system(_cmd);")
        asm("if (_gcc_rc != 0) {")
        asm("    fprintf(stderr, \"[Compilar] GCC fallo con codigo %d\\n\", _gcc_rc);")
        asm("    struct ResultadoEtapa _e = {1, 5}; return _e;")
        asm("}")
        asm("fprintf(stderr, \"[Compilar] Ejecutable generado: %s\\n\", salida.datos);")
    retornar etapa_ok()
