// R20: tipo C de un nodo expresion (recursivo) - paridad S1 tipo_de_expr.
// Resuelve ctors ADT anidados (ok(ok(42))): un ctor como argumento aporta el
// tipo C de su propia instancia (no el fallback 'int'/vacio). Es funcion del
// COMPILADOR (no se emite al C del usuario: alli no existen los structs AST).
funcion _syn_nativo_expr_tipo_c(n: puntero, out: puntero) -> entero:
    inseguro:
        asm("    struct Nodo* _nn = (struct Nodo*)n; char* _oo = (char*)out;")
        asm("    if (!_nn || !_oo) return 0;")
        asm("    _oo[0] = 0;")
        asm("    const char* _t = _nn->tipo.datos;")
        asm("    if (!_t) return 0;")
        asm("    if (strcmp(_t, \"LiteralNumero\") == 0) { strcpy(_oo, \"int64_t\"); return 1; }")
        asm("    if (strcmp(_t, \"LiteralDecimal\") == 0) { strcpy(_oo, \"double\"); return 1; }")
        asm("    if (strcmp(_t, \"LiteralCadena\") == 0) { strcpy(_oo, \"CadenaSegura\"); return 1; }")
        asm("    if (strcmp(_t, \"LiteralNulo\") == 0) { strcpy(_oo, \"void*\"); return 1; }")
        asm("    if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_nn;")
        asm("        if (_lf->nombre.datos && _G_native_es_adt_ctr(_lf->nombre.datos)) {")
        asm("            char _ab[64]; int _tg = 0; char _ft[64]; _ab[0] = 0; _ft[0] = 0;")
        asm("            _G_native_adt_ctr_info(_lf->nombre.datos, _ab, &_tg, _ft);")
        asm("            char _argt[64]; _argt[0] = 0;")
        asm("            struct ListaNodo* _la = _lf->argumentos;")
        asm("            if (_la && _la->cabeza) { _syn_nativo_expr_tipo_c((void*)_la->cabeza, (void*)_argt); }")
        asm("            char _io[64]; _io[0] = 0;")
        asm("            if (_G_native_adt_gen_es(_ab) && _G_native_adt_inst_ctr(_ab, _tg, _argt[0] ? _argt : 0, _io)) { strcpy(_oo, _io); return 1; }")
        asm("            return 0;")
        asm("        }")
        asm("        if (_lf->nombre.datos && _G_native_es_estructura(_lf->nombre.datos)) { snprintf(_oo, 63, \"struct %s\", _lf->nombre.datos); return 1; }")
        asm("        return 0;")
        asm("    }")
        asm("    if (strcmp(_t, \"Identificador\") == 0) {")
        asm("        struct Identificador* _id = (struct Identificador*)_nn;")
        asm("        if (_id->nombre.datos) {")
        asm("            extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("            for (int _v = 0; _v < _G_fn_vars_count; _v++) {")
        asm("                if (strcmp(_G_fn_vars[_v], _id->nombre.datos) == 0 && _G_fn_var_tipos[_v][0]) { strcpy(_oo, _G_fn_var_tipos[_v]); return 1; }")
        asm("            }")
        asm("        }")
        asm("        return 0;")
        asm("    }")
        asm("    return 0;")
