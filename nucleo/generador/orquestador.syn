// ----------------------------------------------------------
// _es_builtin_runtime - paridad emit_selfhost.py L1203: los builtins de
// runtime (definidos en synapse_rt.o) no se re-emiten como funciones.
// ----------------------------------------------------------
funcion _es_builtin_runtime(nombre: puntero) -> entero:
    inseguro:
        asm("const char* _bn = (const char*)nombre;")
        asm("if (!_bn) return 0;")
        asm("static const char* _rtb[] = { \"escribir\", \"escribir_linea\", \"leer_linea\", \"abrir\", \"leer\", \"cerrar\", \"crear_tensor\", \"suma_tensor\", \"producto_punto\", \"relu\", \"reserva\", \"libera\", \"suma\", \"producto\", \"math_crear_tensor\", \"math_suma_tensor\", \"math_producto_punto\", \"math_relu\", \"mem_reserva\", \"mem_libera\", \"math_suma\", \"math_producto\", \"str_eq\", \"texto_a_entero\", \"texto_a_decimal\", \"decimal_a_texto\", \"entero_a_texto\", \"concat\", \"_syn_texto_liberar\", \"leer_archivo\", \"_syn_leer_archivo\" };")
        asm("for (int _bi = 0; _bi < (int)(sizeof(_rtb)/sizeof(_rtb[0])); _bi++) {")
        asm("    if (strcmp(_bn, _rtb[_bi]) == 0) return 1;")
        asm("}")
        asm("return 0;")

funcion gen_visitar_top_level(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) exit(1);")
        asm("if (_syn_es_tipo(_t, \"DefinicionFuncion\")) {")
        asm("    struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_n;")
        asm("    const char* _fn = _f->nombre.datos;")
        asm("    if (!_fn) exit(1);")
        asm("    // Paridad emit_selfhost.py L1203: saltar builtins de runtime en definiciones")
        asm("    if (_es_builtin_runtime((void*)_fn)) return;")
        asm("    // ME-B7: dedup de DEFINICIONES (paridad _funciones_emitidas) - primer cuerpo gana")
        asm("    int _fd = 0;")
        asm("    for (int _fd2 = 0; _fd2 < _G_emit_func_count; _fd2++) { if (strcmp(_G_emit_func_names[_fd2], _fn) == 0) { _fd = 1; break; } }")
        asm("    if (_fd) return;")
        asm("    if (_G_emit_func_count < 2048) { strncpy(_G_emit_func_names[_G_emit_func_count], _fn, 63); _G_emit_func_names[_G_emit_func_count][63] = 0; _G_emit_func_count++; }")
        asm("    // ME-B7: reset del registro de variables por funcion (hoisting - primera declaracion gana)")
        asm("    _G_fn_vars_count = 0;")
        asm("    _G_fn_ptr_vars_count = 0;  // ME-B9.x: reset de parametros puntero")
        asm("    // ME-B7: limpiar arrays de hoisting (evita datos stale entre funciones)")
        asm("    memset(_G_fn_var_auto, 0, sizeof(int) * 2048);")
        asm("    memset(_G_fn_var_src, 0, sizeof(void*) * 2048);")
        asm("    memset(_G_fn_var_tipos, 0, sizeof(char) * 2048 * 64);")
        asm("    struct ListaParametro* _fpv = _f->parametros;")
        asm("    while (_fpv) {")
        asm("        struct Parametro* _ppv = (struct Parametro*)_fpv->cabeza;")
        asm("        if (_ppv && _ppv->nombre.datos && _G_fn_vars_count < 2048) {")
        asm("            strncpy(_G_fn_vars[_G_fn_vars_count], _ppv->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0;")
        asm("            // R18: registrar el tipo C del parametro - paridad S1")
        asm("            // emit_declarations.py L426-428 _variables; necesario para el binding")
        asm("            // del coincidir con multi-instancia del mismo base R18.")
        asm("            extern char _G_fn_var_tipos[2048][64];")
        asm("            if (_ppv->tipo_param.datos) {")
        asm("                traducir_tipo_c((void*)_ppv->tipo_param.datos);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                strncpy(_G_fn_var_tipos[_G_fn_vars_count], _gen_tmp_buf, 63); _G_fn_var_tipos[_G_fn_vars_count][63] = 0;")
        asm("            }")
        asm("            _G_fn_vars_count++;")
        asm("        }")
        asm("        _fpv = _fpv->cola;")
        asm("    }")
        asm("    // ME-B7: pre-pass recursivo de hoisting (paridad _collect_vars de emit_declarations.py)")
        asm("    // Registra TODAS las variables auto-declaradas del cuerpo (recursivo en si/mientras/inseguro/para).")
        asm("    // D-3: recorrido FIFO (orden de aparicion) - paridad _collect_vars de S1")
        asm("    // (for s in stmts): la PRIMERA declaracion gana; una AsignacionVariable")
        asm("    // posterior a un `let` del mismo nombre NO se hoistea como auto=1.")
        asm("    // Divergencia documentada: los bloques anidados (si/mientras/para) se")
        asm("    // procesan al final de la cola (no en su posicion de documento como S1);")
        asm("    // solo afecta a codigo que cruza ambito (declaracion en bloque + asignacion")
        asm("    // fuera), que Synapse no permite - aceptada.")
        asm("    struct Nodo* _hp_stack[4096];  // D-3: FIFO consume el array monotonamente (total sentencias/funcion)")
        asm("    int _hp_head = 0, _hp_tail = 0;")
        asm("    struct ListaNodo* _hp0 = _f->cuerpo;")
        asm("    while (_hp0) { if (_hp0->cabeza && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp0->cabeza; } _hp0 = _hp0->cola; }")
        asm("    while (_hp_head < _hp_tail) {")
        asm("        struct Nodo* _hp_n = _hp_stack[_hp_head++];")
        asm("        if (_hp_n && _hp_n->tipo.datos) {")
        asm("            const char* _hp_t = _hp_n->tipo.datos;")
        asm("            if (strcmp(_hp_t, \"AsignacionVariable\") == 0) {")
        asm("                struct AsignacionVariable* _hp_a = (struct AsignacionVariable*)_hp_n;")
        asm("                if (_hp_a->nombre.datos) {")
        asm("                    int _hp_f = 0;")
        asm("                    for (int _hpi = 0; _hpi < _G_fn_vars_count; _hpi++) { if (strcmp(_G_fn_vars[_hpi], _hp_a->nombre.datos) == 0) { _hp_f = 1; break; } }")
        asm("                    if (!_hp_f && _G_fn_vars_count < 2048) {")
        asm("                        strncpy(_G_fn_vars[_G_fn_vars_count], _hp_a->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0;")
        asm("                        _G_fn_var_src[_G_fn_vars_count] = (void*)_hp_n; _G_fn_var_auto[_G_fn_vars_count] = 1;")
        asm("                        _G_fn_vars_count++;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("            if (strcmp(_hp_t, \"DeclaracionVariable\") == 0) {")
        asm("                struct DeclaracionVariable* _hp_d = (struct DeclaracionVariable*)_hp_n;")
        asm("                if (_hp_d->nombre.datos) {")
        asm("                    int _hp_f = 0;")
        asm("                    for (int _hpi = 0; _hpi < _G_fn_vars_count; _hpi++) { if (strcmp(_G_fn_vars[_hpi], _hp_d->nombre.datos) == 0) { _hp_f = 1; break; } }")
        asm("                    if (!_hp_f && _G_fn_vars_count < 2048) {")
        asm("                        strncpy(_G_fn_vars[_G_fn_vars_count], _hp_d->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0;")
        asm("                        _G_fn_var_auto[_G_fn_vars_count] = 0;")
        asm("                        _G_fn_vars_count++;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("            if (strcmp(_hp_t, \"SentenciaSi\") == 0) {")
        asm("                struct SentenciaSi* _hp_s = (struct SentenciaSi*)_hp_n;")
        asm("                struct ListaNodo* _hp_sl = _hp_s->cuerpo;")
        asm("                while (_hp_sl) { if (_hp_sl->cabeza && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp_sl->cabeza; } _hp_sl = _hp_sl->cola; }")
        asm("                struct ListaNodo* _hp_el = _hp_s->cuerpo_sino;")
        asm("                while (_hp_el) { if (_hp_el->cabeza && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp_el->cabeza; } _hp_el = _hp_el->cola; }")
        asm("            }")
        asm("            if (strcmp(_hp_t, \"SentenciaMientras\") == 0) {")
        asm("                struct SentenciaMientras* _hp_m = (struct SentenciaMientras*)_hp_n;")
        asm("                struct ListaNodo* _hp_ml = _hp_m->cuerpo;")
        asm("                while (_hp_ml) { if (_hp_ml->cabeza && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp_ml->cabeza; } _hp_ml = _hp_ml->cola; }")
        asm("            }")
        asm("            if (strcmp(_hp_t, \"BloqueInseguro\") == 0) {")
        asm("                struct BloqueInseguro* _hp_b = (struct BloqueInseguro*)_hp_n;")
        asm("                struct ListaNodo* _hp_bl = _hp_b->cuerpo;")
        asm("                while (_hp_bl) { if (_hp_bl->cabeza && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp_bl->cabeza; } _hp_bl = _hp_bl->cola; }")
        asm("            }")
        asm("            if (strcmp(_hp_t, \"SentenciaPara\") == 0) {")
        asm("                struct SentenciaPara* _hp_p = (struct SentenciaPara*)_hp_n;")
        asm("                if (_hp_p->inicializacion && _hp_p->inicializacion->tipo.datos && strcmp(_hp_p->inicializacion->tipo.datos, \"AsignacionVariable\") == 0) {")
        asm("                    struct AsignacionVariable* _hp_pa = (struct AsignacionVariable*)_hp_p->inicializacion;")
        asm("                    if (_hp_pa->nombre.datos) {")
        asm("                        int _hp_f = 0;")
        asm("                        for (int _hpi = 0; _hpi < _G_fn_vars_count; _hpi++) { if (strcmp(_G_fn_vars[_hpi], _hp_pa->nombre.datos) == 0) { _hp_f = 1; break; } }")
        asm("                        if (!_hp_f && _G_fn_vars_count < 2048) {")
        asm("                            strncpy(_G_fn_vars[_G_fn_vars_count], _hp_pa->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0;")
        asm("                            _G_fn_var_src[_G_fn_vars_count] = (void*)_hp_p->inicializacion; _G_fn_var_auto[_G_fn_vars_count] = 1;")
        asm("                            _G_fn_vars_count++;")
        asm("                        }")
        asm("                    }")
        asm("                }")
        asm("                if (_hp_p->cuerpo && _hp_tail < 4096) { _hp_stack[_hp_tail++] = _hp_p->cuerpo; }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    // ME-B7: funciones canonicas del front-end (paridad _BUILTIN_EMITTER_MAP de la referencia)")
        asm("    // A4: el frontend nativo es el UNICO frontend - el espejo frontend_p.syn (_P_*)")
        asm("    // se retiro. La dualidad de fuentes (generator.syn unity vs orquestador.syn) se")
        asm("    // cierra en A4.4: este hook es identico a la variante unity de generator.syn.")
        asm("    //   tokenizar: NO se intercepta - se emite el cuerpo nativo de lexer.syn.")
        asm("    //     A4.5 fix: la supresion (return) dejaba el unity SIN definicion de tokenizar")
        asm("    //     (undefined-reference en S2); el frontend nativo ES la definicion real.")
        asm("    //   parsear: wrapper nativo (gen_emitir_frontend_nativo, frontend_nativo.syn) que")
        asm("    //     ejecuta tokenizar -> parsear_nativo -> puente_construir_programa")
        asm("    if (strcmp(_fn, \"parsear\") == 0) {")
        asm("        gen_emitir_frontend_nativo(est); return;")
        asm("    }")
        asm("    char _sig[4096];")
        asm("    char _ps[4096] = \"void\"; int _pp = 0, _pfi = 1;")
        asm("    struct ListaParametro* _pc = _f->parametros;")
        asm("    while (_pc) {")
        asm("        struct Parametro* _p = (struct Parametro*)_pc->cabeza;")
        asm("        if (_p && _p->nombre.datos) {")
        asm("            if (_pfi) { _pp = 0; _pfi = 0; } else { _ps[_pp++] = ','; _ps[_pp++] = ' '; }")
        asm("            const char* _pt = _p->tipo_param.datos;")
        asm("            traducir_tipo_c((void*)_pt);")
        asm("            extern char _gen_tmp_buf[4096];")
        asm("            const char* _ct = _gen_tmp_buf;")
        asm("            // Manual 3 S3.3 / paridad _POINTER_TYPES: tipos de estado se pasan por puntero")
        asm("            // FASE A (A2.3): ParserEst (parser.syn) - mismo mecanismo que AnalizadorSemanticoEst")
        asm("            if (_pt && (strcmp(_pt, \"AnalizadorSemanticoEst\") == 0 || strcmp(_pt, \"RegionGraph\") == 0 || strcmp(_pt, \"UnionFind\") == 0 || strcmp(_pt, \"ParserEst\") == 0)) {")
        asm("                strcat(_gen_tmp_buf, \"*\"); _ct = _gen_tmp_buf;")
        asm("                // ME-B9.x: registrar nombre del parametro puntero (AsignacionCampo ->)")
        asm("                extern char _G_fn_ptr_vars[64][64]; extern int _G_fn_ptr_vars_count;")
        asm("                if (_p->nombre.datos && _G_fn_ptr_vars_count < 64) { strncpy(_G_fn_ptr_vars[_G_fn_ptr_vars_count], _p->nombre.datos, 63); _G_fn_ptr_vars[_G_fn_ptr_vars_count][63] = 0; _G_fn_ptr_vars_count++; }")
        asm("            }")
        asm("            int _k = 0; while (_ct[_k]) _ps[_pp++] = _ct[_k++];")
        asm("            _ps[_pp++] = ' ';")
        asm("            _k = 0; while (_p->nombre.datos[_k]) _ps[_pp++] = _p->nombre.datos[_k++];")
        asm("        }")
        asm("        _pc = _pc->cola;")
        asm("    }")
        asm("    _ps[_pp] = 0;")
        asm("    const char* _rt = _f->tipo_retorno.datos;")
        asm("    traducir_tipo_c((void*)_rt);")
        asm("    extern char _gen_tmp_buf[4096];")
        asm("    const char* _rct = _gen_tmp_buf;")
        asm("    snprintf(_sig, 4096, \"%s %s(%s)\", _rct, _fn, _ps);")
        asm("    gen_emitir_str(est, _sig);")
        asm("    gen_abrir_bloque_c(est);")
        asm("    // A2.3 paridad emit_declarations.py L411-413: inyectar _simd_detectar() al inicio de principal()")
        asm("    if (strcmp(_fn, \"principal\") == 0) { gen_emitir_str(est, \"    _simd_detectar();\"); }")
        asm("    // ME-B7: emitir declaraciones hoisteadas al inicio de la funcion (paridad _collect_vars -> write_line)")
        asm("    extern char _G_fn_vars[2048][64]; extern int _G_fn_vars_count;")
        asm("    extern void* _G_fn_var_src[2048]; extern int _G_fn_var_auto[2048];")
        asm("    for (int _hvd = 0; _hvd < _G_fn_vars_count; _hvd++) {")
        asm("        if (!_G_fn_var_auto[_hvd]) continue;")
        asm("        struct AsignacionVariable* _hva = (struct AsignacionVariable*)_G_fn_var_src[_hvd];")
        asm("        char _hvt[64]; _hvt[0] = 0;")
        asm("        if (_hva && _hva->expresion && _hva->expresion->tipo.datos) {")
        asm("            const char* _het = _hva->expresion->tipo.datos;")
        asm("            if (strcmp(_het, \"LiteralCadena\") == 0) { strcpy(_hvt, \"CadenaSegura\"); }")
        asm("            else if (strcmp(_het, \"OpBinaria\") == 0) {")
        asm("                // ME-C4: paridad tipo_de_expr L84-93 (OpBinaria retorna tipo izquierdo).")
        asm("                // \"a\" + \"b\" -> izquierdo LiteralCadena -> CadenaSegura (fix ft_io_imports).")
        asm("                struct OpBinaria* _hob = (struct OpBinaria*)_hva->expresion;")
        asm("                int _hob_txt = 0;")
        asm("                if (_hob && _hob->izquierdo && _hob->izquierdo->tipo.datos) { _hob_txt = (strcmp(_hob->izquierdo->tipo.datos, \"LiteralCadena\") == 0); }")
        asm("                if (_hob_txt) {")
        asm("                    strcpy(_hvt, \"CadenaSegura\");")
        asm("                } else { int _hdec = 0; if (_hob && _hob->izquierdo && _hob->izquierdo->tipo.datos && strcmp(_hob->izquierdo->tipo.datos, \"LiteralDecimal\") == 0) _hdec = 1; if (_hob && _hob->derecho && _hob->derecho->tipo.datos && strcmp(_hob->derecho->tipo.datos, \"LiteralDecimal\") == 0) _hdec = 1; if (_hdec) { strcpy(_hvt, \"double\"); } else { strcpy(_hvt, \"int64_t\"); } }")
        asm("            }")
        asm("            else if (strcmp(_het, \"LlamadaFuncion\") == 0) {")
        asm("                struct LlamadaFuncion* _hlf = (struct LlamadaFuncion*)_hva->expresion;")
        asm("                // R11: constructor ADT (ok/err/algun/ninguno) -> tipo C de la")
        asm("                // instancia registrada (paridad S1). Sin esto el hoisting")
        asm("                // emitia 'int64_t a = {0};' y gcc fallaba 'incompatible types'.")
        asm("                if (_hlf->nombre.datos && _G_native_es_adt_ctr(_hlf->nombre.datos)) {")
        asm("                    char _hab[64]; int _hag = 0; char _hat[64]; _hab[0]=0; _hat[0]=0;")
        asm("                    _G_native_adt_ctr_info(_hlf->nombre.datos, _hab, &_hag, _hat);")
        asm("                    extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_base[64][64]; extern int _G_native_adt_inst_count;")
        asm("                    extern int _G_native_adt_inst_ctr(const char* base, int tag, const char* tipo_c, char* out);")
        asm("                    extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("                    char _haout[64]; _haout[0]=0;")
        asm("                    // R20: resolver la instancia por el tipo C del argumento (recursivo")
        asm("                    // para ctors anidados ok(ok(42))) - paridad S1 _resolver_instancia_adt.")
        asm("                    // Antes la heuristica 'primera instancia con tag<nfields' era")
        asm("                    // ambigua con 2 instancias del mismo base (struct equivocado/Resultado_T).")
        asm("                    char _hcargt[64]; _hcargt[0]=0;")
        asm("                    struct Nodo* _hcargn = (_hlf->argumentos && _hlf->argumentos->cabeza) ? (struct Nodo*)_hlf->argumentos->cabeza : 0;")
        asm("                    if (_hcargn) { _syn_nativo_expr_tipo_c((void*)_hcargn, (void*)_hcargt); }")
        asm("                    if (!_G_native_adt_inst_ctr(_hab, _hag, _hcargt[0] ? _hcargt : 0, _haout)) {")
        asm("                        int _hans = 0; for (int _haj = 0; _haj < _G_native_adt_inst_count; _haj++) { if (strcmp(_G_native_adt_inst_base[_haj], _hab) == 0) _hans++; }")
        asm("                        if (_hans == 1) { for (int _hai = 0; _hai < _G_native_adt_inst_count; _hai++) { if (strcmp(_G_native_adt_inst_base[_hai], _hab) == 0) { strcpy(_haout, _G_native_adt_inst_c[_hai]); } } }")
        asm("                    }")
        asm("                    if (_haout[0]) { strncpy(_hvt, _haout, 63); _hvt[63] = 0; }")
        asm("                    else { snprintf(_hvt, 63, \"struct %s\", _hab); _hvt[63] = 0; }")
        asm("                } else if (_hlf->nombre.datos && _G_native_es_estructura(_hlf->nombre.datos)) {")
        asm("                    snprintf(_hvt, 64, \"struct %s\", _hlf->nombre.datos);")
        asm("                } else if (_hlf->nombre.datos) {")
        asm("                    char _rtb[64]; _rtb[0] = 0;")
        asm("                    if (_G_native_tipo_retorno(_hlf->nombre.datos, _rtb)) {")
        asm("                        if (strcmp(_rtb, \"vacio\") != 0 && strcmp(_rtb, \"nulo\") != 0 && strcmp(_rtb, \"entero\") != 0) {")
        asm("                            traducir_tipo_c((void*)_rtb);")
        asm("                            extern char _gen_tmp_buf[4096];")
        asm("                            strncpy(_hvt, _gen_tmp_buf, 63); _hvt[63] = 0;")
