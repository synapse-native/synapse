#lang: es

// ============================================================
// orquestador.syn  -  Orquestador del generador nativo
// ============================================================

// ----------------------------------------------------------
// generar - Punto de entrada principal
// ----------------------------------------------------------
funcion generar(programa: Programa, ruta: cadena) -> entero:
    r = 0
    est = GeneradorCEst()
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Abriendo archivo...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("_G_emit_pos = 0;")
        asm("FILE* _G_out = fopen(ruta.datos, \"w\");")
        asm("if (!_G_out) { fprintf(stderr, \"[Orquestador] ERROR FATAL: No se pudo abrir %s\\n\", ruta.datos); r = 1; return r; }")
        asm("extern FILE* _G_fp; _G_fp = _G_out;")
        asm("fprintf(stderr, \"[Orquestador] Archivo abierto\\n\"); fflush(stderr);")

    gen_emitir_linea(est, "// Generado por Synapse (nuevo generador modular)")
    gen_emitir_linea(est, "// Manual 8 S8.1/S8.2: header de paridad con _emitir_encabezado")
    gen_emitir_linea(est, "#pragma GCC diagnostic ignored \"-Wint-to-pointer-cast\"")
    gen_emitir_linea(est, "#pragma GCC diagnostic ignored \"-Wdiscarded-qualifiers\"")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "#include <stdio.h>")
    gen_emitir_linea(est, "#include <stdlib.h>")
    gen_emitir_linea(est, "#include <stdint.h>")
    gen_emitir_linea(est, "#include <pthread.h>")
    gen_emitir_linea(est, "#include <string.h>")
    gen_emitir_linea(est, "#include <assert.h>")
    // F3-15: escaneo de runtime/core/ en generar_etapa (sin hardcoding) —
    // _findfirst (Windows) / opendir (POSIX), guardados por plataforma.
    gen_emitir_linea(est, "#ifdef _WIN32")
    gen_emitir_linea(est, "#include <io.h>")
    gen_emitir_linea(est, "#else")
    gen_emitir_linea(est, "#include <dirent.h>")
    gen_emitir_linea(est, "#endif")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { int longitud; const char* datos; } CadenaSegura;")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 / paridad emit_expressions.py: comparar cadenas con str_eq,
    // int con ==, seleccionado en compilacion via _Generic (evita inferencia en runtime).
    gen_emitir_linea(est, "#define _SYN_EQ(a,b) _Generic((a), CadenaSegura: (str_eq((a),(b)) == 1), default: ((a)==(b)))")
    gen_emitir_linea(est, "#define _SYN_NE(a,b) _Generic((a), CadenaSegura: (str_eq((a),(b)) == 0), default: ((a)!=(b)))")
    // ME-B7 paridad emit_expressions.py L173-200: concat() para + con cadenas
    // (conversion entero_a_texto/decimal_a_texto segun el operando), seleccion
    // en compilacion via _Generic anidado (sin inferencia de tipos en runtime).
    gen_emitir_linea(est, "#define _SYN_PLUS(a,b) _Generic((a), CadenaSegura: _Generic((b), CadenaSegura: concat((a),(b)), default: concat((a), entero_a_texto((b)))), default: _Generic((b), CadenaSegura: concat(entero_a_texto((a)), (b)), default: ((a)+(b))))")
    // ME-B7 paridad emit_expressions.py L336-343: indice sobre cadena -> .datos[idx]
    gen_emitir_linea(est, "#define _SYN_IDX(o,i) _Generic((o), CadenaSegura: ((CadenaSegura){1, &((o).datos[i])}), default: ((o)[i]))")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { uint32_t filas; uint32_t columnas; float* datos; } Tensor;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { FILE* stream; int es_valido; int es_virtual; const char* virtual_data; int virtual_len; } Canal;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "#define nulo ((void*)0)")
    gen_emitir_linea(est, "#define verdadero 1")
    gen_emitir_linea(est, "#define falso 0")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "// --- OO AST node types ---")
    gen_emitir_linea(est, "struct Token;")
    gen_emitir_linea(est, "struct Nodo;")
    gen_emitir_linea(est, "struct ListaNodo;")
    gen_emitir_linea(est, "struct Programa;")
    gen_emitir_linea(est, "struct Identificador;")
    gen_emitir_linea(est, "struct LiteralNumero;")
    gen_emitir_linea(est, "struct LiteralCadena;")
    gen_emitir_linea(est, "struct OpBinaria;")
    gen_emitir_linea(est, "struct OpUnaria;")
    gen_emitir_linea(est, "struct LlamadaFuncion;")
    gen_emitir_linea(est, "struct ExprAccesoCampo;")
    gen_emitir_linea(est, "struct AsignacionVariable;")
    gen_emitir_linea(est, "struct AsignacionCampo;")
    gen_emitir_linea(est, "struct SentenciaSi;")
    gen_emitir_linea(est, "struct SentenciaMientras;")
    gen_emitir_linea(est, "struct SentenciaRetornar;")
    gen_emitir_linea(est, "struct SentenciaExpr;")
    gen_emitir_linea(est, "struct LogLlamada;")
    gen_emitir_linea(est, "struct Parametro;")
    gen_emitir_linea(est, "struct ListaParametro;")
    gen_emitir_linea(est, "struct DefinicionFuncion;")
    gen_emitir_linea(est, "struct DefinicionEstructura;")
    gen_emitir_linea(est, "struct SentenciaRomper;")
    gen_emitir_linea(est, "struct SentenciaSiguiente;")
    gen_emitir_linea(est, "struct SentenciaImportar;")
    gen_emitir_linea(est, "struct DeclaracionExterna;")
    gen_emitir_linea(est, "struct DeclaracionVariable;")
    gen_emitir_linea(est, "struct SentenciaDelegar;")
    gen_emitir_linea(est, "struct DeclaracionExport;")
    gen_emitir_linea(est, "struct BloqueInseguro;")
    gen_emitir_linea(est, "struct ExprObtenerDireccion;")
    gen_emitir_linea(est, "struct ExprDereferencia;")
    // F1.2b: structs usadas por el codegen de nulo/tensor()/tipo (paridad ast_nodes.syn L151-220).
    // Se declaran aqui para que el C de salida sea autocontenido aunque el programa
    // use estos nodos sin importar ast_nodes.syn (los typedefs completos los emite
    // la Fase 1 al recorrer las 'estructura' del programa).
    gen_emitir_linea(est, "struct ExprTensor;")
    gen_emitir_linea(est, "struct LiteralNulo;")
    gen_emitir_linea(est, "struct ConstructorTipo;")
    gen_emitir_linea(est, "struct DeclaracionTipo;")
    gen_emitir_linea(est, "struct ExprPropagar;")  // D-6: operador ? (Manual 3 §7)
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct Token { int tipo; CadenaSegura lexema; int linea; int columna; } Token;")
    gen_emitir_linea(est, "typedef struct Nodo { CadenaSegura tipo; } Nodo;")
    gen_emitir_linea(est, "typedef struct ListaNodo { struct Nodo* cabeza; struct ListaNodo* cola; } ListaNodo;")
    gen_emitir_linea(est, "typedef struct Programa { CadenaSegura tipo; struct ListaNodo* sentencias; } Programa;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "char _gen_tmp_buf[4096];")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "char _G_emit_buf[1048576];")
    gen_emitir_linea(est, "int _G_emit_pos;")
    gen_emitir_linea(est, "FILE* _G_fp;")
    gen_emitir_linea(est, "int _G_scope_depth;")
    gen_emitir_linea(est, "int _G_scope_vars_depth[256];")
    gen_emitir_linea(est, "char _G_scope_vars_names[256][64];")
    gen_emitir_linea(est, "int _G_scope_vars_total;")
    gen_emitir_linea(est, "int _G_safe_mode;  // M22.5: --safe flag for lifetime assertions")
    gen_emitir_linea(est, "")
    // ME-B4: definiciones nativas (paridad _emit_cabecera_comun)
    gen_emitir_linea(est, "char _G_native_structs[256][64];")
    gen_emitir_linea(est, "int _G_native_structs_count;")
    // F3-13: campos de struct con tipo Synapse (paridad context.py _estructuras).
    // El generador nativo necesita el tipo del campo para detectar texto (ej.
    // ch.clave_publica_local de CanalRemoto -> texto) en OpBinaria/let — antes
    // el campo texto se asumia int64_t -> entero_a_texto(campo) en concat -> C
    // invalido (probe importar std.cluster).
    gen_emitir_linea(est, "char _G_native_struct_campos[256][64][64];")
    gen_emitir_linea(est, "char _G_native_struct_campos_tipo[256][64][64];")
    gen_emitir_linea(est, "int _G_native_struct_campos_count[256];")
    gen_emitir_linea(est, "int _G_native_campo_tipo(const char* sn, const char* cn, char* out) {")
    gen_emitir_linea(est, "    if (!sn || !cn || !out) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_structs_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_structs[_i], sn) == 0) {")
    gen_emitir_linea(est, "            for (int _j = 0; _j < _G_native_struct_campos_count[_i]; _j++) {")
    gen_emitir_linea(est, "                if (strcmp(_G_native_struct_campos[_i][_j], cn) == 0) {")
    gen_emitir_linea(est, "                    strcpy(out, _G_native_struct_campos_tipo[_i][_j]); return 1;")
    gen_emitir_linea(est, "                }")
    gen_emitir_linea(est, "            }")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "int _G_native_es_estructura(const char* n) {")
    gen_emitir_linea(est, "    if (!n) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_structs_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_structs[_i], n) == 0) return 1;")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-B6: tipos de retorno (definiciones nativas)
    gen_emitir_linea(est, "char _G_native_func_returns[512][64];")
    gen_emitir_linea(est, "int _G_native_func_returns_count;")
    gen_emitir_linea(est, "int _G_native_tipo_retorno(const char* fn, char* out) {")
    gen_emitir_linea(est, "    if (!fn || !out) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_func_returns_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_func_returns[_i], fn) == 0) {")
    gen_emitir_linea(est, "            strcpy(out, _G_native_func_returns[_i + 256]); return 1;")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-D6: constructores ADT (paridad pre-pass generator.py _constructores_adt).
    // Necesario para expr_eval.syn (constructores -> compound literal del
    // tagged-union) y para la inferencia de tipo del operador '?' (ExprPropagar).
    gen_emitir_linea(est, "char _G_native_adt_ctrs[256][64];")
    gen_emitir_linea(est, "char _G_native_adt_ctrs_adt[256][64];")
    gen_emitir_linea(est, "int _G_native_adt_ctrs_tag[256];")
    gen_emitir_linea(est, "char _G_native_adt_ctrs_tipo[256][64];")
    gen_emitir_linea(est, "int _G_native_adt_ctrs_count;")
    gen_emitir_linea(est, "int _G_native_es_adt_ctr(const char* c) {")
    gen_emitir_linea(est, "    if (!c) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_ctrs_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_adt_ctrs[_i], c) == 0) return 1;")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "int _G_native_adt_ctr_info(const char* c, char* adt_out, int* tag_out, char* tipo_out) {")
    gen_emitir_linea(est, "    if (!c) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_ctrs_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_adt_ctrs[_i], c) == 0) {")
    gen_emitir_linea(est, "            if (adt_out) strcpy(adt_out, _G_native_adt_ctrs_adt[_i]);")
    gen_emitir_linea(est, "            if (tag_out) *tag_out = _G_native_adt_ctrs_tag[_i];")
    gen_emitir_linea(est, "            if (tipo_out) strcpy(tipo_out, _G_native_adt_ctrs_tipo[_i]);")
    gen_emitir_linea(est, "            return 1;")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "int _G_native_adt_unwrap_tipo(const char* adt, char* tipo_out) {")
    gen_emitir_linea(est, "    if (!adt || !tipo_out) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_ctrs_count; _i++) {")
    gen_emitir_linea(est, "        if (_G_native_adt_ctrs_tag[_i] == 0 && strcmp(_G_native_adt_ctrs_adt[_i], adt) == 0) {")
    gen_emitir_linea(est, "            strcpy(tipo_out, _G_native_adt_ctrs_tipo[_i]);")
    gen_emitir_linea(est, "            return 1;")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "int _G_native_adt_unwrap_field(const char* adt, char* field_out) {")
    gen_emitir_linea(est, "    if (!adt || !field_out) return 0;")
    gen_emitir_linea(est, "    // D-2: normalizar la base de una instanciacion (Resultado<entero,texto> -> Resultado)")
    gen_emitir_linea(est, "    char _ab[64]; int _ai = 0; for (; adt[_ai] && adt[_ai] != '<' && _ai < 62; _ai++) _ab[_ai] = adt[_ai]; _ab[_ai] = 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_ctrs_count; _i++) {")
    gen_emitir_linea(est, "        if (_G_native_adt_ctrs_tag[_i] == 0 && strcmp(_G_native_adt_ctrs_adt[_i], _ab) == 0) {")
    gen_emitir_linea(est, "            strcpy(field_out, _G_native_adt_ctrs[_i]);")
    gen_emitir_linea(est, "            return 1;")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-D2: instanciaciones de ADT genericos (monomorfizacion, Opcion A).
    // Paridad pre-pass generator.py _recolectar_instancias_adt: cada uso
    // `Base<A,B>` registra un struct C especializado con campos tipados.
    gen_emitir_linea(est, "char _G_native_adt_gen[64][64];")
    gen_emitir_linea(est, "int _G_native_adt_gen_nparams[64];")
    gen_emitir_linea(est, "char _G_native_adt_gen_params[64][8][64];")
    gen_emitir_linea(est, "int _G_native_adt_gen_count;")
    gen_emitir_linea(est, "int _G_native_adt_gen_es(const char* n) {")
    gen_emitir_linea(est, "    if (!n) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_gen_count; _i++) { if (strcmp(_G_native_adt_gen[_i], n) == 0) return 1; }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "char _G_native_adt_inst_type[64][64];")
    gen_emitir_linea(est, "char _G_native_adt_inst_c[64][64];")
    gen_emitir_linea(est, "char _G_native_adt_inst_base[64][64];")
    gen_emitir_linea(est, "char _G_native_adt_inst_fields_c[64][8][64];")
    gen_emitir_linea(est, "int _G_native_adt_inst_nfields[64];")
    gen_emitir_linea(est, "int _G_native_adt_inst_count;")
    gen_emitir_linea(est, "int _G_native_adt_inst_ctr(const char* base, int tag, const char* tipo_c, char* out) {")
    gen_emitir_linea(est, "    if (!base || !out) return 0;")
    gen_emitir_linea(est, "    int _solo = 1; int _ns = 0; for (int _j = 0; _j < _G_native_adt_inst_count; _j++) { if (strcmp(_G_native_adt_inst_base[_j], base) == 0) { _ns++; } }")
    gen_emitir_linea(est, "    if (_ns == 1) _solo = 1; else _solo = 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_inst_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_adt_inst_base[_i], base) != 0) continue;")
    gen_emitir_linea(est, "        if (_solo) { strcpy(out, _G_native_adt_inst_c[_i]); return 1; }")
    gen_emitir_linea(est, "        if (tag < _G_native_adt_inst_nfields[_i] && tipo_c && _G_native_adt_inst_fields_c[_i][tag][0] && strcmp(_G_native_adt_inst_fields_c[_i][tag], tipo_c) == 0) { strcpy(out, _G_native_adt_inst_c[_i]); return 1; }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "")
    // ME-B7: dedup de funciones emitidas (paridad _funciones_emitidas de la referencia)
    gen_emitir_linea(est, "char _G_emit_func_names[2048][64];")
    gen_emitir_linea(est, "int _G_emit_func_count;")
    // ME-F1.2b: registro de alias de tipo (paridad context.py L210 / pre-pass generator.py L871-890)
    gen_emitir_linea(est, "char _G_tipo_aliases[128][64];")
    gen_emitir_linea(est, "char _G_tipo_aliases_base[128][64];")
    gen_emitir_linea(est, "int _G_tipo_aliases_count;")
    // R5 (F2-2.4c): senal de error de parseo del wrapper parsear() -> pipeline aborte (paridad generator.py)
    gen_emitir_linea(est, "int _G_parse_error = 0;")
    gen_emitir_linea(est, "")
    // ME-B7: variables declaradas por funcion (hoisting: primera declaracion gana)
    gen_emitir_linea(est, "char _G_fn_vars[2048][64];")
    gen_emitir_linea(est, "int _G_fn_vars_count;")
    gen_emitir_linea(est, "// ME-B9.x: parametros de la funcion actual pasados por puntero (_POINTER_TYPES)")
    gen_emitir_linea(est, "char _G_fn_ptr_vars[64][64];")
    gen_emitir_linea(est, "int _G_fn_ptr_vars_count;")
    // ME-B7: nodo fuente de cada variable auto-declarada (inferencia de tipo en hoisting)
    gen_emitir_linea(est, "void* _G_fn_var_src[2048];")
    gen_emitir_linea(est, "int _G_fn_var_auto[2048];")
    // ME-C4: tipo inferido de cada variable auto-declarada (paridad tipo_de_expr para OpBinaria)
    gen_emitir_linea(est, "char _G_fn_var_tipos[2048][64];")
    gen_emitir_linea(est, "")
    // F3-10: elemento (Canal<T>) de cada variable canal para el receive `ch ->`
    // (Manual 2 L144, Manual 5 §4.2). Paridad S1 _elemento_canal de
    // emit_expressions.py: el receive hereda el tipo del elemento del canal.
    gen_emitir_linea(est, "char _G_native_canal_names[512][64];")
    gen_emitir_linea(est, "char _G_native_canal_elem[512][64];")
    gen_emitir_linea(est, "int _G_native_canal_count;")
    gen_emitir_linea(est, "void _G_native_canal_elem_set(const char* _cname, const char* _celem) {")
    gen_emitir_linea(est, "    if (!_cname || !_celem) return;")
    gen_emitir_linea(est, "    for (int _ci = 0; _ci < _G_native_canal_count; _ci++) { if (strcmp(_G_native_canal_names[_ci], _cname) == 0) { strncpy(_G_native_canal_elem[_ci], _celem, 63); _G_native_canal_elem[_ci][63] = 0; return; } }")
    gen_emitir_linea(est, "    if (_G_native_canal_count < 512) { strncpy(_G_native_canal_names[_G_native_canal_count], _cname, 63); _G_native_canal_names[_G_native_canal_count][63] = 0; strncpy(_G_native_canal_elem[_G_native_canal_count], _celem, 63); _G_native_canal_elem[_G_native_canal_count][63] = 0; _G_native_canal_count++; }")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "int _G_native_canal_elem_tipo(const char* _cname, char* _cout) {")
    gen_emitir_linea(est, "    if (!_cname || !_cout) return 0;")
    gen_emitir_linea(est, "    for (int _ci = 0; _ci < _G_native_canal_count; _ci++) { if (strcmp(_G_native_canal_names[_ci], _cname) == 0) { strncpy(_cout, _G_native_canal_elem[_ci], 63); _cout[63] = 0; return 1; } }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // F3-10: helpers de boxeo/desboxeo primitivo (paridad S1 generator.py L796-827).
    // El receive `ch ->` desboxea el void* que devuelve canal_recibir; el S1 ya los
    // emite en sus programas de usuario y el nativo debe tenerlos (antes usaba el
    // cast implicito de gcc al enviar y nunca los emito).
    gen_emitir_linea(est, "static inline void* _synapse_box_int(int64_t v) { return (void*)(intptr_t)v; }")
    gen_emitir_linea(est, "static inline int64_t _synapse_unbox_int(void* p) { return (int64_t)(intptr_t)p; }")
    gen_emitir_linea(est, "static inline void* _synapse_box_float(double v) {")
    gen_emitir_linea(est, "    double* _p = (double*)malloc(sizeof(double));")
    gen_emitir_linea(est, "    if (!_p) { fprintf(stderr, \"ESCAPA_DEL_ALCANCE: malloc fallo\\n\"); exit(1); }")
    gen_emitir_linea(est, "    *_p = v;")
    gen_emitir_linea(est, "    return (void*)_p;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "static inline double _synapse_unbox_float(void* p) {")
    gen_emitir_linea(est, "    double _v = *(double*)p;")
    gen_emitir_linea(est, "    free(p);")
    gen_emitir_linea(est, "    return _v;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // F3-7: funciones listener de `escuchar` (Manual 2 L113) acumuladas y
    // flusheadas antes del main; _G_listener_modo marca el cuerpo del bloque
    // (ExprRecibirCanal -> canal_recibir(_canal) en vez de la variable local).
    gen_emitir_linea(est, "char _G_listeners[8][16384];")
    gen_emitir_linea(est, "int _G_listeners_count;")
    gen_emitir_linea(est, "int _G_listener_modo;")
    gen_emitir_linea(est, "")
    // ME-B6: PGO globals del parser nativo (definidos en _parser.c)
    gen_emitir_linea(est, "extern int _P_ntks, _P_tpos, _P_p_err;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "int _g_argc;")
    gen_emitir_linea(est, "char** _g_argv;")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 paridad con _emitir_cabecera_comun de la referencia:
    // definiciones de runtime helpers usados por el self-host (ver generator.py).
    gen_emitir_linea(est, "int _argc() { return _g_argc; }")
    gen_emitir_linea(est, "CadenaSegura _argv(int i) {")
    gen_emitir_linea(est, "    if (i < 0 || i >= _g_argc) return (CadenaSegura){0, \"\"};")
    gen_emitir_linea(est, "    return (CadenaSegura){ .longitud = (int)strlen(_g_argv[i]), .datos = _g_argv[i] };")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "void salir(int codigo) { exit(codigo); }")
    gen_emitir_linea(est, "CadenaSegura concat(CadenaSegura a, CadenaSegura b) {")
    gen_emitir_linea(est, "    int _tl = a.longitud + b.longitud;")
    gen_emitir_linea(est, "    char* _buf = (char*)malloc(_tl + 1);")
    gen_emitir_linea(est, "    if (!_buf) { fprintf(stderr, \"Error: malloc fallo en concat()\\n\"); exit(1); }")
    gen_emitir_linea(est, "    memcpy(_buf, a.datos, a.longitud);")
    gen_emitir_linea(est, "    memcpy(_buf + a.longitud, b.datos, b.longitud);")
    gen_emitir_linea(est, "    _buf[_tl] = 0;")
    gen_emitir_linea(est, "    return (CadenaSegura){_tl, _buf};")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-B1/B3 fix: tipos TOML y pool allocator (paridad _synapse_shared.h / embedded_libs.h)
    gen_emitir_linea(est, "typedef struct ParToml { CadenaSegura clave; struct NodoToml* valor; } ParToml;")
    gen_emitir_linea(est, "typedef struct NodoToml { int tipo; CadenaSegura valor_str; int valor_ent; struct ParToml* pares; int longitud; } NodoToml;")
    gen_emitir_linea(est, "extern struct NodoToml _toml_parse(CadenaSegura entrada);")
    gen_emitir_linea(est, "extern struct NodoToml _toml_nodo_new(void);")
    gen_emitir_linea(est, "extern void _toml_nodo_liberar(struct NodoToml n);")
    gen_emitir_linea(est, "extern struct NodoToml _toml_object_get(struct NodoToml nodo, CadenaSegura clave);")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "extern void pool_init(uint32_t total_blocks, uint32_t block_size);")
    gen_emitir_linea(est, "extern void pool_free(void* ptr);")
    gen_emitir_linea(est, "extern void* pool_alloc(size_t size);")
    gen_emitir_linea(est, "extern void pool_destroy(void);")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 / paridad _emitir_encabezado (generator.py L544-560):
    // externs de builtins de runtime definidos en synapse_rt.o
    gen_emitir_linea(est, "extern void escribir(CadenaSegura contenido);")
    gen_emitir_linea(est, "extern void escribir_linea(CadenaSegura contenido);")
    gen_emitir_linea(est, "extern CadenaSegura leer_linea(void);")
    gen_emitir_linea(est, "extern Canal abrir(CadenaSegura ruta, CadenaSegura modo);")
    gen_emitir_linea(est, "extern CadenaSegura leer(Canal canal);")
    gen_emitir_linea(est, "extern void cerrar(Canal canal);")
    gen_emitir_linea(est, "extern Tensor crear_tensor(int filas, int columnas);")
    gen_emitir_linea(est, "extern Tensor suma_tensor(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor producto_punto(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor relu(Tensor a);")
    gen_emitir_linea(est, "extern Tensor reserva(int tamano);")
    gen_emitir_linea(est, "extern void libera(Tensor bloque);")
    gen_emitir_linea(est, "extern Tensor suma(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor producto(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern int64_t texto_a_entero(CadenaSegura str);")
    gen_emitir_linea(est, "extern double texto_a_decimal(CadenaSegura str);")
    gen_emitir_linea(est, "extern CadenaSegura decimal_a_texto(double n);")
    gen_emitir_linea(est, "extern CadenaSegura entero_a_texto(int64_t n);")
    gen_emitir_linea(est, "extern int str_eq(CadenaSegura a, CadenaSegura b);")
    gen_emitir_linea(est, "extern void synapse_lanzar_hilo(void* (*fn)(void*), void* arg);")
    gen_emitir_linea(est, "extern void synapse_esperar_hilos(void);")
    gen_emitir_linea(est, "extern void _syn_texto_liberar(CadenaSegura s);")
    gen_emitir_linea(est, "typedef struct CanalConcurrencia CanalConcurrencia;")
    gen_emitir_linea(est, "extern CanalConcurrencia* canal_crear(uint32_t capacidad);")
    gen_emitir_linea(est, "extern void canal_enviar(CanalConcurrencia* canal, void* paquete);")
    gen_emitir_linea(est, "extern void* canal_recibir(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void canal_destruir(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void cerrar_canal(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void _simd_detectar(void);")
    gen_emitir_linea(est, "")

    // ME-B4: recolectar nombres de estructuras definidas en array nativo
    gen_escanear_estructuras(est, programa)

    // ME-B6: recolectar tipos de retorno de funciones definidas en array nativo
    gen_escanear_retornos(est, programa)

    // ME-F1.2b: registrar alias de tipo declarados (`tipo X = Y`, sin constructores)
    gen_escanear_aliases(est, programa)

    // ME-D6: registrar constructores ADT (ok/err/algun/ninguno) - paridad
    gen_escanear_constructores(est, programa)

    // ME-D2: registrar ADT genericos (DeclaracionTipo con parametros_tipo)
    gen_escanear_adt_instancias(est, programa)

    // WALK TOP-LEVEL AST
    gen_recorrer_toplevel(est, programa)

    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Escribiendo archivo de salida...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("extern FILE* _G_fp;")
        asm("if (!_G_fp) { fprintf(stderr, \"[Orquestador] ERROR FATAL: _G_fp nulo\\n\"); r = 1; return r; }")
        asm("if (_G_emit_pos > 0) {")
        asm("    fwrite(_G_emit_buf, 1, _G_emit_pos, _G_fp);")
        asm("}")
        asm("fclose(_G_fp);")
        asm("_G_fp = nulo;")
        asm("fprintf(stderr, \"[Nuevo Generador] Codigo C generado exitosamente\\n\"); fflush(stderr);")
    retornar r

