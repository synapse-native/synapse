// ----------------------------------------------------------
// _es_builtin_runtime - paridad emit_selfhost.py L1203: los builtins de
// runtime (definidos en synapse_rt.o) no se re-emiten como funciones.
// ----------------------------------------------------------
funcion _es_builtin_runtime(nombre: puntero) -> entero:
    inseguro:
        asm("const char* _bn = (const char*)nombre;")
        asm("if (!_bn) return 0;")
        asm("static const char* _rtb[] = { \"escribir\", \"escribir_linea\", \"leer_linea\", \"abrir\", \"leer\", \"cerrar\", \"crear_tensor\", \"suma_tensor\", \"producto_punto\", \"relu\", \"reserva\", \"libera\", \"suma\", \"producto\", \"math_crear_tensor\", \"math_suma_tensor\", \"math_producto_punto\", \"math_relu\", \"mem_reserva\", \"mem_libera\", \"math_suma\", \"math_producto\", \"str_eq\", \"texto_a_entero\", \"texto_a_decimal\", \"decimal_a_texto\", \"entero_a_texto\", \"concat\", \"_syn_texto_liberar\", \"leer_archivo\", \"_syn_leer_archivo\" };")
        asm("for (int _bi = 0; _bi < (int)(sizeof(_rtb)/sizeof(_rtb[0])); _bi++) {")
        asm("    if (strcmp(_bn, _rtb[_bi]) == 0) return 1;")
        asm("}")
        asm("return 0;")

funcion gen_visitar_top_level(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) exit(1);")
        asm("if (_syn_es_tipo(_t, \"DefinicionFuncion\")) {")
        asm("    gen_visitar_funcion(est, stmt);")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaExpr\")) {")
        asm("    gen_visitar_expr(est, stmt);")
        asm("} else if (_syn_es_tipo(_t, \"AsignacionVariable\")) {")
        asm("    gen_visitar_asignacion(est, stmt);")
        asm("} else if (_syn_es_tipo(_t, \"DefinicionEstructura\")) {")
        asm("    struct DefinicionEstructura* _de = (struct DefinicionEstructura*)_n;")
        asm("    if (_de->nombre.datos && strcmp(_de->nombre.datos, \"Token\") != 0 && strcmp(_de->nombre.datos, \"Nodo\") != 0 && strcmp(_de->nombre.datos, \"ListaNodo\") != 0 && strcmp(_de->nombre.datos, \"Programa\") != 0) {")
        asm("        char _stbuf[4096];")
        asm("        snprintf(_stbuf, 4096, \"typedef struct %s {\", _de->nombre.datos);")
        asm("        gen_emitir_str(est, _stbuf);")
        asm("        struct ListaParametro* _fcp = _de->campos;")
        asm("        while (_fcp) {")
        asm("            struct Parametro* _fp = (struct Parametro*)_fcp->cabeza;")
        asm("            if (_fp && _fp->nombre.datos && _fp->tipo_param.datos) {")
        asm("                traducir_tipo_c_campo((void*)_fp->tipo_param.datos);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                const char* _fct = _gen_tmp_buf;")
        asm("                char _fld[4096];")
        asm("                snprintf(_fld, 4096, \"    %s %s;\", _fct, _fp->nombre.datos);")
        asm("                gen_emitir_str(est, _fld);")
        asm("            }")
        asm("            _fcp = _fcp->cola;")
        asm("        }")
        asm("        char _stclose[4096];")
        asm("        snprintf(_stclose, 4096, \"} %s;\", _de->nombre.datos);")
        asm("        gen_emitir_str(est, _stclose);")
        asm("    }")
        asm("} else if (_syn_es_tipo(_t, \"DeclaracionExterna\")) {")
        asm("    // ME-B6: paridad emit_declarations.py visitar_externa (generator.py L875-880):")
        asm("    // emitir prototipo extern para que funciones de modulos importados compilen.")
        asm("    struct DeclaracionExterna* _dx = (struct DeclaracionExterna*)_n;")
        asm("    if (_dx->nombre.datos) {")
        asm("    // ME-C1: guard de overflow (deuda #4) - paridad con el patron _ep < 4095")
        asm("    // de nodos_flujo.syn: el builder de externs no debe exceder _exps[4096].")
        asm("        char _exbuf[4096];")
        asm("        char _exps[4096] = \"void\"; int _expo = 0, _expf = 1;")
        asm("        struct ListaParametro* _expc = _dx->parametros;")
        asm("        while (_expc) {")
        asm("            struct Parametro* _expar = (struct Parametro*)_expc->cabeza;")
        asm("            if (_expar && _expar->nombre.datos && _expar->tipo_param.datos) {")
        asm("                if (_expf) { _expo = 0; _expf = 0; } else if (_expo < 4094) { _exps[_expo++] = ','; _exps[_expo++] = ' '; }")
        asm("                traducir_tipo_c((void*)_expar->tipo_param.datos);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                const char* _expt = _gen_tmp_buf;")
        asm("                int _exk = 0; while (_expt[_exk] && _expo < 4095) _exps[_expo++] = _expt[_exk++];")
        asm("                if (_expo < 4095) _exps[_expo++] = ' ';")
        asm("                _exk = 0; while (_expar->nombre.datos[_exk] && _expo < 4095) _exps[_expo++] = _expar->nombre.datos[_exk++];")
        asm("            }")
        asm("            _expc = _expc->cola;")
        asm("        }")
        asm("        _exps[_expo] = 0;")
        asm("        const char* _exrt = _dx->tipo_retorno.datos;")
        asm("        if (!_exrt || !_exrt[0]) _exrt = \"nulo\";")
        asm("        traducir_tipo_c((void*)_exrt);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        snprintf(_exbuf, 4096, \"extern %s %s(%s);\", _gen_tmp_buf, _dx->nombre.datos, _exps);")
        asm("        gen_emitir_str(est, _exbuf);")
        asm("    }")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaImportar\")) {")
        asm("    /* skip import - NOT a BloqueInseguro, do NOT cast */")
        asm("}")
        asm("else if (_syn_es_tipo(_t, \"ImportarC\")) {")
        asm("    // ME-C5: paridad visitar_import_c (emit_declarations.py L161-168)")
        asm("    struct ImportarC* _ic = (struct ImportarC*)stmt;")
        asm("    char _icbuf[512];")
        asm("    if (_ic && _ic->ruta.datos) {")
        asm("        if (_ic->es_sistema) { snprintf(_icbuf, 512, \"#include <%s>\", _ic->ruta.datos); }")
        asm("        else { snprintf(_icbuf, 512, \"#include \\\"%s\\\"\", _ic->ruta.datos); }")
        asm("        gen_emitir_str(est, _icbuf);")
        asm("    }")
        asm("}")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionTipo\")) {")
        asm("    // F1.2b: paridad visitar_declaracion_tipo (emit_declarations.py L162-197).")
        asm("    // Alias (`tipo X = Y`) -> `typedef <base> X;`; ADT (`tipo X = ok(T) | err(E)`)")
        asm("    // -> tagged union `typedef struct X { int64_t tag; union {...} dato; } X;`")
        asm("    // (los campos struct se emiten por puntero, como traducir_tipo_c_campo).")
        asm("    struct DeclaracionTipo* _dtx = (struct DeclaracionTipo*)stmt;")
        asm("    if (_dtx && _dtx->nombre.datos) {")
        asm("        if (_dtx->constructores) {")
        asm("            char _dth[4096];")
        asm("            snprintf(_dth, 4096, \"typedef struct %s { int64_t tag; union {\", _dtx->nombre.datos);")
        asm("            gen_emitir_str(est, _dth);")
        asm("            int _dtparts = 0;")
        asm("            struct ListaNodo* _dtc = _dtx->constructores;")
        asm("            while (_dtc) {")
        asm("                struct Nodo* _dtn = _dtc->cabeza;")
        asm("                if (_dtn && _dtn->tipo.datos && strcmp(_dtn->tipo.datos, \"ConstructorTipo\") == 0) {")
        asm("                    struct ConstructorTipo* _ct = (struct ConstructorTipo*)_dtn;")
        asm("                    if (_ct->nombre.datos && _ct->tipos && _ct->tipos->cabeza) {")
        asm("                        struct Identificador* _ctid = (struct Identificador*)_ct->tipos->cabeza;")
        asm("                        if (_ctid->nombre.datos) {")
        asm("                            const char* _ctt = _ctid->nombre.datos;")
        asm("                            // placeholder para parametros de tipo no instanciados (T, E)")
        asm("                            int _is_gen = 0;")
        asm("                            struct ListaNodo* _ptl = _dtx->parametros_tipo;")
        asm("                            while (_ptl) {")
        asm("                                struct Nodo* _ptn = _ptl->cabeza;")
        asm("                                if (_ptn && _ptn->tipo.datos && strcmp(_ptn->tipo.datos, \"Identificador\") == 0) {")
        asm("                                    struct Identificador* _ptid = (struct Identificador*)_ptn;")
        asm("                                    if (_ptid->nombre.datos && strcmp(_ptid->nombre.datos, _ctt) == 0) { _is_gen = 1; break; }")
        asm("                                }")
        asm("                                _ptl = _ptl->cola;")
        asm("                            }")
        asm("                            if (_is_gen) { strcpy(_gen_tmp_buf, \"void*\"); } else { traducir_tipo_c((void*)_ctt); }")
        asm("                            extern char _gen_tmp_buf[4096];")
        asm("                            const char* _ctc = _gen_tmp_buf;")
        asm("                            char _ctbuf[4096];")
        asm("                            if (strncmp(_ctc, \"struct \", 7) == 0) { snprintf(_ctbuf, 4096, \" %s* %s;\", _ctc, _ct->nombre.datos); }")
        asm("                            else { snprintf(_ctbuf, 4096, \" %s %s;\", _ctc, _ct->nombre.datos); }")
        asm("                            gen_emitir_str(est, _ctbuf);")
        asm("                            _dtparts = 1;")
        asm("                        }")
        asm("                    }")
        asm("                }")
        asm("                _dtc = _dtc->cola;")
        asm("            }")
        asm("            if (!_dtparts) { gen_emitir_str(est, \" int _unidad;\"); }")
        asm("            char _dtclose[4096];")
        asm("            snprintf(_dtclose, 4096, \" } dato; } %s;\", _dtx->nombre.datos);")
        asm("            gen_emitir_str(est, _dtclose);")
        asm("            gen_emitir_str(est, \"\");")
        asm("            // R17: los typedefs de instanciaciones se emiten en el")
        asm("            // PRE-BLOQUE (antes del recorrido top-level).")
        asm("        } else if (_dtx->tipo_base.datos && _dtx->tipo_base.datos[0]) {")
        asm("            traducir_tipo_c((void*)_dtx->tipo_base.datos);")
        asm("            extern char _gen_tmp_buf[4096];")
        asm("            char _dtbuf[4096];")
        asm("            snprintf(_dtbuf, 4096, \"typedef %s %s;\", _gen_tmp_buf, _dtx->nombre.datos);")
        asm("            gen_emitir_str(est, _dtbuf);")
        asm("            gen_emitir_str(est, \"\");")
        asm("        }")
        asm("    }")
        asm("}")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSi\")) { gen_visitar_si(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaMientras\")) { gen_visitar_mientras(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRetornar\")) { gen_visitar_retornar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRomper\")) { gen_visitar_romper(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSiguiente\")) { gen_visitar_siguiente(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionVariable\")) { gen_visitar_declaracion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaDelegar\")) { gen_visitar_delegar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionExport\")) {")
        asm("    // F1.2d: @export ( IDENT ) funcion -> visitar la funcion envuelta (Manual 2 L81)")
        asm("    // Transparente al generador: el cuerpo se emite igual.")
        asm("    struct DeclaracionExport* _xew = (struct DeclaracionExport*)_n;")
        asm("    if (_xew && _xew->funcion) { gen_visitar_top_level(est, _xew->funcion); }")
        asm("}")
        asm("else if (_syn_es_tipo(_t, \"BloqueInseguro\")) {")
        asm("    struct BloqueInseguro* _sbi = (struct BloqueInseguro*)stmt;")
        asm("    struct ListaNodo* _sbl = (struct ListaNodo*)_sbi->cuerpo;")
        asm("    while (_sbl) {")
        asm("        struct Nodo* _sbs = _sbl->cabeza;")
        asm("        if (_sbs) { gen_visitar_stmt_generico(est, _sbs); }")
        asm("        _sbl = _sbl->cola;")
        asm("    }")
        asm("}")
        asm("else {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo tipo [%s] no reconocido\\n\", _t);")
        asm("    exit(1);")
        asm("}")


// R20: tipo C de un nodo expresion (recursivo) - paridad S1 tipo_de_expr.
// Resuelve ctors ADT anidados (ok(ok(42))): un ctor como argumento aporta el
// tipo C de su propia instancia (no el fallback 'int'/vacio). Es funcion del
// COMPILADOR (no se emite al C del usuario: alli no existen los structs AST).
funcion _syn_nativo_expr_tipo_c(n: puntero, out: puntero) -> entero:
    inseguro:
        asm("    struct Nodo* _nn = (struct Nodo*)n; char* _oo = (char*)out;")
        asm("    if (!_nn || !_oo) return 0;")
        asm("    _oo[0] = 0;")
        asm("    const char* _t = _nn->tipo.datos;")
        asm("    if (!_t) return 0;")
        asm("    if (strcmp(_t, \"LiteralNumero\") == 0) { strcpy(_oo, \"int64_t\"); return 1; }")
        asm("    if (strcmp(_t, \"LiteralDecimal\") == 0) { strcpy(_oo, \"double\"); return 1; }")
        asm("    if (strcmp(_t, \"LiteralCadena\") == 0) { strcpy(_oo, \"CadenaSegura\"); return 1; }")
