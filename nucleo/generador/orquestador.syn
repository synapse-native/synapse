#lang: es

// ============================================================
// orquestador.syn  —  Orquestador del generador nativo
// ============================================================

// ----------------------------------------------------------
// generar — Punto de entrada principal
// ----------------------------------------------------------
funcion generar(programa: Programa, ruta: cadena) -> entero:
    r = 0
    est = GeneradorCEst()
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Abriendo archivo...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("_G_emit_pos = 0;")
        asm("FILE* _G_out = fopen(ruta.datos, \"w\");")
        asm("if (!_G_out) { fprintf(stderr, \"[Orquestador] ERROR FATAL: No se pudo abrir %s\\n\", ruta.datos); r = 1; return r; }")
        asm("extern FILE* _G_fp; _G_fp = _G_out;")
        asm("fprintf(stderr, \"[Orquestador] Archivo abierto\\n\"); fflush(stderr);")

    gen_emitir_linea(est, "// Generado por Synapse (nuevo generador modular)")
    gen_emitir_linea(est, "// Manual 8 S8.1/S8.2: header de paridad con _emitir_encabezado")
    gen_emitir_linea(est, "#pragma GCC diagnostic ignored \"-Wint-to-pointer-cast\"")
    gen_emitir_linea(est, "#pragma GCC diagnostic ignored \"-Wdiscarded-qualifiers\"")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "#include <stdio.h>")
    gen_emitir_linea(est, "#include <stdlib.h>")
    gen_emitir_linea(est, "#include <stdint.h>")
    gen_emitir_linea(est, "#include <pthread.h>")
    gen_emitir_linea(est, "#include <string.h>")
    gen_emitir_linea(est, "#include <assert.h>")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { int longitud; const char* datos; } CadenaSegura;")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 / paridad emit_expressions.py: comparar cadenas con str_eq,
    // int con ==, seleccionado en compilacion via _Generic (evita inferencia en runtime).
    gen_emitir_linea(est, "#define _SYN_EQ(a,b) _Generic((a), CadenaSegura: (str_eq((a),(b)) == 1), default: ((a)==(b)))")
    gen_emitir_linea(est, "#define _SYN_NE(a,b) _Generic((a), CadenaSegura: (str_eq((a),(b)) == 0), default: ((a)!=(b)))")
    // ME-B7 paridad emit_expressions.py L173-200: concat() para + con cadenas
    // (conversion entero_a_texto/decimal_a_texto segun el operando), seleccion
    // en compilacion via _Generic anidado (sin inferencia de tipos en runtime).
    gen_emitir_linea(est, "#define _SYN_PLUS(a,b) _Generic((a), CadenaSegura: _Generic((b), CadenaSegura: concat((a),(b)), default: concat((a), entero_a_texto((b)))), default: _Generic((b), CadenaSegura: concat(entero_a_texto((a)), (b)), default: ((a)+(b))))")
    // ME-B7 paridad emit_expressions.py L336-343: indice sobre cadena -> .datos[idx]
    gen_emitir_linea(est, "#define _SYN_IDX(o,i) _Generic((o), CadenaSegura: ((CadenaSegura){1, &((o).datos[i])}), default: ((o)[i]))")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { uint32_t filas; uint32_t columnas; float* datos; } Tensor;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct { FILE* stream; int es_valido; int es_virtual; const char* virtual_data; int virtual_len; } Canal;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "#define nulo ((void*)0)")
    gen_emitir_linea(est, "#define verdadero 1")
    gen_emitir_linea(est, "#define falso 0")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "// --- OO AST node types ---")
    gen_emitir_linea(est, "struct Token;")
    gen_emitir_linea(est, "struct Nodo;")
    gen_emitir_linea(est, "struct ListaNodo;")
    gen_emitir_linea(est, "struct Programa;")
    gen_emitir_linea(est, "struct Identificador;")
    gen_emitir_linea(est, "struct LiteralNumero;")
    gen_emitir_linea(est, "struct LiteralCadena;")
    gen_emitir_linea(est, "struct OpBinaria;")
    gen_emitir_linea(est, "struct OpUnaria;")
    gen_emitir_linea(est, "struct LlamadaFuncion;")
    gen_emitir_linea(est, "struct ExprAccesoCampo;")
    gen_emitir_linea(est, "struct AsignacionVariable;")
    gen_emitir_linea(est, "struct AsignacionCampo;")
    gen_emitir_linea(est, "struct SentenciaSi;")
    gen_emitir_linea(est, "struct SentenciaMientras;")
    gen_emitir_linea(est, "struct SentenciaRetornar;")
    gen_emitir_linea(est, "struct SentenciaExpr;")
    gen_emitir_linea(est, "struct LogLlamada;")
    gen_emitir_linea(est, "struct Parametro;")
    gen_emitir_linea(est, "struct ListaParametro;")
    gen_emitir_linea(est, "struct DefinicionFuncion;")
    gen_emitir_linea(est, "struct DefinicionEstructura;")
    gen_emitir_linea(est, "struct SentenciaRomper;")
    gen_emitir_linea(est, "struct SentenciaSiguiente;")
    gen_emitir_linea(est, "struct SentenciaImportar;")
    gen_emitir_linea(est, "struct DeclaracionExterna;")
    gen_emitir_linea(est, "struct DeclaracionVariable;")
    gen_emitir_linea(est, "struct BloqueInseguro;")
    gen_emitir_linea(est, "struct ExprObtenerDireccion;")
    gen_emitir_linea(est, "struct ExprDereferencia;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "typedef struct Token { int tipo; CadenaSegura lexema; int linea; int columna; } Token;")
    gen_emitir_linea(est, "typedef struct Nodo { CadenaSegura tipo; } Nodo;")
    gen_emitir_linea(est, "typedef struct ListaNodo { struct Nodo* cabeza; struct ListaNodo* cola; } ListaNodo;")
    gen_emitir_linea(est, "typedef struct Programa { CadenaSegura tipo; struct ListaNodo* sentencias; } Programa;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "char _gen_tmp_buf[4096];")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "char _G_emit_buf[1048576];")
    gen_emitir_linea(est, "int _G_emit_pos;")
    gen_emitir_linea(est, "FILE* _G_fp;")
    gen_emitir_linea(est, "int _G_scope_depth;")
    gen_emitir_linea(est, "int _G_scope_vars_depth[256];")
    gen_emitir_linea(est, "char _G_scope_vars_names[256][64];")
    gen_emitir_linea(est, "int _G_scope_vars_total;")
    gen_emitir_linea(est, "int _G_safe_mode;  // M22.5: --safe flag for lifetime assertions")
    gen_emitir_linea(est, "")
    // ME-B4: definiciones nativas (paridad _emit_cabecera_comun)
    gen_emitir_linea(est, "char _G_native_structs[256][64];")
    gen_emitir_linea(est, "int _G_native_structs_count;")
    gen_emitir_linea(est, "int _G_native_es_estructura(const char* n) {")
    gen_emitir_linea(est, "    if (!n) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_structs_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_structs[_i], n) == 0) return 1;")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-B6: tipos de retorno (definiciones nativas)
    gen_emitir_linea(est, "char _G_native_func_returns[512][64];")
    gen_emitir_linea(est, "int _G_native_func_returns_count;")
    gen_emitir_linea(est, "int _G_native_tipo_retorno(const char* fn, char* out) {")
    gen_emitir_linea(est, "    if (!fn || !out) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_func_returns_count; _i++) {")
    gen_emitir_linea(est, "        if (strcmp(_G_native_func_returns[_i], fn) == 0) {")
    gen_emitir_linea(est, "            strcpy(out, _G_native_func_returns[_i + 256]); return 1;")
    gen_emitir_linea(est, "        }")
    gen_emitir_linea(est, "    }")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-B7: dedup de funciones emitidas (paridad _funciones_emitidas de la referencia)
    gen_emitir_linea(est, "char _G_emit_func_names[2048][64];")
    gen_emitir_linea(est, "int _G_emit_func_count;")
    gen_emitir_linea(est, "")
    // ME-B7: variables declaradas por funcion (hoisting: primera declaracion gana)
    gen_emitir_linea(est, "char _G_fn_vars[2048][64];")
    gen_emitir_linea(est, "int _G_fn_vars_count;")
    gen_emitir_linea(est, "// ME-B9.x: parametros de la funcion actual pasados por puntero (_POINTER_TYPES)")
    gen_emitir_linea(est, "char _G_fn_ptr_vars[64][64];")
    gen_emitir_linea(est, "int _G_fn_ptr_vars_count;")
    // ME-B7: nodo fuente de cada variable auto-declarada (inferencia de tipo en hoisting)
    gen_emitir_linea(est, "void* _G_fn_var_src[2048];")
    gen_emitir_linea(est, "int _G_fn_var_auto[2048];")
    gen_emitir_linea(est, "")
    // ME-B6: PGO globals del parser nativo (definidos en _parser.c)
    gen_emitir_linea(est, "extern int _P_ntks, _P_tpos, _P_p_err;")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "int _g_argc;")
    gen_emitir_linea(est, "char** _g_argv;")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 paridad con _emitir_cabecera_comun de la referencia:
    // definiciones de runtime helpers usados por el self-host (ver generator.py).
    gen_emitir_linea(est, "int _argc() { return _g_argc; }")
    gen_emitir_linea(est, "CadenaSegura _argv(int i) {")
    gen_emitir_linea(est, "    if (i < 0 || i >= _g_argc) return (CadenaSegura){0, \"\"};")
    gen_emitir_linea(est, "    return (CadenaSegura){ .longitud = (int)strlen(_g_argv[i]), .datos = _g_argv[i] };")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "void salir(int codigo) { exit(codigo); }")
    gen_emitir_linea(est, "CadenaSegura concat(CadenaSegura a, CadenaSegura b) {")
    gen_emitir_linea(est, "    int _tl = a.longitud + b.longitud;")
    gen_emitir_linea(est, "    char* _buf = (char*)malloc(_tl + 1);")
    gen_emitir_linea(est, "    if (!_buf) { fprintf(stderr, \"Error: malloc fallo en concat()\\n\"); exit(1); }")
    gen_emitir_linea(est, "    memcpy(_buf, a.datos, a.longitud);")
    gen_emitir_linea(est, "    memcpy(_buf + a.longitud, b.datos, b.longitud);")
    gen_emitir_linea(est, "    _buf[_tl] = 0;")
    gen_emitir_linea(est, "    return (CadenaSegura){_tl, _buf};")
    gen_emitir_linea(est, "}")
    gen_emitir_linea(est, "")
    // ME-B1/B3 fix: tipos TOML y pool allocator (paridad _synapse_shared.h / embedded_libs.h)
    gen_emitir_linea(est, "typedef struct ParToml { CadenaSegura clave; struct NodoToml* valor; } ParToml;")
    gen_emitir_linea(est, "typedef struct NodoToml { int tipo; CadenaSegura valor_str; int valor_ent; struct ParToml* pares; int longitud; } NodoToml;")
    gen_emitir_linea(est, "extern struct NodoToml _toml_parse(CadenaSegura entrada);")
    gen_emitir_linea(est, "extern struct NodoToml _toml_nodo_new(void);")
    gen_emitir_linea(est, "extern void _toml_nodo_liberar(struct NodoToml n);")
    gen_emitir_linea(est, "extern struct NodoToml _toml_object_get(struct NodoToml nodo, CadenaSegura clave);")
    gen_emitir_linea(est, "")
    gen_emitir_linea(est, "extern void pool_init(uint32_t total_blocks, uint32_t block_size);")
    gen_emitir_linea(est, "extern void pool_free(void* ptr);")
    gen_emitir_linea(est, "extern void* pool_alloc(size_t size);")
    gen_emitir_linea(est, "extern void pool_destroy(void);")
    gen_emitir_linea(est, "")
    // Manual 8 S8.2 / paridad _emitir_encabezado (generator.py L544-560):
    // externs de builtins de runtime definidos en synapse_rt.o
    gen_emitir_linea(est, "extern void escribir(CadenaSegura contenido);")
    gen_emitir_linea(est, "extern void escribir_linea(CadenaSegura contenido);")
    gen_emitir_linea(est, "extern CadenaSegura leer_linea(void);")
    gen_emitir_linea(est, "extern Canal abrir(CadenaSegura ruta, CadenaSegura modo);")
    gen_emitir_linea(est, "extern CadenaSegura leer(Canal canal);")
    gen_emitir_linea(est, "extern void cerrar(Canal canal);")
    gen_emitir_linea(est, "extern Tensor crear_tensor(int filas, int columnas);")
    gen_emitir_linea(est, "extern Tensor suma_tensor(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor producto_punto(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor relu(Tensor a);")
    gen_emitir_linea(est, "extern Tensor reserva(int tamano);")
    gen_emitir_linea(est, "extern void libera(Tensor bloque);")
    gen_emitir_linea(est, "extern Tensor suma(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern Tensor producto(Tensor a, Tensor b);")
    gen_emitir_linea(est, "extern int texto_a_entero(CadenaSegura str);")
    gen_emitir_linea(est, "extern float texto_a_decimal(CadenaSegura str);")
    gen_emitir_linea(est, "extern CadenaSegura decimal_a_texto(float n);")
    gen_emitir_linea(est, "extern CadenaSegura entero_a_texto(int n);")
    gen_emitir_linea(est, "extern int str_eq(CadenaSegura a, CadenaSegura b);")
    gen_emitir_linea(est, "extern void synapse_lanzar_hilo(void* (*fn)(void*), void* arg);")
    gen_emitir_linea(est, "extern void synapse_esperar_hilos(void);")
    gen_emitir_linea(est, "extern void _syn_texto_liberar(CadenaSegura s);")
    gen_emitir_linea(est, "typedef struct CanalConcurrencia CanalConcurrencia;")
    gen_emitir_linea(est, "extern CanalConcurrencia* canal_crear(uint32_t capacidad);")
    gen_emitir_linea(est, "extern void canal_enviar(CanalConcurrencia* canal, void* paquete);")
    gen_emitir_linea(est, "extern void* canal_recibir(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void canal_destruir(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void cerrar_canal(CanalConcurrencia* canal);")
    gen_emitir_linea(est, "extern void _simd_detectar(void);")
    gen_emitir_linea(est, "")

    // ME-B4: recolectar nombres de estructuras definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B4: escaneando estructuras\\n\"); fflush(stderr);")
        asm("extern char _G_native_structs[256][64]; extern int _G_native_structs_count;")
        asm("_G_native_structs_count = 0;")
        asm("struct ListaNodo* _gec = programa.sentencias;")
        asm("while (_gec && _G_native_structs_count < 256) {")
        asm("    struct Nodo* _gen = _gec->cabeza;")
        asm("    if (_gen && _gen->tipo.datos && strcmp(_gen->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _ged = (struct DefinicionEstructura*)_gen;")
        asm("        if (_ged->nombre.datos && strcmp(_ged->nombre.datos, \"Token\") != 0 && strcmp(_ged->nombre.datos, \"Nodo\") != 0 && strcmp(_ged->nombre.datos, \"ListaNodo\") != 0 && strcmp(_ged->nombre.datos, \"Programa\") != 0) {")
        asm("            strncpy(_G_native_structs[_G_native_structs_count], _ged->nombre.datos, 63);")
        asm("            _G_native_structs[_G_native_structs_count][63] = 0;")
        asm("            _G_native_structs_count++;")
        asm("        }")
        asm("    }")
        asm("    _gec = _gec->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B4: %d estructuras registradas\\n\", _G_native_structs_count); fflush(stderr);")

    // ME-B6: recolectar tipos de retorno de funciones definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B6: escaneando tipos de retorno\\n\"); fflush(stderr);")
        asm("extern char _G_native_func_returns[512][64]; extern int _G_native_func_returns_count;")
        asm("_G_native_func_returns_count = 0;")
        asm("// ME-B6 paridad context.py:52 / emit_selfhost.py L914: seed de builtins de runtime\n")
        asm("// (sus tipos de retorno no estan en el AST; sin seed, x = _argv(1) infiere int).\n")
        asm("static const char* _G_rt_builtin_fns[] = { \"_argv\",\"leer\",\"leer_linea\",\"concat\",\"entero_a_texto\",\"decimal_a_texto\",\"subcadena\",\"_syn_obtener_env\",\"leer_archivo\",\"_syn_leer_archivo\",\"texto_a_entero\",\"texto_a_decimal\",\"salir\",\"escribir\",\"escribir_linea\",\"cerrar\",\"_argc\" };")
        asm("static const char* _G_rt_builtin_ret[] = { \"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"entero\",\"decimal\",\"nulo\",\"nulo\",\"nulo\",\"nulo\",\"entero\" };")
        asm("for (int _rbi = 0; _rbi < (int)(sizeof(_G_rt_builtin_fns)/sizeof(_G_rt_builtin_fns[0])); _rbi++) {")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count], _G_rt_builtin_fns[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _G_rt_builtin_ret[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("    _G_native_func_returns_count++;")
        asm("}")
        asm("struct ListaNodo* _gefr = programa.sentencias;")
        asm("while (_gefr && _G_native_func_returns_count < 255) {")
        asm("    struct Nodo* _gefn = _gefr->cabeza;")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _geff = (struct DefinicionFuncion*)_gefn;")
        asm("        if (_geff->nombre.datos && _geff->tipo_retorno.datos) {")
        asm("            strncpy(_G_native_func_returns[_G_native_func_returns_count], _geff->nombre.datos, 63);")
        asm("            _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("            strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _geff->tipo_retorno.datos, 63);")
        asm("            _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("            _G_native_func_returns_count++;")
        asm("        }")
        asm("        } else if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DeclaracionExterna\") == 0) {")
        asm("            struct DeclaracionExterna* _gex = (struct DeclaracionExterna*)_gefn;")
        asm("            if (_gex->nombre.datos && _gex->tipo_retorno.datos) {")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count], _gex->nombre.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _gex->tipo_retorno.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("                _G_native_func_returns_count++;")
        asm("            }")
        asm("        }")
        asm("    _gefr = _gefr->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B6: %d retornos registrados\\n\", _G_native_func_returns_count); fflush(stderr);")

    // WALK TOP-LEVEL AST
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Iniciando recorrido AST\\n\"); fflush(stderr);")
        asm("// Manual 8 S8.2: orden alfabetico estricto en emision de funciones/estructuras")
        asm("// Colectar todos los nodos top-level en un array para ordenarlos")
        asm("#define _MAX_TOP_NODOS 4096")
        asm("struct Nodo* _top_nodes[_MAX_TOP_NODOS];")
        asm("int _top_count = 0;")
        asm("struct ListaNodo* _cur = programa.sentencias;")
        asm("char _top_seen_names[2048][64]; int _top_seen_count = 0;")
        asm("while (_cur && _top_count < _MAX_TOP_NODOS) {")
        asm("    struct Nodo* _n = _cur->cabeza;")
        asm("    if (_n && _n->tipo.datos) {")
        asm("        const char* _tcf = _n->tipo.datos;")
        asm("        int _drop = 0;")
        asm("        // Manual 8 S8.2 determinismo: descartar el artefacto 'constante' parseado como SentenciaExpr\n")
        asm("        if (strcmp(_tcf, \"SentenciaExpr\") == 0) {")
        asm("            struct SentenciaExpr* _sfc = (struct SentenciaExpr*)_n;")
        asm("            if (_sfc->expr && _sfc->expr->tipo.datos && strcmp(_sfc->expr->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _idc = (struct Identificador*)_sfc->expr;")
        asm("                if (_idc->nombre.datos && strcmp(_idc->nombre.datos, \"constante\") == 0) _drop = 1;")
        asm("            }")
        asm("        }")
        asm("        // Manual 8 S8.2 determinismo: deduplicar constantes globales por nombre (primero gana)\n")
        asm("        const char* _cname = 0;")
        asm("        if (strcmp(_tcf, \"AsignacionVariable\") == 0) {")
        asm("            struct AsignacionVariable* _avc = (struct AsignacionVariable*)_n;")
        asm("            if (_avc->nombre.datos) _cname = _avc->nombre.datos;")
        asm("        }")
        asm("        if (_cname) {")
        asm("            int _seen = 0;")
        asm("            for (int _si2 = 0; _si2 < _top_seen_count; _si2++) { if (strcmp(_top_seen_names[_si2], _cname) == 0) { _seen = 1; break; } }")
        asm("            if (_seen) { _drop = 1; } else { strncpy(_top_seen_names[_top_seen_count], _cname, 63); _top_seen_count++; }")
        asm("        }")
        asm("        if (!_drop) { _top_nodes[_top_count++] = _n; }")
        asm("    }")
        asm("    _cur = _cur->cola;")
        asm("}")
        asm("// Bubble sort por nombre de funcion/estructura; otros tipos conservan orden relativo")
        asm("for (int _si = 0; _si < _top_count - 1; _si++) {")
        asm("    for (int _sj = 0; _sj < _top_count - 1 - _si; _sj++) {")
        asm("        struct Nodo* _a = _top_nodes[_sj];")
        asm("        struct Nodo* _b = _top_nodes[_sj+1];")
        asm("        const char* _ta = _a->tipo.datos;")
        asm("        const char* _tb = _b->tipo.datos;")
        asm("        int _swap = 0;")
        asm("        // Solo ordenar funciones y estructuras por nombre")
        asm("        if (_ta && _tb && strcmp(_ta, \"DefinicionFuncion\") == 0 && strcmp(_tb, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _fa = (struct DefinicionFuncion*)_a;")
        asm("            struct DefinicionFuncion* _fb = (struct DefinicionFuncion*)_b;")
        asm("            if (_fa->nombre.datos && _fb->nombre.datos && strcmp(_fa->nombre.datos, _fb->nombre.datos) > 0) _swap = 1;")
        asm("        } else if (_ta && _tb && strcmp(_ta, \"DefinicionEstructura\") == 0 && strcmp(_tb, \"DefinicionEstructura\") == 0) {")
        asm("            struct DefinicionEstructura* _ea = (struct DefinicionEstructura*)_a;")
        asm("            struct DefinicionEstructura* _eb = (struct DefinicionEstructura*)_b;")
        asm("            if (_ea->nombre.datos && _eb->nombre.datos && strcmp(_ea->nombre.datos, _eb->nombre.datos) > 0) _swap = 1;")
        asm("        }")
        asm("        if (_swap) { struct Nodo* _tmp = _top_nodes[_sj]; _top_nodes[_sj] = _top_nodes[_sj+1]; _top_nodes[_sj+1] = _tmp; }")
        asm("    }")
        asm("}")
        asm("// Fase 1: emitir TODAS las DefinicionEstructura primero (dependencias de tipos)")
        asm("fprintf(stderr, \"[Orquestador] Fase 1: emitiendo estructuras\\n\"); fflush(stderr);")
        asm("for (int _ei = 0; _ei < _top_count; _ei++) {")
        asm("    struct Nodo* _en = _top_nodes[_ei];")
        asm("    if (_en && _en->tipo.datos && strcmp(_en->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _de0 = (struct DefinicionEstructura*)_en;")
        asm("        if (_de0->nombre.datos && strcmp(_de0->nombre.datos, \"Token\") != 0 && strcmp(_de0->nombre.datos, \"Nodo\") != 0 && strcmp(_de0->nombre.datos, \"ListaNodo\") != 0 && strcmp(_de0->nombre.datos, \"Programa\") != 0) {")
        asm("            char _stbuf0[4096];")
        asm("            snprintf(_stbuf0, 4096, \"typedef struct %s {\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stbuf0);")
        asm("            struct ListaParametro* _fcp0 = _de0->campos;")
        asm("            while (_fcp0) {")
        asm("                struct Parametro* _fp0 = (struct Parametro*)_fcp0->cabeza;")
        asm("                if (_fp0 && _fp0->nombre.datos && _fp0->tipo_param.datos) {")
        asm("                    // ME-B7: _ARRAY_OVERRIDE_FIELDS (paridad context.py L236-239):")
        asm("                    // pila_indent es int[64] aunque el .syn declara entero (asm() raw lo indexa).")
        asm("                    if (strcmp(_fp0->nombre.datos, \"pila_indent\") == 0) { gen_emitir_str(est, \"    int pila_indent[64];\"); }")
        asm("                    else {")
        asm("                        traducir_tipo_c_campo((void*)_fp0->tipo_param.datos);")
        asm("                        extern char _gen_tmp_buf[4096];")
        asm("                        const char* _fct0 = _gen_tmp_buf;")
        asm("                        char _fld0[4096];")
        asm("                        snprintf(_fld0, 4096, \"    %s %s;\", _fct0, _fp0->nombre.datos);")
        asm("                        gen_emitir_str(est, _fld0);")
        asm("                    }")
        asm("                }")
        asm("                _fcp0 = _fcp0->cola;")
        asm("            }")
        asm("            char _stclose0[4096];")
        asm("            snprintf(_stclose0, 4096, \"} %s;\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stclose0);")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// ME-B7: prototipos de funciones (Manual 8 S8.2, paridad _emit_prototipos_funciones + _SPECIAL_SIGS)")
        asm("// El C de salida no tiene prototipos si no se emiten: las llamadas entre modulos")
        asm("// (orden alfabetico) fallarian con 'implicit declaration / conflicting types'.")
        asm("_G_emit_func_count = 0;")
        asm("for (int _pi = 0; _pi < _top_count; _pi++) {")
        asm("    struct Nodo* _pn0 = _top_nodes[_pi];")
        asm("    if (!_pn0 || !_pn0->tipo.datos || strcmp(_pn0->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    struct DefinicionFuncion* _pf0 = (struct DefinicionFuncion*)_pn0;")
        asm("    if (!_pf0->nombre.datos || !_pf0->tipo_retorno.datos) continue;")
        asm("    const char* _pfn0 = _pf0->nombre.datos;")
        asm("    // Paridad emit_selfhost.py L1203: saltar builtins de runtime (str_eq, etc.)")
        asm("    if (_es_builtin_runtime((void*)_pfn0)) continue;")
        asm("    // Dedup por nombre (parser.syn define parsear_tipo_retorno 2 veces; la referencia")
        asm("    // usa _funciones_emitidas — paridad: primer prototipo gana).")
        asm("    int _pfd = 0;")
        asm("    for (int _pd = 0; _pd < _G_emit_func_count; _pd++) { if (strcmp(_G_emit_func_names[_pd], _pfn0) == 0) { _pfd = 1; break; } }")
        asm("    if (_pfd) continue;")
        asm("    strncpy(_G_emit_func_names[_G_emit_func_count], _pfn0, 63); _G_emit_func_names[_G_emit_func_count][63] = 0; _G_emit_func_count++;")
        asm("    char _psig0[4096];")
        asm("    // _SPECIAL_SIGS: firmas canonicas que reemplazan las definiciones legacy")
        asm("    if (strcmp(_pfn0, \"tokenizar\") == 0) { strcpy(_psig0, \"int tokenizar(CadenaSegura fuente);\"); }")
        asm("    else if (strcmp(_pfn0, \"parsear\") == 0) { strcpy(_psig0, \"struct Programa parsear(CadenaSegura fuente);\"); }")
        asm("    else if (strcmp(_pfn0, \"volcar_ast\") == 0) { strcpy(_psig0, \"void volcar_ast(struct Nodo* nodo, int nivel);\"); }")
        asm("    else if (strcmp(_pfn0, \"generar\") == 0) { strcpy(_psig0, \"int generar(struct Programa programa, CadenaSegura ruta);\"); }")
        asm("    else {")
        asm("        char _pp0[4096] = \"void\"; int _ppo0 = 0, _ppf0 = 1;")
        asm("        struct ListaParametro* _ppc0 = _pf0->parametros;")
        asm("        while (_ppc0) {")
        asm("            struct Parametro* _ppar = (struct Parametro*)_ppc0->cabeza;")
        asm("            if (_ppar && _ppar->nombre.datos && _ppar->tipo_param.datos) {")
        asm("                if (_ppf0) { _ppo0 = 0; _ppf0 = 0; } else { _pp0[_ppo0++] = ','; _pp0[_ppo0++] = ' '; }")
        asm("                const char* _ppt0 = _ppar->tipo_param.datos;")
        asm("                traducir_tipo_c((void*)_ppt0);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                const char* _pct0 = _gen_tmp_buf;")
        asm("                // Manual 3 S3.3 / paridad _POINTER_TYPES: tipos de estado se pasan por puntero")
        asm("                if (_ppt0 && (strcmp(_ppt0, \"AnalizadorSemanticoEst\") == 0 || strcmp(_ppt0, \"RegionGraph\") == 0 || strcmp(_ppt0, \"UnionFind\") == 0)) { strcat(_gen_tmp_buf, \"*\"); _pct0 = _gen_tmp_buf; }")
        asm("                int _pk0 = 0; while (_pct0[_pk0]) _pp0[_ppo0++] = _pct0[_pk0++];")
        asm("                _pp0[_ppo0++] = ' ';")
        asm("                _pk0 = 0; while (_ppar->nombre.datos[_pk0]) _pp0[_ppo0++] = _ppar->nombre.datos[_pk0++];")
        asm("            }")
        asm("            _ppc0 = _ppc0->cola;")
        asm("        }")
        asm("        _pp0[_ppo0] = 0;")
        asm("        traducir_tipo_c((void*)_pf0->tipo_retorno.datos);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        snprintf(_psig0, 4096, \"%s %s(%s);\", _gen_tmp_buf, _pfn0, _pp0);")
        asm("    }")
        asm("    gen_emitir_str(est, _psig0);")
        asm("}")
        asm("gen_emitir_str(est, \"\");")
        asm("// Manual 8 S8.2 / paridad _emit_cuerpos (generator.py L747-753):")
        asm("// Fase 2A: emitir PRIMERO las sentencias no-funcion (constantes globales, externs,")
        asm("// imports) en orden de parse — requisito de C: las constantes deben existir antes")
        asm("// que cualquier cuerpo de funcion que las use.")
        asm("_G_emit_func_count = 0;")
        asm("fprintf(stderr, \"[Orquestador] Fase 2A: no-funciones primero\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") == 0) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionEstructura\") == 0) continue;")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")
        asm("// Fase 2B: funciones en orden alfabetico (Manual 8 S8.2)")
        asm("fprintf(stderr, \"[Orquestador] Fase 2B: funciones en orden alfabetico\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")

    // Manual 8 S8.3 / paridad referencia: PGO via flags GCC (sin atexit manual)

    // Emit main() wrapper
    // Manual 8 S8.2 / paridad emit_selfhost.py L1207: NO usar el valor de
    // retorno de principal() — si principal retorna nulo (void) el C fallaria
    // con 'void value not ignored'. La referencia llama principal();,
    // synapse_esperar_hilos();, pool_destroy(); y retorna 0.
    gen_emitir_linea(est, "int main(int argc, char** argv) {")
    gen_emitir_linea(est, "    _g_argc = argc;")
    gen_emitir_linea(est, "    _g_argv = argv;")
    gen_emitir_linea(est, "    pool_init(64, 4096);")
    gen_emitir_linea(est, "    principal();")
    gen_emitir_linea(est, "    synapse_esperar_hilos();")
    gen_emitir_linea(est, "    pool_destroy();")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")

    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Escribiendo archivo de salida...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("extern FILE* _G_fp;")
        asm("if (!_G_fp) { fprintf(stderr, \"[Orquestador] ERROR FATAL: _G_fp nulo\\n\"); r = 1; return r; }")
        asm("if (_G_emit_pos > 0) {")
        asm("    fwrite(_G_emit_buf, 1, _G_emit_pos, _G_fp);")
        asm("}")
        asm("fclose(_G_fp);")
        asm("_G_fp = nulo;")
        asm("fprintf(stderr, \"[Nuevo Generador] Codigo C generado exitosamente\\n\"); fflush(stderr);")
    retornar r

