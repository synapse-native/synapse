#lang: es

// ============================================================
// escaneo.syn - escaneo de declaraciones (estructuras, retornos, alias, constructores)
// ============================================================
// Extraido de orquestador.syn en la modularizacion (deuda
// AUDITORIA_ALINEACION_MANUALES: orquestador.syn 101KB / 1350
// lineas con generar() como monolito de 932 lineas). Los bloques
// asm se mueven TEXTUALMENTE (misma indentacion) a funciones que
// generar() invoca en el mismo orden -> el C generado no cambia.

// ----------------------------------------------------------
// gen_escanear_estructuras - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_estructuras(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-B4: recolectar nombres de estructuras definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B4: escaneando estructuras\\n\"); fflush(stderr);")
        asm("extern char _G_native_structs[256][64]; extern int _G_native_structs_count;")
        asm("_G_native_structs_count = 0;")
        asm("struct ListaNodo* _gec = programa.sentencias;")
        asm("while (_gec && _G_native_structs_count < 256) {")
        asm("    struct Nodo* _gen = _gec->cabeza;")
        asm("    if (_gen && _gen->tipo.datos && strcmp(_gen->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _ged = (struct DefinicionEstructura*)_gen;")
        asm("        if (_ged->nombre.datos && strcmp(_ged->nombre.datos, \"Token\") != 0 && strcmp(_ged->nombre.datos, \"Nodo\") != 0 && strcmp(_ged->nombre.datos, \"ListaNodo\") != 0 && strcmp(_ged->nombre.datos, \"Programa\") != 0) {")
        asm("            strncpy(_G_native_structs[_G_native_structs_count], _ged->nombre.datos, 63);")
        asm("            _G_native_structs[_G_native_structs_count][63] = 0;")
        asm("            _G_native_structs_count++;")
        asm("        }")
        asm("    }")
        asm("    _gec = _gec->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B4: %d estructuras registradas\\n\", _G_native_structs_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_retornos - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_retornos(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-B6: recolectar tipos de retorno de funciones definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B6: escaneando tipos de retorno\\n\"); fflush(stderr);")
        asm("extern char _G_native_func_returns[512][64]; extern int _G_native_func_returns_count;")
        asm("_G_native_func_returns_count = 0;")
        asm("// ME-B6 paridad context.py:52 / emit_selfhost.py L914: seed de builtins de runtime\n")
        asm("// (sus tipos de retorno no estan en el AST; sin seed, x = _argv(1) infiere int).\n")
        asm("// F3-4: seed ampliado con paridad context.py _BUILTINS - abrir->canal,\n")
        asm("// crear_tensor/reserva/suma_tensor/producto_punto/suma/producto/relu->tensor.\n")
        asm("// (let sin anotacion inferia int64_t para builtins que retornan Canal/Tensor).\n")
        asm("static const char* _G_rt_builtin_fns[] = { \"_argv\",\"leer\",\"leer_linea\",\"concat\",\"entero_a_texto\",\"decimal_a_texto\",\"subcadena\",\"_syn_obtener_env\",\"leer_archivo\",\"_syn_leer_archivo\",\"texto_a_entero\",\"texto_a_decimal\",\"salir\",\"escribir\",\"escribir_linea\",\"cerrar\",\"_argc\",\"abrir\",\"crear_tensor\",\"reserva\",\"suma_tensor\",\"producto_punto\",\"suma\",\"producto\",\"relu\" };")
        asm("static const char* _G_rt_builtin_ret[] = { \"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"entero\",\"decimal\",\"nulo\",\"nulo\",\"nulo\",\"nulo\",\"entero\",\"canal\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\" };")
        asm("for (int _rbi = 0; _rbi < (int)(sizeof(_G_rt_builtin_fns)/sizeof(_G_rt_builtin_fns[0])); _rbi++) {")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count], _G_rt_builtin_fns[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _G_rt_builtin_ret[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("    _G_native_func_returns_count++;")
        asm("}")
        asm("struct ListaNodo* _gefr = programa.sentencias;")
        asm("// ME-C2: dedup del escaneo contra el seed de builtins (deuda ME-B8 nota 1).")
        asm("// Paridad semantic_types.py:258: las funciones de usuario tienen precedencia")
        asm("// sobre los builtins. Si el nombre ya existe en _G_native_func_returns")
        asm("// (seed o AST previo), SOBRESCRIBIR el tipo de retorno (usuario gana).")
        asm("while (_gefr && _G_native_func_returns_count < 255) {")
        asm("    struct Nodo* _gefn = _gefr->cabeza;")
        asm("    // F1.2d: des-envolver funciones @export (Manual 2 L81) para el registro")
        asm("    // de tipos de retorno (las llamadas a funciones exportadas infieren bien).")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DeclaracionExport\") == 0) {")
        asm("        struct DeclaracionExport* _gexn = (struct DeclaracionExport*)_gefn;")
        asm("        if (_gexn->funcion && _gexn->funcion->tipo.datos && strcmp(_gexn->funcion->tipo.datos, \"DefinicionFuncion\") == 0) { _gefn = _gexn->funcion; }")
        asm("    }")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _geff = (struct DefinicionFuncion*)_gefn;")
        asm("        if (_geff->nombre.datos && _geff->tipo_retorno.datos) {")
        asm("            int _geidx = -1;")
        asm("            for (int _gei = 0; _gei < _G_native_func_returns_count; _gei++) { if (strcmp(_G_native_func_returns[_gei], _geff->nombre.datos) == 0) { _geidx = _gei; break; } }")
        asm("            if (_geidx >= 0) {")
        asm("                strncpy(_G_native_func_returns[_geidx + 256], _geff->tipo_retorno.datos, 63);")
        asm("                _G_native_func_returns[_geidx + 256][63] = 0;")
        asm("            } else {")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count], _geff->nombre.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _geff->tipo_retorno.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("                _G_native_func_returns_count++;")
        asm("            }")
        asm("        }")
        asm("        } else if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DeclaracionExterna\") == 0) {")
        asm("            struct DeclaracionExterna* _gex = (struct DeclaracionExterna*)_gefn;")
        asm("            if (_gex->nombre.datos && _gex->tipo_retorno.datos) {")
        asm("                int _gexidx = -1;")
        asm("                for (int _gei2 = 0; _gei2 < _G_native_func_returns_count; _gei2++) { if (strcmp(_G_native_func_returns[_gei2], _gex->nombre.datos) == 0) { _gexidx = _gei2; break; } }")
        asm("                if (_gexidx >= 0) {")
        asm("                    strncpy(_G_native_func_returns[_gexidx + 256], _gex->tipo_retorno.datos, 63);")
        asm("                    _G_native_func_returns[_gexidx + 256][63] = 0;")
        asm("                } else {")
        asm("                    strncpy(_G_native_func_returns[_G_native_func_returns_count], _gex->nombre.datos, 63);")
        asm("                    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("                    strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _gex->tipo_retorno.datos, 63);")
        asm("                    _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("                    _G_native_func_returns_count++;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    _gefr = _gefr->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B6: %d retornos registrados\\n\", _G_native_func_returns_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_aliases - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_aliases(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-F1.2b: registrar alias de tipo declarados (`tipo X = Y`, sin constructores)
    // paridad pre-pass generator.py L871-890: se registran ANTES de prototipos/cuerpos
    // para que traducir_tipo_c los resuelva durante la emision.
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] F1.2b: escaneando alias de tipo\\n\"); fflush(stderr);")
        asm("extern char _G_tipo_aliases[128][64]; extern char _G_tipo_aliases_base[128][64]; extern int _G_tipo_aliases_count;")
        asm("_G_tipo_aliases_count = 0;")
        asm("struct ListaNodo* _getd = programa.sentencias;")
        asm("while (_getd && _G_tipo_aliases_count < 128) {")
        asm("    struct Nodo* _getn = _getd->cabeza;")
        asm("    if (_getn && _getn->tipo.datos && strcmp(_getn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _get = (struct DeclaracionTipo*)_getn;")
        asm("        if (_get->nombre.datos && _get->tipo_base.datos && _get->tipo_base.datos[0]) {")
        asm("            strncpy(_G_tipo_aliases[_G_tipo_aliases_count], _get->nombre.datos, 63);")
        asm("            _G_tipo_aliases[_G_tipo_aliases_count][63] = 0;")
        asm("            strncpy(_G_tipo_aliases_base[_G_tipo_aliases_count], _get->tipo_base.datos, 63);")
        asm("            _G_tipo_aliases_base[_G_tipo_aliases_count][63] = 0;")
        asm("            _G_tipo_aliases_count++;")
        asm("        }")
        asm("    }")
        asm("    _getd = _getd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] F1.2b: %d alias registrados\\n\", _G_tipo_aliases_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_constructores - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_constructores(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-D6: registrar constructores ADT (ok/err/algun/ninguno) - paridad
    // pre-pass generator.py _constructores_adt. Necesario para expr_eval.syn
    // (constructores -> compound literal) y la inferencia de ExprPropagar.
    inseguro:
        asm("extern char _G_native_adt_ctrs[256][64]; extern char _G_native_adt_ctrs_adt[256][64]; extern int _G_native_adt_ctrs_tag[256]; extern char _G_native_adt_ctrs_tipo[256][64]; extern int _G_native_adt_ctrs_count;")
        asm("_G_native_adt_ctrs_count = 0;")
        asm("struct ListaNodo* _gacd = programa.sentencias;")
        asm("while (_gacd && _G_native_adt_ctrs_count < 256) {")
        asm("    struct Nodo* _gacn = _gacd->cabeza;")
        asm("    if (_gacn && _gacn->tipo.datos && strcmp(_gacn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _gac = (struct DeclaracionTipo*)_gacn;")
        asm("        if (_gac->nombre.datos && _gac->constructores) {")
        asm("            int _gaci = 0;")
        asm("            struct ListaNodo* _gac_l = _gac->constructores;")
        asm("            while (_gac_l && _G_native_adt_ctrs_count < 256) {")
        asm("                struct Nodo* _gac_c = _gac_l->cabeza;")
        asm("                if (_gac_c && _gac_c->tipo.datos && strcmp(_gac_c->tipo.datos, \"ConstructorTipo\") == 0) {")
        asm("                    struct ConstructorTipo* _gacc = (struct ConstructorTipo*)_gac_c;")
        asm("                    if (_gacc->nombre.datos) {")
        asm("                        strncpy(_G_native_adt_ctrs[_G_native_adt_ctrs_count], _gacc->nombre.datos, 63); _G_native_adt_ctrs[_G_native_adt_ctrs_count][63] = 0;")
        asm("                        strncpy(_G_native_adt_ctrs_adt[_G_native_adt_ctrs_count], _gac->nombre.datos, 63); _G_native_adt_ctrs_adt[_G_native_adt_ctrs_count][63] = 0;")
        asm("                        _G_native_adt_ctrs_tag[_G_native_adt_ctrs_count] = _gaci;")
        asm("                        struct Nodo* _gact0 = (_gacc->tipos && _gacc->tipos->cabeza) ? _gacc->tipos->cabeza : 0;")
        asm("                        if (_gact0 && _gact0->tipo.datos && strcmp(_gact0->tipo.datos, \"Identificador\") == 0) {")
        asm("                            struct Identificador* _gi = (struct Identificador*)_gact0;")
        asm("                            if (_gi->nombre.datos) { strncpy(_G_native_adt_ctrs_tipo[_G_native_adt_ctrs_count], _gi->nombre.datos, 63); _G_native_adt_ctrs_tipo[_G_native_adt_ctrs_count][63] = 0; }")
        asm("                        }")
        asm("                        _G_native_adt_ctrs_count++;")
        asm("                    }")
        asm("                }")
        asm("                _gaci++;")
        asm("                _gac_l = _gac_l->cola;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _gacd = _gacd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] D-6: %d constructores ADT registrados\\n\", _G_native_adt_ctrs_count); fflush(stderr);")
