#lang: es

// ============================================================
// monomorfizacion.syn - monomorfizacion de ADT genericos (registro + scan D-2 de instanciaciones)
// ============================================================
// Extraido de orquestador.syn en la modularizacion (deuda
// AUDITORIA_ALINEACION_MANUALES: orquestador.syn 101KB / 1350
// lineas con generar() como monolito de 932 lineas). Los bloques
// asm se mueven TEXTUALMENTE (misma indentacion) a funciones que
// generar() invoca en el mismo orden -> el C generado no cambia.

// ----------------------------------------------------------
// gen_escanear_adt_instancias - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_adt_instancias(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-D2: registrar ADT genericos (DeclaracionTipo con parametros_tipo)
    // y sus instanciaciones `Base<A,B>` (monomorfizacion, Opcion A). Paridad
    // pre-pass generator.py _recolectar_instancias_adt.
    inseguro:
        asm("extern char _G_native_adt_gen[64][64]; extern int _G_native_adt_gen_nparams[64]; extern char _G_native_adt_gen_params[64][8][64]; extern int _G_native_adt_gen_count;")
        asm("extern char _G_native_adt_inst_type[64][64]; extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_base[64][64]; extern char _G_native_adt_inst_fields_c[64][8][64]; extern int _G_native_adt_inst_nfields[64]; extern int _G_native_adt_inst_count;")
        asm("extern char _G_native_adt_ctrs[256][64]; extern char _G_native_adt_ctrs_adt[256][64]; extern int _G_native_adt_ctrs_tag[256]; extern char _G_native_adt_ctrs_tipo[256][64]; extern int _G_native_adt_ctrs_count;")
        asm("extern char _gen_tmp_buf[4096];")
        asm("_G_native_adt_gen_count = 0; _G_native_adt_inst_count = 0;")
        asm("// Fase A: registrar ADT genericos (sus parametros_tipo)")
        asm("struct ListaNodo* _d2gd = programa.sentencias;")
        asm("while (_d2gd && _G_native_adt_gen_count < 64) {")
        asm("    struct Nodo* _d2gn = _d2gd->cabeza;")
        asm("    if (_d2gn && _d2gn->tipo.datos && strcmp(_d2gn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _d2gt = (struct DeclaracionTipo*)_d2gn;")
        asm("        if (_d2gt->nombre.datos && _d2gt->constructores && _d2gt->parametros_tipo) {")
        asm("            int _d2np = 0;")
        asm("            struct ListaNodo* _d2pl = _d2gt->parametros_tipo;")
        asm("            while (_d2pl && _d2np < 8) {")
        asm("                struct Nodo* _d2pn = _d2pl->cabeza;")
        asm("                if (_d2pn && _d2pn->tipo.datos && strcmp(_d2pn->tipo.datos, \"Identificador\") == 0) {")
        asm("                    struct Identificador* _d2pi = (struct Identificador*)_d2pn;")
        asm("                    if (_d2pi->nombre.datos) { strncpy(_G_native_adt_gen_params[_G_native_adt_gen_count][_d2np], _d2pi->nombre.datos, 63); _G_native_adt_gen_params[_G_native_adt_gen_count][_d2np][63] = 0; _d2np++; }")
        asm("                }")
        asm("                _d2pl = _d2pl->cola;")
        asm("            }")
        asm("            if (_d2np > 0) { strncpy(_G_native_adt_gen[_G_native_adt_gen_count], _d2gt->nombre.datos, 63); _G_native_adt_gen[_G_native_adt_gen_count][63] = 0; _G_native_adt_gen_nparams[_G_native_adt_gen_count] = _d2np; _G_native_adt_gen_count++; }")
        asm("        }")
        asm("    }")
        asm("    _d2gd = _d2gd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] D-2: %d ADT genericos registrados\\n\", _G_native_adt_gen_count); fflush(stderr);")
        asm("// Fase B: registrar una instanciacion `Base<A,B>` (dedup por tipo normalizado)")
        asm("// Se invoca con el string del tipo (retorno/param) en _d2t_buf.")
        asm("")
        asm("// R17: scan de tipos instanciados Base<A,B> en TODO el programa (paridad")
        asm("// pre-pass generator.py _recolectar_instancias_adt): firmas (retorno+params),")
        asm("// let x: Base<A,B> locales (walk recursivo si/mientras/para/inseguro/coincidir),")
        asm("// campos de estructura y externos. Cola FIFO unica (R16) con post-orden.")
        asm("struct ListaNodo* _d2fd = programa.sentencias;")
        asm("char _d2all[256][128]; int _d2nall = 0; int _d2w = 0;")
        asm("while (_d2fd && _G_native_adt_inst_count < 64 && _d2nall < 256) {")
        asm("    struct Nodo* _d2fn = _d2fd->cabeza;")
        asm("    if (_d2fn && _d2fn->tipo.datos) {")
        asm("        const char* _d2tcf = _d2fn->tipo.datos;")
        asm("        if (strcmp(_d2tcf, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _d2f = (struct DefinicionFuncion*)_d2fn;")
        asm("            // R11: retorno Y parametros (un ADT como parametro no se")
        asm("            // registraba -> placeholder \"Resultado_T\" y gcc fallaba).")
        asm("            if (_d2f->tipo_retorno.datos && strchr(_d2f->tipo_retorno.datos, '<')) {")
        asm("                _d2w = 0; for (int _d2c = 0; _d2f->tipo_retorno.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2f->tipo_retorno.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2f->tipo_retorno.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("            }")
        asm("            struct ListaParametro* _d2plp = _d2f->parametros;")
        asm("            while (_d2plp && _d2nall < 256) {")
        asm("                struct Parametro* _d2par = (struct Parametro*)_d2plp->cabeza;")
        asm("                if (_d2par && _d2par->tipo_param.datos && strchr(_d2par->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2par->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2par->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2par->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
        asm("                _d2plp = _d2plp->cola;")
        asm("            }")
        asm("            // R17: `let x: Base<A,B>` del cuerpo (walk FIFO recursivo)")
        asm("            struct Nodo* _d2ws[4096]; int _d2wh = 0; int _d2wt = 0;")
        asm("            struct ListaNodo* _d2b0 = _d2f->cuerpo;")
        asm("            while (_d2b0) { if (_d2b0->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2b0->cabeza; } _d2b0 = _d2b0->cola; }")
        asm("            while (_d2wh < _d2wt && _d2nall < 256) {")
        asm("                struct Nodo* _d2wn = _d2ws[_d2wh++];")
        asm("                if (!_d2wn || !_d2wn->tipo.datos) continue;")
        asm("                const char* _d2wt2 = _d2wn->tipo.datos;")
        asm("                if (strcmp(_d2wt2, \"DeclaracionVariable\") == 0) {")
        asm("                    struct DeclaracionVariable* _d2dv = (struct DeclaracionVariable*)_d2wn;")
        asm("                    if (_d2dv->tipo_param.datos && strchr(_d2dv->tipo_param.datos, '<')) {")
        asm("                        _d2w = 0; for (int _d2c = 0; _d2dv->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2dv->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2dv->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                    }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaSi\") == 0) {")
        asm("                    struct SentenciaSi* _d2si = (struct SentenciaSi*)_d2wn;")
        asm("                    struct ListaNodo* _d2l1 = _d2si->cuerpo; while (_d2l1) { if (_d2l1->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l1->cabeza; } _d2l1 = _d2l1->cola; }")
        asm("                    struct ListaNodo* _d2l2 = _d2si->cuerpo_sino; while (_d2l2) { if (_d2l2->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l2->cabeza; } _d2l2 = _d2l2->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaMientras\") == 0) {")
        asm("                    struct SentenciaMientras* _d2wm = (struct SentenciaMientras*)_d2wn;")
        asm("                    struct ListaNodo* _d2l3 = _d2wm->cuerpo; while (_d2l3) { if (_d2l3->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l3->cabeza; } _d2l3 = _d2l3->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"BloqueInseguro\") == 0) {")
        asm("                    struct BloqueInseguro* _d2bi = (struct BloqueInseguro*)_d2wn;")
        asm("                    struct ListaNodo* _d2l4 = _d2bi->cuerpo; while (_d2l4) { if (_d2l4->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l4->cabeza; } _d2l4 = _d2l4->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaPara\") == 0) {")
        asm("                    struct SentenciaPara* _d2pa = (struct SentenciaPara*)_d2wn;")
        asm("                    if (_d2pa->cuerpo && _d2wt < 4096) { _d2ws[_d2wt++] = _d2pa->cuerpo; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"NodoCoincidir\") == 0) {")
        asm("                    struct NodoCoincidir* _d2mc = (struct NodoCoincidir*)_d2wn;")
        asm("                    struct ListaNodo* _d2cl = _d2mc->casos;")
        asm("                    while (_d2cl) { struct NodoCaso* _d2ca = (struct NodoCaso*)_d2cl->cabeza; if (_d2ca && _d2ca->cuerpo) { struct ListaNodo* _d2bl = _d2ca->cuerpo; while (_d2bl) { if (_d2bl->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2bl->cabeza; } _d2bl = _d2bl->cola; } } _d2cl = _d2cl->cola; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        else if (strcmp(_d2tcf, \"DefinicionEstructura\") == 0) {")
        asm("            struct DefinicionEstructura* _d2e = (struct DefinicionEstructura*)_d2fn;")
        asm("            struct ListaParametro* _d2fl = _d2e->campos;")
        asm("            while (_d2fl && _d2nall < 256) {")
        asm("                struct Parametro* _d2cp = (struct Parametro*)_d2fl->cabeza;")
        asm("                if (_d2cp && _d2cp->tipo_param.datos && strchr(_d2cp->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2cp->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2cp->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2cp->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
        asm("                _d2fl = _d2fl->cola;")
        asm("            }")
        asm("        }")
        asm("        else if (strcmp(_d2tcf, \"DeclaracionExterna\") == 0) {")
        asm("            struct DeclaracionExterna* _d2x = (struct DeclaracionExterna*)_d2fn;")
        asm("            if (_d2x->tipo_retorno.datos && strchr(_d2x->tipo_retorno.datos, '<')) {")
        asm("                _d2w = 0; for (int _d2c = 0; _d2x->tipo_retorno.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2x->tipo_retorno.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2x->tipo_retorno.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("            }")
        asm("            struct ListaParametro* _d2xp = _d2x->parametros;")
        asm("            while (_d2xp && _d2nall < 256) {")
        asm("                struct Parametro* _d2xpa = (struct Parametro*)_d2xp->cabeza;")
        asm("                if (_d2xpa && _d2xpa->tipo_param.datos && strchr(_d2xpa->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2xpa->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2xpa->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2xpa->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
        asm("                _d2xp = _d2xp->cola;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _d2fd = _d2fd->cola;")
        asm("}")
        asm("// D-2 (R16): cola FIFO unica de tipos pendientes - post-orden: las")
        asm("// dependencias anidadas se encolan antes que el contenedor.")
        asm("char _d2pend[128][128]; int _d2npend = 0;")
        asm("for (int _d2t = 0; _d2t < _d2nall && _d2npend < 128; _d2t++) {")
        asm("    strncpy(_d2pend[_d2npend], _d2all[_d2t], 127); _d2pend[_d2npend][127] = 0; _d2npend++;")
        asm("}")
        asm("        int _d2pops = 0;")
        asm("        while (_d2npend > 0 && _G_native_adt_inst_count < 64 && _d2pops < 4096) {")
        asm("            _d2pops++;")
        asm("            char _d2src[128]; strncpy(_d2src, _d2pend[0], 127); _d2src[127] = 0;")
        asm("            for (int _d2s = 1; _d2s < _d2npend; _d2s++) strcpy(_d2pend[_d2s-1], _d2pend[_d2s]);")
        asm("            _d2npend--;")
        asm("            if (!_d2src[0] || strchr(_d2src, '<') == 0) continue;")
        asm("            int _d2len = (int)strlen(_d2src);")
        asm("            if (_d2src[_d2len-1] != '>') continue;")
        asm("            char _d2base[64]; int _d2b = 0; while (_d2src[_d2b] && _d2src[_d2b] != '<' && _d2b < 62) { _d2base[_d2b] = _d2src[_d2b]; _d2b++; } _d2base[_d2b] = 0;")
        asm("            if (!_G_native_adt_gen_es(_d2base)) continue;")
        asm("            // aridad: args separados por coma a nivel 0 (anidamiento depth-aware)")
        asm("            // NOTA R16: el else-if de '>' se parte en 3 asm() porque el emisor")
        asm("            // S1 (generator.py L318-324) anade ';' a toda linea asm que termina")
        asm("            // en '}' con un '{' interno (heuristica de needs_semi); una linea")
        asm("            // asi romperia la cadena else-if en el C generado. NO fusionar.")
        asm("            char _d2args[8][64]; int _d2na = 0; int _d2prof = 0; char _d2cur[64]; int _d2cw = 0;")
        asm("            for (const char* _d2p = _d2src + _d2b + 1; *_d2p && _d2na < 8; _d2p++) {")
        asm("                if (*_d2p == '<') { _d2prof++; if (_d2cw < 63) _d2cur[_d2cw++] = *_d2p; }")
        asm("                else if (*_d2p == '>') {")
        asm("                    if (_d2prof > 0) { _d2prof--; if (_d2cw < 63) _d2cur[_d2cw++] = *_d2p; }")
        asm("                }")
        asm("                else if (*_d2p == ',' && _d2prof == 0) { _d2cur[_d2cw] = 0; strncpy(_d2args[_d2na], _d2cur, 63); _d2args[_d2na][63] = 0; _d2na++; _d2cw = 0; }")
        asm("                else { if (_d2cw < 63) _d2cur[_d2cw++] = *_d2p; }")
        asm("            }")
        asm("            if (_d2cw > 0 && _d2na < 8) { _d2cur[_d2cw] = 0; strncpy(_d2args[_d2na], _d2cur, 63); _d2args[_d2na][63] = 0; _d2na++; }")
        asm("            int _d2gi = -1;")
        asm("            for (int _d2g = 0; _d2g < _G_native_adt_gen_count; _d2g++) { if (strcmp(_G_native_adt_gen[_d2g], _d2base) == 0) { _d2gi = _d2g; break; } }")
        asm("            if (_d2gi < 0 || _d2na != _G_native_adt_gen_nparams[_d2gi]) continue;")
        asm("            int _d2dup = 0;")
        asm("            for (int _d2x = 0; _d2x < _G_native_adt_inst_count; _d2x++) { if (strcmp(_G_native_adt_inst_type[_d2x], _d2src) == 0) { _d2dup = 1; break; } }")
        asm("            if (_d2dup) continue;")
        asm("            // D-2: si hay args ADT-genericos anidados NO registrados, encolarlos")
        asm("            // (y re-encolar el contenedor) para registrarlos ANTES (post-orden);")
        asm("            // asi el campo C del contenedor resuelve contra el struct interno.")
        asm("            int _d2dep = 0;")
        asm("            for (int _d2a = 0; _d2a < _d2na; _d2a++) {")
        asm("                if (strchr(_d2args[_d2a], '<')) {")
        asm("                    char _d2ab[64]; int _d2k = 0; while (_d2args[_d2a][_d2k] && _d2args[_d2a][_d2k] != '<' && _d2k < 62) { _d2ab[_d2k] = _d2args[_d2a][_d2k]; _d2k++; } _d2ab[_d2k] = 0;")
        asm("                    if (_G_native_adt_gen_es(_d2ab)) {")
        asm("                        int _d2reg = 0;")
        asm("                        for (int _d2y = 0; _d2y < _G_native_adt_inst_count; _d2y++) { if (strcmp(_G_native_adt_inst_type[_d2y], _d2args[_d2a]) == 0) { _d2reg = 1; break; } }")
        asm("                        if (!_d2reg) _d2dep = 1;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("            if (_d2dep) {")
        asm("                for (int _d2a = 0; _d2a < _d2na && _d2npend < 124; _d2a++) {")
        asm("                    if (strchr(_d2args[_d2a], '<')) {")
        asm("                        char _d2ab2[64]; int _d2k2 = 0; while (_d2args[_d2a][_d2k2] && _d2args[_d2a][_d2k2] != '<' && _d2k2 < 62) { _d2ab2[_d2k2] = _d2args[_d2a][_d2k2]; _d2k2++; } _d2ab2[_d2k2] = 0;")
        asm("                        if (_G_native_adt_gen_es(_d2ab2)) {")
        asm("                            int _d2r2 = 0;")
        asm("                            for (int _d2y2 = 0; _d2y2 < _G_native_adt_inst_count; _d2y2++) { if (strcmp(_G_native_adt_inst_type[_d2y2], _d2args[_d2a]) == 0) { _d2r2 = 1; break; } }")
        asm("                            if (!_d2r2) { strncpy(_d2pend[_d2npend], _d2args[_d2a], 127); _d2pend[_d2npend][127] = 0; _d2npend++; }")
        asm("                        }")
        asm("                    }")
        asm("                }")
        asm("                if (_d2npend < 124) { strncpy(_d2pend[_d2npend], _d2src, 127); _d2pend[_d2npend][127] = 0; _d2npend++; }")
        asm("                continue;")
        asm("            }")
        asm("            int _d2i = _G_native_adt_inst_count++;")
        asm("            strncpy(_G_native_adt_inst_type[_d2i], _d2src, 63); _G_native_adt_inst_type[_d2i][63] = 0;")
        asm("            strncpy(_G_native_adt_inst_base[_d2i], _d2base, 63); _G_native_adt_inst_base[_d2i][63] = 0;")
        asm("            // nombre C mangle: base + '_' + sane(arg) por arg (sin el '>' de cierre)")
        asm("            char _d2nc[128]; int _d2n = 0;")
        asm("            for (int _d2q = 0; _d2base[_d2q] && _d2n < 60; _d2q++) _d2nc[_d2n++] = _d2base[_d2q];")
        asm("            for (int _d2a = 0; _d2a < _d2na && _d2n < 115; _d2a++) {")
        asm("                _d2nc[_d2n++] = '_';")
        asm("                int _d2alen = (int)strlen(_d2args[_d2a]);")
        asm("                int _d2amax = (_d2alen > 0 && _d2args[_d2a][_d2alen-1] == '>') ? _d2alen - 1 : _d2alen;")
        asm("                for (int _d2q2 = 0; _d2q2 < _d2amax && _d2n < 115; _d2q2++) {")
        asm("                    char _d2ch = _d2args[_d2a][_d2q2];")
        asm("                    if ((_d2ch >= 'a' && _d2ch <= 'z') || (_d2ch >= 'A' && _d2ch <= 'Z') || (_d2ch >= '0' && _d2ch <= '9') || _d2ch == '_') { _d2nc[_d2n++] = _d2ch; }")
        asm("                    else { _d2nc[_d2n++] = '_'; }")
        asm("                }")
        asm("            }")
        asm("            _d2nc[_d2n] = 0;")
        asm("            strncpy(_G_native_adt_inst_c[_d2i], _d2nc, 63); _G_native_adt_inst_c[_d2i][63] = 0;")
        asm("            // campos C sustituidos: por cada ctr del ADT base, si su tipo es un param -> arg")
        asm("            int _d2fi = 0;")
        asm("            for (int _d2ci = 0; _d2ci < _G_native_adt_ctrs_count && _d2fi < 8; _d2ci++) {")
        asm("                if (strcmp(_G_native_adt_ctrs_adt[_d2ci], _d2base) != 0) continue;")
        asm("                const char* _d2ft0 = _G_native_adt_ctrs_tipo[_d2ci];")
        asm("                int _d2es = -1;")
        asm("                for (int _d2pi = 0; _d2pi < _G_native_adt_gen_nparams[_d2gi]; _d2pi++) { if (strcmp(_G_native_adt_gen_params[_d2gi][_d2pi], _d2ft0) == 0) { _d2es = _d2pi; break; } }")
        asm("                if (_d2es >= 0) {")
        asm("                    traducir_tipo_c((void*)_d2args[_d2es]);")
        asm("                } else {")
        asm("                    traducir_tipo_c((void*)_d2ft0);")
        asm("                }")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                // R18 (revision): campos de tipo struct por PUNTERO (paridad S1")
        asm("                // campos_pointer) - el pre-bloque de typedefs va ANTES de la")
        asm("                // definicion del struct; por valor daba 'field has incomplete type'.")
        asm("                if (strncmp(_gen_tmp_buf, \"struct \", 7) == 0) { strcat(_gen_tmp_buf, \"*\"); }")
        asm("                strncpy(_G_native_adt_inst_fields_c[_d2i][_d2fi], _gen_tmp_buf, 63); _G_native_adt_inst_fields_c[_d2i][_d2fi][63] = 0;")
        asm("                _d2fi++;")

        asm("            }")
        asm("            _G_native_adt_inst_nfields[_d2i] = _d2fi;")
        asm("        }")
        asm("fprintf(stderr, \"[Orquestador] D-2: %d instanciaciones de ADT registradas\\n\", _G_native_adt_inst_count); fflush(stderr);")
        asm("// R17: typedefs de TODAS las instanciaciones ANTES del recorrido")
        asm("// top-level (los structs de usuario se emiten en orden alfabetico;")
        asm("// un campo que referencia una instancia emitida en la visita de")
        asm("// DeclaracionTipo, despues, rompia el C). El orden del registro es")
        asm("// post-orden (inner primero) -> anidados y cross-base correctos.")
        asm("extern char _G_native_adt_inst_base[64][64]; extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_fields_c[64][8][64]; extern int _G_native_adt_inst_nfields[64]; extern int _G_native_adt_inst_count;")
        asm("for (int _d2e = 0; _d2e < _G_native_adt_inst_count; _d2e++) {")
        asm("    char _d2h[4096];")
        asm("    snprintf(_d2h, 4096, \"typedef struct %s { int64_t tag; union {\", _G_native_adt_inst_c[_d2e]);")
        asm("    gen_emitir_str(est, _d2h);")
        asm("    int _d2c0 = 0;")
        asm("    for (int _d2ci = 0; _d2ci < _G_native_adt_ctrs_count; _d2ci++) { if (strcmp(_G_native_adt_ctrs_adt[_d2ci], _G_native_adt_inst_base[_d2e]) == 0) _d2c0++; }")
        asm("    if (_d2c0 > 0) {")
        asm("        int _d2order[8]; int _d2no = 0;")
        asm("        for (int _d2ti = 0; _d2ti < 8 && _d2no < _d2c0; _d2ti++) {")
        asm("            for (int _d2ci = 0; _d2ci < _G_native_adt_ctrs_count; _d2ci++) { if (strcmp(_G_native_adt_ctrs_adt[_d2ci], _G_native_adt_inst_base[_d2e]) == 0 && _G_native_adt_ctrs_tag[_d2ci] == _d2ti) { _d2order[_d2no++] = _d2ci; break; } }")
        asm("        }")
        asm("        for (int _d2k = 0; _d2k < _d2no && _d2k < _G_native_adt_inst_nfields[_d2e] && _d2k < 8; _d2k++) {")
        asm("            char _d2fld[4096];")
        asm("            snprintf(_d2fld, 4096, \" %s %s;\", _G_native_adt_inst_fields_c[_d2e][_d2k], _G_native_adt_ctrs[_d2order[_d2k]]);")
        asm("            gen_emitir_str(est, _d2fld);")
        asm("        }")
        asm("    }")
        asm("    if (_G_native_adt_inst_nfields[_d2e] == 0) { gen_emitir_str(est, \" int _unidad;\"); }")
        asm("    char _d2cl[4096];")
        asm("    snprintf(_d2cl, 4096, \" } dato; } %s;\", _G_native_adt_inst_c[_d2e]);")
        asm("    gen_emitir_str(est, _d2cl);")
        asm("    gen_emitir_str(est, \"\");")
        asm("}")
