        asm("while (_l) { _G_native_escuchar_vars(_l->cabeza, out); _l = _l->cola; }")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s2 = (struct SentenciaSi*)_no; struct ListaNodo* _ls = _s2->cuerpo_sino; while (_ls) { _G_native_escuchar_vars(_ls->cabeza, out); _ls = _ls->cola; } }")
