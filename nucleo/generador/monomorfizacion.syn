funcion _G_native_escuchar_vars(n: puntero, out: puntero) -> nulo:
    requiere:
        n != nulo
        out != nulo
    garantiza:
        verdadero
    inseguro:
        asm("if (!n || !out) return;")
        asm("struct Nodo* _no = (struct Nodo*)n;")
        asm("if (!_no->tipo.datos) return;")
        asm("const char* _t = _no->tipo.datos;")
        asm("char _tb[128]; _tb[0] = 0;")
        asm("if (strcmp(_t, \"AsignacionVariable\") == 0) {")
        asm("    struct AsignacionVariable* _a = (struct AsignacionVariable*)_no;")
        asm("    if (_a->nombre.datos && _a->expresion) {")
