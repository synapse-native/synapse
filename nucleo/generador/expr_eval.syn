#lang: es

// ============================================================
// expr_eval.syn  —  Evaluador de expresiones OO para el generador C
// ============================================================
// Visitante de expresiones del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - _oo_expr_a_c es el evaluador de expresiones recursivo que traduce
//     cualquier sub-arbol de expresion a una cadena C.
//   - Soporta: literales, identificadores, operaciones binarias/unarias,
//     llamadas a funcion, obtencion de direccion (&T) y desreferencia (*ptr).
// ============================================================

// ----------------------------------------------------------
// _oo_expr_a_c -- OO expression evaluator
// Traduce un nodo de expresion del AST a una representacion
// en cadena C, escribiendo el resultado en 'buf'.
// ----------------------------------------------------------
funcion _oo_expr_a_c(est: GeneradorCEst, nodo: puntero, buf: puntero, bufsz: entero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)nodo;")
        asm("char* _b = (char*)buf;")
        asm("int _sz = bufsz;")
        asm("if (!_n || !_b || _sz <= 0) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) { strcpy(_b, \"0\"); return; }")
        asm("_b[0] = 0;")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralNumero\")) {")
        asm("    struct LiteralNumero* _ln = (struct LiteralNumero*)_n;")
        asm("    if ((long long)_ln->valor == (long long)9223372036854775807LL + 1) { strcpy(_b, \"(-9223372036854775807LL - 1)\"); }")
        asm("    else { snprintf(_b, _sz, \"%lldLL\", (long long)_ln->valor); }")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralDecimal\")) {")
        asm("    struct LiteralDecimal* _ld = (struct LiteralDecimal*)_n;")
        asm("    snprintf(_b, _sz, \"%.9g\", _ld->valor);")
        asm("    if (!strchr(_b, '.') && !strchr(_b, 'e') && !strchr(_b, 'E')) strcat(_b, \".0\");")
        asm("    else { }")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"Identificador\")) {")
        asm("    struct Identificador* _id = (struct Identificador*)_n;")
        asm("    if (_id->nombre.datos) strncpy(_b, _id->nombre.datos, _sz - 1);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralCadena\")) {")
        asm("    struct LiteralCadena* _lc = (struct LiteralCadena*)_n;")
        asm("    // Manual 8 S8.2 / paridad emit_expressions.py L159-169:")
        asm("    // escapar \\\\, \\\", \\n, \\r, \\t dentro del literal.")
        asm("    if (_lc->valor.datos && _lc->valor.longitud > 0) {")
        asm("        char _esc[4096]; int _ep = 0;")
        asm("        for (int _vi = 0; _vi < _lc->valor.longitud && _ep < 4090; _vi++) {")
        asm("            char _vc = _lc->valor.datos[_vi];")
        asm("            if (_vc == '\\\\') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\\'; }")
        asm("            else if (_vc == '\\\"') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\"'; }")
        asm("            else if (_vc == '\\n') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'n'; }")
        asm("            else if (_vc == '\\r') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'r'; }")
        asm("            else if (_vc == '\\t') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 't'; }")
        asm("            else { _esc[_ep++] = _vc; }")
        asm("        }")
        asm("        _esc[_ep] = 0;")
        asm("        snprintf(_b, _sz, \"(CadenaSegura){.longitud=%d,.datos=\\\"%s\\\"}\", _lc->valor.longitud, _esc);")
        asm("    } else {")
        asm("        strcpy(_b, \"(CadenaSegura){.longitud=0,.datos=\\\"\\\"}\");")
        asm("    }")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ArgumentoTransferido\")) {")
        asm("    // R15: ->expr (paridad S1 expr_a_c de ArgumentoTransferido:")
        asm("    // el valor transferido se emite como el expr subyacente).")
        asm("    struct ArgumentoTransferido* _aft = (struct ArgumentoTransferido*)_n;")
        asm("    if (_aft->expr) { _oo_expr_a_c(est, _aft->expr, _b, _sz); }")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"LiteralNulo\")) {")
        asm("    // F1.2b: paridad emit_expressions.py L157-159 (expr_a_c de LiteralNulo -> \"nulo\")")
        asm("    strcpy(_b, \"nulo\");")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprTensor\")) {")
        asm("    // F1.2b: paridad emit_expressions.py L338-341 (expr_a_c de ExprTensor -> crear_tensor(filas, cols))")
        asm("    struct ExprTensor* _et = (struct ExprTensor*)_n;")
        asm("    char _etf[2048], _etc[2048];")
        asm("    _etf[0] = _etc[0] = 0;")
        asm("    if (_et->filas) { _oo_expr_a_c(est, _et->filas, _etf, 2048); } else { strcpy(_etf, \"0\"); }")
        asm("    if (_et->columnas) { _oo_expr_a_c(est, _et->columnas, _etc, 2048); } else { strcpy(_etc, \"0\"); }")
        asm("    snprintf(_b, _sz, \"crear_tensor(%s, %s)\", _etf, _etc);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprCrearCanal\")) {")
        asm("    // F3-6: paridad emit_expressions.py L523-525 (ExprCrearCanal -> canal_crear(cap)).")
        asm("    // Antes: sin rama -> el let/expr caia al default (ch = 0; canal nunca creado).")
        asm("    struct ExprCrearCanal* _cc = (struct ExprCrearCanal*)_n;")
        asm("    char _ccap[2048]; _ccap[0] = 0;")
        asm("    if (_cc->capacidad && _cc->capacidad->tipo.datos) { _oo_expr_a_c(est, _cc->capacidad, _ccap, 2048); } else { strcpy(_ccap, \"10\"); }")
        asm("    snprintf(_b, _sz, \"canal_crear(%s)\", _ccap);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprRecibirCanal\")) {")
        asm("    // F3-6: paridad emit_expressions.py (ExprRecibirCanal -> canal_recibir(canal)).")
        asm("    // F3-7: dentro del bloque de `escuchar canal:` el recibir se emite como")
        asm("    // canal_recibir(_canal) (la variable del listener, no la local del")
        asm("    // contenedor, que no es visible en la funcion listener).")
        asm("    // F3-10: el receive hereda el tipo del elemento del canal (Manual 5 §4.2)")
        asm("    // y se desboxea el void* que devuelve canal_recibir (paridad S1).")
        asm("    // F4-6: firma del Manual 5 §3.4 `canal_recibir(canal, bool* cerrado)`. Dentro")
        asm("    // del escuchar el receive emite un statement-expression que rompe el while")
        asm("    // del listener cuando *cerrado == true (Manual 5 §4.3), distinguiendo el")
        asm("    // valor 0 del cierre. Fuera del escuchar se pasa &(bool){0} (leniency).")
        asm("    struct ExprRecibirCanal* _rc = (struct ExprRecibirCanal*)_n;")
        asm("    extern int _G_listener_modo;")
        asm("    char _relem[64]; _relem[0] = 0;")
        asm("    if (_rc->canal && _rc->canal->tipo.datos && strcmp(_rc->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _rid = (struct Identificador*)_rc->canal;")
        asm("        if (_rid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_rid->nombre.datos, _relem); }")
        asm("    }")
        asm("    if (_G_listener_modo) {")
        asm("        char _unbox[64];")
        asm("        if (strcmp(_relem, \"int64_t\") == 0) { strcpy(_unbox, \"_synapse_unbox_int(_m)\"); }")
        asm("        else if (strcmp(_relem, \"double\") == 0) { strcpy(_unbox, \"_synapse_unbox_float(_m)\"); }")
        asm("        else { strcpy(_unbox, \"_m\"); }")
        asm("        snprintf(_b, _sz, \"({ void* _m = canal_recibir(_canal, &_cerrado); if (_cerrado) break; %s; })\", _unbox);")
        asm("        return;")
        asm("    }")
        asm("    char _rbuf[2048]; _rbuf[0] = 0;")
        asm("    {")
        asm("        char _rcc[2048]; _rcc[0] = 0;")
        asm("        if (_rc->canal && _rc->canal->tipo.datos) { _oo_expr_a_c(est, _rc->canal, _rcc, 2048); } else { strcpy(_rcc, \"NULL\"); }")
        asm("        snprintf(_rbuf, 2048, \"canal_recibir(%s, &(bool){0})\", _rcc);")
        asm("    }")
        asm("    if (strcmp(_relem, \"int64_t\") == 0) { snprintf(_b, _sz, \"_synapse_unbox_int(%s)\", _rbuf); return; }")
        asm("    if (strcmp(_relem, \"double\") == 0) { snprintf(_b, _sz, \"_synapse_unbox_float(%s)\", _rbuf); return; }")
        asm("    snprintf(_b, _sz, \"%s\", _rbuf);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprPropagar\")) {")
        asm("    // D-6: operador '?' postfijo (Manual 3 §7 L331-342). Statement-expression")
        asm("    // GNU: si el Resultado es err (tag 1) propaga el valor entero; si es ok,")
        asm("    // evalua al campo del primer constructor (dato.ok).")
        asm("    struct ExprPropagar* _pp = (struct ExprPropagar*)_n;")
        asm("    char _pe[2048]; _pe[0] = 0;")
        asm("    if (_pp->expresion) { _oo_expr_a_c(est, _pp->expresion, _pe, 2048); }")
        asm("    char _padt[64]; _padt[0] = 0;")
        asm("    if (_pp->expresion && _pp->expresion->tipo.datos && strcmp(_pp->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _plf = (struct LlamadaFuncion*)_pp->expresion;")
        asm("        if (_plf->nombre.datos) { _G_native_tipo_retorno(_plf->nombre.datos, _padt); }")
        asm("    }")
        asm("    if (!_padt[0]) strcpy(_padt, \"Resultado\");")
        asm("    // la variable temporal es del tipo ADT (Resultado o el struct instanciado")
        asm("    // D-2: traducir_tipo_c resuelve `Resultado<entero,texto>` -> struct")
        asm("    // especializado; el desempaquetado .dato.ok da el valor.")
        asm("    traducir_tipo_c((void*)_padt);")
        asm("    extern char _gen_tmp_buf[4096];")
        asm("    char _ptc[64]; _ptc[0] = 0;")
        asm("    strncpy(_ptc, _gen_tmp_buf, 63); _ptc[63] = 0;")
        asm("    char _pfield[64]; _pfield[0] = 0;")
        asm("    _G_native_adt_unwrap_field(_padt, _pfield);")
        asm("    if (!_pfield[0]) strcpy(_pfield, \"ok\");")
        asm("    snprintf(_b, _sz, \"({ %s _prop = %s; if (_prop.tag == 1) return _prop; _prop.dato.%s; })\", _ptc, _pe, _pfield);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"OpBinaria\")) {")
        asm("    struct OpBinaria* _op = (struct OpBinaria*)_n;")
        asm("    char _izq[2048], _der[2048];")
        asm("    _izq[0] = _der[0] = 0;")
        asm("    if (_op->izquierdo) { _oo_expr_a_c(est, _op->izquierdo, _izq, 2048); }")
        asm("    if (_op->derecho) { _oo_expr_a_c(est, _op->derecho, _der, 2048); }")
        asm("    const char* _op_str = \"\";")
        asm("    int _ot = 0;")
        asm("    if (_op->operador) {")
        asm("        _ot = _op->operador->tipo;")
        asm("        switch (_ot) {")
        asm("            case 30: _op_str = \" + \"; break;")
        asm("            case 31: _op_str = \" - \"; break;")
        asm("            case 32: _op_str = \" * \"; break;")
        asm("            case 33: _op_str = \" / \"; break;")
        asm("            case 34: _op_str = \" % \"; break;  // ME-B7: T_MOD (34) faltaba en el switch")
        asm("            case 16: _op_str = \" > \"; break;")
        asm("            case 17: _op_str = \" < \"; break;")
        asm("            case 25: _op_str = \" == \"; break;")
        asm("            case 26: _op_str = \" != \"; break;")
        asm("            case 28: _op_str = \" >= \"; break;")
        asm("            case 27: _op_str = \" <= \"; break;")
        asm("            case 14: _op_str = \" && \"; break;")
        asm("            case 15: _op_str = \" || \"; break;")
        asm("            default: _op_str = \" ? \"; break;")
        asm("        }")
        asm("    }")
        asm("    // ME-B7 paridad emit_expressions.py L160-200 (tipo_de_expr + _es_str):")
        asm("    // decidir en TIEMPO DE GENERACION si un operando es texto (no macros _Generic,")
        asm("    // que gcc rechaza: valida todas las ramas y str_eq(int,int) es invalido).")
        asm("    // Un operando es texto si: LiteralCadena, o llamada a funcion que retorna")
        asm("    // cadena (via _G_native_tipo_retorno), o concat/entero_a_texto/leer_linea/subcadena.")
        asm("    int _ix_txt = 0, _dx_txt = 0;")
        asm("    struct Nodo* _nx0 = (struct Nodo*)_op->izquierdo;")
        asm("    struct Nodo* _nx1 = (struct Nodo*)_op->derecho;")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LiteralCadena\") == 0) _ix_txt = 1;")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"LiteralCadena\") == 0) _dx_txt = 1;")
        asm("    // ME-C4: Identificador de variable inferida como texto (paridad tipo_de_expr L89-93).")
        asm("    extern char _G_fn_var_tipos[2048][64];")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _hvi = (struct Identificador*)_nx0;")
        asm("        if (_hvi->nombre.datos) {")
        asm("            for (int _vti = 0; _vti < _G_fn_vars_count; _vti++) {")
        asm("                if (strcmp(_G_fn_vars[_vti], _hvi->nombre.datos) == 0) {")
        asm("                    if (strcmp(_G_fn_var_tipos[_vti], \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("                    break;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _hvd2 = (struct Identificador*)_nx1;")
        asm("        if (_hvd2->nombre.datos) {")
        asm("            for (int _vti2 = 0; _vti2 < _G_fn_vars_count; _vti2++) {")
        asm("                if (strcmp(_G_fn_vars[_vti2], _hvd2->nombre.datos) == 0) {")
        asm("                    if (strcmp(_G_fn_var_tipos[_vti2], \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("                    break;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    // F3-13: ExprAccesoCampo con campo de tipo texto (paridad S1 tipo_de_expr L70-95).")
        asm("    // ch.clave_publica_local (CanalRemoto.texto) debe contar como texto en OpBinaria.")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("        struct ExprAccesoCampo* _hca = (struct ExprAccesoCampo*)_nx0;")
        asm("        if (_hca->objeto && _hca->objeto->tipo.datos && strcmp(_hca->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("            struct Identificador* _hco = (struct Identificador*)_hca->objeto;")
        asm("            if (_hco->nombre.datos && _hca->nombre_campo.datos) {")
        asm("                char _hc_t[64]; _hc_t[0] = 0;")
        asm("                for (int _hci = 0; _hci < _G_fn_vars_count; _hci++) {")
        asm("                    if (strcmp(_G_fn_vars[_hci], _hco->nombre.datos) == 0 && _G_fn_var_tipos[_hci][0]) {")
        asm("                        const char* _hsrc = _G_fn_var_tipos[_hci];")
        asm("                        if (strncmp(_hsrc, \"struct \", 7) == 0) _hsrc += 7;")
        asm("                        char _hsb[64]; _hsb[0] = 0;")
        asm("                        for (int _hsi = 0; _hsrc[_hsi] && _hsi < 62; _hsi++) { if (_hsrc[_hsi] == '<') break; _hsb[_hsi] = _hsrc[_hsi]; _hsb[_hsi + 1] = 0; }")
        asm("                        if (_G_native_campo_tipo(_hsb, _hca->nombre_campo.datos, _hc_t)) {")
        asm("                            if (strcmp(_hc_t, \"texto\") == 0 || strcmp(_hc_t, \"cadena\") == 0 || strcmp(_hc_t, \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("                        }")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("        struct ExprAccesoCampo* _hca2 = (struct ExprAccesoCampo*)_nx1;")
        asm("        if (_hca2->objeto && _hca2->objeto->tipo.datos && strcmp(_hca2->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("            struct Identificador* _hco2 = (struct Identificador*)_hca2->objeto;")
        asm("            if (_hco2->nombre.datos && _hca2->nombre_campo.datos) {")
        asm("                char _hc_t2[64]; _hc_t2[0] = 0;")
        asm("                for (int _hci2 = 0; _hci2 < _G_fn_vars_count; _hci2++) {")
        asm("                    if (strcmp(_G_fn_vars[_hci2], _hco2->nombre.datos) == 0 && _G_fn_var_tipos[_hci2][0]) {")
        asm("                        const char* _hsrc2 = _G_fn_var_tipos[_hci2];")
        asm("                        if (strncmp(_hsrc2, \"struct \", 7) == 0) _hsrc2 += 7;")
        asm("                        char _hsb2[64]; _hsb2[0] = 0;")
        asm("                        for (int _hsi2 = 0; _hsrc2[_hsi2] && _hsi2 < 62; _hsi2++) { if (_hsrc2[_hsi2] == '<') break; _hsb2[_hsi2] = _hsrc2[_hsi2]; _hsb2[_hsi2 + 1] = 0; }")
        asm("                        if (_G_native_campo_tipo(_hsb2, _hca2->nombre_campo.datos, _hc_t2)) {")
        asm("                            if (strcmp(_hc_t2, \"texto\") == 0 || strcmp(_hc_t2, \"cadena\") == 0 || strcmp(_hc_t2, \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("                        }")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfi = (struct LlamadaFuncion*)_nx0;")
        asm("        if (_lfi->nombre.datos) {")
        asm("            char _rti[64]; _rti[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_lfi->nombre.datos, _rti)) {")
        asm("                if (strcmp(_rti, \"cadena\") == 0 || strcmp(_rti, \"texto\") == 0 || strcmp(_rti, \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("            }")
        asm("            if (strcmp(_lfi->nombre.datos, \"concat\") == 0 || strcmp(_lfi->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_lfi->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_lfi->nombre.datos, \"leer_linea\") == 0 || strcmp(_lfi->nombre.datos, \"subcadena\") == 0) _ix_txt = 1;")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfd = (struct LlamadaFuncion*)_nx1;")
        asm("        if (_lfd->nombre.datos) {")
        asm("            char _rtd[64]; _rtd[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_lfd->nombre.datos, _rtd)) {")
        asm("                if (strcmp(_rtd, \"cadena\") == 0 || strcmp(_rtd, \"texto\") == 0 || strcmp(_rtd, \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("            }")
        asm("            if (strcmp(_lfd->nombre.datos, \"concat\") == 0 || strcmp(_lfd->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_lfd->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_lfd->nombre.datos, \"leer_linea\") == 0 || strcmp(_lfd->nombre.datos, \"subcadena\") == 0) _dx_txt = 1;")
        asm("        }")
        asm("    }")
        asm("    if (_ot == 25) {")
        asm("        if (_ix_txt || _dx_txt) { snprintf(_b, _sz, \"(str_eq(%s, %s) == 1)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s == %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    if (_ot == 26) {")
        asm("        if (_ix_txt || _dx_txt) { snprintf(_b, _sz, \"(str_eq(%s, %s) == 0)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s != %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    if (_ot == 30) {")
        asm("        // paridad _to_str2: el lado no-texto se convierte con entero_a_texto")
        asm("        if (_ix_txt && _dx_txt) { snprintf(_b, _sz, \"concat(%s, %s)\", _izq, _der); }")
        asm("        else if (_ix_txt) { snprintf(_b, _sz, \"concat(%s, entero_a_texto(%s))\", _izq, _der); }")
        asm("        else if (_dx_txt) { snprintf(_b, _sz, \"concat(entero_a_texto(%s), %s)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s + %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s%s\", _izq, _op_str, _der);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"OpUnaria\")) {")
        asm("    struct OpUnaria* _ou = (struct OpUnaria*)_n;")
