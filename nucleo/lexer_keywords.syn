// cumple Manual 1 §2: lexer
// cumple Manual 8 §4.1: compilador nativo S2
#lang: es

// ============================================================
// lexer_keywords.syn - tablas de keywords multi-idioma (Manual 2 S2.3)
// ============================================================
// Extraido de nucleo/lexer.syn en la modularizacion R32 (deuda D-9(b),
// AUDITORIA_ALINEACION_MANUALES). Las 4 tablas es/en/fr/pt se mueven
// TEXTUALMENTE (misma indentacion, sin cambios de logica); el orquestador
// keyword_token() queda en lexer.syn y delega aqui por idioma. El emisor
// C ordena funciones alfabeticamente (Manual 8 S8.2) -> el C generado no
// cambia salvo el array _files[] de principal.syn (prueba de transparencia).


// --- Keyword dictionary lookup (multi-idioma, Manual 2 S2.3) ---
// AUDITORIA FASE A (A2.1): activados let/delegar/rc/arc/débil/modulo
// (Manual 2 §3: T_LET, T_DELEGAR, T_RC, T_ARC, T_DEBIL, T_MODULO), keywords
// contextuales que conservan el lexema para el parser (paridad con _P_*).
funcion keyword_token_es(palabra: cadena) -> entero:
    si str_eq(palabra, "si") == 1:
        retornar T_SI
    si str_eq(palabra, "sino") == 1:
        retornar T_SINO
    si str_eq(palabra, "funcion") == 1:
        retornar T_FUNCION
    si str_eq(palabra, "retornar") == 1:
        retornar T_RETORNAR
    si str_eq(palabra, "lanzar") == 1:
        retornar T_LANZAR
    si str_eq(palabra, "recuperar") == 1:
        retornar T_RECUPERAR
    si str_eq(palabra, "escuchar") == 1:
        retornar T_ESCUCHAR
    si str_eq(palabra, "mientras") == 1:
        retornar T_MIENTRAS
    si str_eq(palabra, "importar") == 1:
        retornar T_IMPORTAR
    si str_eq(palabra, "romper") == 1:
        retornar T_ROMPER
    si str_eq(palabra, "siguiente") == 1:
        retornar T_SIGUIENTE
    si str_eq(palabra, "estructura") == 1:
        retornar T_ESTRUCTURA
    si str_eq(palabra, "y") == 1:
        retornar T_Y
    si str_eq(palabra, "o") == 1:
        retornar T_O
    si str_eq(palabra, "no") == 1:
        retornar T_NO
    si str_eq(palabra, "verdadero") == 1:
        retornar T_VERDADERO
    si str_eq(palabra, "falso") == 1:
        retornar T_FALSO
    si str_eq(palabra, "inseguro") == 1:
        retornar T_INSEGURO
    si str_eq(palabra, "importar_c") == 1:
        retornar T_IMPORTAR_C
    si str_eq(palabra, "externo") == 1:
        retornar T_EXTERNO
    si str_eq(palabra, "coincidir") == 1:
        retornar T_COINCIDIR
    si str_eq(palabra, "requiere") == 1:
        retornar T_REQUIERE
    si str_eq(palabra, "garantiza") == 1:
        retornar T_GARANTIZA
    si str_eq(palabra, "canal") == 1:
        retornar T_CANAL
    si str_eq(palabra, "asm") == 1:
        retornar T_ASM
    si str_eq(palabra, "constante") == 1:
        retornar T_CONSTANTE
    si str_eq(palabra, "para") == 1:
        retornar T_PARA
    // AUDITORIA F1 (D-F1): Manual 2 §3 — keywords contextuales activados
    si str_eq(palabra, "tipo") == 1:
        retornar T_TIPO
    si str_eq(palabra, "tensor") == 1:
        retornar T_TENSOR
    si str_eq(palabra, "nulo") == 1:
        retornar T_NULO
    si str_eq(palabra, "ok") == 1:
        retornar T_OK
    si str_eq(palabra, "err") == 1:
        retornar T_ERR
    si str_eq(palabra, "algun") == 1:
        retornar T_ALGUN
    si str_eq(palabra, "ninguno") == 1:
        retornar T_NINGUNO
    // AUDITORIA FASE A (A2.1): Manual 2 §3 — let/delegar/rc/arc/débil/modulo
    si str_eq(palabra, "let") == 1:
        retornar T_LET
    si str_eq(palabra, "delegar") == 1:
        retornar T_DELEGAR
    si str_eq(palabra, "rc") == 1:
        retornar T_RC
    si str_eq(palabra, "arc") == 1:
        retornar T_ARC
    si str_eq(palabra, "débil") == 1:
        retornar T_DEBIL
    si str_eq(palabra, "modulo") == 1:
        retornar T_MODULO
    retornar 0

funcion keyword_token_en(palabra: cadena) -> entero:
    si str_eq(palabra, "if") == 1:
        retornar T_SI
    si str_eq(palabra, "else") == 1:
        retornar T_SINO
    si str_eq(palabra, "function") == 1:
        retornar T_FUNCION
    si str_eq(palabra, "return") == 1:
        retornar T_RETORNAR
    si str_eq(palabra, "spawn") == 1:
        retornar T_LANZAR
    si str_eq(palabra, "recover") == 1:
        retornar T_RECUPERAR
    si str_eq(palabra, "listen") == 1:
        retornar T_ESCUCHAR
    si str_eq(palabra, "while") == 1:
        retornar T_MIENTRAS
    si str_eq(palabra, "break") == 1:
        retornar T_ROMPER
    si str_eq(palabra, "continue") == 1:
        retornar T_SIGUIENTE
    si str_eq(palabra, "import") == 1:
        retornar T_IMPORTAR
    si str_eq(palabra, "struct") == 1:
        retornar T_ESTRUCTURA
    si str_eq(palabra, "and") == 1:
        retornar T_Y
    si str_eq(palabra, "or") == 1:
        retornar T_O
    si str_eq(palabra, "not") == 1:
        retornar T_NO
    si str_eq(palabra, "true") == 1:
        retornar T_VERDADERO
    si str_eq(palabra, "false") == 1:
        retornar T_FALSO
    si str_eq(palabra, "unsafe") == 1:
        retornar T_INSEGURO
    si str_eq(palabra, "import_c") == 1:
        retornar T_IMPORTAR_C
    si str_eq(palabra, "extern") == 1:
        retornar T_EXTERNO
    si str_eq(palabra, "match") == 1:
        retornar T_COINCIDIR
    si str_eq(palabra, "requires") == 1:
        retornar T_REQUIERE
    si str_eq(palabra, "ensures") == 1:
        retornar T_GARANTIZA
    si str_eq(palabra, "asm") == 1:
        retornar T_ASM
    si str_eq(palabra, "constant") == 1:
        retornar T_CONSTANTE
    si str_eq(palabra, "const") == 1:
        retornar T_CONSTANTE
    si str_eq(palabra, "for") == 1:
        retornar T_PARA
    // AUDITORIA F1 (D-F1): Manual 2 §3 — keywords contextuales activados
    si str_eq(palabra, "type") == 1:
        retornar T_TIPO
    si str_eq(palabra, "tensor") == 1:
        retornar T_TENSOR
    si str_eq(palabra, "null") == 1:
        retornar T_NULO
    si str_eq(palabra, "ok") == 1:
        retornar T_OK
    si str_eq(palabra, "err") == 1:
        retornar T_ERR
    si str_eq(palabra, "some") == 1:
        retornar T_ALGUN
    si str_eq(palabra, "none") == 1:
        retornar T_NINGUNO
    // AUDITORIA FASE A (A2.1): Manual 2 §3
    si str_eq(palabra, "let") == 1:
        retornar T_LET
    si str_eq(palabra, "delegate") == 1:
        retornar T_DELEGAR
    si str_eq(palabra, "rc") == 1:
        retornar T_RC
    si str_eq(palabra, "arc") == 1:
        retornar T_ARC
    si str_eq(palabra, "weak") == 1:
        retornar T_DEBIL
    si str_eq(palabra, "module") == 1:
        retornar T_MODULO
    retornar 0

