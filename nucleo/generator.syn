        asm("            for (int _pvi = 0; _pvi < _G_fn_ptr_vars_count; _pvi++) { if (strcmp(_G_fn_ptr_vars[_pvi], _oidc->nombre.datos) == 0) { _sep = \"->\"; break; } }")
        asm("        }")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s%s\", _obj_buf, _sep, _ea->nombre_campo.datos ? _ea->nombre_campo.datos : \"\");")
        asm("    return;")
        asm("}")
        asm("// Fallback")
        asm("strcpy(_b, \"0\");")

// ===== From: nodos_flujo.syn =====

#lang: es

// ============================================================
// nodos_flujo.syn  —  Visitantes de control de flujo (OO style)
// ============================================================
// Visitantes para nodos del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - Cada visitante emite gen_emitir_traza() antes de emitir
//     codigo, para trazabilidad en el archivo C generado.
//   - Los bloques ( ) se emiten exclusivamente mediante
//     gen_abrir_bloque_c() y gen_cerrar_bloque_c() de emision_c.
//     Prohibida la emision manual de llaves con strings crudos.
//   - El dispatcher (gen_visitar_stmt_generico) tiene una rama
//     de fail-fast para tipos de nodo no reconocidos.
// ============================================================

// NOTA: _oo_expr_a_c se encuentra en expr_eval.syn (submodulo separado)

// ----------------------------------------------------------
// gen_visitar_si  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_si(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSi* _s = (struct SentenciaSi*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSi\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// if (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    if (\");")
        asm("_buf2[0] = 0;")
        asm("if (_s->condicion) { _oo_expr_a_c(est, _s->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// Visit if-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _ic = _s->cuerpo;")
        asm("    while (_ic) {")
        asm("        struct Nodo* _is = _ic->cabeza;")
        asm("        if (_is) { gen_visitar_stmt_generico(est, _is); }")
        asm("        _ic = _ic->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")
        asm("if (_s->cuerpo_sino) {")
        asm("    gen_emitir_str(est, \"    else\");")
        asm("    gen_abrir_bloque_c(est);")
        asm("    struct ListaNodo* _ec = _s->cuerpo_sino;")
        asm("    while (_ec) {")
        asm("        struct Nodo* _es = _ec->cabeza;")
        asm("        if (_es) { gen_visitar_stmt_generico(est, _es); }")
        asm("        _ec = _ec->cola;")
        asm("    }")
        asm("    gen_cerrar_bloque_c(est);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_mientras  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_mientras(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaMientras* _w = (struct SentenciaMientras*)stmt;")
        asm("if (!_w) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaMientras\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// while (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    while (\");")
        asm("_buf2[0] = 0;")
        asm("if (_w->condicion) { _oo_expr_a_c(est, _w->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// While-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _wc = _w->cuerpo;")
        asm("    while (_wc) {")
        asm("        struct Nodo* _ws = _wc->cabeza;")
        asm("        if (_ws) { gen_visitar_stmt_generico(est, _ws); }")
        asm("        _wc = _wc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_para  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_para(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaPara* _p = (struct SentenciaPara*)stmt;")
        asm("if (!_p) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaPara\");")
        asm("char _buf[4096], _init[512], _cond[512], _step[512];")
        asm("_init[0] = _cond[0] = _step[0] = 0;")
        asm("// Evaluate init, cond, step expressions")
        asm("if (_p->inicializacion) { _oo_expr_a_c(est, _p->inicializacion, _init, 512); }")
        asm("if (_p->condicion) { _oo_expr_a_c(est, _p->condicion, _cond, 512); }")
        asm("if (_p->incremento) { _oo_expr_a_c(est, _p->incremento, _step, 512); }")
        asm("// Emit: for (init; cond; step) {")
        asm("snprintf(_buf, 4096, \"    for (%s; %s; %s)\", _init, _cond, _step);")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// For-body via dispatcher")
        asm("{")
        asm("    struct Nodo* _fc = _p->cuerpo;")
        asm("    if (_fc) { gen_visitar_stmt_generico(est, _fc); }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_retornar
// ----------------------------------------------------------
funcion gen_visitar_retornar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)stmt;")
        asm("if (!_rt) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRetornar\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    return \");")
        asm("_buf2[0] = 0;")
        asm("if (_rt->expr) { _oo_expr_a_c(est, _rt->expr, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_declaracion
// ----------------------------------------------------------
funcion gen_visitar_declaracion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)stmt;")
        asm("if (!_dv) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"DeclaracionVariable\");")
        asm("if (!_dv->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: DeclaracionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Manual 8 S8.2 / paridad: literal string -> CadenaSegura (no const char*)")
        asm("// F1.2c: `let x: tipo = ...` usa la anotacion explicita (paridad visitar_declaracion);")
        asm("// si no hay anotacion se infiere: LiteralCadena -> CadenaSegura, LiteralDecimal -> float, resto int.")
        asm("extern char _gen_tmp_buf[4096];")
        asm("char _var_type_buf[128]; _var_type_buf[0] = 0;")
        asm("const char* _var_type = \"int \";")
        asm("if (_dv->tipo_param.datos && _dv->tipo_param.datos[0] != 0) {")
        asm("    traducir_tipo_c((void*)_dv->tipo_param.datos);")
        asm("    strncpy(_var_type_buf, _gen_tmp_buf, 127); _var_type_buf[127] = 0;")
        asm("    strcat(_var_type_buf, \" \");")
        asm("    _var_type = _var_type_buf;")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralDecimal\") == 0) {")
        asm("    _var_type = \"float \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprTensor\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L53-54 (ExprTensor -> Tensor)")
        asm("    _var_type = \"Tensor \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralNulo\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L36-38 (LiteralNulo -> void*)")
        asm("    _var_type = \"void* \";")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _dv->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_dv->expresion) { _oo_expr_a_c(est, _dv->expresion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.2: Track string vars for RAII pool_free at scope exit
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        // M22.3: RAII tracking — solo para expresiones GARANTIZADAS de retornar texto al heap
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto = 0;")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos) {")
        asm("    const char* _et = _dv->expresion->tipo.datos;")
        asm("    // Literal string — siempre texto al heap")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("    // LlamadaFuncion: solo si el nombre coincide con funciones que retornan texto")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto = 1;")
        asm("        }")
        asm("    }")
        asm("    // OpBinaria: + es texto solo si un operando es literal o var de texto (paridad tipo_de_expr)")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_dv->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_es_texto == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _dv->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _dv->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_delegar
// F1.2c: `delegar expresion` == `retornar err(...)` (Manual 2 §2 L132,
// Manual 3 §7). Patron `?` de Resultado: si el tag es err, propaga el valor;
// si es ok, continua (el valor se descarta).
// ----------------------------------------------------------
funcion gen_visitar_delegar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaDelegar* _dl = (struct SentenciaDelegar*)stmt;")
        asm("if (!_dl) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaDelegar\");")
        asm("char _dbuf[4096]; _dbuf[0] = 0;")
        asm("if (_dl->expresion) { _oo_expr_a_c(est, _dl->expresion, _dbuf, 4096); }")
        asm("char _dline[4128]; _dline[0] = 0;")
        asm("snprintf(_dline, 4128, \"    Resultado _del = %s;\", _dbuf);")
        asm("gen_emitir_str(est, \"{\");")
        asm("gen_emitir_str(est, _dline);")
        asm("gen_emitir_str(est, \"    if (_del.tag == 1) return _del;\");")
        asm("gen_emitir_str(est, \"}\");")

funcion gen_visitar_asignacion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionVariable* _a = (struct AsignacionVariable*)stmt;")
        asm("if (!_a) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionVariable\");")
        asm("if (!_a->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: AsignacionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal assignment -> use const char*")
        asm("const char* _var_type = \"int \";")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("}")
        asm("// ME-B4: Struct constructor call -> struct <N> <var> = {0};")
        asm("const char* _struct_name = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf2 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf2->nombre.datos && _G_native_es_estructura(_lf2->nombre.datos)) { _struct_name = _lf2->nombre.datos; }")
        asm("}")
        asm("// ME-B6: inferir tipo desde retorno de funcion definida")
        asm("const char* _ret_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf3 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf3->nombre.datos) {")
        asm("        char _rtbuf[64]; _rtbuf[0] = 0;")
        asm("        if (_G_native_tipo_retorno(_lf3->nombre.datos, _rtbuf)) {")
        asm("            if (strcmp(_rtbuf, \"vacio\") != 0 && strcmp(_rtbuf, \"nulo\") != 0 && strcmp(_rtbuf, \"entero\") != 0) { _ret_type = _rtbuf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("// ME-B7 hoisting (paridad emit_declarations.py 'Pre-pass: hoist variable declarations'):")
        asm("// la primera asignacion declara la variable; las siguientes solo asignan.")
        asm("extern char _G_fn_vars[2048][64]; extern int _G_fn_vars_count;")
        asm("int _ya_decl = 0;")
        asm("for (int _vd = 0; _vd < _G_fn_vars_count; _vd++) { if (strcmp(_G_fn_vars[_vd], _a->nombre.datos) == 0) { _ya_decl = 1; break; } }")
        asm("if (!_ya_decl && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _a->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_vars_count++; }")
        asm("if (!_ya_decl) {")
        asm("    if (_struct_name) {")
        asm("        strcat(_buf, \"struct \"); strcat(_buf, _struct_name); strcat(_buf, \" \");")
        asm("    } else if (_ret_type) {")
        asm("        traducir_tipo_c((void*)_ret_type);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        strcat(_buf, _gen_tmp_buf); strcat(_buf, \" \");")
        asm("    } else {")
        asm("        strcat(_buf, _var_type);")
        asm("    }")
        asm("}")
        asm("strcat(_buf, _a->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_a->expresion) {")
        asm("    // ME-B4: constructor de struct emitido por _oo_expr_a_c como compound literal (struct X){0}")
        asm("    _oo_expr_a_c(est, _a->expresion, _buf2, 4096);")
        asm("}")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.3: RAII tracking — solo funciones y operadores garantizados de retornar texto
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto2 = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos) {")
        asm("    const char* _et = _a->expresion->tipo.datos;")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_a->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto2 = 1;")
        asm("        }")
        asm("    }")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_a->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_es_texto2 == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto2 == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto2) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _a->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _a->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_asignacion_campo  (ME-B9.x, paridad visitar_asignacion_campo)
// ----------------------------------------------------------
funcion gen_visitar_asignacion_campo(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionCampo* _ac = (struct AsignacionCampo*)stmt;")
        asm("if (!_ac) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionCampo\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0; _buf2[0] = 0;")
        asm("if (_ac->objeto) { _oo_expr_a_c(est, _ac->objeto, _buf, 4096); }")
        asm("if (_ac->expresion) { _oo_expr_a_c(est, _ac->expresion, _buf2, 4096); }")
        asm("const char* _sep = \".\";")
        asm("if (_ac->objeto && _ac->objeto->tipo.datos && strcmp(_ac->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("    struct Identificador* _oidc = (struct Identificador*)_ac->objeto;")
        asm("    if (_oidc->nombre.datos) {")
        asm("        extern char _G_fn_ptr_vars[64][64]; extern int _G_fn_ptr_vars_count;")
        asm("        for (int _pvi = 0; _pvi < _G_fn_ptr_vars_count; _pvi++) { if (strcmp(_G_fn_ptr_vars[_pvi], _oidc->nombre.datos) == 0) { _sep = \"->\"; break; } }")
        asm("    }")
        asm("}")
        asm("char _linea[8192];")
        asm("snprintf(_linea, 8192, \"    %s%s%s = %s;\", _buf, _sep, _ac->nombre_campo.datos ? _ac->nombre_campo.datos : \"\", _buf2);")
        asm("gen_emitir_str(est, _linea);")

// ----------------------------------------------------------
// gen_visitar_expr
// ----------------------------------------------------------
funcion gen_visitar_expr(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaExpr* _s = (struct SentenciaExpr*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaExpr\");")
        asm("char _buf[4096]; _buf[0] = 0;")
        asm("char _sbuf[4096]; _sbuf[0] = 0;")
        asm("// ME-B5: detectar asm(<cadena>) directo -> emitir instruccion cruda (paridad generator.py L203-232)")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _asm_lf = (struct LlamadaFuncion*)_s->expr;")
        asm("    if (_asm_lf->nombre.datos && strcmp(_asm_lf->nombre.datos, \"asm\") == 0 && _asm_lf->argumentos) {")
        asm("        struct Nodo* _asm_arg = (struct Nodo*)_asm_lf->argumentos->cabeza;")
        asm("        if (_asm_arg && _syn_es_tipo(_asm_arg->tipo.datos, \"LiteralCadena\")) {")
        asm("            struct LiteralCadena* _asm_lc = (struct LiteralCadena*)_asm_arg;")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud == 0) {")
        asm("                // asm(\"\") vacio: emitir sentencia vacia valida (paridad generator.py 'not trimmed')")
        asm("                gen_emitir_str(est, \";\");")
        asm("                return;")
        asm("            }")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud > 0) {")
        asm("                strncpy(_buf, _asm_lc->valor.datos, 4095);")
        asm("                _buf[4095] = 0;")
        asm("                int _l2 = (int)strlen(_buf);")
        asm("                while (_l2 > 0 && (_buf[_l2-1] == ' ' || _buf[_l2-1] == '\\t' || _buf[_l2-1] == '\\n')) _l2--;")
        asm("                int _needs_semi = 1;")
        asm("                if (_l2 == 0) _needs_semi = 0;")
        asm("                else if (_buf[0] == '#') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == ';') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '{') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '}') {")
        asm("                    int _pb = _l2 - 2;")
        asm("                    while (_pb >= 0 && (_buf[_pb] == ' ' || _buf[_pb] == '\\t' || _buf[_pb] == '\\n')) _pb--;")
        asm("                    if (_pb >= 0 && _buf[_pb] == ';') { _needs_semi = 0; }")
        asm("                    else {")
        asm("                        int _io = -1;")
        asm("                        for (int _j = _l2 - 2; _j >= 0; _j--) { if (_buf[_j] == '{') { _io = _j; break; } }")
        asm("                        if (_io < 0) _needs_semi = 0;")
        asm("                    }")
        asm("                }")
        asm("                if (_needs_semi) { strcat(_buf, \";\"); }")
        asm("                char _ebuf[4096];")
        asm("                int _ep = 0;")
        asm("                for (int _k = 0; _buf[_k] && _ep < 4095; _k++) {")
        asm("                    if (_buf[_k] == '\\n') { _ebuf[_ep++] = '\\\\'; _ebuf[_ep++] = 'n'; }")
        asm("                    else { _ebuf[_ep++] = _buf[_k]; }")
        asm("                }")
