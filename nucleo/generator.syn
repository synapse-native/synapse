    gen_emitir_linea(est, "int _G_native_es_adt_ctr(const char* c) {")
    gen_emitir_linea(est, "    if (!c) return 0;")
    gen_emitir_linea(est, "    for (int _i = 0; _i < _G_native_adt_ctrs_count; _i++) {")
