// ----------------------------------------------------------
// gen_emitir_tokenizar — funcion tokenizar canonica (contador).
// Paridad: emitir_tokenizar (compilador/generator/emit_expressions.py).
// ----------------------------------------------------------
funcion gen_emitir_tokenizar(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("static char _G_tk0[] = \"int tokenizar(CadenaSegura fuente) {\";")
        asm("gen_emitir_str(est, _G_tk0);")
        asm("static char _G_tk1[] = \"    int _i=0, _linea=1, _columna=1, _token_count=0;\";")
        asm("gen_emitir_str(est, _G_tk1);")
        asm("static char _G_tk2[] = \"    while (_i < fuente.longitud) {\";")
        asm("gen_emitir_str(est, _G_tk2);")
        asm("static char _G_tk3[] = \"        char _c = fuente.datos[_i];\";")
        asm("gen_emitir_str(est, _G_tk3);")
        asm("static char _G_tk4[] = \"        if (_c==' '||_c=='\\\\t'){_i++;_columna++;continue;}\";")
        asm("gen_emitir_str(est, _G_tk4);")
        asm("static char _G_tk5[] = \"        if (_c=='\\\\r'){_i++;continue;}\";")
        asm("gen_emitir_str(est, _G_tk5);")
        asm("static char _G_tk6[] = \"        if (_c=='\\\\n'){_i++;_linea++;_columna=1;continue;}\";")
        asm("gen_emitir_str(est, _G_tk6);")
        asm("static char _G_tk7[] = \"        if (_c=='/'&&_i+1<fuente.longitud&&fuente.datos[_i+1]=='/'){\";")
        asm("gen_emitir_str(est, _G_tk7);")
        asm("static char _G_tk8[] = \"            while(_i<fuente.longitud&&fuente.datos[_i]!='\\\\n')_i++;continue;\";")
        asm("gen_emitir_str(est, _G_tk8);")
        asm("static char _G_tk9[] = \"        }\";")
        asm("gen_emitir_str(est, _G_tk9);")
        asm("static char _G_tk10[] = \"        if(_c=='\\\\\\\"'||_c=='\\\\''){char _q=_c;int _st=_i;_i++;_columna++;while(_i<fuente.longitud&&fuente.datos[_i]!=_q){_i++;_columna++;}if(_i>=fuente.longitud){break;}_i++;_columna++;_token_count++;}\";")
        asm("gen_emitir_str(est, _G_tk10);")
        asm("static char _G_tk11[] = \"        else if(_c>='0'&&_c<='9'){int _st=_i;while(_i<fuente.longitud&&fuente.datos[_i]>='0'&&fuente.datos[_i]<='9')_i++;_columna+=_i-_st;_token_count++;}\";")
        asm("gen_emitir_str(est, _G_tk11);")
        asm("static char _G_tk12[] = \"        else if((_c>='a'&&_c<='z')||(_c>='A'&&_c<='Z')||_c=='_'){int _st=_i;while(_i<fuente.longitud&&((fuente.datos[_i]>='a'&&fuente.datos[_i]<='z')||(fuente.datos[_i]>='A'&&fuente.datos[_i]<='Z')||(fuente.datos[_i]>='0'&&fuente.datos[_i]<='9')||fuente.datos[_i]=='_'))_i++;_columna+=_i-_st;_token_count++;}\";")
        asm("gen_emitir_str(est, _G_tk12);")
        asm("static char _G_tk13[] = \"        else{_i++;_columna++;_token_count++;}\";")
        asm("gen_emitir_str(est, _G_tk13);")
        asm("static char _G_tk14[] = \"    }\";")
        asm("gen_emitir_str(est, _G_tk14);")
        asm("static char _G_tk15[] = \"    return _token_count;\";")
        asm("gen_emitir_str(est, _G_tk15);")
        asm("static char _G_tk16[] = \"}\";")
        asm("gen_emitir_str(est, _G_tk16);")


