// ----------------------------------------------------------
// gen_visitar_stmt_generico — Dispatcher principal
// ----------------------------------------------------------
funcion gen_visitar_stmt_generico(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo sin tipo (puntero nulo en tipo.datos)\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"SentenciaSi\")) { gen_visitar_si(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaMientras\")) { gen_visitar_mientras(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaPara\")) { gen_visitar_para(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRetornar\")) { gen_visitar_retornar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaDelegar\")) { gen_visitar_delegar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionVariable\")) { gen_visitar_asignacion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaExpr\")) { gen_visitar_expr(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionVariable\")) { gen_visitar_declaracion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionCampo\")) { gen_visitar_asignacion_campo(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRomper\")) { gen_visitar_romper(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSiguiente\")) { gen_visitar_siguiente(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"BloqueInseguro\")) {")
        asm("    struct BloqueInseguro* _sbi = (struct BloqueInseguro*)stmt;")
        asm("    gen_emitir_traza(est, \"nodos_flujo.syn\", \"BloqueInseguro\");")
        asm("    struct ListaNodo* _sbl = (struct ListaNodo*)_sbi->cuerpo;")
        asm("    while (_sbl) {")
        asm("        struct Nodo* _sbs = _sbl->cabeza;")
        asm("        if (_sbs) { gen_visitar_stmt_generico(est, _sbs); }")
        asm("        _sbl = _sbl->cola;")
        asm("    }")
        asm("} else {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo tipo [%s] no reconocido\\n\", _t);")
        asm("    exit(1);")
        asm("}")

