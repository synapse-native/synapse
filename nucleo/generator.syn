        asm("while (_d2gd && _G_native_adt_gen_count < 64) {")
        asm("    struct Nodo* _d2gn = _d2gd->cabeza;")
        asm("    if (_d2gn && _d2gn->tipo.datos && strcmp(_d2gn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _d2gt = (struct DeclaracionTipo*)_d2gn;")
        asm("        if (_d2gt->nombre.datos && _d2gt->constructores && _d2gt->parametros_tipo) {")
        asm("            int _d2np = 0;")
        asm("            struct ListaNodo* _d2pl = _d2gt->parametros_tipo;")
        asm("            while (_d2pl && _d2np < 8) {")
        asm("                struct Nodo* _d2pn = _d2pl->cabeza;")
        asm("                if (_d2pn && _d2pn->tipo.datos && strcmp(_d2pn->tipo.datos, \"Identificador\") == 0) {")
        asm("                    struct Identificador* _d2pi = (struct Identificador*)_d2pn;")
