constante NODO_FUNCION = 2
constante NODO_SI = 3
constante NODO_MIENTRAS = 4
constante NODO_RETORNAR = 5
constante NODO_EXPR = 6
constante NODO_ASIGNACION = 7
constante NODO_IDENTIFICADOR = 8
constante NODO_NUMERO = 9
constante NODO_DECIMAL = 10
constante NODO_CADENA_LIT = 11
