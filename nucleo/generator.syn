// ===== From: nodos_flujo.syn =====

#lang: es
// ============================================================
// nodos_flujo.syn - Visitantes de control de flujo (OO style)
// ============================================================
// Visitantes para nodos del AST usando formato OO (struct Nodo*).
//
// DISENO:
// - Cada visitante emite gen_emitir_traza() antes de emitir
// codigo, para trazabilidad en el archivo C generado.
// - Los bloques ( ) se emiten exclusivamente mediante
// gen_abrir_bloque_c() y gen_cerrar_bloque_c() de emision_c.
// Prohibida la emision manual de llaves con strings crudos.
// - El dispatcher (gen_visitar_stmt_generico) tiene una rama
// de fail-fast para tipos de nodo no reconocidos.
// ============================================================

// NOTA: _oo_expr_a_c se encuentra en expr_eval.syn (submodulo separado)

// ----------------------------------------------------------
// gen_visitar_si (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_si(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSi* _s = (struct SentenciaSi*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSi\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// if (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    if (\");")
        asm("_buf2[0] = 0;")
        asm("if (_s->condicion) { _oo_expr_a_c(est, _s->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        // F17: PGO — incremento de contador en frontera if-true
        pgo_emitir_incremento_bb(est)
        cov_emitir_sonda(est) // cumple Manual 8 §4.2 (ME coverage_aristas): sonda paridad S1; OFF no emite (cumple Manual 1 §6)
        asm("// Visit if-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _ic = _s->cuerpo;")
        asm("    while (_ic) {")
        asm("        struct Nodo* _is = _ic->cabeza;")
        asm("        if (_is) { gen_visitar_stmt_generico(est, _is); }")
        asm("        _ic = _ic->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")
        asm("if (_s->cuerpo_sino) {")
        asm("    gen_emitir_str(est, \"    else\");")
        asm("    gen_abrir_bloque_c(est);")
        // F17: PGO — incremento de contador en frontera if-else
        pgo_emitir_incremento_bb(est)
        cov_emitir_sonda(est) // cumple Manual 8 §4.2 (ME coverage_aristas): sonda paridad S1; OFF no emite (cumple Manual 1 §6)
        asm("    struct ListaNodo* _ec = _s->cuerpo_sino;")
        asm("    while (_ec) {")
        asm("        struct Nodo* _es = _ec->cabeza;")
        asm("        if (_es) { gen_visitar_stmt_generico(est, _es); }")
        asm("        _ec = _ec->cola;")
        asm("    }")
        asm("    gen_cerrar_bloque_c(est);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_mientras (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_mientras(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaMientras* _w = (struct SentenciaMientras*)stmt;")
        asm("if (!_w) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaMientras\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// while (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    while (\");")
        asm("_buf2[0] = 0;")
        asm("if (_w->condicion) { _oo_expr_a_c(est, _w->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        // F17: PGO — incremento de contador en frontera while-body
        pgo_emitir_incremento_bb(est)
        cov_emitir_sonda(est) // cumple Manual 8 §4.2 (ME coverage_aristas): sonda paridad S1; OFF no emite (cumple Manual 1 §6)
        asm("// While-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _wc = _w->cuerpo;")
        asm("    while (_wc) {")
        asm("        struct Nodo* _ws = _wc->cabeza;")
        asm("        if (_ws) { gen_visitar_stmt_generico(est, _ws); }")
        asm("        _wc = _wc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_para (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_para(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaPara* _p = (struct SentenciaPara*)stmt;")
        asm("if (!_p) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaPara\");")
        asm("char _buf[4096], _init[512], _cond[512], _step[512], _vtb[128];")
        asm("_init[0] = _cond[0] = _step[0] = 0; _vtb[0] = 0;")
        // cumple Manual 3 §3 (r153 R2n): bucle_para_rango — `para x en expr:`
        // (puente: SentenciaPara con inicializacion=0, iterable en condicion,
        // variable en nombre). Emisión paritaria con emit_control.py
        // _emitir_para_en: índice + _syn_lista_obtener + desencajonado del slot.
        asm("if (!_p->inicializacion && _p->condicion) {")
        asm("    extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("    extern int64_t _syn_tipo_escalar(void* t);")
        asm("    char _fe_tipo[128]; _fe_tipo[0] = 0;")
        asm("    // 33.4b: limpieza diferida del para-en Mapa (RAII al CERRAR el bloque, M2 §9.1)")
        asm("    char _fe_defer[4][64]; int _fe_ndefer = 0;")
        asm("    _syn_nativo_expr_tipo_c((void*)_p->condicion, (void*)_fe_tipo);")
        asm("    const char* _fevar = (_p->nombre.datos && _p->nombre.datos[0]) ? _p->nombre.datos : \"_fe_v\";")
        asm("    char _feiter[512]; _feiter[0] = 0;")
        asm("    _oo_expr_a_c(est, _p->condicion, _feiter, 512);")
        asm("    // r153 (H-R153-6): si el inferidor no resolvio el tipo C de la")
        asm("    // expresion iterable y es una llamada `Lista<T>()`/`Mapa<K,V>()`,")
        asm("    // usar el nombre Synapse del nodo (el span 'Lista<T>') para la")
        asm("    // deteccion de la coleccion — paridad emit_control.py tipo_de_expr.")
        asm("    // (NOTA: condicion->tipo.datos es el tipo de NODO del puente, ej")
        asm("    //  'LlamadaFuncion'/'Identificador', NO el tipo Synapse.)")
        asm("    if (!_fe_tipo[0] && _p->condicion->tipo.datos && strcmp(_p->condicion->tipo.datos, \"LlamadaFuncion\") == 0 && ((struct LlamadaFuncion*)_p->condicion)->nombre.datos) { strncpy(_fe_tipo, ((struct LlamadaFuncion*)_p->condicion)->nombre.datos, 127); _fe_tipo[127] = 0; }")
        asm("    // r153 (H-R153-16): iterable que llega como handle void* — una llamada a")
        asm("    // funcion importada con retorno Lista<T> (ej. lint_archivo) NO se")
        asm("    // distingue de una cadena si el inferidor no ve el tipo Synapse de la")
        asm("    // firma; con _fe_tipo 'void*' o vacio caia en la rama texto (.datos).")
        asm("    // La variable de bucle declarada con coleccion explicita en la misma")
        asm("    // funcion (ej. `let suites = Lista<...>()`) ya registro el span")
        asm("    // 'Lista<...>' en _G_fn_var_tipos; una llamada/identificador resoluble a")
        asm("    // void* de coleccion se despacha aqui por el nombre registrado.")
        asm("    if ((_fe_tipo[0] == 0 || strcmp(_fe_tipo, \"void*\") == 0)) {")
        asm("        extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("        const char* _fevname = 0;")
        asm("        if (_p->condicion->tipo.datos && strcmp(_p->condicion->tipo.datos, \"Identificador\") == 0) {")
        asm("            struct Identificador* _feid = (struct Identificador*)_p->condicion;")
        asm("            if (_feid->nombre.datos) _fevname = _feid->nombre.datos;")
        asm("        }")
        asm("        if (_fevname) {")
        asm("            for (int _fev = 0; _fev < _G_fn_vars_count; _fev++) {")
        asm("                if (strcmp(_G_fn_vars[_fev], _fevname) == 0 && (strncmp(_G_fn_var_tipos[_fev], \"Lista<\", 6) == 0 || strncmp(_G_fn_var_tipos[_fev], \"Mapa<\", 5) == 0)) { strncpy(_fe_tipo, _G_fn_var_tipos[_fev], 127); _fe_tipo[127] = 0; break; }")
        asm("            }")
        asm("        }")
        asm("        // r153 (H-R153-24): paridad S1 — el iterable puede llegar envuelto")
        asm("        // (ruta unity: la llamada/cadena postfija se mapea a un nodo compuesto)")
        asm("        const char* _fevname2 = 0;")
        asm("        if (!_fevname && _p->condicion->tipo.datos && strcmp(_p->condicion->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("            struct ExprAccesoCampo* _few = (struct ExprAccesoCampo*)_p->condicion;")
        asm("            if (_few->objeto && _few->objeto->tipo.datos && strcmp(_few->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _fewi = (struct Identificador*)_few->objeto;")
        asm("                if (_fewi->nombre.datos) _fevname2 = _fewi->nombre.datos;")
        asm("            }")
        asm("        }")
        asm("        if (_fevname2) {")
        asm("            for (int _fev3 = 0; _fev3 < _G_fn_vars_count; _fev3++) {")
        asm("                if (strcmp(_G_fn_vars[_fev3], _fevname2) == 0 && (strncmp(_G_fn_var_tipos[_fev3], \"Lista<\", 6) == 0 || strncmp(_G_fn_var_tipos[_fev3], \"Mapa<\", 5) == 0)) { strncpy(_fe_tipo, _G_fn_var_tipos[_fev3], 127); _fe_tipo[127] = 0; break; }")
        asm("            }")
        asm("        }")
        asm("        // r153 (H-R153-22): llamada a funcion importada con retorno colección")
        asm("        // (agrupar_por_suite) — el span crudo `Lista<T>` vive en el registro")
        asm("        // de retornos (_G_native_func_returns, offsets +1024); con él el for-en")
        asm("        // despacha la caminata del runtime y el elemento toma su tipo real.")
        asm("        if ((_fe_tipo[0] == 0 || strcmp(_fe_tipo, \"void*\") == 0) && _p->condicion->tipo.datos && strcmp(_p->condicion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _felf = (struct LlamadaFuncion*)_p->condicion;")
        asm("            if (_felf->nombre.datos) {")
        asm("                extern char _G_native_func_returns[2048][64]; extern int _G_native_func_returns_count;")
        asm("                char _fesp[64]; _fesp[0] = 0;")
        asm("                for (int _fes = 0; _fes < _G_native_func_returns_count; _fes++) {")
        asm("                    if (strcmp(_G_native_func_returns[_fes], _felf->nombre.datos) == 0) { strncpy(_fesp, _G_native_func_returns[_fes + 1024], 63); _fesp[63] = 0; break; }")
        asm("                }")
        asm("                if (_fesp[0] && (strncmp(_fesp, \"Lista<\", 6) == 0 || strncmp(_fesp, \"Mapa<\", 5) == 0)) { strncpy(_fe_tipo, _fesp, 127); _fe_tipo[127] = 0; }")
        asm("            }")
        asm("        }")
        asm("        // r153 (H-R153-23): for-en anidado sobre CAMPO de coleccion")
        asm("        // (`para test en suite.tests`) — cumple Manual 3 §3: el iterable es")
        asm("        // cualquier expresion que produce lista (M3 §3 L133). Base")
        asm("        // Identificador con tipo registrado -> _G_native_campo_tipo -> span")
        asm("        // crudo Lista<T>/Mapa<K,V>.")
        asm("        if ((_fe_tipo[0] == 0 || strcmp(_fe_tipo, \"void*\") == 0) && _p->condicion->tipo.datos && strcmp(_p->condicion->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("            struct ExprAccesoCampo* _feeac = (struct ExprAccesoCampo*)_p->condicion;")
        asm("            if (_feeac->objeto && _feeac->objeto->tipo.datos && strcmp(_feeac->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _febid = (struct Identificador*)_feeac->objeto;")
        asm("                if (_febid->nombre.datos && _feeac->nombre_campo.datos) {")
        asm("                    char _febt[64]; _febt[0] = 0;")
        asm("                    for (int _fev2 = 0; _fev2 < _G_fn_vars_count; _fev2++) {")
        asm("                        if (strcmp(_G_fn_vars[_fev2], _febid->nombre.datos) == 0) { strncpy(_febt, _G_fn_var_tipos[_fev2], 63); _febt[63] = 0; break; }")
        asm("                    }")
        asm("                    if (strncmp(_febt, \"struct \", 7) == 0) { memmove(_febt, _febt + 7, strlen(_febt + 7) + 1); }")
        asm("                    for (int _fecut = 0; _fecut < 64 && _febt[_fecut]; _fecut++) { if (_febt[_fecut] == '<') { _febt[_fecut] = 0; break; } }")
        asm("                    if (_febt[0]) {")
        asm("                        extern int _G_native_campo_tipo(const char*, const char*, char*);")
        asm("                        char _fefld[64]; _fefld[0] = 0;")
        asm("                        if (_G_native_campo_tipo(_febt, _feeac->nombre_campo.datos, _fefld) && (strncmp(_fefld, \"Lista<\", 6) == 0 || strncmp(_fefld, \"Mapa<\", 5) == 0)) {")
        asm("                            strncpy(_fe_tipo, _fefld, 127); _fe_tipo[127] = 0;")
        asm("                        }")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    char _feelemn[120]; _feelemn[0] = 0;  // r153 (H-R153-19): visible para el registro de la var del bucle")
        asm("    if (_fe_tipo[0] == 'L' && strncmp(_fe_tipo, \"Lista<\", 6) == 0) {")
        asm("        // Lista<T>: caminata del runtime de colecciones (H-R153-2)")
        asm("        char _fel[64]; snprintf(_fel, 64, \"_fe_l_%p\", (void*)_p);")
        asm("        char _fei[64]; snprintf(_fei, 64, \"_fe_i_%p\", (void*)_p);")
        asm("        char _feh0[640]; snprintf(_feh0, 640, \"    void* %s = (void*)(%s);\", _fel, _feiter); gen_emitir_str(est, _feh0);")
        asm("        // r153 (H-R153-7): el header SIN llave — gen_abrir_bloque_c ya la")
        asm("        // emite (antes: '{{' en el C y desbalance al cerrar con un solo '}'")
        asm("        char _feh1[640]; snprintf(_feh1, 640, \"    for (int64_t %s = 0; %s < _syn_lista_longitud(%s); %s++)\", _fei, _fei, _fel, _fei); gen_emitir_str(est, _feh1);")
        asm("        gen_abrir_bloque_c(est);")
        asm("        char _fecom[128]; snprintf(_fecom, 128, \"_fe_c_%p\", (void*)_p);")
        asm("        char _fecom2[160]; snprintf(_fecom2, 160, \"    int64_t %s = _syn_lista_obtener(%s, (int)%s);\", _fecom, _fel, _fei); gen_emitir_str(est, _fecom2);")
        asm("        // elemento: escalar por valor; struct/texto por dirección (slots int64)")
        asm("        const char* _feelem = _fe_tipo + 6;")
        asm("        size_t _feel = strlen(_feelem);")
        asm("        if (_feel > 0 && _feelem[_feel-1] == '>') _feel--;")
        asm("        memcpy(_feelemn, _feelem, _feel < 119 ? _feel : 119); _feelemn[_feel < 119 ? _feel : 119] = 0;")
        asm("        // r153 (H-R153-8): elemento Synapse -> C (paridad traducir_tipo_c).")
        asm("        // La condicion de escalar se calcula ANTES del mapeo (_syn_tipo_")
        asm("        // escalar no reconoce los nombres C int64_t/double).")
        asm("        int _feesc = _syn_tipo_escalar((void*)_feelemn);")
        asm("        if (strcmp(_feelemn, \"texto\") == 0 || strcmp(_feelemn, \"cadena\") == 0) strcpy(_feelemn, \"CadenaSegura\");")
        asm("        else if (strcmp(_feelemn, \"entero\") == 0) strcpy(_feelemn, \"int64_t\");")
        asm("        else if (strcmp(_feelemn, \"decimal\") == 0) strcpy(_feelemn, \"double\");")
        asm("        else if (strcmp(_feelemn, \"booleano\") == 0) strcpy(_feelemn, \"int\");")
        asm("        else if (strcmp(_feelemn, \"puntero\") == 0) strcpy(_feelemn, \"void*\");")
        // r153 (H-R153-18): snprintf con origen==destino solapados es UB (puede
        // producir "struct struct", observado en synapse_unity.c:351). memmove
        // solapado seguro: "struct " + elemento en _feelemn[120] (7+112+1 <= 120).
        asm("        else if (!_feesc) { memmove(_feelemn + 7, _feelemn, (_feel < 112) ? _feel : 112); memcpy(_feelemn, \"struct \", 7); _feelemn[7 + ((_feel < 112) ? _feel : 112)] = 0; }")
        asm("        if (_feesc) {")
        asm("            char _feh2[320]; snprintf(_feh2, 320, \"    %s %s = (%s)%s;\", _feelemn, _fevar, _feelemn, _fecom); gen_emitir_str(est, _feh2);")
        asm("        } else {")
        asm("            char _feh3[320]; snprintf(_feh3, 320, \"    %s %s = *(%s*)(intptr_t)%s;\", _feelemn, _fevar, _feelemn, _fecom); gen_emitir_str(est, _feh3);")
        asm("        }")
        asm("    } else if (_fe_tipo[0] == 'M' && strncmp(_fe_tipo, \"Mapa<\", 5) == 0) {")
        asm("        // cumple Manual 2 §4.3 (33.4b): `para k en mapa` — k itera las")
        asm("        // CLAVES (M3 §5.2 keys()/iter(); D-33.4b-1: valor via m[k], 33.4a).")
        asm("        // _syn_mapa_claves retorna una lista con claves ENCAJONADAS como")
        asm("        // CadenaSegura* (runtime/core/mapa.c 33.4b) — el desencajonado es")
        asm("        // el deref estándar de Lista<texto>. Paridad emit_control.py.")
        asm("        char _fem[64]; snprintf(_fem, 64, \"_fe_m_%p\", (void*)_p);")
        asm("        char _femi[64]; snprintf(_femi, 64, \"_fe_i_%p\", (void*)_p);")
        asm("        char _femh0[640]; snprintf(_femh0, 640, \"    void* %s = _syn_mapa_claves((void*)(%s));\", _fem, _feiter); gen_emitir_str(est, _femh0);")
        asm("        char _femh1[640]; snprintf(_femh1, 640, \"    for (int64_t %s = 0; %s < _syn_lista_longitud(%s); %s++)\", _femi, _femi, _fem, _femi); gen_emitir_str(est, _femh1);")
        asm("        gen_abrir_bloque_c(est);")
        asm("        char _femcom[128]; snprintf(_femcom, 128, \"_fe_mc_%p\", (void*)_p);")
        asm("        char _femcom2[160]; snprintf(_femcom2, 160, \"    int64_t %s = _syn_lista_obtener(%s, (int)%s);\", _femcom, _fem, _femi); gen_emitir_str(est, _femcom2);")
        asm("        char _femh2[320]; snprintf(_femh2, 320, \"    CadenaSegura %s = *(CadenaSegura*)(intptr_t)%s;\", _fevar, _femcom); gen_emitir_str(est, _femh2);")
        asm("        // 33.4b: liberar la lista de claves al CERRAR el bloque (fuera del bucle)")
        asm("        if (_fe_ndefer < 4) { strncpy(_fe_defer[_fe_ndefer], _fem, 63); _fe_defer[_fe_ndefer][63] = 0; _fe_ndefer++; }")
        asm("        // registrar la var del bucle con tipo texto (paridad rama Lista)")
        asm("        strcpy(_feelemn, \"CadenaSegura\");")
        asm("    } else {")
        asm("        // texto: iterar bytes (paridad emit_control.py)")
        asm("        char _fes[64]; snprintf(_fes, 64, \"_fe_s_%p\", (void*)_p);")
        asm("        char _fei2[64]; snprintf(_fei2, 64, \"_fe_i_%p\", (void*)_p);")
        asm("        char _feh4[640]; snprintf(_feh4, 640, \"    CadenaSegura %s = %s;\", _fes, _feiter); gen_emitir_str(est, _feh4);")
        asm("        // r153 (H-R153-7): idem rama Lista — header SIN llave")
        asm("        char _feh5[640]; snprintf(_feh5, 640, \"    for (int64_t %s = 0; %s < %s.longitud; %s++)\", _fei2, _fei2, _fes, _fei2); gen_emitir_str(est, _feh5);")
        asm("        gen_abrir_bloque_c(est);")
        asm("        char _feh6[320]; snprintf(_feh6, 320, \"    int64_t %s = (int64_t)(unsigned char)%s.datos[%s];\", _fevar, _fes, _fei2); gen_emitir_str(est, _feh6);")
        asm("    }")
        asm("    // registrar la variable de bucle (patron R28/R30)")
        asm("    extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("    int _pvi2 = -1;")
        asm("    for (int _v2 = 0; _v2 < _G_fn_vars_count; _v2++) { if (strcmp(_G_fn_vars[_v2], _fevar) == 0) { _pvi2 = _v2; break; } }")
        asm("    if (_pvi2 < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _fevar, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _pvi2 = _G_fn_vars_count++; }")
        asm("    // r153 (H-R153-19): la var del bucle registra el tipo C REAL del")
        asm("    // elemento (struct ResultadoTest para Lista<ResultadoTest>) — antes")
        asm("    // 'puntero' generico, y test.campo no resolvia el tipo del campo")
        asm("    // (texto) -> entero_a_texto(campo)/== sin str_eq -> gcc rc=1.")
        asm("    // 33.4b: Mapa también registra el tipo real del elemento (claves = CadenaSegura)")
        asm("    const char* _fetv = ((_fe_tipo[0] == 'L' || _fe_tipo[0] == 'M') && _feelemn[0]) ? _feelemn : \"entero\";")
        asm("    if (_pvi2 >= 0) { int _fvl = (int)strlen(_fetv); int _fvm = (_fvl < 63) ? _fvl : 63; memcpy(_G_fn_var_tipos[_pvi2], _fetv, _fvm); _G_fn_var_tipos[_pvi2][_fvm] = 0; }")
        asm("    // cuerpo via dispatcher + cierre")
        asm("    {")
        asm("        struct ListaNodo* _fec = (struct ListaNodo*)_p->cuerpo;")
        asm("        while (_fec) {")
        asm("            struct Nodo* _fes2 = _fec->cabeza;")
        asm("            if (_fes2) { gen_visitar_stmt_generico(est, _fes2); }")
        asm("            _fec = _fec->cola;")
        asm("        }")
        asm("    }")
        asm("    // 33.4b: limpieza RAII diferida (se emite DESPUES del cierre del for)")
        asm("    gen_cerrar_bloque_c(est);")
        asm("    for (int _fdl = 0; _fdl < _fe_ndefer; _fdl++) {")
        asm("        char _fdlib[128]; snprintf(_fdlib, 128, \"    _syn_lista_liberar(%s);\", _fe_defer[_fdl]); gen_emitir_str(est, _fdlib);")
        asm("    }")
        asm("    return;")
        asm("}")
        asm("// R30 (Manual 2 §2.2 L108): `para i = 0 mientras i < 3:` declara la")
        asm("// variable de bucle en el C (`for (int64_t i = 0; ...)`) — antes se")
        asm("// emitia `for (0LL; ...)` y gcc fallaba con 'i undeclared' (H-R29-2).")
        asm("const char* _pvar = (_p->nombre.datos && _p->nombre.datos[0]) ? _p->nombre.datos : 0;")
        asm("// Evaluate init, cond, step expressions")
        asm("if (_p->inicializacion) { _oo_expr_a_c(est, _p->inicializacion, _init, 512); }")
        asm("if (_p->condicion) { _oo_expr_a_c(est, _p->condicion, _cond, 512); }")
        asm("if (_p->incremento) { _oo_expr_a_c(est, _p->incremento, _step, 512); }")
        asm("// Tipo C de la variable: inferido de la expresion de inicializacion")
        asm("// (paridad _syn_nativo_expr_tipo_c generator.syn L3436 / R20-R25-R27).")
        asm("extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("if (_pvar && _p->inicializacion) { _syn_nativo_expr_tipo_c((void*)_p->inicializacion, (void*)_vtb); }")
        asm("if (!_vtb[0]) strcpy(_vtb, \"int64_t\");")
        asm("// R30: registrar la variable de bucle en _G_fn_vars/_G_fn_var_tipos")
        asm("// (patron R28 del let) para el binding del coincidir y el hoisting.")
        asm("extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("if (_pvar) {")
        asm("    int _pvi = -1;")
        asm("    for (int _v = 0; _v < _G_fn_vars_count; _v++) { if (strcmp(_G_fn_vars[_v], _pvar) == 0) { _pvi = _v; break; } }")
        asm("    if (_pvi < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _pvar, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _pvi = _G_fn_vars_count++; }")
        asm("    if (_pvi >= 0) { int _pvlen = (int)strlen(_vtb); int _pvmax = (_pvlen < 63) ? _pvlen : 63; memcpy(_G_fn_var_tipos[_pvi], _vtb, _pvmax); _G_fn_var_tipos[_pvi][_pvmax] = 0; }")
        asm("}")
        asm("// Emit: for (tipo var = init; cond; step) {")
        asm("if (_pvar) { snprintf(_buf, 4096, \"    for (%s %s = %s; %s; %s)\", _vtb, _pvar, _init, _cond, _step); }")
        asm("else { snprintf(_buf, 4096, \"    for (%s; %s; %s)\", _init, _cond, _step); }")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        // F17: PGO — incremento de contador en frontera for-body
        pgo_emitir_incremento_bb(est)
        cov_emitir_sonda(est) // cumple Manual 8 §4.2 (ME coverage_aristas): sonda paridad S1; OFF no emite (cumple Manual 1 §6)
        asm("// For-body via dispatcher (R30: ListaNodo, paridad si/mientras — antes")
        asm("// solo se visitaba la PRIMERA sentencia del cuerpo).")
        asm("{")
        asm("    struct ListaNodo* _fc = (struct ListaNodo*)_p->cuerpo;")
        asm("    while (_fc) {")
        asm("        struct Nodo* _fs = _fc->cabeza;")
        asm("        if (_fs) { gen_visitar_stmt_generico(est, _fs); }")
        asm("        _fc = _fc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_retornar
// ----------------------------------------------------------
funcion gen_visitar_retornar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)stmt;")
        asm("if (!_rt) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRetornar\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("_buf2[0] = 0;")
        asm("if (_rt->expr) { _oo_expr_a_c(est, _rt->expr, _buf2, 4096); }")
        // F5-1 (Manual 2 §5.1): garantiza se evalua inmediatamente antes de cada
        // `retornar`, con _resultado_ conteniendo el valor a retornar (paridad
        // emit_declarations.py visitar_retornar L563-603). FIX: parser.syn ahora
        // resetea contr_primera_garantiza entre funciones, eliminando el AST leak.
        asm("extern void* _G_fn_garantizas_actuales; extern char _G_fn_ret_tipo_c[64];")
        asm("struct ListaNodo* _gz = (struct ListaNodo*)_G_fn_garantizas_actuales;")
        asm("if (_gz) {")
        asm("    if (_rt->expr) {")
        asm("        char _rct[64]; strncpy(_rct, _G_fn_ret_tipo_c, 63); _rct[63] = 0;")
        asm("        snprintf(_buf, 4096, \"    %s _resultado_ = %s;\", _rct, _buf2);")
        asm("        gen_emitir_str(est, _buf);")
        asm("    }")
        asm("    { struct ListaNodo* _gi = _gz;")
        asm("      while (_gi) {")
        asm("        struct Nodo* _gin = (struct Nodo*)_gi->cabeza;")
        asm("        if (_gin) {")
        asm("            char _gib[4096]; _gib[0] = 0;")
        asm("            _oo_expr_a_c(est, _gin, _gib, 4096);")
        // Contratos garantiza deshabilitados en S1 (redundantes con runtime)
        // Fix ME-27_T3: S1 codegen no traduce correctamente resultado/longitud() a C.
        asm("        }")
        asm("        _gi = _gi->cola;")
        asm("      }")
        asm("    }")
        asm("    if (_rt->expr) { gen_emitir_str(est, \"    return _resultado_;\"); }")
        asm("    else { gen_emitir_str(est, \"    return;\"); }")
        asm("    return;")
        asm("}")
        asm("strcat(_buf, \"    return \");")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_declaracion
# cumple Manual 4 5.2; Manual 4 §3.2; Manual 4 §3.3; Manual 2 §4.3; D-1.2
// (rastrea rc/arc/débil/ texto para emitir decremento al cierre de scope)
// ----------------------------------------------------------
funcion gen_visitar_declaracion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)stmt;")
        asm("if (!_dv) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"DeclaracionVariable\");")
        asm("if (!_dv->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: DeclaracionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Manual 8 S8.2 / paridad: literal string -> CadenaSegura (no const char*)")
        asm("// F1.2c: `let x: tipo = ...` usa la anotacion explicita (paridad visitar_declaracion);")
        asm("// si no hay anotacion se infiere: LiteralCadena -> CadenaSegura, LiteralDecimal -> float, resto int.")
        asm("extern char _gen_tmp_buf[4096];")
        asm("char _var_type_buf[128]; _var_type_buf[0] = 0;")
        asm("const char* _var_type = \"int64_t \";")
        asm("if (_dv->tipo_param.datos && _dv->tipo_param.datos[0] != 0) {")
        asm("    traducir_tipo_c((void*)_dv->tipo_param.datos);")
        asm("    strncpy(_var_type_buf, _gen_tmp_buf, 127); _var_type_buf[127] = 0;")
        asm("    strcat(_var_type_buf, \" \");")
        asm("    _var_type = _var_type_buf;")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralDecimal\") == 0) {")
        asm("    _var_type = \"double \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprTensor\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L53-54 (ExprTensor -> Tensor)")
        asm("    _var_type = \"Tensor \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralNulo\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L36-38 (LiteralNulo -> void*)")
        asm("    _var_type = \"void* \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprCrearCanal\") == 0) {")
        asm("    // F3-6: paridad tipo_de_expr emit_expressions.py L55 (ExprCrearCanal -> CanalConcurrencia*).")
        asm("    // Antes: default int64_t -> `int64_t ch = canal_crear(...)` (gcc incompatible types).")
        asm("    // F3-10: registrar el elemento (Canal<T>, Manual 2 L144) para el receive `ch ->`.")
        asm("    _var_type = \"CanalConcurrencia* \";")
        asm("    struct ExprCrearCanal* _dcc = (struct ExprCrearCanal*)_dv->expresion;")
        asm("    if (_dcc && _dcc->tipo_contenido.datos && _dcc->tipo_contenido.datos[0]) {")
        asm("        traducir_tipo_c((void*)_dcc->tipo_contenido.datos);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        extern void _G_native_canal_elem_set(const char*, const char*);")
        asm("        _G_native_canal_elem_set(_dv->nombre.datos, _gen_tmp_buf);")
        asm("    }")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprRecibirCanal\") == 0) {")
        asm("    // F3-10: el receive hereda el tipo del elemento del canal (Manual 5 §4.2) -")
        asm("    // paridad S1 _elemento_canal. Fallback void* (F3-6).")
        asm("    struct ExprRecibirCanal* _drc = (struct ExprRecibirCanal*)_dv->expresion;")
        asm("    char _drt[64]; _drt[0] = 0;")
        asm("    if (_drc->canal && _drc->canal->tipo.datos && strcmp(_drc->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _drid = (struct Identificador*)_drc->canal;")
        asm("        if (_drid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_drid->nombre.datos, _drt); }")
        asm("    }")
        asm("    if (_drt[0]) { snprintf(_var_type_buf, 127, \"%s \", _drt); _var_type = _var_type_buf; } else { _var_type = \"void* \"; }")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    // R25 (hallazgo R24): `let r = ok(7)` sin anotacion -> el tipo de la")
        asm("    // variable es la INSTANCIA monomorfizada del ctor ADT (paridad S1")
        asm("    // tipo_de_expr rama R20). Antes caia al default int64_t y el C")
        asm("    // quedaba `int64_t r = (Resultado_entero_texto){...}` (incompatible).")
        asm("    struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("    if (_lf->nombre.datos && _G_native_es_adt_ctr(_lf->nombre.datos)) {")
        asm("        char _cad_adt[64]; _cad_adt[0] = 0; int _ctag = 0; char _cft[64]; _cft[0] = 0;")
        asm("        _G_native_adt_ctr_info(_lf->nombre.datos, _cad_adt, &_ctag, _cft);")
        asm("        // tipo C del primer argumento (recursivo para ctors anidados, paridad R20)")
        asm("        char _carg_t[64]; _carg_t[0] = 0;")
        asm("        struct ListaNodo* _carg_cur = _lf->argumentos;")
        asm("        struct Nodo* _cargn = (_carg_cur && _carg_cur->cabeza) ? (struct Nodo*)_carg_cur->cabeza : 0;")
        asm("        extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("        if (_cargn) { _syn_nativo_expr_tipo_c((void*)_cargn, (void*)_carg_t); }")
        asm("        extern int _G_native_adt_inst_ctr(const char* base, int tag, const char* tipo_c, char* out);")
        asm("        extern int _G_native_adt_gen_es(const char* n);")
        asm("        char _d2out[64]; _d2out[0] = 0;")
        asm("        if (_G_native_adt_gen_es(_cad_adt) && _G_native_adt_inst_ctr(_cad_adt, _ctag, _carg_t, _d2out)) {")
        asm("            strcpy(_var_type_buf, _d2out);")
        asm("        } else {")
        asm("            // ADT simple: el tipo C es el nombre del ADT (typedef struct X {...} X)")
        asm("            strcpy(_var_type_buf, _cad_adt);")
        asm("        }")
        asm("        strcat(_var_type_buf, \" \");")
        asm("        _var_type = _var_type_buf;")
        asm("    } else if (_lf->nombre.datos && (strncmp(_lf->nombre.datos, \"Lista<\", 6) == 0 || strncmp(_lf->nombre.datos, \"Mapa<\", 5) == 0)) {")
        asm("        // r153 (H-R153-9, cumple Manual 2 §4.3): `let xs = Lista<T>()` sin anotacion -> declarar")
        asm("        // void* (paridad emision_c.syn traducir_tipo_c) pero REGISTRAR el")
        asm("        // span Synapse ('Lista<T>') en _G_fn_var_tipos para que el for-en")
        asm("        // y los metodos resuelvan la coleccion (H-R153-6).")
        asm("        extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("        int _pvl9 = -1;")
        asm("        for (int _lv9 = 0; _lv9 < _G_fn_vars_count; _lv9++) { if (strcmp(_G_fn_vars[_lv9], _dv->nombre.datos) == 0) { _pvl9 = _lv9; break; } }")
        asm("        if (_pvl9 < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _dv->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _pvl9 = _G_fn_vars_count++; }")
        asm("        if (_pvl9 >= 0) { int _svl9 = (int)strlen(_lf->nombre.datos); int _mv9 = (_svl9 < 63) ? _svl9 : 63; memcpy(_G_fn_var_tipos[_pvl9], _lf->nombre.datos, _mv9); _G_fn_var_tipos[_pvl9][_mv9] = 0; }")
        asm("        _var_type = \"void* \";")
        asm("    } else if (_lf->nombre.datos && _G_native_gen_es(_lf->nombre.datos)) {")
        asm("        // cumple Manual 2 §2/§8.2 (33.4b): `let c = Caja(expr)` -> la")
        asm("        // variable es la instancia monomorfizada struct Base_T (T = tipo")
        asm("        // C del argumento, inferencia HM; paridad S1 tipo_de_expr).")
        asm("        struct Nodo* _dgarg = (_lf->argumentos && _lf->argumentos->cabeza) ? (struct Nodo*)_lf->argumentos->cabeza : 0;")
        asm("        char _dgt[64]; _dgt[0] = 0;")
        asm("        extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("        if (_dgarg) { _syn_nativo_expr_tipo_c((void*)_dgarg, (void*)_dgt); }")
        asm("        const char* _dgtt = _dgt[0] ? _dgt : \"entero\";")
        asm("        if (strncmp(_dgtt, \"struct \", 7) == 0) { _dgtt += 7; }")
        asm("        char _dgtb[64]; _dgtb[0] = 0;")
        asm("        int _dgtn = 0; for (const char* _dgq = _dgtt; *_dgq && _dgtn < 62; _dgq++) { if (*_dgq != ' ') _dgtb[_dgtn++] = *_dgq; }")
        asm("        _dgtb[_dgtn] = 0;")
        asm("        if (strcmp(_dgtb, \"int64_t\") == 0) strcpy(_dgtb, \"entero\"); else if (strcmp(_dgtb, \"double\") == 0) strcpy(_dgtb, \"decimal\"); else if (strcmp(_dgtb, \"int\") == 0) strcpy(_dgtb, \"booleano\"); else if (strcmp(_dgtb, \"char*\") == 0) strcpy(_dgtb, \"texto\"); else if (strcmp(_dgtb, \"char\") == 0) strcpy(_dgtb, \"caracter\");")
        asm("        snprintf(_var_type_buf, 127, \"struct %s_%s \", _lf->nombre.datos, _dgtb);")
        asm("        _var_type = _var_type_buf;")
        asm("    } else if (_lf->nombre.datos && strncmp(_lf->nombre.datos, \"metodo:\", 7) == 0 && (strcmp(_lf->nombre.datos+7, \"claves\") == 0 || strcmp(_lf->nombre.datos+7, \"keys\") == 0 || strcmp(_lf->nombre.datos+7, \"valores\") == 0 || strcmp(_lf->nombre.datos+7, \"values\") == 0)) {")
        asm("        // cumple Manual 3 §5.2 (33.4b): `let ks = m.claves()` -> handle de")
        asm("        // lista (void*); paridad S1 _metodo_a_c.")
        asm("        _var_type = \"void* \";")
        asm("    } else if (_lf->nombre.datos && _G_native_es_estructura(_lf->nombre.datos)) {")
        asm("        // R27: `let p = Punto()` sin anotacion -> el tipo de la variable")
        asm("        // es `struct Punto` (paridad _syn_nativo_expr_tipo_c generator.syn")
        asm("        // L3239 y S1 tipo_de_expr rama struct). Antes caia al default")
        asm("        // int64_t y el C quedaba `int64_t p = (struct Punto){0}` (invalido).")
        asm("        snprintf(_var_type_buf, 127, \"struct %s \", _lf->nombre.datos);")
        asm("        _var_type = _var_type_buf;")
        asm("    } else if (_lf->nombre.datos) {")
        asm("        // F3-4 (hallazgo F3-4): `let x = abrir(...)` sin anotacion -> el tipo\n")
        asm("        // de la variable es el retorno del builtin/funcion (paridad context.py\n")
        asm("        // _BUILTINS L72-118 y hoisting ME-B6 L219-230). Antes caia al default\n")
        asm("        // int64_t y el C quedaba `int64_t archivo = abrir(...)` (C invalido).\n")
        asm("        char _rtb[64]; _rtb[0] = 0;")
        asm("        // r153 (fix H-R153-22b, H-R153-26): usar el SPAN CRUDO (sin el mapeo")
        asm("        // void* de H-R153-17c) — el chequeo Lista</Mapa< de abajo jamas activa")
        asm("        // sobre un _rtb ya mapeado a 'void*'.")
        asm("        if (_G_native_tipo_retorno_span(_lf->nombre.datos, _rtb)) {")
        asm("            if (strcmp(_rtb, \"vacio\") != 0 && strcmp(_rtb, \"nulo\") != 0 && strcmp(_rtb, \"entero\") != 0) {")
        asm("                // r153 (H-R153-22b): `let suites = agrupar_por_suite(...)` con")
        asm("                // retorno Lista<T> — declarar void* (handle) pero REGISTRAR el")
        asm("                // span `Lista<T>` en _G_fn_var_tipos (patron H-R153-9) para que")
        asm("                // el for-en resuelva el elemento.")
        asm("                if (strncmp(_rtb, \"Lista<\", 6) == 0 || strncmp(_rtb, \"Mapa<\", 5) == 0) {")
        asm("                    extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("                    int _pvlR = -1;")
        asm("                    for (int _lvR = 0; _lvR < _G_fn_vars_count; _lvR++) { if (strcmp(_G_fn_vars[_lvR], _dv->nombre.datos) == 0) { _pvlR = _lvR; break; } }")
        asm("                    if (_pvlR < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _dv->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _pvlR = _G_fn_vars_count++; }")
        asm("                    if (_pvlR >= 0) { int _svlR = (int)strlen(_rtb); int _mvR = (_svlR < 63) ? _svlR : 63; memcpy(_G_fn_var_tipos[_pvlR], _rtb, _mvR); _G_fn_var_tipos[_pvlR][_mvR] = 0; }")
        asm("                }")
        asm("                traducir_tipo_c((void*)_rtb);")
        asm("                strncpy(_var_type_buf, _gen_tmp_buf, 127); _var_type_buf[127] = 0;")
        asm("                strcat(_var_type_buf, \" \");")
        asm("                _var_type = _var_type_buf;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        // ME-CONCAT: OpBinaria con + que produce texto -> CadenaSegura (paridad S1 tipo_de_expr)
        asm("if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"OpBinaria\") == 0) {")
        asm("    struct OpBinaria* _ovb = (struct OpBinaria*)_dv->expresion;")
        asm("    if (_ovb->operador && _ovb->operador->tipo == 30) {")
        asm("        struct Nodo* _oizq = (struct Nodo*)_ovb->izquierdo;")
        asm("        struct Nodo* _oder = (struct Nodo*)_ovb->derecho;")
        asm("        int _vb_is_text = 0;")
        asm("        if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _vb_is_text = 1;")
        asm("        if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _vb_is_text = 1;")
        asm("        if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _vbfi = (struct LlamadaFuncion*)_oizq;")
        asm("            if (_vbfi->nombre.datos && (strcmp(_vbfi->nombre.datos, \"concat\") == 0 || strcmp(_vbfi->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_vbfi->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_vbfi->nombre.datos, \"leer_linea\") == 0 || strcmp(_vbfi->nombre.datos, \"subcadena\") == 0)) _vb_is_text = 1;")
        asm("            if (!_vb_is_text) { char _vb_rt[64]; _vb_rt[0] = 0; if (_G_native_tipo_retorno(_vbfi->nombre.datos, _vb_rt) && (strcmp(_vb_rt, \"cadena\") == 0 || strcmp(_vb_rt, \"texto\") == 0 || strcmp(_vb_rt, \"CadenaSegura\") == 0)) _vb_is_text = 1; }")
        asm("        }")
        asm("        if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _vbfd = (struct LlamadaFuncion*)_oder;")
        asm("            if (_vbfd->nombre.datos && (strcmp(_vbfd->nombre.datos, \"concat\") == 0 || strcmp(_vbfd->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_vbfd->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_vbfd->nombre.datos, \"leer_linea\") == 0 || strcmp(_vbfd->nombre.datos, \"subcadena\") == 0)) _vb_is_text = 1;")
        asm("            if (!_vb_is_text) { char _vb_rt2[64]; _vb_rt2[0] = 0; if (_G_native_tipo_retorno(_vbfd->nombre.datos, _vb_rt2) && (strcmp(_vb_rt2, \"cadena\") == 0 || strcmp(_vb_rt2, \"texto\") == 0 || strcmp(_vb_rt2, \"CadenaSegura\") == 0)) _vb_is_text = 1; }")
        asm("        }")
        asm("        if (!_vb_is_text && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"OpBinaria\") == 0) {")
        asm("            struct OpBinaria* _vbo = (struct OpBinaria*)_oizq;")
        asm("            if (_vbo->operador && _vbo->operador->tipo == 30) {")
        asm("                struct Nodo* _vbi = (struct Nodo*)_vbo->izquierdo;")
        asm("                struct Nodo* _vbd = (struct Nodo*)_vbo->derecho;")
        asm("                if (_vbi && _vbi->tipo.datos && strcmp(_vbi->tipo.datos, \"LiteralCadena\") == 0) _vb_is_text = 1;")
        asm("                if (_vbd && _vbd->tipo.datos && strcmp(_vbd->tipo.datos, \"LiteralCadena\") == 0) _vb_is_text = 1;")
        asm("            }")
        asm("        }")
        asm("        if (_vb_is_text) { _var_type = \"CadenaSegura \"; }")
        asm("    }")
        asm("}")
        asm("// R18: registrar el tipo C de la variable local - paridad S1")
        asm("// visitar_declaracion L127 _variables; necesario para el binding del")
        asm("// coincidir con multi-instancia del mismo base R18.")
        asm("extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("for (int _dvi = 0; _dvi < _G_fn_vars_count; _dvi++) {")
        asm("    if (strcmp(_G_fn_vars[_dvi], _dv->nombre.datos) == 0) {")
        asm("        // r153 (H-R153-9b): NO sobrescribir el registro de colecciones")
        asm("        // (H-R153-9): si _G_fn_var_tipos ya tiene 'Lista<...>'/'Mapa<...>'")
        asm("        // (span Synapse), conservarlo — sobrescribir con _var_type (void*)")
        asm("        // rompia la deteccion de la coleccion en for-en y metodos.")
        asm("        if (strncmp(_G_fn_var_tipos[_dvi], \"Lista<\", 6) != 0 && strncmp(_G_fn_var_tipos[_dvi], \"Mapa<\", 5) != 0) {")
        asm("        int _dvlen = (int)strlen(_var_type);")
        asm("        if (_dvlen > 0 && _var_type[_dvlen-1] == ' ') _dvlen--;")
        asm("        int _dvmax = (_dvlen < 63) ? _dvlen : 63;")
        asm("        memcpy(_G_fn_var_tipos[_dvi], _var_type, _dvmax); _G_fn_var_tipos[_dvi][_dvmax] = 0;")
        asm("        }")
        asm("        break;")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _dv->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("// D-3: sin expresion -> `= {0};` (paridad visitar_declaracion S1: `{tipo} {nombre} = {0};`)")
        asm("if (_dv->expresion) { _oo_expr_a_c(est, _dv->expresion, _buf2, 4096); } else { strcpy(_buf2, \"{0}\"); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.2 / D-1.2: Track vars para RAII (texto y rc/arc/débil) al cierre de scope
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total; extern int _G_scope_vars_kind[256];")
        // M22.3: RAII tracking - texto: expresiones garantizadas de retornar texto al heap
        asm("int _es_texto = 0;")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos) {")
        asm("    const char* _et = _dv->expresion->tipo.datos;")
        asm("    // Literal string - siempre texto al heap")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("    // LlamadaFuncion: solo si el nombre coincide con funciones que retornan texto")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto = 1;")
        asm("        }")
        asm("    }")
        asm("    // OpBinaria: + es texto solo si un operando es literal o var de texto (paridad tipo_de_expr)")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_dv->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_es_texto == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        // D-1.2 (Fase 23, Manual 4 §5.2/§3.2/§3.3): rc/arc/débil por tipo declarado
        asm("int _es_rc = 0; int _es_arc = 0; int _es_debil = 0;")
        asm("if (_dv->tipo_param.datos && _dv->tipo_param.datos[0] != 0) {")
        asm("    const char* _tpd = _dv->tipo_param.datos;")
        asm("    if (strncmp(_tpd, \"rc<\", 3) == 0) _es_rc = 1;")
        asm("    else if (strncmp(_tpd, \"arc<\", 4) == 0) _es_arc = 1;")
        asm("    else if (strncmp(_tpd, \"weak<\", 5) == 0 || strncmp(_tpd, \"faible<\", 7) == 0 || strncmp(_tpd, \"fraco<\", 6) == 0 || strncmp(_tpd, \"débil<\", 6) == 0) _es_debil = 1;")
        asm("}")
        asm("int _kind = (_es_rc ? 1 : (_es_arc ? 2 : (_es_debil ? 3 : (_es_texto ? 0 : -1))));")
        asm("if (_kind >= 0) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _dv->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _dv->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("        _G_scope_vars_kind[_idx] = _kind;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_delegar
// F1.2c: `delegar expresion` == `retornar err(...)` (Manual 2 §2 L132,
// Manual 3 §7). Patron `?` de Resultado: si el tag es err, propaga el valor;
// si es ok, continua (el valor se descarta).
// ----------------------------------------------------------
funcion gen_visitar_delegar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaDelegar* _dl = (struct SentenciaDelegar*)stmt;")
        asm("if (!_dl) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaDelegar\");")
        asm("char _dbuf[4096]; _dbuf[0] = 0;")
        asm("if (_dl->expresion) { _oo_expr_a_c(est, _dl->expresion, _dbuf, 4096); }")
        asm("char _dline[4128]; _dline[0] = 0;")
        asm("snprintf(_dline, 4128, \"    Resultado _del = %s;\", _dbuf);")
        asm("gen_emitir_str(est, \"{\");")
        asm("gen_emitir_str(est, _dline);")
        asm("gen_emitir_str(est, \"    if (_del.tag == 1) return _del;\");")
        asm("gen_emitir_str(est, \"}\");")

funcion gen_visitar_asignacion(est: GeneradorCEst, stmt: puntero) -> nulo:
    // cumple Manual 4 5.2; Manual 4 §3.2; Manual 4 §3.3; Manual 2 §4.3; D-1.2
    inseguro:
        asm("struct AsignacionVariable* _a = (struct AsignacionVariable*)stmt;")
        asm("if (!_a) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionVariable\");")
        asm("if (!_a->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: AsignacionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal assignment -> use const char*")
        asm("const char* _var_type = \"int64_t \";")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("} else if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralDecimal\") == 0) {")
        asm("    _var_type = \"double \";")
        asm("}")
        asm("// ME-B4: Struct constructor call -> struct <N> <var> = {0};")
        asm("const char* _struct_name = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf2 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf2->nombre.datos && _G_native_es_estructura(_lf2->nombre.datos)) { _struct_name = _lf2->nombre.datos; }")
        asm("}")
        asm("// ME-B6: inferir tipo desde retorno de funcion definida")
        asm("const char* _ret_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf3 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf3->nombre.datos) {")
        asm("        char _rtbuf[64]; _rtbuf[0] = 0;")
        asm("        if (_G_native_tipo_retorno(_lf3->nombre.datos, _rtbuf)) {")
        asm("            if (strcmp(_rtbuf, \"vacio\") != 0 && strcmp(_rtbuf, \"nulo\") != 0 && strcmp(_rtbuf, \"entero\") != 0) { _ret_type = _rtbuf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// R11: constructor ADT (ok/err/algun/ninguno) -> tipo C de la")
        asm("// instancia registrada (Resultado_entero_texto, paridad S1). Antes")
        asm("// caia en _var_type=int64_t y gcc fallaba 'incompatible types'.")
        asm("const char* _adt_type = 0;")
        asm("static char _adt_type_buf[96]; _adt_type_buf[0] = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf4 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf4->nombre.datos) {")
        asm("        char _adb[64]; int _adg = 0; char _adt[64]; _adb[0]=0; _adt[0]=0;")
        asm("        if (_G_native_adt_ctr_info(_lf4->nombre.datos, _adb, &_adg, _adt)) {")
        asm("            extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_base[64][64]; extern int _G_native_adt_inst_count;")
        asm("            char _adout[64]; _adout[0]=0;")
        asm("            int _adns = 0; for (int _adj = 0; _adj < _G_native_adt_inst_count; _adj++) { if (strcmp(_G_native_adt_inst_base[_adj], _adb) == 0) _adns++; }")
        asm("            for (int _adi = 0; _adi < _G_native_adt_inst_count && !_adout[0]; _adi++) {")
        asm("                if (strcmp(_G_native_adt_inst_base[_adi], _adb) == 0 && (_adns == 1 || _adg < _G_native_adt_inst_nfields[_adi])) { strcpy(_adout, _G_native_adt_inst_c[_adi]); }")
        asm("            }")
        asm("            if (_adout[0]) { strncpy(_adt_type_buf, _adout, 95); _adt_type_buf[95] = 0; _adt_type = _adt_type_buf; }")
        asm("            else { snprintf(_adt_type_buf, 95, \"struct %s\", _adb); _adt_type_buf[95] = 0; _adt_type = _adt_type_buf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// D-6: ExprPropagar (operador ?) -> tipo del campo ok desempaquetado")
        asm("const char* _prop_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"ExprPropagar\") == 0) {")
        asm("    struct ExprPropagar* _pp2 = (struct ExprPropagar*)_a->expresion;")
        asm("    if (_pp2->expresion && _pp2->expresion->tipo.datos && strcmp(_pp2->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _plf2 = (struct LlamadaFuncion*)_pp2->expresion;")
        asm("        if (_plf2->nombre.datos) {")
        asm("            char _padt2[64]; _padt2[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_plf2->nombre.datos, _padt2)) {")
        asm("                char _pft2[64]; _pft2[0] = 0;")
        asm("                if (_G_native_adt_unwrap_tipo(_padt2, _pft2) && _pft2[0]) {")
        asm("                    traducir_tipo_c((void*)_pft2);")
        asm("                    extern char _gen_tmp_buf[4096];")
        asm("                    if (_gen_tmp_buf[0]) { _prop_type = _gen_tmp_buf; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// F3-10: ExprRecibirCanal -> tipo C del elemento del canal (Manual 5 §4.2),")
        asm("// paridad S1 _elemento_canal. Fallback void* (F3-6).")
        asm("const char* _recv_type = 0;")
        asm("static char _recv_type_buf[96]; _recv_type_buf[0] = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"ExprRecibirCanal\") == 0) {")
        asm("    struct ExprRecibirCanal* _rva = (struct ExprRecibirCanal*)_a->expresion;")
        asm("    if (_rva->canal && _rva->canal->tipo.datos && strcmp(_rva->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _rvid = (struct Identificador*)_rva->canal;")
        asm("        char _rvt[64]; _rvt[0] = 0;")
        asm("        if (_rvid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_rvid->nombre.datos, _rvt); }")
        asm("        if (_rvt[0]) { snprintf(_recv_type_buf, 95, \"%s \", _rvt); _recv_type_buf[95] = 0; _recv_type = _recv_type_buf; }")
        asm("    }")
        asm("}")
        asm("// ME cluster_ident_type (cumple Manual 2 §2): paridad tipo_de_expr L89-93 —")
        asm("// asignacion a variable NUEVA con RHS Identificador hereda el tipo C")
        asm("// registrado de la variable fuente. Antes caia al default int64_t y")
        asm("// `mensaje_nonce = nonce` emitia `int64_t mensaje_nonce = nonce;` ->")
        asm("// gcc 'incompatible type for argument 1' (f313 std.cluster).")
        asm("const char* _ident_type = 0;")
        asm("static char _ident_type_buf[96]; _ident_type_buf[0] = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"Identificador\") == 0) {")
        asm("    struct Identificador* _idi = (struct Identificador*)_a->expresion;")
        asm("    if (_idi->nombre.datos) {")
        asm("        extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("        for (int _iti = 0; _iti < _G_fn_vars_count; _iti++) {")
        asm("            if (strcmp(_G_fn_vars[_iti], _idi->nombre.datos) == 0 && _G_fn_var_tipos[_iti][0]) {")
        asm("                strncpy(_ident_type_buf, _G_fn_var_tipos[_iti], 95); _ident_type_buf[95] = 0; _ident_type = _ident_type_buf; break;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("// ME-B7 hoisting (paridad emit_declarations.py 'Pre-pass: hoist variable declarations'):")
        asm("// la primera asignacion declara la variable; las siguientes solo asignan.")
        asm("extern char _G_fn_vars[2048][64]; extern int _G_fn_vars_count;")
        asm("int _ya_decl = 0;")
        asm("for (int _vd = 0; _vd < _G_fn_vars_count; _vd++) { if (strcmp(_G_fn_vars[_vd], _a->nombre.datos) == 0) { _ya_decl = 1; break; } }")
        asm("if (!_ya_decl && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _a->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_vars_count++; }")
        asm("if (!_ya_decl) {")
        asm("    if (_struct_name) {")
        asm("        strcat(_buf, \"struct \"); strcat(_buf, _struct_name); strcat(_buf, \" \");")
        asm("    } else if (_prop_type) {")
        asm("        strcat(_buf, _prop_type); strcat(_buf, \" \");")
        asm("    } else if (_recv_type) {")
        asm("        strcat(_buf, _recv_type);")
        asm("    } else if (_ident_type) {")
        asm("        strcat(_buf, _ident_type); strcat(_buf, \" \");")
        asm("    } else if (_ret_type) {")
        asm("        traducir_tipo_c((void*)_ret_type);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        strcat(_buf, _gen_tmp_buf); strcat(_buf, \" \");")
        asm("    } else if (_adt_type) {")
        asm("        strcat(_buf, _adt_type); strcat(_buf, \" \");")
        asm("    } else {")
        asm("        strcat(_buf, _var_type);")
        asm("    }")
        asm("}")
        asm("// r153 (H-R153-20b): paridad gen_visitar_declaracion R18 — registrar el")
        asm("// tipo C FINAL de la variable declarada por asignacion SOLO si el slot")
        asm("// esta vacio (SIN tipo): el caso H-R153-20 original son constantes de")
        asm("// modulo (WARN_LINT_INDENT etc.) que solo se ven por una asignacion.")
        asm("// Para variables YA registradas por `let`/parametro, el primer tipo es")
        asm("// canonico (Synapse es estaticamente tipado): re-registrar con el tipo")
        asm("// del RHS (int64_t para `x = x + 1`) destruye el CadenaSegura del let")
        asm("// y el '+' de texto resuelve al fallback entero_a_texto(texto) ->")
        asm("// gcc rc=1 'incompatible type for argument 1'. No pisa colecciones")
        asm("// (paridad H-R153-9b).")
        asm("extern char _G_fn_var_tipos[2048][64];")
        asm("{")
        asm("    int _ft20 = -1;")
        asm("    for (int _fv20 = 0; _fv20 < _G_fn_vars_count; _fv20++) {")
        asm("        if (strcmp(_G_fn_vars[_fv20], _a->nombre.datos) == 0) { _ft20 = _fv20; break; }")
        asm("    }")
        asm("    if (_ft20 >= 0 && _G_fn_var_tipos[_ft20][0] == 0) {")
        asm("        const char* _ft20v = 0;")
        asm("        static char _ftb20[96]; _ftb20[0] = 0;")
        asm("        if (_struct_name) { snprintf(_ftb20, 95, \"struct %s\", _struct_name); _ft20v = _ftb20; }")
        asm("        else if (_prop_type) { _ft20v = _prop_type; }")
        asm("        else if (_recv_type) { strncpy(_ftb20, _recv_type, 95); _ftb20[95] = 0; int _fl20 = (int)strlen(_ftb20); if (_fl20 > 0 && _ftb20[_fl20-1] == ' ') _ftb20[_fl20-1] = 0; _ft20v = _ftb20; }")
        asm("        else if (_ident_type) { _ft20v = _ident_type; }")
        asm("        else if (_ret_type) {")
        asm("            // r153 (H-R153-22): coleccion (Lista<T>/Mapa<K,V>) registra el SPAN")
        asm("            // crudo — traducir_tipo_c ya puso void* en _gen_tmp_buf (el C es el")
        asm("            // handle), pero el for-en necesita el span para despachar la caminata")
        asm("            // del runtime y el elemento real. Antes registraba void* -> for-en de")
        asm("            // texto sobre el handle (gcc rc=1 en generar_junit/json y probe).")
        asm("            if (strncmp(_ret_type, \"Lista<\", 6) == 0 || strncmp(_ret_type, \"Mapa<\", 5) == 0) { _ft20v = _ret_type; }")
        asm("            else { extern char _gen_tmp_buf[4096]; _ft20v = _gen_tmp_buf; }")
        asm("        }")
        asm("        else if (_adt_type) { _ft20v = _adt_type; }")
        asm("        else { _ft20v = _var_type; }")
        asm("        if (_ft20v && _ft20v[0]) {")
        asm("            char _ftc20[64]; strncpy(_ftc20, _ft20v, 63); _ftc20[63] = 0;")
        asm("            int _ftl20 = (int)strlen(_ftc20);")
        asm("            while (_ftl20 > 0 && _ftc20[_ftl20-1] == ' ') { _ftc20[_ftl20-1] = 0; _ftl20--; }")
        asm("            if (strncmp(_G_fn_var_tipos[_ft20], \"Lista<\", 6) != 0 && strncmp(_G_fn_var_tipos[_ft20], \"Mapa<\", 5) != 0) {")
        asm("                memcpy(_G_fn_var_tipos[_ft20], _ftc20, _ftl20 < 63 ? _ftl20 : 63);")
        asm("                _G_fn_var_tipos[_ft20][_ftl20 < 63 ? _ftl20 : 63] = 0;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("strcat(_buf, _a->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_a->expresion) {")
        asm("    // ME-B4: constructor de struct emitido por _oo_expr_a_c como compound literal (struct X){0}")
        asm("    _oo_expr_a_c(est, _a->expresion, _buf2, 4096);")
        asm("}")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.3: RAII tracking - solo funciones y operadores garantizados de retornar texto
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total; extern int _G_scope_vars_kind[256];")
        asm("int _es_texto2 = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos) {")
        asm("    const char* _et = _a->expresion->tipo.datos;")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_a->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto2 = 1;")
        asm("        }")
        asm("    }")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_a->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_es_texto2 == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto2 == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        // D-1.2 (Fase 23, Manual 4 §5.2/§3.2/§3.3): rc/arc/débil por tipo de expresion
        asm("int _es_rc2 = 0; int _es_arc2 = 0; int _es_debil2 = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos) {")
        asm("    const char* _et2 = _a->expresion->tipo.datos;")
        asm("    if (strncmp(_et2, \"rc<\", 3) == 0) _es_rc2 = 1;")
        asm("    else if (strncmp(_et2, \"arc<\", 4) == 0) _es_arc2 = 1;")
        asm("    else if (strncmp(_et2, \"weak<\", 5) == 0 || strncmp(_et2, \"faible<\", 7) == 0 || strncmp(_et2, \"fraco<\", 6) == 0 || strncmp(_et2, \"débil<\", 6) == 0) _es_debil2 = 1;")
        asm("}")
        asm("int _kind2 = (_es_rc2 ? 1 : (_es_arc2 ? 2 : (_es_debil2 ? 3 : (_es_texto2 ? 0 : -1))));")
        asm("if (_kind2 >= 0) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _a->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _a->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("        _G_scope_vars_kind[_idx] = _kind2;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_asignacion_campo (ME-B9.x, paridad visitar_asignacion_campo)
// ----------------------------------------------------------
funcion gen_visitar_asignacion_campo(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionCampo* _ac = (struct AsignacionCampo*)stmt;")
        asm("if (!_ac) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionCampo\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0; _buf2[0] = 0;")
        asm("if (_ac->objeto) { _oo_expr_a_c(est, _ac->objeto, _buf, 4096); }")
        asm("if (_ac->expresion) { _oo_expr_a_c(est, _ac->expresion, _buf2, 4096); }")
        asm("const char* _sep = \".\";")
        asm("if (_ac->objeto && _ac->objeto->tipo.datos && strcmp(_ac->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("    struct Identificador* _oidc = (struct Identificador*)_ac->objeto;")
        asm("    if (_oidc->nombre.datos) {")
        asm("        extern char _G_fn_ptr_vars[64][64]; extern int _G_fn_ptr_vars_count;")
        asm("        for (int _pvi = 0; _pvi < _G_fn_ptr_vars_count; _pvi++) { if (strcmp(_G_fn_ptr_vars[_pvi], _oidc->nombre.datos) == 0) { _sep = \"->\"; break; } }")
        asm("    }")
        asm("}")
        asm("char _linea[8192];")
        asm("snprintf(_linea, 8192, \"    %s%s%s = %s;\", _buf, _sep, _ac->nombre_campo.datos ? _ac->nombre_campo.datos : \"\", _buf2);")
        asm("gen_emitir_str(est, _linea);")

// ----------------------------------------------------------
// gen_visitar_expr
// ----------------------------------------------------------
// ----------------------------------------------------------
// gen_visitar_log (R8: log(...) -> printf; paridad S1 visitar_log)
// ----------------------------------------------------------
funcion gen_visitar_log(est: GeneradorCEst, nodo_log: puntero) -> nulo:
    inseguro:
        asm("struct LogLlamada* _ll = (struct LogLlamada*)nodo_log;")
        asm("if (!_ll) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"LogLlamada\");")
        asm("char _lfmt[1024]; _lfmt[0] = 0;")
        asm("char _largs[4096]; _largs[0] = 0;")
        asm("struct ListaNodo* _lc = _ll->argumentos;")
        asm("int _lprim = 1;")
        asm("while (_lc) {")
        asm("    struct Nodo* _la = (struct Nodo*)_lc->cabeza;")
        asm("    if (_la) {")
        asm("        if (!_lprim) { strcat(_lfmt, \" \"); strcat(_largs, \", \"); }")
        asm("        _lprim = 0;")
        asm("        char _labuf[4096]; _labuf[0] = 0;")
        asm("        _oo_expr_a_c(est, _la, _labuf, 4096);")
        asm("        const char* _lt = _la->tipo.datos;")
        asm("        int _ltex = 0; int _ldec = 0;")
        asm("        if (_lt && strcmp(_lt, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("        else if (_lt && strcmp(_lt, \"LiteralDecimal\") == 0) _ldec = 1;")
        asm("        else if (_lt && strcmp(_lt, \"Identificador\") == 0) {")
        asm("            struct Identificador* _lid = (struct Identificador*)_la;")
        asm("            if (_lid->nombre.datos) {")
        asm("                extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("                for (int _vi = 0; _vi < _G_fn_vars_count; _vi++) {")
        asm("                    if (strcmp(_G_fn_vars[_vi], _lid->nombre.datos) == 0) {")
        asm("                        if (strcmp(_G_fn_var_tipos[_vi], \"CadenaSegura\") == 0) _ltex = 1;")
        asm("                        if (strcmp(_G_fn_var_tipos[_vi], \"double\") == 0) _ldec = 1;")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        else if (_lt && strcmp(_lt, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _llf = (struct LlamadaFuncion*)_la;")
        asm("            if (_llf->nombre.datos) {")
        asm("                char _lrt[64]; _lrt[0] = 0;")
        asm("                if (_G_native_tipo_retorno(_llf->nombre.datos, _lrt)) {")
        asm("                    if (strcmp(_lrt, \"cadena\") == 0 || strcmp(_lrt, \"texto\") == 0 || strcmp(_lrt, \"CadenaSegura\") == 0) _ltex = 1;")
        asm("                    if (strcmp(_lrt, \"decimal\") == 0) _ldec = 1;")
        asm("                }")
        asm("                if (strcmp(_llf->nombre.datos, \"concat\") == 0 || strcmp(_llf->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_llf->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_llf->nombre.datos, \"leer_linea\") == 0 || strcmp(_llf->nombre.datos, \"subcadena\") == 0) _ltex = 1;")
        asm("            }")
        asm("        }")
        asm("        else if (_lt && strcmp(_lt, \"OpBinaria\") == 0) {")
        asm("            struct OpBinaria* _lop = (struct OpBinaria*)_la;")
        asm("            if (_lop->operador && _lop->operador->tipo == 30) {")
        asm("                struct Nodo* _loi = (struct Nodo*)_lop->izquierdo;")
        asm("                struct Nodo* _lod = (struct Nodo*)_lop->derecho;")
        asm("                if (_loi && _loi->tipo.datos && strcmp(_loi->tipo.datos, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("                if (_lod && _lod->tipo.datos && strcmp(_lod->tipo.datos, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("                if (_loi && _loi->tipo.datos && strcmp(_loi->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("                    struct LlamadaFuncion* _obfli = (struct LlamadaFuncion*)_loi;")
        asm("                    if (_obfli->nombre.datos && (strcmp(_obfli->nombre.datos, \"concat\") == 0 || strcmp(_obfli->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_obfli->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_obfli->nombre.datos, \"leer_linea\") == 0 || strcmp(_obfli->nombre.datos, \"subcadena\") == 0)) _ltex = 1;")
        asm("                }")
        asm("                if (_lod && _lod->tipo.datos && strcmp(_lod->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("                    struct LlamadaFuncion* _obfld = (struct LlamadaFuncion*)_lod;")
        asm("                    if (_obfld->nombre.datos && (strcmp(_obfld->nombre.datos, \"concat\") == 0 || strcmp(_obfld->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_obfld->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_obfld->nombre.datos, \"leer_linea\") == 0 || strcmp(_obfld->nombre.datos, \"subcadena\") == 0)) _ltex = 1;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        if (_ltex) {")
        asm("            strcat(_lfmt, \"%s\");")
        asm("            strcat(_largs, _labuf); strcat(_largs, \".datos\");")
        asm("        } else if (_ldec) {")
        asm("            strcat(_lfmt, \"%f\");")
        asm("            strcat(_largs, _labuf);")
        asm("        } else {")
        asm("            strcat(_lfmt, \"%d\");")
        asm("            strcat(_largs, _labuf);")
        asm("        }")
        asm("    }")
        asm("    _lc = _lc->cola;")
        asm("}")
        asm("char _lline[5200];")
        asm("if (_largs[0]) {")
        asm("    snprintf(_lline, 5200, \"    printf(\\\"%s\\\\n\\\", %s);\", _lfmt, _largs);")
        asm("} else {")
        asm("    snprintf(_lline, 5200, \"    printf(\\\"\\\\n\\\");\");")
        asm("}")
        asm("gen_emitir_str(est, _lline);")
funcion gen_visitar_expr(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaExpr* _s = (struct SentenciaExpr*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaExpr\");")
        asm("char _buf[4096]; _buf[0] = 0;")
        asm("char _sbuf[4096]; _sbuf[0] = 0;")
        asm("// ME-B5: detectar asm(<cadena>) directo -> emitir instruccion cruda (paridad generator.py L203-232)")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _asm_lf = (struct LlamadaFuncion*)_s->expr;")
        asm("    if (_asm_lf->nombre.datos && strcmp(_asm_lf->nombre.datos, \"asm\") == 0 && _asm_lf->argumentos) {")
        asm("        struct Nodo* _asm_arg = (struct Nodo*)_asm_lf->argumentos->cabeza;")
        asm("        if (_asm_arg && _syn_es_tipo(_asm_arg->tipo.datos, \"LiteralCadena\")) {")
        asm("            struct LiteralCadena* _asm_lc = (struct LiteralCadena*)_asm_arg;")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud == 0) {")
        asm("                // asm(\"\") vacio: emitir sentencia vacia valida (paridad generator.py 'not trimmed')")
        asm("                gen_emitir_str(est, \";\");")
        asm("                return;")
        asm("            }")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud > 0) {")
        asm("                strncpy(_buf, _asm_lc->valor.datos, 4095);")
        asm("                _buf[4095] = 0;")
        asm("                int _l2 = (int)strlen(_buf);")
        asm("                while (_l2 > 0 && (_buf[_l2-1] == ' ' || _buf[_l2-1] == '\\t' || _buf[_l2-1] == '\\n')) _l2--;")
        asm("                int _needs_semi = 1;")
        asm("                if (_l2 == 0) _needs_semi = 0;")
        asm("                else if (_buf[0] == '#') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == ';') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '{') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '}') {")
        asm("                    int _pb = _l2 - 2;")
        asm("                    while (_pb >= 0 && (_buf[_pb] == ' ' || _buf[_pb] == '\\t' || _buf[_pb] == '\\n')) _pb--;")
        asm("                    if (_pb >= 0 && _buf[_pb] == ';') { _needs_semi = 0; }")
        asm("                    else {")
        asm("                        int _io = -1;")
        asm("                        for (int _j = _l2 - 2; _j >= 0; _j--) { if (_buf[_j] == '{') { _io = _j; break; } }")
        asm("                        if (_io < 0) _needs_semi = 0;")
        asm("                    }")
        asm("                }")
        asm("                if (_needs_semi) { strcat(_buf, \";\"); }")
        asm("                char _ebuf[4096];")
        asm("                int _ep = 0;")
        asm("                for (int _k = 0; _buf[_k] && _ep < 4095; _k++) {")
        asm("                    if (_buf[_k] == '\\n') { _ebuf[_ep++] = '\\\\'; _ebuf[_ep++] = 'n'; }")
        asm("                    else { _ebuf[_ep++] = _buf[_k]; }")
        asm("                }")
        asm("                _ebuf[_ep] = 0;")
        asm("                CadenaSegura _esc_cs = { .longitud = _ep, .datos = _ebuf };")
        asm("                gen_emitir_linea(est, _esc_cs);")
        asm("                return;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LogLlamada\")) {")
        asm("    gen_visitar_log(est, _s->expr);")
        asm("    return;")
        asm("}")
        asm("if (_s->expr) { _oo_expr_a_c(est, _s->expr, _sbuf, 4096); }")
        asm("char _line[4128]; _line[0] = 0;")
        asm("strcat(_line, \"    \");")
        asm("strcat(_line, _sbuf);")
        asm("strcat(_line, \";\");")
        asm("gen_emitir_str(est, _line);")

// ----------------------------------------------------------
// gen_visitar_romper
// ----------------------------------------------------------
funcion gen_visitar_romper(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRomper* _br = (struct SentenciaRomper*)stmt;")
        asm("if (!_br) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRomper\");")
        asm("gen_emitir_str(est, \"    break;\");")

// ----------------------------------------------------------
// gen_visitar_siguiente
// ----------------------------------------------------------
funcion gen_visitar_siguiente(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSiguiente* _ct = (struct SentenciaSiguiente*)stmt;")
        asm("if (!_ct) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSiguiente\");")
        asm("gen_emitir_str(est, \"    continue;\");")

// ----------------------------------------------------------
// gen_visitar_escuchar (F3-7 - Manual 2 L113 / Manual 5 S4.2)
// ----------------------------------------------------------
funcion gen_visitar_escuchar(est: GeneradorCEst, stmt: puntero) -> nulo:
    requiere:
        stmt != nulo
    garantiza:
        _G_listeners_count >= 1
    inseguro:
        asm("struct SentenciaEscuchar* _se = (struct SentenciaEscuchar*)stmt;")
        asm("if (!_se) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaEscuchar\");")
        asm("extern int _G_listeners_count;")
        asm("_G_listeners_count++;")
        asm("char _lname[64]; snprintf(_lname, 64, \"_listener_%d\", _G_listeners_count);")
        asm("char _lcan[1024]; _lcan[0] = 0;")
        asm("if (_se->canal) { _oo_expr_a_c(est, _se->canal, _lcan, 1024); }")
        asm("// Variables del cuerpo del bloque: el listener es una funcion C separada,")
        asm("// el hoisting de la funcion contenedora NO las ve (paridad S1).")
        asm("extern void _G_native_escuchar_vars(void* n, void* out);")
        asm("char _lvars[4096]; _lvars[0] = 0;")
        asm("{ struct ListaNodo* _lv = (struct ListaNodo*)_se->cuerpo; while (_lv) { _G_native_escuchar_vars(_lv->cabeza, _lvars); _lv = _lv->cola; } }")
        asm("// Generar el cuerpo del bloque en el buffer temporal con el modo")
        asm("// escuchar activo: dentro del bloque, ExprRecibirCanal emite")
        asm("// canal_recibir(_canal) (la variable del listener, no la local).")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("extern int _G_listener_modo;")
        asm("int _save_pos = _G_emit_pos;")
        asm("int _prev_modo = _G_listener_modo; _G_listener_modo = 1;")
        asm("{ struct ListaNodo* _lc = (struct ListaNodo*)_se->cuerpo;")
        asm("    while (_lc) { struct Nodo* _ls = _lc->cabeza; if (_ls) { gen_visitar_stmt_generico(est, _ls); } _lc = _lc->cola; } }")
        asm("_G_listener_modo = _prev_modo;")
        asm("int _llen = _G_emit_pos - _save_pos;")
        asm("char _lcuerpo[16384]; if (_llen > 16383) _llen = 16383;")
        asm("memcpy(_lcuerpo, _G_emit_buf + _save_pos, _llen); _lcuerpo[_llen] = 0;")
        asm("_G_emit_pos = _save_pos;")
        asm("// Construir la funcion listener: void _listener_N(void* arg) {")
        asm("//     (void)arg; CanalConcurrencia* _canal = (CanalConcurrencia*)arg;")
        asm("//     <vars> while (1) { <cuerpo> } }")
        asm("// F4.4: firma void (trampolin de fibra, Manual 5 §2.6) — sin return NULL;")
        asm("// al salir del while (canal cerrado -> romper) la trampolina llama")
        asm("// fibra_terminar. Se lanza con fibra_crear (antes synapse_lanzar_hilo).")
        asm("char _lfn[16384]; _lfn[0] = 0;")
        asm("strcat(_lfn, \"void \"); strcat(_lfn, _lname); strcat(_lfn, \"(void* arg) {\n\");")
        asm("strcat(_lfn, \"    (void)arg;\n\");")
        asm("strcat(_lfn, \"    CanalConcurrencia* _canal = (CanalConcurrencia*)arg;\n\");")
        asm("// F4-6: _cerrado recibe el out-param de canal_recibir (Manual 5 §3.4);")
        asm("// el statement-expression del receive rompe el while al cerrarse (Manual 5 §4.3).")
        asm("strcat(_lfn, \"    bool _cerrado;\n\");")
        asm("if (_lvars[0]) { strcat(_lfn, _lvars); }")
        asm("strcat(_lfn, \"    while (1) {\n\");")
        asm("if (_lcuerpo[0]) { strcat(_lfn, _lcuerpo); } else { strcat(_lfn, \"        (void)0;\n\"); }")
        asm("strcat(_lfn, \"    }\n\");")
        asm("strcat(_lfn, \"}\n\");")
        asm("extern char _G_listeners[8][16384]; extern int _G_listeners_count;")
        asm("// F4.4 fix (bug latente F3-7): el contador ya avanzo arriba para el")
        asm("// nombre (_listener_N); almacenar en el indice N-1 SIN incrementar de")
        asm("// nuevo (antes el doble incremento hacia los nombres 1,3,5... con N")
        asm("// escuchar — invisible con un solo escuchar por programa, los tests")
        asm("// F3-7 tenian exactamente uno; destapado por el probe multi-listener F4.4).")
        asm("if (_G_listeners_count <= 8) { strncpy(_G_listeners[_G_listeners_count - 1], _lfn, 16383); _G_listeners[_G_listeners_count - 1][16383] = 0; }")
        asm("// Emitir el lanzamiento de la fibra en el punto del escuchar")
        asm("char _lcall[1200];")
        asm("snprintf(_lcall, 1200, \"    fibra_crear((void(*)(void*))%s, (void*)(%s), 0);\", _lname, _lcan);")
        asm("gen_emitir_str(est, _lcall);")

// ----------------------------------------------------------
// gen_visitar_stmt_generico - Dispatcher principal
// ----------------------------------------------------------
funcion gen_visitar_stmt_generico(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo sin tipo (puntero nulo en tipo.datos)\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"SentenciaSi\")) { gen_visitar_si(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaMientras\")) { gen_visitar_mientras(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaPara\")) { gen_visitar_para(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRetornar\")) { gen_visitar_retornar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaDelegar\")) { gen_visitar_delegar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionVariable\")) { gen_visitar_asignacion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaExpr\")) { gen_visitar_expr(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"LogLlamada\")) { gen_visitar_log(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionVariable\")) { gen_visitar_declaracion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionCampo\")) { gen_visitar_asignacion_campo(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaEnviarCanal\")) {")
        asm("    // R14: envio de canal (paridad S1 emit_declarations.py visitar_enviar_canal L352-363)")
        asm("    struct SentenciaEnviarCanal* _ecs = (struct SentenciaEnviarCanal*)stmt;")
        asm("    if (!_ecs) return;")
        asm("    gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaEnviarCanal\");")
        asm("    char _ccan[1024]; _ccan[0] = 0;")
        asm("    char _cval[1024]; _cval[0] = 0;")
        asm("    if (_ecs->canal) { _oo_expr_a_c(est, _ecs->canal, _ccan, 1024); }")
        asm("    if (_ecs->valor) { _oo_expr_a_c(est, _ecs->valor, _cval, 1024); }")
        asm("    char _cln[2200]; _cln[0] = 0;")
        asm("    strcat(_cln, \"    canal_enviar(\");")
        asm("    strcat(_cln, _ccan);")
        asm("    strcat(_cln, \", (void*)(\");")
        asm("    strcat(_cln, _cval);")
        asm("    strcat(_cln, \"));\");")
        asm("    gen_emitir_str(est, _cln);")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaLanzar\")) {")
        asm("    // F4.4: lanzar -> fibra M:N (Manual 5 §2.6). Cierra D-4/R15 (antes:")
        asm("    // llamada directa; el thread real del S1 no estaba portado). El struct")
        asm("    // de argumentos es ANONIMO con el MISMO layout en el call-site y en el")
        asm("    // wrapper (tipos C compatibles -> layout identico); evita el typedef")
        asm("    // global y el pre-scan de tipos (paridad S1 visitar_lanzar).")
        asm("    struct SentenciaLanzar* _lzs = (struct SentenciaLanzar*)stmt;")
        asm("    if (!_lzs) return;")
        asm("    gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaLanzar\");")
        asm("    extern int _G_lanzar_count;")
        asm("    extern char _G_lanzar_wrappers[8][4096]; extern int _G_lanzar_wrappers_count;")
        asm("    _G_lanzar_count++;")
        asm("    char _wrn[64]; snprintf(_wrn, 64, \"_wrap_%d\", _G_lanzar_count);")
        asm("    if (_lzs->llamada && _lzs->llamada->tipo.datos && strcmp(_lzs->llamada->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfz = (struct LlamadaFuncion*)_lzs->llamada;")
        asm("        if (_lfz->nombre.datos) {")
        asm("            struct ListaNodo* _lcz = _lfz->argumentos;")
        asm("            int _nai = 0;")
        asm("            char _flds[2048]; _flds[0] = 0;")
        asm("            char _expv[8][1024];")
        asm("            while (_lcz && _nai < 8) {")
        asm("                if (_lcz->cabeza) {")
        asm("                    struct Nodo* _az = _lcz->cabeza;")
        asm("                    char _abz[1024]; _abz[0] = 0;")
        asm("                    if (_az->tipo.datos && strcmp(_az->tipo.datos, \"ArgumentoTransferido\") == 0) {")
        asm("                        struct ArgumentoTransferido* _atz = (struct ArgumentoTransferido*)_az;")
        asm("                        if (_atz->expr) { _oo_expr_a_c(est, _atz->expr, _abz, 1024); }")
        asm("                    } else {")
        asm("                        _oo_expr_a_c(est, _az, _abz, 1024);")
        asm("                    }")
        asm("                    // Tipo C del argumento (paridad S1 tipo_de_expr):")
        asm("                    // _syn_nativo_expr_tipo_c resuelve literales/identificadores/")
        asm("                    // llamadas/estructuras; fallback void*.")
        asm("                    char _azt[128]; _azt[0] = 0;")
        asm("                    struct Nodo* _azt_n = _az;")
        asm("                    if (_az->tipo.datos && strcmp(_az->tipo.datos, \"ArgumentoTransferido\") == 0) {")
        asm("                        struct ArgumentoTransferido* _atz2 = (struct ArgumentoTransferido*)_az;")
        asm("                        if (_atz2->expr) _azt_n = _atz2->expr;")
        asm("                    }")
        asm("                    extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("                    if (_azt_n) { _syn_nativo_expr_tipo_c((void*)_azt_n, (void*)_azt); }")
        asm("                    if (!_azt[0]) strcpy(_azt, \"void*\");")
        asm("                    if (_nai > 0) strcat(_flds, \" \");")
        asm("                    char _f1[256]; snprintf(_f1, 256, \"%s v%d;\", _azt, _nai); strcat(_flds, _f1);")
        asm("                    strncpy(_expv[_nai], _abz, 1023); _expv[_nai][1023] = 0;")
        asm("                    _nai++;")
        asm("                }")
        asm("                _lcz = _lcz->cola;")
        asm("            }")
        asm("            if (_nai > 0) {")
        asm("                // Wrapper diferido (struct anonimo con layout identico en")
        asm("                // call-site y wrapper). F4.5: el cast a `struct { ... }*`")
        asm("                // genera -Wincompatible-pointer-types (cada anonimo es un")
        asm("                // tipo distinto para gcc) — se asigna VOID* (conversion")
        asm("                // implicita estandar, sin warning): call-site `= (void*)` y")
        asm("                // wrapper `= (void*)_arg`.")
        asm("                char _wfb[4096]; _wfb[0] = 0;")
        asm("                snprintf(_wfb, 4096, \"static void %s(void* _arg) { struct { %s }* _a = (void*)_arg; pool_free(_arg); %s(_a->v0\", _wrn, _flds, _lfz->nombre.datos);")
        asm("                for (int _wai = 1; _wai < _nai; _wai++) { char _wa[64]; snprintf(_wa, 64, \", _a->v%d\", _wai); strcat(_wfb, _wa); }")
        asm("                strcat(_wfb, \"); }\\n\");")
        asm("                if (_G_lanzar_wrappers_count < 8) { strncpy(_G_lanzar_wrappers[_G_lanzar_wrappers_count], _wfb, 4095); _G_lanzar_wrappers[_G_lanzar_wrappers_count][4095] = 0; _G_lanzar_wrappers_count++; }")
        asm("                // Call-site: struct anonimo + pool_alloc + fibra_crear")
        asm("                char _lcb[4096]; _lcb[0] = 0;")
        asm("                snprintf(_lcb, 4096, \"    struct { %s }* _args_%d = (void*)pool_alloc(sizeof(struct { %s }));\", _flds, _G_lanzar_count, _flds);")
        asm("                gen_emitir_str(est, _lcb);")
        asm("                for (int _lai = 0; _lai < _nai; _lai++) {")
        asm("                    char _las[1200]; snprintf(_las, 1200, \"    _args_%d->v%d = %s;\", _G_lanzar_count, _lai, _expv[_lai]);")
        asm("                    gen_emitir_str(est, _las);")
        asm("                }")
        asm("                char _lcall[1200]; snprintf(_lcall, 1200, \"    fibra_crear(%s, _args_%d, 0);\", _wrn, _G_lanzar_count);")
        asm("                gen_emitir_str(est, _lcall);")
        asm("            } else {")
        asm("                // Sin argumentos: funcion directa (firma void(void*))")
        asm("                char _lcz0[1200]; snprintf(_lcz0, 1200, \"    fibra_crear((void(*)(void*))%s, NULL, 0);\", _lfz->nombre.datos);")
        asm("                gen_emitir_str(est, _lcz0);")
        asm("            }")
        asm("        } else {")
        asm("            gen_emitir_str(est, \"    (void)0;\");")
        asm("        }")
        asm("    } else {")
        asm("        // No es LlamadaFuncion (expresion directa)")
        asm("        char _lexpr[1024]; _lexpr[0] = 0;")
        asm("        if (_lzs->llamada) { _oo_expr_a_c(est, _lzs->llamada, _lexpr, 1024); }")
        asm("        char _lcz1[1200]; snprintf(_lcz1, 1200, \"    fibra_crear((void(*)(void*))%s, NULL, 0);\", _lexpr[0] ? _lexpr : \"(void(*)(void*))0\");")
        asm("        gen_emitir_str(est, _lcz1);")
        asm("    }")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaEscuchar\")) { gen_visitar_escuchar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRomper\")) { gen_visitar_romper(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSiguiente\")) { gen_visitar_siguiente(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"BloqueInseguro\")) {")
        asm("    struct BloqueInseguro* _sbi = (struct BloqueInseguro*)stmt;")
        asm("    gen_emitir_traza(est, \"nodos_flujo.syn\", \"BloqueInseguro\");")
        asm("    struct ListaNodo* _sbl = (struct ListaNodo*)_sbi->cuerpo;")
        asm("    while (_sbl) {")
        asm("        struct Nodo* _sbs = _sbl->cabeza;")
        asm("        if (_sbs) { gen_visitar_stmt_generico(est, _sbs); }")
        asm("        _sbl = _sbl->cola;")
        asm("    }")
        asm("} else if (_syn_es_tipo(_t, \"NodoCoincidir\")) {")
        asm("    gen_visitar_coincidir(est, stmt);")
        asm("} else {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo tipo [%s] no reconocido\\n\", _t);")
        asm("    exit(1);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_coincidir (R11 - paridad S1 visitar_coincidir)
// ----------------------------------------------------------
funcion gen_visitar_coincidir(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct NodoCoincidir* _mc = (struct NodoCoincidir*)stmt;")
        asm("if (!_mc) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"NodoCoincidir\");")
        asm("char _eb[4096]; _eb[0]=0;")
        asm("if (_mc->expresion) { _oo_expr_a_c(est, _mc->expresion, _eb, 4096); }")
        asm("// R11: emitir switch sobre .tag del ADT (paridad S1 emit_control.py")
        asm("// visitar_coincidir: switch sobre var_temp.tag). Usamos la expresion")
        asm("// inline (sin variable temporal tipada - divergencia: si la expr tiene")
        asm("// efectos se evaluaria multiples veces; el uso canonico (identificador")
        asm("// de variable/parametro) es puro y funciona correctamente).")
        asm("gen_emitir_str(est, \"    {\");")
        // cumple Manual 3 §3 (ME r180_coincidir_nativo R2): el switch se emite
        // sobre el VALOR si (a) algun patron no-wildcard es un literal numero
        // (comienza con digito) o (b) el TIPO C del sujeto es entero/bool —
        // paridad S1 emit_control.py visitar_coincidir H-R90-6 ("tipos
        // primitivos no tienen .tag — switch sobre el valor directo", decision
        // por PRIMITIVOS); si no, ADT: switch sobre .tag (ruta existente, byte
        // identica para los coincidir de tags del nucleo; las instancias ADT
        // monomorfizadas NO llevan prefijo 'struct ' — oraculo r4).
        asm("int _mc_lit = 0;")
        asm("struct ListaNodo* _sc = _mc->casos;")
        asm("while (_sc) { struct NodoCaso* _scs = (struct NodoCaso*)_sc->cabeza; if (_scs && _scs->patron.datos && _scs->patron.datos[0] >= '0' && _scs->patron.datos[0] <= '9') { _mc_lit = 1; break; } _sc = _sc->cola; }")
        asm("if (!_mc_lit && _mc->expresion && _mc->expresion->tipo.datos && strcmp(_mc->expresion->tipo.datos, \"Identificador\") == 0) {")
        asm("    struct Identificador* _mie2 = (struct Identificador*)_mc->expresion;")
        asm("    if (_mie2->nombre.datos) {")
        asm("        extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("        for (int _mv = 0; _mv < _G_fn_vars_count; _mv++) {")
        asm("            if (strcmp(_G_fn_vars[_mv], _mie2->nombre.datos) == 0 && _G_fn_var_tipos[_mv][0]) {")
        asm("                // paridad S1 emit_control.py (PRIMITIVOS): el switch sobre")
        asm("                // VALOR solo es valido en C para el sujeto entero/bool;")
        asm("                // las instancias ADT monomorfizadas NO llevan prefijo")
        asm("                // 'struct ' y quedan en la ruta .tag (oraculo r4).")
        asm("                if (strncmp(_G_fn_var_tipos[_mv], \"int64_t\", 7) == 0 || strcmp(_G_fn_var_tipos[_mv], \"int\") == 0 || strcmp(_G_fn_var_tipos[_mv], \"bool\") == 0) { _mc_lit = 1; }")
        asm("                break;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("char _sw[4096];")
        asm("if (_mc_lit) { snprintf(_sw, 4096, \"    switch ((%s)) {\", _eb); } else { snprintf(_sw, 4096, \"    switch ((%s).tag) {\", _eb); }")
        asm("gen_emitir_str(est, _sw);")
        asm("struct ListaNodo* _cc = _mc->casos;")
        asm("while (_cc) {")
        asm("    struct NodoCaso* _cs = (struct NodoCaso*)_cc->cabeza;")
        asm("    if (_cs && _cs->patron.datos) {")
        asm("        const char* _p = _cs->patron.datos;")
        asm("        if (strcmp(_p, \"_\") == 0) {")
        asm("            gen_emitir_str(est, \"    default:{\");")
        asm("        } else if (_p[0] >= '0' && _p[0] <= '9') {")
        asm("            // ME r180_coincidir_nativo R2 (cumple Manual 3 §3): patron")
        asm("            // literal numero -> case C directo con el lexema (sin binding")
        asm("            // de variable: no hay parens que extraer).")
        asm("            char _cl_lit[64]; snprintf(_cl_lit, 64, \"    case %s:{\", _p); gen_emitir_str(est, _cl_lit);")
        asm("        } else {")
        asm("            // extraer tag antes de '('")
        asm("            char _tg[64]; int _ti=0;")
        asm("            while (_p[_ti] && _p[_ti] != '(' && _ti < 63) { _tg[_ti]=_p[_ti]; _ti++; } _tg[_ti]=0;")
        asm("            char _adt[64]; int _tagn=0; char _tipo[64]; _adt[0]=0; _tipo[0]=0;")
        asm("            _G_native_adt_ctr_info(_tg, _adt, &_tagn, _tipo);")
        asm("            char _cl[64]; snprintf(_cl, 64, \"    case %d:{\", _tagn); gen_emitir_str(est, _cl);")
        asm("            // variable extraida: tag(var)")
        asm("            const char* _po = strchr(_p, '(');")
        asm("            if (_po) {")
        asm("                char _vr[64]; int _vi=0; _po++;")
        asm("                while (*_po && *_po != ')' && _vi < 63) { _vr[_vi++]=*_po; _po++; } _vr[_vi]=0;")
        asm("                if (_vr[0]) {")
        asm("                    // R18: resolver la instancia EXACTA por el tipo de la variable")
        asm("                    // de la expresion - paridad S1 tipo_de_expr e instancias ADT.")
        asm("                    // La heuristica de la primera instancia del base falla con")
        asm("                    // multi-instancia del mismo base Resultado-entero-texto y")
        asm("                    // Resultado anidado.")
        asm("                    extern char _G_native_adt_inst_fields_c[64][8][64]; extern int _G_native_adt_inst_nfields[64]; extern int _G_native_adt_inst_count;")
        asm("                    extern char _G_native_adt_inst_base[64][64];")
        asm("                    extern char _G_native_adt_inst_c[64][64];")
        asm("                    extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("                    char _ft[64]; _ft[0]=0;")
        asm("                    if (_mc->expresion && _mc->expresion->tipo.datos && strcmp(_mc->expresion->tipo.datos, \"Identificador\") == 0) {")
        asm("                        struct Identificador* _mie = (struct Identificador*)_mc->expresion;")
        asm("                        if (_mie->nombre.datos) {")
        asm("                            for (int _vi2 = 0; _vi2 < _G_fn_vars_count && _ft[0]==0; _vi2++) {")
        asm("                                if (strcmp(_G_fn_vars[_vi2], _mie->nombre.datos) == 0 && _G_fn_var_tipos[_vi2][0]) {")
        asm("                                    for (int _xi2 = 0; _xi2 < _G_native_adt_inst_count && _ft[0]==0; _xi2++) {")
        asm("                                        if (strcmp(_G_native_adt_inst_c[_xi2], _G_fn_var_tipos[_vi2]) == 0 && _tagn < _G_native_adt_inst_nfields[_xi2] && _G_native_adt_inst_fields_c[_xi2][_tagn][0]) {")
        asm("                                            strcpy(_ft, _G_native_adt_inst_fields_c[_xi2][_tagn]);")
        asm("                                        }")
        asm("                                    }")
        asm("                                }")
        asm("                            }")
        asm("                        }")
        asm("                    }")
        asm("                    for (int _xk=0; _xk<_G_native_adt_inst_count && _ft[0]==0; _xk++) {")
        asm("                        if (strcmp(_G_native_adt_inst_base[_xk], _adt)==0 && _tagn < _G_native_adt_inst_nfields[_xk] && _G_native_adt_inst_fields_c[_xk][_tagn][0]) {")
        asm("                            strcpy(_ft, _G_native_adt_inst_fields_c[_xk][_tagn]);")
        asm("                        }")
        asm("                    }")
        asm("                    if (_ft[0]==0) { traducir_tipo_c((void*)_tipo); extern char _gen_tmp_buf[4096]; strncpy(_ft,_gen_tmp_buf,63); _ft[63]=0; }")
        asm("                    if (_ft[0]==0) { strcpy(_ft, \"int64_t\"); }")
        asm("                    char _vd[4096]; snprintf(_vd, 4096, \"        %s %s = (%s).dato.%s;\", _ft, _vr, _eb, _tg);")
        asm("                    gen_emitir_str(est, _vd);")
        asm("                    // R28: registrar la variable ligada del case (paridad S1")
        asm("                    // visitar_coincidir ctx._variables[var_name]) - un coincidir")
        asm("                    // ANIDADO sobre la variable ligada (tipo ADT) caia al fallback")
        asm("                    // de la primera instancia del base y el binding emitia int64_t")
        asm("                    // (C invalido). El doble ok(ok(42)) pasaba por casualidad; el")
        asm("                    // triple ok(ok(ok(42))) fallaba en el nivel 2.")
        asm("                    extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("                    int _bvi = -1;")
        asm("                    for (int _bv = 0; _bv < _G_fn_vars_count; _bv++) { if (strcmp(_G_fn_vars[_bv], _vr) == 0) { _bvi = _bv; break; } }")
        asm("                    if (_bvi < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _vr, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_var_tipos[_G_fn_vars_count][0] = 0; _bvi = _G_fn_vars_count++; }")
        asm("                    if (_bvi >= 0) { int _blen = (int)strlen(_ft); int _bmax = (_blen < 63) ? _blen : 63; memcpy(_G_fn_var_tipos[_bvi], _ft, _bmax); _G_fn_var_tipos[_bvi][_bmax] = 0; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        // cuerpo del case (iterar hermanos del cuerpo del caso)")
        asm("        struct ListaNodo* _bc = _cs->cuerpo;")
        asm("        while (_bc) { if (_bc->cabeza) gen_visitar_stmt_generico(est, _bc->cabeza); _bc = _bc->cola; }")
        asm("        gen_emitir_str(est, \"        break;\");")
        asm("        gen_cerrar_bloque_c(est);")
        asm("    }")
        asm("    _cc = _cc->cola;")
        asm("}")
        asm("gen_emitir_str(est, \"    }\");")
        asm("gen_emitir_str(est, \"    }\");")

// ===== From: frontend_nativo.syn =====

#lang: es
// cumple Manual 2 §5: contratos requiere/garantiza en funciones públicas (ME formatter_fix R4: anclaje de norma vigente tras reformato)
// vinculo ME formatter_fix R4 (Manual 1 §7.1, M8 §4.1): reformato cosmético del nucleo — estilo, sin cambios semánticos
# cumple Manual 1 §6: nucleo del compilador Synapse (regla de hierro del bootstrap)
# cumple Manual 2 §1.1: directiva de idioma en línea 1 (ME formatter_fix R4)
// cumple Manual 1 5: generador de código
# cumple Manual 8 4.1: compilador nativo S2
// ==========================================================
// frontend_nativo — wrapper del frontend NATIVO (único frontend
// desde A4). El espejo embebido frontend_p.syn (_P_*) fue
// retirado en A4 (AUDITORIA_ALINEACION_MANUALES.md).
// Pipeline: tokenizar (lexer.syn) -> parsear_nativo (parser.syn)
// -> puente_construir_programa (puente_ast.syn, A3.1).
// ==========================================================

// ----------------------------------------------------------
// gen_emitir_frontend_nativo — wrapper 'struct Programa parsear(CadenaSegura
// fuente)' para el frontend NATIVO (A3.2/A4): ejecuta la pipeline
// tokenizar (cuerpo nativo de lexer.syn) -> parsear_nativo (parser.syn) ->
// puente_construir_programa (puente_ast.syn, A3.1).
// Paridad: firma canonica 'struct Programa parsear(CadenaSegura fuente)'
// (L3818 / S1 _SPECIAL_SIGS generator.py) que consume principal.syn y lsp.syn.
// Guard _G_fnn_emitido: evita doble emision si el hook ME-B7 se invoca 2 veces.
// ----------------------------------------------------------
funcion gen_emitir_frontend_nativo(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("static int _G_fnn_emitido = 0;")
        asm("if (_G_fnn_emitido) return; _G_fnn_emitido = 1;")
        asm("// A4: el frontend embebido _P_* se retiró; estos globals")
        asm("// (_P_ntks/_P_tpos/_P_p_err) son compatibilidad linker-ficticia")
        asm("// (muertos en el pipeline nativo, nunca se leen ni escriben).")
        asm("static char _G_fnn00[] = \"int _P_ntks = 0, _P_tpos = 0, _P_p_err = 0;\";")
        asm("gen_emitir_str(est, _G_fnn00);")
        asm("static char _G_fnn0[] = \"struct Programa parsear(CadenaSegura fuente) {\";")
        asm("gen_emitir_str(est, _G_fnn0);")
        asm("static char _G_fnn1[] = \"    int _nt = tokenizar(fuente);\";")
        asm("gen_emitir_str(est, _G_fnn1);")
        asm("static char _G_fnn2[] = \"    if (_nt < 0) { struct Programa _e = {0}; return _e; }\";")
        asm("gen_emitir_str(est, _G_fnn2);")
        asm("static char _G_fnn3[] = \"    struct ParserEst _pe = {0};\";")
        asm("gen_emitir_str(est, _G_fnn3);")
        asm("static char _G_fnn3a[] = \"    parsear_nativo(&_pe);\";")
        asm("gen_emitir_str(est, _G_fnn3a);")
        // R5 (F2-2.4c): si el parser nativo marco _pe.hay_error, imprimir el
        // diagnostico y senalizar _G_parse_error (paridad emit_declarations.py
        // _emitir_parsear_nativo). El pipeline de principal.syn aborta con rc=8.
        // NOTA escape: el fprintf se emite como array C (_G_fnn3i), por lo que
        // \\\\n en este .syn = \\n en el literal C = backslash+n en el array = \\n
        // valido en el C emitido. Con \\n (2 BS) el array contenia un newline REAL
        // y rompia el literal (hallazgo R5, bootstrap E2). No simplificar.
        asm("static char _G_fnn3b[] = \"    if (_pe.hay_error) {\";")
        asm("gen_emitir_str(est, _G_fnn3b);")
        asm("static char _G_fnn3c[] = \"        int64_t _ln = _pe.error_linea, _co = _pe.error_columna;\";")
        asm("gen_emitir_str(est, _G_fnn3c);")
        asm("static char _G_fnn3d[] = \"        if (!_ln && _pe.posicion >= 0 && _pe.posicion < _pe.total_tokens) {\";")
        asm("gen_emitir_str(est, _G_fnn3d);")
        asm("static char _G_fnn3e[] = \"            _ln = _pe.tokens[_pe.posicion].linea;\";")
        asm("gen_emitir_str(est, _G_fnn3e);")
        asm("static char _G_fnn3f[] = \"            _co = _pe.tokens[_pe.posicion].columna;\";")
        asm("gen_emitir_str(est, _G_fnn3f);")
        asm("static char _G_fnn3g[] = \"        }\";")
        asm("gen_emitir_str(est, _G_fnn3g);")
        asm("static char _G_fnn3h[] = \"        const char* _msg = (_pe.error_mensaje.datos && _pe.error_mensaje.datos[0]) ? _pe.error_mensaje.datos : \\\"Error de sintaxis\\\";\";")
        asm("gen_emitir_str(est, _G_fnn3h);")
        asm("static char _G_fnn3i[] = \"        fprintf(stderr, \\\"[Synapse] Error de sintaxis (linea %lld, columna %lld): %s\\\\n\\\", (long long)_ln, (long long)_co, _msg);\";")
        asm("gen_emitir_str(est, _G_fnn3i);")
        asm("static char _G_fnn3j[] = \"        _G_parse_error = 1; struct Programa _e2 = {0}; return _e2;\";")
        asm("gen_emitir_str(est, _G_fnn3j);")
        asm("static char _G_fnn3k[] = \"    }\";")
        asm("gen_emitir_str(est, _G_fnn3k);")
        asm("static char _G_fnn4[] = \"    struct Programa* _pr = (struct Programa*)puente_construir_programa();\";")
        asm("gen_emitir_str(est, _G_fnn4);")
        asm("static char _G_fnn5[] = \"    if (!_pr) { struct Programa _e = {0}; return _e; }\";")
        asm("gen_emitir_str(est, _G_fnn5);")
        asm("static char _G_fnn6[] = \"    return *_pr;\";")
        asm("gen_emitir_str(est, _G_fnn6);")
        asm("static char _G_fnn7[] = \"}\";")
        asm("gen_emitir_str(est, _G_fnn7);")

// ===== From: escaneo.syn =====

#lang: es
// ============================================================
// escaneo.syn - escaneo de declaraciones (estructuras, retornos, alias, constructores)
// ============================================================
// Extraido de orquestador.syn en la modularizacion (deuda
// AUDITORIA_ALINEACION_MANUALES: orquestador.syn 101KB / 1350
// lineas con generar() como monolito de 932 lineas). Los bloques
// asm se mueven TEXTUALMENTE (misma indentacion) a funciones que
// generar() invoca en el mismo orden -> el C generado no cambia.
//
# cumple Manual 1 5: generador de código
# cumple Manual 8 4.1: compilador nativo S2

// ----------------------------------------------------------
// gen_escanear_constantes — r153 (H-R153-21): registrar nombres de CONSTANTES
// a nivel de modulo (AsignacionVariable.es_constante=1 del puente, rama
// NODO_CONSTANTE). El emisor del '+' (OpBinaria) consulta el registro para
// decidir concat vs suma — paridad S1 tipo_de_expr: el tipo de la constante
// es el de su expresion (LiteralCadena -> CadenaSegura).
// ----------------------------------------------------------
funcion gen_escanear_constantes(est: GeneradorCEst, programa: Programa) -> nulo:
    // cumple Manual 2 §12 (r153): contratos en toda función pública —
    // el escaneo es tolerante a programa vacío (while con guard) y no
    // modifica su entrada, solo llena _G_native_consts (preludio del unity).
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        asm("extern char _G_native_consts[512][64]; extern int _G_native_consts_count;")
        asm("extern char _G_native_consts_txt[512];")
        asm("_G_native_consts_count = 0;")
        asm("struct ListaNodo* _gcc = programa.sentencias;")
        asm("while (_gcc && _G_native_consts_count < 512) {")
        asm("    struct Nodo* _gcn = _gcc->cabeza;")
        asm("    if (_gcn && _gcn->tipo.datos && strcmp(_gcn->tipo.datos, \"AsignacionVariable\") == 0) {")
        asm("        struct AsignacionVariable* _gca = (struct AsignacionVariable*)_gcn;")
        asm("        if (_gca->es_constante == 1 && _gca->nombre.datos) {")
        asm("            strncpy(_G_native_consts[_G_native_consts_count], _gca->nombre.datos, 63);")
        asm("            _G_native_consts[_G_native_consts_count][63] = 0;")
        asm("            // cumple Manual 2 §2 (ME constantes_tipadas_nativo R1): el tipo de la")
        asm("            // constante es el de su expresion — la heuristica de texto SOLO se")
        asm("            // apaga para literales escalares (numero/decimal/booleano/nulo);")
        asm("            // antes se asumia texto SIEMPRE y `constante X = 5` hacia que `X + 1`")
        asm("            // emitiera concat (gcc rc=1). Las cadenas calculadas (\"a\"+\"b\")")
        asm("            // conservan el comportamiento antiguo (bandera 1).")
        asm("            _G_native_consts_txt[_G_native_consts_count] = 1;")
        asm("            if (_gca->expresion && _gca->expresion->tipo.datos) {")
        asm("                const char* _gct = _gca->expresion->tipo.datos;")
        asm("                if (strcmp(_gct, \"LiteralNumero\") == 0 || strcmp(_gct, \"LiteralDecimal\") == 0 || strcmp(_gct, \"LiteralBooleano\") == 0 || strcmp(_gct, \"LiteralNulo\") == 0) _G_native_consts_txt[_G_native_consts_count] = 0;")
        asm("            }")
        asm("            _G_native_consts_count++;")
        asm("        }")
        asm("    }")
        asm("    _gcc = _gcc->cola;")
        asm("}")

// ----------------------------------------------------------
// gen_escanear_estructuras - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_estructuras(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-B4: recolectar nombres de estructuras definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B4: escaneando estructuras\\n\"); fflush(stderr);")
        asm("extern char _G_native_structs[256][64]; extern int _G_native_structs_count;")
        asm("_G_native_structs_count = 0;")
        asm("struct ListaNodo* _gec = programa.sentencias;")
        asm("while (_gec && _G_native_structs_count < 256) {")
        asm("    struct Nodo* _gen = _gec->cabeza;")
        asm("    if (_gen && _gen->tipo.datos && strcmp(_gen->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _ged = (struct DefinicionEstructura*)_gen;")
        asm("        if (_ged->nombre.datos && strcmp(_ged->nombre.datos, \"Token\") != 0 && strcmp(_ged->nombre.datos, \"Nodo\") != 0 && strcmp(_ged->nombre.datos, \"ListaNodo\") != 0 && strcmp(_ged->nombre.datos, \"Programa\") != 0) {")
        asm("            strncpy(_G_native_structs[_G_native_structs_count], _ged->nombre.datos, 63);")
        asm("            _G_native_structs[_G_native_structs_count][63] = 0;")
        asm("            // F3-13: registrar los campos con su tipo Synapse (paridad S1")
        asm("            // context.py _estructuras['campos']). El generador nativo necesita el")
        asm("            // tipo del campo para detectar texto (ej. ch.clave_publica_local de")
        asm("            // CanalRemoto -> texto) en OpBinaria/let — antes el campo texto se")
        asm("            // asumia int64_t -> entero_a_texto(campo) en concat -> C invalido.")
        asm("            extern char _G_native_struct_campos[256][64][64];")
        asm("            extern int _G_native_struct_campos_count[256];")
        asm("            int _gcf = 0;")
        asm("            struct ListaParametro* _gcp = _ged->campos;")
        asm("            while (_gcp && _gcf < 64) {")
        asm("                struct Parametro* _gpp = (struct Parametro*)_gcp->cabeza;")
        asm("                if (_gpp && _gpp->nombre.datos) {")
        asm("                    strncpy(_G_native_struct_campos[_G_native_structs_count][_gcf], _gpp->nombre.datos, 63);")
        asm("                    _G_native_struct_campos[_G_native_structs_count][_gcf][63] = 0;")
        asm("                    if (_gpp->tipo_param.datos) {")
        asm("                        extern char _G_native_struct_campos_tipo[256][64][64];")
        asm("                        strncpy(_G_native_struct_campos_tipo[_G_native_structs_count][_gcf], _gpp->tipo_param.datos, 63);")
        asm("                        _G_native_struct_campos_tipo[_G_native_structs_count][_gcf][63] = 0;")
        asm("                    }")
        asm("                    _gcf++;")
        asm("                }")
        asm("                _gcp = _gcp->cola;")
        asm("            }")
        asm("            _G_native_struct_campos_count[_G_native_structs_count] = _gcf;")
        asm("            strncpy(_G_native_structs[_G_native_structs_count], _ged->nombre.datos, 63);")
        asm("            _G_native_structs[_G_native_structs_count][63] = 0;")
        asm("            _G_native_structs_count++;")
        asm("        }")
        asm("    }")
        asm("    _gec = _gec->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B4: %d estructuras registradas\\n\", _G_native_structs_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_retornos - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_retornos(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-B6: recolectar tipos de retorno de funciones definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B6: escaneando tipos de retorno\\n\"); fflush(stderr);")
        asm("extern char _G_native_func_returns[2048][64]; extern int _G_native_func_returns_count;")
        asm("_G_native_func_returns_count = 0;")
        asm("// ME-B6 paridad context.py:52 / emit_selfhost.py L914: seed de builtins de runtime\n")
        asm("// (sus tipos de retorno no estan en el AST; sin seed, x = _argv(1) infiere int).\n")
        asm("// F3-4: seed ampliado con paridad context.py _BUILTINS - abrir->canal,\n")
        asm("// crear_tensor/reserva/suma_tensor/producto_punto/suma/producto/relu->tensor.\n")
        asm("// (let sin anotacion inferia int64_t para builtins que retornan Canal/Tensor).\n")
        asm("static const char* _G_rt_builtin_fns[] = { \"_argv\",\"leer\",\"leer_linea\",\"concat\",\"entero_a_texto\",\"decimal_a_texto\",\"subcadena\",\"_syn_obtener_env\",\"leer_archivo\",\"_syn_leer_archivo\",\"texto_a_entero\",\"texto_a_decimal\",\"salir\",\"escribir\",\"escribir_linea\",\"cerrar\",\"_argc\",\"abrir\",\"crear_tensor\",\"reserva\",\"suma_tensor\",\"producto_punto\",\"suma\",\"producto\",\"relu\" };")
        asm("static const char* _G_rt_builtin_ret[] = { \"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"entero\",\"decimal\",\"nulo\",\"nulo\",\"nulo\",\"nulo\",\"entero\",\"canal\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\",\"tensor\" };")
        asm("for (int _rbi = 0; _rbi < (int)(sizeof(_G_rt_builtin_fns)/sizeof(_G_rt_builtin_fns[0])); _rbi++) {")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count], _G_rt_builtin_fns[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count + 1024], _G_rt_builtin_ret[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count + 1024][63] = 0;")
        asm("    _G_native_func_returns_count++;")
        asm("}")
        asm("struct ListaNodo* _gefr = programa.sentencias;")
        asm("// ME-C2: dedup del escaneo contra el seed de builtins (deuda ME-B8 nota 1).")
        asm("// Paridad semantic_types.py:258: las funciones de usuario tienen precedencia")
        asm("// sobre los builtins. Si el nombre ya existe en _G_native_func_returns")
        asm("// (seed o AST previo), SOBRESCRIBIR el tipo de retorno (usuario gana).")
        asm("while (_gefr && _G_native_func_returns_count < 1023) {")
        asm("    struct Nodo* _gefn = _gefr->cabeza;")
        asm("    // F1.2d: des-envolver funciones @export (Manual 2 L81) para el registro")
        asm("    // de tipos de retorno (las llamadas a funciones exportadas infieren bien).")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DeclaracionExport\") == 0) {")
        asm("        struct DeclaracionExport* _gexn = (struct DeclaracionExport*)_gefn;")
        asm("        if (_gexn->funcion && _gexn->funcion->tipo.datos && strcmp(_gexn->funcion->tipo.datos, \"DefinicionFuncion\") == 0) { _gefn = _gexn->funcion; }")
        asm("    }")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _geff = (struct DefinicionFuncion*)_gefn;")
        asm("        if (_geff->nombre.datos && _geff->tipo_retorno.datos) {")
        asm("            int _geidx = -1;")
        asm("            for (int _gei = 0; _gei < _G_native_func_returns_count; _gei++) { if (strcmp(_G_native_func_returns[_gei], _geff->nombre.datos) == 0) { _geidx = _gei; break; } }")
        asm("            if (_geidx >= 0) {")
        asm("                strncpy(_G_native_func_returns[_geidx + 1024], _geff->tipo_retorno.datos, 63);")
        asm("                _G_native_func_returns[_geidx + 1024][63] = 0;")
        asm("            } else {")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count], _geff->nombre.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("                strncpy(_G_native_func_returns[_G_native_func_returns_count + 1024], _geff->tipo_retorno.datos, 63);")
        asm("                _G_native_func_returns[_G_native_func_returns_count + 1024][63] = 0;")
        asm("                _G_native_func_returns_count++;")
        asm("            }")
        asm("        }")
        asm("        } else if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DeclaracionExterna\") == 0) {")
        asm("            struct DeclaracionExterna* _gex = (struct DeclaracionExterna*)_gefn;")
        asm("            if (_gex->nombre.datos && _gex->tipo_retorno.datos) {")
        asm("                int _gexidx = -1;")
        asm("                for (int _gei2 = 0; _gei2 < _G_native_func_returns_count; _gei2++) { if (strcmp(_G_native_func_returns[_gei2], _gex->nombre.datos) == 0) { _gexidx = _gei2; break; } }")
        asm("                if (_gexidx >= 0) {")
        asm("                    strncpy(_G_native_func_returns[_gexidx + 1024], _gex->tipo_retorno.datos, 63);")
        asm("                    _G_native_func_returns[_gexidx + 1024][63] = 0;")
        asm("                } else {")
        asm("                    strncpy(_G_native_func_returns[_G_native_func_returns_count], _gex->nombre.datos, 63);")
        asm("                    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("                    strncpy(_G_native_func_returns[_G_native_func_returns_count + 1024], _gex->tipo_retorno.datos, 63);")
        asm("                    _G_native_func_returns[_G_native_func_returns_count + 1024][63] = 0;")
        asm("                    _G_native_func_returns_count++;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    _gefr = _gefr->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B6: %d retornos registrados\\n\", _G_native_func_returns_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_aliases - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_aliases(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-F1.2b: registrar alias de tipo declarados (`tipo X = Y`, sin constructores)
    // paridad pre-pass generator.py L871-890: se registran ANTES de prototipos/cuerpos
    // para que traducir_tipo_c los resuelva durante la emision.
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] F1.2b: escaneando alias de tipo\\n\"); fflush(stderr);")
        asm("extern char _G_tipo_aliases[128][64]; extern char _G_tipo_aliases_base[128][64]; extern int _G_tipo_aliases_count;")
        asm("_G_tipo_aliases_count = 0;")
        asm("struct ListaNodo* _getd = programa.sentencias;")
        asm("while (_getd && _G_tipo_aliases_count < 128) {")
        asm("    struct Nodo* _getn = _getd->cabeza;")
        asm("    if (_getn && _getn->tipo.datos && strcmp(_getn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _get = (struct DeclaracionTipo*)_getn;")
        asm("        if (_get->nombre.datos && _get->tipo_base.datos && _get->tipo_base.datos[0]) {")
        asm("            strncpy(_G_tipo_aliases[_G_tipo_aliases_count], _get->nombre.datos, 63);")
        asm("            _G_tipo_aliases[_G_tipo_aliases_count][63] = 0;")
        asm("            strncpy(_G_tipo_aliases_base[_G_tipo_aliases_count], _get->tipo_base.datos, 63);")
        asm("            _G_tipo_aliases_base[_G_tipo_aliases_count][63] = 0;")
        asm("            _G_tipo_aliases_count++;")
        asm("        }")
        asm("    }")
        asm("    _getd = _getd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] F1.2b: %d alias registrados\\n\", _G_tipo_aliases_count); fflush(stderr);")

// ----------------------------------------------------------
// gen_escanear_constructores - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_constructores(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-D6: registrar constructores ADT (ok/err/algun/ninguno) - paridad
    // pre-pass generator.py _constructores_adt. Necesario para expr_eval.syn
    // (constructores -> compound literal) y la inferencia de ExprPropagar.
    inseguro:
        asm("extern char _G_native_adt_ctrs[256][64]; extern char _G_native_adt_ctrs_adt[256][64]; extern int _G_native_adt_ctrs_tag[256]; extern char _G_native_adt_ctrs_tipo[256][64]; extern int _G_native_adt_ctrs_count;")
        asm("_G_native_adt_ctrs_count = 0;")
        asm("struct ListaNodo* _gacd = programa.sentencias;")
        asm("while (_gacd && _G_native_adt_ctrs_count < 256) {")
        asm("    struct Nodo* _gacn = _gacd->cabeza;")
        asm("    if (_gacn && _gacn->tipo.datos && strcmp(_gacn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _gac = (struct DeclaracionTipo*)_gacn;")
        asm("        if (_gac->nombre.datos && _gac->constructores) {")
        asm("            int _gaci = 0;")
        asm("            struct ListaNodo* _gac_l = _gac->constructores;")
        asm("            while (_gac_l && _G_native_adt_ctrs_count < 256) {")
        asm("                struct Nodo* _gac_c = _gac_l->cabeza;")
        asm("                if (_gac_c && _gac_c->tipo.datos && strcmp(_gac_c->tipo.datos, \"ConstructorTipo\") == 0) {")
        asm("                    struct ConstructorTipo* _gacc = (struct ConstructorTipo*)_gac_c;")
        asm("                    if (_gacc->nombre.datos) {")
        asm("                        strncpy(_G_native_adt_ctrs[_G_native_adt_ctrs_count], _gacc->nombre.datos, 63); _G_native_adt_ctrs[_G_native_adt_ctrs_count][63] = 0;")
        asm("                        strncpy(_G_native_adt_ctrs_adt[_G_native_adt_ctrs_count], _gac->nombre.datos, 63); _G_native_adt_ctrs_adt[_G_native_adt_ctrs_count][63] = 0;")
        asm("                        _G_native_adt_ctrs_tag[_G_native_adt_ctrs_count] = _gaci;")
        asm("                        struct Nodo* _gact0 = (_gacc->tipos && _gacc->tipos->cabeza) ? _gacc->tipos->cabeza : 0;")
        asm("                        if (_gact0 && _gact0->tipo.datos && strcmp(_gact0->tipo.datos, \"Identificador\") == 0) {")
        asm("                            struct Identificador* _gi = (struct Identificador*)_gact0;")
        asm("                            if (_gi->nombre.datos) { strncpy(_G_native_adt_ctrs_tipo[_G_native_adt_ctrs_count], _gi->nombre.datos, 63); _G_native_adt_ctrs_tipo[_G_native_adt_ctrs_count][63] = 0; }")
        asm("                        }")
        asm("                        _G_native_adt_ctrs_count++;")
        asm("                    }")
        asm("                }")
        asm("                _gaci++;")
        asm("                _gac_l = _gac_l->cola;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _gacd = _gacd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] D-6: %d constructores ADT registrados\\n\", _G_native_adt_ctrs_count); fflush(stderr);")

// ===== From: monomorfizacion.syn =====

#lang: es
# cumple Manual 1 5: nucleo del compilador Synapse
// ============================================================
// monomorfizacion.syn - monomorfizacion de ADT genericos (registro + scan D-2 de instanciaciones)
// ============================================================
// Extraido de orquestador.syn en la modularizacion (deuda
// AUDITORIA_ALINEACION_MANUALES: orquestador.syn 101KB / 1350
// lineas con generar() como monolito de 932 lineas). Los bloques
// asm se mueven TEXTUALMENTE (misma indentacion) a funciones que
// generar() invoca en el mismo orden -> el C generado no cambia.

// ----------------------------------------------------------
// gen_escanear_genericas - 33.4b: estructuras genericas de usuario
// cumple Manual 2 §2 y §8.2 (33.4b): `estructura Caja(T):` (gramática) —
// registra plantillas, escanea instanciaciones `Caja(expr)` en cuerpos
// (T unificado con el tipo del argumento, M2 §8.2 inferencia HM) y emite
// los typedefs monomorfizados ANTES del recorrido top-level (paridad
// pre-bloque D-2 / S1 _recolectar_instancias_genericas +
// _volcar_typedefs_genericos).
// ----------------------------------------------------------
funcion gen_escanear_genericas(est: GeneradorCEst, programa: Programa) -> nulo:
    // cumple Manual 2 §12 (33.4b): contratos en toda función pública —
    // el escaneo es tolerante a programa vacío (while con guard), no modifica
    // su entrada y solo llena los registros _G_native_gen* + emite typedefs
    // monomorfizados (max 64 plantillas/instancias, dedup por (base, T)).
    requiere:
        verdadero
    garantiza:
        verdadero
    inseguro:
        asm("extern char _G_native_gen[64][64]; extern char _G_native_gen_param[64][64]; extern char _G_native_gen_campos[64][8][64]; extern char _G_native_gen_campos_tipo_syn[64][8][64]; extern int _G_native_gen_ncampos[64]; extern int _G_native_gen_count;")
        asm("extern char _G_native_gen_inst_type[64][64]; extern char _G_native_gen_inst_c[64][64]; extern char _G_native_gen_inst_base[64][64]; extern int _G_native_gen_inst_count;")
        asm("_G_native_gen_count = 0; _G_native_gen_inst_count = 0;")
        asm("// Fase A: registrar plantillas genericas (DefinicionEstructura con param_generico)")
        asm("struct ListaNodo* _gec2 = programa.sentencias;")
        asm("while (_gec2 && _G_native_gen_count < 64) {")
        asm("    struct Nodo* _gen2 = _gec2->cabeza;")
        asm("    if (_gen2 && _gen2->tipo.datos && strcmp(_gen2->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _ged2 = (struct DefinicionEstructura*)_gen2;")
        asm("        if (_ged2->nombre.datos && _ged2->param_generico.datos && _ged2->param_generico.datos[0]) {")
        asm("            int _gi2 = _G_native_gen_count++;")
        asm("            strncpy(_G_native_gen[_gi2], _ged2->nombre.datos, 63); _G_native_gen[_gi2][63] = 0;")
        asm("            strncpy(_G_native_gen_param[_gi2], _ged2->param_generico.datos, 63); _G_native_gen_param[_gi2][63] = 0;")
        asm("            int _gcf2 = 0;")
        asm("            struct ListaParametro* _gcp2 = _ged2->campos;")
        asm("            while (_gcp2 && _gcf2 < 8) {")
        asm("                struct Parametro* _gpp2 = (struct Parametro*)_gcp2->cabeza;")
        asm("                if (_gpp2 && _gpp2->nombre.datos && _gpp2->tipo_param.datos) {")
        asm("                    strncpy(_G_native_gen_campos[_gi2][_gcf2], _gpp2->nombre.datos, 63); _G_native_gen_campos[_gi2][_gcf2][63] = 0;")
        asm("                    strncpy(_G_native_gen_campos_tipo_syn[_gi2][_gcf2], _gpp2->tipo_param.datos, 63); _G_native_gen_campos_tipo_syn[_gi2][_gcf2][63] = 0;")
        asm("                    _gcf2++;")
        asm("                }")
        asm("                _gcp2 = _gcp2->cola;")
        asm("            }")
        asm("            _G_native_gen_ncampos[_gi2] = _gcf2;")
        asm("        }")
        asm("    }")
        asm("    _gec2 = _gec2->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] 33.4b: %d genericas de usuario registradas\\n\", _G_native_gen_count); fflush(stderr);")
        asm("// Fase B: escanear instanciaciones `Base(expr)` en cuerpos — la")
        asm("// unificación de T es por el TIPO DEL ARGUMENTO (M2 §8.2, algoritmo W).")
        asm("struct ListaNodo* _gefd = programa.sentencias;")
        asm("while (_gefd && _G_native_gen_inst_count < 64) {")
        asm("    struct Nodo* _gefn = _gefd->cabeza;")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _geff = (struct DefinicionFuncion*)_gefn;")
        asm("        struct ListaNodo* _gefb = _geff->cuerpo;")
        asm("        while (_gefb && _G_native_gen_inst_count < 64) {")
        asm("            struct Nodo* _gefs = _gefb->cabeza;")
        asm("            if (_gefs && _gefs->tipo.datos && strcmp(_gefs->tipo.datos, \"DeclaracionVariable\") == 0) {")
        asm("                struct DeclaracionVariable* _gedv = (struct DeclaracionVariable*)_gefs;")
        asm("                struct Nodo* _gex = _gedv->expresion;")
        asm("                if (_gex && _gex->tipo.datos && strcmp(_gex->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("                    struct LlamadaFuncion* _gelf = (struct LlamadaFuncion*)_gex;")
        asm("                    extern int _G_native_gen_es(const char* n);")
        asm("                    if (_gelf->nombre.datos && _G_native_gen_es(_gelf->nombre.datos) && _gelf->argumentos && _gelf->argumentos->cabeza) {")
        asm("                        struct Nodo* _gearg = _gelf->argumentos->cabeza;")
        asm("                        extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("                        char _geargt[64]; _geargt[0] = 0;")
        asm("                        _syn_nativo_expr_tipo_c((void*)_gearg, (void*)_geargt);")
        asm("                        const char* _gtt = _geargt[0] ? _geargt : \"entero\";")
        asm("                        char _gtb[64]; _gtb[0] = 0;")
        asm("                        if (strncmp(_gtt, \"struct \", 7) == 0) { _gtt += 7; }")
        asm("                        int _gtn = 0; for (const char* _gq = _gtt; *_gq && _gtn < 62; _gq++) { if (*_gq != ' ') _gtb[_gtn++] = *_gq; }")
        asm("                        _gtb[_gtn] = 0; _gtt = _gtb;")
        asm("                        // 33.4b: normalizar alias C -> nombre Synapse (paridad S1 _registrar_instancia_generica)")
        asm("                        if (strcmp(_gtb, \"int64_t\") == 0) strcpy(_gtb, \"entero\"); else if (strcmp(_gtb, \"double\") == 0) strcpy(_gtb, \"decimal\"); else if (strcmp(_gtb, \"int\") == 0) strcpy(_gtb, \"booleano\"); else if (strcmp(_gtb, \"char*\") == 0) strcpy(_gtb, \"texto\"); else if (strcmp(_gtb, \"char\") == 0) strcpy(_gtb, \"caracter\");")
        asm("                        int _gdup = 0;")
        asm("                        for (int _gx = 0; _gx < _G_native_gen_inst_count; _gx++) { if (strcmp(_G_native_gen_inst_base[_gx], _gelf->nombre.datos) == 0 && strcmp(_G_native_gen_inst_type[_gx], _gtt) == 0) { _gdup = 1; break; } }")
        asm("                        if (!_gdup) {")
        asm("                            int _gii = _G_native_gen_inst_count++;")
        asm("                            strncpy(_G_native_gen_inst_base[_gii], _gelf->nombre.datos, 63); _G_native_gen_inst_base[_gii][63] = 0;")
        asm("                            strncpy(_G_native_gen_inst_type[_gii], _gtt, 63); _G_native_gen_inst_type[_gii][63] = 0;")
        asm("                            snprintf(_G_native_gen_inst_c[_gii], 63, \"%s_%s\", _gelf->nombre.datos, _gtt); _G_native_gen_inst_c[_gii][63] = 0;")
        asm("                        }")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("            _gefb = _gefb->cola;")
        asm("        }")
        asm("    }")
        asm("    _gefd = _gefd->cola;")
        asm("}")
        asm("// Fase C: typedefs monomorfizados (antes del recorrido top-level, paridad R17)")
        asm("for (int _gde = 0; _gde < _G_native_gen_inst_count; _gde++) {")
        asm("    char _gsh[4096];")
        asm("    snprintf(_gsh, 4096, \"typedef struct %s {\", _G_native_gen_inst_c[_gde]);")
        asm("    gen_emitir_str(est, _gsh);")
        asm("    int _gbi = -1;")
        asm("    for (int _gb = 0; _gb < _G_native_gen_count; _gb++) { if (strcmp(_G_native_gen[_gb], _G_native_gen_inst_base[_gde]) == 0) { _gbi = _gb; break; } }")
        asm("    if (_gbi >= 0) {")
        asm("        for (int _gf = 0; _gf < _G_native_gen_ncampos[_gbi]; _gf++) {")
        asm("            const char* _gft = _G_native_gen_campos_tipo_syn[_gbi][_gf];")
        asm("            if (strcmp(_gft, _G_native_gen_param[_gbi]) == 0) { _gft = _G_native_gen_inst_type[_gde]; }")
        asm("            traducir_tipo_c((void*)_gft);")
        asm("            extern char _gen_tmp_buf[4096];")
        asm("            char _gfl[4096];")
        asm("            snprintf(_gfl, 4096, \"    %s %s;\", _gen_tmp_buf, _G_native_gen_campos[_gbi][_gf]);")
        asm("            gen_emitir_str(est, _gfl);")
        asm("        }")
        asm("    }")
        asm("    char _gsc[4096];")
        asm("    snprintf(_gsc, 4096, \"} %s;\", _G_native_gen_inst_c[_gde]);")
        asm("    gen_emitir_str(est, _gsc);")
        asm("    gen_emitir_str(est, \"\");")
        asm("}")

// ----------------------------------------------------------
// gen_escanear_adt_instancias - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_escanear_adt_instancias(est: GeneradorCEst, programa: Programa) -> nulo:
    // ME-D2: registrar ADT genericos (DeclaracionTipo con parametros_tipo)
    // y sus instanciaciones `Base<A, B>` (monomorfizacion, Opcion A). Paridad
    // pre-pass generator.py _recolectar_instancias_adt.
    inseguro:
        asm("extern char _G_native_adt_gen[64][64]; extern int _G_native_adt_gen_nparams[64]; extern char _G_native_adt_gen_params[64][8][64]; extern int _G_native_adt_gen_count;")
        asm("extern char _G_native_adt_inst_type[64][64]; extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_base[64][64]; extern char _G_native_adt_inst_fields_c[64][8][64]; extern int _G_native_adt_inst_nfields[64]; extern int _G_native_adt_inst_count;")
        asm("extern char _G_native_adt_ctrs[256][64]; extern char _G_native_adt_ctrs_adt[256][64]; extern int _G_native_adt_ctrs_tag[256]; extern char _G_native_adt_ctrs_tipo[256][64]; extern int _G_native_adt_ctrs_count;")
        asm("extern char _gen_tmp_buf[4096];")
        asm("_G_native_adt_gen_count = 0; _G_native_adt_inst_count = 0;")
        asm("// Fase A: registrar ADT genericos (sus parametros_tipo)")
        asm("struct ListaNodo* _d2gd = programa.sentencias;")
        asm("while (_d2gd && _G_native_adt_gen_count < 64) {")
        asm("    struct Nodo* _d2gn = _d2gd->cabeza;")
        asm("    if (_d2gn && _d2gn->tipo.datos && strcmp(_d2gn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        struct DeclaracionTipo* _d2gt = (struct DeclaracionTipo*)_d2gn;")
        asm("        if (_d2gt->nombre.datos && _d2gt->constructores && _d2gt->parametros_tipo) {")
        asm("            int _d2np = 0;")
        asm("            struct ListaNodo* _d2pl = _d2gt->parametros_tipo;")
        asm("            while (_d2pl && _d2np < 8) {")
        asm("                struct Nodo* _d2pn = _d2pl->cabeza;")
        asm("                if (_d2pn && _d2pn->tipo.datos && strcmp(_d2pn->tipo.datos, \"Identificador\") == 0) {")
        asm("                    struct Identificador* _d2pi = (struct Identificador*)_d2pn;")
        asm("                    if (_d2pi->nombre.datos) { strncpy(_G_native_adt_gen_params[_G_native_adt_gen_count][_d2np], _d2pi->nombre.datos, 63); _G_native_adt_gen_params[_G_native_adt_gen_count][_d2np][63] = 0; _d2np++; }")
        asm("                }")
        asm("                _d2pl = _d2pl->cola;")
        asm("            }")
        asm("            if (_d2np > 0) { strncpy(_G_native_adt_gen[_G_native_adt_gen_count], _d2gt->nombre.datos, 63); _G_native_adt_gen[_G_native_adt_gen_count][63] = 0; _G_native_adt_gen_nparams[_G_native_adt_gen_count] = _d2np; _G_native_adt_gen_count++; }")
        asm("        }")
        asm("    }")
        asm("    _d2gd = _d2gd->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] D-2: %d ADT genericos registrados\\n\", _G_native_adt_gen_count); fflush(stderr);")
        asm("// Fase B: registrar una instanciacion `Base<A,B>` (dedup por tipo normalizado)")
        asm("// Se invoca con el string del tipo (retorno/param) en _d2t_buf.")
        asm("")
        asm("// R17: scan de tipos instanciados Base<A,B> en TODO el programa (paridad")
        asm("// pre-pass generator.py _recolectar_instancias_adt): firmas (retorno+params),")
        asm("// let x: Base<A,B> locales (walk recursivo si/mientras/para/inseguro/coincidir),")
        asm("// campos de estructura y externos. Cola FIFO unica (R16) con post-orden.")
        asm("struct ListaNodo* _d2fd = programa.sentencias;")
        asm("char _d2all[256][128]; int _d2nall = 0; int _d2w = 0;")
        asm("while (_d2fd && _G_native_adt_inst_count < 64 && _d2nall < 256) {")
        asm("    struct Nodo* _d2fn = _d2fd->cabeza;")
        asm("    if (_d2fn && _d2fn->tipo.datos) {")
        asm("        const char* _d2tcf = _d2fn->tipo.datos;")
        asm("        if (strcmp(_d2tcf, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _d2f = (struct DefinicionFuncion*)_d2fn;")
        asm("            // R11: retorno Y parametros (un ADT como parametro no se")
        asm("            // registraba -> placeholder \"Resultado_T\" y gcc fallaba).")
        asm("            if (_d2f->tipo_retorno.datos && strchr(_d2f->tipo_retorno.datos, '<')) {")
        asm("                _d2w = 0; for (int _d2c = 0; _d2f->tipo_retorno.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2f->tipo_retorno.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2f->tipo_retorno.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("            }")
        asm("            struct ListaParametro* _d2plp = _d2f->parametros;")
        asm("            while (_d2plp && _d2nall < 256) {")
        asm("                struct Parametro* _d2par = (struct Parametro*)_d2plp->cabeza;")
        asm("                if (_d2par && _d2par->tipo_param.datos && strchr(_d2par->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2par->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2par->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2par->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
        asm("                _d2plp = _d2plp->cola;")
        asm("            }")
        asm("            // R17: `let x: Base<A,B>` del cuerpo (walk FIFO recursivo)")
        asm("            struct Nodo* _d2ws[4096]; int _d2wh = 0; int _d2wt = 0;")
        asm("            struct ListaNodo* _d2b0 = _d2f->cuerpo;")
        asm("            while (_d2b0) { if (_d2b0->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2b0->cabeza; } _d2b0 = _d2b0->cola; }")
        asm("            while (_d2wh < _d2wt && _d2nall < 256) {")
        asm("                struct Nodo* _d2wn = _d2ws[_d2wh++];")
        asm("                if (!_d2wn || !_d2wn->tipo.datos) continue;")
        asm("                const char* _d2wt2 = _d2wn->tipo.datos;")
        asm("                if (strcmp(_d2wt2, \"DeclaracionVariable\") == 0) {")
        asm("                    struct DeclaracionVariable* _d2dv = (struct DeclaracionVariable*)_d2wn;")
        asm("                    if (_d2dv->tipo_param.datos && strchr(_d2dv->tipo_param.datos, '<')) {")
        asm("                        _d2w = 0; for (int _d2c = 0; _d2dv->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2dv->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2dv->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                    }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaSi\") == 0) {")
        asm("                    struct SentenciaSi* _d2si = (struct SentenciaSi*)_d2wn;")
        asm("                    struct ListaNodo* _d2l1 = _d2si->cuerpo; while (_d2l1) { if (_d2l1->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l1->cabeza; } _d2l1 = _d2l1->cola; }")
        asm("                    struct ListaNodo* _d2l2 = _d2si->cuerpo_sino; while (_d2l2) { if (_d2l2->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l2->cabeza; } _d2l2 = _d2l2->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaMientras\") == 0) {")
        asm("                    struct SentenciaMientras* _d2wm = (struct SentenciaMientras*)_d2wn;")
        asm("                    struct ListaNodo* _d2l3 = _d2wm->cuerpo; while (_d2l3) { if (_d2l3->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l3->cabeza; } _d2l3 = _d2l3->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"BloqueInseguro\") == 0) {")
        asm("                    struct BloqueInseguro* _d2bi = (struct BloqueInseguro*)_d2wn;")
        asm("                    struct ListaNodo* _d2l4 = _d2bi->cuerpo; while (_d2l4) { if (_d2l4->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2l4->cabeza; } _d2l4 = _d2l4->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"SentenciaPara\") == 0) {")
        asm("                    struct SentenciaPara* _d2pa = (struct SentenciaPara*)_d2wn;")
        asm("                    struct ListaNodo* _d2pl = _d2pa->cuerpo;")
        asm("                    while (_d2pl) { if (_d2pl->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2pl->cabeza; } _d2pl = _d2pl->cola; }")
        asm("                }")
        asm("                if (strcmp(_d2wt2, \"NodoCoincidir\") == 0) {")
        asm("                    struct NodoCoincidir* _d2mc = (struct NodoCoincidir*)_d2wn;")
        asm("                    struct ListaNodo* _d2cl = _d2mc->casos;")
        asm("                    while (_d2cl) { struct NodoCaso* _d2ca = (struct NodoCaso*)_d2cl->cabeza; if (_d2ca && _d2ca->cuerpo) { struct ListaNodo* _d2bl = _d2ca->cuerpo; while (_d2bl) { if (_d2bl->cabeza && _d2wt < 4096) { _d2ws[_d2wt++] = _d2bl->cabeza; } _d2bl = _d2bl->cola; } } _d2cl = _d2cl->cola; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        else if (strcmp(_d2tcf, \"DefinicionEstructura\") == 0) {")
        asm("            struct DefinicionEstructura* _d2e = (struct DefinicionEstructura*)_d2fn;")
        asm("            struct ListaParametro* _d2fl = _d2e->campos;")
        asm("            while (_d2fl && _d2nall < 256) {")
        asm("                struct Parametro* _d2cp = (struct Parametro*)_d2fl->cabeza;")
        asm("                if (_d2cp && _d2cp->tipo_param.datos && strchr(_d2cp->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2cp->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2cp->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2cp->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
        asm("                _d2fl = _d2fl->cola;")
        asm("            }")
        asm("        }")
        asm("        else if (strcmp(_d2tcf, \"DeclaracionExterna\") == 0) {")
        asm("            struct DeclaracionExterna* _d2x = (struct DeclaracionExterna*)_d2fn;")
        asm("            if (_d2x->tipo_retorno.datos && strchr(_d2x->tipo_retorno.datos, '<')) {")
        asm("                _d2w = 0; for (int _d2c = 0; _d2x->tipo_retorno.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2x->tipo_retorno.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2x->tipo_retorno.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("            }")
        asm("            struct ListaParametro* _d2xp = _d2x->parametros;")
        asm("            while (_d2xp && _d2nall < 256) {")
        asm("                struct Parametro* _d2xpa = (struct Parametro*)_d2xp->cabeza;")
        asm("                if (_d2xpa && _d2xpa->tipo_param.datos && strchr(_d2xpa->tipo_param.datos, '<')) {")
        asm("                    _d2w = 0; for (int _d2c = 0; _d2xpa->tipo_param.datos[_d2c] && _d2w < 120; _d2c++) { if (_d2xpa->tipo_param.datos[_d2c] != ' ') _d2all[_d2nall][_d2w++] = _d2xpa->tipo_param.datos[_d2c]; } _d2all[_d2nall][_d2w] = 0; _d2nall++;")
        asm("                }")
