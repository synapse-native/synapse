#lang: es

// ============================================================
// emision_c.syn  —  API de emision de codigo C de bajo nivel
// ============================================================

// ----------------------------------------------------------
// traducir_tipo_c
// ----------------------------------------------------------
funcion traducir_tipo_c(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("if (!_t) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("int _len = (int)strlen(_t);")
        asm("if (_len > 7 && _t[0]=='C' && _t[1]=='a' && _t[2]=='n' && _t[3]=='a' && _t[4]=='l' && _t[5]=='<')")
        asm("    { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        asm("if (_len > 10 && _t[0]=='R' && _t[1]=='e' && _t[2]=='s' && _t[3]=='u' && _t[4]=='l' && _t[5]=='t' && _t[6]=='a' && _t[7]=='d' && _t[8]=='o' && _t[9]=='<')")
        asm("    { strcpy(_gen_tmp_buf, \"Resultado_T\"); return; }")
        asm("if (strcmp(_t, \"entero\")==0 || strcmp(_t, \"int\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"vacio\")==0 || strcmp(_t, \"nulo\")==0 || strcmp(_t, \"void\")==0) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("if (strcmp(_t, \"decimal\")==0 || strcmp(_t, \"real\")==0 || strcmp(_t, \"flotante\")==0) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("if (strcmp(_t, \"Tensor\")==0 || strcmp(_t, \"tensor\")==0) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("if (strcmp(_t, \"Canal\")==0 || strcmp(_t, \"canal\")==0) { strcpy(_gen_tmp_buf, \"Canal\"); return; }")
        asm("if (strcmp(_t, \"texto\")==0 || strcmp(_t, \"cadena\")==0) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("if (strcmp(_t, \"booleano\")==0 || strcmp(_t, \"logico\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"char\")==0) { strcpy(_gen_tmp_buf, \"char\"); return; }")
        asm("if (strcmp(_t, \"double\")==0) { strcpy(_gen_tmp_buf, \"double\"); return; }")
        asm("if (strcmp(_t, \"puntero\")==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("snprintf(_gen_tmp_buf, 64, \"struct %s\", _t);")

// ----------------------------------------------------------
// gen_emitir_linea — API PRINCIPAL
// ----------------------------------------------------------
funcion gen_emitir_linea(est: GeneradorCEst, linea: cadena) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    const char* _gs = linea.datos;")
        asm("    int _gl = linea.longitud;")
        asm("    if (_G_emit_pos + _gl + 2 > 1048576) return;")
        asm("    memcpy(_G_emit_buf + _G_emit_pos, _gs, _gl);")
        asm("    _G_emit_pos += _gl;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_emitir_str — API de bajo nivel para bloques asm()
// ----------------------------------------------------------
funcion gen_emitir_str(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("if (!str) return;")
        asm("const char* _s = (const char*)str;")
        asm("int _len = (int)strlen(_s);")
        asm("CadenaSegura _cs = {_len, _s};")
        asm("gen_emitir_linea(est, _cs);")

// ----------------------------------------------------------
// gen_emitir_nueva_linea
// ----------------------------------------------------------
funcion gen_emitir_nueva_linea(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    if (_G_emit_pos + 2 > 1048576) return;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_obtener_salida
// ----------------------------------------------------------
funcion gen_obtener_salida(est: GeneradorCEst) -> cadena:
    r = ""
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("if (_G_emit_pos > 0) {")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("    strcpy(_gen_tmp_buf, _G_emit_buf);")
        asm("} else {")
        asm("    strcpy(_gen_tmp_buf, \"\");")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// ----------------------------------------------------------
// gen_escribir_cadena_escapada
// ----------------------------------------------------------
funcion gen_escribir_cadena_escapada(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("const char* _s=(const char*)str;if(!_s)return;char _esc[16384];int _epos=0;int _ei=0;while(_s[_ei]&&_epos<16380){char _c=_s[_ei];if(_c==10){_esc[_epos++]=92;_esc[_epos++]=110;}else if(_c==34){_esc[_epos++]=92;_esc[_epos++]=34;}else if(_c==92){_esc[_epos++]=92;_esc[_epos++]=92;}else if(_c==9){_esc[_epos++]=92;_esc[_epos++]=116;}else if(_c==13){_esc[_epos++]=92;_esc[_epos++]=114;}else{_esc[_epos++]=_c;}_ei++;}_esc[_epos]=0;CadenaSegura _esc_cs={.longitud=_epos,.datos=_esc};gen_emitir_linea(est,_esc_cs);")

// ============================================================
// CAPA 2: Trazabilidad (C-Mapping)
// ============================================================

// ----------------------------------------------------------
// gen_emitir_traza
// Emite:     /* [Traza: modulo.syn - NombreNodo] */
// ----------------------------------------------------------
funcion gen_emitir_traza(est: GeneradorCEst, modulo: puntero, nombre_nodo: puntero) -> nulo:
    inseguro:
        asm("const char* _mod = (const char*)modulo;")
        asm("const char* _nn = (const char*)nombre_nodo;")
        asm("if (!_mod || !_nn) return;")
        asm("char _buf[512];")
        asm("snprintf(_buf, 512, \"  /* [Traza: %s - %s] */\", _mod, _nn);")
        asm("gen_emitir_str(est, _buf);")

// ============================================================
// CAPA 3: Auditoria Simetrica de Bloques
// ============================================================
// NOTA: est se pasa por valor. Las funciones no modifican
// est.indent_actual (no persistiria en C). La indentacion
// la gestionan los visitantes mediante prefijos en los strings.
// ============================================================

// ----------------------------------------------------------
// gen_abrir_bloque_c
// Emite "(" + newline al buffer de salida.
// M22.2: Incrementa scope_depth global y emite marcador de entrada.
// ----------------------------------------------------------
funcion gen_abrir_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '{';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;")   // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")
        asm("_G_scope_depth++;")

// ----------------------------------------------------------
// gen_cerrar_bloque_c
// Emite ")" + newline + pool_free para RAII en este ambito.
// M22.2: Antes de cerrar, decrementa scope_depth y emite
// pool_free para variables CadenaSegura rastreadas.
// NOTA: La indentacion la gestiona el visitante llamante.
// ----------------------------------------------------------
funcion gen_cerrar_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("// M22.2: Emitir pool_free para vars RAII en este ambito")
        asm("int _sd = _G_scope_depth;")
        asm("for (int _vi = 0; _vi < _G_scope_vars_total; _vi++) {")
        asm("    if (_G_scope_vars_depth[_vi] == _sd) {")
        asm("        char _free_line[128];")
        asm("        snprintf(_free_line, 128, \"    _syn_texto_liberar(%s); /* RAII scope %d */\", _G_scope_vars_names[_vi], _sd);")
        asm("        int _fl = (int)strlen(_free_line);")
        asm("        if (_G_emit_pos + _fl + 2 <= 1048576) {")
        asm("            memcpy(_G_emit_buf + _G_emit_pos, _free_line, _fl);")
        asm("            _G_emit_pos += _fl;")
        asm("            _G_emit_buf[_G_emit_pos] = 10;")
        asm("            _G_emit_pos++;")
        asm("        }")
        asm("        // Mark as removed (sentinel depth = -1) en vez de swap-with-last")
        asm("        _G_scope_vars_depth[_vi] = -1;")
        asm("        _G_scope_vars_names[_vi][0] = 0;")
        asm("    }")
        asm("}")
        asm("// Compact: rebuild array skipping removed entries")
        asm("int _wi = 0;")
        asm("for (int _ri = 0; _ri < _G_scope_vars_total; _ri++) {")
        asm("    if (_G_scope_vars_depth[_ri] >= 0) {")
        asm("        _G_scope_vars_depth[_wi] = _G_scope_vars_depth[_ri];")
        asm("        strcpy(_G_scope_vars_names[_wi], _G_scope_vars_names[_ri]);")
        asm("        _wi++;")
        asm("    }")
        asm("}")
        asm("_G_scope_vars_total = _wi;")
        asm("_G_scope_depth--;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '}';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;")   // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")


// ----------------------------------------------------------
// _syn_es_tipo
// Comparacion segura de tipo de nodo (strncmp con limite 64).
// Evita problemas de NUL terminator en _n->tipo.datos.
// ----------------------------------------------------------
funcion _syn_es_tipo(ptr_tipo_nodo: puntero, esperado: puntero) -> entero:
    inseguro:
        asm("if (!ptr_tipo_nodo || !esperado) return 0;")

        asm("return strncmp((const char*)ptr_tipo_nodo, (const char*)esperado, 64) == 0;")
// ===== From: nodos_flujo.syn =====

#lang: es

// ============================================================
// nodos_flujo.syn  —  Visitantes de control de flujo (OO style)
// ============================================================
// Visitantes para nodos del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - Cada visitante emite gen_emitir_traza() antes de emitir
//     codigo, para trazabilidad en el archivo C generado.
//   - Los bloques ( ) se emiten exclusivamente mediante
//     gen_abrir_bloque_c() y gen_cerrar_bloque_c() de emision_c.
//     Prohibida la emision manual de llaves con strings crudos.
//   - El dispatcher (gen_visitar_stmt_generico) tiene una rama
//     de fail-fast para tipos de nodo no reconocidos.
// ============================================================

// ----------------------------------------------------------
// gen_visitar_si
// Visita un struct SentenciaSi* y emite: if (cond) ( ... ) else ( ... )
// ----------------------------------------------------------
// _oo_expr_a_c -- OO expression evaluator
funcion _oo_expr_a_c(est: GeneradorCEst, nodo: puntero, buf: puntero, bufsz: entero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)nodo;")
        asm("char* _b = (char*)buf;")
        asm("int _sz = bufsz;")
        asm("if (!_n || !_b || _sz <= 0) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) { strcpy(_b, \"0\"); return; }")
        asm("_b[0] = 0;")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralNumero\")) {")
        asm("    struct LiteralNumero* _ln = (struct LiteralNumero*)_n;")
        asm("    snprintf(_b, _sz, \"%d\", _ln->valor);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralDecimal\")) {")
        asm("    // NOTE: No struct LiteralDecimal in ast_types.h yet.")
        asm("    // Using lexeme from the token IF accessible, otherwise snprintf float.")
        asm("    // The LiteralDecimal node in OO layer may have a token reference;")
        asm("    // for now emit 0.0f as safe default (micro-tests use ints).")
        asm("    extern char _gen_tmp_buf[4096];")
        asm("    // Try to snprintf from float valor if struct has it")
        asm("    struct LiteralNumero* _ld = (struct LiteralNumero*)_n;")
        asm("    snprintf(_b, _sz, \"%d.0f\", _ld->valor);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"Identificador\")) {")
        asm("    struct Identificador* _id = (struct Identificador*)_n;")
        asm("    if (_id->nombre.datos) strncpy(_b, _id->nombre.datos, _sz - 1);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralCadena\")) {")
        asm("    struct LiteralCadena* _lc = (struct LiteralCadena*)_n;")
        asm("    if (_lc->valor.datos && _lc->valor.longitud > 0) {")
        asm("        snprintf(_b, _sz, \"\\\"%s\\\"\", _lc->valor.datos);")
        asm("    } else {")
        asm("        strcpy(_b, \"\\\"\\\"\");")
        asm("    }")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"OpBinaria\")) {")
        asm("    struct OpBinaria* _op = (struct OpBinaria*)_n;")
        asm("    char _izq[512], _der[512];")
        asm("    _izq[0] = _der[0] = 0;")
        asm("    if (_op->izquierdo) { _oo_expr_a_c(est, _op->izquierdo, _izq, 512); }")
        asm("    if (_op->derecho) { _oo_expr_a_c(est, _op->derecho, _der, 512); }")
        asm("    const char* _op_str = \"\";")
        asm("    if (_op->operador) {")
        asm("        int _ot = _op->operador->tipo;")
        asm("        switch (_ot) {")
        asm("            case 30: _op_str = \" + \"; break;")
        asm("            case 31: _op_str = \" - \"; break;")
        asm("            case 32: _op_str = \" * \"; break;")
        asm("            case 33: _op_str = \" / \"; break;")
        asm("            case 16: _op_str = \" > \"; break;")
        asm("            case 17: _op_str = \" < \"; break;")
        asm("            case 25: _op_str = \" == \"; break;")
        asm("            case 26: _op_str = \" != \"; break;")
        asm("            case 28: _op_str = \" >= \"; break;")
        asm("            case 27: _op_str = \" <= \"; break;")
        asm("            case 14: _op_str = \" && \"; break;")
        asm("            case 15: _op_str = \" || \"; break;")
        asm("            default: _op_str = \" ? \"; break;")
        asm("        }")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s%s\", _izq, _op_str, _der);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"OpUnaria\")) {")
        asm("    struct OpUnaria* _ou = (struct OpUnaria*)_n;")
        asm("    char _uexpr[512]; _uexpr[0] = 0;")
        asm("    if (_ou->expr) { _oo_expr_a_c(est, _ou->expr, _uexpr, 512); }")
        asm("    const char* _uop = \"\";")
        asm("    if (_ou->operador) {")
        asm("        int _ut = _ou->operador->tipo;")
        asm("        if (_ut == 31) { _uop = \"-\"; } else if (_ut == 16) { _uop = \"!\"; }")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s\", _uop, _uexpr);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_n;")
        asm("    if (_lf->nombre.datos) strcpy(_b, _lf->nombre.datos);")
        asm("    strcat(_b, \"(\");")
        asm("    int _arg_idx = 0;")
        asm("    struct ListaNodo* _arg_cur = _lf->argumentos;")
        asm("    while (_arg_cur) {")
        asm("        struct Nodo* _arg_n = _arg_cur->cabeza;")
        asm("        if (_arg_n) {")
        asm("            if (_arg_idx > 0) strcat(_b, \", \");")
        asm("            char _arg_buf[256]; _arg_buf[0] = 0;")
        asm("            _oo_expr_a_c(est, _arg_n, _arg_buf, 256);")
        asm("            strcat(_b, _arg_buf);")
        asm("            _arg_idx++;")
        asm("        }")
        asm("        _arg_cur = _arg_cur->cola;")
        asm("    }")
        asm("    strcat(_b, \")\");")
        asm("    return;")
        asm("}")
        asm("")
        asm("// Fallback")
        asm("strcpy(_b, \"0\");")

// ----------------------------------------------------------
// gen_visitar_si  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_si(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSi* _s = (struct SentenciaSi*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSi\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// if (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    if (\");")
        asm("_buf2[0] = 0;")
        asm("if (_s->condicion) { _oo_expr_a_c(est, _s->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// [PGO] Counter at if-true block entry")
        asm("pgo_instrumentar_if_true(est);")
        asm("// Visit if-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _ic = _s->cuerpo;")
        asm("    while (_ic) {")
        asm("        struct Nodo* _is = _ic->cabeza;")
        asm("        if (_is) { gen_visitar_stmt_generico(est, _is); }")
        asm("        _ic = _ic->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")
        asm("if (_s->cuerpo_sino) {")
        asm("    gen_emitir_str(est, \"    else\");")
        asm("    gen_abrir_bloque_c(est);")
        asm("    // [PGO] Counter at if-false (else) block entry")
        asm("    pgo_instrumentar_if_false(est);")
        asm("    struct ListaNodo* _ec = _s->cuerpo_sino;")
        asm("    while (_ec) {")
        asm("        struct Nodo* _es = _ec->cabeza;")
        asm("        if (_es) { gen_visitar_stmt_generico(est, _es); }")
        asm("        _ec = _ec->cola;")
        asm("    }")
        asm("    gen_cerrar_bloque_c(est);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_mientras  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_mientras(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaMientras* _w = (struct SentenciaMientras*)stmt;")
        asm("if (!_w) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaMientras\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// while (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    while (\");")
        asm("_buf2[0] = 0;")
        asm("if (_w->condicion) { _oo_expr_a_c(est, _w->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// [PGO] Counter at while-body entry")
        asm("pgo_instrumentar_while_body(est);")
        asm("// While-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _wc = _w->cuerpo;")
        asm("    while (_wc) {")
        asm("        struct Nodo* _ws = _wc->cabeza;")
        asm("        if (_ws) { gen_visitar_stmt_generico(est, _ws); }")
        asm("        _wc = _wc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_para  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_para(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaPara* _p = (struct SentenciaPara*)stmt;")
        asm("if (!_p) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaPara\");")
        asm("char _buf[4096], _init[512], _cond[512], _step[512];")
        asm("_init[0] = _cond[0] = _step[0] = 0;")
        asm("// Evaluate init, cond, step expressions")
        asm("if (_p->inicializacion) { _oo_expr_a_c(est, _p->inicializacion, _init, 512); }")
        asm("if (_p->condicion) { _oo_expr_a_c(est, _p->condicion, _cond, 512); }")
        asm("if (_p->incremento) { _oo_expr_a_c(est, _p->incremento, _step, 512); }")
        asm("// Emit: for (init; cond; step) {")
        asm("snprintf(_buf, 4096, \"    for (%s; %s; %s)\", _init, _cond, _step);")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// [PGO] Counter at for-body entry")
        asm("pgo_instrumentar_for_body(est);")
        asm("// For-body via dispatcher")
        asm("{")
        asm("    struct Nodo* _fc = _p->cuerpo;")
        asm("    if (_fc) { gen_visitar_stmt_generico(est, _fc); }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_retornar
// ----------------------------------------------------------
funcion gen_visitar_retornar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)stmt;")
        asm("if (!_rt) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRetornar\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    return \");")
        asm("_buf2[0] = 0;")
        asm("if (_rt->expr) { _oo_expr_a_c(est, _rt->expr, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_declaracion
// ----------------------------------------------------------
funcion gen_visitar_declaracion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)stmt;")
        asm("if (!_dv) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"DeclaracionVariable\");")
        asm("if (!_dv->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: DeclaracionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal -> use const char*")
        asm("const char* _var_type = \"int \";")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"const char* \";")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _dv->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_dv->expresion) { _oo_expr_a_c(est, _dv->expresion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.2: Track string vars for RAII pool_free at scope exit
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    if (_G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _dv->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

funcion gen_visitar_asignacion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionVariable* _a = (struct AsignacionVariable*)stmt;")
        asm("if (!_a) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionVariable\");")
        asm("if (!_a->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: AsignacionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal assignment -> use const char*")
        asm("const char* _var_type = \"int \";")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"const char* \";")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _a->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_a->expresion) { _oo_expr_a_c(est, _a->expresion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_expr
// ----------------------------------------------------------
funcion gen_visitar_expr(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaExpr* _s = (struct SentenciaExpr*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaExpr\");")
        asm("char _buf[4096];")
        asm("_buf[0] = 0;")
        asm("if (_s->expr) { _oo_expr_a_c(est, _s->expr, _buf, 4096); }")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_romper
// ----------------------------------------------------------
funcion gen_visitar_romper(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRomper* _br = (struct SentenciaRomper*)stmt;")
        asm("if (!_br) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRomper\");")
        asm("gen_emitir_str(est, \"    break;\");")

// ----------------------------------------------------------
// gen_visitar_siguiente
// ----------------------------------------------------------
funcion gen_visitar_siguiente(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSiguiente* _ct = (struct SentenciaSiguiente*)stmt;")
        asm("if (!_ct) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSiguiente\");")
        asm("gen_emitir_str(est, \"    continue;\");")

// ----------------------------------------------------------
// gen_visitar_stmt_generico — Dispatcher principal
// ----------------------------------------------------------
funcion gen_visitar_stmt_generico(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo sin tipo (puntero nulo en tipo.datos)\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"SentenciaSi\")) { gen_visitar_si(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaMientras\")) { gen_visitar_mientras(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaPara\")) { gen_visitar_para(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRetornar\")) { gen_visitar_retornar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionVariable\")) { gen_visitar_asignacion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaExpr\")) { gen_visitar_expr(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionVariable\")) { gen_visitar_declaracion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"AsignacionCampo\")) { gen_visitar_expr(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRomper\")) { gen_visitar_romper(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSiguiente\")) { gen_visitar_siguiente(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"BloqueInseguro\")) {")
        asm("    struct BloqueInseguro* _sbi = (struct BloqueInseguro*)stmt;")
        asm("    gen_emitir_traza(est, \"nodos_flujo.syn\", \"BloqueInseguro\");")
        asm("    struct ListaNodo* _sbl = (struct ListaNodo*)_sbi->cuerpo;")
        asm("    while (_sbl) {")
        asm("        struct Nodo* _sbs = _sbl->cabeza;")
        asm("        if (_sbs) { gen_visitar_stmt_generico(est, _sbs); }")
        asm("        _sbl = _sbl->cola;")
        asm("    }")
        asm("} else {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo tipo [%s] no reconocido\\n\", _t);")
        asm("    exit(1);")
        asm("}")

// ===== From: orquestador.syn =====

#lang: es

// ============================================================
// orquestador.syn  —  Orquestador del generador nativo
// ============================================================

// ----------------------------------------------------------
// generar — Punto de entrada principal
// ----------------------------------------------------------
funcion generar(programa: Programa, ruta: cadena) -> entero:
    r = 0
    est = GeneradorCEst()
    // PGO: Inicializar contadores al comenzar la generacion
    pgo_inicializar()
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Abriendo archivo...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("_G_emit_pos = 0;")
        asm("FILE* _G_out = fopen(ruta.datos, \"w\");")
        asm("if (!_G_out) { fprintf(stderr, \"[Orquestador] ERROR FATAL: No se pudo abrir %s\\n\", ruta.datos); r = 1; return r; }")
        asm("extern FILE* _G_fp; _G_fp = _G_out;")
        asm("fprintf(stderr, \"[Orquestador] Archivo abierto\\n\"); fflush(stderr);")

    gen_emitir_linea(est, "// Generado por Synapse (nuevo generador modular)")
    gen_emitir_linea(est, "#include <stdio.h>")
    gen_emitir_linea(est, "#include <stdlib.h>")
    gen_emitir_linea(est, "#include <string.h>")
    gen_emitir_linea(est, "typedef struct { int longitud; const char* datos; } CadenaSegura;")
    gen_emitir_linea(est, "#define nulo ((void*)0)")
    gen_emitir_linea(est, "#define verdadero 1")
    gen_emitir_linea(est, "#define falso 0")
    gen_emitir_linea(est, "int _g_argc;")
    gen_emitir_linea(est, "char** _g_argv;")

    // WALK TOP-LEVEL AST
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Iniciando recorrido AST\\n\"); fflush(stderr);")
        asm("struct ListaNodo* _cur = programa.sentencias;")
        asm("if (!_cur) { fprintf(stderr, \"[Orquestador] ERROR FATAL: AST vacio (sentencias nulo)\\n\"); r = 1; return r; }")
        asm("int _count = 0;")
        asm("while (_cur) {")
        asm("    _count++;")
        asm("    struct Nodo* _n = _cur->cabeza;")
        asm("    if (!_n) { _cur = _cur->cola; continue; }")
        asm("    fprintf(stderr, \"[Orquestador] Node %d: tipo='%s'\\n\", _count, _n->tipo.datos ? _n->tipo.datos : \"(null)\"); fflush(stderr);")
        asm("    gen_visitar_top_level(est, _n);")
        asm("    _cur = _cur->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] Recorrido AST completado: %d nodos\\n\", _count); fflush(stderr);")

    // [PGO] Finalizar instrumentacion y emitir volcado antes de main()
    asm("pgo_finalizar(est);")

    // Emit main() wrapper
    gen_emitir_linea(est, "int main(int argc, char** argv) {")
    gen_emitir_linea(est, "    _g_argc = argc;")
    gen_emitir_linea(est, "    _g_argv = argv;")
    gen_emitir_linea(est, "    pool_init(64, 4096);")
    gen_emitir_linea(est, "    return principal();")
    gen_emitir_linea(est, "}")

    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Escribiendo archivo de salida...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("extern FILE* _G_fp;")
        asm("if (!_G_fp) { fprintf(stderr, \"[Orquestador] ERROR FATAL: _G_fp nulo\\n\"); r = 1; return r; }")
        asm("if (_G_emit_pos > 0) {")
        asm("    fwrite(_G_emit_buf, 1, _G_emit_pos, _G_fp);")
        asm("}")
        asm("fclose(_G_fp);")
        asm("_G_fp = nulo;")
        asm("fprintf(stderr, \"[Nuevo Generador] Codigo C generado exitosamente\\n\"); fflush(stderr);")
    retornar r

// ----------------------------------------------------------
// gen_visitar_top_level — Dispatcher para nodos top-level
// ----------------------------------------------------------
funcion gen_visitar_top_level(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) { fprintf(stderr, \"[DEBUG] gen_visitar_top_level: stmt is NULL\\n\"); return; }")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) { fprintf(stderr, \"[DEBUG] gen_visitar_top_level: tipo.datos is NULL\\n\"); exit(1); }")
        asm("fprintf(stderr, \"[DEBUG] gen_visitar_top_level: tipo='%s'\\n\", _t);")
        asm("if (_syn_es_tipo(_t, \"DefinicionFuncion\")) {")
        asm("    struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_n;")
        asm("    fprintf(stderr, \"[DEBUG]   DefinicionFuncion: _f=%p\\n\", (void*)_f);")
        asm("    fprintf(stderr, \"[DEBUG]   nombre.datos=%p\\n\", (void*)_f->nombre.datos);")
        asm("    const char* _fn = _f->nombre.datos;")
        asm("    if (!_fn) { fprintf(stderr, \"Error Fatal: DefinicionFuncion sin nombre\\n\"); exit(1); }")
        asm("    fprintf(stderr, \"[DEBUG]   nombre='%s'\\n\", _fn);")
        asm("    char _sig[4096];")
        asm("    snprintf(_sig, 4096, \"int %s()\", _fn);")
        asm("    fprintf(stderr, \"[DEBUG]   emit function signature\\n\");")
        asm("    gen_emitir_str(est, _sig);")
        asm("    gen_abrir_bloque_c(est);")
        asm("    // [PGO] Emitir contadores estaticos para funcion")
        asm("    int _base_pgo = pgo_emitir_contadores_funcion(est, 1);")
        asm("    pgo_emitir_incremento_id(est, _base_pgo);")
        asm("    fprintf(stderr, \"[DEBUG]   start walking body\\n\");")
        asm("    struct ListaNodo* _bc = _f->cuerpo;")
        asm("    fprintf(stderr, \"[DEBUG]   cuerpo=%p\\n\", (void*)_bc);")
        asm("    int _bs_count = 0;")
        asm("    while (_bc) {")
        asm("        _bs_count++;")
        asm("        struct Nodo* _bs = _bc->cabeza;")
        asm("        fprintf(stderr, \"[DEBUG]   body stmt %d: _bs=%p\\n\", _bs_count, (void*)_bs);")
        asm("        if (!_bs) { _bc = _bc->cola; continue; }")
        asm("        if (_bs->tipo.datos) {")
        asm("            fprintf(stderr, \"[DEBUG]     tipo='%s'\\n\", _bs->tipo.datos);")
        asm("        }")
        asm("        fprintf(stderr, \"[DEBUG]     calling gen_visitar_stmt_generico...\\n\");")
        asm("        gen_visitar_stmt_generico(est, _bs);")
        asm("        fprintf(stderr, \"[DEBUG]     return OK\\n\");")
        asm("        _bc = _bc->cola;")
        asm("    }")
        asm("    fprintf(stderr, \"[DEBUG]   body done (%d stmts)\\n\", _bs_count);")
        asm("    gen_cerrar_bloque_c(est);")
        asm("    fprintf(stderr, \"[DEBUG]   function done\\n\");")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaExpr\")) {")
        asm("    gen_visitar_expr(est, stmt);")
        asm("} else if (_syn_es_tipo(_t, \"AsignacionVariable\")) {")
        asm("    gen_visitar_asignacion(est, stmt);")
        asm("} else if (_syn_es_tipo(_t, \"DefinicionEstructura\")) {")
        asm("    /* skip struct */")
        asm("} else if (_syn_es_tipo(_t, \"DeclaracionExterna\")) {")
        asm("    /* skip extern */")
        asm("} else if (_syn_es_tipo(_t, \"SentenciaImportar\")) {")
        asm("    /* skip import - NOT a BloqueInseguro, do NOT cast */")
        asm("}")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSi\")) { gen_visitar_si(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaMientras\")) { gen_visitar_mientras(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRetornar\")) { gen_visitar_retornar(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaRomper\")) { gen_visitar_romper(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"SentenciaSiguiente\")) { gen_visitar_siguiente(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"DeclaracionVariable\")) { gen_visitar_declaracion(est, stmt); }")
        asm("else if (_syn_es_tipo(_t, \"BloqueInseguro\")) {")
        asm("    struct BloqueInseguro* _sbi = (struct BloqueInseguro*)stmt;")
        asm("    struct ListaNodo* _sbl = (struct ListaNodo*)_sbi->cuerpo;")
        asm("    while (_sbl) {")
        asm("        struct Nodo* _sbs = _sbl->cabeza;")
        asm("        if (_sbs) { gen_visitar_stmt_generico(est, _sbs); }")
        asm("        _sbl = _sbl->cola;")
        asm("    }")
        asm("}")
        asm("else {")
        asm("    fprintf(stderr, \"Error Fatal Generador: Nodo tipo [%s] no reconocido\\n\", _t);")
        asm("    exit(1);")
        asm("}")
