// ----------------------------------------------------------
// Estructura de estado del generador (única, pasada por valor)
// ----------------------------------------------------------
estructura GeneradorCEst:
    // --- Output buffer ---
    buf_lineas: entero       // pointer to buffer (void* stored as int)
    buf_capacidad: entero    // total buffer capacity
    buf_longitud: entero     // current write position
    indent_actual: entero    // current indentation level (spaces * 4)
    archivo_actual: entero   // FILE* stored as intptr_t (for fwrite/fclose)

    // --- Function tracking ---
    contador_thread: entero
    contador_listener: entero
    funciones_emitidas: entero
    func_emitidas_nombres: cadena
    func_return_types_nombres: cadena
    func_return_types_tipos: cadena
    func_return_types_total: entero
    in_function_scope: booleano

    // --- Variable tracking ---
    var_nombres: cadena
    var_tipos: cadena
    var_total: entero
    var_capacidad: entero
    const_types_nombres: cadena
    const_types_tipos: cadena
    const_types_total: entero

    // --- Scope stack (RAII) ---
    scope_var_nombres: cadena
    scope_var_tipos: cadena
    scope_var_total: entero
    scope_stack_top: entero
    scope_stack_at: entero

    // --- Tensor / canal tracking ---
    tensor_vars: cadena
    tensor_vars_total: entero
    tensor_transferidas: cadena
    tensor_transferidas_total: entero
    canal_vars: cadena
    canal_vars_total: entero
    canal_cerradas: cadena
    canal_cerradas_total: entero

    // --- Listener tracking ---
    listener_funciones: cadena
    listener_total: entero

    // --- Struct tracking ---
    struct_nombres: cadena
    struct_total: entero
    struct_nombres_c: cadena
    struct_total_c: entero

    // --- External function tracking ---
    extern_nombres: cadena
    extern_params: cadena
    extern_total: entero

    // --- Destructor map (RAII) ---
    dtor_tipos: cadena
    dtor_funcs: cadena
    dtor_total: entero

    // --- Emit flags ---
    gen_tok_emitido: booleano
    gen_parse_emitido: booleano
    gen_defs_emitido: booleano

    // --- Contract (requiere/garantiza) ---
    garantizas_nombres: cadena
    garantizas_valores: cadena
    garantizas_total: entero

    // --- Program-level flags ---
    es_no_std: booleano
    linker_libs: cadena
    linker_libs_total: entero

    // --- Build buffer for code generation ---
    build_buf: cadena

    // --- Current function return type ---
    func_retorno_actual: cadena

    // --- Strings on heap ---
    strings_heap: cadena
    strings_heap_total: entero

    // --- M22.2: Scope tracking (native RAII, est pasada por valor) ---
    // scope_depth se maneja via global _G_scope_depth (no persiste en est)

    // --- M22.5: --safe mode (lifetime assertions in generated C) ---
    safe_mode: booleano
    // NOTA: safe_mode se propaga via global _G_safe_mode porque est se pasa por valor

// ----------------------------------------------------------
// Tamaño del buffer temporal global
// ----------------------------------------------------------
constante _GEN_TMP_SIZE = 4096
constante _G_SCOPE_MAX_VARS = 256

// ===== From: emision_c.syn =====

#lang: es

// ============================================================
// emision_c.syn  —  API de emision de codigo C de bajo nivel
// ============================================================

// ----------------------------------------------------------
// traducir_tipo_c
// ----------------------------------------------------------
funcion traducir_tipo_c(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("if (!_t) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("int _len = (int)strlen(_t);")
        asm("if (_len > 7 && _t[0]=='C' && _t[1]=='a' && _t[2]=='n' && _t[3]=='a' && _t[4]=='l' && _t[5]=='<') { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        asm("if (_len > 10 && _t[0]=='R' && _t[1]=='e' && _t[2]=='s' && _t[3]=='u' && _t[4]=='l' && _t[5]=='t' && _t[6]=='a' && _t[7]=='d' && _t[8]=='o' && _t[9]=='<') { strcpy(_gen_tmp_buf, \"Resultado_T\"); return; }")
        asm("if (strcmp(_t, \"entero\")==0 || strcmp(_t, \"int\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"vacio\")==0 || strcmp(_t, \"nulo\")==0 || strcmp(_t, \"void\")==0) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("if (strcmp(_t, \"decimal\")==0 || strcmp(_t, \"real\")==0 || strcmp(_t, \"flotante\")==0) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("if (strcmp(_t, \"Tensor\")==0 || strcmp(_t, \"tensor\")==0) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("if (strcmp(_t, \"Canal\")==0 || strcmp(_t, \"canal\")==0) { strcpy(_gen_tmp_buf, \"Canal\"); return; }")
        asm("if (strcmp(_t, \"texto\")==0 || strcmp(_t, \"cadena\")==0) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("if (strcmp(_t, \"booleano\")==0 || strcmp(_t, \"logico\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"char\")==0) { strcpy(_gen_tmp_buf, \"char\"); return; }")
        asm("if (strcmp(_t, \"double\")==0) { strcpy(_gen_tmp_buf, \"double\"); return; }")
        asm("if (strcmp(_t, \"puntero\")==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("snprintf(_gen_tmp_buf, 64, \"struct %s\", _t);")

// ----------------------------------------------------------
// traducir_tipo_c_campo
// Manual 8 S8.2 + paridad con el generador de referencia (_P_mt/_vest):
// para campos de estructura, los tipos primitivos se emiten por valor,
// y los tipos de tipo struct se emiten como PUNTERO (struct X*).
// ----------------------------------------------------------
funcion traducir_tipo_c_campo(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("traducir_tipo_c((void*)_t);")
        asm("extern char _gen_tmp_buf[4096];")
        asm("// Si el tipo no es primitivo, traducir_tipo_c emite 'struct <X>'.")
        asm("// Como campo de estructura ese tipo se referencia por puntero -> anadir '*'.")
        asm("if (strncmp(_gen_tmp_buf, \"struct \", 7) == 0) { strcat(_gen_tmp_buf, \"*\"); }")

// ----------------------------------------------------------
// traducir_tipo_retorno
// Paridad con el generador de referencia (_P_mt): tipos de retorno de tipo
// struct se emiten como struct X (por valor), nunca puntero.
// ----------------------------------------------------------
funcion traducir_tipo_retorno(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("traducir_tipo_c((void*)_t);")

// ----------------------------------------------------------
// gen_emitir_linea — API PRINCIPAL
// ----------------------------------------------------------
funcion gen_emitir_linea(est: GeneradorCEst, linea: cadena) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    const char* _gs = linea.datos;")
        asm("    int _gl = linea.longitud;")
        asm("    if (_G_emit_pos + _gl + 2 > 1048576) return;")
        asm("    memcpy(_G_emit_buf + _G_emit_pos, _gs, _gl);")
        asm("    _G_emit_pos += _gl;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_emitir_str — API de bajo nivel para bloques asm()
// ----------------------------------------------------------
funcion gen_emitir_str(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("if (!str) return;")
        asm("const char* _s = (const char*)str;")
        asm("int _len = (int)strlen(_s);")
        asm("CadenaSegura _cs = {_len, _s};")
        asm("gen_emitir_linea(est, _cs);")

// ----------------------------------------------------------
// gen_emitir_nueva_linea
// ----------------------------------------------------------
funcion gen_emitir_nueva_linea(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    if (_G_emit_pos + 2 > 1048576) return;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_obtener_salida
// ----------------------------------------------------------
funcion gen_obtener_salida(est: GeneradorCEst) -> cadena:
    r = ""
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("if (_G_emit_pos > 0) {")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("    strcpy(_gen_tmp_buf, _G_emit_buf);")
        asm("} else {")
        asm("    strcpy(_gen_tmp_buf, \"\");")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// ----------------------------------------------------------
// gen_escribir_cadena_escapada
// ----------------------------------------------------------
funcion gen_escribir_cadena_escapada(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("const char* _s=(const char*)str;if(!_s)return;char _esc[16384];int _epos=0;int _ei=0;while(_s[_ei]&&_epos<16380){char _c=_s[_ei];if(_c==10){_esc[_epos++]=92;_esc[_epos++]=110;}else if(_c==34){_esc[_epos++]=92;_esc[_epos++]=34;}else if(_c==92){_esc[_epos++]=92;_esc[_epos++]=92;}else if(_c==9){_esc[_epos++]=92;_esc[_epos++]=116;}else if(_c==13){_esc[_epos++]=92;_esc[_epos++]=114;}else{_esc[_epos++]=_c;}_ei++;}_esc[_epos]=0;CadenaSegura _esc_cs={.longitud=_epos,.datos=_esc};gen_emitir_linea(est,_esc_cs);")

// ============================================================
// CAPA 2: Trazabilidad (C-Mapping)
// ============================================================

// ----------------------------------------------------------
// gen_emitir_traza
// Emite:     /* [Traza: modulo.syn - NombreNodo] */
// ----------------------------------------------------------
funcion gen_emitir_traza(est: GeneradorCEst, modulo: puntero, nombre_nodo: puntero) -> nulo:
    inseguro:
        asm("// [Optimizacion] gen_emitir_traza anulado: no emitir comentarios de traza en el C")
        asm("(void)modulo; (void)nombre_nodo; (void)est;")

// ============================================================
// CAPA 3: Auditoria Simetrica de Bloques
// ============================================================
// NOTA: est se pasa por valor. Las funciones no modifican
// est.indent_actual (no persistiria en C). La indentacion
// la gestionan los visitantes mediante prefijos en los strings.
// ============================================================

// ----------------------------------------------------------
// gen_emitir_lifetime_assert
// M22.5: Emite una asercion de lifetime en el codigo C generado
// (solo si _G_safe_mode esta activo).
// Formato: assert(condition && "mensaje");
// ----------------------------------------------------------
funcion gen_emitir_lifetime_assert(est: GeneradorCEst, condicion: puntero, mensaje: puntero) -> nulo:
    inseguro:
        asm("extern int _G_safe_mode;")
        asm("if (!_G_safe_mode) return;")
        asm("const char* _cond = (const char*)condicion;")
        asm("const char* _msg = (const char*)mensaje;")
        asm("if (!_cond || !_msg) return;")
        asm("char _buf[512];")
        asm("snprintf(_buf, 512, \"    assert(%s && \\\"%s\\\"); /* LIFETIME */\", _cond, _msg);")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_abrir_bloque_c
// Emite "(" + newline al buffer de salida.
// M22.2: Incrementa scope_depth global y emite marcador de entrada.
// ----------------------------------------------------------
funcion gen_abrir_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '{';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;")   // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")
        asm("_G_scope_depth++;")
        // M22.5: Emitir ASSERT activo de LIFETIME en modo --safe (no comentario pasivo)
        asm("extern int _G_safe_mode;")
        asm("if (_G_safe_mode) {")
        asm("    char _safe_buf[256];")
        asm("    snprintf(_safe_buf, 256, \"    assert(_G_scope_depth >= 0 && _G_scope_depth < 256 && \\\"LIFETIME: scope_depth overflow at block %d\\\"); /* LIFETIME */\", _G_scope_depth);")
        asm("    gen_emitir_str(est, _safe_buf);")
        asm("}")

// ----------------------------------------------------------
// gen_cerrar_bloque_c
// Emite ")" + newline + pool_free para RAII en este ambito.
// M22.2: Antes de cerrar, decrementa scope_depth y emite
// pool_free para variables CadenaSegura rastreadas.
// NOTA: La indentacion la gestiona el visitante llamante.
// ----------------------------------------------------------
funcion gen_cerrar_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("// M22.2: Emitir pool_free para vars RAII en este ambito")
        asm("int _sd = _G_scope_depth;")
        asm("// Manual 3 S3.3: orden lexicografico en iteracion de variables de scope")
        asm("// Colectar indices de vars en este ambito y ordenar por nombre")
        asm("int _scope_idxs[256]; int _scope_n = 0;")
        asm("for (int _vi = 0; _vi < _G_scope_vars_total && _scope_n < 256; _vi++) {")
        asm("    if (_G_scope_vars_depth[_vi] == _sd) {")
        asm("        _scope_idxs[_scope_n++] = _vi;")
        asm("    }")
        asm("}")
        asm("// Bubble sort indices por nombre (lexicografico)")
        asm("for (int _si = 0; _si < _scope_n - 1; _si++) {")
        asm("    for (int _sj = 0; _sj < _scope_n - 1 - _si; _sj++) {")
        asm("        if (strcmp(_G_scope_vars_names[_scope_idxs[_sj]], _G_scope_vars_names[_scope_idxs[_sj+1]]) > 0) {")
        asm("            int _tmp = _scope_idxs[_sj];")
        asm("            _scope_idxs[_sj] = _scope_idxs[_sj+1];")
        asm("            _scope_idxs[_sj+1] = _tmp;")
        asm("        }")
        asm("    }")
        asm("}")
        asm("for (int _vi = 0; _vi < _scope_n; _vi++) {")
        asm("    int _v = _scope_idxs[_vi];")
        asm("    char _free_line[128];")
        asm("    snprintf(_free_line, 128, \"    _syn_texto_liberar(%s); /* RAII scope %d */\", _G_scope_vars_names[_v], _sd);")
        asm("    int _fl = (int)strlen(_free_line);")
        asm("    if (_G_emit_pos + _fl + 2 <= 1048576) {")
        asm("        memcpy(_G_emit_buf + _G_emit_pos, _free_line, _fl);")
        asm("        _G_emit_pos += _fl;")
        asm("        _G_emit_buf[_G_emit_pos] = 10;")
        asm("        _G_emit_pos++;")
        asm("    }")
        asm("    // Mark as removed (sentinel depth = -1)")
        asm("    _G_scope_vars_depth[_v] = -1;")
        asm("    _G_scope_vars_names[_v][0] = 0;")
        asm("}")
        asm("// Compact: rebuild array skipping removed entries")
        asm("int _wi = 0;")
        asm("for (int _ri = 0; _ri < _G_scope_vars_total; _ri++) {")
        asm("    if (_G_scope_vars_depth[_ri] >= 0) {")
        asm("        _G_scope_vars_depth[_wi] = _G_scope_vars_depth[_ri];")
        asm("        strcpy(_G_scope_vars_names[_wi], _G_scope_vars_names[_ri]);")
        asm("        _wi++;")
        asm("    }")
        asm("}")
        asm("_G_scope_vars_total = _wi;")
        asm("_G_scope_depth--;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '}';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;")   // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")


// ----------------------------------------------------------
// _syn_es_tipo
// Comparacion segura de tipo de nodo (strncmp con limite 64).
// Evita problemas de NUL terminator en _n->tipo.datos.
// ----------------------------------------------------------
funcion _syn_es_tipo(ptr_tipo_nodo: puntero, esperado: puntero) -> entero:
    inseguro:
        asm("if (!ptr_tipo_nodo || !esperado) return 0;")

        asm("return strncmp((const char*)ptr_tipo_nodo, (const char*)esperado, 64) == 0;")
// ===== From: expr_eval.syn =====

#lang: es

// ============================================================
// expr_eval.syn  —  Evaluador de expresiones OO para el generador C
// ============================================================
// Visitante de expresiones del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - _oo_expr_a_c es el evaluador de expresiones recursivo que traduce
//     cualquier sub-arbol de expresion a una cadena C.
//   - Soporta: literales, identificadores, operaciones binarias/unarias,
//     llamadas a funcion, obtencion de direccion (&T) y desreferencia (*ptr).
// ============================================================

// ----------------------------------------------------------
// _oo_expr_a_c -- OO expression evaluator
// Traduce un nodo de expresion del AST a una representacion
// en cadena C, escribiendo el resultado en 'buf'.
// ----------------------------------------------------------
funcion _oo_expr_a_c(est: GeneradorCEst, nodo: puntero, buf: puntero, bufsz: entero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)nodo;")
        asm("char* _b = (char*)buf;")
        asm("int _sz = bufsz;")
        asm("if (!_n || !_b || _sz <= 0) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) { strcpy(_b, \"0\"); return; }")
        asm("_b[0] = 0;")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralNumero\")) {")
        asm("    struct LiteralNumero* _ln = (struct LiteralNumero*)_n;")
        asm("    snprintf(_b, _sz, \"%d\", _ln->valor);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralDecimal\")) {")
        asm("    // NOTE: No struct LiteralDecimal in ast_types.h yet.")
        asm("    // Using lexeme from the token IF accessible, otherwise snprintf float.")
        asm("    // The LiteralDecimal node in OO layer may have a token reference;")
        asm("    // for now emit 0.0f as safe default (micro-tests use ints).")
        asm("    extern char _gen_tmp_buf[4096];")
        asm("    // Try to snprintf from float valor if struct has it")
        asm("    struct LiteralNumero* _ld = (struct LiteralNumero*)_n;")
        asm("    snprintf(_b, _sz, \"%d.0f\", _ld->valor);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"Identificador\")) {")
        asm("    struct Identificador* _id = (struct Identificador*)_n;")
        asm("    if (_id->nombre.datos) strncpy(_b, _id->nombre.datos, _sz - 1);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralCadena\")) {")
        asm("    struct LiteralCadena* _lc = (struct LiteralCadena*)_n;")
        asm("    // Manual 8 S8.2 / paridad emit_expressions.py L159-169:")
        asm("    // escapar \\\\, \\\", \\n, \\r, \\t dentro del literal.")
        asm("    if (_lc->valor.datos && _lc->valor.longitud > 0) {")
        asm("        char _esc[4096]; int _ep = 0;")
        asm("        for (int _vi = 0; _vi < _lc->valor.longitud && _ep < 4090; _vi++) {")
        asm("            char _vc = _lc->valor.datos[_vi];")
        asm("            if (_vc == '\\\\') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\\'; }")
        asm("            else if (_vc == '\\\"') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\"'; }")
        asm("            else if (_vc == '\\n') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'n'; }")
        asm("            else if (_vc == '\\r') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'r'; }")
        asm("            else if (_vc == '\\t') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 't'; }")
        asm("            else { _esc[_ep++] = _vc; }")
        asm("        }")
        asm("        _esc[_ep] = 0;")
        asm("        snprintf(_b, _sz, \"(CadenaSegura){.longitud=%d,.datos=\\\"%s\\\"}\", _lc->valor.longitud, _esc);")
        asm("    } else {")
        asm("        strcpy(_b, \"(CadenaSegura){.longitud=0,.datos=\\\"\\\"}\");")
        asm("    }")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"OpBinaria\")) {")
        asm("    struct OpBinaria* _op = (struct OpBinaria*)_n;")
        asm("    char _izq[2048], _der[2048];")
        asm("    _izq[0] = _der[0] = 0;")
        asm("    if (_op->izquierdo) { _oo_expr_a_c(est, _op->izquierdo, _izq, 2048); }")
        asm("    if (_op->derecho) { _oo_expr_a_c(est, _op->derecho, _der, 2048); }")
        asm("    const char* _op_str = \"\";")
        asm("    int _ot = 0;")
        asm("    if (_op->operador) {")
        asm("        _ot = _op->operador->tipo;")
        asm("        switch (_ot) {")
        asm("            case 30: _op_str = \" + \"; break;")
        asm("            case 31: _op_str = \" - \"; break;")
        asm("            case 32: _op_str = \" * \"; break;")
        asm("            case 33: _op_str = \" / \"; break;")
        asm("            case 34: _op_str = \" % \"; break;  // ME-B7: T_MOD (34) faltaba en el switch")
        asm("            case 16: _op_str = \" > \"; break;")
        asm("            case 17: _op_str = \" < \"; break;")
        asm("            case 25: _op_str = \" == \"; break;")
        asm("            case 26: _op_str = \" != \"; break;")
        asm("            case 28: _op_str = \" >= \"; break;")
        asm("            case 27: _op_str = \" <= \"; break;")
        asm("            case 14: _op_str = \" && \"; break;")
        asm("            case 15: _op_str = \" || \"; break;")
        asm("            default: _op_str = \" ? \"; break;")
        asm("        }")
        asm("    }")
        asm("    // ME-B7 paridad emit_expressions.py L160-200 (tipo_de_expr + _es_str):")
        asm("    // decidir en TIEMPO DE GENERACION si un operando es texto (no macros _Generic,")
        asm("    // que gcc rechaza: valida todas las ramas y str_eq(int,int) es invalido).")
        asm("    // Un operando es texto si: LiteralCadena, o llamada a funcion que retorna")
        asm("    // cadena (via _G_native_tipo_retorno), o concat/entero_a_texto/leer_linea/subcadena.")
        asm("    int _ix_txt = 0, _dx_txt = 0;")
        asm("    struct Nodo* _nx0 = (struct Nodo*)_op->izquierdo;")
        asm("    struct Nodo* _nx1 = (struct Nodo*)_op->derecho;")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LiteralCadena\") == 0) _ix_txt = 1;")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"LiteralCadena\") == 0) _dx_txt = 1;")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfi = (struct LlamadaFuncion*)_nx0;")
        asm("        if (_lfi->nombre.datos) {")
        asm("            char _rti[64]; _rti[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_lfi->nombre.datos, _rti)) {")
        asm("                if (strcmp(_rti, \"cadena\") == 0 || strcmp(_rti, \"texto\") == 0 || strcmp(_rti, \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("            }")
        asm("            if (strcmp(_lfi->nombre.datos, \"concat\") == 0 || strcmp(_lfi->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_lfi->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_lfi->nombre.datos, \"leer_linea\") == 0 || strcmp(_lfi->nombre.datos, \"subcadena\") == 0) _ix_txt = 1;")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfd = (struct LlamadaFuncion*)_nx1;")
        asm("        if (_lfd->nombre.datos) {")
        asm("            char _rtd[64]; _rtd[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_lfd->nombre.datos, _rtd)) {")
        asm("                if (strcmp(_rtd, \"cadena\") == 0 || strcmp(_rtd, \"texto\") == 0 || strcmp(_rtd, \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("            }")
        asm("            if (strcmp(_lfd->nombre.datos, \"concat\") == 0 || strcmp(_lfd->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_lfd->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_lfd->nombre.datos, \"leer_linea\") == 0 || strcmp(_lfd->nombre.datos, \"subcadena\") == 0) _dx_txt = 1;")
        asm("        }")
        asm("    }")
        asm("    if (_ot == 25) {")
        asm("        if (_ix_txt || _dx_txt) { snprintf(_b, _sz, \"(str_eq(%s, %s) == 1)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s == %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    if (_ot == 26) {")
        asm("        if (_ix_txt || _dx_txt) { snprintf(_b, _sz, \"(str_eq(%s, %s) == 0)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s != %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    if (_ot == 30) {")
        asm("        // paridad _to_str2: el lado no-texto se convierte con entero_a_texto")
        asm("        if (_ix_txt && _dx_txt) { snprintf(_b, _sz, \"concat(%s, %s)\", _izq, _der); }")
        asm("        else if (_ix_txt) { snprintf(_b, _sz, \"concat(%s, entero_a_texto(%s))\", _izq, _der); }")
        asm("        else if (_dx_txt) { snprintf(_b, _sz, \"concat(entero_a_texto(%s), %s)\", _izq, _der); }")
        asm("        else { snprintf(_b, _sz, \"(%s + %s)\", _izq, _der); }")
        asm("        return;")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s%s\", _izq, _op_str, _der);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"OpUnaria\")) {")
        asm("    struct OpUnaria* _ou = (struct OpUnaria*)_n;")
        asm("    char _uexpr[2048]; _uexpr[0] = 0;")
        asm("    if (_ou->expr) { _oo_expr_a_c(est, _ou->expr, _uexpr, 2048); }")
        asm("    const char* _uop = \"\";")
        asm("    if (_ou->operador) {")
        asm("        int _ut = _ou->operador->tipo;")
        asm("        if (_ut == 31) { _uop = \"-\"; } else if (_ut == 16) { _uop = \"!\"; }")
        asm("    }")
        asm("    snprintf(_b, _sz, \"%s%s\", _uop, _uexpr);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_n;")
        asm("    // ME-B4: constructor de struct -> compound literal (paridad emit_expressions.py 'Struct constructor')")
        asm("    if (_lf->nombre.datos && _G_native_es_estructura(_lf->nombre.datos)) {")
        asm("        strcpy(_b, \"(struct \");")
        asm("        strcat(_b, _lf->nombre.datos);")
        asm("        strcat(_b, \"){\");")
        asm("        int _arg_idx = 0;")
        asm("        struct ListaNodo* _arg_cur = _lf->argumentos;")
        asm("        while (_arg_cur) {")
        asm("            struct Nodo* _arg_n = _arg_cur->cabeza;")
        asm("            if (_arg_n) {")
        asm("                if (_arg_idx > 0) strcat(_b, \", \");")
        asm("                char _arg_buf[4096]; _arg_buf[0] = 0;")
        asm("                _oo_expr_a_c(est, _arg_n, _arg_buf, 4096);")
        asm("                strcat(_b, _arg_buf);")
        asm("                _arg_idx++;")
        asm("            }")
        asm("            _arg_cur = _arg_cur->cola;")
        asm("        }")
        asm("        if (_arg_idx == 0) strcat(_b, \"0\");")
        asm("        strcat(_b, \"}\");")
        asm("        return;")
        asm("    }")
        asm("    if (_lf->nombre.datos) strcpy(_b, _lf->nombre.datos);")
        asm("    strcat(_b, \"(\");")
        asm("    int _arg_idx = 0;")
        asm("    struct ListaNodo* _arg_cur = _lf->argumentos;")
        asm("    while (_arg_cur) {")
        asm("        struct Nodo* _arg_n = _arg_cur->cabeza;")
        asm("        if (_arg_n) {")
        asm("            if (_arg_idx > 0) strcat(_b, \", \");")
        asm("            char _arg_buf[4096]; _arg_buf[0] = 0;")
        asm("            _oo_expr_a_c(est, _arg_n, _arg_buf, 4096);")
        asm("            strcat(_b, _arg_buf);")
        asm("            _arg_idx++;")
        asm("        }")
        asm("        _arg_cur = _arg_cur->cola;")
        asm("    }")
        asm("    strcat(_b, \")\");")
        asm("    return;")
        asm("}")
        asm("")
        // M22.5: ExprObtenerDireccion (&T) - ASSERT activo via gen_emitir_lifetime_assert
        asm("if (_syn_es_tipo(_t, \"ExprObtenerDireccion\")) {")
        asm("    extern int _G_safe_mode;")
        asm("    struct ExprObtenerDireccion* _eo = (struct ExprObtenerDireccion*)_n;")
        asm("    char _inner_buf[1024]; _inner_buf[0] = 0;")
        asm("    if (_eo->expr) { _oo_expr_a_c(est, _eo->expr, _inner_buf, 1024); }")
        asm("    if (_G_safe_mode) {")
        asm("        gen_emitir_lifetime_assert(est, \"_G_scope_depth >= 0\", \"LIFETIME: borrowed &T must outlive borrower\");")
        asm("    }")
        asm("    snprintf(_b, _sz, \"&(%s)\", _inner_buf);")
        asm("    return;")
        asm("}")
        // M22.5: ExprDereferencia (*ptr) - ASSERT activo via gen_emitir_lifetime_assert
        asm("if (_syn_es_tipo(_t, \"ExprDereferencia\")) {")
        asm("    extern int _G_safe_mode;")
        asm("    struct ExprDereferencia* _ed = (struct ExprDereferencia*)_n;")
        asm("    char _inner_buf2[1024]; _inner_buf2[0] = 0;")
        asm("    if (_ed->expr) { _oo_expr_a_c(est, _ed->expr, _inner_buf2, 1024); }")
        asm("    if (_G_safe_mode) {")
        asm("        gen_emitir_lifetime_assert(est, _inner_buf2, \"LIFETIME: dereferencing potentially dangling pointer\");")
        asm("    }")
        asm("    snprintf(_b, _sz, \"*(%s)\", _inner_buf2);")
        asm("    return;")
        asm("}")
        asm("// Fallback")
        asm("strcpy(_b, \"0\");")

// ===== From: nodos_flujo.syn =====

#lang: es

// ============================================================
// nodos_flujo.syn  —  Visitantes de control de flujo (OO style)
// ============================================================
// Visitantes para nodos del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - Cada visitante emite gen_emitir_traza() antes de emitir
//     codigo, para trazabilidad en el archivo C generado.
//   - Los bloques ( ) se emiten exclusivamente mediante
//     gen_abrir_bloque_c() y gen_cerrar_bloque_c() de emision_c.
//     Prohibida la emision manual de llaves con strings crudos.
//   - El dispatcher (gen_visitar_stmt_generico) tiene una rama
//     de fail-fast para tipos de nodo no reconocidos.
// ============================================================

// NOTA: _oo_expr_a_c se encuentra en expr_eval.syn (submodulo separado)

// ----------------------------------------------------------
// gen_visitar_si  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_si(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSi* _s = (struct SentenciaSi*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSi\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// if (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    if (\");")
        asm("_buf2[0] = 0;")
        asm("if (_s->condicion) { _oo_expr_a_c(est, _s->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// Visit if-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _ic = _s->cuerpo;")
        asm("    while (_ic) {")
        asm("        struct Nodo* _is = _ic->cabeza;")
        asm("        if (_is) { gen_visitar_stmt_generico(est, _is); }")
        asm("        _ic = _ic->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")
        asm("if (_s->cuerpo_sino) {")
        asm("    gen_emitir_str(est, \"    else\");")
        asm("    gen_abrir_bloque_c(est);")
        asm("    struct ListaNodo* _ec = _s->cuerpo_sino;")
        asm("    while (_ec) {")
        asm("        struct Nodo* _es = _ec->cabeza;")
        asm("        if (_es) { gen_visitar_stmt_generico(est, _es); }")
        asm("        _ec = _ec->cola;")
        asm("    }")
        asm("    gen_cerrar_bloque_c(est);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_mientras  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_mientras(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaMientras* _w = (struct SentenciaMientras*)stmt;")
        asm("if (!_w) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaMientras\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// while (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    while (\");")
        asm("_buf2[0] = 0;")
        asm("if (_w->condicion) { _oo_expr_a_c(est, _w->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// While-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _wc = _w->cuerpo;")
        asm("    while (_wc) {")
        asm("        struct Nodo* _ws = _wc->cabeza;")
        asm("        if (_ws) { gen_visitar_stmt_generico(est, _ws); }")
        asm("        _wc = _wc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_para  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_para(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaPara* _p = (struct SentenciaPara*)stmt;")
        asm("if (!_p) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaPara\");")
        asm("char _buf[4096], _init[512], _cond[512], _step[512];")
        asm("_init[0] = _cond[0] = _step[0] = 0;")
        asm("// Evaluate init, cond, step expressions")
        asm("if (_p->inicializacion) { _oo_expr_a_c(est, _p->inicializacion, _init, 512); }")
        asm("if (_p->condicion) { _oo_expr_a_c(est, _p->condicion, _cond, 512); }")
        asm("if (_p->incremento) { _oo_expr_a_c(est, _p->incremento, _step, 512); }")
        asm("// Emit: for (init; cond; step) {")
        asm("snprintf(_buf, 4096, \"    for (%s; %s; %s)\", _init, _cond, _step);")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// For-body via dispatcher")
        asm("{")
        asm("    struct Nodo* _fc = _p->cuerpo;")
        asm("    if (_fc) { gen_visitar_stmt_generico(est, _fc); }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_retornar
// ----------------------------------------------------------
funcion gen_visitar_retornar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)stmt;")
        asm("if (!_rt) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRetornar\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    return \");")
        asm("_buf2[0] = 0;")
        asm("if (_rt->expr) { _oo_expr_a_c(est, _rt->expr, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_declaracion
// ----------------------------------------------------------
funcion gen_visitar_declaracion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)stmt;")
        asm("if (!_dv) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"DeclaracionVariable\");")
        asm("if (!_dv->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: DeclaracionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Manual 8 S8.2 / paridad: literal string -> CadenaSegura (no const char*)")
        asm("const char* _var_type = \"int \";")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _dv->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_dv->expresion) { _oo_expr_a_c(est, _dv->expresion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.2: Track string vars for RAII pool_free at scope exit
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        // M22.3: RAII tracking — solo para expresiones GARANTIZADAS de retornar texto al heap
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto = 0;")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos) {")
        asm("    const char* _et = _dv->expresion->tipo.datos;")
        asm("    // Literal string — siempre texto al heap")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("    // LlamadaFuncion: solo si el nombre coincide con funciones que retornan texto")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto = 1;")
        asm("        }")
        asm("    }")
        asm("    // OpBinaria: + es texto solo si un operando es literal o var de texto (paridad tipo_de_expr)")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_dv->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_es_texto == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _dv->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _dv->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

funcion gen_visitar_asignacion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionVariable* _a = (struct AsignacionVariable*)stmt;")
        asm("if (!_a) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionVariable\");")
        asm("if (!_a->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: AsignacionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal assignment -> use const char*")
        asm("const char* _var_type = \"int \";")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("}")
        asm("// ME-B4: Struct constructor call -> struct <N> <var> = {0};")
        asm("const char* _struct_name = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf2 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf2->nombre.datos && _G_native_es_estructura(_lf2->nombre.datos)) { _struct_name = _lf2->nombre.datos; }")
        asm("}")
        asm("// ME-B6: inferir tipo desde retorno de funcion definida")
        asm("const char* _ret_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf3 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf3->nombre.datos) {")
        asm("        char _rtbuf[64]; _rtbuf[0] = 0;")
        asm("        if (_G_native_tipo_retorno(_lf3->nombre.datos, _rtbuf)) {")
        asm("            if (strcmp(_rtbuf, \"vacio\") != 0 && strcmp(_rtbuf, \"nulo\") != 0 && strcmp(_rtbuf, \"entero\") != 0) { _ret_type = _rtbuf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("// ME-B7 hoisting (paridad emit_declarations.py 'Pre-pass: hoist variable declarations'):")
        asm("// la primera asignacion declara la variable; las siguientes solo asignan.")
        asm("extern char _G_fn_vars[2048][64]; extern int _G_fn_vars_count;")
        asm("int _ya_decl = 0;")
        asm("for (int _vd = 0; _vd < _G_fn_vars_count; _vd++) { if (strcmp(_G_fn_vars[_vd], _a->nombre.datos) == 0) { _ya_decl = 1; break; } }")
        asm("if (!_ya_decl && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _a->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_vars_count++; }")
        asm("if (!_ya_decl) {")
        asm("    if (_struct_name) {")
        asm("        strcat(_buf, \"struct \"); strcat(_buf, _struct_name); strcat(_buf, \" \");")
        asm("    } else if (_ret_type) {")
        asm("        traducir_tipo_c((void*)_ret_type);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        strcat(_buf, _gen_tmp_buf); strcat(_buf, \" \");")
        asm("    } else {")
        asm("        strcat(_buf, _var_type);")
        asm("    }")
        asm("}")
        asm("strcat(_buf, _a->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_a->expresion) {")
        asm("    // ME-B4: constructor de struct emitido por _oo_expr_a_c como compound literal (struct X){0}")
        asm("    _oo_expr_a_c(est, _a->expresion, _buf2, 4096);")
        asm("}")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.3: RAII tracking — solo funciones y operadores garantizados de retornar texto
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto2 = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos) {")
        asm("    const char* _et = _a->expresion->tipo.datos;")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_a->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto2 = 1;")
        asm("        }")
        asm("    }")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_a->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_es_texto2 == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto2 == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto2) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _a->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _a->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_expr
// ----------------------------------------------------------
funcion gen_visitar_expr(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaExpr* _s = (struct SentenciaExpr*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaExpr\");")
        asm("char _buf[4096];")
        asm("_buf[0] = 0;")
        asm("// ME-B5: detectar asm(<cadena>) directo -> emitir instruccion cruda (paridad generator.py L203-232)")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _asm_lf = (struct LlamadaFuncion*)_s->expr;")
        asm("    if (_asm_lf->nombre.datos && strcmp(_asm_lf->nombre.datos, \"asm\") == 0 && _asm_lf->argumentos) {")
        asm("        struct Nodo* _asm_arg = (struct Nodo*)_asm_lf->argumentos->cabeza;")
        asm("        if (_asm_arg && _syn_es_tipo(_asm_arg->tipo.datos, \"LiteralCadena\")) {")
        asm("            struct LiteralCadena* _asm_lc = (struct LiteralCadena*)_asm_arg;")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud == 0) {")
        asm("                // asm(\"\") vacio: emitir sentencia vacia valida (paridad generator.py 'not trimmed')")
        asm("                gen_emitir_str(est, \";\");")
        asm("                return;")
        asm("            }")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud > 0) {")
        asm("                strncpy(_buf, _asm_lc->valor.datos, 4095);")
        asm("                _buf[4095] = 0;")
        asm("                int _l2 = (int)strlen(_buf);")
        asm("                while (_l2 > 0 && (_buf[_l2-1] == ' ' || _buf[_l2-1] == '\\t' || _buf[_l2-1] == '\\n')) _l2--;")
        asm("                int _needs_semi = 1;")
        asm("                if (_l2 == 0) _needs_semi = 0;")
        asm("                else if (_buf[0] == '#') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == ';') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '{') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '}') {")
        asm("                    int _pb = _l2 - 2;")
        asm("                    while (_pb >= 0 && (_buf[_pb] == ' ' || _buf[_pb] == '\\t' || _buf[_pb] == '\\n')) _pb--;")
        asm("                    if (_pb >= 0 && _buf[_pb] == ';') { _needs_semi = 0; }")
        asm("                    else {")
        asm("                        int _io = -1;")
        asm("                        for (int _j = _l2 - 2; _j >= 0; _j--) { if (_buf[_j] == '{') { _io = _j; break; } }")
        asm("                        if (_io < 0) _needs_semi = 0;")
        asm("                    }")
        asm("                }")
        asm("                if (_needs_semi) { strcat(_buf, \";\"); }")
        asm("                char _ebuf[4096];")
        asm("                int _ep = 0;")
        asm("                for (int _k = 0; _buf[_k] && _ep < 4095; _k++) {")
        asm("                    if (_buf[_k] == '\\n') { _ebuf[_ep++] = '\\\\'; _ebuf[_ep++] = 'n'; }")
        asm("                    else { _ebuf[_ep++] = _buf[_k]; }")
        asm("                }")
        asm("                _ebuf[_ep] = 0;")
        asm("                CadenaSegura _esc_cs = { .longitud = _ep, .datos = _ebuf };")
        asm("                gen_emitir_linea(est, _esc_cs);")
        asm("                return;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_s->expr) { _oo_expr_a_c(est, _s->expr, _buf, 4096); }")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

