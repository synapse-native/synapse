        asm("    extern int _G_safe_mode;")
        asm("    struct ExprDereferencia* _ed = (struct ExprDereferencia*)_n;")
        asm("    char _inner_buf2[1024]; _inner_buf2[0] = 0;")
        asm("    if (_ed->expr) { _oo_expr_a_c(est, _ed->expr, _inner_buf2, 1024); }")
        asm("    if (_G_safe_mode) {")
        asm("        gen_emitir_lifetime_assert(est, _inner_buf2, \"LIFETIME: dereferencing potentially dangling pointer\");")
        asm("    }")
        asm("    snprintf(_b, _sz, \"*(%s)\", _inner_buf2);")
        asm("    return;")
        asm("}")
        // ME-C3: ExprAccesoCampo lectura (paridad emit_expressions.py L315-329) - fix ft_estructura
        asm("if (_syn_es_tipo(_t, \"ExprAccesoCampo\")) {")
        asm("    struct ExprAccesoCampo* _ea = (struct ExprAccesoCampo*)_n;")
        asm("    char _obj_buf[4096]; _obj_buf[0] = 0;")
        asm("    if (_ea->objeto) { _oo_expr_a_c(est, _ea->objeto, _obj_buf, 4096); }")
        asm("    const char* _sep = \".\";")
        asm("    if (_ea->objeto && _ea->objeto->tipo.datos && strcmp(_ea->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _oidc = (struct Identificador*)_ea->objeto;")
        asm("        if (_oidc->nombre.datos) {")
