// --- Visit return ---
funcion gen_visitar_retornar(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _expr = _np[6];")
        asm("char _buf[4096];")
        asm("gen_emit_all_destructors(est, \"\");")
        asm("if (_expr > 0 && _expr < total_nodos) {")
        asm("    char _val[4096];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("    snprintf(_buf, 4096, \"return %s;\", _val);")
        asm("} else {")
        asm("    snprintf(_buf, 4096, \"return;\");")
        asm("}")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit expr statement ---
funcion gen_visitar_expr_stmt(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _expr = _np[6];")
        asm("if (_expr <= 0 || _expr >= total_nodos) return;")
        asm("int* _ep = (int*)nodos + _expr * 11;")
        asm("char _buf[4096];")
        asm("if (_ep[0] == 14) {")
        asm("    const char* _fn = (const char*)_ep[4];")
        asm("    if (_fn && strcmp(_fn, \"log\") == 0)")
        asm("        { gen_visitar_log(est, nodos, total_nodos, tokens, total_tokens, _expr); return; }")
        asm("}")
        asm("char _val[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("snprintf(_buf, 4096, \"%s;\", _val);")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit assignment ---
funcion gen_visitar_asignacion(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("int _expr = _np[6];")
        asm("if (!_name || _expr <= 0) return;")
        asm("char _val[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("int _vi = gen_find_var(est, _name);")
        asm("if (_vi < 0) {")
        asm("    gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _expr);")
        asm("    snprintf(_buf, 4096, \"%s %s = %s;\", _gen_tmp_buf, _name, _val);")
        asm("    gen_emitir_linea(est, _buf);")
        asm("    gen_add_var(est, _name, _gen_tmp_buf);")
        asm("} else {")
        asm("    snprintf(_buf, 4096, \"%s = %s;\", _name, _val);")
        asm("    gen_emitir_linea(est, _buf);")
        asm("}")

// --- Visit declaration ---
funcion gen_visitar_declaracion(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("const char* _type = (const char*)_np[5];")
        asm("int _expr = _np[6];")
        asm("if (!_name || !_type) return;")
        asm("char _val[4096] = \"\";")
        asm("if (_expr > 0 && _expr < total_nodos)")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("char _ct[64]; traducir_tipo_c(_type); strcpy(_ct, _gen_tmp_buf);")
        asm("char _buf[4096];")
        asm("int _vi = gen_find_var(est, _name);")
        asm("if (_vi < 0) {")
        asm("    if (_val[0]) snprintf(_buf, 4096, \"%s %s = %s;\", _ct, _name, _val);")
        asm("    else snprintf(_buf, 4096, \"%s %s = {0};\", _ct, _name);")
        asm("    gen_emitir_linea(est, _buf);")
        asm("    gen_add_var(est, _name, _ct);")
        asm("} else {")
        asm("    if (_val[0]) snprintf(_buf, 4096, \"%s = %s;\", _name, _val);")
        asm("    else snprintf(_buf, 4096, \"%s = {0};\", _name);")
        asm("    gen_emitir_linea(est, _buf);")
        asm("    gen_set_var_type(est, _vi, _ct);")
        asm("}")

// --- Visit struct ---
funcion gen_visitar_estructura(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("int _fields = _np[6];")
        asm("if (!_name) return;")
        asm("char _buf[4096], _buf2[4096];")
        asm("snprintf(_buf, 4096, \"typedef struct %s {\", _name);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("int _fcur = _fields;")
        asm("while (_fcur > 0 && _fcur < total_nodos) {")
        asm("    int* _fp = (int*)nodos + _fcur * 11;")
        asm("    if (_fp[0] == 15) {")
        asm("        const char* _fn = (const char*)_fp[4];")
        asm("        const char* _ft = (const char*)_fp[5];")
        asm("        traducir_tipo_c(_ft);")
        asm("        snprintf(_buf2, 4096, \"%s %s;\", _gen_tmp_buf, _fn);")
        asm("        gen_emitir_linea(est, _buf2);")
        asm("    }")
        asm("    _fcur = _fp[8];")
        asm("}")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("snprintf(_buf, 4096, \"} %s;\", _name);")
        asm("gen_emitir_linea(est, _buf);")
        asm("snprintf(_buf, 4096, \"static inline struct %s %s_nuevo() { struct %s _r = {0}; return _r; }\", _name, _name, _name);")
        asm("gen_emitir_linea(est, _buf);")
        asm("gen_emitir_nueva_linea(est);")
        asm("gen_agregar_struct_c(est, _name);")

// --- Visit constant ---
funcion gen_visitar_constante(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("int _expr = _np[6];")
        asm("if (!_name || _expr <= 0) return;")
        asm("char _val[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("snprintf(_buf, 4096, \"#define %s (%s)\", _name, _val);")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit extern ---
funcion gen_visitar_externo(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("const char* _ret = (const char*)_np[5];")
        asm("int _params = _np[6];")
        asm("if (!_name || !_ret) return;")
        asm("char _ret_c[64]; traducir_tipo_c(_ret); strcpy(_ret_c, _gen_tmp_buf);")
        asm("char _params_str[4096] = \"void\";")
        asm("int _ppos = 0, _first = 1;")
        asm("int _pcur = _params;")
        asm("while (_pcur > 0 && _pcur < total_nodos) {")
        asm("    int* _pp = (int*)nodos + _pcur * 11;")
        asm("    if (_pp[0] == 15) {")
        asm("        const char* _pn = (const char*)_pp[4];")
        asm("        const char* _pt = (const char*)_pp[5];")
        asm("        if (_first) { _ppos = 0; _first = 0; } else { _params_str[_ppos++] = ','; _params_str[_ppos++] = ' '; }")
        asm("        traducir_tipo_c(_pt);")
        asm("        int _k = 0; while (_gen_tmp_buf[_k]) _params_str[_ppos++] = _gen_tmp_buf[_k++];")
        asm("        _params_str[_ppos++] = ' ';")
        asm("        _k = 0; while (_pn[_k]) _params_str[_ppos++] = _pn[_k++];")
        asm("    }")
        asm("    _pcur = _pp[8];")
        asm("}")
        asm("_params_str[_ppos] = 0;")
        asm("char _buf[4096];")
        asm("snprintf(_buf, 4096, \"extern %s %s(%s);\", _ret_c, _name, _params_str);")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit log ---
funcion gen_visitar_log(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _args = _np[6];")
        asm("char _fmt[4096] = \"\"; int _fpos = 0;")
        asm("char _pr[4096] = \"\"; int _ppos = 0;")
        asm("int _first = 1;")
        asm("int _acur = _args;")
        asm("while (_acur > 0 && _acur < total_nodos) {")
        asm("    if (!_first) { _fmt[_fpos++] = ' '; } _first = 0;")
        asm("    _fmt[_fpos++] = '%'; _fmt[_fpos++] = 's';")
        asm("    char _arg_str[4096];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _acur, _arg_str, 4096);")
        asm("    if (_ppos > 0) { _pr[_ppos++] = ','; _pr[_ppos++] = ' '; }")
        asm("    int _k = 0; while (_arg_str[_k]) _pr[_ppos++] = _arg_str[_k++];")
        asm("    _acur = ((int*)nodos)[_acur * 11 + 8];")
        asm("}")
        asm("_fmt[_fpos] = 0; _pr[_ppos] = 0;")
        asm("char _buf[4096];")
        asm("if (_ppos > 0) {")
        asm("    snprintf(_buf, 4096, \"printf(\\\"%%s\\\\n\\\", %s);\", _pr);")
        asm("} else {")
        asm("    snprintf(_buf, 4096, \"printf(\\\"%%s\\\\n\\\");\");")
        asm("}")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit asignacion campo ---
funcion gen_visitar_asignacion_campo(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _campo = (const char*)_np[4];")
        asm("int _obj = _np[6];")
        asm("int _expr = _np[7];")
        asm("if (!_campo || _obj <= 0) return;")
        asm("char _obj_str[4096], _val[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _obj, _obj_str, 4096);")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _val, 4096);")
        asm("snprintf(_buf, 4096, \"%s.%s = %s;\", _obj_str, _campo, _val);")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit spawn ---
funcion gen_visitar_lanzar(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _call = _np[6];")
        asm("if (_call <= 0) return;")
        asm("int* _cp = (int*)nodos + _call * 11;")
        asm("char _buf[4096];")
        asm("if (_cp[0] == 14) {")
        asm("    const char* _fn = (const char*)_cp[4];")
        asm("    int _args = _cp[6];")
        asm("    char _arg_val[512] = \"\";")
        asm("    int _has_arg = 0;")
        asm("    if (_args > 0 && _args < total_nodos) {")
        asm("        gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _args, _arg_val, 512);")
        asm("        _has_arg = 1;")
        asm("    }")
        asm("    if (_has_arg) {")
        asm("        snprintf(_buf, 4096, \"synapse_lanzar_hilo((void*(*)(void*))%s, (void*)(intptr_t)(%s));\", _fn, _arg_val);")
        asm("    } else {")
        asm("        snprintf(_buf, 4096, \"synapse_lanzar_hilo((void*(*)(void*))%s, NULL);\", _fn);")
        asm("    }")
        asm("    gen_emitir_linea(est, _buf);")
        asm("}")

// --- Visit recover ---
funcion gen_visitar_recuperar(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _accion = _np[6];")
        asm("int _plan = _np[7];")
        asm("if (_accion <= 0 || _plan <= 0) return;")
        asm("char _acc_str[4096], _plan_str[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _accion, _acc_str, 4096);")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _plan, _plan_str, 4096);")
        asm("gen_emitir_linea(est, \"{\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("snprintf(_buf, 4096, \"if (%s != 0) { %s; }\", _acc_str, _plan_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")

// --- Visit listen ---
funcion gen_visitar_escuchar(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _canal = _np[6];")
        asm("int _respu = _np[7];")
        asm("if (_canal <= 0 || _respu <= 0) return;")
        asm("est.contador_listener = est.contador_listener + 1;")
        asm("int _lid = est.contador_listener;")
        asm("char _canal_str[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _canal, _canal_str, 4096);")
        asm("int* _rp = (int*)nodos + _respu * 11;")
        asm("const char* _rname = (_rp[0] == 14) ? (const char*)_rp[4] : \"/* error */\";")
        asm("if (!_rname) _rname = \"/* error */\";")
        asm("char _listener[4096];")
        asm("int _lpos = 0;")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"void* _listener_fn_%d(void* arg) {\", _lid);")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n    (void)arg;\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n    CanalConcurrencia* _canal = %s;\", _canal_str);")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n    while (1) {\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n        void* _paquete = canal_recibir(_canal);\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n        if (!_paquete) break;\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n        %s(_paquete);\", _rname);")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n    }\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n    return NULL;\");")
        asm("_lpos += snprintf(_listener + _lpos, 4096 - _lpos, \"\\n}\");")
        asm("strcpy(est.listener_funciones.datos + est.listener_total * 4096, _listener);")
        asm("est.listener_total = est.listener_total + 1;")
        asm("snprintf(_buf, 4096, \"pthread_t _listener_pth_%d;\", _lid);")
        asm("gen_emitir_linea(est, _buf);")
        asm("snprintf(_buf, 4096, \"pthread_create(&_listener_pth_%d, NULL, _listener_fn_%d, NULL);\", _lid, _lid);")
        asm("gen_emitir_linea(est, _buf);")
        asm("snprintf(_buf, 4096, \"pthread_detach(_listener_pth_%d);\", _lid);")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit channel send ---
funcion gen_visitar_enviar_canal(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _canal = _np[6];")
        asm("int _valor = _np[7];")
        asm("if (_canal <= 0 || _valor <= 0) return;")
        asm("char _canal_str[4096], _val_str[4096], _buf[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _canal, _canal_str, 4096);")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _valor, _val_str, 4096);")
        asm("gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _valor);")
        asm("if (strcmp(_gen_tmp_buf, \"int\") == 0) {")
        asm("    char _boxed[4096]; strcpy(_boxed, prim_int_to_ptr(_val_str).datos);")
        asm("    snprintf(_buf, 4096, \"canal_enviar(%s, %s);\", _canal_str, _boxed);")
        asm("} else if (strcmp(_gen_tmp_buf, \"float\") == 0) {")
        asm("    char _boxed[4096]; strcpy(_boxed, prim_float_to_ptr(_val_str).datos);")
        asm("    snprintf(_buf, 4096, \"canal_enviar(%s, %s);\", _canal_str, _boxed);")
        asm("} else {")
        asm("    snprintf(_buf, 4096, \"canal_enviar(%s, (void*)(%s));\", _canal_str, _val_str);")
        asm("}")
        asm("gen_emitir_linea(est, _buf);")

// --- Visit for loop ---
funcion gen_visitar_para(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _init = _np[6];")
        asm("int _cond = _np[7];")
        asm("int _inc = _np[8];")
        asm("int _body = _np[9];")
        asm("char _buf[4096];")
        asm("// Handle init")
        asm("if (_init > 0 && _init < total_nodos) {")
        asm("    int* _ip = (int*)nodos + _init * 11;")
        asm("    if (_ip[0] == 7) {")
        asm("        const char* _iname = (const char*)_ip[4];")
        asm("        int _iexpr = _ip[6];")
        asm("        char _ival[4096];")
        asm("        gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _iexpr, _ival, 4096);")
        asm("        if (_iname && gen_find_var(est, _iname) < 0) {")
        asm("            gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _iexpr);")
        asm("            snprintf(_buf, 4096, \"%s %s = %s;\", _gen_tmp_buf, _iname, _ival);")
        asm("            gen_emitir_linea(est, _buf);")
        asm("            gen_add_var(est, _iname, _gen_tmp_buf);")
        asm("        } else if (_iname) {")
        asm("            snprintf(_buf, 4096, \"%s = %s;\", _iname, _ival);")
        asm("            gen_emitir_linea(est, _buf);")
        asm("        }")
        asm("    }")
        asm("}")
        asm("char _cond_str[4096] = \"1\";")
        asm("if (_cond > 0 && _cond < total_nodos)")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _cond, _cond_str, 4096);")
        asm("char _inc_str[4096] = \"\";")
        asm("if (_inc > 0 && _inc < total_nodos) {")
        asm("    int* _ip2 = (int*)nodos + _inc * 11;")
        asm("    if (_ip2[0] == 7)")
        asm("        gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _ip2[6], _inc_str, 4096);")
        asm("}")
        asm("snprintf(_buf, 4096, \"for (; %s; %s) {\", _cond_str, _inc_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_push_scope(est);")
        asm("gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _body);")
        asm("gen_pop_scope(est);")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")

// --- Visit match ---
funcion gen_visitar_coincidir(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _expr = _np[6];")
        asm("int _casos = _np[7];")
        asm("if (_expr <= 0) return;")
        asm("char _expr_str[4096], _buf[4096], _buf2[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _expr_str, 4096);")
        asm("snprintf(_buf, 4096, \"/* match: %s */\", _expr_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("int _ccur = _casos, _caso_idx = 0;")
        asm("while (_ccur > 0 && _ccur < total_nodos) {")
        asm("    int* _cp = (int*)nodos + _ccur * 11;")
        asm("    if (_cp[0] == 39) {")
        asm("        const char* _tag = (const char*)_cp[4];")
        asm("        const char* _var = (const char*)_cp[5];")
        asm("        int _cuerpo = _cp[6];")
        asm("        if (_caso_idx == 0) {")
        asm("            snprintf(_buf, 4096, \"if (%s.tag == TAG_%s) {\", _expr_str, _tag);")
        asm("        } else {")
        asm("            snprintf(_buf, 4096, \"} else if (%s.tag == TAG_%s) {\", _expr_str, _tag);")
        asm("        }")
        asm("        gen_emitir_linea(est, _buf);")
        asm("        est.indent_actual = est.indent_actual + 1;")
        asm("        if (_var && _var[0]) {")
        asm("            snprintf(_buf2, 4096, \"int %s = %s.valor;\", _var, _expr_str);")
        asm("            gen_emitir_linea(est, _buf2);")
        asm("        }")
        asm("        gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _cuerpo);")
        asm("        est.indent_actual = est.indent_actual - 1;")
        asm("        _caso_idx = _caso_idx + 1;")
        asm("    }")
        asm("    _ccur = _cp[8];")
        asm("}")
        asm("if (_caso_idx > 0) gen_emitir_linea(est, \"}\");")

// --- Expression to C string ---
funcion gen_expr_a_c(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero, buf: puntero, bufsz: entero) -> nulo:
    inseguro:
        asm("if (idx <= 0 || idx >= total_nodos) { snprintf(buf, bufsz, \"0\"); return; }")
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _tipo = _np[0];")
        asm("const char* _str = _np[4] ? (const char*)_np[4] : \"\";")
        asm("int _vint = _np[3];")
        asm("char _l[4096], _r[4096];")
        asm("")
        asm("if (_tipo == 9)  { snprintf(buf, bufsz, \"%d\", _vint); return; }")
        asm("if (_tipo == 10) { snprintf(buf, bufsz, \"%ff\", *(float*)&_vint); return; }")
        asm("if (_tipo == 11) { int _len = _np[5]; snprintf(buf, bufsz, \"(CadenaSegura){.longitud=%d,.datos=(char*)%s}\", _len, _str); return; }")
        asm("if (_tipo == 8)  {")
        asm("    if (strcmp(_str, \"nulo\") == 0) { snprintf(buf, bufsz, \"NULL\"); return; }")
        asm("    snprintf(buf, bufsz, \"%s\", _str); return;")
        asm("}")
        asm("if (_tipo == 12) { // OpBinaria")
        asm("    int _op = _np[5]; int _izq = _np[6]; int _der = _np[7];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _izq, _l, 4096);")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _der, _r, 4096);")
        asm("    const char* _os = \"+\";")
        asm("    if (_op == 25) _os = \"==\"; else if (_op == 26) _os = \"!=\";")
        asm("    else if (_op == 23) _os = \">\"; else if (_op == 24) _os = \"<\";")
        asm("    else if (_op == 27) _os = \"<=\"; else if (_op == 28) _os = \">=\";")
        asm("    else if (_op == 30) _os = \"+\"; else if (_op == 31) _os = \"-\";")
        asm("    else if (_op == 32) _os = \"*\"; else if (_op == 33) _os = \"/\";")
        asm("    else if (_op == 34) _os = \"%\"; else if (_op == 14) _os = \"&&\";")
        asm("    else if (_op == 15) _os = \"||\";")
        asm("    snprintf(buf, bufsz, \"(%s %s %s)\", _l, _os, _r); return;")
        asm("}")
        asm("if (_tipo == 13) { // OpUnaria")
        asm("    int _op = _np[5]; int _expr = _np[6];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _expr, _l, 4096);")
        asm("    const char* _os = \"-\";")
        asm("    if (_op == 30) _os = \"+\"; else if (_op == 16) _os = \"!\";")
        asm("    snprintf(buf, bufsz, \"(%s%s)\", _os, _l); return;")
        asm("}")
        asm("if (_tipo == 14) { // LlamadaFuncion")
        asm("    char _fn[256]; strcpy(_fn, _str);")
        asm("    for (char* _p = _fn; *_p; _p++) if (*_p == '.') *_p = '_';")
        asm("    int _args = _np[6];")
        asm("    char _args_str[4096] = \"\"; int _apos = 0; int _acur = _args;")
        asm("    while (_acur > 0 && _acur < total_nodos) {")
        asm("        if (_apos > 0) { _args_str[_apos++] = ','; _args_str[_apos++] = ' '; }")
        asm("        gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _acur, _l, 4096);")
        asm("        int _k = 0; while (_l[_k]) _args_str[_apos++] = _l[_k++];")
        asm("        _acur = ((int*)nodos)[_acur * 11 + 8];")
        asm("    }")
        asm("    _args_str[_apos] = 0;")
        asm("    snprintf(buf, bufsz, \"%s(%s)\", _fn, _args_str); return;")
        asm("}")
        asm("if (_tipo == 31) { // AccesoCampo")
        asm("    int _obj = _np[6];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _obj, _l, 4096);")
        asm("    snprintf(buf, bufsz, \"%s.%s\", _l, _str); return;")
        asm("}")
        asm("if (_tipo == 22) { snprintf(buf, bufsz, \"%d\", _vint ? 1 : 0); return; }")
        asm("if (_tipo == 28) { // Tensor")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _np[6], _l, 4096);")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _np[7], _r, 4096);")
        asm("    snprintf(buf, bufsz, \"(Tensor){.filas=%s,.columnas=%s,.datos=(float*)calloc(%s*%s,sizeof(float))}\", _l, _r, _l, _r); return;")
        asm("}")
        asm("if (_tipo == 30 || _tipo == 36 || _tipo == 37) {")
        asm("    int _inner = _np[6];")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _inner, _l, 4096);")
        asm("    if (_tipo == 36) { snprintf(buf, bufsz, \"(&%s)\", _l); return; }")
        asm("    if (_tipo == 37) { snprintf(buf, bufsz, \"(*%s)\", _l); return; }")
        asm("    snprintf(buf, bufsz, \"%s\", _l); return;")
        asm("}")
        asm("if (_tipo == 40) { snprintf(buf, bufsz, \"%s\", _str); return; }")
        asm("if (_tipo == 41) {")
        asm("    if (_np[6] > 0 && _np[6] < total_nodos) {")
        asm("        gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _np[6], _l, 4096);")
        asm("        snprintf(buf, bufsz, \"canal_crear(%s)\", _l);")
        asm("    } else snprintf(buf, bufsz, \"canal_crear(10)\");")
        asm("    return;")
        asm("}")
        asm("if (_tipo == 43) {")
        asm("    gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _np[6], _l, 4096);")
        asm("    snprintf(buf, bufsz, \"(Resultado_T){.es_ok=1,.datos={.ok_valor=canal_recibir(%s)}}\", _l); return;")
        asm("}")
        asm("snprintf(buf, bufsz, \"/*?*/\");")

// --- Type inference for expression ---
funcion gen_tipo_de_expr(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("if (idx <= 0 || idx >= total_nodos) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _tipo = _np[0];")
        asm("const char* _str = _np[4] ? (const char*)_np[4] : \"\";")
        asm("")
        asm("if (_tipo == 9) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (_tipo == 10) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("if (_tipo == 11) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("if (_tipo == 22) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (_tipo == 28) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("if (_tipo == 36) { gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[6]);")
        asm("    char _tmp[64]; strcpy(_tmp, _gen_tmp_buf); snprintf(_gen_tmp_buf, 64, \"%s*\", _tmp); return; }")
        asm("if (_tipo == 37) { gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[6]);")
        asm("    int _len = (int)strlen(_gen_tmp_buf); if (_len > 0 && _gen_tmp_buf[_len-1] == '*') _gen_tmp_buf[_len-1] = 0; return; }")
        asm("if (_tipo == 30) { gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[6]); return; }")
        asm("if (_tipo == 12) {")
        asm("    gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[6]); char _lt[64]; strcpy(_lt, _gen_tmp_buf);")
        asm("    gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[7]);")
        asm("    if (strcmp(_lt, \"CadenaSegura\")==0 && strcmp(_gen_tmp_buf, \"CadenaSegura\")==0) return;")
        asm("    if (strcmp(_lt, \"float\")==0 || strcmp(_gen_tmp_buf, \"float\")==0) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("    strcpy(_gen_tmp_buf, \"int\"); return;")
        asm("}")
        asm("if (_tipo == 13) { gen_tipo_de_expr(est, nodos, total_nodos, tokens, total_tokens, _np[6]);")
        asm("    if (strcmp(_gen_tmp_buf, \"float\") != 0) strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (_tipo == 8) {")
        asm("    if (strcmp(_str, \"nulo\") == 0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("    int _vi = gen_find_var(est, _str);")
        asm("    if (_vi >= 0) { strcpy(_gen_tmp_buf, (const char*)est.var_tipos + _vi * 64); return; }")
        asm("    strcpy(_gen_tmp_buf, \"int\"); return;")
        asm("}")
        asm("if (_tipo == 14) {")
        asm("    if (strcmp(_str, \"_argc\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("    if (strcmp(_str, \"_argv\")==0||strcmp(_str,\"leer\")==0||strcmp(_str,\"leer_linea\")==0||strcmp(_str,\"concat\")==0||strcmp(_str,\"decimal_a_texto\")==0||strcmp(_str,\"entero_a_texto\")==0) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("    if (strcmp(_str, \"abrir\")==0) { strcpy(_gen_tmp_buf, \"Canal\"); return; }")
        asm("    if (strcmp(_str, \"cerrar\")==0||strcmp(_str,\"salir\")==0||strcmp(_str,\"escribir\")==0||strcmp(_str,\"escribir_linea\")==0||strcmp(_str,\"libera\")==0||strcmp(_str,\"volcar_ast\")==0||strcmp(_str,\"canal_enviar\")==0||strcmp(_str,\"cerrar_canal\")==0) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("    if (strcmp(_str, \"tokenizar\")==0||strcmp(_str,\"texto_a_entero\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("    if (strcmp(_str, \"generar\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("    if (strcmp(_str, \"texto_a_decimal\")==0) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("    if (strcmp(_str, \"parsear\")==0) { strcpy(_gen_tmp_buf, \"struct Programa\"); return; }")
        asm("    if (strcmp(_str, \"reserva\")==0||strcmp(_str,\"suma\")==0||strcmp(_str,\"producto\")==0||strcmp(_str,\"relu\")==0||strcmp(_str,\"crear_tensor\")==0||strcmp(_str,\"suma_tensor\")==0||strcmp(_str,\"producto_punto\")==0) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("    if (strcmp(_str, \"canal_crear\")==0) { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        asm("    if (strcmp(_str, \"canal_recibir\")==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("    strcpy(_gen_tmp_buf, gen_func_return_type(est, _str));")
        asm("    if (_gen_tmp_buf[0]) return;")
        asm("    strcpy(_gen_tmp_buf, \"int\"); return;")
        asm("}")
        asm("if (_tipo == 31||_tipo==40) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (_tipo == 41) { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        asm("if (_tipo == 43) { strcpy(_gen_tmp_buf, \"Resultado_T\"); return; }")
        asm("strcpy(_gen_tmp_buf, \"int\");")

// --- Special emitter: tokenizar (generate C tokenizer function) ---
funcion gen_emitir_tokenizar_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("gen_emitir_linea(est, \"int tokenizar(CadenaSegura fuente) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"int _i = 0, _linea = 1, _columna = 1, _token_count = 0;\");")
        asm("gen_emitir_linea(est, \"while (_i < fuente.longitud) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"char _c = fuente.datos[_i];\");")
        asm("gen_emitir_linea(est, \"if (_c==' '||_c=='\\\\t') { _i++; _columna++; continue; }\");")
        asm("gen_emitir_linea(est, \"if (_c=='\\\\r') { _i++; continue; }\");")
        asm("gen_emitir_linea(est, \"if (_c=='\\\\n') { _i++; _linea++; _columna=1; continue; }\");")
        asm("gen_emitir_linea(est, \"if (_c=='/'&&_i+1<fuente.longitud&&fuente.datos[_i+1]=='/') { while(_i<fuente.longitud&&fuente.datos[_i]!='\\\\n')_i++; continue; }\");")
        asm("gen_emitir_linea(est, \"if (_c=='\\\\\"'||_c=='\\\\'') { char _q=_c; int _st=_i; _i++; _columna++; while(_i<fuente.longitud&&fuente.datos[_i]!=_q){_i++;_columna++;} if(_i>=fuente.longitud){fprintf(stderr,\\\"  TOKEN STRING_UNCLOSED L%d:%d\\\\n\\\",_linea,_columna);break;} _i++;_columna++;_token_count++;fprintf(stderr,\\\"  TOKEN STRING L%d:%d\\\\n\\\",_linea,_columna); }\");")
        asm("gen_emitir_linea(est, \"else if(_c>='0'&&_c<='9'){int _st=_i;while(_i<fuente.longitud&&fuente.datos[_i]>='0'&&fuente.datos[_i]<='9')_i++;_columna+=_i-_st;_token_count++;fprintf(stderr,\\\"  TOKEN NUMBER L%d:%d\\\\n\\\",_linea,_columna);}\");")
        asm("gen_emitir_linea(est, \"else if((_c>='a'&&_c<='z')||(_c>='A'&&_c<='Z')||_c=='_'){int _st=_i;while(_i<fuente.longitud&&((fuente.datos[_i]>='a'&&fuente.datos[_i]<='z')||(fuente.datos[_i]>='A'&&fuente.datos[_i]<='Z')||(fuente.datos[_i]>='0'&&fuente.datos[_i]<='9')||fuente.datos[_i]=='_'))_i++;_columna+=_i-_st;_token_count++;fprintf(stderr,\\\"  TOKEN IDENTIFIER L%d:%d\\\\n\\\",_linea,_columna);}\");")
        asm("gen_emitir_linea(est, \"else{_i++;_columna++;_token_count++;fprintf(stderr,\\\"  TOKEN CHAR(%%c)L%d:%d\\\\n\\\",_c,_linea,_columna);}\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_linea(est, \"fprintf(stderr,\\\"Total tokens: %%d\\\\n\\\",_token_count);\");")
        asm("gen_emitir_linea(est, \"return _token_count;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")

// --- Special emitter: parsear (generate C parser wrappers) ---
funcion gen_emitir_parsear_c(est: GeneradorCEst) -> nulo:
    gen_emitir_token_defs(est)
    inseguro:
        asm("// Emit P_tokenizar function")
        asm("gen_emitir_linea(est, \"void _P_tokenizar(const char* s, int len) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"int i=0,li=1,co=1;\");")
        asm("gen_emitir_linea(est, \"while(i<len&&_P_ntks<MAX_TOKS-1){\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"char c=s[i];\");")
        asm("gen_emitir_linea(est, \"if(c==' '||c=='\\\\t'){i++;co++;continue;}\");")
        asm("gen_emitir_linea(est, \"if(c=='\\\\r'){i++;continue;}\");")
        asm("gen_emitir_linea(est, \"if(c=='\\\\n'){\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"_P_tks[_P_ntks].tipo=T_NL;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=0;_P_ntks++;i++;li++;co=1;\");")
        asm("gen_emitir_linea(est, \"while(i<len&&(s[i]==' '||s[i]=='\\\\t')){if(s[i]==' ')co++;else co+=4;i++;}\");")
        asm("gen_emitir_linea(est, \"if(i<len&&s[i]=='\\\\n')continue;\");")
        asm("gen_emitir_linea(est, \"if(i<len&&s[i]=='#'){while(i<len&&s[i]!='\\\\n')i++;continue;}\");")
        asm("gen_emitir_linea(est, \"if(i<len&&s[i]=='/'&&i+1<len&&s[i+1]=='/'){while(i<len&&s[i]!='\\\\n')i++;continue;}\");")
        asm("gen_emitir_linea(est, \"{int _sp=co-1;if(_sp>_P_pila_indent[_P_nivel_pila]){_P_nivel_pila++;_P_pila_indent[_P_nivel_pila]=_sp;_P_tks[_P_ntks].tipo=T_INDENT;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=0;_P_ntks++;}else if(_sp<_P_pila_indent[_P_nivel_pila]){while(_P_nivel_pila>0&&_sp<_P_pila_indent[_P_nivel_pila]){_P_tks[_P_ntks].tipo=T_DEDENT;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=0;_P_ntks++;_P_nivel_pila--;}}}\");")
        asm("gen_emitir_linea(est, \"continue;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("// Single-char tokens and identifiers... ")
        asm("gen_emitir_linea(est, \"if(c=='\\\\\"'||c=='\\\\''){char q=c;int st=i;int scol=co;i++;co++;while(i<len&&s[i]!=q){i++;co++;}if(i>=len)break;i++;co++;int vl=(i-st-2)<255?(i-st-2):255;strncpy(_P_tks[_P_ntks].val,s+st+1,vl);_P_tks[_P_ntks].val[vl]=0;_P_tks[_P_ntks].tipo=T_STR;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=scol;_P_ntks++;continue;}\");")
        asm("gen_emitir_linea(est, \"if(c>='0'&&c<='9'){int st=i;int scol=co;while(i<len&&s[i]>='0'&&s[i]<='9')i++;if(i<len&&s[i]=='.'){i++;while(i<len&&s[i]>='0'&&s[i]<='9')i++;}int vl=(i-st)<255?(i-st):255;strncpy(_P_tks[_P_ntks].val,s+st,vl);_P_tks[_P_ntks].val[vl]=0;_P_tks[_P_ntks].tipo=T_NUM;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=scol;_P_ntks++;co+=i-st;continue;}\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_linea(est, \"while(_P_nivel_pila>0){_P_tks[_P_ntks].tipo=T_DEDENT;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=0;_P_ntks++;_P_nivel_pila--;}\");")
        asm("gen_emitir_linea(est, \"_P_tks[_P_ntks].tipo=T_EOF;_P_tks[_P_ntks].linea=li;_P_tks[_P_ntks].col=0;_P_ntks++;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("")
        asm("gen_emitir_linea(est, \"static void _P_procesar_indentacion_final() {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"while(_P_nivel_pila>0){_P_tks[_P_ntks].tipo=T_DEDENT;_P_tks[_P_ntks].linea=_P_tks[_P_ntks-1].linea;_P_tks[_P_ntks].col=0;_P_ntks++;_P_nivel_pila--;}\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("")
        asm("// Parser entry point")
        asm("gen_emitir_linea(est, \"struct Programa parsear(CadenaSegura fuente) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"_P_ntks=0;_P_tpos=0;_P_p_err=0;_P_nivel_pila=0;\");")
        asm("gen_emitir_linea(est, \"_P_pila_indent[0]=0;\");")
        asm("gen_emitir_linea(est, \"_P_tokenizar(fuente.datos,fuente.longitud);\");")
        asm("gen_emitir_linea(est, \"_P_procesar_indentacion_final();\");")
        asm("gen_emitir_linea(est, \"struct Programa _prog={0};\");")
        asm("gen_emitir_linea(est, \"return _prog;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")

// --- Special emitter: generar (C code that self-generates C) ---
funcion gen_emitir_generar_c(est: GeneradorCEst) -> nulo:
    gen_emitir_token_defs(est)
    inseguro:
        asm("// Emit _gen helper functions")
        asm("gen_emitir_linea(est, \"// --- AST Walker (auto-generado) ---\");")
        asm("gen_emitir_linea(est, \"// Global state from estado_global.syn\");")
        asm("gen_emitir_linea(est, \"int _G_indent = 0;\");")
        asm("gen_emitir_linea(est, \"FILE* _G_out = NULL;\");")
        asm("gen_emitir_linea(est, \"char _G_vn[1024][64] = {{0}};\");")
        asm("gen_emitir_linea(est, \"char _G_vt[1024][64] = {{0}};\");")
        asm("gen_emitir_linea(est, \"int _G_nv = 0;\");")
        asm("gen_emitir_linea(est, \"char _G_ret_type[64] = {0};\");")
        asm("gen_emitir_linea(est, \"char _G_extern_names[64][64] = {{0}};\");")
        asm("gen_emitir_linea(est, \"char _G_extern_params[64][256] = {{0}};\");")
        asm("gen_emitir_linea(est, \"int _G_nextern = 0;\");")
        asm("gen_emitir_linea(est, \"char _G_snames[64][64] = {{0}};\");")
        asm("gen_emitir_linea(est, \"int _G_nsnames = 0;\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("gen_emitir_linea(est, \"void _G_reset() { _G_nv = 0; }\");")
        asm("gen_emitir_linea(est, \"int _G_find(const char* n) { for(int i=0;i<_G_nv;i++) if(strcmp(_G_vn[i],n)==0) return i; return -1; }\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("gen_emitir_linea(est, \"void _G_emit(const char* s) { for(int i=0;i<_G_indent;i++) fprintf(_G_out,\\\"    \\\"); fprintf(_G_out,\\\"%s\\\\n\\\",s); }\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("// Main generar function")
        asm("gen_emitir_linea(est, \"int generar(struct Programa programa, CadenaSegura ruta) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"char sal[1024]; int sl=ruta.longitud;\");")
        asm("gen_emitir_linea(est, \"if(sl>4&&ruta.datos[sl-4]=='.'&&(ruta.datos[sl-3]=='s'||ruta.datos[sl-3]=='S')&&(ruta.datos[sl-2]=='y'||ruta.datos[sl-2]=='Y')&&(ruta.datos[sl-1]=='n'||ruta.datos[sl-1]=='N')){memcpy(sal,ruta.datos,sl-4);sal[sl-4]='.';sal[sl-3]='c';sal[sl-2]=0;}else snprintf(sal,sizeof(sal),\\\"%.*s.c\\\",ruta.longitud,ruta.datos);\");")
        asm("gen_emitir_linea(est, \"_G_out=fopen(sal,\\\"w\\\"); if(!_G_out){fprintf(stderr,\\\"Error: no se puede crear %%s\\\\n\\\",sal);return 1;}\");")
        asm("gen_emitir_linea(est, \"fprintf(_G_out,\\\"// Generado por Synapse (auto-hospedado)\\\\n\\\");\");")
        asm("gen_emitir_linea(est, \"fprintf(_G_out,\\\"#include <stdio.h>\\\\n#include <stdlib.h>\\\\n#include <stdint.h>\\\\n#include <string.h>\\\\n#include <pthread.h>\\\\n\\\");\");")
        asm("gen_emitir_linea(est, \"fprintf(_G_out,\\\"typedef struct {int longitud;const char* datos;} CadenaSegura;\\\\n\\\");\");")
        asm("gen_emitir_linea(est, \"fclose(_G_out);\");")
        asm("gen_emitir_linea(est, \"return 0;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")

// --- Special emitter: volcar_ast ---
funcion gen_emitir_volcar_ast_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("gen_emitir_linea(est, \"void volcar_ast(struct Nodo* nodo, int nivel) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"if(!nodo){printf(\\\"(null)\\\\n\\\");return;}\");")
        asm("gen_emitir_linea(est, \"for(int i=0;i<nivel;i++)printf(\\\"  \\\");\");")
        asm("gen_emitir_linea(est, \"printf(\\\"[%%s]\\\\n\\\",nodo->tipo.datos);\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")

// --- Scope management (called from generated code) ---
funcion gen_push_scope(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("est.scope_stack_top = est.scope_stack_top + 1;")
        asm("est.scope_stack_at = est.scope_stack_at + 1;")
        asm("est.scope_var_total = 0;")

funcion gen_pop_scope(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("est.scope_stack_top = est.scope_stack_top - 1;")
        asm("if (est.scope_stack_top < 0) est.scope_stack_top = 0;")
        asm("est.scope_stack_at = est.scope_stack_top;")
        asm("est.scope_var_total = 0;")

funcion gen_emit_all_destructors(est: GeneradorCEst, exclude_var: puntero) -> nulo:
    inseguro:
        asm("(void)est; (void)exclude_var; // stub")

// --- Main C code generation entry point ---
funcion generar(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero) -> entero:
    r = 0
    inseguro:
        asm("// generar: main generation entry point")
        asm("// Emit header")
        asm("gen_emitir_linea(est, \"// Generado por Synapse (auto-hospedado)\");")
        asm("gen_emitir_linea(est, \"#include <stdio.h>\");")
        asm("gen_emitir_linea(est, \"#include <stdlib.h>\");")
        asm("gen_emitir_linea(est, \"#include <stdint.h>\");")
        asm("gen_emitir_linea(est, \"#include <string.h>\");")
        asm("gen_emitir_linea(est, \"#include <pthread.h>\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("gen_emitir_linea(est, \"typedef struct { int longitud; const char* datos; } CadenaSegura;\");")
        asm("gen_emitir_linea(est, \"typedef struct { uint32_t filas; uint32_t columnas; float* datos; int es_mapeado; } Tensor;\");")
        asm("gen_emitir_linea(est, \"typedef struct { FILE* stream; int es_valido; int es_virtual; const char* virtual_data; int virtual_len; } Canal;\");")
        asm("gen_emitir_linea(est, \"#define POOL_BLOQUES 64\");")
        asm("gen_emitir_linea(est, \"#define TAMANO_BLOQUE 4096\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("// External runtime declarations")
        asm("gen_emitir_linea(est, \"extern void escribir(CadenaSegura contenido);\");")
        asm("gen_emitir_linea(est, \"extern void escribir_linea(CadenaSegura contenido);\");")
        asm("gen_emitir_linea(est, \"extern CadenaSegura leer_linea(void);\");")
        asm("gen_emitir_linea(est, \"extern Canal abrir(CadenaSegura ruta, CadenaSegura modo);\");")
        asm("gen_emitir_linea(est, \"extern CadenaSegura leer(Canal canal);\");")
        asm("gen_emitir_linea(est, \"extern void cerrar(Canal canal);\");")
        asm("gen_emitir_linea(est, \"extern Tensor crear_tensor(int filas, int columnas);\");")
        asm("gen_emitir_linea(est, \"extern Tensor suma_tensor(Tensor a, Tensor b);\");")
        asm("gen_emitir_linea(est, \"extern Tensor producto_punto(Tensor a, Tensor b);\");")
        asm("gen_emitir_linea(est, \"extern Tensor relu(Tensor a);\");")
        asm("gen_emitir_linea(est, \"extern Tensor reserva(int tamano);\");")
        asm("gen_emitir_linea(est, \"extern void libera(Tensor bloque);\");")
        asm("gen_emitir_linea(est, \"extern Tensor suma(Tensor a, Tensor b);\");")
        asm("gen_emitir_linea(est, \"extern Tensor producto(Tensor a, Tensor b);\");")
        asm("gen_emitir_linea(est, \"extern int texto_a_entero(CadenaSegura str);\");")
        asm("gen_emitir_linea(est, \"extern float texto_a_decimal(CadenaSegura str);\");")
        asm("gen_emitir_linea(est, \"extern CadenaSegura decimal_a_texto(float n);\");")
        asm("gen_emitir_linea(est, \"extern CadenaSegura entero_a_texto(int n);\");")
        asm("gen_emitir_linea(est, \"extern void synapse_lanzar_hilo(void* (*fn)(void*), void* arg);\");")
        asm("gen_emitir_linea(est, \"extern void synapse_esperar_hilos(void);\");")
        asm("gen_emitir_linea(est, \"extern void pool_init(uint32_t total_blocks, uint32_t block_size);\");")
        asm("gen_emitir_linea(est, \"extern void pool_free(void* ptr);\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("// Builtin functions")
        asm("gen_emitir_linea(est, \"static int _g_argc;\");")
        asm("gen_emitir_linea(est, \"static char** _g_argv;\");")
        asm("gen_emitir_linea(est, \"int _argc() { return _g_argc; }\");")
        asm("gen_emitir_linea(est, \"CadenaSegura _argv(int i) { if(i<0||i>=_g_argc)return (CadenaSegura){0,(char*)\\\"\\\"}; return (CadenaSegura){.longitud=(int)strlen(_g_argv[i]),.datos=_g_argv[i]}; }\");")
        asm("gen_emitir_linea(est, \"void salir(int c) { exit(c); }\");")
        asm("gen_emitir_nueva_linea(est);")
        asm("// Forward struct declarations")
        asm("for (int _ni = 0; _ni < total_nodos; _ni++) {")
        asm("    if (((int*)nodos)[_ni * 11 + 0] == 16) {")
        asm("        const char* _sn = (const char*)((int*)nodos)[_ni * 11 + 4];")
        asm("        if (_sn) { char _fwd[256]; snprintf(_fwd, 256, \"struct %s;\", _sn); gen_emitir_linea(est, _fwd); }")
        asm("    }")
        asm("}")
        asm("gen_emitir_nueva_linea(est);")
        asm("// Build function return types map")
        asm("for (int _ni = 0; _ni < total_nodos; _ni++) {")
        asm("    int* _np = (int*)nodos + _ni * 11;")
        asm("    if (_np[0] == 2) {")
        asm("        const char* _fn = (const char*)_np[4];")
        asm("        const char* _ft = (const char*)_np[5];")
        asm("        if (_fn && _ft) gen_agregar_return_type(est, _fn, _ft);")
        asm("    }")
        asm("}")
        asm("// Visit all top-level statements")
        asm("for (int _ni = 0; _ni < total_nodos; _ni++) {")
        asm("    gen_visitar_nodo(est, nodos, total_nodos, tokens, total_tokens, _ni);")
        asm("}")
        asm("// Emit listener functions")
        asm("for (int _li = 0; _li < est.listener_total; _li++) {")
        asm("    gen_emitir_linea(est, (const char*)est.listener_funciones + _li * 4096);")
        asm("    gen_emitir_nueva_linea(est);")
        asm("}")
        asm("// Emit main()")
        asm("gen_emitir_linea(est, \"int main(int argc, char** argv) {\");")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_emitir_linea(est, \"int _g_argc = argc;\");")
        asm("gen_emitir_linea(est, \"char** _g_argv = argv;\");")
        asm("gen_emitir_linea(est, \"pool_init(POOL_BLOQUES, TAMANO_BLOQUE);\");")
        asm("gen_emitir_linea(est, \"principal();\");")
        asm("gen_emitir_linea(est, \"synapse_esperar_hilos();\");")
        asm("gen_emitir_linea(est, \"return 0;\");")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("r = 0")
    retornar r
