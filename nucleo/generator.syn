        asm("char _buf[4096];")
        asm("snprintf(_buf, 4096, \"while (%s) {\", _cond_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_push_scope(est);")
        asm("gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _body);")
