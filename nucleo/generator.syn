// ===== From: nodos_flujo.syn =====

#lang: es

// ============================================================
// nodos_flujo.syn  -  Visitantes de control de flujo (OO style)
// ============================================================
// Visitantes para nodos del AST usando formato OO (struct Nodo*).
//
// DISENO:
//   - Cada visitante emite gen_emitir_traza() antes de emitir
//     codigo, para trazabilidad en el archivo C generado.
//   - Los bloques ( ) se emiten exclusivamente mediante
//     gen_abrir_bloque_c() y gen_cerrar_bloque_c() de emision_c.
//     Prohibida la emision manual de llaves con strings crudos.
//   - El dispatcher (gen_visitar_stmt_generico) tiene una rama
//     de fail-fast para tipos de nodo no reconocidos.
// ============================================================

// NOTA: _oo_expr_a_c se encuentra en expr_eval.syn (submodulo separado)

// ----------------------------------------------------------
// gen_visitar_si  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_si(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaSi* _s = (struct SentenciaSi*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaSi\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// if (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    if (\");")
        asm("_buf2[0] = 0;")
        asm("if (_s->condicion) { _oo_expr_a_c(est, _s->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// Visit if-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _ic = _s->cuerpo;")
        asm("    while (_ic) {")
        asm("        struct Nodo* _is = _ic->cabeza;")
        asm("        if (_is) { gen_visitar_stmt_generico(est, _is); }")
        asm("        _ic = _ic->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")
        asm("if (_s->cuerpo_sino) {")
        asm("    gen_emitir_str(est, \"    else\");")
        asm("    gen_abrir_bloque_c(est);")
        asm("    struct ListaNodo* _ec = _s->cuerpo_sino;")
        asm("    while (_ec) {")
        asm("        struct Nodo* _es = _ec->cabeza;")
        asm("        if (_es) { gen_visitar_stmt_generico(est, _es); }")
        asm("        _ec = _ec->cola;")
        asm("    }")
        asm("    gen_cerrar_bloque_c(est);")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_mientras  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_mientras(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaMientras* _w = (struct SentenciaMientras*)stmt;")
        asm("if (!_w) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaMientras\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("// while (condition) (")
        asm("_buf[0] = 0;")
        asm("strcat(_buf, \"    while (\");")
        asm("_buf2[0] = 0;")
        asm("if (_w->condicion) { _oo_expr_a_c(est, _w->condicion, _buf2, 4096); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \")\");")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// While-body via dispatcher")
        asm("{")
        asm("    struct ListaNodo* _wc = _w->cuerpo;")
        asm("    while (_wc) {")
        asm("        struct Nodo* _ws = _wc->cabeza;")
        asm("        if (_ws) { gen_visitar_stmt_generico(est, _ws); }")
        asm("        _wc = _wc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_para  (INSTRUMENTADO con PGO via asm())
// ----------------------------------------------------------
funcion gen_visitar_para(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaPara* _p = (struct SentenciaPara*)stmt;")
        asm("if (!_p) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaPara\");")
        asm("char _buf[4096], _init[512], _cond[512], _step[512], _vtb[128];")
        asm("_init[0] = _cond[0] = _step[0] = 0; _vtb[0] = 0;")
        asm("// R30 (Manual 2 §2.2 L108): `para i = 0 mientras i < 3:` declara la")
        asm("// variable de bucle en el C (`for (int64_t i = 0; ...)`) — antes se")
        asm("// emitia `for (0LL; ...)` y gcc fallaba con 'i undeclared' (H-R29-2).")
        asm("const char* _pvar = (_p->nombre.datos && _p->nombre.datos[0]) ? _p->nombre.datos : 0;")
        asm("// Evaluate init, cond, step expressions")
        asm("if (_p->inicializacion) { _oo_expr_a_c(est, _p->inicializacion, _init, 512); }")
        asm("if (_p->condicion) { _oo_expr_a_c(est, _p->condicion, _cond, 512); }")
        asm("if (_p->incremento) { _oo_expr_a_c(est, _p->incremento, _step, 512); }")
        asm("// Tipo C de la variable: inferido de la expresion de inicializacion")
        asm("// (paridad _syn_nativo_expr_tipo_c generator.syn L3436 / R20-R25-R27).")
        asm("extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("if (_pvar && _p->inicializacion) { _syn_nativo_expr_tipo_c((void*)_p->inicializacion, (void*)_vtb); }")
        asm("if (!_vtb[0]) strcpy(_vtb, \"int64_t\");")
        asm("// R30: registrar la variable de bucle en _G_fn_vars/_G_fn_var_tipos")
        asm("// (patron R28 del let) para el binding del coincidir y el hoisting.")
        asm("extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("if (_pvar) {")
        asm("    int _pvi = -1;")
        asm("    for (int _v = 0; _v < _G_fn_vars_count; _v++) { if (strcmp(_G_fn_vars[_v], _pvar) == 0) { _pvi = _v; break; } }")
        asm("    if (_pvi < 0 && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _pvar, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _pvi = _G_fn_vars_count++; }")
        asm("    if (_pvi >= 0) { int _pvlen = (int)strlen(_vtb); int _pvmax = (_pvlen < 63) ? _pvlen : 63; memcpy(_G_fn_var_tipos[_pvi], _vtb, _pvmax); _G_fn_var_tipos[_pvi][_pvmax] = 0; }")
        asm("}")
        asm("// Emit: for (tipo var = init; cond; step) {")
        asm("if (_pvar) { snprintf(_buf, 4096, \"    for (%s %s = %s; %s; %s)\", _vtb, _pvar, _init, _cond, _step); }")
        asm("else { snprintf(_buf, 4096, \"    for (%s; %s; %s)\", _init, _cond, _step); }")
        asm("gen_emitir_str(est, _buf);")
        asm("gen_abrir_bloque_c(est);")
        asm("// For-body via dispatcher (R30: ListaNodo, paridad si/mientras — antes")
        asm("// solo se visitaba la PRIMERA sentencia del cuerpo).")
        asm("{")
        asm("    struct ListaNodo* _fc = (struct ListaNodo*)_p->cuerpo;")
        asm("    while (_fc) {")
        asm("        struct Nodo* _fs = _fc->cabeza;")
        asm("        if (_fs) { gen_visitar_stmt_generico(est, _fs); }")
        asm("        _fc = _fc->cola;")
        asm("    }")
        asm("}")
        asm("gen_cerrar_bloque_c(est);")

// ----------------------------------------------------------
// gen_visitar_retornar
// ----------------------------------------------------------
funcion gen_visitar_retornar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)stmt;")
        asm("if (!_rt) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaRetornar\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("_buf2[0] = 0;")
        asm("if (_rt->expr) { _oo_expr_a_c(est, _rt->expr, _buf2, 4096); }")
        // F5-1 (Manual 2 §5.1): garantiza se evalua inmediatamente antes de cada
        // `retornar`, con _resultado_ conteniendo el valor a retornar (paridad
        // emit_declarations.py visitar_retornar L563-603). FIX: parser.syn ahora
        // resetea contr_primera_garantiza entre funciones, eliminando el AST leak.
        asm("extern void* _G_fn_garantizas_actuales; extern char _G_fn_ret_tipo_c[64];")
        asm("struct ListaNodo* _gz = (struct ListaNodo*)_G_fn_garantizas_actuales;")
        asm("if (_gz) {")
        asm("    if (_rt->expr) {")
        asm("        char _rct[64]; strncpy(_rct, _G_fn_ret_tipo_c, 63); _rct[63] = 0;")
        asm("        snprintf(_buf, 4096, \"    %s _resultado_ = %s;\", _rct, _buf2);")
        asm("        gen_emitir_str(est, _buf);")
        asm("    }")
        asm("    { struct ListaNodo* _gi = _gz;")
        asm("      while (_gi) {")
        asm("        struct Nodo* _gin = (struct Nodo*)_gi->cabeza;")
        asm("        if (_gin) {")
        asm("            char _gib[4096]; _gib[0] = 0;")
        asm("            _oo_expr_a_c(est, _gin, _gib, 4096);")
        asm("            if (_gib[0]) {")
        asm("                char _gil[4200];")
        asm("                snprintf(_gil, 4200, \"    #ifndef SYNAPSE_RELEASE\"); gen_emitir_str(est, _gil);")
        asm("                snprintf(_gil, 4200, \"    assert((%s) && \\\"Fallo en contrato: garantiza\\\");\", _gib); gen_emitir_str(est, _gil);")
        asm("                snprintf(_gil, 4200, \"    #endif\"); gen_emitir_str(est, _gil);")
        asm("            }")
        asm("        }")
        asm("        _gi = _gi->cola;")
        asm("      }")
        asm("    }")
        asm("    if (_rt->expr) { gen_emitir_str(est, \"    return _resultado_;\"); }")
        asm("    else { gen_emitir_str(est, \"    return;\"); }")
        asm("    return;")
        asm("}")
        asm("strcat(_buf, \"    return \");")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_visitar_declaracion
// ----------------------------------------------------------
funcion gen_visitar_declaracion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)stmt;")
        asm("if (!_dv) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"DeclaracionVariable\");")
        asm("if (!_dv->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: DeclaracionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Manual 8 S8.2 / paridad: literal string -> CadenaSegura (no const char*)")
        asm("// F1.2c: `let x: tipo = ...` usa la anotacion explicita (paridad visitar_declaracion);")
        asm("// si no hay anotacion se infiere: LiteralCadena -> CadenaSegura, LiteralDecimal -> float, resto int.")
        asm("extern char _gen_tmp_buf[4096];")
        asm("char _var_type_buf[128]; _var_type_buf[0] = 0;")
        asm("const char* _var_type = \"int64_t \";")
        asm("if (_dv->tipo_param.datos && _dv->tipo_param.datos[0] != 0) {")
        asm("    traducir_tipo_c((void*)_dv->tipo_param.datos);")
        asm("    strncpy(_var_type_buf, _gen_tmp_buf, 127); _var_type_buf[127] = 0;")
        asm("    strcat(_var_type_buf, \" \");")
        asm("    _var_type = _var_type_buf;")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralDecimal\") == 0) {")
        asm("    _var_type = \"double \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprTensor\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L53-54 (ExprTensor -> Tensor)")
        asm("    _var_type = \"Tensor \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LiteralNulo\") == 0) {")
        asm("    // A2.3 paridad tipo_de_expr emit_expressions.py L36-38 (LiteralNulo -> void*)")
        asm("    _var_type = \"void* \";")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprCrearCanal\") == 0) {")
        asm("    // F3-6: paridad tipo_de_expr emit_expressions.py L55 (ExprCrearCanal -> CanalConcurrencia*).")
        asm("    // Antes: default int64_t -> `int64_t ch = canal_crear(...)` (gcc incompatible types).")
        asm("    // F3-10: registrar el elemento (Canal<T>, Manual 2 L144) para el receive `ch ->`.")
        asm("    _var_type = \"CanalConcurrencia* \";")
        asm("    struct ExprCrearCanal* _dcc = (struct ExprCrearCanal*)_dv->expresion;")
        asm("    if (_dcc && _dcc->tipo_contenido.datos && _dcc->tipo_contenido.datos[0]) {")
        asm("        traducir_tipo_c((void*)_dcc->tipo_contenido.datos);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        extern void _G_native_canal_elem_set(const char*, const char*);")
        asm("        _G_native_canal_elem_set(_dv->nombre.datos, _gen_tmp_buf);")
        asm("    }")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"ExprRecibirCanal\") == 0) {")
        asm("    // F3-10: el receive hereda el tipo del elemento del canal (Manual 5 §4.2) -")
        asm("    // paridad S1 _elemento_canal. Fallback void* (F3-6).")
        asm("    struct ExprRecibirCanal* _drc = (struct ExprRecibirCanal*)_dv->expresion;")
        asm("    char _drt[64]; _drt[0] = 0;")
        asm("    if (_drc->canal && _drc->canal->tipo.datos && strcmp(_drc->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _drid = (struct Identificador*)_drc->canal;")
        asm("        if (_drid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_drid->nombre.datos, _drt); }")
        asm("    }")
        asm("    if (_drt[0]) { snprintf(_var_type_buf, 127, \"%s \", _drt); _var_type = _var_type_buf; } else { _var_type = \"void* \"; }")
        asm("} else if (_dv->expresion && _dv->expresion->tipo.datos && strcmp(_dv->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    // R25 (hallazgo R24): `let r = ok(7)` sin anotacion -> el tipo de la")
        asm("    // variable es la INSTANCIA monomorfizada del ctor ADT (paridad S1")
        asm("    // tipo_de_expr rama R20). Antes caia al default int64_t y el C")
        asm("    // quedaba `int64_t r = (Resultado_entero_texto){...}` (incompatible).")
        asm("    struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("    if (_lf->nombre.datos && _G_native_es_adt_ctr(_lf->nombre.datos)) {")
        asm("        char _cad_adt[64]; _cad_adt[0] = 0; int _ctag = 0; char _cft[64]; _cft[0] = 0;")
        asm("        _G_native_adt_ctr_info(_lf->nombre.datos, _cad_adt, &_ctag, _cft);")
        asm("        // tipo C del primer argumento (recursivo para ctors anidados, paridad R20)")
        asm("        char _carg_t[64]; _carg_t[0] = 0;")
        asm("        struct ListaNodo* _carg_cur = _lf->argumentos;")
        asm("        struct Nodo* _cargn = (_carg_cur && _carg_cur->cabeza) ? (struct Nodo*)_carg_cur->cabeza : 0;")
        asm("        extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("        if (_cargn) { _syn_nativo_expr_tipo_c((void*)_cargn, (void*)_carg_t); }")
        asm("        extern int _G_native_adt_inst_ctr(const char* base, int tag, const char* tipo_c, char* out);")
        asm("        extern int _G_native_adt_gen_es(const char* n);")
        asm("        char _d2out[64]; _d2out[0] = 0;")
        asm("        if (_G_native_adt_gen_es(_cad_adt) && _G_native_adt_inst_ctr(_cad_adt, _ctag, _carg_t, _d2out)) {")
        asm("            strcpy(_var_type_buf, _d2out);")
        asm("        } else {")
        asm("            // ADT simple: el tipo C es el nombre del ADT (typedef struct X {...} X)")
        asm("            strcpy(_var_type_buf, _cad_adt);")
        asm("        }")
        asm("        strcat(_var_type_buf, \" \");")
        asm("        _var_type = _var_type_buf;")
        asm("    } else if (_lf->nombre.datos && _G_native_es_estructura(_lf->nombre.datos)) {")
        asm("        // R27: `let p = Punto()` sin anotacion -> el tipo de la variable")
        asm("        // es `struct Punto` (paridad _syn_nativo_expr_tipo_c generator.syn")
        asm("        // L3239 y S1 tipo_de_expr rama struct). Antes caia al default")
        asm("        // int64_t y el C quedaba `int64_t p = (struct Punto){0}` (invalido).")
        asm("        snprintf(_var_type_buf, 127, \"struct %s \", _lf->nombre.datos);")
        asm("        _var_type = _var_type_buf;")
        asm("    } else if (_lf->nombre.datos) {")
        asm("        // F3-4 (hallazgo F3-4): `let x = abrir(...)` sin anotacion -> el tipo\n")
        asm("        // de la variable es el retorno del builtin/funcion (paridad context.py\n")
        asm("        // _BUILTINS L72-118 y hoisting ME-B6 L219-230). Antes caia al default\n")
        asm("        // int64_t y el C quedaba `int64_t archivo = abrir(...)` (C invalido).\n")
        asm("        char _rtb[64]; _rtb[0] = 0;")
        asm("        if (_G_native_tipo_retorno(_lf->nombre.datos, _rtb)) {")
        asm("            if (strcmp(_rtb, \"vacio\") != 0 && strcmp(_rtb, \"nulo\") != 0 && strcmp(_rtb, \"entero\") != 0) {")
        asm("                traducir_tipo_c((void*)_rtb);")
        asm("                strncpy(_var_type_buf, _gen_tmp_buf, 127); _var_type_buf[127] = 0;")
        asm("                strcat(_var_type_buf, \" \");")
        asm("                _var_type = _var_type_buf;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// R18: registrar el tipo C de la variable local - paridad S1")
        asm("// visitar_declaracion L127 _variables; necesario para el binding del")
        asm("// coincidir con multi-instancia del mismo base R18.")
        asm("extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("for (int _dvi = 0; _dvi < _G_fn_vars_count; _dvi++) {")
        asm("    if (strcmp(_G_fn_vars[_dvi], _dv->nombre.datos) == 0) {")
        asm("        int _dvlen = (int)strlen(_var_type);")
        asm("        if (_dvlen > 0 && _var_type[_dvlen-1] == ' ') _dvlen--;")
        asm("        int _dvmax = (_dvlen < 63) ? _dvlen : 63;")
        asm("        memcpy(_G_fn_var_tipos[_dvi], _var_type, _dvmax); _G_fn_var_tipos[_dvi][_dvmax] = 0;")
        asm("        break;")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("strcat(_buf, _var_type);")
        asm("strcat(_buf, _dv->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("// D-3: sin expresion -> `= {0};` (paridad visitar_declaracion S1: `{tipo} {nombre} = {0};`)")
        asm("if (_dv->expresion) { _oo_expr_a_c(est, _dv->expresion, _buf2, 4096); } else { strcpy(_buf2, \"{0}\"); }")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.2: Track string vars for RAII pool_free at scope exit
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        // M22.3: RAII tracking - solo para expresiones GARANTIZADAS de retornar texto al heap
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto = 0;")
        asm("if (_dv->expresion && _dv->expresion->tipo.datos) {")
        asm("    const char* _et = _dv->expresion->tipo.datos;")
        asm("    // Literal string - siempre texto al heap")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("    // LlamadaFuncion: solo si el nombre coincide con funciones que retornan texto")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_dv->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto = 1;")
        asm("        }")
        asm("    }")
        asm("    // OpBinaria: + es texto solo si un operando es literal o var de texto (paridad tipo_de_expr)")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_dv->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto = 1;")
        asm("            if (_es_texto == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _dv->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _dv->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_delegar
// F1.2c: `delegar expresion` == `retornar err(...)` (Manual 2 §2 L132,
// Manual 3 §7). Patron `?` de Resultado: si el tag es err, propaga el valor;
// si es ok, continua (el valor se descarta).
// ----------------------------------------------------------
funcion gen_visitar_delegar(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaDelegar* _dl = (struct SentenciaDelegar*)stmt;")
        asm("if (!_dl) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaDelegar\");")
        asm("char _dbuf[4096]; _dbuf[0] = 0;")
        asm("if (_dl->expresion) { _oo_expr_a_c(est, _dl->expresion, _dbuf, 4096); }")
        asm("char _dline[4128]; _dline[0] = 0;")
        asm("snprintf(_dline, 4128, \"    Resultado _del = %s;\", _dbuf);")
        asm("gen_emitir_str(est, \"{\");")
        asm("gen_emitir_str(est, _dline);")
        asm("gen_emitir_str(est, \"    if (_del.tag == 1) return _del;\");")
        asm("gen_emitir_str(est, \"}\");")

funcion gen_visitar_asignacion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionVariable* _a = (struct AsignacionVariable*)stmt;")
        asm("if (!_a) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionVariable\");")
        asm("if (!_a->nombre.datos) {")
        asm("    fprintf(stderr, \"Error Fatal Generador: AsignacionVariable sin nombre\\n\");")
        asm("    exit(1);")
        asm("}")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0;")
        asm("// Detect string literal assignment -> use const char*")
        asm("const char* _var_type = \"int64_t \";")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralCadena\") == 0) {")
        asm("    _var_type = \"CadenaSegura \";")
        asm("} else if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LiteralDecimal\") == 0) {")
        asm("    _var_type = \"double \";")
        asm("}")
        asm("// ME-B4: Struct constructor call -> struct <N> <var> = {0};")
        asm("const char* _struct_name = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf2 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf2->nombre.datos && _G_native_es_estructura(_lf2->nombre.datos)) { _struct_name = _lf2->nombre.datos; }")
        asm("}")
        asm("// ME-B6: inferir tipo desde retorno de funcion definida")
        asm("const char* _ret_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf3 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf3->nombre.datos) {")
        asm("        char _rtbuf[64]; _rtbuf[0] = 0;")
        asm("        if (_G_native_tipo_retorno(_lf3->nombre.datos, _rtbuf)) {")
        asm("            if (strcmp(_rtbuf, \"vacio\") != 0 && strcmp(_rtbuf, \"nulo\") != 0 && strcmp(_rtbuf, \"entero\") != 0) { _ret_type = _rtbuf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// R11: constructor ADT (ok/err/algun/ninguno) -> tipo C de la")
        asm("// instancia registrada (Resultado_entero_texto, paridad S1). Antes")
        asm("// caia en _var_type=int64_t y gcc fallaba 'incompatible types'.")
        asm("const char* _adt_type = 0;")
        asm("static char _adt_type_buf[96]; _adt_type_buf[0] = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf4 = (struct LlamadaFuncion*)_a->expresion;")
        asm("    if (_lf4->nombre.datos) {")
        asm("        char _adb[64]; int _adg = 0; char _adt[64]; _adb[0]=0; _adt[0]=0;")
        asm("        if (_G_native_adt_ctr_info(_lf4->nombre.datos, _adb, &_adg, _adt)) {")
        asm("            extern char _G_native_adt_inst_c[64][64]; extern char _G_native_adt_inst_base[64][64]; extern int _G_native_adt_inst_count;")
        asm("            char _adout[64]; _adout[0]=0;")
        asm("            int _adns = 0; for (int _adj = 0; _adj < _G_native_adt_inst_count; _adj++) { if (strcmp(_G_native_adt_inst_base[_adj], _adb) == 0) _adns++; }")
        asm("            for (int _adi = 0; _adi < _G_native_adt_inst_count && !_adout[0]; _adi++) {")
        asm("                if (strcmp(_G_native_adt_inst_base[_adi], _adb) == 0 && (_adns == 1 || _adg < _G_native_adt_inst_nfields[_adi])) { strcpy(_adout, _G_native_adt_inst_c[_adi]); }")
        asm("            }")
        asm("            if (_adout[0]) { strncpy(_adt_type_buf, _adout, 95); _adt_type_buf[95] = 0; _adt_type = _adt_type_buf; }")
        asm("            else { snprintf(_adt_type_buf, 95, \"struct %s\", _adb); _adt_type_buf[95] = 0; _adt_type = _adt_type_buf; }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// D-6: ExprPropagar (operador ?) -> tipo del campo ok desempaquetado")
        asm("const char* _prop_type = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"ExprPropagar\") == 0) {")
        asm("    struct ExprPropagar* _pp2 = (struct ExprPropagar*)_a->expresion;")
        asm("    if (_pp2->expresion && _pp2->expresion->tipo.datos && strcmp(_pp2->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _plf2 = (struct LlamadaFuncion*)_pp2->expresion;")
        asm("        if (_plf2->nombre.datos) {")
        asm("            char _padt2[64]; _padt2[0] = 0;")
        asm("            if (_G_native_tipo_retorno(_plf2->nombre.datos, _padt2)) {")
        asm("                char _pft2[64]; _pft2[0] = 0;")
        asm("                if (_G_native_adt_unwrap_tipo(_padt2, _pft2) && _pft2[0]) {")
        asm("                    traducir_tipo_c((void*)_pft2);")
        asm("                    extern char _gen_tmp_buf[4096];")
        asm("                    if (_gen_tmp_buf[0]) { _prop_type = _gen_tmp_buf; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// F3-10: ExprRecibirCanal -> tipo C del elemento del canal (Manual 5 §4.2),")
        asm("// paridad S1 _elemento_canal. Fallback void* (F3-6).")
        asm("const char* _recv_type = 0;")
        asm("static char _recv_type_buf[96]; _recv_type_buf[0] = 0;")
        asm("if (!_struct_name && _a->expresion && _a->expresion->tipo.datos && strcmp(_a->expresion->tipo.datos, \"ExprRecibirCanal\") == 0) {")
        asm("    struct ExprRecibirCanal* _rva = (struct ExprRecibirCanal*)_a->expresion;")
        asm("    if (_rva->canal && _rva->canal->tipo.datos && strcmp(_rva->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _rvid = (struct Identificador*)_rva->canal;")
        asm("        char _rvt[64]; _rvt[0] = 0;")
        asm("        if (_rvid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_rvid->nombre.datos, _rvt); }")
        asm("        if (_rvt[0]) { snprintf(_recv_type_buf, 95, \"%s \", _rvt); _recv_type_buf[95] = 0; _recv_type = _recv_type_buf; }")
        asm("    }")
        asm("}")
        asm("strcat(_buf, \"    \");")
        asm("// ME-B7 hoisting (paridad emit_declarations.py 'Pre-pass: hoist variable declarations'):")
        asm("// la primera asignacion declara la variable; las siguientes solo asignan.")
        asm("extern char _G_fn_vars[2048][64]; extern int _G_fn_vars_count;")
        asm("int _ya_decl = 0;")
        asm("for (int _vd = 0; _vd < _G_fn_vars_count; _vd++) { if (strcmp(_G_fn_vars[_vd], _a->nombre.datos) == 0) { _ya_decl = 1; break; } }")
        asm("if (!_ya_decl && _G_fn_vars_count < 2048) { strncpy(_G_fn_vars[_G_fn_vars_count], _a->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_vars_count++; }")
        asm("if (!_ya_decl) {")
        asm("    if (_struct_name) {")
        asm("        strcat(_buf, \"struct \"); strcat(_buf, _struct_name); strcat(_buf, \" \");")
        asm("    } else if (_prop_type) {")
        asm("        strcat(_buf, _prop_type); strcat(_buf, \" \");")
        asm("    } else if (_recv_type) {")
        asm("        strcat(_buf, _recv_type);")
        asm("    } else if (_ret_type) {")
        asm("        traducir_tipo_c((void*)_ret_type);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        strcat(_buf, _gen_tmp_buf); strcat(_buf, \" \");")
        asm("    } else if (_adt_type) {")
        asm("        strcat(_buf, _adt_type); strcat(_buf, \" \");")
        asm("    } else {")
        asm("        strcat(_buf, _var_type);")
        asm("    }")
        asm("}")
        asm("strcat(_buf, _a->nombre.datos);")
        asm("strcat(_buf, \" = \");")
        asm("_buf2[0] = 0;")
        asm("if (_a->expresion) {")
        asm("    // ME-B4: constructor de struct emitido por _oo_expr_a_c como compound literal (struct X){0}")
        asm("    _oo_expr_a_c(est, _a->expresion, _buf2, 4096);")
        asm("}")
        asm("strcat(_buf, _buf2);")
        asm("strcat(_buf, \";\");")
        asm("gen_emitir_str(est, _buf);")
        // M22.3: RAII tracking - solo funciones y operadores garantizados de retornar texto
        asm("extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total;")
        asm("int _es_texto2 = 0;")
        asm("if (_a->expresion && _a->expresion->tipo.datos) {")
        asm("    const char* _et = _a->expresion->tipo.datos;")
        asm("    if (strcmp(_et, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("    if (strcmp(_et, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_a->expresion;")
        asm("        if (_lf->nombre.datos) {")
        asm("            const char* _fn = _lf->nombre.datos;")
        asm("            if (strcmp(_fn, \"leer_linea\") == 0 || strcmp(_fn, \"concat\") == 0 || strcmp(_fn, \"entero_a_texto\") == 0 || strcmp(_fn, \"decimal_a_texto\") == 0 || strcmp(_fn, \"subcadena\") == 0 || strcmp(_fn, \"leer\") == 0 || strcmp(_fn, \"_argv\") == 0 || strcmp(_fn, \"_syn_obtener_env\") == 0 || strcmp(_fn, \"leer_archivo\") == 0 || strcmp(_fn, \"_syn_leer_archivo\") == 0) _es_texto2 = 1;")
        asm("        }")
        asm("    }")
        asm("    if (strcmp(_et, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_a->expresion;")
        asm("        if (_op->operador && _op->operador->tipo == 30) {")
        asm("            struct Nodo* _oizq = (struct Nodo*)_op->izquierdo;")
        asm("            struct Nodo* _oder = (struct Nodo*)_op->derecho;")
        asm("            if (_oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"LiteralCadena\") == 0) _es_texto2 = 1;")
        asm("            if (_es_texto2 == 0 && _oizq && _oizq->tipo.datos && strcmp(_oizq->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _oidz = (struct Identificador*)_oizq;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sii = 0; _sii < _G_scope_vars_total; _sii++) {")
        asm("                    if (_oidz->nombre.datos && strcmp(_G_scope_vars_names[_sii], _oidz->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("            if (_es_texto2 == 0 && _oder && _oder->tipo.datos && strcmp(_oder->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _odrd = (struct Identificador*)_oder;")
        asm("                extern char _G_scope_vars_names[256][64]; extern int _G_scope_vars_total;")
        asm("                for (int _sid = 0; _sid < _G_scope_vars_total; _sid++) {")
        asm("                    if (_odrd->nombre.datos && strcmp(_G_scope_vars_names[_sid], _odrd->nombre.datos) == 0) { _es_texto2 = 1; break; }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_es_texto2) {")
        asm("    // ME-B8: registro idempotente por nombre (paridad emit_declarations.py)")
        asm("    // evita double free: la variable se libera SOLO en el scope de su declaracion")
        asm("    int _dup = 0;")
        asm("    for (int _di = 0; _di < _G_scope_vars_total; _di++) { if (strcmp(_G_scope_vars_names[_di], _a->nombre.datos) == 0) { _dup = 1; break; } }")
        asm("    if (!_dup && _G_scope_vars_total < 256) {")
        asm("        int _idx = _G_scope_vars_total++;")
        asm("        _G_scope_vars_depth[_idx] = _G_scope_depth;")
        asm("        strncpy(_G_scope_vars_names[_idx], _a->nombre.datos, 63);")
        asm("        _G_scope_vars_names[_idx][63] = 0;")
        asm("    }")
        asm("}")

// ----------------------------------------------------------
// gen_visitar_asignacion_campo  (ME-B9.x, paridad visitar_asignacion_campo)
// ----------------------------------------------------------
funcion gen_visitar_asignacion_campo(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct AsignacionCampo* _ac = (struct AsignacionCampo*)stmt;")
        asm("if (!_ac) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"AsignacionCampo\");")
        asm("char _buf[4096], _buf2[4096];")
        asm("_buf[0] = 0; _buf2[0] = 0;")
        asm("if (_ac->objeto) { _oo_expr_a_c(est, _ac->objeto, _buf, 4096); }")
        asm("if (_ac->expresion) { _oo_expr_a_c(est, _ac->expresion, _buf2, 4096); }")
        asm("const char* _sep = \".\";")
        asm("if (_ac->objeto && _ac->objeto->tipo.datos && strcmp(_ac->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("    struct Identificador* _oidc = (struct Identificador*)_ac->objeto;")
        asm("    if (_oidc->nombre.datos) {")
        asm("        extern char _G_fn_ptr_vars[64][64]; extern int _G_fn_ptr_vars_count;")
        asm("        for (int _pvi = 0; _pvi < _G_fn_ptr_vars_count; _pvi++) { if (strcmp(_G_fn_ptr_vars[_pvi], _oidc->nombre.datos) == 0) { _sep = \"->\"; break; } }")
        asm("    }")
        asm("}")
        asm("char _linea[8192];")
        asm("snprintf(_linea, 8192, \"    %s%s%s = %s;\", _buf, _sep, _ac->nombre_campo.datos ? _ac->nombre_campo.datos : \"\", _buf2);")
        asm("gen_emitir_str(est, _linea);")

// ----------------------------------------------------------
// gen_visitar_expr
// ----------------------------------------------------------
// ----------------------------------------------------------
// gen_visitar_log  (R8: log(...) -> printf; paridad S1 visitar_log)
// ----------------------------------------------------------
funcion gen_visitar_log(est: GeneradorCEst, nodo_log: puntero) -> nulo:
    inseguro:
        asm("struct LogLlamada* _ll = (struct LogLlamada*)nodo_log;")
        asm("if (!_ll) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"LogLlamada\");")
        asm("char _lfmt[1024]; _lfmt[0] = 0;")
        asm("char _largs[4096]; _largs[0] = 0;")
        asm("struct ListaNodo* _lc = _ll->argumentos;")
        asm("int _lprim = 1;")
        asm("while (_lc) {")
        asm("    struct Nodo* _la = (struct Nodo*)_lc->cabeza;")
        asm("    if (_la) {")
        asm("        if (!_lprim) { strcat(_lfmt, \" \"); strcat(_largs, \", \"); }")
        asm("        _lprim = 0;")
        asm("        char _labuf[4096]; _labuf[0] = 0;")
        asm("        _oo_expr_a_c(est, _la, _labuf, 4096);")
        asm("        const char* _lt = _la->tipo.datos;")
        asm("        int _ltex = 0; int _ldec = 0;")
        asm("        if (_lt && strcmp(_lt, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("        else if (_lt && strcmp(_lt, \"LiteralDecimal\") == 0) _ldec = 1;")
        asm("        else if (_lt && strcmp(_lt, \"Identificador\") == 0) {")
        asm("            struct Identificador* _lid = (struct Identificador*)_la;")
        asm("            if (_lid->nombre.datos) {")
        asm("                extern char _G_fn_vars[2048][64]; extern char _G_fn_var_tipos[2048][64]; extern int _G_fn_vars_count;")
        asm("                for (int _vi = 0; _vi < _G_fn_vars_count; _vi++) {")
        asm("                    if (strcmp(_G_fn_vars[_vi], _lid->nombre.datos) == 0) {")
        asm("                        if (strcmp(_G_fn_var_tipos[_vi], \"CadenaSegura\") == 0) _ltex = 1;")
        asm("                        if (strcmp(_G_fn_var_tipos[_vi], \"double\") == 0) _ldec = 1;")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        else if (_lt && strcmp(_lt, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _llf = (struct LlamadaFuncion*)_la;")
        asm("            if (_llf->nombre.datos) {")
        asm("                char _lrt[64]; _lrt[0] = 0;")
        asm("                if (_G_native_tipo_retorno(_llf->nombre.datos, _lrt)) {")
        asm("                    if (strcmp(_lrt, \"cadena\") == 0 || strcmp(_lrt, \"texto\") == 0 || strcmp(_lrt, \"CadenaSegura\") == 0) _ltex = 1;")
        asm("                    if (strcmp(_lrt, \"decimal\") == 0) _ldec = 1;")
        asm("                }")
        asm("                if (strcmp(_llf->nombre.datos, \"concat\") == 0 || strcmp(_llf->nombre.datos, \"entero_a_texto\") == 0 || strcmp(_llf->nombre.datos, \"decimal_a_texto\") == 0 || strcmp(_llf->nombre.datos, \"leer_linea\") == 0 || strcmp(_llf->nombre.datos, \"subcadena\") == 0) _ltex = 1;")
        asm("            }")
        asm("        }")
        asm("        else if (_lt && strcmp(_lt, \"OpBinaria\") == 0) {")
        asm("            struct OpBinaria* _lop = (struct OpBinaria*)_la;")
        asm("            if (_lop->operador && _lop->operador->tipo == 30) {")
        asm("                struct Nodo* _loi = (struct Nodo*)_lop->izquierdo;")
        asm("                struct Nodo* _lod = (struct Nodo*)_lop->derecho;")
        asm("                if (_loi && _loi->tipo.datos && strcmp(_loi->tipo.datos, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("                if (_lod && _lod->tipo.datos && strcmp(_lod->tipo.datos, \"LiteralCadena\") == 0) _ltex = 1;")
        asm("            }")
        asm("        }")
        asm("        if (_ltex) {")
        asm("            strcat(_lfmt, \"%s\");")
        asm("            strcat(_largs, _labuf); strcat(_largs, \".datos\");")
        asm("        } else if (_ldec) {")
        asm("            strcat(_lfmt, \"%f\");")
        asm("            strcat(_largs, _labuf);")
        asm("        } else {")
        asm("            strcat(_lfmt, \"%d\");")
        asm("            strcat(_largs, _labuf);")
        asm("        }")
        asm("    }")
        asm("    _lc = _lc->cola;")
        asm("}")
        asm("char _lline[5200];")
        asm("if (_largs[0]) {")
        asm("    snprintf(_lline, 5200, \"    printf(\\\"%s\\\\n\\\", %s);\", _lfmt, _largs);")
        asm("} else {")
        asm("    snprintf(_lline, 5200, \"    printf(\\\"\\\\n\\\");\");")
        asm("}")
        asm("gen_emitir_str(est, _lline);")
funcion gen_visitar_expr(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct SentenciaExpr* _s = (struct SentenciaExpr*)stmt;")
        asm("if (!_s) return;")
        asm("gen_emitir_traza(est, \"nodos_flujo.syn\", \"SentenciaExpr\");")
        asm("char _buf[4096]; _buf[0] = 0;")
        asm("char _sbuf[4096]; _sbuf[0] = 0;")
        asm("// ME-B5: detectar asm(<cadena>) directo -> emitir instruccion cruda (paridad generator.py L203-232)")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LlamadaFuncion\")) {")
        asm("    struct LlamadaFuncion* _asm_lf = (struct LlamadaFuncion*)_s->expr;")
        asm("    if (_asm_lf->nombre.datos && strcmp(_asm_lf->nombre.datos, \"asm\") == 0 && _asm_lf->argumentos) {")
        asm("        struct Nodo* _asm_arg = (struct Nodo*)_asm_lf->argumentos->cabeza;")
        asm("        if (_asm_arg && _syn_es_tipo(_asm_arg->tipo.datos, \"LiteralCadena\")) {")
        asm("            struct LiteralCadena* _asm_lc = (struct LiteralCadena*)_asm_arg;")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud == 0) {")
        asm("                // asm(\"\") vacio: emitir sentencia vacia valida (paridad generator.py 'not trimmed')")
        asm("                gen_emitir_str(est, \";\");")
        asm("                return;")
        asm("            }")
        asm("            if (_asm_lc->valor.datos && _asm_lc->valor.longitud > 0) {")
        asm("                strncpy(_buf, _asm_lc->valor.datos, 4095);")
        asm("                _buf[4095] = 0;")
        asm("                int _l2 = (int)strlen(_buf);")
        asm("                while (_l2 > 0 && (_buf[_l2-1] == ' ' || _buf[_l2-1] == '\\t' || _buf[_l2-1] == '\\n')) _l2--;")
        asm("                int _needs_semi = 1;")
        asm("                if (_l2 == 0) _needs_semi = 0;")
        asm("                else if (_buf[0] == '#') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == ';') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '{') _needs_semi = 0;")
        asm("                else if (_buf[_l2-1] == '}') {")
        asm("                    int _pb = _l2 - 2;")
        asm("                    while (_pb >= 0 && (_buf[_pb] == ' ' || _buf[_pb] == '\\t' || _buf[_pb] == '\\n')) _pb--;")
        asm("                    if (_pb >= 0 && _buf[_pb] == ';') { _needs_semi = 0; }")
        asm("                    else {")
        asm("                        int _io = -1;")
        asm("                        for (int _j = _l2 - 2; _j >= 0; _j--) { if (_buf[_j] == '{') { _io = _j; break; } }")
        asm("                        if (_io < 0) _needs_semi = 0;")
        asm("                    }")
        asm("                }")
        asm("                if (_needs_semi) { strcat(_buf, \";\"); }")
        asm("                char _ebuf[4096];")
        asm("                int _ep = 0;")
        asm("                for (int _k = 0; _buf[_k] && _ep < 4095; _k++) {")
        asm("                    if (_buf[_k] == '\\n') { _ebuf[_ep++] = '\\\\'; _ebuf[_ep++] = 'n'; }")
        asm("                    else { _ebuf[_ep++] = _buf[_k]; }")
        asm("                }")
        asm("                _ebuf[_ep] = 0;")
        asm("                CadenaSegura _esc_cs = { .longitud = _ep, .datos = _ebuf };")
        asm("                gen_emitir_linea(est, _esc_cs);")
        asm("                return;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("}")
        asm("if (_s->expr && _syn_es_tipo(_s->expr->tipo.datos, \"LogLlamada\")) {")
        asm("    gen_visitar_log(est, _s->expr);")
        asm("    return;")
        asm("}")
        asm("if (_s->expr) { _oo_expr_a_c(est, _s->expr, _sbuf, 4096); }")
        asm("char _line[4128]; _line[0] = 0;")
        asm("strcat(_line, \"    \");")
        asm("strcat(_line, _sbuf);")
        asm("strcat(_line, \";\");")
        asm("gen_emitir_str(est, _line);")

// ----------------------------------------------------------
// gen_visitar_romper
