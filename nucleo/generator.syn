// --- Token type constants (mirror parser.syn) ---
constante T_IDENTIFICADOR = 19
constante T_NUMERO = 20
constante T_CADENA = 22
constante T_FLECHA_DER = 37
constante T_PAREN_IZQ = 38
constante T_PAREN_DER = 39
constante T_DOSPUNTOS = 40
constante T_COMA = 41
constante T_NUEVALINEA = 42
constante T_INDENTAR = 43
constante T_DESINDENTAR = 44
constante T_ASIGNAR = 29
constante T_MAS = 30
constante T_MENOS = 31
constante T_POR = 32
constante T_DIV = 33
constante T_MOD = 34
constante T_PUNTO = 13
constante T_IGUAL = 25
constante T_DISTINTO = 26
constante T_MENOR = 24
constante T_MAYOR = 23
constante T_MENOR_IGUAL = 27
constante T_MAYOR_IGUAL = 28
constante T_Y = 14
constante T_O = 15
constante T_NO = 16
constante T_AMPERSAND = 45
constante T_FLECHA = 35
constante T_FIN = 57
// --- Generator state struct ---
estructura GeneradorCEst:
    // Output state
    buf_lineas: entero
    buf_capacidad: entero
    buf_longitud: entero
    indent_actual: entero
    // Function tracking
    contador_thread: entero
    contador_listener: entero
    funciones_emitidas: entero
    func_emitidas_nombres: cadena
    func_return_types_nombres: cadena
    func_return_types_tipos: cadena
    func_return_types_total: entero
    in_function_scope: booleano
    // Variable tracking
    var_nombres: cadena
    var_tipos: cadena
    var_total: entero
    var_capacidad: entero
    const_types_nombres: cadena
    const_types_tipos: cadena
    const_types_total: entero
    // Scope stack
    scope_var_nombres: cadena
    scope_var_tipos: cadena
    scope_var_total: entero
    scope_stack_top: entero
    scope_stack_at: entero
    // Tensor / canal tracking
    tensor_vars: cadena
    tensor_vars_total: entero
    tensor_transferidas: cadena
    tensor_transferidas_total: entero
    canal_vars: cadena
    canal_vars_total: entero
    canal_cerradas: cadena
    canal_cerradas_total: entero
    // Listener tracking
    listener_funciones: cadena
    listener_total: entero
    // Struct tracking
    struct_nombres: cadena
    struct_total: entero
    struct_nombres_c: cadena
    struct_total_c: entero
    // External function tracking
    extern_nombres: cadena
    extern_params: cadena
    extern_total: entero
    // Destructor map
    dtor_tipos: cadena
    dtor_funcs: cadena
    dtor_total: entero
    // Gen flags
    gen_tok_emitido: booleano
    gen_parse_emitido: booleano
    gen_defs_emitido: booleano
    // Garantizas for current function
    garantizas_nombres: cadena
    garantizas_valores: cadena
    garantizas_total: entero
    // Program-level flags
    es_no_std: booleano
    linker_libs: cadena
    linker_libs_total: entero
    // Build buffer for code generation
    build_buf: cadena
    // Current function return type
    func_retorno_actual: cadena
    // Strings on heap
    strings_heap: cadena
    strings_heap_total: entero

// --- Global temp buffer for type translation ---
constante _GEN_TMP_SIZE = 4096
// --- Type translation (Synapse -> C type string in _gen_tmp_buf) ---
funcion traducir_tipo_c(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("if (!_t) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("int _len = (int)strlen(_t);")
        asm("if (_len > 7 && _t[0]=='C' && _t[1]=='a' && _t[2]=='n' && _t[3]=='a' && _t[4]=='l' && _t[5]=='<')")
        asm("    { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        asm("if (_len > 10 && _t[0]=='R' && _t[1]=='e' && _t[2]=='s' && _t[3]=='u' && _t[4]=='l' && _t[5]=='t' && _t[6]=='a' && _t[7]=='d' && _t[8]=='o' && _t[9]=='<')")
        asm("    { strcpy(_gen_tmp_buf, \"Resultado_T\"); return; }")
        asm("if (strcmp(_t, \"entero\")==0 || strcmp(_t, \"int\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"vacio\")==0 || strcmp(_t, \"nulo\")==0 || strcmp(_t, \"void\")==0) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("if (strcmp(_t, \"decimal\")==0 || strcmp(_t, \"real\")==0 || strcmp(_t, \"flotante\")==0) { strcpy(_gen_tmp_buf, \"float\"); return; }")
        asm("if (strcmp(_t, \"Tensor\")==0 || strcmp(_t, \"tensor\")==0) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("if (strcmp(_t, \"Canal\")==0 || strcmp(_t, \"canal\")==0) { strcpy(_gen_tmp_buf, \"Canal\"); return; }")
        asm("if (strcmp(_t, \"texto\")==0 || strcmp(_t, \"cadena\")==0) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("if (strcmp(_t, \"booleano\")==0 || strcmp(_t, \"logico\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"char\")==0) { strcpy(_gen_tmp_buf, \"char\"); return; }")
        asm("if (strcmp(_t, \"double\")==0) { strcpy(_gen_tmp_buf, \"double\"); return; }")
        asm("if (strcmp(_t, \"puntero\")==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("snprintf(_gen_tmp_buf, 64, \"struct %s\", _t);")

// --- Coercion helper ---
funcion aplicar_coercion(expr_c: puntero, tipo_origen: puntero, tipo_destino: puntero, linea: entero) -> cadena:
    r = ""
    inseguro:
        asm("const char* _o = (const char*)tipo_origen;")
        asm("const char* _d = (const char*)tipo_destino;")
        asm("if (strcmp(_o, \"float\")==0 && strcmp(_d, \"CadenaSegura\")==0)")
        asm("    { snprintf(_gen_tmp_buf, 4096, \"decimal_a_texto(%s)\", (const char*)expr_c); return; }")
        asm("if (strcmp(_o, \"int\")==0 && strcmp(_d, \"CadenaSegura\")==0)")
        asm("    { snprintf(_gen_tmp_buf, 4096, \"entero_a_texto(%s)\", (const char*)expr_c); return; }")
        asm("if (strcmp(_o, _d)==0) { strcpy(_gen_tmp_buf, (const char*)expr_c); return; }")
        asm("snprintf(_gen_tmp_buf, 4096, \"/* coercion: %s -> %s */\", _o, _d);")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// --- Primitive boxing helpers ---
funcion prim_int_to_ptr(valor: puntero) -> cadena:
    r = ""
    inseguro:
        asm("snprintf(_gen_tmp_buf, 4096, \"_synapse_box_int(%s)\", (const char*)valor);")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

funcion prim_float_to_ptr(valor: puntero) -> cadena:
    r = ""
    inseguro:
        asm("snprintf(_gen_tmp_buf, 4096, \"_synapse_box_float(%s)\", (const char*)valor);")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// --- Allocator helpers ---
funcion syn_malloc(est: GeneradorCEst, size_expr: puntero) -> cadena:
    r = ""
    inseguro:
        asm("if (est.es_no_std) {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"__syn_asignar(%s)\", (const char*)size_expr);")
        asm("} else {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"malloc(%s)\", (const char*)size_expr);")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

funcion syn_calloc(est: GeneradorCEst, n_expr: puntero, size_expr: puntero) -> cadena:
    r = ""
    inseguro:
        asm("if (est.es_no_std) {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"__syn_asignar(%s * %s)\", (const char*)n_expr, (const char*)size_expr);")
        asm("} else {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"calloc(%s, %s)\", (const char*)n_expr, (const char*)size_expr);")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

funcion syn_free(est: GeneradorCEst, ptr_expr: puntero) -> cadena:
    r = ""
    inseguro:
        asm("if (est.es_no_std) {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"__syn_liberar(%s)\", (const char*)ptr_expr);")
        asm("} else {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"free(%s)\", (const char*)ptr_expr);")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

funcion syn_pool_alloc(est: GeneradorCEst, size_expr: puntero) -> cadena:
    r = ""
    inseguro:
        asm("if (est.es_no_std) {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"__syn_asignar(%s)\", (const char*)size_expr);")
        asm("} else {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"_pool_malloc(%s)\", (const char*)size_expr);")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

funcion syn_pool_free(est: GeneradorCEst, ptr_expr: puntero) -> cadena:
    r = ""
    inseguro:
        asm("if (est.es_no_std) {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"__syn_liberar(%s)\", (const char*)ptr_expr);")
        asm("} else {")
        asm("    snprintf(_gen_tmp_buf, 4096, \"pool_free(%s)\", (const char*)ptr_expr);")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// --- Variable management ---
funcion gen_find_var(est: GeneradorCEst, nombre: puntero) -> entero:
    inseguro:
        r = -1
        asm("for (int _vi = 0; _vi < est.var_total; _vi++) {")
        asm("    if (strcmp(est.var_nombres.datos + _vi * 64, (const char*)nombre) == 0)")
        asm("        { r = _vi; break; }")
        asm("}")
        retornar r

funcion gen_add_var(est: GeneradorCEst, nombre: puntero, tipo: puntero) -> nulo:
    inseguro:
        asm("strcpy(est.var_nombres.datos + est.var_total * 64, (const char*)nombre);")
        asm("strcpy(est.var_tipos.datos + est.var_total * 64, (const char*)tipo);")
        asm("est.var_total = est.var_total + 1;")

funcion gen_set_var_type(est: GeneradorCEst, idx: entero, tipo: puntero) -> nulo:
    inseguro:
        asm("if (idx >= 0 && idx < est.var_total)")
        asm("    strcpy(est.var_tipos.datos + idx * 64, (const char*)tipo);")

// --- Function return type tracking ---
funcion gen_agregar_return_type(est: GeneradorCEst, nombre: puntero, tipo: puntero) -> nulo:
    inseguro:
        asm("strcpy(est.func_return_types_nombres.datos + est.func_return_types_total * 64, (const char*)nombre);")
        asm("strcpy(est.func_return_types_tipos.datos + est.func_return_types_total * 64, (const char*)tipo);")
        asm("est.func_return_types_total = est.func_return_types_total + 1;")

funcion gen_func_return_type(est: GeneradorCEst, nombre: puntero) -> cadena:
    r = ""
    inseguro:
        asm("for (int _fi = 0; _fi < est.func_return_types_total; _fi++) {")
        asm("    if (strcmp(est.func_return_types_nombres.datos + _fi * 64, (const char*)nombre) == 0) {")
        asm("        strcpy(_gen_tmp_buf, (const char*)est.func_return_types_tipos.datos + _fi * 64);")
        asm("        return;")
        asm("    }")
        asm("}")
        asm("strcpy(_gen_tmp_buf, \"int\");")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// --- Struct tracking ---
funcion gen_agregar_struct_c(est: GeneradorCEst, nombre: puntero) -> nulo:
    inseguro:
        asm("strcpy(est.struct_nombres_c.datos + est.struct_total_c * 64, (const char*)nombre);")
        asm("est.struct_total_c = est.struct_total_c + 1;")

// --- Code emission helpers ---
funcion gen_emitir_linea(est: GeneradorCEst, linea: puntero) -> nulo:
    inseguro:
        asm("{")
        asm("    static char _gebuf[1048576];")
        asm("    static int _gepos = 0;")
        asm("    const char* _gs = (const char*)linea;")
        asm("    int _gl = (int)strlen(_gs);")
        asm("    if (_gepos + _gl + 2 > 1048576) return;")
        asm("    memcpy(_gebuf + _gepos, _gs, _gl);")
        asm("    _gepos += _gl;")
        asm("    _gebuf[_gepos] = 10;")
        asm("    _gepos++;")
        asm("    _gebuf[_gepos] = 0;")
        asm("}")

funcion gen_emitir_nueva_linea(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("{")
        asm("    static char _genbuf[1048576];")
        asm("    static int _genpos = 0;")
        asm("    if (_genpos + 2 > 1048576) return;")
        asm("    _genbuf[_genpos] = 10;")
        asm("    _genpos++;")
        asm("    _genbuf[_genpos] = 0;")
        asm("}")

// --- Emit token definitions for embedded parser ---
funcion gen_emitir_token_defs(est: GeneradorCEst) -> nulo:
    si est.gen_defs_emitido == verdadero:
        retornar
    est.gen_defs_emitido = verdadero
    gen_emitir_linea(est, "// --- Token IDs ---")
    gen_emitir_linea(est, "#define T_IF 1")
    gen_emitir_linea(est, "#define T_ELSE 2")
    gen_emitir_linea(est, "#define T_FUNC 3")
    gen_emitir_linea(est, "#define T_RET 4")
    gen_emitir_linea(est, "#define T_SPAWN 5")
    gen_emitir_linea(est, "#define T_RECOVER 6")
    gen_emitir_linea(est, "#define T_LISTEN 7")
    gen_emitir_linea(est, "#define T_WHILE 8")
    gen_emitir_linea(est, "#define T_IMPORT 9")
    gen_emitir_linea(est, "#define T_BREAK 10")
    gen_emitir_linea(est, "#define T_CONTINUE 11")
    gen_emitir_linea(est, "#define T_DOT 12")
    gen_emitir_linea(est, "#define T_IDENT 13")
    gen_emitir_linea(est, "#define T_NUM 14")
    gen_emitir_linea(est, "#define T_STR 15")
    gen_emitir_linea(est, "#define T_GT 16")
    gen_emitir_linea(est, "#define T_LT 17")
    gen_emitir_linea(est, "#define T_EQ 18")
    gen_emitir_linea(est, "#define T_NE 19")
    gen_emitir_linea(est, "#define T_LE 20")
    gen_emitir_linea(est, "#define T_GE 21")
    gen_emitir_linea(est, "#define T_ASSIGN 22")
    gen_emitir_linea(est, "#define T_PLUS 23")
    gen_emitir_linea(est, "#define T_MINUS 24")
    gen_emitir_linea(est, "#define T_MUL 25")
    gen_emitir_linea(est, "#define T_DIV 26")
    gen_emitir_linea(est, "#define T_MOD 27")
    gen_emitir_linea(est, "#define T_ARROW 28")
    gen_emitir_linea(est, "#define T_LPAREN 29")
    gen_emitir_linea(est, "#define T_RPAREN 30")
    gen_emitir_linea(est, "#define T_COLON 31")
    gen_emitir_linea(est, "#define T_COMMA 32")
    gen_emitir_linea(est, "#define T_NL 33")
    gen_emitir_linea(est, "#define T_INDENT 34")
    gen_emitir_linea(est, "#define T_DEDENT 35")
    gen_emitir_linea(est, "#define T_EOF 36")
    gen_emitir_linea(est, "#define T_STRUCT 37")
    gen_emitir_linea(est, "#define T_AND 38")
    gen_emitir_linea(est, "#define T_OR 39")
    gen_emitir_linea(est, "#define T_NOT 40")
    gen_emitir_linea(est, "#define T_TRUE 41")
    gen_emitir_linea(est, "#define T_FALSE 42")
    gen_emitir_linea(est, "#define T_INSEGURO 43")
    gen_emitir_linea(est, "#define T_IMPORTAR_C 44")
    gen_emitir_linea(est, "#define T_AMPERSAND 45")
    gen_emitir_linea(est, "#define T_EXTERNO 46")
    gen_emitir_nueva_linea(est)
    gen_emitir_linea(est, "#define MAX_TOKS 16384")
    gen_emitir_linea(est, "typedef struct { int tipo; int linea; int col; char val[256]; } _P_Token;")
    gen_emitir_linea(est, "// Global state from estado_global.syn")
    gen_emitir_linea(est, "_P_Token _P_tks[MAX_TOKS];")
    gen_emitir_linea(est, "int _P_ntks = 0, _P_tpos = 0, _P_p_err = 0;")
    gen_emitir_linea(est, "int _P_pila_indent[64], _P_nivel_pila = 0;")
    gen_emitir_nueva_linea(est)

// --- Main output accessor ---
funcion gen_obtener_salida(est: GeneradorCEst) -> cadena:
    r = ""
    inseguro:
        asm("if (est.buf_longitud > 0 && est.buf_lineas) {")
        asm("    ((char*)est.buf_lineas)[est.buf_longitud] = 0;")
        asm("    strcpy(_gen_tmp_buf, (const char*)est.buf_lineas);")
        asm("} else {")
        asm("    strcpy(_gen_tmp_buf, \"\");")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// --- Node visiting (main dispatch) ---
funcion gen_visitar_nodo(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("if (idx < 0 || idx >= total_nodos) return;")
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _tipo = _np[0];")
        asm("const char* _str = _np[4] ? (const char*)_np[4] : \"\";")
        asm("int _izq = _np[6];")
        asm("int _der = _np[7];")
        asm("int _her = _np[8];")
        asm("int _extra = _np[9];")
        asm("char _buf[4096], _buf2[4096];")
        asm("")
        asm("if (_tipo == 2)  { gen_visitar_funcion(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 3)  { gen_visitar_si(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 4)  { gen_visitar_mientras(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 5)  { gen_visitar_retornar(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 6)  { gen_visitar_expr_stmt(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 7)  { gen_visitar_asignacion(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 16) { gen_visitar_estructura(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 17) { snprintf(_buf, 4096, \"/* importar %s */\", _str); gen_emitir_linea(est, _buf); return; }")
        asm("if (_tipo == 18) { gen_visitar_lanzar(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 19) { gen_visitar_escuchar(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 20) { gen_emitir_linea(est, \"break;\"); return; }")
        asm("if (_tipo == 21) { gen_emitir_linea(est, \"continue;\"); return; }")
        asm("if (_tipo == 40) { gen_emitir_linea(est, _str); return; }")
        asm("if (_tipo == 25) {")
        asm("    if (_der) {")
        asm("        snprintf(_buf, 4096, \"#include <%s>\", _str);")
        asm("    } else {")
        asm("        snprintf(_buf, 4096, \"#include \\\"%s\\\"\", _str);")
        asm("    }")
        asm("    gen_emitir_linea(est, _buf); return;")
        asm("}")
        asm("if (_tipo == 26) { gen_visitar_externo(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 23) { gen_visitar_constante(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 24) {")
        asm("    gen_emitir_linea(est, \"{ /* unsafe */\");")
        asm("    est.indent_actual = est.indent_actual + 1;")
        asm("    gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _izq);")
        asm("    est.indent_actual = est.indent_actual - 1;")
        asm("    gen_emitir_linea(est, \"}\"); return;")
        asm("}")
        asm("if (_tipo == 34) { gen_visitar_declaracion(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 35) { gen_visitar_log(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 32) { gen_visitar_asignacion_campo(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 38) { gen_visitar_coincidir(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 42) { gen_visitar_enviar_canal(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 45) { gen_visitar_para(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("if (_tipo == 27) { gen_visitar_recuperar(est, nodos, total_nodos, tokens, total_tokens, idx); return; }")
        asm("// Fallback: expression statement")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, idx, _buf, 4096);")
        asm("snprintf(_buf2, 4096, \"%s;\", _buf);")
        asm("gen_emitir_linea(est, _buf2);")

funcion gen_visitar_bloque_lista(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int _cur = idx;")
        asm("while (_cur > 0 && _cur < total_nodos) {")
        asm("    gen_visitar_nodo(est, nodos, total_nodos, tokens, total_tokens, _cur);")
        asm("    _cur = ((int*)nodos)[_cur * 11 + 8]; // hermano")
        asm("}")

// --- Visit function definition ---
funcion gen_visitar_funcion(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("const char* _name = (const char*)_np[4];")
        asm("const char* _ret = (const char*)_np[5];")
        asm("int _params = _np[6];")
        asm("int _body = _np[7];")
        asm("if (!_name) return;")
        asm("// Check already emitted")
        asm("for (int _fi = 0; _fi < est.funciones_emitidas; _fi++) {")
        asm("    if (strcmp((const char*)est.func_emitidas_nombres + _fi * 64, _name) == 0) return;")
        asm("}")
        asm("strcpy(est.func_emitidas_nombres.datos + est.funciones_emitidas * 64, _name);")
        asm("est.funciones_emitidas = est.funciones_emitidas + 1;")
        asm("// Skip runtime builtins")
        asm("const char* _skip[] = {\"escribir\",\"escribir_linea\",\"leer_linea\",\"abrir\",\"leer\",\"cerrar\",")
        asm("    \"crear_tensor\",\"suma_tensor\",\"producto_punto\",\"relu\",\"reserva\",\"libera\",")
        asm("    \"suma\",\"producto\",\"math_crear_tensor\",\"math_suma_tensor\",\"math_producto_punto\",")
        asm("    \"math_relu\",\"mem_reserva\",\"mem_libera\",\"math_suma\",\"math_producto\",")
        asm("    \"texto_a_entero\",\"texto_a_decimal\",\"decimal_a_texto\",\"entero_a_texto\",NULL};")
        asm("for (int _si = 0; _skip[_si]; _si++) {")
        asm("    if (strcmp(_name, _skip[_si]) == 0) return;")
        asm("}")
        asm("// Handle special compiler functions")
        asm("if (strcmp(_name, \"tokenizar\") == 0) { gen_emitir_tokenizar_c(est); return; }")
        asm("if (strcmp(_name, \"parsear\") == 0) { gen_emitir_parsear_c(est); return; }")
        asm("if (strcmp(_name, \"generar\") == 0) { gen_emitir_generar_c(est); return; }")
        asm("if (strcmp(_name, \"volcar_ast\") == 0) { gen_emitir_volcar_ast_c(est); return; }")
        asm("// Build params")
        asm("char _params_str[4096] = \"void\";")
        asm("int _ppos = 0, _first = 1;")
        asm("int _pcur = _params;")
        asm("while (_pcur > 0 && _pcur < total_nodos) {")
        asm("    int* _pp = (int*)nodos + _pcur * 11;")
        asm("    if (_pp[0] == 15) {")
        asm("        const char* _pn = (const char*)_pp[4];")
        asm("        const char* _pt = (const char*)_pp[5];")
        asm("        if (_first) { _ppos = 0; _first = 0; } else { _params_str[_ppos++] = ','; _params_str[_ppos++] = ' '; }")
        asm("        traducir_tipo_c(_pt);")
        asm("        int _k = 0; while (_gen_tmp_buf[_k]) _params_str[_ppos++] = _gen_tmp_buf[_k++];")
        asm("        _params_str[_ppos++] = ' ';")
        asm("        _k = 0; while (_pn[_k]) _params_str[_ppos++] = _pn[_k++];")
        asm("    }")
        asm("    _pcur = _pp[8];")
        asm("}")
        asm("_params_str[_ppos] = 0;")
        asm("// Return type")
        asm("char _ret_type[64];")
        asm("traducir_tipo_c(_ret);")
        asm("strcpy(_ret_type, _gen_tmp_buf);")
        asm("strcpy((char*)est.func_retorno_actual, _ret_type);")
        asm("// Emit function")
        asm("char _buf[4096];")
        asm("snprintf(_buf, 4096, \"%s %s(%s) {\", _ret_type, _name, _params_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_push_scope(est);")
        asm("gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _body);")
        asm("gen_pop_scope(est);")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("gen_emitir_linea(est, \"}\");")
        asm("gen_emitir_nueva_linea(est);")

// --- Visit if ---
funcion gen_visitar_si(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
    inseguro:
        asm("int* _np = (int*)nodos + idx * 11;")
        asm("int _cond = _np[6];")
        asm("int _body = _np[7];")
        asm("int _sino = _np[8];")
        asm("char _cond_str[4096];")
        asm("gen_expr_a_c(est, nodos, total_nodos, tokens, total_tokens, _cond, _cond_str, 4096);")
        asm("char _buf[4096];")
        asm("snprintf(_buf, 4096, \"if (%s) {\", _cond_str);")
        asm("gen_emitir_linea(est, _buf);")
        asm("est.indent_actual = est.indent_actual + 1;")
        asm("gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _body);")
        asm("est.indent_actual = est.indent_actual - 1;")
        asm("if (_sino > 0 && _sino < total_nodos) {")
        asm("    gen_emitir_linea(est, \"} else {\");")
        asm("    est.indent_actual = est.indent_actual + 1;")
        asm("    gen_visitar_bloque_lista(est, nodos, total_nodos, tokens, total_tokens, _sino);")
        asm("    est.indent_actual = est.indent_actual - 1;")
        asm("}")
        asm("gen_emitir_linea(est, \"}\");")

// --- Visit while ---
funcion gen_visitar_mientras(est: GeneradorCEst, nodos: entero, total_nodos: entero, tokens: entero, total_tokens: entero, idx: entero) -> nulo:
