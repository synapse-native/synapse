        asm("            strncpy(_G_native_structs[_G_native_structs_count], _ged->nombre.datos, 63);")
        asm("            _G_native_structs[_G_native_structs_count][63] = 0;")
        asm("            _G_native_structs_count++;")
        asm("        }")
        asm("    }")
        asm("    _gec = _gec->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B4: %d estructuras registradas\\n\", _G_native_structs_count); fflush(stderr);")

    // ME-B6: recolectar tipos de retorno de funciones definidas en array nativo
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] ME-B6: escaneando tipos de retorno\\n\"); fflush(stderr);")
        asm("extern char _G_native_func_returns[512][64]; extern int _G_native_func_returns_count;")
        asm("_G_native_func_returns_count = 0;")
        asm("// ME-B6 paridad context.py:52 / emit_selfhost.py L914: seed de builtins de runtime\n")
        asm("// (sus tipos de retorno no estan en el AST; sin seed, x = _argv(1) infiere int).\n")
        asm("static const char* _G_rt_builtin_fns[] = { \"_argv\",\"leer\",\"leer_linea\",\"concat\",\"entero_a_texto\",\"decimal_a_texto\",\"subcadena\",\"_syn_obtener_env\",\"leer_archivo\",\"_syn_leer_archivo\",\"texto_a_entero\",\"texto_a_decimal\",\"salir\",\"escribir\",\"escribir_linea\",\"cerrar\",\"_argc\" };")
        asm("static const char* _G_rt_builtin_ret[] = { \"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"cadena\",\"entero\",\"decimal\",\"nulo\",\"nulo\",\"nulo\",\"nulo\",\"entero\" };")
        asm("for (int _rbi = 0; _rbi < (int)(sizeof(_G_rt_builtin_fns)/sizeof(_G_rt_builtin_fns[0])); _rbi++) {")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count], _G_rt_builtin_fns[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("    strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _G_rt_builtin_ret[_rbi], 63);")
        asm("    _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("    _G_native_func_returns_count++;")
        asm("}")
        asm("struct ListaNodo* _gefr = programa.sentencias;")
        asm("while (_gefr && _G_native_func_returns_count < 255) {")
        asm("    struct Nodo* _gefn = _gefr->cabeza;")
        asm("    if (_gefn && _gefn->tipo.datos && strcmp(_gefn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _geff = (struct DefinicionFuncion*)_gefn;")
        asm("        if (_geff->nombre.datos && _geff->tipo_retorno.datos) {")
        asm("            strncpy(_G_native_func_returns[_G_native_func_returns_count], _geff->nombre.datos, 63);")
        asm("            _G_native_func_returns[_G_native_func_returns_count][63] = 0;")
        asm("            strncpy(_G_native_func_returns[_G_native_func_returns_count + 256], _geff->tipo_retorno.datos, 63);")
        asm("            _G_native_func_returns[_G_native_func_returns_count + 256][63] = 0;")
        asm("            _G_native_func_returns_count++;")
        asm("        }")
        asm("    }")
        asm("    _gefr = _gefr->cola;")
        asm("}")
        asm("fprintf(stderr, \"[Orquestador] ME-B6: %d retornos registrados\\n\", _G_native_func_returns_count); fflush(stderr);")

    // WALK TOP-LEVEL AST
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Iniciando recorrido AST\\n\"); fflush(stderr);")
        asm("// Manual 8 S8.2: orden alfabetico estricto en emision de funciones/estructuras")
        asm("// Colectar todos los nodos top-level en un array para ordenarlos")
        asm("#define _MAX_TOP_NODOS 4096")
        asm("struct Nodo* _top_nodes[_MAX_TOP_NODOS];")
        asm("int _top_count = 0;")
        asm("struct ListaNodo* _cur = programa.sentencias;")
        asm("char _top_seen_names[2048][64]; int _top_seen_count = 0;")
        asm("while (_cur && _top_count < _MAX_TOP_NODOS) {")
        asm("    struct Nodo* _n = _cur->cabeza;")
        asm("    if (_n && _n->tipo.datos) {")
        asm("        const char* _tcf = _n->tipo.datos;")
        asm("        int _drop = 0;")
        asm("        // Manual 8 S8.2 determinismo: descartar el artefacto 'constante' parseado como SentenciaExpr\n")
        asm("        if (strcmp(_tcf, \"SentenciaExpr\") == 0) {")
        asm("            struct SentenciaExpr* _sfc = (struct SentenciaExpr*)_n;")
        asm("            if (_sfc->expr && _sfc->expr->tipo.datos && strcmp(_sfc->expr->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _idc = (struct Identificador*)_sfc->expr;")
        asm("                if (_idc->nombre.datos && strcmp(_idc->nombre.datos, \"constante\") == 0) _drop = 1;")
        asm("            }")
        asm("        }")
        asm("        // Manual 8 S8.2 determinismo: deduplicar constantes globales por nombre (primero gana)\n")
        asm("        const char* _cname = 0;")
        asm("        if (strcmp(_tcf, \"AsignacionVariable\") == 0) {")
        asm("            struct AsignacionVariable* _avc = (struct AsignacionVariable*)_n;")
        asm("            if (_avc->nombre.datos) _cname = _avc->nombre.datos;")
        asm("        }")
        asm("        if (_cname) {")
        asm("            int _seen = 0;")
        asm("            for (int _si2 = 0; _si2 < _top_seen_count; _si2++) { if (strcmp(_top_seen_names[_si2], _cname) == 0) { _seen = 1; break; } }")
        asm("            if (_seen) { _drop = 1; } else { strncpy(_top_seen_names[_top_seen_count], _cname, 63); _top_seen_count++; }")
        asm("        }")
        asm("        if (!_drop) { _top_nodes[_top_count++] = _n; }")
        asm("    }")
        asm("    _cur = _cur->cola;")
        asm("}")
        asm("// Bubble sort por nombre de funcion/estructura; otros tipos conservan orden relativo")
        asm("for (int _si = 0; _si < _top_count - 1; _si++) {")
        asm("    for (int _sj = 0; _sj < _top_count - 1 - _si; _sj++) {")
        asm("        struct Nodo* _a = _top_nodes[_sj];")
        asm("        struct Nodo* _b = _top_nodes[_sj+1];")
        asm("        const char* _ta = _a->tipo.datos;")
        asm("        const char* _tb = _b->tipo.datos;")
        asm("        int _swap = 0;")
        asm("        // Solo ordenar funciones y estructuras por nombre")
        asm("        if (_ta && _tb && strcmp(_ta, \"DefinicionFuncion\") == 0 && strcmp(_tb, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _fa = (struct DefinicionFuncion*)_a;")
        asm("            struct DefinicionFuncion* _fb = (struct DefinicionFuncion*)_b;")
        asm("            if (_fa->nombre.datos && _fb->nombre.datos && strcmp(_fa->nombre.datos, _fb->nombre.datos) > 0) _swap = 1;")
        asm("        } else if (_ta && _tb && strcmp(_ta, \"DefinicionEstructura\") == 0 && strcmp(_tb, \"DefinicionEstructura\") == 0) {")
        asm("            struct DefinicionEstructura* _ea = (struct DefinicionEstructura*)_a;")
        asm("            struct DefinicionEstructura* _eb = (struct DefinicionEstructura*)_b;")
        asm("            if (_ea->nombre.datos && _eb->nombre.datos && strcmp(_ea->nombre.datos, _eb->nombre.datos) > 0) _swap = 1;")
        asm("        }")
        asm("        if (_swap) { struct Nodo* _tmp = _top_nodes[_sj]; _top_nodes[_sj] = _top_nodes[_sj+1]; _top_nodes[_sj+1] = _tmp; }")
        asm("    }")
        asm("}")
        asm("// Fase 1: emitir TODAS las DefinicionEstructura primero (dependencias de tipos)")
        asm("fprintf(stderr, \"[Orquestador] Fase 1: emitiendo estructuras\\n\"); fflush(stderr);")
        asm("for (int _ei = 0; _ei < _top_count; _ei++) {")
        asm("    struct Nodo* _en = _top_nodes[_ei];")
        asm("    if (_en && _en->tipo.datos && strcmp(_en->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _de0 = (struct DefinicionEstructura*)_en;")
        asm("        if (_de0->nombre.datos && strcmp(_de0->nombre.datos, \"Token\") != 0 && strcmp(_de0->nombre.datos, \"Nodo\") != 0 && strcmp(_de0->nombre.datos, \"ListaNodo\") != 0 && strcmp(_de0->nombre.datos, \"Programa\") != 0) {")
        asm("            char _stbuf0[4096];")
        asm("            snprintf(_stbuf0, 4096, \"typedef struct %s {\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stbuf0);")
        asm("            struct ListaParametro* _fcp0 = _de0->campos;")
        asm("            while (_fcp0) {")
        asm("                struct Parametro* _fp0 = (struct Parametro*)_fcp0->cabeza;")
        asm("                if (_fp0 && _fp0->nombre.datos && _fp0->tipo_param.datos) {")
        asm("                    // ME-B7: _ARRAY_OVERRIDE_FIELDS (paridad context.py L236-239):")
        asm("                    // pila_indent es int[64] aunque el .syn declara entero (asm() raw lo indexa).")
        asm("                    if (strcmp(_fp0->nombre.datos, \"pila_indent\") == 0) { gen_emitir_str(est, \"    int pila_indent[64];\"); }")
        asm("                    else {")
        asm("                        traducir_tipo_c_campo((void*)_fp0->tipo_param.datos);")
        asm("                        extern char _gen_tmp_buf[4096];")
        asm("                        const char* _fct0 = _gen_tmp_buf;")
        asm("                        char _fld0[4096];")
        asm("                        snprintf(_fld0, 4096, \"    %s %s;\", _fct0, _fp0->nombre.datos);")
        asm("                        gen_emitir_str(est, _fld0);")
        asm("                    }")
        asm("                }")
        asm("                _fcp0 = _fcp0->cola;")
        asm("            }")
        asm("            char _stclose0[4096];")
        asm("            snprintf(_stclose0, 4096, \"} %s;\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stclose0);")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// ME-B7: prototipos de funciones (Manual 8 S8.2, paridad _emit_prototipos_funciones + _SPECIAL_SIGS)")
        asm("// El C de salida no tiene prototipos si no se emiten: las llamadas entre modulos")
        asm("// (orden alfabetico) fallarian con 'implicit declaration / conflicting types'.")
        asm("_G_emit_func_count = 0;")
        asm("for (int _pi = 0; _pi < _top_count; _pi++) {")
        asm("    struct Nodo* _pn0 = _top_nodes[_pi];")
        asm("    if (!_pn0 || !_pn0->tipo.datos || strcmp(_pn0->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    struct DefinicionFuncion* _pf0 = (struct DefinicionFuncion*)_pn0;")
        asm("    if (!_pf0->nombre.datos || !_pf0->tipo_retorno.datos) continue;")
        asm("    const char* _pfn0 = _pf0->nombre.datos;")
        asm("    // Paridad emit_selfhost.py L1203: saltar builtins de runtime (str_eq, etc.)")
        asm("    if (_es_builtin_runtime((void*)_pfn0)) continue;")
        asm("    // Dedup por nombre (parser.syn define parsear_tipo_retorno 2 veces; la referencia")
        asm("    // usa _funciones_emitidas — paridad: primer prototipo gana).")
        asm("    int _pfd = 0;")
        asm("    for (int _pd = 0; _pd < _G_emit_func_count; _pd++) { if (strcmp(_G_emit_func_names[_pd], _pfn0) == 0) { _pfd = 1; break; } }")
        asm("    if (_pfd) continue;")
        asm("    strncpy(_G_emit_func_names[_G_emit_func_count], _pfn0, 63); _G_emit_func_names[_G_emit_func_count][63] = 0; _G_emit_func_count++;")
        asm("    char _psig0[4096];")
        asm("    // _SPECIAL_SIGS: firmas canonicas que reemplazan las definiciones legacy")
        asm("    if (strcmp(_pfn0, \"tokenizar\") == 0) { strcpy(_psig0, \"int tokenizar(CadenaSegura fuente);\"); }")
        asm("    else if (strcmp(_pfn0, \"parsear\") == 0) { strcpy(_psig0, \"struct Programa parsear(CadenaSegura fuente);\"); }")
        asm("    else if (strcmp(_pfn0, \"volcar_ast\") == 0) { strcpy(_psig0, \"void volcar_ast(struct Nodo* nodo, int nivel);\"); }")
        asm("    else if (strcmp(_pfn0, \"generar\") == 0) { strcpy(_psig0, \"int generar(struct Programa programa, CadenaSegura ruta);\"); }")
        asm("    else {")
        asm("        char _pp0[4096] = \"void\"; int _ppo0 = 0, _ppf0 = 1;")
        asm("        struct ListaParametro* _ppc0 = _pf0->parametros;")
        asm("        while (_ppc0) {")
        asm("            struct Parametro* _ppar = (struct Parametro*)_ppc0->cabeza;")
        asm("            if (_ppar && _ppar->nombre.datos && _ppar->tipo_param.datos) {")
        asm("                if (_ppf0) { _ppo0 = 0; _ppf0 = 0; } else { _pp0[_ppo0++] = ','; _pp0[_ppo0++] = ' '; }")
        asm("                const char* _ppt0 = _ppar->tipo_param.datos;")
        asm("                traducir_tipo_c((void*)_ppt0);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                const char* _pct0 = _gen_tmp_buf;")
        asm("                // Manual 3 S3.3 / paridad _POINTER_TYPES: tipos de estado se pasan por puntero")
        asm("                if (_ppt0 && (strcmp(_ppt0, \"AnalizadorSemanticoEst\") == 0 || strcmp(_ppt0, \"RegionGraph\") == 0 || strcmp(_ppt0, \"UnionFind\") == 0)) { strcat(_gen_tmp_buf, \"*\"); _pct0 = _gen_tmp_buf; }")
        asm("                int _pk0 = 0; while (_pct0[_pk0]) _pp0[_ppo0++] = _pct0[_pk0++];")
        asm("                _pp0[_ppo0++] = ' ';")
        asm("                _pk0 = 0; while (_ppar->nombre.datos[_pk0]) _pp0[_ppo0++] = _ppar->nombre.datos[_pk0++];")
        asm("            }")
        asm("            _ppc0 = _ppc0->cola;")
        asm("        }")
        asm("        _pp0[_ppo0] = 0;")
        asm("        traducir_tipo_c((void*)_pf0->tipo_retorno.datos);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        snprintf(_psig0, 4096, \"%s %s(%s);\", _gen_tmp_buf, _pfn0, _pp0);")
        asm("    }")
        asm("    gen_emitir_str(est, _psig0);")
        asm("}")
        asm("gen_emitir_str(est, \"\");")
        asm("// Manual 8 S8.2 / paridad _emit_cuerpos (generator.py L747-753):")
        asm("// Fase 2A: emitir PRIMERO las sentencias no-funcion (constantes globales, externs,")
        asm("// imports) en orden de parse — requisito de C: las constantes deben existir antes")
        asm("// que cualquier cuerpo de funcion que las use.")
        asm("_G_emit_func_count = 0;")
        asm("fprintf(stderr, \"[Orquestador] Fase 2A: no-funciones primero\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") == 0) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionEstructura\") == 0) continue;")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")
        asm("// Fase 2B: funciones en orden alfabetico (Manual 8 S8.2)")
        asm("fprintf(stderr, \"[Orquestador] Fase 2B: funciones en orden alfabetico\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")

    // Manual 8 S8.3 / paridad referencia: PGO via flags GCC (sin atexit manual)

    // Emit main() wrapper
    // Manual 8 S8.2 / paridad emit_selfhost.py L1207: NO usar el valor de
    // retorno de principal() — si principal retorna nulo (void) el C fallaria
    // con 'void value not ignored'. La referencia llama principal();,
    // synapse_esperar_hilos();, pool_destroy(); y retorna 0.
    gen_emitir_linea(est, "int main(int argc, char** argv) {")
    gen_emitir_linea(est, "    _g_argc = argc;")
    gen_emitir_linea(est, "    _g_argv = argv;")
    gen_emitir_linea(est, "    pool_init(64, 4096);")
    gen_emitir_linea(est, "    principal();")
    gen_emitir_linea(est, "    synapse_esperar_hilos();")
    gen_emitir_linea(est, "    pool_destroy();")
    gen_emitir_linea(est, "    return 0;")
    gen_emitir_linea(est, "}")

    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Escribiendo archivo de salida...\\n\"); fflush(stderr);")
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("extern FILE* _G_fp;")
        asm("if (!_G_fp) { fprintf(stderr, \"[Orquestador] ERROR FATAL: _G_fp nulo\\n\"); r = 1; return r; }")
        asm("if (_G_emit_pos > 0) {")
        asm("    fwrite(_G_emit_buf, 1, _G_emit_pos, _G_fp);")
        asm("}")
        asm("fclose(_G_fp);")
        asm("_G_fp = nulo;")
        asm("fprintf(stderr, \"[Nuevo Generador] Codigo C generado exitosamente\\n\"); fflush(stderr);")
    retornar r

// ----------------------------------------------------------

// ----------------------------------------------------------
// _es_builtin_runtime — paridad emit_selfhost.py L1203: los builtins de
// runtime (definidos en synapse_rt.o) no se re-emiten como funciones.
// ----------------------------------------------------------
funcion _es_builtin_runtime(nombre: puntero) -> entero:
    inseguro:
        asm("const char* _bn = (const char*)nombre;")
        asm("if (!_bn) return 0;")
        asm("static const char* _rtb[] = { \"escribir\", \"escribir_linea\", \"leer_linea\", \"abrir\", \"leer\", \"cerrar\", \"crear_tensor\", \"suma_tensor\", \"producto_punto\", \"relu\", \"reserva\", \"libera\", \"suma\", \"producto\", \"math_crear_tensor\", \"math_suma_tensor\", \"math_producto_punto\", \"math_relu\", \"mem_reserva\", \"mem_libera\", \"math_suma\", \"math_producto\", \"str_eq\", \"texto_a_entero\", \"texto_a_decimal\", \"decimal_a_texto\", \"entero_a_texto\", \"concat\", \"_syn_texto_liberar\", \"leer_archivo\", \"_syn_leer_archivo\" };")
        asm("for (int _bi = 0; _bi < (int)(sizeof(_rtb)/sizeof(_rtb[0])); _bi++) {")
        asm("    if (strcmp(_bn, _rtb[_bi]) == 0) return 1;")
        asm("}")
        asm("return 0;")

funcion gen_visitar_top_level(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) exit(1);")
        asm("fprintf(stderr, \"[DBG-TOP] %s\\n\", _t); fflush(stderr);")
        asm("if (_syn_es_tipo(_t, \"DefinicionFuncion\")) {")
        asm("    struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_n;")
        asm("    const char* _fn = _f->nombre.datos;")
        asm("    if (!_fn) exit(1);")
        asm("    // Paridad emit_selfhost.py L1203: saltar builtins de runtime en definiciones")
        asm("    if (_es_builtin_runtime((void*)_fn)) return;")
        asm("    // ME-B7: dedup de DEFINICIONES (paridad _funciones_emitidas) — primer cuerpo gana")
        asm("    int _fd = 0;")
        asm("    for (int _fd2 = 0; _fd2 < _G_emit_func_count; _fd2++) { if (strcmp(_G_emit_func_names[_fd2], _fn) == 0) { _fd = 1; break; } }")
        asm("    if (_fd) return;")
        asm("    if (_G_emit_func_count < 2048) { strncpy(_G_emit_func_names[_G_emit_func_count], _fn, 63); _G_emit_func_names[_G_emit_func_count][63] = 0; _G_emit_func_count++; }")
        asm("    // ME-B7: reset del registro de variables por funcion (hoisting — primera declaracion gana)")
        asm("    _G_fn_vars_count = 0;")
        asm("    // ME-B7: limpiar arrays de hoisting (evita datos stale entre funciones)")
        asm("    memset(_G_fn_var_auto, 0, sizeof(int) * 2048);")
        asm("    memset(_G_fn_var_src, 0, sizeof(void*) * 2048);")
        asm("    struct ListaParametro* _fpv = _f->parametros;")
        asm("    while (_fpv) {")
        asm("        struct Parametro* _ppv = (struct Parametro*)_fpv->cabeza;")
        asm("        if (_ppv && _ppv->nombre.datos && _G_fn_vars_count < 2048) {")
        asm("            strncpy(_G_fn_vars[_G_fn_vars_count], _ppv->nombre.datos, 63); _G_fn_vars[_G_fn_vars_count][63] = 0; _G_fn_vars_count++;")
        asm("        }")
        asm("        _fpv = _fpv->cola;")
        asm("    }")
        asm("    // ME-B7: pre-pass recursivo de hoisting (paridad _collect_vars de emit_declarations.py)")
        asm("    // Registra TODAS las variables auto-declaradas del cuerpo (recursivo en si/mientras/inseguro/para).")
        asm("    struct Nodo* _hp_stack[1024];")
        asm("    int _hp_top = 0;")
        asm("    struct ListaNodo* _hp0 = _f->cuerpo;")
        asm("    while (_hp0) { if (_hp0->cabeza && _hp_top < 1024) { _hp_stack[_hp_top++] = _hp0->cabeza; } _hp0 = _hp0->cola; }")
        asm("    while (_hp_top > 0) {")
        asm("        struct Nodo* _hp_n = _hp_stack[--_hp_top];")
        asm("        if (_hp_n && _hp_n->tipo.datos) {")
        asm("            const char* _hp_t = _hp_n->tipo.datos;")
        asm("            if (strcmp(_hp_t, \"AsignacionVariable\") == 0) {")
        asm("                struct AsignacionVariable* _hp_a = (struct AsignacionVariable*)_hp_n;")
        asm("                if (_hp_a->nombre.datos) {")
        asm("                    int _hp_f = 0;")
        asm("                    for (int _hpi = 0; _hpi < _G_fn_vars_count; _hpi++) { if (strcmp(_G_fn_vars[_hpi], _hp_a->nombre.datos) == 0) { _hp_f = 1; break; } }")
