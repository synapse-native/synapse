constante T_MAS = 30
constante T_MENOS = 31
constante T_POR = 32
constante T_DIV = 33
constante T_MOD = 34
constante T_PUNTO = 13
constante T_IGUAL = 25
constante T_DISTINTO = 26
constante T_MENOR = 24
constante T_MAYOR = 23
constante T_MENOR_IGUAL = 27
constante T_MAYOR_IGUAL = 28
constante T_Y = 14
constante T_O = 15
constante T_NO = 16
constante T_AMPERSAND = 45
constante T_FLECHA = 35
constante T_FIN = 57

// ----------------------------------------------------------
// Estructura de estado del generador (única, pasada por valor)
// ----------------------------------------------------------
estructura GeneradorCEst:
    // --- Output buffer ---
    buf_lineas: entero // pointer to buffer (void* stored as int)
    buf_capacidad: entero // total buffer capacity
    buf_longitud: entero // current write position
    indent_actual: entero // current indentation level (spaces * 4)
    archivo_actual: entero // FILE* stored as intptr_t (for fwrite/fclose)

    // --- Function tracking ---
    contador_thread: entero
    contador_listener: entero
    funciones_emitidas: entero
    func_emitidas_nombres: cadena
    func_return_types_nombres: cadena
    func_return_types_tipos: cadena
    func_return_types_total: entero
    in_function_scope: booleano

    // --- Variable tracking ---
    var_nombres: cadena
    var_tipos: cadena
    var_total: entero
    var_capacidad: entero
    const_types_nombres: cadena
    const_types_tipos: cadena
    const_types_total: entero

    // --- Scope stack (RAII) ---
    scope_var_nombres: cadena
    scope_var_tipos: cadena
    scope_var_total: entero
    scope_stack_top: entero
    scope_stack_at: entero

    // --- Tensor / canal tracking ---
    tensor_vars: cadena
    tensor_vars_total: entero
    tensor_transferidas: cadena
    tensor_transferidas_total: entero
    canal_vars: cadena
    canal_vars_total: entero
    canal_cerradas: cadena
    canal_cerradas_total: entero

    // --- Listener tracking ---
    listener_funciones: cadena
    listener_total: entero

    // --- Struct tracking ---
    struct_nombres: cadena
    struct_total: entero
    struct_nombres_c: cadena
    struct_total_c: entero

    // --- External function tracking ---
    extern_nombres: cadena
    extern_params: cadena
    extern_total: entero

    // --- Destructor map (RAII) ---
    dtor_tipos: cadena
    dtor_funcs: cadena
    dtor_total: entero

    // --- Emit flags ---
    gen_tok_emitido: booleano
    gen_parse_emitido: booleano
    gen_defs_emitido: booleano

    // --- Contract (requiere/garantiza) ---
    garantizas_nombres: cadena
    garantizas_valores: cadena
    garantizas_total: entero

    // --- Program-level flags ---
    es_no_std: booleano
    linker_libs: cadena
    linker_libs_total: entero

    // --- Build buffer for code generation ---
    build_buf: cadena

    // --- Current function return type ---
    func_retorno_actual: cadena

    // --- Strings on heap ---
    strings_heap: cadena
    strings_heap_total: entero

    // --- M22.2: Scope tracking (native RAII, est pasada por valor) ---
    // scope_depth se maneja via global _G_scope_depth (no persiste en est)

    // --- M22.5: --safe mode (lifetime assertions in generated C) ---
    safe_mode: booleano
    // NOTA: safe_mode se propaga via global _G_safe_mode porque est se pasa por valor

// ----------------------------------------------------------
// Tamaño del buffer temporal global
// ----------------------------------------------------------
constante _GEN_TMP_SIZE = 4096
constante _G_SCOPE_MAX_VARS = 256

// ===== From: emision_c.syn =====

#lang: es
// cumple Manual 1 §7.1 (ME formatter_fix R4): reformato cosmético del nucleo con synapse fmt — estilo, sin cambios semánticos
// ============================================================
// emision_c.syn — API de emision de codigo C de bajo nivel
// ============================================================

// ----------------------------------------------------------
// traducir_tipo_c
// ----------------------------------------------------------
funcion traducir_tipo_c(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("if (!_t) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("int _len = (int)strlen(_t);")
        asm("if (_len > 7 && _t[0]=='C' && _t[1]=='a' && _t[2]=='n' && _t[3]=='a' && _t[4]=='l' && _t[5]=='<') { strcpy(_gen_tmp_buf, \"CanalConcurrencia*\"); return; }")
        // F1.2d + F1.4: rc<T>/arc<T>/debil<T> (Manual 2 sec. 4.3). ABI placeholder
        // (void*) hasta la Fase 23 (runtime real de rc/arc/debil, ROADMAP Fase 23).
        // F1.4 anade 'rc<' (Manual 2 sec. 4 L151: "rc" tipo).
        asm("if (strncmp(_t, \"rc<\", 3)==0 || strncmp(_t, \"arc<\", 4)==0 || strncmp(_t, \"weak<\", 5)==0 || strncmp(_t, \"faible<\", 7)==0 || strncmp(_t, \"fraco<\", 6)==0 || strncmp(_t, \"d\u00e9bil<\", 6)==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        // D-2: instanciaciones de ADT genéricos registradas (monomorfización).
        // `Resultado<entero, texto>` -> struct especializado `Resultado_entero_texto`
        // (Manual 2 §4.2 L279-280). Paridad context.py traducir_tipo_c.
        asm("extern char _G_native_adt_inst_type[64][64]; extern char _G_native_adt_inst_c[64][64]; extern int _G_native_adt_inst_count;")
        asm("if (strchr(_t, '<')) {")
        asm("    char _d2t[128]; int _d2w = 0; for (int _d2c = 0; _t[_d2c] && _d2w < 120; _d2c++) { if (_t[_d2c] != ' ') _d2t[_d2w++] = _t[_d2c]; } _d2t[_d2w] = 0;")
        asm("    for (int _d2i = 0; _d2i < _G_native_adt_inst_count; _d2i++) {")
        asm("        if (strcmp(_G_native_adt_inst_type[_d2i], _d2t) == 0) { strcpy(_gen_tmp_buf, _G_native_adt_inst_c[_d2i]); return; }")
        asm("    }")
        asm("}")
        asm("if (_len > 10 && _t[0]=='R' && _t[1]=='e' && _t[2]=='s' && _t[3]=='u' && _t[4]=='l' && _t[5]=='t' && _t[6]=='a' && _t[7]=='d' && _t[8]=='o' && _t[9]=='<') { strcpy(_gen_tmp_buf, \"Resultado_T\"); return; }")
        asm("if (strcmp(_t, \"entero\")==0 || strcmp(_t, \"int\")==0) { strcpy(_gen_tmp_buf, \"int64_t\"); return; }") // A5.2 D-7: entero -> int64_t (Manual 2 S4.1 L267-268)
        // cumple Manual 2 §4.3 (r153 R3n): colecciones stdlib — handle del runtime
        // (runtime/core/lista.c/mapa.c, slots int64, OBL-M6-5). Paridad S1 context.py.
        asm("if (_t[0]=='L' && strncmp(_t, \"Lista<\", 6)==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("if (_t[0]=='M' && strncmp(_t, \"Mapa<\", 5)==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        asm("if (strcmp(_t, \"vacio\")==0 || strcmp(_t, \"nulo\")==0 || strcmp(_t, \"void\")==0) { strcpy(_gen_tmp_buf, \"void\"); return; }")
        asm("if (strcmp(_t, \"decimal\")==0 || strcmp(_t, \"real\")==0 || strcmp(_t, \"flotante\")==0 || strcmp(_t, \"float\")==0) { strcpy(_gen_tmp_buf, \"double\"); return; }") // A5.2 D-7: decimal -> double (Manual 2 S4.1 L267-268)
        asm("if (strcmp(_t, \"Tensor\")==0 || strcmp(_t, \"tensor\")==0) { strcpy(_gen_tmp_buf, \"Tensor\"); return; }")
        asm("if (strcmp(_t, \"Canal\")==0 || strcmp(_t, \"canal\")==0) { strcpy(_gen_tmp_buf, \"Canal\"); return; }")
        asm("if (strcmp(_t, \"texto\")==0 || strcmp(_t, \"cadena\")==0) { strcpy(_gen_tmp_buf, \"CadenaSegura\"); return; }")
        asm("if (strcmp(_t, \"booleano\")==0 || strcmp(_t, \"logico\")==0) { strcpy(_gen_tmp_buf, \"int\"); return; }")
        asm("if (strcmp(_t, \"char\")==0) { strcpy(_gen_tmp_buf, \"char\"); return; }")
        asm("if (strcmp(_t, \"double\")==0) { strcpy(_gen_tmp_buf, \"double\"); return; }")
        asm("if (strcmp(_t, \"puntero\")==0) { strcpy(_gen_tmp_buf, \"void*\"); return; }")
        // M22.6 (paridad context.py L466-469): tipos puntero C (p.ej. char*, int*)
        // -> se traduce la base y se re-anade '*'. Sin esto 'char*' caia al fallback
        // 'struct char*' y rompia externs como los de std.http/std.net.
        asm("if (_len > 0 && _t[_len-1] == '*') {")
        asm("    char _pt[64]; int _pw = 0; for (int _pc = 0; _pc < _len-1 && _pw < 62; _pc++) _pt[_pw++] = _t[_pc]; _pt[_pw] = 0;")
        asm("    while (_pw > 0 && _pt[_pw-1] == ' ') _pt[--_pw] = 0;")
        asm("    traducir_tipo_c((void*)_pt);")
        asm("    strcat(_gen_tmp_buf, \"*\");")
        asm("    return;")
        asm("}")
        // F1.2b: resolver alias declarados (`tipo X = Y`) — paridad context.py L399-400
        // (recursion: un alias puede apuntar a otro alias).
        asm("extern char _G_tipo_aliases[128][64]; extern char _G_tipo_aliases_base[128][64]; extern int _G_tipo_aliases_count;")
        asm("for (int _tai = 0; _tai < _G_tipo_aliases_count; _tai++) {")
        asm("    if (strcmp(_G_tipo_aliases[_tai], _t) == 0) {")
        asm("        traducir_tipo_c((void*)_G_tipo_aliases_base[_tai]);")
        asm("        return;")
        asm("    }")
        asm("}")
        asm("snprintf(_gen_tmp_buf, 64, \"struct %s\", _t);")

// ----------------------------------------------------------
// traducir_tipo_c_campo
// Manual 8 S8.2 + paridad con el generador de referencia (_P_mt/_vest):
// para campos de estructura, los tipos primitivos se emiten por valor,
// y los tipos de tipo struct se emiten como PUNTERO (struct X*).
// ----------------------------------------------------------
funcion traducir_tipo_c_campo(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("traducir_tipo_c((void*)_t);")
        asm("extern char _gen_tmp_buf[4096];")
        asm("// Si el tipo no es primitivo, traducir_tipo_c emite 'struct <X>'.")
        asm("// Como campo de estructura ese tipo se referencia por puntero -> anadir '*'.")
        asm("if (strncmp(_gen_tmp_buf, \"struct \", 7) == 0) { strcat(_gen_tmp_buf, \"*\"); }")

// ----------------------------------------------------------
// traducir_tipo_retorno
// Paridad con el generador de referencia (_P_mt): tipos de retorno de tipo
// struct se emiten como struct X (por valor), nunca puntero.
// ----------------------------------------------------------
funcion traducir_tipo_retorno(tipo_synapse: puntero) -> nulo:
    inseguro:
        asm("const char* _t = (const char*)tipo_synapse;")
        asm("traducir_tipo_c((void*)_t);")

// ----------------------------------------------------------
// gen_emitir_linea — API PRINCIPAL
// ----------------------------------------------------------
funcion gen_emitir_linea(est: GeneradorCEst, linea: cadena) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    const char* _gs = linea.datos;")
        asm("    int _gl = linea.longitud;")
        asm("    if (_G_emit_pos + _gl + 2 > 1048576) return;")
        asm("    memcpy(_G_emit_buf + _G_emit_pos, _gs, _gl);")
        asm("    _G_emit_pos += _gl;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_emitir_str — API de bajo nivel para bloques asm()
// ----------------------------------------------------------
funcion gen_emitir_str(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("if (!str) return;")
        asm("const char* _s = (const char*)str;")
        asm("int _len = (int)strlen(_s);")
        asm("CadenaSegura _cs = {_len, _s};")
        asm("gen_emitir_linea(est, _cs);")

// ----------------------------------------------------------
// gen_emitir_nueva_linea
// ----------------------------------------------------------
funcion gen_emitir_nueva_linea(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("{")
        asm("    if (_G_emit_pos + 2 > 1048576) return;")
        asm("    _G_emit_buf[_G_emit_pos] = 10;")
        asm("    _G_emit_pos++;")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("}")

// ----------------------------------------------------------
// gen_obtener_salida
// ----------------------------------------------------------
funcion gen_obtener_salida(est: GeneradorCEst) -> cadena:
    r = ""
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos;")
        asm("if (_G_emit_pos > 0) {")
        asm("    _G_emit_buf[_G_emit_pos] = 0;")
        asm("    strcpy(_gen_tmp_buf, _G_emit_buf);")
        asm("} else {")
        asm("    strcpy(_gen_tmp_buf, \"\");")
        asm("}")
        asm("r = (CadenaSegura){.longitud=(int)strlen(_gen_tmp_buf), .datos=strdup(_gen_tmp_buf)};")
    retornar r

// ----------------------------------------------------------
// gen_escribir_cadena_escapada
// ----------------------------------------------------------
funcion gen_escribir_cadena_escapada(est: GeneradorCEst, str: puntero) -> nulo:
    inseguro:
        asm("const char* _s=(const char*)str;if(!_s)return;char _esc[16384];int _epos=0;int _ei=0;while(_s[_ei]&&_epos<16380){char _c=_s[_ei];if(_c==10){_esc[_epos++]=92;_esc[_epos++]=110;}else if(_c==34){_esc[_epos++]=92;_esc[_epos++]=34;}else if(_c==92){_esc[_epos++]=92;_esc[_epos++]=92;}else if(_c==9){_esc[_epos++]=92;_esc[_epos++]=116;}else if(_c==13){_esc[_epos++]=92;_esc[_epos++]=114;}else{_esc[_epos++]=_c;}_ei++;}_esc[_epos]=0;CadenaSegura _esc_cs={.longitud=_epos,.datos=_esc};gen_emitir_linea(est,_esc_cs);")

// ============================================================
// CAPA 2: Trazabilidad (C-Mapping)
// ============================================================

// ----------------------------------------------------------
// gen_emitir_traza
// Emite: /* [Traza: modulo.syn - NombreNodo] */
// ----------------------------------------------------------
funcion gen_emitir_traza(est: GeneradorCEst, modulo: puntero, nombre_nodo: puntero) -> nulo:
    inseguro:
        asm("// [Optimizacion] gen_emitir_traza anulado: no emitir comentarios de traza en el C")
        asm("(void)modulo; (void)nombre_nodo; (void)est;")

// ============================================================
// CAPA 3: Auditoria Simetrica de Bloques
// ============================================================
// NOTA: est se pasa por valor. Las funciones no modifican
// est.indent_actual (no persistiria en C). La indentacion
// la gestionan los visitantes mediante prefijos en los strings.
// ============================================================

// ----------------------------------------------------------
// gen_emitir_lifetime_assert
// M22.5: Emite una asercion de lifetime en el codigo C generado
// (solo si _G_safe_mode esta activo).
// Formato: assert(condition && "mensaje");
// ----------------------------------------------------------
funcion gen_emitir_lifetime_assert(est: GeneradorCEst, condicion: puntero, mensaje: puntero) -> nulo:
    inseguro:
        asm("extern int _G_safe_mode;")
        asm("if (!_G_safe_mode) return;")
        asm("const char* _cond = (const char*)condicion;")
        asm("const char* _msg = (const char*)mensaje;")
        asm("if (!_cond || !_msg) return;")
        asm("char _buf[512];")
        asm("snprintf(_buf, 512, \"    assert(%s && \\\"%s\\\"); /* LIFETIME */\", _cond, _msg);")
        asm("gen_emitir_str(est, _buf);")

// ----------------------------------------------------------
// gen_abrir_bloque_c
// Emite "(" + newline al buffer de salida.
// M22.2: Incrementa scope_depth global y emite marcador de entrada.
// ----------------------------------------------------------
funcion gen_abrir_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '{';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;") // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")
        asm("_G_scope_depth++;")
        // M22.5: Emitir ASSERT activo de LIFETIME en modo --safe (no comentario pasivo)
        asm("extern int _G_safe_mode;")
        asm("if (_G_safe_mode) {")
        asm("    char _safe_buf[256];")
        asm("    snprintf(_safe_buf, 256, \"    assert(_G_scope_depth >= 0 && _G_scope_depth < 256 && \\\"LIFETIME: scope_depth overflow at block %d\\\"); /* LIFETIME */\", _G_scope_depth);")
        asm("    gen_emitir_str(est, _safe_buf);")
        asm("}")

// ----------------------------------------------------------
// gen_cerrar_bloque_c
// Emite ")" + newline + liberacion RAII en este ambito.
# cumple Manual 4 5.2; Manual 4 §3.2; Manual 4 §3.3; D-1.2
// (cleanup block: decremento rc/arc/débil o _syn_texto_liberar al cierre de scope)
// NOTA: La indentacion la gestiona el visitante llamante.
// ----------------------------------------------------------
funcion gen_cerrar_bloque_c(est: GeneradorCEst) -> nulo:
    inseguro:
        asm("extern char _G_emit_buf[1048576]; extern int _G_emit_pos; extern int _G_scope_depth;")
        asm("extern int _G_scope_vars_depth[256]; extern char _G_scope_vars_names[256][64];")
        asm("extern int _G_scope_vars_total; extern int _G_scope_vars_kind[256];")
        asm("// M22.2: Emitir pool_free para vars RAII en este ambito")
        asm("int _sd = _G_scope_depth;")
        asm("// Manual 3 S3.3: orden lexicografico en iteracion de variables de scope")
        asm("// Colectar indices de vars en este ambito y ordenar por nombre")
        asm("int _scope_idxs[256]; int _scope_n = 0;")
        asm("for (int _vi = 0; _vi < _G_scope_vars_total && _scope_n < 256; _vi++) {")
        asm("    if (_G_scope_vars_depth[_vi] == _sd) {")
        asm("        _scope_idxs[_scope_n++] = _vi;")
        asm("    }")
        asm("}")
        asm("// Bubble sort indices por nombre (lexicografico)")
        asm("for (int _si = 0; _si < _scope_n - 1; _si++) {")
        asm("    for (int _sj = 0; _sj < _scope_n - 1 - _si; _sj++) {")
        asm("        if (strcmp(_G_scope_vars_names[_scope_idxs[_sj]], _G_scope_vars_names[_scope_idxs[_sj+1]]) > 0) {")
        asm("            int _tmp = _scope_idxs[_sj];")
        asm("            _scope_idxs[_sj] = _scope_idxs[_sj+1];")
        asm("            _scope_idxs[_sj+1] = _tmp;")
        asm("        }")
        asm("    }")
        asm("}")
        asm("for (int _vi = 0; _vi < _scope_n; _vi++) {")
        asm("    int _v = _scope_idxs[_vi];")
        asm("    char _free_line[128];")
        // D-1.2 (Fase 23, Manual 4 §5.2): liberar al cierre de scope segun la clase.
        // 0=texto -> _syn_texto_liberar; 1=rc -> _syn_rc_decrement; 2=arc ->
        // _syn_arc_decrement; 3=debil -> rc_weak_release(&var).
        asm("    if (_G_scope_vars_kind[_v] == 1) {")
        asm("        snprintf(_free_line, 128, \"    _syn_rc_decrement(%s); /* RAII rc scope %d */\", _G_scope_vars_names[_v], _sd);")
        asm("    } else if (_G_scope_vars_kind[_v] == 2) {")
        asm("        snprintf(_free_line, 128, \"    _syn_arc_decrement(%s); /* RAII arc scope %d */\", _G_scope_vars_names[_v], _sd);")
        asm("    } else if (_G_scope_vars_kind[_v] == 3) {")
        asm("        snprintf(_free_line, 128, \"    rc_weak_release(&%s); /* RAII weak scope %d */\", _G_scope_vars_names[_v], _sd);")
        asm("    } else {")
        asm("        snprintf(_free_line, 128, \"    _syn_texto_liberar(%s); /* RAII scope %d */\", _G_scope_vars_names[_v], _sd);")
        asm("    }")
        asm("    int _fl = (int)strlen(_free_line);")
        asm("    if (_G_emit_pos + _fl + 2 <= 1048576) {")
        asm("        memcpy(_G_emit_buf + _G_emit_pos, _free_line, _fl);")
        asm("        _G_emit_pos += _fl;")
        asm("        _G_emit_buf[_G_emit_pos] = 10;")
        asm("        _G_emit_pos++;")
        asm("    }")
        asm("    // Mark as removed (sentinel depth = -1)")
        asm("    _G_scope_vars_depth[_v] = -1;")
        asm("    _G_scope_vars_names[_v][0] = 0;")
        asm("}")
        asm("// Compact: rebuild array skipping removed entries")
        asm("int _wi = 0;")
        asm("for (int _ri = 0; _ri < _G_scope_vars_total; _ri++) {")
        asm("    if (_G_scope_vars_depth[_ri] >= 0) {")
        asm("        _G_scope_vars_depth[_wi] = _G_scope_vars_depth[_ri];")
        asm("        strcpy(_G_scope_vars_names[_wi], _G_scope_vars_names[_ri]);")
        asm("        _wi++;")
        asm("    }")
        asm("}")
        asm("_G_scope_vars_total = _wi;")
        asm("_G_scope_depth--;")
        asm("if (_G_emit_pos + 2 > 1048576) return;")
        asm("_G_emit_buf[_G_emit_pos] = '}';")
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 10;") // '\n'
        asm("_G_emit_pos++;")
        asm("_G_emit_buf[_G_emit_pos] = 0;")

// ----------------------------------------------------------
// _syn_es_tipo
// Comparacion segura de tipo de nodo (strncmp con limite 64).
// Evita problemas de NUL terminator en _n->tipo.datos.
// ----------------------------------------------------------
funcion _syn_es_tipo(ptr_tipo_nodo: puntero, esperado: puntero) -> entero:
    inseguro:
        asm("if (!ptr_tipo_nodo || !esperado) return 0;")

        asm("return strncmp((const char*)ptr_tipo_nodo, (const char*)esperado, 64) == 0;")
// ===== From: expr_eval.syn =====

#lang: es
# cumple Manual 1 1: infraestructura del compilador Synapse
# cumple Manual 8 4: toolchain de construcción
// ============================================================
// expr_eval.syn — Evaluador de expresiones OO para el generador C
// ============================================================
// Visitante de expresiones del AST usando formato OO (struct Nodo*).
//
// DISENO:
// - _oo_expr_a_c es el evaluador de expresiones recursivo que traduce
// cualquier sub-arbol de expresion a una cadena C.
// - Soporta: literales, identificadores, operaciones binarias/unarias,
// llamadas a funcion, obtencion de direccion (&T) y desreferencia (*ptr).
// ============================================================

// ----------------------------------------------------------
// _oo_expr_a_c -- OO expression evaluator
// Traduce un nodo de expresion del AST a una representacion
// en cadena C, escribiendo el resultado en 'buf'.
// ----------------------------------------------------------
funcion _oo_expr_a_c(est: GeneradorCEst, nodo: puntero, buf: puntero, bufsz: entero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)nodo;")
        asm("char* _b = (char*)buf;")
        asm("int _sz = bufsz;")
        asm("if (!_n || !_b || _sz <= 0) return;")
        asm("const char* _t = _n->tipo.datos;")
        asm("if (!_t) { strcpy(_b, \"0\"); return; }")
        asm("_b[0] = 0;")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralNumero\")) {")
        asm("    struct LiteralNumero* _ln = (struct LiteralNumero*)_n;")
        asm("    if ((long long)_ln->valor == (-9223372036854775807LL - 1)) { strcpy(_b, \"(-9223372036854775807LL - 1)\"); }")
        asm("    else { snprintf(_b, _sz, \"%lldLL\", (long long)_ln->valor); }")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralDecimal\")) {")
        asm("    struct LiteralDecimal* _ld = (struct LiteralDecimal*)_n;")
        asm("    snprintf(_b, _sz, \"%.9g\", _ld->valor);")
        asm("    if (!strchr(_b, '.') && !strchr(_b, 'e') && !strchr(_b, 'E')) strcat(_b, \".0\");")
        asm("    else { }")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"Identificador\")) {")
        asm("    struct Identificador* _id = (struct Identificador*)_n;")
        asm("    if (_id->nombre.datos) strncpy(_b, _id->nombre.datos, _sz - 1);")
        asm("    return;")
        asm("}")
        asm("")
        asm("if (_syn_es_tipo(_t, \"LiteralCadena\")) {")
        asm("    struct LiteralCadena* _lc = (struct LiteralCadena*)_n;")
        asm("    // Manual 8 S8.2 / paridad emit_expressions.py L159-169:")
        asm("    // escapar \\\\, \\\", \\n, \\r, \\t dentro del literal.")
        asm("    if (_lc->valor.datos && _lc->valor.longitud > 0) {")
        asm("        char _esc[4096]; int _ep = 0;")
        asm("        for (int _vi = 0; _vi < _lc->valor.longitud && _ep < 4090; _vi++) {")
        asm("            char _vc = _lc->valor.datos[_vi];")
        asm("            if (_vc == '\\\\') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\\'; }")
        asm("            else if (_vc == '\\\"') { _esc[_ep++] = '\\\\'; _esc[_ep++] = '\\\"'; }")
        asm("            else if (_vc == '\\n') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'n'; }")
        asm("            else if (_vc == '\\r') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 'r'; }")
        asm("            else if (_vc == '\\t') { _esc[_ep++] = '\\\\'; _esc[_ep++] = 't'; }")
        asm("            else { _esc[_ep++] = _vc; }")
        asm("        }")
        asm("        _esc[_ep] = 0;")
        asm("        snprintf(_b, _sz, \"(CadenaSegura){.longitud=%d,.datos=\\\"%s\\\"}\", _lc->valor.longitud, _esc);")
        asm("    } else {")
        asm("        strcpy(_b, \"(CadenaSegura){.longitud=0,.datos=\\\"\\\"}\");")
        asm("    }")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ArgumentoTransferido\")) {")
        asm("    // R15: ->expr (paridad S1 expr_a_c de ArgumentoTransferido:")
        asm("    // el valor transferido se emite como el expr subyacente).")
        asm("    struct ArgumentoTransferido* _aft = (struct ArgumentoTransferido*)_n;")
        asm("    if (_aft->expr) { _oo_expr_a_c(est, _aft->expr, _b, _sz); }")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"LiteralNulo\")) {")
        asm("    // F1.2b: paridad emit_expressions.py L157-159 (expr_a_c de LiteralNulo -> \"nulo\")")
        asm("    strcpy(_b, \"nulo\");")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprTensor\")) {")
        asm("    // F1.2b: paridad emit_expressions.py L338-341 (expr_a_c de ExprTensor -> crear_tensor(filas, cols))")
        asm("    struct ExprTensor* _et = (struct ExprTensor*)_n;")
        asm("    char _etf[2048], _etc[2048];")
        asm("    _etf[0] = _etc[0] = 0;")
        asm("    if (_et->filas) { _oo_expr_a_c(est, _et->filas, _etf, 2048); } else { strcpy(_etf, \"0\"); }")
        asm("    if (_et->columnas) { _oo_expr_a_c(est, _et->columnas, _etc, 2048); } else { strcpy(_etc, \"0\"); }")
        asm("    snprintf(_b, _sz, \"crear_tensor(%s, %s)\", _etf, _etc);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprCrearCanal\")) {")
        asm("    // F3-6: paridad emit_expressions.py L523-525 (ExprCrearCanal -> canal_crear(cap)).")
        asm("    // Antes: sin rama -> el let/expr caia al default (ch = 0; canal nunca creado).")
        asm("    struct ExprCrearCanal* _cc = (struct ExprCrearCanal*)_n;")
        asm("    char _ccap[2048]; _ccap[0] = 0;")
        asm("    if (_cc->capacidad && _cc->capacidad->tipo.datos) { _oo_expr_a_c(est, _cc->capacidad, _ccap, 2048); } else { strcpy(_ccap, \"10\"); }")
        asm("    snprintf(_b, _sz, \"canal_crear(%s)\", _ccap);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprRecibirCanal\")) {")
        asm("    // F3-6: paridad emit_expressions.py (ExprRecibirCanal -> canal_recibir(canal)).")
        asm("    // F3-7: dentro del bloque de `escuchar canal:` el recibir se emite como")
        asm("    // canal_recibir(_canal) (la variable del listener, no la local del")
        asm("    // contenedor, que no es visible en la funcion listener).")
        asm("    // F3-10: el receive hereda el tipo del elemento del canal (Manual 5 §4.2)")
        asm("    // y se desboxea el void* que devuelve canal_recibir (paridad S1).")
        asm("    // F4-6: firma del Manual 5 §3.4 `canal_recibir(canal, bool* cerrado)`. Dentro")
        asm("    // del escuchar el receive emite un statement-expression que rompe el while")
        asm("    // del listener cuando *cerrado == true (Manual 5 §4.3), distinguiendo el")
        asm("    // valor 0 del cierre. Fuera del escuchar se pasa &(bool){0} (leniency).")
        asm("    struct ExprRecibirCanal* _rc = (struct ExprRecibirCanal*)_n;")
        asm("    extern int _G_listener_modo;")
        asm("    char _relem[64]; _relem[0] = 0;")
        asm("    if (_rc->canal && _rc->canal->tipo.datos && strcmp(_rc->canal->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _rid = (struct Identificador*)_rc->canal;")
        asm("        if (_rid->nombre.datos) { extern int _G_native_canal_elem_tipo(const char*, char*); _G_native_canal_elem_tipo(_rid->nombre.datos, _relem); }")
        asm("    }")
        asm("    if (_G_listener_modo) {")
        asm("        char _unbox[64];")
        asm("        if (strcmp(_relem, \"int64_t\") == 0) { strcpy(_unbox, \"_synapse_unbox_int(_m)\"); }")
        asm("        else if (strcmp(_relem, \"double\") == 0) { strcpy(_unbox, \"_synapse_unbox_float(_m)\"); }")
        asm("        else { strcpy(_unbox, \"_m\"); }")
        asm("        snprintf(_b, _sz, \"({ void* _m = canal_recibir(_canal, &_cerrado); if (_cerrado) break; %s; })\", _unbox);")
        asm("        return;")
        asm("    }")
        asm("    char _rbuf[2048]; _rbuf[0] = 0;")
        asm("    {")
        asm("        char _rcc[2048]; _rcc[0] = 0;")
        asm("        if (_rc->canal && _rc->canal->tipo.datos) { _oo_expr_a_c(est, _rc->canal, _rcc, 2048); } else { strcpy(_rcc, \"NULL\"); }")
        asm("        snprintf(_rbuf, 2048, \"canal_recibir(%s, &(bool){0})\", _rcc);")
        asm("    }")
        asm("    if (strcmp(_relem, \"int64_t\") == 0) { snprintf(_b, _sz, \"_synapse_unbox_int(%s)\", _rbuf); return; }")
        asm("    if (strcmp(_relem, \"double\") == 0) { snprintf(_b, _sz, \"_synapse_unbox_float(%s)\", _rbuf); return; }")
        asm("    snprintf(_b, _sz, \"%s\", _rbuf);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"ExprPropagar\")) {")
        asm("    // D-6: operador '?' postfijo (Manual 3 §7 L331-342). Statement-expression")
        asm("    // GNU: si el Resultado es err (tag 1) propaga el valor entero; si es ok,")
        asm("    // evalua al campo del primer constructor (dato.ok).")
        asm("    struct ExprPropagar* _pp = (struct ExprPropagar*)_n;")
        asm("    char _pe[2048]; _pe[0] = 0;")
        asm("    if (_pp->expresion) { _oo_expr_a_c(est, _pp->expresion, _pe, 2048); }")
        asm("    char _padt[64]; _padt[0] = 0;")
        asm("    if (_pp->expresion && _pp->expresion->tipo.datos && strcmp(_pp->expresion->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _plf = (struct LlamadaFuncion*)_pp->expresion;")
        asm("        if (_plf->nombre.datos) { _G_native_tipo_retorno(_plf->nombre.datos, _padt); }")
        asm("    }")
        asm("    if (!_padt[0]) strcpy(_padt, \"Resultado\");")
        asm("    // la variable temporal es del tipo ADT (Resultado o el struct instanciado")
        asm("    // D-2: traducir_tipo_c resuelve `Resultado<entero,texto>` -> struct")
        asm("    // especializado; el desempaquetado .dato.ok da el valor.")
        asm("    traducir_tipo_c((void*)_padt);")
        asm("    extern char _gen_tmp_buf[4096];")
        asm("    char _ptc[64]; _ptc[0] = 0;")
        asm("    strncpy(_ptc, _gen_tmp_buf, 63); _ptc[63] = 0;")
        asm("    char _pfield[64]; _pfield[0] = 0;")
        asm("    _G_native_adt_unwrap_field(_padt, _pfield);")
        asm("    if (!_pfield[0]) strcpy(_pfield, \"ok\");")
        asm("    snprintf(_b, _sz, \"({ %s _prop = %s; if (_prop.tag == 1) return _prop; _prop.dato.%s; })\", _ptc, _pe, _pfield);")
        asm("    return;")
        asm("}")
        asm("if (_syn_es_tipo(_t, \"OpBinaria\")) {")
        asm("    struct OpBinaria* _op = (struct OpBinaria*)_n;")
        asm("    char _izq[2048], _der[2048];")
        asm("    _izq[0] = _der[0] = 0;")
        asm("    if (_op->izquierdo) { _oo_expr_a_c(est, _op->izquierdo, _izq, 2048); }")
        asm("    if (_op->derecho) { _oo_expr_a_c(est, _op->derecho, _der, 2048); }")
        asm("    const char* _op_str = \"\";")
        asm("    int _ot = 0;")
        asm("    if (_op->operador) {")
        asm("        _ot = _op->operador->tipo;")
        asm("        switch (_ot) {")
        asm("            case 30: _op_str = \" + \"; break;")
        asm("            case 31: _op_str = \" - \"; break;")
        asm("            case 32: _op_str = \" * \"; break;")
        asm("            case 33: _op_str = \" / \"; break;")
        asm("            case 34: _op_str = \" % \"; break;  // ME-B7: T_MOD (34) faltaba en el switch")
        asm("            case 16: _op_str = \" > \"; break;")
        asm("            case 17: _op_str = \" < \"; break;")
        asm("            case 25: _op_str = \" == \"; break;")
        asm("            case 26: _op_str = \" != \"; break;")
        asm("            case 28: _op_str = \" >= \"; break;")
        asm("            case 27: _op_str = \" <= \"; break;")
        asm("            case 14: _op_str = \" && \"; break;")
        asm("            case 15: _op_str = \" || \"; break;")
        asm("            default: _op_str = \" ? \"; break;")
        asm("        }")
        asm("    }")
        asm("    // ME-B7 paridad emit_expressions.py L160-200 (tipo_de_expr + _es_str):")
        asm("    // decidir en TIEMPO DE GENERACION si un operando es texto (no macros _Generic,")
        asm("    // que gcc rechaza: valida todas las ramas y str_eq(int,int) es invalido).")
        asm("    // Un operando es texto si: LiteralCadena, o llamada a funcion que retorna")
        asm("    // cadena (via _G_native_tipo_retorno), o concat/entero_a_texto/leer_linea/subcadena.")
        asm("    int _ix_txt = 0, _dx_txt = 0;")
        asm("    struct Nodo* _nx0 = (struct Nodo*)_op->izquierdo;")
        asm("    struct Nodo* _nx1 = (struct Nodo*)_op->derecho;")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LiteralCadena\") == 0) _ix_txt = 1;")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"LiteralCadena\") == 0) _dx_txt = 1;")
        asm("    // ME-C4: Identificador de variable inferida como texto (paridad tipo_de_expr L89-93).")
        asm("    extern char _G_fn_var_tipos[2048][64];")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _hvi = (struct Identificador*)_nx0;")
        asm("        if (_hvi->nombre.datos) {")
        asm("            for (int _vti = 0; _vti < _G_fn_vars_count; _vti++) {")
        asm("                if (strcmp(_G_fn_vars[_vti], _hvi->nombre.datos) == 0) {")
        asm("                    if (strcmp(_G_fn_var_tipos[_vti], \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("                    break;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"Identificador\") == 0) {")
        asm("        struct Identificador* _hvd2 = (struct Identificador*)_nx1;")
        asm("        if (_hvd2->nombre.datos) {")
        asm("            for (int _vti2 = 0; _vti2 < _G_fn_vars_count; _vti2++) {")
        asm("                if (strcmp(_G_fn_vars[_vti2], _hvd2->nombre.datos) == 0) {")
        asm("                    if (strcmp(_G_fn_var_tipos[_vti2], \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("                    break;")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    // F3-13: ExprAccesoCampo con campo de tipo texto (paridad S1 tipo_de_expr L70-95).")
        asm("    // ch.clave_publica_local (CanalRemoto.texto) debe contar como texto en OpBinaria.")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("        struct ExprAccesoCampo* _hca = (struct ExprAccesoCampo*)_nx0;")
        asm("        if (_hca->objeto && _hca->objeto->tipo.datos && strcmp(_hca->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("            struct Identificador* _hco = (struct Identificador*)_hca->objeto;")
        asm("            if (_hco->nombre.datos && _hca->nombre_campo.datos) {")
        asm("                char _hc_t[64]; _hc_t[0] = 0;")
        asm("                for (int _hci = 0; _hci < _G_fn_vars_count; _hci++) {")
        asm("                    if (strcmp(_G_fn_vars[_hci], _hco->nombre.datos) == 0 && _G_fn_var_tipos[_hci][0]) {")
        asm("                        const char* _hsrc = _G_fn_var_tipos[_hci];")
        asm("                        if (strncmp(_hsrc, \"struct \", 7) == 0) _hsrc += 7;")
        asm("                        char _hsb[64]; _hsb[0] = 0;")
        asm("                        for (int _hsi = 0; _hsrc[_hsi] && _hsi < 62; _hsi++) { if (_hsrc[_hsi] == '<') break; _hsb[_hsi] = _hsrc[_hsi]; _hsb[_hsi + 1] = 0; }")
        asm("                        if (_G_native_campo_tipo(_hsb, _hca->nombre_campo.datos, _hc_t)) {")
        asm("                            if (strcmp(_hc_t, \"texto\") == 0 || strcmp(_hc_t, \"cadena\") == 0 || strcmp(_hc_t, \"CadenaSegura\") == 0) _ix_txt = 1;")
        asm("                        }")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx1 && _nx1->tipo.datos && strcmp(_nx1->tipo.datos, \"ExprAccesoCampo\") == 0) {")
        asm("        struct ExprAccesoCampo* _hca2 = (struct ExprAccesoCampo*)_nx1;")
        asm("        if (_hca2->objeto && _hca2->objeto->tipo.datos && strcmp(_hca2->objeto->tipo.datos, \"Identificador\") == 0) {")
        asm("            struct Identificador* _hco2 = (struct Identificador*)_hca2->objeto;")
        asm("            if (_hco2->nombre.datos && _hca2->nombre_campo.datos) {")
        asm("                char _hc_t2[64]; _hc_t2[0] = 0;")
        asm("                for (int _hci2 = 0; _hci2 < _G_fn_vars_count; _hci2++) {")
        asm("                    if (strcmp(_G_fn_vars[_hci2], _hco2->nombre.datos) == 0 && _G_fn_var_tipos[_hci2][0]) {")
        asm("                        const char* _hsrc2 = _G_fn_var_tipos[_hci2];")
        asm("                        if (strncmp(_hsrc2, \"struct \", 7) == 0) _hsrc2 += 7;")
        asm("                        char _hsb2[64]; _hsb2[0] = 0;")
        asm("                        for (int _hsi2 = 0; _hsrc2[_hsi2] && _hsi2 < 62; _hsi2++) { if (_hsrc2[_hsi2] == '<') break; _hsb2[_hsi2] = _hsrc2[_hsi2]; _hsb2[_hsi2 + 1] = 0; }")
        asm("                        if (_G_native_campo_tipo(_hsb2, _hca2->nombre_campo.datos, _hc_t2)) {")
        asm("                            if (strcmp(_hc_t2, \"texto\") == 0 || strcmp(_hc_t2, \"cadena\") == 0 || strcmp(_hc_t2, \"CadenaSegura\") == 0) _dx_txt = 1;")
        asm("                        }")
        asm("                        break;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (_nx0 && _nx0->tipo.datos && strcmp(_nx0->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lfi = (struct LlamadaFuncion*)_nx0;")
        asm("        if (_lfi->nombre.datos) {")
