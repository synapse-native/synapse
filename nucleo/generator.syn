// ----------------------------------------------------------
// R28: derivar instancias de ADT desde ctors en EXPRESIONES
// (`let r = ok(ok(42))` sin anotacion y `r = ok(ok(42))` implicita).
// El scan D-2 solo registra instancias nombradas en firmas/let anotados;
// un ctor puro en una expresion quedaba sin registrar -> el let caia a
// int64_t/base y el C quedaba invalido. Paridad S1 _recolectar_instancias_adt
// (fixpoint R28). Convencion R20/R25: los parametros no acotados del ctor
// (E en Resultado<T,E>) se rellenan con la PRIMERA instancia registrada del
// base; el arg 0 es concreto (literal o ctor anidado recursivo).
// ----------------------------------------------------------
funcion _G_native_adt_registrar_syn(tipo_syn: puntero) -> entero:
    inseguro:
        asm("extern void traducir_tipo_c(void* tipo); extern char _gen_tmp_buf[4096];")
        asm("const char* _ts = (const char*)tipo_syn;")
        asm("if (!_ts || !strchr(_ts, '<')) return 0;")
        asm("int _rl = (int)strlen(_ts);")
        asm("if (_rl < 3 || _ts[_rl-1] != '>') return 0;")
        asm("char _rb[64]; int _rbw = 0;")
        asm("while (_ts[_rbw] && _ts[_rbw] != '<' && _rbw < 62) { _rb[_rbw] = _ts[_rbw]; _rbw++; }")
        asm("_rb[_rbw] = 0;")
        asm("if (!_G_native_adt_gen_es(_rb)) return 0;")
        asm("int _rgi = -1;")
        asm("for (int _rg = 0; _rg < _G_native_adt_gen_count; _rg++) { if (strcmp(_G_native_adt_gen[_rg], _rb) == 0) { _rgi = _rg; break; } }")
        asm("if (_rgi < 0) return 0;")
        asm("int _rnp = _G_native_adt_gen_nparams[_rgi];")
        asm("char _rargs[8][64]; int _rna = 0; int _rprof = 0; char _rcur[64]; int _rcw = 0;")
        asm("for (const char* _rp = _ts + _rbw + 1; *_rp && _rna < 8; _rp++) {")
        asm("    if (*_rp == '<') { _rprof++; if (_rcw < 63) _rcur[_rcw++] = *_rp; }")
        asm("    else if (*_rp == '>') {")
        asm("        if (_rprof > 0) { _rprof--; if (_rcw < 63) _rcur[_rcw++] = *_rp; }")
        asm("    }")
        asm("    else if (*_rp == ',' && _rprof == 0) { _rcur[_rcw] = 0; strncpy(_rargs[_rna], _rcur, 63); _rargs[_rna][63] = 0; _rna++; _rcw = 0; }")
        asm("    else { if (_rcw < 63) _rcur[_rcw++] = *_rp; }")
        asm("}")
        asm("if (_rcw > 0 && _rna < 8) { _rcur[_rcw] = 0; strncpy(_rargs[_rna], _rcur, 63); _rargs[_rna][63] = 0; _rna++; }")
        asm("if (_rna != _rnp) return 0;")
        asm("// post-orden: args anidados primero (paridad FIFO D-2)")
        asm("for (int _ra = 0; _ra < _rna; _ra++) { if (strchr(_rargs[_ra], '<')) _G_native_adt_registrar_syn(_rargs[_ra]); }")
        asm("char _rn[128]; int _rwn = 0;")
        asm("for (const char* _rq = _ts; *_rq; _rq++) { if (*_rq != ' ') _rn[_rwn++] = *_rq; }")
        asm("_rn[_rwn] = 0;")
        asm("for (int _rx = 0; _rx < _G_native_adt_inst_count; _rx++) { if (strcmp(_G_native_adt_inst_type[_rx], _rn) == 0) return 0; }")
        asm("char _rnm[128]; int _rnn = 0;")
        asm("for (int _rq2 = 0; _rb[_rq2] && _rnn < 60; _rq2++) _rnm[_rnn++] = _rb[_rq2];")
        asm("for (int _ra2 = 0; _ra2 < _rna && _rnn < 115; _ra2++) {")
        asm("    _rnm[_rnn++] = '_';")
        asm("    int _ral = (int)strlen(_rargs[_ra2]);")
        asm("    int _ram = (_ral > 0 && _rargs[_ra2][_ral-1] == '>') ? _ral - 1 : _ral;")
        asm("    for (int _rq3 = 0; _rq3 < _ram && _rnn < 115; _rq3++) {")
        asm("        char _rch = _rargs[_ra2][_rq3];")
        asm("        if ((_rch >= 'a' && _rch <= 'z') || (_rch >= 'A' && _rch <= 'Z') || (_rch >= '0' && _rch <= '9') || _rch == '_') _rnm[_rnn++] = _rch;")
        asm("        else _rnm[_rnn++] = '_';")
        asm("    }")
        asm("}")
        asm("_rnm[_rnn] = 0;")
        asm("if (_G_native_adt_inst_count >= 64) return 0;")
        asm("int _ri = _G_native_adt_inst_count++;")
        asm("strncpy(_G_native_adt_inst_type[_ri], _rn, 63); _G_native_adt_inst_type[_ri][63] = 0;")
        asm("strncpy(_G_native_adt_inst_base[_ri], _rb, 63); _G_native_adt_inst_base[_ri][63] = 0;")
        asm("strncpy(_G_native_adt_inst_c[_ri], _rnm, 63); _G_native_adt_inst_c[_ri][63] = 0;")
        asm("int _rfi = 0;")
        asm("for (int _rci = 0; _rci < _G_native_adt_ctrs_count && _rfi < 8; _rci++) {")
        asm("    if (strcmp(_G_native_adt_ctrs_adt[_rci], _rb) != 0) continue;")
        asm("    const char* _rft = _G_native_adt_ctrs_tipo[_rci];")
        asm("    int _res = -1;")
        asm("    for (int _rpi = 0; _rpi < _rnp; _rpi++) { if (strcmp(_G_native_adt_gen_params[_rgi][_rpi], _rft) == 0) { _res = _rpi; break; } }")
        asm("    if (_res >= 0) { traducir_tipo_c((void*)_rargs[_res]); } else { traducir_tipo_c((void*)_rft); }")
        asm("    if (strncmp(_gen_tmp_buf, \"struct \", 7) == 0) { strcat(_gen_tmp_buf, \"*\"); }")
        asm("    strncpy(_G_native_adt_inst_fields_c[_ri][_rfi], _gen_tmp_buf, 63); _G_native_adt_inst_fields_c[_ri][_rfi][63] = 0;")
        asm("    _rfi++;")
        asm("}")
        asm("_G_native_adt_inst_nfields[_ri] = _rfi;")
        asm("return 1;")

funcion _G_native_adt_resolver_ctor(n: puntero, out: puntero, depth: entero) -> entero:
    inseguro:
        asm("struct Nodo* _nn = (struct Nodo*)n; char* _oo = (char*)out; int _dep = (int)depth;")
        asm("if (!_nn || !_nn->tipo.datos || _dep > 8) { _oo[0] = 0; return 0; }")
        asm("const char* _t = _nn->tipo.datos;")
        asm("if (strcmp(_t, \"LiteralNumero\") == 0) { strcpy(_oo, \"entero\"); return 1; }")
        asm("if (strcmp(_t, \"LiteralDecimal\") == 0) { strcpy(_oo, \"decimal\"); return 1; }")
        asm("if (strcmp(_t, \"LiteralCadena\") == 0) { strcpy(_oo, \"texto\"); return 1; }")
        asm("if (strcmp(_t, \"LiteralNulo\") == 0) { strcpy(_oo, \"puntero\"); return 1; }")
        asm("if (strcmp(_t, \"LlamadaFuncion\") != 0) { _oo[0] = 0; return 0; }")
        asm("struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_nn;")
        asm("if (!_lf->nombre.datos || !_G_native_es_adt_ctr(_lf->nombre.datos)) { _oo[0] = 0; return 0; }")
        asm("char _base[64]; int _rtag; _base[0] = 0;")
        asm("_G_native_adt_ctr_info(_lf->nombre.datos, _base, &_rtag, 0);")
        asm("int _gi = -1;")
        asm("for (int _g = 0; _g < _G_native_adt_gen_count; _g++) { if (strcmp(_G_native_adt_gen[_g], _base) == 0) { _gi = _g; break; } }")
        asm("if (_gi < 0) { _oo[0] = 0; return 0; }")
        asm("int _np = _G_native_adt_gen_nparams[_gi];")
        asm("if (_np == 0) { strcpy(_oo, _base); return 1; }")
        asm("char _argt[64]; _argt[0] = 0;")
        asm("struct ListaNodo* _al = _lf->argumentos;")
        asm("if (!_al || !_al->cabeza) { _oo[0] = 0; return 0; }")
        asm("if (!_G_native_adt_resolver_ctor((void*)_al->cabeza, (void*)_argt, (int64_t)(_dep + 1))) { _oo[0] = 0; return 0; }")
        asm("// resto: primera instancia registrada del base -> args[1..np-1]")
        asm("char _resto[8][64]; int _nr = 0; int _rok = 0;")
        asm("for (int _i2 = 0; _i2 < _G_native_adt_inst_count; _i2++) {")
        asm("    if (strcmp(_G_native_adt_inst_base[_i2], _base) != 0) continue;")
        asm("    const char* _ts2 = _G_native_adt_inst_type[_i2];")
        asm("    int _k = 0; while (_ts2[_k] && _ts2[_k] != '<' && _k < 62) _k++;")
        asm("    if (_ts2[_k] != '<') continue;")
        asm("    char _rargs2[8][64]; int _rna2 = 0; int _rprof2 = 0; char _rcur2[64]; int _rcw2 = 0;")
        asm("    for (const char* _p2 = _ts2 + _k + 1; *_p2 && _rna2 < 8; _p2++) {")
        asm("        if (*_p2 == '<') { _rprof2++; if (_rcw2 < 63) _rcur2[_rcw2++] = *_p2; }")
        asm("        else if (*_p2 == '>') {")
        asm("            if (_rprof2 > 0) { _rprof2--; if (_rcw2 < 63) _rcur2[_rcw2++] = *_p2; }")
        asm("        }")
        asm("        else if (*_p2 == ',' && _rprof2 == 0) { _rcur2[_rcw2] = 0; strncpy(_rargs2[_rna2], _rcur2, 63); _rargs2[_rna2][63] = 0; _rna2++; _rcw2 = 0; }")
        asm("        else { if (_rcw2 < 63) _rcur2[_rcw2++] = *_p2; }")
        asm("    }")
        asm("    if (_rcw2 > 0 && _rna2 < 8) { _rcur2[_rcw2] = 0; strncpy(_rargs2[_rna2], _rcur2, 63); _rargs2[_rna2][63] = 0; _rna2++; }")
        asm("    if (_rna2 == _np) {")
        asm("        for (int _rr = 1; _rr < _np && _nr < 8; _rr++) strncpy(_resto[_nr++], _rargs2[_rr], 63);")
        asm("        _rok = 1;")
        asm("        break;")
        asm("    }")
        asm("}")
        asm("if (!_rok) { _oo[0] = 0; return 0; }")
        asm("int _w = 0;")
        asm("for (int _q = 0; _base[_q] && _w < 110; _q++) _oo[_w++] = _base[_q];")
        asm("_oo[_w++] = '<';")
        asm("for (int _q = 0; _argt[_q] && _w < 110; _q++) _oo[_w++] = _argt[_q];")
        asm("for (int _i3 = 0; _i3 < _nr && _w < 110; _i3++) {")
        asm("    _oo[_w++] = ',';")
        asm("    for (int _q = 0; _resto[_i3][_q] && _w < 110; _q++) _oo[_w++] = _resto[_i3][_q];")
        asm("}")
        asm("_oo[_w++] = '>'; _oo[_w] = 0;")
        asm("return 1;")

funcion _G_native_scan_ctor_exprs(p: puntero) -> nulo:
    inseguro:
        asm("struct Programa* _pp = (struct Programa*)p;")
        asm("if (!_pp) return;")
        asm("for (int _paso = 0; _paso < 4; _paso++) {")
        asm("    int _antes = _G_native_adt_inst_count;")
        asm("    struct ListaNodo* _sd = _pp->sentencias;")
        asm("    while (_sd) {")
        asm("        struct Nodo* _sn = _sd->cabeza;")
        asm("        if (_sn && _sn->tipo.datos && strcmp(_sn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _sf = (struct DefinicionFuncion*)_sn;")
        asm("            struct Nodo* _wq[4096]; int _wh = 0, _wt = 0;")
        asm("            struct ListaNodo* _b0 = _sf->cuerpo;")
        asm("            while (_b0) { if (_b0->cabeza && _wt < 4096) _wq[_wt++] = _b0->cabeza; _b0 = _b0->cola; }")
        asm("            while (_wh < _wt) {")
        asm("                struct Nodo* _wn = _wq[_wh++];")
        asm("                if (!_wn || !_wn->tipo.datos) continue;")
        asm("                const char* _tt = _wn->tipo.datos;")
        asm("                struct Nodo* _expr = 0;")
        asm("                if (strcmp(_tt, \"DeclaracionVariable\") == 0) {")
        asm("                    struct DeclaracionVariable* _dv = (struct DeclaracionVariable*)_wn;")
        asm("                    if (!_dv->tipo_param.datos || !_dv->tipo_param.datos[0]) _expr = _dv->expresion;")
        asm("                } else if (strcmp(_tt, \"AsignacionVariable\") == 0) {")
        asm("                    struct AsignacionVariable* _av = (struct AsignacionVariable*)_wn;")
        asm("                    _expr = _av->expresion;")
        asm("                }")
        asm("                if (_expr) {")
        asm("                    char _rt[128]; _rt[0] = 0;")
        asm("                    if (_G_native_adt_resolver_ctor((void*)_expr, (void*)_rt, 0) && _rt[0]) { _G_native_adt_registrar_syn((void*)_rt); }")
        asm("                }")
        asm("                if (strcmp(_tt, \"SentenciaSi\") == 0) {")
        asm("                    struct SentenciaSi* _si = (struct SentenciaSi*)_wn;")
        asm("                    struct ListaNodo* _l1 = _si->cuerpo; while (_l1) { if (_l1->cabeza && _wt < 4096) _wq[_wt++] = _l1->cabeza; _l1 = _l1->cola; }")
        asm("                    struct ListaNodo* _l2 = _si->cuerpo_sino; while (_l2) { if (_l2->cabeza && _wt < 4096) _wq[_wt++] = _l2->cabeza; _l2 = _l2->cola; }")
        asm("                }")
        asm("                if (strcmp(_tt, \"SentenciaMientras\") == 0) {")
        asm("                    struct SentenciaMientras* _wm = (struct SentenciaMientras*)_wn;")
        asm("                    struct ListaNodo* _l3 = _wm->cuerpo; while (_l3) { if (_l3->cabeza && _wt < 4096) _wq[_wt++] = _l3->cabeza; _l3 = _l3->cola; }")
        asm("                }")
        asm("                if (strcmp(_tt, \"BloqueInseguro\") == 0) {")
        asm("                    struct BloqueInseguro* _bi = (struct BloqueInseguro*)_wn;")
        asm("                    struct ListaNodo* _l4 = _bi->cuerpo; while (_l4) { if (_l4->cabeza && _wt < 4096) _wq[_wt++] = _l4->cabeza; _l4 = _l4->cola; }")
        asm("                }")
        asm("                if (strcmp(_tt, \"SentenciaPara\") == 0) {")
        asm("                    struct SentenciaPara* _pa = (struct SentenciaPara*)_wn;")
        asm("                    struct ListaNodo* _pl = _pa->cuerpo; while (_pl) { if (_pl->cabeza && _wt < 4096) _wq[_wt++] = _pl->cabeza; _pl = _pl->cola; }")
        asm("                }")
        asm("                if (strcmp(_tt, \"NodoCoincidir\") == 0) {")
        asm("                    struct NodoCoincidir* _mc = (struct NodoCoincidir*)_wn;")
        asm("                    struct ListaNodo* _cl = _mc->casos;")
        asm("                    while (_cl) {")
        asm("                        struct NodoCaso* _ca = (struct NodoCaso*)_cl->cabeza;")
        asm("                        if (_ca && _ca->cuerpo) {")
        asm("                            struct ListaNodo* _bl = _ca->cuerpo;")
        asm("                            while (_bl) { if (_bl->cabeza && _wt < 4096) _wq[_wt++] = _bl->cabeza; _bl = _bl->cola; }")
        asm("                        }")
        asm("                        _cl = _cl->cola;")
        asm("                    }")
        asm("                }")
        asm("            }")
        asm("        }")
        asm("        _sd = _sd->cola;")
        asm("    }")
        asm("    if (_G_native_adt_inst_count == _antes) break;")
        asm("}")

// ----------------------------------------------------------
// F3-7 (Manual 2 L113): helpers del `escuchar` nativo.
// Funciones reales (patron _G_native_scan_ctor_exprs): el compilador
// las necesita en SU unity (recorrido.syn pre-scan + nodos_flujo.syn
// gen_visitar_escuchar las llaman via asm); NO pueden emitirse como
// texto de cabecera (gen_emitir_linea) porque referencian structs del
// AST que en programas de usuario no existen.
// ----------------------------------------------------------
funcion _G_native_contar_escuchar(n: puntero) -> entero:
    requiere:
        n != nulo
    garantiza:
        _resultado_ >= 0
    inseguro:
        asm("if (!n) return 0;")
        asm("struct Nodo* _no = (struct Nodo*)n;")
        asm("if (!_no->tipo.datos) return 0;")
        asm("const char* _t = _no->tipo.datos;")
        asm("int _c = 0;")
        asm("if (strcmp(_t, \"SentenciaEscuchar\") == 0) _c++;")
        asm("struct ListaNodo* _l = 0;")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s = (struct SentenciaSi*)_no; _l = _s->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaMientras\") == 0) { struct SentenciaMientras* _m = (struct SentenciaMientras*)_no; _l = _m->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaPara\") == 0) { struct SentenciaPara* _p = (struct SentenciaPara*)_no; _l = _p->cuerpo; }")
        asm("else if (strcmp(_t, \"BloqueInseguro\") == 0) { struct BloqueInseguro* _b = (struct BloqueInseguro*)_no; _l = _b->cuerpo; }")
        asm("else if (strcmp(_t, \"DefinicionFuncion\") == 0) { struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_no; _l = _f->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaEscuchar\") == 0) { struct SentenciaEscuchar* _e = (struct SentenciaEscuchar*)_no; _l = _e->cuerpo; }")
        asm("while (_l) { _c += _G_native_contar_escuchar(_l->cabeza); _l = _l->cola; }")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s2 = (struct SentenciaSi*)_no; struct ListaNodo* _ls = _s2->cuerpo_sino; while (_ls) { _c += _G_native_contar_escuchar(_ls->cabeza); _ls = _ls->cola; } }")
        asm("return _c;")

// F4.4: pre-scan de `lanzar` (fibras M:N, Manual 5 §2.6) — recorre un nodo
// contando SentenciaLanzar con el MISMO orden que la emision (contador local
// que replica _G_lanzar_count, que avanza para TODO lanzar aunque solo los
// que llevan argumentos crean wrapper) y acumula en `out` las declaraciones
// adelantadas `static void _wrap_N(void* arg);` para emitirlas ANTES de los
// cuerpos de funcion (paridad S1 _preprocess_lanzar + _deferred_wrap_decls;
// el patron _G_native_contar_escuchar de F3-7).
funcion _G_native_contar_lanzar(n: puntero, out: puntero) -> nulo:
    requiere:
        n != nulo
        out != nulo
    garantiza:
        verdadero
    inseguro:
        asm("if (!n || !out) return;")
        asm("struct Nodo* _no = (struct Nodo*)n;")
        asm("if (!_no->tipo.datos) return;")
        asm("const char* _t = _no->tipo.datos;")
        asm("static int _lc = 0;")
        asm("if (strcmp(_t, \"SentenciaLanzar\") == 0) {")
        asm("    _lc++;")
        asm("    struct SentenciaLanzar* _lz = (struct SentenciaLanzar*)_no;")
        asm("    if (_lz->llamada && _lz->llamada->tipo.datos && strcmp(_lz->llamada->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_lz->llamada;")
        asm("        if (_lf->argumentos) {")
        asm("            char _lb[128]; snprintf(_lb, 128, \"static void _wrap_%d(void* arg);\\n\", _lc);")
        asm("            strcat(out, _lb);")
        asm("        }")
        asm("    }")
        asm("}")
        asm("struct ListaNodo* _l = 0;")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s = (struct SentenciaSi*)_no; _l = _s->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaMientras\") == 0) { struct SentenciaMientras* _m = (struct SentenciaMientras*)_no; _l = _m->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaPara\") == 0) { struct SentenciaPara* _p = (struct SentenciaPara*)_no; _l = _p->cuerpo; }")
        asm("else if (strcmp(_t, \"BloqueInseguro\") == 0) { struct BloqueInseguro* _b = (struct BloqueInseguro*)_no; _l = _b->cuerpo; }")
        asm("else if (strcmp(_t, \"DefinicionFuncion\") == 0) { struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_no; _l = _f->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaEscuchar\") == 0) { struct SentenciaEscuchar* _e = (struct SentenciaEscuchar*)_no; _l = _e->cuerpo; }")
        asm("while (_l) { _G_native_contar_lanzar(_l->cabeza, out); _l = _l->cola; }")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s2 = (struct SentenciaSi*)_no; struct ListaNodo* _ls = _s2->cuerpo_sino; while (_ls) { _G_native_contar_lanzar(_ls->cabeza, out); _ls = _ls->cola; } }")

funcion _G_native_escuchar_vars(n: puntero, out: puntero) -> nulo:
    requiere:
        n != nulo
        out != nulo
    garantiza:
        verdadero
    inseguro:
        asm("if (!n || !out) return;")
        asm("struct Nodo* _no = (struct Nodo*)n;")
        asm("if (!_no->tipo.datos) return;")
        asm("const char* _t = _no->tipo.datos;")
        asm("char _tb[128]; _tb[0] = 0;")
        asm("if (strcmp(_t, \"AsignacionVariable\") == 0) {")
        asm("    struct AsignacionVariable* _a = (struct AsignacionVariable*)_no;")
        asm("    if (_a->nombre.datos && _a->expresion) {")
        asm("        extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out);")
        asm("        _syn_nativo_expr_tipo_c((void*)_a->expresion, (void*)_tb);")
        asm("        if (!_tb[0]) strcpy(_tb, \"int64_t\");")
        asm("        snprintf(out + strlen(out), 4096 - strlen(out), \"    %s %s;\n\", _tb, _a->nombre.datos);")
        asm("    }")
        asm("} else if (strcmp(_t, \"DeclaracionVariable\") == 0) {")
        asm("    struct DeclaracionVariable* _d = (struct DeclaracionVariable*)_no;")
        asm("    if (_d->nombre.datos) {")
        asm("        if (_d->expresion) { extern int64_t _syn_nativo_expr_tipo_c(void* n, void* out); _syn_nativo_expr_tipo_c((void*)_d->expresion, (void*)_tb); }")
        asm("        if (!_tb[0] && _d->tipo.datos && _d->tipo.datos[0]) { traducir_tipo_c((void*)_d->tipo.datos); extern char _gen_tmp_buf[4096]; strncpy(_tb, _gen_tmp_buf, 127); _tb[127] = 0; }")
        asm("        if (!_tb[0]) strcpy(_tb, \"int64_t\");")
        asm("        snprintf(out + strlen(out), 4096 - strlen(out), \"    %s %s;\n\", _tb, _d->nombre.datos);")
        asm("    }")
        asm("}")
        asm("struct ListaNodo* _l = 0;")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s = (struct SentenciaSi*)_no; _l = _s->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaMientras\") == 0) { struct SentenciaMientras* _m = (struct SentenciaMientras*)_no; _l = _m->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaPara\") == 0) { struct SentenciaPara* _p = (struct SentenciaPara*)_no; _l = _p->cuerpo; }")
        asm("else if (strcmp(_t, \"BloqueInseguro\") == 0) { struct BloqueInseguro* _b = (struct BloqueInseguro*)_no; _l = _b->cuerpo; }")
        asm("else if (strcmp(_t, \"SentenciaEscuchar\") == 0) { struct SentenciaEscuchar* _e = (struct SentenciaEscuchar*)_no; _l = _e->cuerpo; }")
        asm("while (_l) { _G_native_escuchar_vars(_l->cabeza, out); _l = _l->cola; }")
        asm("if (strcmp(_t, \"SentenciaSi\") == 0) { struct SentenciaSi* _s2 = (struct SentenciaSi*)_no; struct ListaNodo* _ls = _s2->cuerpo_sino; while (_ls) { _G_native_escuchar_vars(_ls->cabeza, out); _ls = _ls->cola; } }")

// ===== From: recorrido.syn =====

#lang: es

// ============================================================
// recorrido.syn - recorrido top-level del AST (orden alfabetico + dispatch)
// ============================================================
// Extraido de orquestador.syn en la modularizacion (deuda
// AUDITORIA_ALINEACION_MANUALES: orquestador.syn 101KB / 1350
// lineas con generar() como monolito de 932 lineas). Los bloques
// asm se mueven TEXTUALMENTE (misma indentacion) a funciones que
// generar() invoca en el mismo orden -> el C generado no cambia.

// ----------------------------------------------------------
// gen_recorrer_toplevel - (bloque extraido de generar())
// ----------------------------------------------------------
funcion gen_recorrer_toplevel(est: GeneradorCEst, programa: Programa) -> nulo:
    // WALK TOP-LEVEL AST
    inseguro:
        asm("fprintf(stderr, \"[Orquestador] Iniciando recorrido AST\\n\"); fflush(stderr);")
        asm("// Manual 8 S8.2: orden alfabetico estricto en emision de funciones/estructuras")
        asm("// Colectar todos los nodos top-level en un array para ordenarlos")
        asm("#define _MAX_TOP_NODOS 4096")
        asm("struct Nodo* _top_nodes[_MAX_TOP_NODOS];")
        asm("int _top_count = 0;")
        asm("struct ListaNodo* _cur = programa.sentencias;")
        asm("char _top_seen_names[2048][64]; int _top_seen_count = 0;")
        asm("while (_cur && _top_count < _MAX_TOP_NODOS) {")
        asm("    struct Nodo* _n = _cur->cabeza;")
        asm("    if (_n && _n->tipo.datos) {")
        asm("        const char* _tcf = _n->tipo.datos;")
        asm("        int _drop = 0;")
        asm("        // Manual 8 S8.2 determinismo: descartar el artefacto 'constante' parseado como SentenciaExpr\n")
        asm("        if (strcmp(_tcf, \"SentenciaExpr\") == 0) {")
        asm("            struct SentenciaExpr* _sfc = (struct SentenciaExpr*)_n;")
        asm("            if (_sfc->expr && _sfc->expr->tipo.datos && strcmp(_sfc->expr->tipo.datos, \"Identificador\") == 0) {")
        asm("                struct Identificador* _idc = (struct Identificador*)_sfc->expr;")
        asm("                if (_idc->nombre.datos && strcmp(_idc->nombre.datos, \"constante\") == 0) _drop = 1;")
        asm("            }")
        asm("        }")
        asm("        // Manual 8 S8.2 determinismo: deduplicar constantes globales por nombre (primero gana)\n")
        asm("        const char* _cname = 0;")
        asm("        if (strcmp(_tcf, \"AsignacionVariable\") == 0) {")
        asm("            struct AsignacionVariable* _avc = (struct AsignacionVariable*)_n;")
        asm("            if (_avc->nombre.datos) _cname = _avc->nombre.datos;")
        asm("        }")
        asm("        if (_cname) {")
        asm("            int _seen = 0;")
        asm("            for (int _si2 = 0; _si2 < _top_seen_count; _si2++) { if (strcmp(_top_seen_names[_si2], _cname) == 0) { _seen = 1; break; } }")
        asm("            if (_seen) { _drop = 1; } else { strncpy(_top_seen_names[_top_seen_count], _cname, 63); _top_seen_count++; }")
        asm("        }")
        asm("        if (!_drop) { _top_nodes[_top_count++] = _n; }")
        asm("    }")
        asm("    _cur = _cur->cola;")
        asm("}")
        asm("// Bubble sort por nombre de funcion/estructura; otros tipos conservan orden relativo")
        asm("for (int _si = 0; _si < _top_count - 1; _si++) {")
        asm("    for (int _sj = 0; _sj < _top_count - 1 - _si; _sj++) {")
        asm("        struct Nodo* _a = _top_nodes[_sj];")
        asm("        struct Nodo* _b = _top_nodes[_sj+1];")
        asm("        const char* _ta = _a->tipo.datos;")
        asm("        const char* _tb = _b->tipo.datos;")
        asm("        int _swap = 0;")
        asm("        // Solo ordenar funciones y estructuras por nombre")
        asm("        if (_ta && _tb && strcmp(_ta, \"DefinicionFuncion\") == 0 && strcmp(_tb, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _fa = (struct DefinicionFuncion*)_a;")
        asm("            struct DefinicionFuncion* _fb = (struct DefinicionFuncion*)_b;")
        asm("            if (_fa->nombre.datos && _fb->nombre.datos && strcmp(_fa->nombre.datos, _fb->nombre.datos) > 0) _swap = 1;")
        asm("        } else if (_ta && _tb && strcmp(_ta, \"DefinicionEstructura\") == 0 && strcmp(_tb, \"DefinicionEstructura\") == 0) {")
        asm("            struct DefinicionEstructura* _ea = (struct DefinicionEstructura*)_a;")
        asm("            struct DefinicionEstructura* _eb = (struct DefinicionEstructura*)_b;")
        asm("            if (_ea->nombre.datos && _eb->nombre.datos && strcmp(_ea->nombre.datos, _eb->nombre.datos) > 0) _swap = 1;")
        asm("        }")
        asm("        if (_swap) { struct Nodo* _tmp = _top_nodes[_sj]; _top_nodes[_sj] = _top_nodes[_sj+1]; _top_nodes[_sj+1] = _tmp; }")
        asm("    }")
        asm("}")
        asm("// Fase 1: emitir TODAS las DefinicionEstructura primero (dependencias de tipos)")
        asm("fprintf(stderr, \"[Orquestador] Fase 1: emitiendo estructuras\\n\"); fflush(stderr);")
        asm("for (int _ei = 0; _ei < _top_count; _ei++) {")
        asm("    struct Nodo* _en = _top_nodes[_ei];")
        asm("    if (_en && _en->tipo.datos && strcmp(_en->tipo.datos, \"DefinicionEstructura\") == 0) {")
        asm("        struct DefinicionEstructura* _de0 = (struct DefinicionEstructura*)_en;")
        asm("        if (_de0->nombre.datos && strcmp(_de0->nombre.datos, \"Token\") != 0 && strcmp(_de0->nombre.datos, \"Nodo\") != 0 && strcmp(_de0->nombre.datos, \"ListaNodo\") != 0 && strcmp(_de0->nombre.datos, \"Programa\") != 0) {")
        asm("            char _stbuf0[4096];")
        asm("            snprintf(_stbuf0, 4096, \"typedef struct %s {\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stbuf0);")
        asm("            struct ListaParametro* _fcp0 = _de0->campos;")
        asm("            while (_fcp0) {")
        asm("                struct Parametro* _fp0 = (struct Parametro*)_fcp0->cabeza;")
        asm("                if (_fp0 && _fp0->nombre.datos && _fp0->tipo_param.datos) {")
        asm("                    // ME-B7: _ARRAY_OVERRIDE_FIELDS (paridad context.py L236-239):")
        asm("                    // pila_indent es int[64] aunque el .syn declara entero (asm() raw lo indexa).")
        asm("                    if (strcmp(_fp0->nombre.datos, \"pila_indent\") == 0) { gen_emitir_str(est, \"    int pila_indent[64];\"); }")
        asm("                    else {")
        asm("                        traducir_tipo_c_campo((void*)_fp0->tipo_param.datos);")
        asm("                        extern char _gen_tmp_buf[4096];")
        asm("                        const char* _fct0 = _gen_tmp_buf;")
        asm("                        char _fld0[4096];")
        asm("                        snprintf(_fld0, 4096, \"    %s %s;\", _fct0, _fp0->nombre.datos);")
        asm("                        gen_emitir_str(est, _fld0);")
        asm("                    }")
        asm("                }")
        asm("                _fcp0 = _fcp0->cola;")
        asm("            }")
        asm("            char _stclose0[4096];")
        asm("            snprintf(_stclose0, 4096, \"} %s;\", _de0->nombre.datos);")
        asm("            gen_emitir_str(est, _stclose0);")
        asm("        }")
        asm("    }")
        asm("}")
        asm("// F1.2b: typedefs de DeclaracionTipo (alias/ADT) tras las estructuras y")
        asm("// antes de los prototipos (paridad generator.py L1075-1078). Los prototipos")
        asm("// y cuerpos referencian struct <ADT>; el typedef debe existir antes.")
        asm("for (int _tdi = 0; _tdi < _top_count; _tdi++) {")
        asm("    struct Nodo* _tdn = _top_nodes[_tdi];")
        asm("    if (_tdn && _tdn->tipo.datos && strcmp(_tdn->tipo.datos, \"DeclaracionTipo\") == 0) {")
        asm("        gen_visitar_top_level(est, _tdn);")
        asm("    }")
        asm("}")
        asm("// F3-7: pre-scan de `escuchar` — emitir los externs de los listeners")
        asm("// ANTES de los cuerpos de funciones (paridad S1 _emit_cuerpos: antes se")
        asm("// emitian tras ellas y gcc fallaba con '_listener_N undeclared' al usarse")
        asm("// en synapse_lanzar_hilo dentro de principal). El conteo replica el orden")
        asm("// de emision (no-funciones en parse order + funciones alfabeticas) para")
        asm("// que la numeracion _listener_1..N coincida con est->contador_listener.")
        asm("extern int64_t _G_native_contar_escuchar(void* n);")
        asm("int _esc_total = 0;")
        asm("for (int _esci = 0; _esci < _top_count; _esci++) {")
        asm("    struct Nodo* _escn = _top_nodes[_esci];")
        asm("    if (!_escn || !_escn->tipo.datos) continue;")
        asm("    if (strcmp(_escn->tipo.datos, \"DefinicionFuncion\") == 0) continue;")
        asm("    _esc_total += _G_native_contar_escuchar(_escn);")
        asm("}")
        asm("for (int _esci = 0; _esci < _top_count; _esci++) {")
        asm("    struct Nodo* _escn = _top_nodes[_esci];")
        asm("    if (!_escn || !_escn->tipo.datos) continue;")
        asm("    if (strcmp(_escn->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    _esc_total += _G_native_contar_escuchar(_escn);")
        asm("}")
        asm("for (int _esi = 1; _esi <= _esc_total; _esi++) {")
        asm("    char _esb[128]; snprintf(_esb, 128, \"extern void _listener_%d(void* arg);\", _esi);")
        asm("    gen_emitir_str(est, _esb);")
        asm("}")
        asm("if (_esc_total) gen_emitir_nueva_linea(est);")
        asm("// F4.4: pre-scan de `lanzar` — declaraciones adelantadas de los wrappers")
        asm("// `static void _wrap_N(void* arg)` ANTES de los cuerpos (paridad S1")
        asm("// _preprocess_lanzar/_deferred_wrap_decls; patron _G_native_contar_lanzar")
        asm("// replica el orden de emision y el contador de TODO lanzar).")
        asm("extern void _G_native_contar_lanzar(void* n, void* out);")
        asm("char _lzb[8192]; _lzb[0] = 0;")
        asm("for (int _lzi = 0; _lzi < _top_count; _lzi++) {")
        asm("    struct Nodo* _lzn = _top_nodes[_lzi];")
        asm("    if (!_lzn || !_lzn->tipo.datos) continue;")
        asm("    if (strcmp(_lzn->tipo.datos, \"DefinicionFuncion\") == 0) continue;")
        asm("    _G_native_contar_lanzar(_lzn, _lzb);")
        asm("}")
        asm("for (int _lzi = 0; _lzi < _top_count; _lzi++) {")
        asm("    struct Nodo* _lzn = _top_nodes[_lzi];")
        asm("    if (!_lzn || !_lzn->tipo.datos) continue;")
        asm("    if (strcmp(_lzn->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    _G_native_contar_lanzar(_lzn, _lzb);")
        asm("}")
        asm("if (_lzb[0]) { gen_emitir_str(est, _lzb); gen_emitir_nueva_linea(est); }")
        asm("// ME-B7: prototipos de funciones (Manual 8 S8.2, paridad _emit_prototipos_funciones + _SPECIAL_SIGS)")
        asm("// El C de salida no tiene prototipos si no se emiten: las llamadas entre modulos")
        asm("// (orden alfabetico) fallarian con 'implicit declaration / conflicting types'.")
        asm("_G_emit_func_count = 0;")
        asm("for (int _pi = 0; _pi < _top_count; _pi++) {")
        asm("    struct Nodo* _pn0 = _top_nodes[_pi];")
        asm("    if (!_pn0 || !_pn0->tipo.datos) continue;")
        asm("    // F1.2d: prototipos tambien para funciones envueltas en @export (Manual 2 L81)")
        asm("    struct DefinicionFuncion* _pf0 = NULL;")
        asm("    if (strcmp(_pn0->tipo.datos, \"DefinicionFuncion\") == 0) { _pf0 = (struct DefinicionFuncion*)_pn0; }")
        asm("    else if (strcmp(_pn0->tipo.datos, \"DeclaracionExport\") == 0) {")
        asm("        struct DeclaracionExport* _pexn = (struct DeclaracionExport*)_pn0;")
        asm("        if (_pexn->funcion && _pexn->funcion->tipo.datos && strcmp(_pexn->funcion->tipo.datos, \"DefinicionFuncion\") == 0) { _pf0 = (struct DefinicionFuncion*)_pexn->funcion; }")
        asm("    }")
        asm("    if (!_pf0) continue;")
        asm("    if (!_pf0->nombre.datos || !_pf0->tipo_retorno.datos) continue;")
        asm("    const char* _pfn0 = _pf0->nombre.datos;")
        asm("    // Paridad emit_selfhost.py L1203: saltar builtins de runtime (str_eq, etc.)")
        asm("    if (_es_builtin_runtime((void*)_pfn0)) continue;")
        asm("    // Dedup por nombre (parser.syn define parsear_tipo_retorno 2 veces; la referencia")
        asm("    // usa _funciones_emitidas - paridad: primer prototipo gana).")
        asm("    int _pfd = 0;")
        asm("    for (int _pd = 0; _pd < _G_emit_func_count; _pd++) { if (strcmp(_G_emit_func_names[_pd], _pfn0) == 0) { _pfd = 1; break; } }")
        asm("    if (_pfd) continue;")
        asm("    strncpy(_G_emit_func_names[_G_emit_func_count], _pfn0, 63); _G_emit_func_names[_G_emit_func_count][63] = 0; _G_emit_func_count++;")
        asm("    char _psig0[4096];")
        asm("    // _SPECIAL_SIGS: firmas canonicas que reemplazan las definiciones legacy")
        asm("    if (strcmp(_pfn0, \"tokenizar\") == 0) { strcpy(_psig0, \"int64_t tokenizar(CadenaSegura fuente);\"); }")  // A5.2 D-7: entero -> int64_t
        asm("    else if (strcmp(_pfn0, \"parsear\") == 0) { strcpy(_psig0, \"struct Programa parsear(CadenaSegura fuente);\"); }")
        asm("    else if (strcmp(_pfn0, \"volcar_ast\") == 0) { strcpy(_psig0, \"void volcar_ast(struct Nodo* nodo, int nivel);\"); }")
        asm("    else if (strcmp(_pfn0, \"generar\") == 0) { strcpy(_psig0, \"int64_t generar(struct Programa programa, CadenaSegura ruta);\"); }")  // A5.2 D-7: entero -> int64_t
        asm("    else {")
        asm("        char _pp0[4096] = \"void\"; int _ppo0 = 0, _ppf0 = 1;")
        asm("        struct ListaParametro* _ppc0 = _pf0->parametros;")
        asm("        while (_ppc0) {")
        asm("            struct Parametro* _ppar = (struct Parametro*)_ppc0->cabeza;")
        asm("            if (_ppar && _ppar->nombre.datos && _ppar->tipo_param.datos) {")
        asm("                if (_ppf0) { _ppo0 = 0; _ppf0 = 0; } else { _pp0[_ppo0++] = ','; _pp0[_ppo0++] = ' '; }")
        asm("                const char* _ppt0 = _ppar->tipo_param.datos;")
        asm("                traducir_tipo_c((void*)_ppt0);")
        asm("                extern char _gen_tmp_buf[4096];")
        asm("                const char* _pct0 = _gen_tmp_buf;")
        asm("                // Manual 3 S3.3 / paridad _POINTER_TYPES: tipos de estado se pasan por puntero")
        asm("                // FASE A (A2.3): ParserEst (parser.syn) - mismo mecanismo que AnalizadorSemanticoEst")
        asm("                if (_ppt0 && (strcmp(_ppt0, \"AnalizadorSemanticoEst\") == 0 || strcmp(_ppt0, \"RegionGraph\") == 0 || strcmp(_ppt0, \"UnionFind\") == 0 || strcmp(_ppt0, \"ParserEst\") == 0)) { strcat(_gen_tmp_buf, \"*\"); _pct0 = _gen_tmp_buf; }")
        asm("                int _pk0 = 0; while (_pct0[_pk0]) _pp0[_ppo0++] = _pct0[_pk0++];")
        asm("                _pp0[_ppo0++] = ' ';")
        asm("                _pk0 = 0; while (_ppar->nombre.datos[_pk0]) _pp0[_ppo0++] = _ppar->nombre.datos[_pk0++];")
        asm("            }")
        asm("            _ppc0 = _ppc0->cola;")
        asm("        }")
        asm("        _pp0[_ppo0] = 0;")
        asm("        traducir_tipo_c((void*)_pf0->tipo_retorno.datos);")
        asm("        extern char _gen_tmp_buf[4096];")
        asm("        snprintf(_psig0, 4096, \"%s %s(%s);\", _gen_tmp_buf, _pfn0, _pp0);")
        asm("    }")
        asm("    gen_emitir_str(est, _psig0);")
        asm("}")
        asm("gen_emitir_str(est, \"\");")
        asm("// Manual 8 S8.2 / paridad _emit_cuerpos (generator.py L747-753):")
        asm("// Fase 2A: emitir PRIMERO las sentencias no-funcion (constantes globales, externs,")
        asm("// imports) en orden de parse - requisito de C: las constantes deben existir antes")
        asm("// que cualquier cuerpo de funcion que las use.")
        asm("_G_emit_func_count = 0;")
        asm("fprintf(stderr, \"[Orquestador] Fase 2A: no-funciones primero\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") == 0) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionEstructura\") == 0) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DeclaracionTipo\") == 0) continue;  // ya emitidos en Fase 1.5")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")
        asm("// Fase 2B: funciones en orden alfabetico (Manual 8 S8.2)")
        asm("fprintf(stderr, \"[Orquestador] Fase 2B: funciones en orden alfabetico\\n\"); fflush(stderr);")
        asm("for (int _vi = 0; _vi < _top_count; _vi++) {")
        asm("    struct Nodo* _n = _top_nodes[_vi];")
        asm("    if (!_n || !_n->tipo.datos) continue;")
        asm("    if (strcmp(_n->tipo.datos, \"DefinicionFuncion\") != 0) continue;")
        asm("    gen_visitar_top_level(est, _n);")
        asm("}")

    // Manual 8 S8.3 / paridad referencia: PGO via flags GCC (sin atexit manual)

    // F3-7/F4.4: flush de los listeners (`void _listener_N`) y de los wrappers
    // de `lanzar` (`static void _wrap_N`) acumulados — antes del main (paridad
    // S1 _listener_funciones/_deferred_wrappers al final de _emit_cuerpos).
    inseguro:
        asm("extern char _G_listeners[8][16384]; extern int _G_listeners_count;")
        asm("for (int _lfi = 0; _lfi < _G_listeners_count; _lfi++) {")
        asm("    if (_G_listeners[_lfi][0]) gen_emitir_str(est, _G_listeners[_lfi]);")
        asm("}")
        asm("if (_G_listeners_count) gen_emitir_nueva_linea(est);")
        asm("extern char _G_lanzar_wrappers[8][4096]; extern int _G_lanzar_wrappers_count;")
        asm("for (int _lwi = 0; _lwi < _G_lanzar_wrappers_count; _lwi++) {")
        asm("    if (_G_lanzar_wrappers[_lwi][0]) gen_emitir_str(est, _G_lanzar_wrappers[_lwi]);")
        asm("}")
        asm("if (_G_lanzar_wrappers_count) gen_emitir_nueva_linea(est);")

    // Emit main() wrapper — F3-11: paridad S1 (generator.py L1158-1176).
    // Manual 8 S8.2: si `principal` retorna nulo (void) el C fallaria con
    // 'void value not ignored' -> llamada sin captura y return 0; si retorna
    // entero (el rc del pipeline), capturar y return _rc. ANTES se emitia
    // SIEMPRE `principal(); ... return 0;` -> stage2 auto-compilado perdia el
    // codigo de error (rc=7 -> 0) de los errores semanticos (F3-11).
    inseguro:
        asm("int _principal_es_entero = 0;")
        asm("struct ListaNodo* _pcur = programa.sentencias;")
        asm("while (_pcur) {")
        asm("    struct Nodo* _pn = _pcur->cabeza;")
        asm("    if (_pn && _pn->tipo.datos && strcmp(_pn->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _pf = (struct DefinicionFuncion*)_pn;")
        asm("        if (_pf->nombre.datos && strcmp(_pf->nombre.datos, \"principal\") == 0) {")
        asm("            const char* _ptr = _pf->tipo_retorno.datos ? _pf->tipo_retorno.datos : \"\";")
        asm("            if (_ptr[0] && strcmp(_ptr, \"nulo\") != 0 && strcmp(_ptr, \"void\") != 0) _principal_es_entero = 1;")
        asm("            break;")
        asm("        }")
        asm("    }")
        asm("    _pcur = _pcur->cola;")
        asm("}")
        asm("gen_emitir_str(est, \"int main(int argc, char** argv) {\");")
        asm("gen_emitir_str(est, \"    _g_argc = argc;\");")
        asm("gen_emitir_str(est, \"    _g_argv = argv;\");")
        asm("gen_emitir_str(est, \"    pool_init(64, 4096);\");")
        asm("if (_principal_es_entero) {")
        asm("    gen_emitir_str(est, \"    int64_t _rc = principal();\");")
        asm("} else {")
        asm("    gen_emitir_str(est, \"    principal();\");")
        asm("}")
        asm("gen_emitir_str(est, \"    synapse_esperar_hilos();\");")
        asm("gen_emitir_str(est, \"    synapse_esperar_fibras();\");")
        asm("gen_emitir_str(est, \"    pool_destroy();\");")
        asm("if (_principal_es_entero) {")
        asm("    gen_emitir_str(est, \"    return _rc;\");")
        asm("} else {")
        asm("    gen_emitir_str(est, \"    return 0;\");")
        asm("}")
        asm("gen_emitir_str(est, \"}\");")

// ===== From: funciones.syn =====

// ============================================================
// funciones.syn — Emision de funciones de usuario
// (extraido de la rama DefinicionFuncion de gen_visitar_top_level
// en la modularizacion; AUDITORIA 13)
// ============================================================

funcion gen_visitar_funcion(est: GeneradorCEst, stmt: puntero) -> nulo:
    inseguro:
        asm("struct Nodo* _n = (struct Nodo*)stmt;")
        asm("if (!_n) return;")
        asm("const char* _t = _n->tipo.datos;")
