#lang: es
// cumple Manual 2 §1.3: parser
// cumple Manual 3 §3: bucle_para_rango `para x en expr:` (r153 R2n)
# cumple Manual 8 §4.1: compilador nativo S2
// R29 (regla 13, modularizacion): sentencias de control de flujo extraidas de
// nucleo/parser.syn (1, 511 lineas -> parser.syn 486 + sentencias 553 +
// declaraciones 420 + canales 52). Diagnostico FASE A (2026-08-07): parser.syn
// era el cajon de sastre del frontend nativo (30 funciones top-level) pese a
// existir parser_base/expr/stmt/constantes. Mecanico: texto identico, sin
// cambios de logica; el emisor S1 ordena funciones/estructuras alfabeticamente
// (Manual 8 §8.2) -> C byte-identico verificado por bootstrap.
// ------------------------------------------------------------
funcion parsear_si(est: ParserEst) -> entero:
    stmt = 0
    r = 1
    si token_esperar(est, T_SI) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_SI, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero_si = 0
    ultimo_si = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero_si == 0:
                        primero_si = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo_si].hermano = stmt")
                    ultimo_si = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'si cond: stmt' en una sola linea
        // (paridad _P_si del espejo: 'else { _P_sentencia(); }'). Antes solo
        // se manejaba NUEVALINEA+INDENTAR y el inline quedaba como sentencia
        // hermana — 'si idx == 0: retornar "tensor"' dejaba el retornar FUERA
        // del if (55 usos solo en analizador_semantico.syn -> divergencia S3).
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero_si = stmt
            ultimo_si = stmt
    si primero_si > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero_si")
    // FASE A (A3.1): el cuerpo del sino se ENLAZA (primero en NODO_SI.ptr_extra,
    // cadena hermano) — antes se parseaba y se DESCARTABA (SentenciaSi.cuerpo_sino
    // del puente estaria vacio; paridad _P_* cuerpo_sino en _P_sentencia).
    r = 1
    primero_sino = 0
    ultimo_sino = 0
    si token_mirar(est) == T_SINO:
        token_avanzar(est)
        // cumple Manual 2 §3: T_SINO — 'sino si' (cadena else-if) es azucar de
        // un si ANIDADO como cuerpo del sino: paridad exacta con el espejo
        // _P_si (parser.c L1879-1883), donde el else simplemente anida el si
        // siguiente (SentenciaSi.cuerpo_sino = [SentenciaSi anidado], Manual 2
        // §L365). Antes T_SINO caia al parser_sinc_skip de parsear_sentencia
        // (se comia el 'sino' en silencio) y el ':' siguiente producia
        // 'Token inesperado COLON': NINGUN archivo con 'sino si' compilaba
        // (nucleo/llvm_backend.syn, syquex/parser.syn, opensyn/, build/syq_frontend.syn).
        si token_mirar(est) == T_SI:
            stmt_sino_si = parsear_si(est)
            si stmt_sino_si != 0:
                primero_sino = stmt_sino_si
                ultimo_sino = stmt_sino_si
        sino:
            si token_esperar(est, T_DOSPUNTOS) == 0:
                retornar 0
            si token_mirar(est) == T_NUEVALINEA:
                token_avanzar(est)
                mientras token_mirar(est) == T_NUEVALINEA:
                    token_avanzar(est)
                si token_mirar(est) == T_INDENTAR:
                    token_avanzar(est)
                    mientras r == 1:
                        t = token_mirar(est)
                        si t == T_NUEVALINEA:
                            token_avanzar(est)
                            siguiente
                        si t == T_DESINDENTAR:
                            token_avanzar(est)
                            r = 0
                            romper
                        si t == T_FIN:
                            r = 0
                            romper
                        stmt = parsear_sentencia(est)
                        si stmt != 0:
                            si primero_sino == 0:
                                primero_sino = stmt
                            sino:
                                inseguro:
                                    asm("est->nodos[ultimo_sino].hermano = stmt")
                            ultimo_sino = stmt
                        sino:
                            // Anti-cuelgue (paridad A3.1)
                            token_avanzar(est)
                        siguiente
            sino:
                // FASE A (A4.5): cuerpo inline del sino (paridad _P_si).
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    primero_sino = stmt
                    ultimo_sino = stmt
    si primero_sino > 0:
        inseguro:
            asm("est->nodos[nodo].ptr_extra = primero_sino")
    retornar nodo

funcion parsear_mientras(est: ParserEst) -> entero:
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_MIENTRAS, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'mientras cond: stmt' (paridad _P_*
        // T_WHILE: 'else { _P_sentencia(); }').
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero")
    retornar nodo

funcion parsear_para(est: ParserEst) -> entero:
    // Synapse-style: para Identificador = Expresion mientras Expresion: (Manual 2 §2.2)
    // Ej: para i = 0 mientras i < 10:
    si token_esperar(est, T_PARA) == 0:
        retornar 0
    si token_es_nombre(token_mirar(est)) == 0:
        parser_error(est, "Se esperaba variable de bucle para", token_linea(est, est.posicion), token_columna(est, est.posicion))
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    // cumple Manual 3 §3 (r153 R2n): bucle_para_rango `para x en expr:` —
    // "en" es identificador contextual (paridad parser_control.py: TOKENS_
    // CONTEXTUALES): si el token tras la variable tiene lexema "en", el bucle
    // itera sobre una coleccion (NODO_PARA_EN; variable en payload primario,
    // iterable en hijo_der, cuerpo en hijo_izq).
    si token_tipo(est, est.posicion + 1) == T_IDENTIFICADOR:
        es_en = 0
        inseguro:
            asm("{ struct LexerBuffers* _lb_en = (struct LexerBuffers*)lexer_buffers();")
            asm("  int _p2_en = est->posicion + 1;")
            asm("  if (_lb_en && _p2_en >= 0 && _p2_en < _lb_en->ntks) {")
            asm("      CadenaSegura _v_en = ((struct TokenLex*)_lb_en->tokens)[_p2_en].valor;")
            asm("      es_en = (_v_en.longitud == 2 && _v_en.datos && _v_en.datos[0] == 'e' && _v_en.datos[1] == 'n') ? 1 : 0; }")
            asm("}")
        si es_en == 1:
            token_avanzar(est) // consume la variable
            token_avanzar(est) // consume 'en'
            nodo_en = parser_nuevo_nodo(est, NODO_PARA_EN, linea, col)
            nodo_guardar_token(est, nodo_en, est.posicion - 2)
            iterable = parsear_expresion(est)
            inseguro:
                asm("est->nodos[nodo_en].hijo_der = iterable")
            si token_esperar(est, T_DOSPUNTOS) == 0:
                retornar 0
            primero_en = 0
            ultimo_en = 0
            si token_mirar(est) == T_NUEVALINEA:
                token_avanzar(est)
                mientras token_mirar(est) == T_NUEVALINEA:
                    token_avanzar(est)
                si token_mirar(est) == T_INDENTAR:
                    token_avanzar(est)
                    ren = 1
                    mientras ren == 1:
                        t_en = token_mirar(est)
                        si t_en == T_NUEVALINEA:
                            token_avanzar(est)
                            siguiente
                        si t_en == T_DESINDENTAR:
                            token_avanzar(est)
                            ren = 0
                            romper
                        si t_en == T_FIN:
                            ren = 0
                            romper
                        stmt_en = parsear_sentencia(est)
                        si stmt_en != 0:
                            si primero_en == 0:
                                primero_en = stmt_en
                            sino:
                                inseguro:
                                    asm("est->nodos[ultimo_en].hermano = stmt_en")
                            ultimo_en = stmt_en
                        sino:
                            token_avanzar(est)
                        siguiente
            sino:
                // cuerpo inline: 'para x en l: stmt'
                stmt_en = parsear_sentencia(est)
                si stmt_en != 0:
                    primero_en = stmt_en
                    ultimo_en = stmt_en
            si primero_en > 0:
                inseguro:
                    asm("est->nodos[nodo_en].hijo_izq = primero_en")
            retornar nodo_en
    nodo = parser_nuevo_nodo(est, NODO_PARA, linea, col)
    pos_var = est.posicion
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    inicializacion = parsear_expresion(est)
    // FASE A (A3.0): payload de la variable de bucle 64-bit-safe (antes
    // token_ptr_valor truncaba a 32 bits)
    nodo_guardar_token(est, nodo, pos_var)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = inicializacion")
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    condicion = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_der = condicion")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'para ...: stmt' (paridad _P_* T_PARA).
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].ptr_extra = primero")
    retornar nodo

funcion parsear_retornar(est: ParserEst) -> entero:
    si token_esperar(est, T_RETORNAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_RETORNAR, linea, col)
    t = token_mirar(est)
    si t != T_NUEVALINEA:
        si t != T_DESINDENTAR:
            si t != T_FIN:
                expr = parsear_expresion(est)
                inseguro:
                    asm("est->nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_lanzar(est: ParserEst) -> entero:
    si token_esperar(est, T_LANZAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_LANZAR, linea, col)
    expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_escuchar(est: ParserEst) -> entero:
    si token_esperar(est, T_ESCUCHAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ESCUCHAR, linea, col)
    // F3-7 (Manual 2 L113): escuchar_canal ::= "escuchar" expresion ":"
    // NEWLINE INDENT bloque DEDENT. La forma antigua `escuchar canal ->
    // callback` NO existe en el manual y se elimina; el bloque recibe con
    // `canal ->` (Manual 5 §4.2) y el generador emite el listener.
    canal_expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = canal_expr")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    token_avanzar(est)
                siguiente
        sino:
            // Anti-cuelgue: bloque vacio tras ':' sin INDENTAR
            retornar nodo
    sino:
        // cuerpo inline: 'escuchar ch: stmt' en una sola linea
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero")
    retornar nodo

funcion parsear_asignacion(est: ParserEst) -> entero:
    t = token_mirar(est)
    si token_es_nombre(t) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    // FASE A (A3.0): payload del nombre (AsignacionVariable.nombre)
    pos_nombre = est.posicion
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    nodo = parser_nuevo_nodo(est, NODO_ASIGNACION, linea, col)
    nodo_guardar_token(est, nodo, pos_nombre)
    si token_es_nombre(token_mirar(est)) == 1 y token_tipo(est, est.posicion + 1) == T_FLECHA:
        expr = parsear_recibir_canal(est)
    sino:
        expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_der = expr")
    retornar nodo

funcion parsear_asm(est: ParserEst) -> entero:
    si token_esperar(est, T_ASM) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ASM, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    si token_mirar(est) == T_CADENA:
        // FASE A (A3.0): payload 64-bit-safe (antes token_ptr_valor truncaba)
        pos_asm = est.posicion
        token_avanzar(est)
        nodo_guardar_token(est, nodo, pos_asm)
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    retornar nodo

funcion parsear_inseguro(est: ParserEst) -> entero:
    si token_esperar(est, T_INSEGURO) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_INSEGURO, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    // FASE A (A3.1): el cuerpo se ENLAZA (primero en hijo_izq, cadena hermano) —
    // antes se parseaba y se DESCARTABA (BloqueInseguro.cuerpo del puente vacio;
    // paridad _P_* cpo en _P_sentencia T_INSEGURO).
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1)
                    token_avanzar(est)
                siguiente
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_izq = primero")
    retornar nodo

funcion parsear_coincidir(est: ParserEst) -> entero:
    // R11 (deuda FASE_2_2.4_NATIVA.md): cablear NodoCoincidir en el pipeline
    // nativo (parser -> puente -> flatten F8 -> analizador -> generador).
    // Antes el parser plano creaba NODO_CASO vacios (sin patron, sin cuerpo
    // enlazado) y no encadenaba los casos al NODO_COINCIDIR: el puente no
    // producia el nodo tipado (deuda del puente A3.1) y la validacion de
    // exhaustividad nativa (ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED, Manual 2 S2.4)
    // quedaba INERTE. Ahora: (1) el patron se guarda como span en el payload
    // primario del NODO_CASO ("ok(valor)", "ninguno" o "_"); (2) el cuerpo
    // del caso se enlaza en hijo_izq del caso (cadena hermano); (3) los casos
    // se encadenan desde hijo_der del NODO_COINCIDIR (puente_lista ->
    // SentenciaCoincidir.casos).
    si token_esperar(est, T_COINCIDIR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_COINCIDIR, linea, col)
    pos_sujeto_ini = est.posicion
    expr = parsear_expresion(est)
    // cumple Manual 5 §3.6 (H-R184-1, ME r188_deuda_cero_1): la forma
    // canónica del cierre es `coincidir c ->:` — la flecha marca la
    // recepción de canal y es OPCIONAL ante el ':' que abre el bloque de
    // casos (el `coincidir c:` histórico sigue siendo válido). Paridad
    // con compilador/parser_control.py:_parsear_coincidir (ARROW posible).
    // cumple Manual 5 §3.6 (ME r188b): caso_coincidir — "coincidir co ->:";
    // la flecha marca el receive. El sujeto identificador de un token se
    // re-embraga como NODO_RECIBIR_CANAL (span del token sujeto, paridad con
    // parsear_recibir_canal: el puente construye
    // ExprRecibirCanal{canal=Identificador(nx)}); el resto de la paridad de
    // r188b (typedef/instancia Resultado<E,T> + binding .dato/E/err) vive en
    // generador/nodos_flujo.syn:gen_visitar_coincidir e
    // generador/expr_eval.syn (H-R188-2). El `coincidir c:` historico sigue.
    si token_mirar(est) == T_FLECHA:
        token_avanzar(est)
        sujeto_un_token = 0
        si est.posicion == pos_sujeto_ini + 2:
            sujeto_un_token = 1
        si sujeto_un_token == 1:
            nodo_recv = parser_nuevo_nodo(est, NODO_RECIBIR_CANAL, linea, col)
            nodo_guardar_token(est, nodo_recv, pos_sujeto_ini)
            inseguro:
                asm("est->nodos[nodo].hijo_izq = nodo_recv")
        sino:
            inseguro:
                asm("est->nodos[nodo].hijo_izq = expr")
    sino:
        inseguro:
            asm("est->nodos[nodo].hijo_izq = expr")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primer_caso = 0
    ultimo_caso = 0
    caso_parseado = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                // cumple Manual 3 §3 (ME r180_coincidir_nativo R1): patron ::=
                // IDENTIFICADOR "(" IDENTIFICADOR ")" | IDENTIFICADOR | "_" |
                // numero — la entrada del caso usa token_es_inicio_patron:
                // `1 =>` ya no se descarta por el anti-cuelgue (antes
                // token_es_nombre(T_NUMERO)==0 soltaba el caso y corrompia el
                // bucle; probe TDD rc=8 en stage2). El wildcard `_` ya entraba
                // (lexea como T_IDENTIFICADOR).
                si token_es_inicio_patron(t) == 1:
                    linea_c = token_linea(est, est.posicion)
                    col_c = token_columna(est, est.posicion)
                    // R11: capturar el SPAN del patron antes de consumirlo
                    // (paridad _P_*: el patron del caso incluye tag + (var)).
                    pos_pat_ini = est.posicion
                    token_avanzar(est)
                    nodo_caso = parser_nuevo_nodo(est, NODO_CASO, linea_c, col_c)
                    pos_pat_fin = pos_pat_ini
                    si token_mirar(est) == T_PAREN_IZQ:
                        token_avanzar(est)
                        si token_es_nombre(token_mirar(est)) == 1:
                            token_avanzar(est)
                        si token_esperar(est, T_PAREN_DER) == 0:
                            retornar 0
                        pos_pat_fin = est.posicion - 1
                    nodo_guardar_span(est, nodo_caso, pos_pat_ini, pos_pat_fin, 1)
                    si token_esperar(est, T_FLECHA_DER) == 0:
                        retornar 0
                    // R22 (Manual 2 L124 / Manual 3 L140): caso_coincidir ::=
                    // patron "=>" ( sentencia | NEWLINE INDENT bloque DEDENT ).
                    // El cuerpo del caso puede ser un BLOQUE indentado en la
                    // linea siguiente (ej. MANUAL 5 §7: ok(valor) => + bloque);
                    // antes solo se aceptaba la forma de una linea y un
                    // coincidir anidado en el cuerpo daba rc=8 (probe R20 p3).
                    primero_cuerpo = 0
                    ultimo_cuerpo = 0
                    si token_mirar(est) == T_NUEVALINEA:
                        token_avanzar(est)
                        // R22: saltar TODAS las NL (lineas vacias/comentarios)
                        // antes del INDENTAR del bloque (paridad A4.5).
                        mientras token_mirar(est) == T_NUEVALINEA:
                            token_avanzar(est)
                        si token_mirar(est) == T_INDENTAR:
                            token_avanzar(est)
                            r22a = 1
                            mientras r22a == 1:
                                t = token_mirar(est)
                                si t == T_NUEVALINEA:
                                    token_avanzar(est)
                                    siguiente
                                si t == T_DESINDENTAR:
                                    token_avanzar(est)
                                    r22a = 0
                                    romper
                                si t == T_FIN:
                                    r22a = 0
                                    romper
                                stmt = parsear_sentencia(est)
                                si stmt != 0:
                                    si primero_cuerpo == 0:
                                        primero_cuerpo = stmt
                                    sino:
                                        inseguro:
                                            asm("est->nodos[ultimo_cuerpo].hermano = stmt")
                                    ultimo_cuerpo = stmt
                                sino:
                                    // Anti-cuelgue (paridad A3.1)
                                    token_avanzar(est)
                                siguiente
                    sino:
                        // R22: forma de una linea — termina en NL/DESINDENTAR o
                        // en el borde del siguiente caso (columna del patron).
                        // Sin el guard, un coincidir anidado de una linea se
                        // tragaba el caso siguiente (AST corrupto: 'Nodo tipo
                        // DefinicionFuncion no reconocido' en el generador).
                        // NOTA (revision code-reviewer): el guard de columna es
                        // una HEURISTICA de indentacion (los bloques anidados
                        // consumen su propio DESINDENTAR, asi que el borde del
                        // caso siguiente se detecta por columna) — asume
                        // columnas consistentes (espacios); con tabs mixtos la
                        // comparacion podria enganar (documentado, reporte §25).
                        r22b = 1
                        mientras r22b == 1:
                            t = token_mirar(est)
                            si t == T_NUEVALINEA:
                                r22b = 0
                                romper
                            si t == T_DESINDENTAR:
                                r22b = 0
                                romper
                            si t == T_FIN:
                                r22b = 0
                                romper
                            si col_c > 0:
                                si token_columna(est, est.posicion) <= col_c:
                                    r22b = 0
                                    romper
                            stmt = parsear_sentencia(est)
                            si stmt != 0:
                                si primero_cuerpo == 0:
                                    primero_cuerpo = stmt
                                sino:
                                    inseguro:
                                        asm("est->nodos[ultimo_cuerpo].hermano = stmt")
                                ultimo_cuerpo = stmt
                            sino:
                                // Anti-cuelgue (paridad A3.1)
                                token_avanzar(est)
                            siguiente
                    si primero_cuerpo > 0:
                        inseguro:
                            asm("est->nodos[nodo_caso].hijo_izq = primero_cuerpo")
                    // R11: encadenar los casos (primero en hijo_der del
                    // NODO_COINCIDIR, cadena hermano — puente puente_lista(hd)).
                    si primer_caso == 0:
                        primer_caso = nodo_caso
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo_caso].hermano = nodo_caso")
                    ultimo_caso = nodo_caso
                    // cumple Manual 3 §3 (ME r183_coincidir_bloque_nativo R1):
                    // cumple Manual 2 §1.3: los comentarios de este cambio usan
                    // el estilo de linea // de M2 §1.3 (los comentarios de línea
                    // comienzan con // y se extienden hasta el final de la línea).
                    // la iteracion produjo un caso COMPLETO (patron + flecha +
                    // cuerpo + encadenado): el cursor ya esta en el token real
                    // siguiente (patron del caso siguiente o DESINDENTAR que
                    // cierra el bloque de casos).
                    caso_parseado = 1
                si caso_parseado == 0:
                    // R11 anti-cuelgue (paridad A3.1): si la iteracion NO
                    // produjo caso y el token no es nombre, no es un patron
                    // valido — avanzar para no entrar en bucle infinito en el
                    // while de casos. H-R180-1: tras un caso parseado el
                    // anti-cuelgue NO corre (se comia el DESINDENTAR que
                    // cierra el bloque de casos y el bucle externo se comia
                    // el cierre del cuerpo de la funcion — `funcion` quedaba
                    // expuesto como def anidada, rc=1 'Nodo tipo
                    // [DefinicionFuncion] no reconocido' — o el patron
                    // numerico del caso siguiente,
                    // token_es_nombre(T_NUMERO)==0, rc=8).
                    si token_es_nombre(token_mirar(est)) != 1:
                        token_avanzar(est)
                caso_parseado = 0
                siguiente
    si primer_caso > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primer_caso")
    retornar nodo
