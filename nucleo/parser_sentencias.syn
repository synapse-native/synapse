#lang: es

// R29 (regla 13, modularizacion): sentencias de control de flujo extraidas de
// nucleo/parser.syn (1,511 lineas -> parser.syn 486 + sentencias 553 +
// declaraciones 420 + canales 52). Diagnostico FASE A (2026-08-07): parser.syn
// era el cajon de sastre del frontend nativo (30 funciones top-level) pese a
// existir parser_base/expr/stmt/constantes. Mecanico: texto identico, sin
// cambios de logica; el emisor S1 ordena funciones/estructuras alfabeticamente
// (Manual 8 §8.2) -> C byte-identico verificado por bootstrap.
// ------------------------------------------------------------
funcion parsear_si(est: ParserEst) -> entero:
    stmt = 0
    r = 1
    si token_esperar(est, T_SI) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_SI, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero_si = 0
    ultimo_si = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero_si == 0:
                        primero_si = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo_si].hermano = stmt")
                    ultimo_si = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'si cond: stmt' en una sola linea
        // (paridad _P_si del espejo: 'else { _P_sentencia(); }'). Antes solo
        // se manejaba NUEVALINEA+INDENTAR y el inline quedaba como sentencia
        // hermana — 'si idx == 0: retornar "tensor"' dejaba el retornar FUERA
        // del if (55 usos solo en analizador_semantico.syn -> divergencia S3).
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero_si = stmt
            ultimo_si = stmt
    si primero_si > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero_si")
    // FASE A (A3.1): el cuerpo del sino se ENLAZA (primero en NODO_SI.ptr_extra,
    // cadena hermano) — antes se parseaba y se DESCARTABA (SentenciaSi.cuerpo_sino
    // del puente estaria vacio; paridad _P_* cuerpo_sino en _P_sentencia).
    r = 1
    primero_sino = 0
    ultimo_sino = 0
    si token_mirar(est) == T_SINO:
        token_avanzar(est)
        si token_esperar(est, T_DOSPUNTOS) == 0:
            retornar 0
        si token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
            mientras token_mirar(est) == T_NUEVALINEA:
                token_avanzar(est)
            si token_mirar(est) == T_INDENTAR:
                token_avanzar(est)
                mientras r == 1:
                    t = token_mirar(est)
                    si t == T_NUEVALINEA:
                        token_avanzar(est)
                        siguiente
                    si t == T_DESINDENTAR:
                        token_avanzar(est)
                        r = 0
                        romper
                    si t == T_FIN:
                        r = 0
                        romper
                    stmt = parsear_sentencia(est)
                    si stmt != 0:
                        si primero_sino == 0:
                            primero_sino = stmt
                        sino:
                            inseguro:
                                asm("est->nodos[ultimo_sino].hermano = stmt")
                        ultimo_sino = stmt
                    sino:
                        // Anti-cuelgue (paridad A3.1)
                        token_avanzar(est)
                    siguiente
        sino:
            // FASE A (A4.5): cuerpo inline del sino (paridad _P_si).
            stmt = parsear_sentencia(est)
            si stmt != 0:
                primero_sino = stmt
                ultimo_sino = stmt
    si primero_sino > 0:
        inseguro:
            asm("est->nodos[nodo].ptr_extra = primero_sino")
    retornar nodo

funcion parsear_mientras(est: ParserEst) -> entero:
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_MIENTRAS, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'mientras cond: stmt' (paridad _P_*
        // T_WHILE: 'else { _P_sentencia(); }').
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero")
    retornar nodo

funcion parsear_para(est: ParserEst) -> entero:
    // Synapse-style: para Identificador = Expresion mientras Expresion: (Manual 2 §2.2)
    // Ej: para i = 0 mientras i < 10:
    si token_esperar(est, T_PARA) == 0:
        retornar 0
    si token_es_nombre(token_mirar(est)) == 0:
        parser_error(est, "Se esperaba variable de bucle para", token_linea(est, est.posicion), token_columna(est, est.posicion))
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_PARA, linea, col)
    pos_var = est.posicion
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    inicializacion = parsear_expresion(est)
    // FASE A (A3.0): payload de la variable de bucle 64-bit-safe (antes
    // token_ptr_valor truncaba a 32 bits)
    nodo_guardar_token(est, nodo, pos_var)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = inicializacion")
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    condicion = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_der = condicion")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1): avanza si el token no produce sentencia
                    token_avanzar(est)
                siguiente
    sino:
        // FASE A (A4.5): cuerpo inline 'para ...: stmt' (paridad _P_* T_PARA).
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].ptr_extra = primero")
    retornar nodo

funcion parsear_retornar(est: ParserEst) -> entero:
    si token_esperar(est, T_RETORNAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_RETORNAR, linea, col)
    t = token_mirar(est)
    si t != T_NUEVALINEA:
        si t != T_DESINDENTAR:
            si t != T_FIN:
                expr = parsear_expresion(est)
                inseguro:
                    asm("est->nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_lanzar(est: ParserEst) -> entero:
    si token_esperar(est, T_LANZAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_LANZAR, linea, col)
    expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_escuchar(est: ParserEst) -> entero:
    si token_esperar(est, T_ESCUCHAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ESCUCHAR, linea, col)
    // F3-7 (Manual 2 L113): escuchar_canal ::= "escuchar" expresion ":"
    // NEWLINE INDENT bloque DEDENT. La forma antigua `escuchar canal ->
    // callback` NO existe en el manual y se elimina; el bloque recibe con
    // `canal ->` (Manual 5 §4.2) y el generador emite el listener.
    canal_expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = canal_expr")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    token_avanzar(est)
                siguiente
        sino:
            // Anti-cuelgue: bloque vacio tras ':' sin INDENTAR
            retornar nodo
    sino:
        // cuerpo inline: 'escuchar ch: stmt' en una sola linea
        stmt = parsear_sentencia(est)
        si stmt != 0:
            primero = stmt
            ultimo = stmt
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primero")
    retornar nodo

funcion parsear_asignacion(est: ParserEst) -> entero:
    t = token_mirar(est)
    si token_es_nombre(t) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    // FASE A (A3.0): payload del nombre (AsignacionVariable.nombre)
    pos_nombre = est.posicion
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    nodo = parser_nuevo_nodo(est, NODO_ASIGNACION, linea, col)
    nodo_guardar_token(est, nodo, pos_nombre)
    si token_es_nombre(token_mirar(est)) == 1 y token_tipo(est, est.posicion + 1) == T_FLECHA:
        expr = parsear_recibir_canal(est)
    sino:
        expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_der = expr")
    retornar nodo

funcion parsear_asm(est: ParserEst) -> entero:
    si token_esperar(est, T_ASM) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ASM, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    si token_mirar(est) == T_CADENA:
        // FASE A (A3.0): payload 64-bit-safe (antes token_ptr_valor truncaba)
        pos_asm = est.posicion
        token_avanzar(est)
        nodo_guardar_token(est, nodo, pos_asm)
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    retornar nodo

funcion parsear_inseguro(est: ParserEst) -> entero:
    si token_esperar(est, T_INSEGURO) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_INSEGURO, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    // FASE A (A3.1): el cuerpo se ENLAZA (primero en hijo_izq, cadena hermano) —
    // antes se parseaba y se DESCARTABA (BloqueInseguro.cuerpo del puente vacio;
    // paridad _P_* cpo en _P_sentencia T_INSEGURO).
    primero = 0
    ultimo = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                si stmt != 0:
                    si primero == 0:
                        primero = stmt
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo].hermano = stmt")
                    ultimo = stmt
                sino:
                    // Anti-cuelgue (paridad A3.1)
                    token_avanzar(est)
                siguiente
    si primero > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_izq = primero")
    retornar nodo

funcion parsear_coincidir(est: ParserEst) -> entero:
    // R11 (deuda FASE_2_2.4_NATIVA.md): cablear NodoCoincidir en el pipeline
    // nativo (parser -> puente -> flatten F8 -> analizador -> generador).
    // Antes el parser plano creaba NODO_CASO vacios (sin patron, sin cuerpo
    // enlazado) y no encadenaba los casos al NODO_COINCIDIR: el puente no
    // producia el nodo tipado (deuda del puente A3.1) y la validacion de
    // exhaustividad nativa (ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED, Manual 2 S2.4)
    // quedaba INERTE. Ahora: (1) el patron se guarda como span en el payload
    // primario del NODO_CASO ("ok(valor)", "ninguno" o "_"); (2) el cuerpo
    // del caso se enlaza en hijo_izq del caso (cadena hermano); (3) los casos
    // se encadenan desde hijo_der del NODO_COINCIDIR (puente_lista ->
    // SentenciaCoincidir.casos).
    si token_esperar(est, T_COINCIDIR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_COINCIDIR, linea, col)
    expr = parsear_expresion(est)
    inseguro:
        asm("est->nodos[nodo].hijo_izq = expr")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    primer_caso = 0
    ultimo_caso = 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        // FASE A (A4.5): paridad con _P_bloque — se saltan TODAS las NL
        // consecutivas (lineas vacias y comentarios) antes del INDENTAR.
        // Antes se saltaba solo una: un bloque tras ':' con comentarios
        // internos dejaba el INDENTAR huerfano y el parser entraba en bucle.
        mientras token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                si token_es_nombre(t) == 1:
                    linea_c = token_linea(est, est.posicion)
                    col_c = token_columna(est, est.posicion)
                    // R11: capturar el SPAN del patron antes de consumirlo
                    // (paridad _P_*: el patron del caso incluye tag + (var)).
                    pos_pat_ini = est.posicion
                    token_avanzar(est)
                    nodo_caso = parser_nuevo_nodo(est, NODO_CASO, linea_c, col_c)
                    pos_pat_fin = pos_pat_ini
                    si token_mirar(est) == T_PAREN_IZQ:
                        token_avanzar(est)
                        si token_es_nombre(token_mirar(est)) == 1:
                            token_avanzar(est)
                        si token_esperar(est, T_PAREN_DER) == 0:
                            retornar 0
                        pos_pat_fin = est.posicion - 1
                    nodo_guardar_span(est, nodo_caso, pos_pat_ini, pos_pat_fin, 1)
                    si token_esperar(est, T_FLECHA_DER) == 0:
                        retornar 0
                    // R22 (Manual 2 L124 / Manual 3 L140): caso_coincidir ::=
                    // patron "=>" ( sentencia | NEWLINE INDENT bloque DEDENT ).
                    // El cuerpo del caso puede ser un BLOQUE indentado en la
                    // linea siguiente (ej. MANUAL 5 §7: ok(valor) => + bloque);
                    // antes solo se aceptaba la forma de una linea y un
                    // coincidir anidado en el cuerpo daba rc=8 (probe R20 p3).
                    primero_cuerpo = 0
                    ultimo_cuerpo = 0
                    si token_mirar(est) == T_NUEVALINEA:
                        token_avanzar(est)
                        // R22: saltar TODAS las NL (lineas vacias/comentarios)
                        // antes del INDENTAR del bloque (paridad A4.5).
                        mientras token_mirar(est) == T_NUEVALINEA:
                            token_avanzar(est)
                        si token_mirar(est) == T_INDENTAR:
                            token_avanzar(est)
                            r22a = 1
                            mientras r22a == 1:
                                t = token_mirar(est)
                                si t == T_NUEVALINEA:
                                    token_avanzar(est)
                                    siguiente
                                si t == T_DESINDENTAR:
                                    token_avanzar(est)
                                    r22a = 0
                                    romper
                                si t == T_FIN:
                                    r22a = 0
                                    romper
                                stmt = parsear_sentencia(est)
                                si stmt != 0:
                                    si primero_cuerpo == 0:
                                        primero_cuerpo = stmt
                                    sino:
                                        inseguro:
                                            asm("est->nodos[ultimo_cuerpo].hermano = stmt")
                                    ultimo_cuerpo = stmt
                                sino:
                                    // Anti-cuelgue (paridad A3.1)
                                    token_avanzar(est)
                                siguiente
                    sino:
                        // R22: forma de una linea — termina en NL/DESINDENTAR o
                        // en el borde del siguiente caso (columna del patron).
                        // Sin el guard, un coincidir anidado de una linea se
                        // tragaba el caso siguiente (AST corrupto: 'Nodo tipo
                        // DefinicionFuncion no reconocido' en el generador).
                        // NOTA (revision code-reviewer): el guard de columna es
                        // una HEURISTICA de indentacion (los bloques anidados
                        // consumen su propio DESINDENTAR, asi que el borde del
                        // caso siguiente se detecta por columna) — asume
                        // columnas consistentes (espacios); con tabs mixtos la
                        // comparacion podria enganar (documentado, reporte §25).
                        r22b = 1
                        mientras r22b == 1:
                            t = token_mirar(est)
                            si t == T_NUEVALINEA:
                                r22b = 0
                                romper
                            si t == T_DESINDENTAR:
                                r22b = 0
                                romper
                            si t == T_FIN:
                                r22b = 0
                                romper
                            si col_c > 0:
                                si token_columna(est, est.posicion) <= col_c:
                                    r22b = 0
                                    romper
                            stmt = parsear_sentencia(est)
                            si stmt != 0:
                                si primero_cuerpo == 0:
                                    primero_cuerpo = stmt
                                sino:
                                    inseguro:
                                        asm("est->nodos[ultimo_cuerpo].hermano = stmt")
                                ultimo_cuerpo = stmt
                            sino:
                                // Anti-cuelgue (paridad A3.1)
                                token_avanzar(est)
                            siguiente
                    si primero_cuerpo > 0:
                        inseguro:
                            asm("est->nodos[nodo_caso].hijo_izq = primero_cuerpo")
                    // R11: encadenar los casos (primero en hijo_der del
                    // NODO_COINCIDIR, cadena hermano — puente puente_lista(hd)).
                    si primer_caso == 0:
                        primer_caso = nodo_caso
                    sino:
                        inseguro:
                            asm("est->nodos[ultimo_caso].hermano = nodo_caso")
                    ultimo_caso = nodo_caso
                si token_es_nombre(token_mirar(est)) != 1:
                    // R11 anti-cuelgue (paridad A3.1): si el token no es nombre
                    // no es un patron valido (ej. literal '1 =>') — avanzar para
                    // no entrar en bucle infinito en el while de casos.
                    token_avanzar(est)
                siguiente
    si primer_caso > 0:
        inseguro:
            asm("est->nodos[nodo].hijo_der = primer_caso")
    retornar nodo

