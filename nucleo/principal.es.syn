            izq = nodo
            siguiente
        si t == T_MOD:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_unario(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        r = 0
    retornar izq
funcion parsear_unario(est: ParserEst) -> entero:
    linea = 0
    col = 0
    expr = 0
    nodo = 0
    t = token_mirar(est)
    si t == T_MENOS:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_UNARIA, linea, col)
        retornar nodo
    si t == T_NO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_UNARIA, linea, col)
        retornar nodo
    si t == T_AMPERSAND:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_PUNTERO, linea, col)
        retornar nodo
    si t == T_POR:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        expr = parsear_unario(est)
        nodo = parser_nuevo_nodo(est, NODO_DEREF, linea, col)
        retornar nodo
    retornar parsear_primario(est)
funcion parsear_primario(est: ParserEst) -> entero:
    linea = 0
    col = 0
    nodo = 0
    t = token_mirar(est)
    si t == T_NUMERO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_NUMERO, linea, col)
        retornar nodo
    si t == T_FLOTANTE:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_DECIMAL, linea, col)
        retornar nodo
    si t == T_CADENA:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_CADENA_LIT, linea, col)
        retornar nodo
    si t == T_VERDADERO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_BOOLEANO, linea, col)
        retornar nodo
    si t == T_FALSO:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_BOOLEANO, linea, col)
        retornar nodo
    si t == T_IDENTIFICADOR:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_IDENTIFICADOR, linea, col)
        t2 = token_mirar(est)
        si t2 == T_PAREN_IZQ:
            token_esperar(est, T_PAREN_IZQ)
            r = 1
            mientras r == 1:
                si token_mirar(est) == T_PAREN_DER:
                    romper
                arg = parsear_expresion(est)
                si token_mirar(est) == T_COMA:
                    token_avanzar(est)
                    siguiente
                r = 1
            token_esperar(est, T_PAREN_DER)
        si t2 == T_PUNTO:
            si token_mirar(est) == T_PUNTO:
                token_avanzar(est)
                tok_campo = token_mirar(est)
                linea2 = token_linea(est, est.posicion)
                col2 = token_columna(est, est.posicion)
                si tok_campo == T_IDENTIFICADOR:
                    token_avanzar(est)
                    nodo2 = parser_nuevo_nodo(est, NODO_ACCESO_CAMPO, linea2, col2)
                    nodo = nodo2
        retornar nodo
    si t == T_PAREN_IZQ:
        token_avanzar(est)
        expr = parsear_expresion(est)
        token_esperar(est, T_PAREN_DER)
        retornar expr
    parser_error(est, "Expresion inesperada", token_linea(est, est.posicion), token_columna(est, est.posicion))
    retornar 0
funcion parsear_sentencia(est: ParserEst) -> entero:
    linea = 0
    col = 0
    nodo = 0
    t = token_mirar(est)
    si t == T_FUNCION:
        retornar parsear_funcion(est)
    si t == T_ESTRUCTURA:
        retornar parsear_estructura_def(est)
    si t == T_IF:
        retornar parsear_si(est)
    si t == T_MIENTRAS:
        retornar parsear_mientras(est)
    si t == T_PARA:
        retornar parsear_para(est)
    si t == T_RETORNAR:
        retornar parsear_retornar(est)
    si t == T_LANZAR:
        retornar parsear_lanzar(est)
    si t == T_ESCUCHAR:
        retornar parsear_escuchar(est)
    si t == T_ROMPER:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        retornar parser_nuevo_nodo(est, NODO_ROMPER, linea, col)
    si t == T_SIGUIENTE:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        retornar parser_nuevo_nodo(est, NODO_SIGUIENTE, linea, col)
    si t == T_IMPORTAR:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        token_avanzar(est)
        nodo = parser_nuevo_nodo(est, NODO_IMPORTAR, linea, col)
        retornar nodo
    si t == T_ESTRUCTURA:
        retornar parsear_estructura_def(est)
    si t == T_CONSTANTE:
        retornar parsear_constante(est)
    si t == T_ASM:
        retornar parsear_asm(est)
    si t == T_INSEGURO:
        retornar parsear_inseguro(est)
    si t == T_IMPORTAR_C:
        retornar parsear_importar_c(est)
    si t == T_EXTERNO:
        retornar parsear_externo(est)
    si t == T_COINCIDIR:
        retornar parsear_coincidir(est)
    si t == T_INDENTAR:
        retornar 0
    si t == T_DESINDENTAR:
        retornar 0
    si t == T_NUEVALINEA:
        retornar 0
    si t == T_FIN:
        retornar 0
    si t == T_IDENTIFICADOR:
        t2 = token_mirar(est)
        si t2 == T_ASIGNAR:
            retornar parsear_asignacion(est)
        si t2 == T_FLECHA_IZQ:
            retornar parsear_enviar_canal(est)
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        expr = parsear_expresion(est)
        t3 = token_mirar(est)
        si t3 == T_RECUPERAR:
            token_avanzar(est)
            token_esperar(est, T_DOSPUNTOS)
            plan_b = parsear_expresion(est)
            retornar expr
        nodo = parser_nuevo_nodo(est, NODO_EXPR, linea, col)
        retornar nodo
    retornar 0
funcion parsear_funcion(est: ParserEst) -> entero:
    r2 = 0
    expr = 0
    r = 0
    si token_esperar(est, T_FUNCION) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        parser_error(est, "Se esperaba nombre de funcion", token_linea(est, est.posicion), token_columna(est, est.posicion))
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo_func = parser_nuevo_nodo(est, NODO_FUNCION, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    ultimo_param = 0
    si token_mirar(est) != T_PAREN_DER:
        r = 1
        mientras r == 1:
            linea_p = token_linea(est, est.posicion)
            col_p = token_columna(est, est.posicion)
            si token_mirar(est) == T_IDENTIFICADOR:
                token_avanzar(est)
                si token_esperar(est, T_DOSPUNTOS) == 0:
                    retornar 0
                si token_mirar(est) == T_IDENTIFICADOR:
                    token_avanzar(est)
                    nodo_p = parser_nuevo_nodo(est, NODO_PARAMETRO, linea_p, col_p)
                    si token_mirar(est) == T_COMA:
                        token_avanzar(est)
                        siguiente
                    sino:
                        r = 0
                sino:
                    r = 0
            sino:
                r = 0
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_NUEVALINEA:
            token_avanzar(est)
            siguiente
        si t == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_REQUIERE:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    r2 = 1
                    mientras r2 == 1:
                        t = token_mirar(est)
                        si t == T_NUEVALINEA:
                            token_avanzar(est)
                            siguiente
                        si t == T_INDENTAR:
                            token_avanzar(est)
                            mientras r2 == 1:
                                t = token_mirar(est)
                                si t == T_NUEVALINEA:
                                    token_avanzar(est)
                                    siguiente
                                si t == T_DESINDENTAR:
                                    token_avanzar(est)
                                    r2 = 0
                                    romper
                                expr = parsear_expresion(est)
                                siguiente
                        sino:
                            r2 = 0
                    siguiente
                si t == T_GARANTIZA:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    r2 = 1
                    mientras r2 == 1:
                        t = token_mirar(est)
                        si t == T_NUEVALINEA:
                            token_avanzar(est)
                            siguiente
                        si t == T_INDENTAR:
                            token_avanzar(est)
                            mientras r2 == 1:
                                t = token_mirar(est)
                                si t == T_NUEVALINEA:
                                    token_avanzar(est)
                                    siguiente
                                si t == T_DESINDENTAR:
                                    token_avanzar(est)
                                    r2 = 0
                                    romper
                                expr = parsear_expresion(est)
                                siguiente
                        sino:
                            r2 = 0
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                r = 0
        sino:
            r = 0
    si token_mirar(est) == T_INDENTAR:
        token_avanzar(est)
        mientras r == 1:
            t = token_mirar(est)
            si t == T_DESINDENTAR:
                token_avanzar(est)
                r = 0
                romper
            si t == T_FIN:
                r = 0
                romper
            stmt = parsear_sentencia(est)
            siguiente
    retornar nodo_func
funcion parsear_si(est: ParserEst) -> entero:
    t = 0
    stmt = 0
    r = 1
    si token_esperar(est, T_IF) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_SI, linea, col)
    cond = parsear_expresion(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    r = 1
    si token_mirar(est) == T_ELSE:
        token_avanzar(est)
        si token_esperar(est, T_DOSPUNTOS) == 0:
            retornar 0
        si token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
            si token_mirar(est) == T_INDENTAR:
                token_avanzar(est)
                mientras r == 1:
                    t = token_mirar(est)
                    si t == T_DESINDENTAR:
                        token_avanzar(est)
                        r = 0
                        romper
                    si t == T_FIN:
                        r = 0
                        romper
                    stmt = parsear_sentencia(est)
                    siguiente
    retornar nodo
funcion parsear_mientras(est: ParserEst) -> entero:
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_MIENTRAS, linea, col)
    cond = parsear_expresion(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo
funcion parsear_para(est: ParserEst) -> entero:
    si token_esperar(est, T_PARA) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_VACIO, linea, col)
    parsear_asignacion(est)
    si token_esperar(est, T_PUNTOCOMA) == 0:
        retornar 0
    parsear_expresion(est)
    si token_esperar(est, T_PUNTOCOMA) == 0:
        retornar 0
    parsear_asignacion(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo
funcion parsear_retornar(est: ParserEst) -> entero:
    si token_esperar(est, T_RETORNAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_RETORNAR, linea, col)
    t = token_mirar(est)
    si t != T_NUEVALINEA:
        si t != T_DESINDENTAR:
            si t != T_FIN:
                expr = parsear_expresion(est)
    retornar nodo
funcion parsear_lanzar(est: ParserEst) -> entero:
    si token_esperar(est, T_LANZAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_LANZAR, linea, col)
    expr = parsear_expresion(est)
    retornar nodo
funcion parsear_escuchar(est: ParserEst) -> entero:
    si token_esperar(est, T_ESCUCHAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ESCUCHAR, linea, col)
    parsear_expresion(est)
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    expr = parsear_expresion(est)
    retornar nodo
funcion parsear_asignacion(est: ParserEst) -> entero:
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    nodo = parser_nuevo_nodo(est, NODO_ASIGNACION, linea, col)
    expr = parsear_expresion(est)
    retornar nodo
funcion parsear_estructura_def(est: ParserEst) -> entero:
    si token_esperar(est, T_ESTRUCTURA) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_ESTRUCTURA, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                si t == T_IDENTIFICADOR:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    si token_mirar(est) == T_IDENTIFICADOR:
                        token_avanzar(est)
                siguiente
            retornar nodo
    retornar nodo
funcion parsear_constante(est: ParserEst) -> entero:
    si token_esperar(est, T_CONSTANTE) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_CONSTANTE, linea, col)
    si token_mirar(est) == T_DOSPUNTOS:
        token_avanzar(est)
        si token_mirar(est) == T_IDENTIFICADOR:
            token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    expr = parsear_expresion(est)
    retornar nodo
funcion parsear_asm(est: ParserEst) -> entero:
    si token_esperar(est, T_ASM) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ASM, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    si token_mirar(est) == T_CADENA:
        token_avanzar(est)
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    retornar nodo
funcion parsear_inseguro(est: ParserEst) -> entero:
    si token_esperar(est, T_INSEGURO) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_INSEGURO, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo
funcion parsear_importar_c(est: ParserEst) -> entero:
    si token_esperar(est, T_IMPORTAR_C) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_IMPORTAR_C, linea, col)
    si token_mirar(est) == T_CADENA:
        token_avanzar(est)
    retornar nodo
funcion parsear_externo(est: ParserEst) -> entero:
    si token_esperar(est, T_EXTERNO) == 0:
        retornar 0
    si token_esperar(est, T_FUNCION) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_EXTERNO, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_PAREN_DER:
            r = 0
            romper
        si t == T_IDENTIFICADOR:
            token_avanzar(est)
            si token_esperar(est, T_DOSPUNTOS) == 0:
                retornar 0
            si token_mirar(est) == T_IDENTIFICADOR:
                token_avanzar(est)
            si token_mirar(est) == T_POR:
                token_avanzar(est)
            si token_mirar(est) == T_COMA:
                token_avanzar(est)
                siguiente
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    retornar nodo
funcion parsear_coincidir(est: ParserEst) -> entero:
    si token_esperar(est, T_COINCIDIR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_COINCIDIR, linea, col)
    expr = parsear_expresion(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                si t == T_IDENTIFICADOR:
                    linea_c = token_linea(est, est.posicion)
                    col_c = token_columna(est, est.posicion)
                    token_avanzar(est)
                    nodo_caso = parser_nuevo_nodo(est, NODO_CASO, linea_c, col_c)
                    si token_mirar(est) == T_PAREN_IZQ:
                        token_avanzar(est)
                        si token_mirar(est) == T_IDENTIFICADOR:
                            token_avanzar(est)
                        si token_esperar(est, T_PAREN_DER) == 0:
                            retornar 0
                    si token_esperar(est, T_FLECHA_DER) == 0:
                        retornar 0
                    r2 = 1
                    mientras r2 == 1:
                        t = token_mirar(est)
                        si t == T_NUEVALINEA:
                            r2 = 0
                            romper
                        si t == T_DESINDENTAR:
                            r2 = 0
                            romper
                        si t == T_FIN:
                            r2 = 0
                            romper
                        stmt = parsear_sentencia(est)
                        siguiente
                siguiente
    retornar nodo
funcion parsear_enviar_canal(est: ParserEst) -> entero:
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ENVIAR_CANAL, linea, col)
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_FLECHA_IZQ) == 0:
        retornar 0
    expr = parsear_expresion(est)
    retornar nodo
funcion parsear(tokens: TokenExt, total: entero) -> entero:
    est = ParserEst()
    est.tokens = tokens
    est.total_tokens = total
    est.posicion = 0
    est.total_nodos = 0
    est.hay_error = ?
    est.error_mensaje = ""
    prog = parser_nuevo_nodo(est, NODO_PROGRAMA, 0, 0)
    ultimo_stmt = 0
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_FIN:
            r = 0
            romper
        stmt = parsear_sentencia(est)
        si est.hay_error == ?:
            retornar -1
        si stmt != 0:
            si ultimo_stmt == 0:
                ultimo_stmt = stmt
            sino:
                ultimo_stmt = stmt
        sino:
            token_avanzar(est)
    si est.hay_error == ?:
        retornar -1
    retornar prog
