funcion analizar_sentencia(est: AnalizadorSemanticoEst, idx_nodo: entero) -> nulo:
    si idx_nodo < 0:
        retornar
    tipo = nodo_tipo(est, idx_nodo)
    linea = nodo_linea(est, idx_nodo)
    si tipo == NODO_ASIGNACION:
        retornar
    si tipo == NODO_DECLARACION:
        retornar
    si tipo == NODO_SI:
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
        tabla_salir_scope(est)
        retornar
    si tipo == NODO_MIENTRAS:
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
        tabla_salir_scope(est)
        retornar
    si tipo == NODO_INSEGURO:
        tabla_entrar_scope(est)
        prev = est.dentro_de_inseguro
        est.dentro_de_inseguro = ?
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
        est.dentro_de_inseguro = prev
        tabla_salir_scope(est)
        retornar
    si tipo == NODO_COINCIDIR:
        est.en_coincidir = ?
        casos = nodo_hijo_izq(est, idx_nodo)
        idx_caso = casos
        r = 1
        mientras r == 1:
            si idx_caso <= 0:
                r = 0
                romper
            tag_nombre = ""
            var_nombre = ""
            res = 0
            si res == 0:
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                tabla_salir_scope(est)
            si res == 1:
                tabla_declarar(est, var_nombre, "int", idx_caso, ?)
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                tabla_salir_scope(est)
        est.en_coincidir = ?
        retornar
    si tipo == NODO_EXPR:
        retornar
    si tipo == NODO_LOG:
        retornar
    retornar
funcion analizar_paso_estructuras(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_ESTRUCTURA:
            nombre = ""
            registrar_estructura(est, nombre, stmt)
funcion analizar_paso_funciones(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            si es_builtin(nombre) == ?:
                ok = tabla_declarar(est, nombre, "int", stmt, ?)
                si ok == ?:
                    sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
        si tipo == NODO_EXTERNO:
            nombre = ""
            ok = tabla_declarar(est, nombre, "int", stmt, ?)
            si ok == ?:
                sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
funcion analizar_paso_cuerpos(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            si es_builtin(nombre) == ?:
                tabla_entrar_scope(est)
                est.func_actual = nombre
                cuerpo = nodo_hijo_izq(est, stmt)
                stmt_cuerpo = cuerpo
                r2 = 1
                mientras r2 == 1:
                    si stmt_cuerpo <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_cuerpo)
                tabla_salir_scope(est)
                est.func_actual = ""
funcion analizar(est: AnalizadorSemanticoEst) -> nulo:
    idx_programa = 0
    si idx_programa < 0:
        retornar
    analizar_paso_estructuras(est, idx_programa)
    analizar_paso_funciones(est, idx_programa)
    analizar_paso_cuerpos(est, idx_programa)
