            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        r = 0
    retornar izq
funcion parsear_adicion(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
