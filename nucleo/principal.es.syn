estructura ReporteError:
    codigo: entero
    linea: entero
    columna: entero
    mensaje: cadena
estructura GestorDiagnostico:
    reportes: ReporteError
    total_reportes: entero
    capacidad: entero
    idioma: cadena
    ruta_archivo: cadena
funcion gestor_nuevo(idioma: cadena, ruta: cadena, capacidad: entero) -> GestorDiagnostico:
    g = GestorDiagnostico()
    g.idioma = idioma
    g.ruta_archivo = ruta
    g.total_reportes = 0
    g.capacidad = capacidad
    retornar g
funcion reportar_error(diag: GestorDiagnostico, codigo: entero, linea: entero, columna: entero, mensaje: cadena) -> nulo:
funcion hay_errores(diag: GestorDiagnostico) -> booleano:
    si diag.total_reportes > 0:
        retornar ?
    retornar ?
funcion contar_errores(diag: GestorDiagnostico) -> entero:
    retornar diag.total_reportes
funcion codigo_salida(diag: GestorDiagnostico) -> entero:
    si hay_errores(diag) == ?:
        retornar 1
    retornar 0
funcion resumen_errores(diag: GestorDiagnostico) -> cadena:
    si hay_errores(diag) == ?:
        retornar "0 errores"
    r = ""
    retornar r
funcion obtener_plantilla_error(codigo: entero, idioma: cadena) -> cadena:
    si idioma == "es":
        si codigo == ERR_SYNTAX_EXPECTED_TOKEN:
            retornar "Se esperaba {esperado}, se encontro '{encontrado}'"
        si codigo == ERR_SYNTAX_UNEXPECTED_TOKEN:
            retornar "Token inesperado '{tok_name}' tras expresion"
        si codigo == ERR_SYNTAX_UNEXPECTED_EXPR:
            retornar "Expresion inesperada: '{tipo}'"
        si codigo == ERR_SYNTAX_EXPECTED_NEWLINE:
            retornar "Se esperaba nueva linea despues de '{construccion}'"
        si codigo == ERR_LANG_MISSING:
            retornar "Falta declaracion de idioma '#lang: <codigo>' en la linea 1"
        si codigo == ERR_LANG_UNSUPPORTED:
            retornar "Idioma '{idioma}' no soportado"
        si codigo == ERR_INDENT_INVALID:
            retornar "La indentacion debe ser multiplo de 4 espacios"
        si codigo == ERR_INDENT_INCONSISTENT:
            retornar "Nivel de indentacion inconsistente"
        si codigo == ERR_STRING_UNCLOSED:
            retornar "Cadena sin cerrar"
        si codigo == ERR_LEX:
            retornar "{mensaje}"
        si codigo == ERR_LEX_CHAR_UNEXPECTED:
            retornar "Caracter inesperado '{char}'"
        si codigo == ERR_FILE_NOT_FOUND:
            retornar "Archivo no encontrado: {archivo}"
        si codigo == ERR_CANONICAL_FORMAT:
            retornar "Formato canonico no reconocido o corrupto"
        si codigo == ERR_SEM_VAR_NO_DECLARADA:
            retornar "Variable '{nombre}' no declarada en este ambito"
        si codigo == ERR_SEM_TIPO_INCOMPATIBLE:
            retornar "Tipos incompatibles: no se puede usar '{tipo1}' con '{tipo2}' en '{operacion}'"
        si codigo == ERR_SEM_TIPO_RETORNO:
            retornar "Tipo de retorno incorrecto: se esperaba '{esperado}', se obtuvo '{obtenido}'"
        si codigo == ERR_SEM_FUNC_NO_DEFINIDA:
            retornar "Funcion '{nombre}' no definida"
        si codigo == ERR_SEM_REDEFINICION:
            retornar "Redefinicion de '{nombre}' en el mismo ambito"
        si codigo == ERR_SEM_ARGUMENTOS_INVALIDOS:
            retornar "Cantidad de argumentos invalida para '{nombre}': se esperaban {esperados}"
        si codigo == ERR_SEM_ESTRUCTURA_NO_DEFINIDA:
            retornar "Estructura '{nombre}' no definida"
        si codigo == ERR_SEM_CAMPO_NO_EXISTE:
            retornar "La estructura '{struct}' no tiene un campo '{campo}'"
        si codigo == ERR_SEM_VAR_MOVIDA:
            retornar "Uso ilegal de variable ya movida '{nombre}'"
        si codigo == ERR_SEM_ACCESO_MEMORIA_MOVIDA:
            retornar "Acceso prohibido a memoria movida '{nombre}'"
        si codigo == ERR_SEM_RESULTADO_SIN_DESEMPAQUETAR:
            retornar "Resultado de canal sin desempaquetar"
        si codigo == ERR_MANIFEST_NOT_FOUND:
            retornar "Manifiesto axon.toml no encontrado en el directorio actual"
        si codigo == ERR_MODULE_STD_NOT_FOUND:
            retornar "Modulo estandar '{modulo}' no encontrado. Sysroot corrupto"
        si codigo == ERR_MODULE_AXON_NOT_FOUND:
            retornar "Dependencia '{modulo}' no encontrada en axon_modules"
        si codigo == ERR_DEP_NOT_DECLARED:
            retornar "Dependencia '{modulo}' importada en el codigo pero no declarada en axon.toml"
        si codigo == ERR_LOCK_HASH_MISMATCH:
            retornar "El hash de la dependencia '{modulo}' no coincide con axon.lock"
        si codigo == ERR_GIT_FAILURE:
            retornar "Error de red o revision Git invalida para la dependencia '{modulo}'"
        si codigo == ERR_SEM_ASM_FUERA_INSEGURO:
            retornar "asm() solo puede usarse dentro de un bloque 'inseguro:'"
        si codigo == ERR_SEM_CONSTANTE_INMUTABLE:
            retornar "No se puede reasignar la constante '{nombre}'"
        retornar "Error desconocido"
    si codigo == ERR_SYNTAX_EXPECTED_TOKEN:
        retornar "Expected {esperado}, found '{encontrado}'"
    si codigo == ERR_SYNTAX_UNEXPECTED_TOKEN:
        retornar "Unexpected token '{tok_name}' after expression"
    si codigo == ERR_SYNTAX_UNEXPECTED_EXPR:
        retornar "Unexpected expression: '{tipo}'"
    si codigo == ERR_SYNTAX_EXPECTED_NEWLINE:
        retornar "Expected newline after '{construccion}'"
    si codigo == ERR_LANG_MISSING:
        retornar "Missing language declaration '#lang: <code>' at line 1"
    si codigo == ERR_LANG_UNSUPPORTED:
        retornar "Language '{idioma}' not supported"
    si codigo == ERR_INDENT_INVALID:
        retornar "Indentation must be a multiple of 4 spaces"
    si codigo == ERR_INDENT_INCONSISTENT:
        retornar "Inconsistent indentation level"
    si codigo == ERR_STRING_UNCLOSED:
        retornar "Unclosed string literal"
    si codigo == ERR_LEX:
        retornar "{mensaje}"
    si codigo == ERR_LEX_CHAR_UNEXPECTED:
        retornar "Unexpected character '{char}'"
    si codigo == ERR_FILE_NOT_FOUND:
        retornar "File not found: {archivo}"
    si codigo == ERR_CANONICAL_FORMAT:
        retornar "Unrecognized or corrupted canonical format"
    si codigo == ERR_SEM_VAR_NO_DECLARADA:
        retornar "Variable '{nombre}' not declared in this scope"
    si codigo == ERR_SEM_TIPO_INCOMPATIBLE:
        retornar "Incompatible types: cannot use '{tipo1}' with '{tipo2}' in '{operacion}'"
    si codigo == ERR_SEM_TIPO_RETORNO:
        retornar "Incorrect return type: expected '{esperado}', got '{obtenido}'"
    si codigo == ERR_SEM_FUNC_NO_DEFINIDA:
        retornar "Function '{nombre}' not defined"
    si codigo == ERR_SEM_REDEFINICION:
        retornar "Redefinition of '{nombre}' in the same scope"
    si codigo == ERR_SEM_ARGUMENTOS_INVALIDOS:
        retornar "Invalid argument count for '{nombre}': expected {esperados}"
    si codigo == ERR_SEM_ESTRUCTURA_NO_DEFINIDA:
        retornar "Struct '{nombre}' not defined"
    si codigo == ERR_SEM_CAMPO_NO_EXISTE:
        retornar "Struct '{struct}' has no field '{campo}'"
    si codigo == ERR_SEM_VAR_MOVIDA:
        retornar "Illegal use of already moved variable '{nombre}'"
    si codigo == ERR_SEM_ACCESO_MEMORIA_MOVIDA:
        retornar "Forbidden access to moved memory '{nombre}'"
    si codigo == ERR_SEM_RESULTADO_SIN_DESEMPAQUETAR:
        retornar "Unpacked channel result"
    si codigo == ERR_MANIFEST_NOT_FOUND:
        retornar "axon.toml manifest not found in current directory"
    si codigo == ERR_MODULE_STD_NOT_FOUND:
        retornar "Standard module '{modulo}' not found. Corrupt Sysroot"
    si codigo == ERR_MODULE_AXON_NOT_FOUND:
        retornar "Dependency '{modulo}' not found in axon_modules"
    si codigo == ERR_DEP_NOT_DECLARED:
        retornar "Dependency '{modulo}' imported in code but not declared in axon.toml"
    si codigo == ERR_LOCK_HASH_MISMATCH:
        retornar "Hash of dependency '{modulo}' does not match axon.lock"
    si codigo == ERR_GIT_FAILURE:
        retornar "Network error or invalid Git revision for dependency '{modulo}'"
    si codigo == ERR_SEM_ASM_FUERA_INSEGURO:
        retornar "asm() can only be used inside an 'unsafe:' block"
    si codigo == ERR_SEM_CONSTANTE_INMUTABLE:
        retornar "Cannot reassign constant '{nombre}'"
    retornar "Unknown error"
funcion obtener_linea_contexto(lineas: cadena, linea_num: entero) -> cadena:
    r = ""
    retornar r
funcion formatear_entrada_error(ruta: cadena, linea: entero, columna: entero, mensaje: cadena) -> cadena:
    r = ""
    retornar r
funcion formatear_ubicacion(ruta: cadena, linea: entero, columna: entero) -> cadena:
    si linea > 0:
        r = ""
        retornar r
    retornar ruta
estructura TokenExt:
    tipo: entero
    linea: entero
    columna: entero
    ptr_valor: entero
    len_valor: entero
estructura NodoAST:
    tipo_nodo: entero
    linea: entero
    columna: entero
    valor_int: entero
    valor_dec: decimal
    ptr_str: entero
    len_str: entero
    hijo_izq: entero
    hijo_der: entero
    hermano: entero
    ptr_extra: entero
estructura ParserEst:
    tokens: TokenExt
    total_tokens: entero
    posicion: entero
    nodos: NodoAST
    total_nodos: entero
    hay_error: booleano
    error_mensaje: cadena
    error_linea: entero
    error_columna: entero
    es_sin_std: booleano
funcion parser_nuevo_nodo(est: ParserEst, tipo: entero, linea: entero, columna: entero) -> entero:
funcion parser_error(est: ParserEst, mensaje: cadena, linea: entero, columna: entero) -> nulo:
    est.hay_error = ?
    est.error_mensaje = mensaje
    est.error_linea = linea
    est.error_columna = columna
funcion token_tipo(est: ParserEst, pos: entero) -> entero:
funcion token_linea(est: ParserEst, pos: entero) -> entero:
funcion token_columna(est: ParserEst, pos: entero) -> entero:
funcion token_avanzar(est: ParserEst) -> nulo:
funcion token_mirar(est: ParserEst) -> entero:
funcion token_esperar(est: ParserEst, esperado: entero) -> entero:
    t = token_mirar(est)
    si t == esperado:
        retornar 1
    est.hay_error = ?
    retornar 0
funcion token_esperar_texto(est: ParserEst, esperado: entero) -> entero:
    t = token_mirar(est)
    si t == esperado:
        linea = token_linea(est, est.posicion)
        col = token_columna(est, est.posicion)
        retornar parser_nuevo_nodo(est, NODO_IDENTIFICADOR, linea, col)
    est.hay_error = ?
    retornar 0
funcion parsear_expresion(est: ParserEst) -> entero:
    retornar parsear_logica(est)
funcion parsear_logica(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_comparacion(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_Y:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_comparacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        si t == T_O:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_comparacion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        r = 0
    retornar izq
funcion parsear_comparacion(est: ParserEst) -> entero:
    linea = 0
    col = 0
    der = 0
    nodo = 0
    izq = parsear_adicion(est)
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_MAYOR:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        si t == T_MENOR:
            linea = token_linea(est, est.posicion)
            col = token_columna(est, est.posicion)
            token_avanzar(est)
            der = parsear_adicion(est)
            nodo = parser_nuevo_nodo(est, NODO_BINARIA, linea, col)
            izq = nodo
            siguiente
        si t == T_IGUAL:
            linea = token_linea(est, est.posicion)
