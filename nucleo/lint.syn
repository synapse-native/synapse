#lang: es
// cumple Manual 2 §5.1 (ME r192_deuda_barrido): cláusulas de contratos booleanas alineadas.
// cumple Manual 3 §12 (12.2): lint.syn se compone con formatter.syn vía import
// módulo→módulo (ME formatter_fix, R1) — elimina el duplicado
// normalizar_espacios cuya versión de 2 ramas ensombrece (first-wins del
// aplanador, pipeline.py) a la de formatter.syn y causó H-33.5-3.
importar formatter
// ME r198b3_fmt_lint (H-R198b2-2): builder runtime de anexión O(1)
// amortizada — el acumulador de lint_fix era O(n²) sobre archivos grandes.
// cumple Manual 6 §3.1: declaración externo de funciones C del runtime
// (runtime/core/texto.c §12.2).
externo funcion _syn_texto_builder_crear() -> entero
externo funcion _syn_texto_builder_anexar(id: entero, frag: texto) -> nulo
externo funcion _syn_texto_builder_construir(id: entero) -> texto
externo funcion _syn_texto_builder_liberar(id: entero) -> nulo
// nucleo/lint.syn — Linter nativo sobre AST unificado
// cumple Manual 3 §12: biblioteca estándar de Syquex
// cumple Manual 2 §5: contratos requiere/garantiza en funciones públicas
// cumple Manual 2 §12: nucleo/lint.syn — linter nativo con 5 reglas
// cumple Manual 8 §4.1: backend del comando `synapse lint` (r153 R4)
// cumple Manual 3 §12: colecciones de la biblioteca estándar en su API
// Fase 31.3: linter que procesa el FUENTE por líneas (API real de S1/S2).
// r153 (H-R153-1): el módulo fue escrito contra un API imaginado
// (programa.primero, nodo.contratos, NodoAST sin definir, `no es nulo`,
// coincidir con constantes no declaradas). Se reescribe contra el API que
// ambas capas soportan de verdad (probe r153): Listas, para..en, metodos de
// colección, longitud(), subcadena(). El AST no es alcanzable desde un módulo
// usuario (los tipos NodoAST/Programa no se exponen) — las reglas AST viven
// en el linter embebido de principal.syn; este módulo aporta las reglas de
// FUENTE: indentación, trailing-ws, doble espacio, tabs, TODO/FIXME.
// --- Estructura de advertencia ---
estructura Advertencia:
    tipo: texto // "estilo", "seguridad", "rendimiento"
    mensaje: texto
    linea: entero
    columna: entero
    archivo: texto
// --- Códigos de error ---
constante WARN_LINT_UNUSED_VAR = "WARN_LINT_UNUSED_VAR"
constante WARN_LINT_NO_CONTRACT = "WARN_LINT_NO_CONTRACT"
constante WARN_LINT_INDENT = "WARN_LINT_INDENT"
constante WARN_LINT_NAMING = "WARN_LINT_NAMING"
constante WARN_LINT_DEAD_CODE = "WARN_LINT_DEAD_CODE"
constante WARN_LINT_TRAILING_WS = "WARN_LINT_TRAILING_WS"
constante WARN_LINT_DOUBLE_SPACE = "WARN_LINT_DOUBLE_SPACE"
// --- Función principal del linter (API canónica del módulo) ---
// r153 (H-R153-1): el API imaginado recibía `Programa` (AST no alcanzable
// desde un módulo usuario, verificado con probe). La entrada canónica es la
// RUTA del fuente; las reglas AST viven en el linter embebido de principal.syn.
funcion lint_programa(ruta: texto) -> Lista<Advertencia>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        longitud(_resultado_) >= 0
    // cumple Manual 2 §12: lint_programa() procesa el programa por su fuente.
    retornar lint_archivo(ruta)
// --- Detección de aviso en línea (H-R153-17) ---
// helper para cli_lint: recorre la lista con for-en y compara la línea.
// No usa .obtener(i).campo (método+campo en cadena): la ruta unity nativa no
// emite acceso a campo sobre el slot int64 encajonado que devuelve una
// llamada (hallazgo r153, verificado con probe en synapse_unity.c).
funcion lint_tiene_aviso_en_linea(ads: Lista<Advertencia>, linea: entero) -> booleano:
    requiere:
        verdadero
    garantiza:
        _resultado_ == 1 o _resultado_ == 0
    // cumple Manual 2 §4.3 (H-R153-17): recorrido con for-en (elemento
    // desencajonado por el emisor) en lugar de .obtener(i).campo.
    para a en ads:
        si a.linea == linea:
            retornar verdadero
    retornar falso
// --- Regla 1: variable descartada '_' (WARN_LINT_UNUSED_VAR) ---
funcion lint_variable(nombre: texto, linea: entero, col: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    // cumple Manual 2 §12: Regla 1 — variable '_' no utilizada (sin AST).
    si nombre == "_":
        advertencias.agregar(Advertencia(
            "estilo",
            WARN_LINT_UNUSED_VAR + ": variable '_' no utilizada, considera eliminarla",
            linea,
            col,
            archivo
        ))
// --- Regla 4 sobre firmas: nombre de función snake_case ---
funcion lint_funcion(nombre: texto, linea: entero, col: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    // cumple Manual 2 §12: Regla 4 — despacha lint_nombres() (definida luego).
    lint_nombres(nombre, linea, col, archivo, advertencias)
// --- Regla 3: Indentación incorrecta (fuente) ---
funcion lint_indentacion(linea: texto, num_linea: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    let espacios = 0
    mientras espacios < longitud(linea):
        si subcadena(linea, espacios, 1) == " ":
            espacios = espacios + 1
        sino:
            romper
    si espacios % 4 != 0 y espacios > 0:
        advertencias.agregar(Advertencia(
            "estilo",
            WARN_LINT_INDENT + ": indentación " + entero_a_texto(espacios) + " no es múltiplo de 4",
            num_linea,
            1,
            archivo
        ))
// --- Regla 4: Nombres no snake_case ---
funcion es_snake_case(nombre: texto) -> booleano:
    requiere:
        verdadero
    garantiza:
        _resultado_ == 1 o _resultado_ == 0
    // H-R153-6: sin cadena larga de `o` (37 terminos) — el emisor de
    // expresiones del bootstrap pierde terminos en cadenas logicas largas
    // (hallazgo r153, verificado con probe y en _probe_or.c; ambos capas).
    // Semantica identica: solo [a-z0-9_] con busqueda por alfabeto.
    si longitud(nombre) == 0:
        retornar falso
    let alfabeto = "_abcdefghijklmnopqrstuvwxyz0123456789"
    let i = 0
    mientras i < longitud(nombre):
        // snake_case: solo minúsculas, dígitos, guión bajo.
        let c = subcadena(nombre, i, 1)
        let j = 0
        let permitido = falso
        mientras j < longitud(alfabeto):
            si subcadena(alfabeto, j, 1) == c:
                permitido = verdadero
            j = j + 1
        si no permitido:
            retornar falso
        i = i + 1
    retornar verdadero
funcion lint_nombres(nombre: texto, linea: entero, col: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    si no es_snake_case(nombre):
        advertencias.agregar(Advertencia(
            "estilo",
            WARN_LINT_NAMING + ": '" + nombre + "' no es snake_case",
            linea,
            col,
            archivo
        ))
// --- Función principal: lint por líneas del fuente ---
funcion lint_contenido(contenido: texto, ruta: texto) -> Lista<Advertencia>:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    // cumple Manual 2 §12: reglas de fuente — indentación múltiplo de 4,
    // espacios finales, doble espacio y tabs (Manual 31 §4.3).
    let advertencias = Lista<Advertencia>()
    let num_linea = 1
    let inicio_linea = 0
    let largo = longitud(contenido)
    mientras inicio_linea < largo:
        let fin_linea = inicio_linea
        mientras fin_linea < largo:
            si subcadena(contenido, fin_linea, 1) == "\n":
                romper
            fin_linea = fin_linea + 1
        let linea = subcadena(contenido, inicio_linea, fin_linea - inicio_linea)
        lint_indentacion(linea, num_linea, ruta, advertencias)
        lint_espacios_finales(linea, num_linea, ruta, advertencias)
        lint_doble_espacio(linea, num_linea, ruta, advertencias)
        lint_tabs(linea, num_linea, ruta, advertencias)
        num_linea = num_linea + 1
        inicio_linea = fin_linea + 1
    retornar advertencias
// --- Regla 7: espacios finales (WARN_LINT_TRAILING_WS) ---
funcion lint_espacios_finales(linea: texto, num_linea: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    let largo = longitud(linea)
    si largo > 0:
        si subcadena(linea, largo - 1, 1) == " ":
            advertencias.agregar(Advertencia(
                "estilo",
                WARN_LINT_TRAILING_WS + ": espacios al final de la línea",
                num_linea,
                largo,
                archivo
            ))
// --- Regla 8: doble espacio interno (WARN_LINT_DOUBLE_SPACE) ---
funcion lint_doble_espacio(linea: texto, num_linea: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    let espacios = 0
    mientras espacios < longitud(linea):
        si subcadena(linea, espacios, 1) != " ":
            romper
        espacios = espacios + 1
    // Buscar ' ' fuera del leading (>= 2 espacios internos consecutivos)
    let i = espacios
    mientras i + 1 < longitud(linea):
        si subcadena(linea, i, 1) == " " y subcadena(linea, i + 1, 1) == " ":
            advertencias.agregar(Advertencia(
                "estilo",
                WARN_LINT_DOUBLE_SPACE + ": doble espacio interno",
                num_linea,
                i + 1,
                archivo
            ))
            romper
        i = i + 1
// --- Regla 9: tabulaciones (estilo) ---
funcion lint_tabs(linea: texto, num_linea: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    let i = 0
    mientras i < longitud(linea):
        si subcadena(linea, i, 1) == "\t":
            advertencias.agregar(Advertencia(
                "estilo",
                WARN_LINT_INDENT + ": tabulación (usa 4 espacios)",
                num_linea,
                i + 1,
                archivo
            ))
            romper
        i = i + 1
// --- Función principal del linter de archivo ---
funcion lint_archivo(ruta: texto) -> Lista<Advertencia>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        longitud(_resultado_) >= 0
    // cumple Manual 2 §12: lint_archivo() lee el fuente y emite advertencias.
    // cumple Manual 2 §4.3 (H-R153-2): leer_archivo delega en el runtime real.
    let contenido = leer_archivo(ruta)
    si longitud(contenido) == 0:
        let vacias = Lista<Advertencia>()
        vacias.agregar(Advertencia(
            "seguridad",
            WARN_LINT_NO_CONTRACT + ": archivo vacío o ilegible",
            0,
            0,
            ruta
        ))
        retornar vacias
    retornar lint_contenido(contenido, ruta)
// --- Fix: corrige indentación y estilo en archivo ---
funcion lint_fix(ruta: texto) -> texto:
    requiere:
        longitud(ruta) > 0
    garantiza:
        longitud(_resultado_) >= 0
    let contenido = leer_archivo(ruta)
    si longitud(contenido) == 0:
        retornar ""
    let num_linea = 1
    let inicio_linea = 0
    let largo = longitud(contenido)
    // r153: preserva el newline final (paridad formatter.syn).
    let termina_nl = falso
    si largo > 0:
        si subcadena(contenido, largo - 1, 1) == "\n":
            termina_nl = verdadero
    // ME r198b3_fmt_lint (H-R198b2-2): el acumulador pasa al builder runtime
    // (O(1) amortizado) — cumple Manual 6 §3.1: anexión de líneas vía las
    // funciones C declaradas externo arriba; la copia final única ha sido
    // transferida por _syn_texto_builder_construir (Manual 2 §5.1):
    // `_resultado_` contiene el valor a retornar.
    let acc = _syn_texto_builder_crear()
    si acc < 0:
        // sin builder disponible: sin cambios (paridad con "ilegible")
        retornar ""
    let primero = verdadero
    mientras inicio_linea < largo:
        let fin_linea = inicio_linea
        mientras fin_linea < largo:
            si subcadena(contenido, fin_linea, 1) == "\n":
                romper
            fin_linea = fin_linea + 1
        let linea = subcadena(contenido, inicio_linea, fin_linea - inicio_linea)
        let linea_fix = fix_linea(linea)
        si num_linea > 1:
            _syn_texto_builder_anexar(acc, "\n")
        _syn_texto_builder_anexar(acc, linea_fix)
        primero = falso
        num_linea = num_linea + 1
        inicio_linea = fin_linea + 1
    si termina_nl y no primero:
        _syn_texto_builder_anexar(acc, "\n")
    let resultado = _syn_texto_builder_construir(acc)
    _syn_texto_builder_liberar(acc)
    // Escribir archivo corregido
    inseguro:
        asm("FILE* _f = fopen(ruta.datos, \"wb\"); if(_f){ fwrite(resultado.datos, 1, resultado.longitud, _f); fclose(_f); }")
    retornar resultado
// --- Fix de línea individual ---
// cumple Manual 1 §7.1 (ME formatter_fix, R1): fix_linea delega en
// formatear_linea (formatter.syn) — paridad fix↔fmt: el fix aplica la MISMA
// regla de estilo ("Indentación: 4 espacios, prohibido el uso de tabuladores")
// que el formateador; sin esto, `lint --fix` y `fmt` divergían y el duplicado
// normalizar_espacios (2 ramas) viciaba el fmt (H-33.5-3).
funcion fix_linea(linea: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar formatear_linea(linea)
// r153 (H-R153-8b): lint.syn es un MÓDULO (importado por principal.syn, Manual 8
// §4.1) — NO define `principal`. Su compilación verificable es en COMPAÑÍA de
// principal.syn (como en producción): el oráculo R4 compila principal.syn con
// los tres módulos importados y test_modulos_compilan.py compila cada módulo
// con un driver mínimo que define `principal` (igual que el enlazador exige
// el símbolo en C para un .c sin main).
