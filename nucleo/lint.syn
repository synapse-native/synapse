#lang: es
// nucleo/lint.syn — Linter nativo sobre AST unificado
// cumple Manual 3 §12: biblioteca estándar de Syquex
// cumple Manual 2 §5: contratos requiere/garantiza en funciones públicas
// Fase 31.3: linter que procesa SemNodo[] y emite advertencias

// --- Estructura de advertencia ---

estructura Advertencia:
    tipo: texto           // "estilo", "seguridad", "rendimiento"
    mensaje: texto
    linea: entero
    columna: entero
    archivo: texto

// --- Códigos de error ---

constante WARN_LINT_UNUSED_VAR = "WARN_LINT_UNUSED_VAR"
constante WARN_LINT_NO_CONTRACT = "WARN_LINT_NO_CONTRACT"
constante WARN_LINT_INDENT = "WARN_LINT_INDENT"
constante WARN_LINT_NAMING = "WARN_LINT_NAMING"
constante WARN_LINT_DEAD_CODE = "WARN_LINT_DEAD_CODE"

// --- Función principal del linter ---

funcion lint_programa(programa: Programa) -> Lista<Advertencia>:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let advertencias = Lista<Advertencia>()

    // Recorrer declaraciones del programa
    let nodo = programa.primero
    mientras nodo no es nulo:
        coincidir nodo.tipo:
            NODO_FUNCION => lint_funcion(nodo, advertencias)
            NODO_ESTRUCTURA => lint_estructura(nodo, advertencias)
            NODO_LET => lint_variable(nodo, advertencias)
        nodo = nodo.hermano

    retornar advertencias

// --- Regla 1: Variables no utilizadas (WARN_LINT_UNUSED_VAR) ---

funcion lint_variable(nodo: NodoAST, advertencias: Lista<Advertencia>):
    requiere:
        nodo no es nulo
    garantiza:
        verdadero
    let nombre = nodo.nombre
    // Verificar si la variable se usa en el resto del programa
    // (implementación simplificada: marcar para análisis posterior)
    si nombre == "_":
        advertencias.agregar(Advertencia(
            "estilo",
            "Variable con nombre _: considera un nombre descriptivo",
            nodo.linea,
            nodo.columna,
            nodo.archivo
        ))

// --- Regla 2: Funciones sin contratos (WARN_LINT_NO_CONTRACT) ---

funcion lint_funcion(nodo: NodoAST, advertencias: Lista<Advertencia>):
    requiere:
        nodo no es nulo
    garantiza:
        verdadero
    // Verificar que la función tenga requiere/garantiza
    si nodo.contratos == nulo:
        advertencias.agregar(Advertencia(
            "seguridad",
            "Función sin contratos (requiere/garantiza): " + nodo.nombre,
            nodo.linea,
            nodo.columna,
            nodo.archivo
        ))

// --- Regla 3: Indentación incorrecta (WARN_LINT_INDENT) ---

funcion lint_indentacion(linea: texto, num_linea: entero, archivo: texto, advertencias: Lista<Advertencia>):
    requiere:
        verdadero
    garantiza:
        verdadero
    let espacios = 0
    mientras espacios < longitud(linea):
        si subcadena(linea, espacios, 1) == " ":
            espacios = espacios + 1
        sino:
            romper
    // Verificar que la indentación sea múltiplo de 4
    si espacios % 4 != 0 y espacios > 0:
        advertencias.agregar(Advertencia(
            "estilo",
            "Indentación debe ser múltiplo de 4 espacios",
            num_linea,
            1,
            archivo
        ))

// --- Regla 4: Nombres no estándar (WARN_LINT_NAMING) ---

funcion lint_nombres(nodo: NodoAST, advertencias: Lista<Advertencia>):
    requiere:
        nodo no es nulo
    garantiza:
        verdadero
    let nombre = nodo.nombre
    // Verificar snake_case: solo minúsculas, números y guiones bajos
    let i = 0
    mientras i < longitud(nombre):
        let c = subcadena(nombre, i, 1)
        si c != "_" y (c < "a" o c > "z") y (c < "0" o c > "9") y (c < "A" o c > "Z"):
            advertencias.agregar(Advertencia(
                "estilo",
                "Nombre no estándar (snake_case esperado): " + nombre,
                nodo.linea,
                nodo.columna,
                nodo.archivo
            ))
            romper
        i = i + 1

// --- Regla 5: Código muerto (WARN_LINT_DEAD_CODE) ---

funcion lint_codigo_muerto(nodo: NodoAST, advertencias: Lista<Advertencia>):
    requiere:
        nodo no es nulo
    garantiza:
        verdadero
    // Detectar bloques después de retornar/lanzar
    si nodo.tipo == NODO_RETORNAR o nodo.tipo == NODO_LANZAR:
        si nodo.hermano no es nulo:
            advertencias.agregar(Advertencia(
                "rendimiento",
                "Código muerto después de retornar/lanzar",
                nodo.hermano.linea,
                nodo.hermano.columna,
                nodo.hermano.archivo
            ))

// --- Funciones auxiliares ---

funcion lint_archivo(ruta: texto) -> Resultado<Lista<Advertencia>, texto>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ es ok o _resultado_ es err
    let contenido = ""
    inseguro:
        asm("{ CadenaSegura _af = {.datos=(char*)ruta.datos,.longitud=ruta.longitud}; CadenaSegura _ac = _syn_leer_archivo(_af); if(_ac.longitud>0) contenido=_ac; }")
    si longitud(contenido) == 0:
        retornar err("No se pudo leer el archivo: " + ruta)

    let advertencias = Lista<Advertencia>()
    let num_linea = 1
    let inicio_linea = 0
    let largo = longitud(contenido)

    mientras inicio_linea < largo:
        let fin_linea = inicio_linea
        mientras fin_linea < largo:
            si subcadena(contenido, fin_linea, 1) == "\n":
                romper
            fin_linea = fin_linea + 1
        let linea = subcadena(contenido, inicio_linea, fin_linea - inicio_linea)
        lint_indentacion(linea, num_linea, ruta, advertencias)
        num_linea = num_linea + 1
        inicio_linea = fin_linea + 1

    retornar ok(advertencias)
