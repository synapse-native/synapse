#lang: es
// ast_nodes.syn -- Tipos compuestos del AST en Synapse puro
// Cada estructura define un nodo del arbol. Los campos que apuntan
// a otras estructuras del AST se convierten automaticamente en
// punteros en C para evitar recursion infinita en el tipo.

estructura Token:
    tipo: entero
    lexema: texto
    linea: entero
    columna: entero

estructura Nodo:
    tipo: texto

estructura ListaNodo:
    cabeza: Nodo
    cola: ListaNodo

estructura Programa:
    tipo: texto
    sentencias: ListaNodo

estructura Identificador:
    tipo: texto
    nombre: texto
    linea: entero
    columna: entero

estructura LiteralNumero:
    tipo: texto
    valor: entero

estructura LiteralDecimal:
    tipo: texto
    valor: decimal

estructura LiteralCadena:
    tipo: texto
    valor: texto

estructura OpBinaria:
    tipo: texto
    izquierdo: Nodo
    operador: Token
    derecho: Nodo

estructura OpUnaria:
    tipo: texto
    operador: Token
    expr: Nodo

estructura LlamadaFuncion:
    tipo: texto
    nombre: texto
    argumentos: ListaNodo

estructura ExprAccesoCampo:
    tipo: texto
    objeto: Nodo
    nombre_campo: texto

estructura AsignacionVariable:
    tipo: texto
    nombre: texto
    expresion: Nodo
    // R9: marcador StmtConstante (1 si el puente la creo desde
    // NODO_CONSTANTE). El flatten F8 lo copia a SemNodo.valor_int y la pasada
    // 2 / analizar_sentencia registran la constante con es_constante=1
    // (inmutabilidad real, paridad S1 semantic_checker.py StmtConstante).
    es_constante: booleano

estructura DeclaracionVariable:
    tipo: texto
    nombre: texto
    tipo_param: texto
    expresion: Nodo
    linea: entero
    columna: entero

estructura SentenciaDelegar:
    tipo: texto
    expresion: Nodo

estructura DeclaracionExport:
    tipo: texto
    destino: texto
    funcion: Nodo

estructura AsignacionCampo:
    tipo: texto
    objeto: Nodo
    nombre_campo: texto
    expresion: Nodo

estructura SentenciaSi:
    tipo: texto
    condicion: Nodo
    cuerpo: ListaNodo
    cuerpo_sino: ListaNodo

estructura SentenciaMientras:
    tipo: texto
    condicion: Nodo
    cuerpo: ListaNodo

estructura SentenciaRetornar:
    tipo: texto
    expr: Nodo

estructura SentenciaExpr:
    tipo: texto
    expr: Nodo

estructura LogLlamada:
    tipo: texto
    argumentos: ListaNodo

estructura Parametro:
    tipo: texto
    nombre: texto
    tipo_param: texto
    es_transferencia: booleano

estructura ListaParametro:
    cabeza: Parametro
    cola: ListaParametro

estructura DefinicionFuncion:
    tipo: texto
    nombre: texto
    parametros: ListaParametro
    tipo_retorno: texto
    requiere: ListaNodo
    garantiza: ListaNodo
    cuerpo: ListaNodo

estructura DefinicionEstructura:
    tipo: texto
    nombre: texto
    campos: ListaParametro

estructura SentenciaRomper:
    tipo: texto

estructura SentenciaSiguiente:
    tipo: texto

estructura SentenciaPara:
    tipo: texto
    linea: entero
    columna: entero
    inicializacion: Nodo
    condicion: Nodo
    incremento: Nodo
    cuerpo: Nodo

estructura SentenciaLanzar:
    tipo: texto
    llamada: Nodo

estructura SentenciaRecuperar:
    tipo: texto
    accion_critica: Nodo
    plan_b: Nodo

estructura SentenciaEscuchar:
    tipo: texto
    canal: Nodo
    respuesta: Nodo

estructura ExprTensor:
    tipo: texto
    filas: Nodo
    columnas: Nodo

estructura ExprIndice:
    tipo: texto
    expr: Nodo
    indice: Nodo

// D-6: operador '?' postfijo — propaga el err de un Resultado y desempaqueta el
// valor ok (Manual 3 §7 L331-342).
estructura ExprPropagar:
    tipo: texto
    expresion: Nodo

estructura ArgumentoTransferido:
    tipo: texto
    expr: Nodo

estructura SentenciaImportar:
    tipo: texto
    ruta: texto

estructura BloqueInseguro:
    tipo: texto
    cuerpo: ListaNodo

estructura ExprObtenerDireccion:
    tipo: texto
    expr: Nodo
    es_mutable: booleano
    linea: entero
    columna: entero

estructura ExprDereferencia:
    tipo: texto
    expr: Nodo

estructura ImportarC:
    tipo: texto
    ruta: texto
    es_sistema: booleano

estructura DeclaracionExterna:
    tipo: texto
    nombre: texto
    parametros: ListaParametro
    tipo_retorno: texto

estructura ExprCrearCanal:
    tipo: texto
    tipo_contenido: texto
    capacidad: Nodo

estructura SentenciaEnviarCanal:
    tipo: texto
    canal: Nodo
    valor: Nodo
    linea: entero
    columna: entero

estructura ExprRecibirCanal:
    tipo: texto
    canal: Nodo

estructura LiteralNulo:
    tipo: texto

estructura ConstructorTipo:
    tipo: texto
    nombre: texto
    tipos: ListaNodo

estructura DeclaracionTipo:
    tipo: texto
    nombre: texto
    parametros_tipo: ListaNodo
    tipo_base: texto
    constructores: ListaNodo

// R11 (deuda FASE_2_2.4_NATIVA.md): NodoCoincidir/NodoCaso — el coincidir de
// patrones (Manual 2 S2.4). Paridad S1 ast_nodes.py NodoCoincidir{expresion,
// casos} / NodoCaso{patron, cuerpo}. El puente plano->tipado (puente_ast.syn)
// los construye desde NODO_COINCIDIR/NODO_CASO (parser.syn parsear_coincidir),
// el flatten F8 los aplana a SemNodo[38]/[39] y el analizador valida la
// exhaustividad (ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED).
estructura NodoCoincidir:
    tipo: texto
    expresion: Nodo
    casos: ListaNodo

estructura NodoCaso:
    tipo: texto
    patron: texto
    cuerpo: ListaNodo
