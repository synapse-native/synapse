#lang: es
// nucleo/formatter.syn — Formateador nativo sobre AST unificado
// cumple Manual 3 §12: biblioteca estándar de Syquex
// Fase 31.4: formateador que reescribe código según reglas de estilo

// --- Reglas de estilo (normativas) ---

estructura ReglasEstilo:
    espacios_indentacion: entero    // 4 (prohibido tabs)
    espacios_operadores: booleano   // verdadero: a + b no a+b
    espacio_despues_coma: booleano  // verdadero: funcion(a, b)
    lineas_entre_funciones: entero  // 1

funcion reglas_defecto() -> ReglasEstilo:
    requiere:
        verdadero
    garantiza:
        verdadero
    retornar ReglasEstilo(4, verdadero, verdadero, 1)

// --- Formateo de programa ---

funcion formatear_programa(programa: Programa) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "#lang: es\n"
    let primera = verdadero
    para decl en programa.declaraciones:
        si no primera:
            resultado = resultado + "\n"
        resultado = resultado + formatear_declaracion(decl)
        primera = falso
    retornar resultado

// --- Formateo de declaraciones ---

funcion formatear_declaracion(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    coincidir decl:
        NODO_FUNCION =>
            retornar formatear_funcion(decl)
        NODO_ESTRUCTURA =>
            retornar formatear_estructura(decl)
        NODO_LET =>
            retornar formatear_variable(decl)
        NODO_CONST =>
            retornar formatear_constante(decl)
        NODO_IMPORT =>
            retornar formatear_import(decl)
        _ =>
            retornar ""

// --- Formateo de función ---

funcion formatear_funcion(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "funcion "
    resultado = resultado + decl.txt1 + "("
    resultado = resultado + formatear_parametros(decl.hijo_izq)
    resultado = resultado + ")"
    si decl.hijo_der no es nulo:
        resultado = resultado + " -> " + formatear_tipo(decl.hijo_der)
    resultado = resultado + ":\n"
    resultado = resultado + formatear_contratos(decl.extra)
    resultado = resultado + indentar(formatear_bloque(decl.hijo_izq))
    retornar resultado

// --- Formateo de parámetros ---

funcion formatear_parametros(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    let resultado = ""
    let actual = nodo
    mientras actual no es nulo:
        si resultado != "":
            resultado = resultado + ", "
        resultado = resultado + actual.txt1 + ": " + formatear_tipo(actual.hijo_der)
        actual = actual.hermano
    retornar resultado

// --- Formateo de tipo ---

funcion formatear_tipo(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    retornar nodo.txt1

// --- Formateo de contratos ---

funcion formatear_contratos(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    let resultado = ""
    let actual = nodo
    mientras actual no es nulo:
        si actual.tipo == NODO_REQUIERE:
            resultado = resultado + "    requiere:\n"
            resultado = resultado + indentar(indentar(formatear_expresion(actual.hijo_izq)))
        si actual.tipo == NODO_GARANTIZA:
            resultado = resultado + "    garantiza:\n"
            resultado = resultado + indentar(indentar(formatear_expresion(actual.hijo_izq)))
        actual = actual.hermano
    retornar resultado

// --- Formateo de expresión ---

funcion formatear_expresion(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    coincidir nodo.tipo:
        NODO_LITERAL_ENTERO =>
            retornar texto_de_entero(nodo.valor_int)
        NODO_LITERAL_DECIMAL =>
            retornar texto_de_decimal(nodo.valor_float)
        NODO_LITERAL_CADENA =>
            retornar "\"" + nodo.txt1 + "\""
        NODO_LITERAL_BOOLEANO =>
            si nodo.valor_int == 1: retornar "verdadero"
            si no: retornar "falso"
        NODO_IDENTIFICADOR =>
            retornar nodo.txt1
        NODO_LLAMADA =>
            retornar formatear_llamada(nodo)
        NODO_BINARIO =>
            retornar formatear_binario(nodo)
        NODO_UNARIO =>
            retornar formatear_unario(nodo)
        _ =>
            retornar nodo.txt1

// --- Formateo de llamada ---

funcion formatear_llamada(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = nodo.txt1 + "("
    let actual = nodo.hijo_izq
    let primero = verdadero
    mientras actual no es nulo:
        si no primero:
            resultado = resultado + ", "
        resultado = resultado + formatear_expresion(actual)
        primero = falso
        actual = actual.hermano
    resultado = resultado + ")"
    retornar resultado

// --- Formateo de operador binario ---

funcion formatear_binario(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let izq = formatear_expresion(nodo.hijo_izq)
    let der = formatear_expresion(nodo.hijo_der)
    retornar izq + " " + nodo.txt1 + " " + der

// --- Formateo de unario ---

funcion formatear_unario(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar nodo.txt1 + formatear_expresion(nodo.hijo_izq)

// --- Formateo de estructura ---

funcion formatear_estructura(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "estructura " + decl.txt1 + ":\n"
    resultado = resultado + indentar(formatear_campos(decl.hijo_izq))
    retornar resultado

// --- Formateo de campos ---

funcion formatear_campos(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    let resultado = ""
    let actual = nodo
    mientras actual no es nulo:
        resultado = resultado + actual.txt1 + ": " + formatear_tipo(actual.hijo_der) + "\n"
        actual = actual.hermano
    retornar resultado

// --- Formateo de variable ---

funcion formatear_variable(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "let " + decl.txt1
    si decl.hijo_der no es nulo:
        resultado = resultado + " = " + formatear_expresion(decl.hijo_der)
    resultado = resultado + "\n"
    retornar resultado

// --- Formateo de constante ---

funcion formatear_constante(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "constante " + decl.txt1
    si decl.hijo_der no es nulo:
        resultado = resultado + " = " + formatear_expresion(decl.hijo_der)
    resultado = resultado + "\n"
    retornar resultado

// --- Formateo de import ---

funcion formatear_import(decl: Declaracion) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar "importar " + decl.txt1 + "\n"

// --- Formateo de bloque ---

funcion formatear_bloque(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    let resultado = ""
    let actual = nodo
    mientras actual no es nulo:
        resultado = resultado + formatear_sentencia(actual)
        actual = actual.hermano
    retornar resultado

// --- Formateo de sentencia ---

funcion formatear_sentencia(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    coincidir nodo.tipo:
        NODO_LET =>
            retornar formatear_variable(nodo)
        NODO_RETORNAR =>
            retornar "retornar " + formatear_expresion(nodo.hijo_izq) + "\n"
        NODO_SI =>
            retornar formatear_si(nodo)
        NODO_MIENTRAS =>
            retornar formatear_mientras(nodo)
        NODO_PARA =>
            retornar formatear_para(nodo)
        NODO_COINCIDIR =>
            retornar formatear_coincidir(nodo)
        NODO_LLAMADA =>
            retornar formatear_llamada(nodo) + "\n"
        NODO_ASIGNACION =>
            retornar formatear_asignacion(nodo)
        _ =>
            retornar formatear_expresion(nodo) + "\n"

// --- Formateo de si ---

funcion formatear_si(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "si " + formatear_expresion(nodo.hijo_izq) + ":\n"
    resultado = resultado + indentar(formatear_bloque(nodo.hijo_der))
    si nodo.extra no es nulo:
        resultado = resultado + "sino:\n"
        resultado = resultado + indentar(formatear_bloque(nodo.extra))
    retornar resultado

// --- Formateo de mientras ---

funcion formatear_mientras(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "mientras " + formatear_expresion(nodo.hijo_izq) + ":\n"
    resultado = resultado + indentar(formatear_bloque(nodo.hijo_der))
    retornar resultado

// --- Formateo de para ---

funcion formatear_para(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "para " + nodo.txt1 + " en " + formatear_expresion(nodo.hijo_izq) + ":\n"
    resultado = resultado + indentar(formatear_bloque(nodo.hijo_der))
    retornar resultado

// --- Formateo de coincidir ---

funcion formatear_coincidir(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "coincidir " + formatear_expresion(nodo.hijo_izq) + ":\n"
    resultado = resultado + indentar(formatear_casos(nodo.hijo_der))
    retornar resultado

// --- Formateo de casos ---

funcion formatear_casos(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si nodo es nulo:
        retornar ""
    let resultado = ""
    let actual = nodo
    mientras actual no es nulo:
        resultado = resultado + formatear_caso(actual)
        actual = actual.hermano
    retornar resultado

// --- Formateo de caso ---

funcion formatear_caso(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = "    " + formatear_expresion(nodo.hijo_izq) + " =>\n"
    resultado = resultado + indentar(indentar(formatear_bloque(nodo.hijo_der)))
    retornar resultado

// --- Formateo de asignación ---

funcion formatear_asignacion(nodo: SemNodo) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar nodo.txt1 + " = " + formatear_expresion(nodo.hijo_izq) + "\n"

// --- Indentación ---

funcion indentar(texto: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= longitud(texto)
    si texto == "":
        retornar ""
    let resultado = "    " + texto
    retornar resultado

// --- Utilidades ---

funcion texto_de_entero(valor: entero) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar "$valor"

funcion texto_de_decimal(valor: decimal) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    retornar "$valor"

// --- Formateo de archivo ---

funcion formatear_archivo(ruta: texto) -> Resultado<texto, texto>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ es ok o _resultado_ es err
    let contenido = leer_archivo(ruta)
    si contenido es err:
        retornar err("No se pudo leer: " + ruta)
    let formateado = formatear_texto(contenido)
    retornar ok(formateado)

funcion formatear_texto(texto: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = ""
    let linea_actual = ""
    let linea_num = 0
    let indent = 0
    let largo = longitud(texto)
    let i = 0
    mientras i <= largo:
        si i == largo o subcadena(texto, i, 1) == "\n":
            let linea_formateada = formatear_linea(linea_actual, indent)
            si longitud(resultado) > 0:
                resultado = resultado + "\n"
            resultado = resultado + linea_formateada
            linea_actual = ""
            linea_num = linea_num + 1
            i = i + 1
        sino:
            linea_actual = linea_actual + subcadena(texto, i, 1)
            i = i + 1
    retornar resultado

// cumple Manual 3 §12: formateo de una línea individual
funcion formatear_linea(linea: texto, indent_ref: entero) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let trimmed = recortar(linea)
    si longitud(trimmed) == 0:
        retornar ""
    // Calcular indentación actual
    let espacios = 0
    mientras espacios < longitud(linea):
        si subcadena(linea, espacios, 1) == " ":
            espacios = espacios + 1
        sino:
            romper
    let nivel = espacios / 4
    // Corregir indentación a múltiplo de 4
    let nueva_indent = ""
    let k = 0
    mientras k < nivel:
        nueva_indent = nueva_indent + "    "
        k = k + 1
    // Normalizar espacios alrededor de operadores
    let formateado = normalizar_espacios(trimmed)
    retornar nueva_indent + formateado

// cumple Manual 3 §12: normaliza espacios alrededor de = y otros operadores
funcion normalizar_espacios(linea: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    let resultado = ""
    let largo = longitud(linea)
    let i = 0
    mientras i < largo:
        let c = subcadena(linea, i, 1)
        si c == " ":
            // Saltar espacios múltiples
            mientras i < largo y subcadena(linea, i, 1) == " ":
                i = i + 1
            resultado = resultado + " "
        sino si c == ",":
            resultado = resultado + ", "
            i = i + 1
            mientras i < largo y subcadena(linea, i, 1) == " ":
                i = i + 1
        sino:
            resultado = resultado + c
            i = i + 1
    retornar resultado

// cumple Manual 3 §12: recorta espacios al inicio y final
funcion recortar(linea: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0
    si longitud(linea) == 0:
        retornar ""
    let inicio = 0
    mientras inicio < longitud(linea):
        si subcadena(linea, inicio, 1) != " ":
            romper
        inicio = inicio + 1
    let fin = longitud(linea) - 1
    mientras fin >= inicio:
        si subcadena(linea, fin, 1) != " ":
            romper
        fin = fin - 1
    si inicio > fin:
        retornar ""
    retornar subcadena(linea, inicio, fin - inicio + 1)

// --- Verificación de formato (--check) ---

funcion verificar_formato(ruta: texto) -> Resultado<booleano, texto>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ es ok o _resultado_ es err
    let contenido = leer_archivo(ruta)
    si contenido es err:
        retornar err("No se pudo leer: " + ruta)
    let formateado = formatear_texto(contenido)
    retornar ok(contenido == formateado)

// --- Escritura de formato (--write) ---

funcion fmt_archivo(ruta: texto) -> Resultado<booleano, texto>:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ es ok o _resultado_ es err
    let contenido = leer_archivo(ruta)
    si contenido es err:
        retornar err("No se pudo leer: " + ruta)
    let formateado = formatear_texto(contenido)
    si contenido == formateado:
        retornar ok(falso)  // sin cambios
    inseguro:
        asm("FILE* _f = fopen(ruta.datos, \"wb\"); if(_f){ fwrite(formateado.datos, 1, formateado.longitud, _f); fclose(_f); }")
    retornar ok(verdadero)  // reformateado

// --- Reformato de múltiples archivos ---

funcion fmt_directorio(ruta: texto) -> entero:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ >= 0
    let total = 0
    let modificados = 0
    let errores = 0
    // Recorrer archivos .syn en directorio
    let cmd = "dir /b \"" + ruta + "\\*.syn\" 2>nul"
    let salida = ""
    inseguro:
        asm("char _buf[4096]; FILE* _p = popen(cmd.datos, \"r\"); if(_p){ while(fgets(_buf, sizeof(_buf), _p)) salida = concat(salida, _buf); pclose(_p); }")
    let inicio = 0
    let largo = longitud(salida)
    mientras inicio < largo:
        let fin = inicio
        mientras fin < largo:
            si subcadena(salida, fin, 1) == "\n":
                romper
            fin = fin + 1
        let nombre = subcadena(salida, inicio, fin - inicio)
        si longitud(nombre) > 0:
            let ruta_completa = ruta + "\\" + nombre
            let r = fmt_archivo(ruta_completa)
            si r es ok:
                total = total + 1
                si valor_ok(r) == verdadero:
                    modificados = modificados + 1
            sino:
                errores = errores + 1
        inicio = fin + 1
    retornar errores
