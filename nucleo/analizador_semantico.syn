funcion builtin_tipo_retorno(nombre: cadena) -> cadena:
    si nombre == "reserva": retornar "tensor"
    si nombre == "libera": retornar "nulo"
    si nombre == "crear_tensor": retornar "tensor"
    si nombre == "suma_tensor": retornar "tensor"
    si nombre == "producto_punto": retornar "tensor"
    si nombre == "abrir": retornar "Canal"
    si nombre == "leer": retornar "texto"
    si nombre == "escribir": retornar "nulo"
    si nombre == "escribir_linea": retornar "nulo"
    si nombre == "leer_linea": retornar "texto"
    si nombre == "cerrar": retornar "nulo"
    si nombre == "suma": retornar "tensor"
    si nombre == "producto": retornar "tensor"
    si nombre == "relu": retornar "tensor"
    si nombre == "tokenizar": retornar "int"
    si nombre == "parsear": retornar "Programa"
    si nombre == "generar": retornar "int"
    si nombre == "_argc": retornar "int"
    si nombre == "_argv": retornar "texto"
    si nombre == "salir": retornar "nulo"
    si nombre == "concat": retornar "texto"
    si nombre == "texto_a_entero": retornar "int"
    si nombre == "texto_a_decimal": retornar "decimal"
    si nombre == "entero_a_texto": retornar "texto"
    si nombre == "decimal_a_texto": retornar "texto"
    si nombre == "volcar_ast": retornar "nulo"
    si nombre == "canal_crear": retornar "CanalConcurrencia*"
    si nombre == "canal_enviar": retornar "nulo"
    si nombre == "canal_recibir": retornar "void*"
    si nombre == "cerrar_canal": retornar "nulo"
    si nombre == "len": retornar "int"
    si nombre == "subcadena": retornar "texto"
    si nombre == "empieza_con": retornar "int"
    retornar ""

funcion builtin_tipo_parametro(nombre: cadena, idx: entero) -> cadena:
    si nombre == "reserva" o nombre == "libera" o nombre == "crear_tensor" o nombre == "suma_tensor" o nombre == "producto_punto":
        si idx == 0: retornar "tensor"
        si idx == 1 o nombre == "reserva" o nombre == "libera": retornar "int"
    si nombre == "abrir":
        si idx == 0 o idx == 1: retornar "texto"
    si nombre == "leer" o nombre == "cerrar":
        si idx == 0: retornar "Canal"
    si nombre == "escribir" o nombre == "escribir_linea":
        si idx == 0: retornar "texto"
    si nombre == "suma" o nombre == "producto":
        si idx == 0 o idx == 1: retornar "tensor"
    si nombre == "relu" o nombre == "tokenizar" o nombre == "parsear":
        si idx == 0: retornar "texto"
    si nombre == "generar":
        si idx == 0: retornar "Programa"
        si idx == 1: retornar "texto"
    si nombre == "_argv" o nombre == "salir" o nombre == "texto_a_entero":
        si idx == 0: retornar "int"
    si nombre == "concat":
        si idx == 0 o idx == 1: retornar "texto"
    si nombre == "texto_a_decimal" o nombre == "decimal_a_texto":
        si idx == 0: retornar "texto"
    si nombre == "entero_a_texto":
        si idx == 0: retornar "int"
    si nombre == "volcar_ast":
        si idx == 0: retornar "Programa"
    si nombre == "canal_crear":
        si idx == 0: retornar "int"
    si nombre == "canal_enviar":
        si idx == 0: retornar "CanalConcurrencia*"
        si idx == 1: retornar "void*"
    si nombre == "canal_recibir" o nombre == "cerrar_canal":
        si idx == 0: retornar "CanalConcurrencia*"
    si nombre == "len" o nombre == "empieza_con":
        si idx == 0: retornar "texto"
    si nombre == "subcadena":
        si idx == 0: retornar "texto"
        si idx == 1 o idx == 2: retornar "int"
    si nombre == "empieza_con":
        si idx == 1: retornar "texto"
    retornar ""

// --- Node information helpers ---
funcion nodo_tipo(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].tipo_nodo : 0")
    retornar r

funcion nodo_linea(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].linea : 0")
    retornar r

funcion nodo_hijo_izq(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].hijo_izq : 0")
    retornar r

funcion nodo_hijo_der(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].hijo_der : 0")
    retornar r

funcion nodo_hermano(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].hermano : 0")
    retornar r

funcion nodo_expr(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    // Slot [6] del flat array: hijo de expresion (len_str reutilizado por flatten)
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? ((int*)&est->nodos[idx])[6] : 0")
    retornar r

funcion nodo_valor_int(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est->total_nodos) ? est->nodos[idx].valor_int : 0")
    retornar r

// --- M21.4: Borrow tracking (Manual 4 S4.2) ---
funcion prestamo_activo(est: AnalizadorSemanticoEst, idx_simbolo: entero, es_mutable: booleano) -> booleano:
    // Conflicto si: hay mutable y pedimos inmutable, o hay cualquier prestamo y pedimos mutable
    r = 0
    i = 0
    mientras i < est.total_prestamos:
        inseguro:
            asm("if (est->prestamos[i].idx_simbolo == idx_simbolo) {")
            asm("    if (es_mutable) { r = 1; }")
            asm("    else if (est->prestamos[i].es_mutable) { r = 1; }")
            asm("}")
        si r == 1:
            romper
        i = i + 1
    si r == 1:
        retornar verdadero
    retornar falso

funcion registrar_prestamo(est: AnalizadorSemanticoEst, idx_simbolo: entero, es_mutable: booleano) -> booleano:
    si prestamo_activo(est, idx_simbolo, es_mutable):
        retornar falso
    inseguro:
        asm("if (est->total_prestamos < 4096) {")
        asm("    est->prestamos[est->total_prestamos].idx_simbolo = idx_simbolo;")
        asm("    est->prestamos[est->total_prestamos].es_mutable = es_mutable;")
        asm("    est->prestamos[est->total_prestamos].nivel_ambito = est->tabla->nivel_actual;")
        asm("    est->total_prestamos++;")
        asm("}")
    retornar verdadero

// --- M21.4: Expression traversal to register borrows (Manual 4 S4.2) ---
funcion analizar_expr(est: AnalizadorSemanticoEst, idx: entero) -> nulo:
    si idx <= 0:
        retornar
    tipo = nodo_tipo(est, idx)
    // NODO_PUNTERO (36): &x / &mut x
    si tipo == NODO_PUNTERO:
        es_mut = nodo_valor_int(est, idx)
        hijo = nodo_expr(est, idx)
        si hijo > 0:
            h_tipo = nodo_tipo(est, hijo)
            si h_tipo == NODO_IDENTIFICADOR:
                inseguro:
                    asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[hijo].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[hijo])<<32; } const char* _v=(const char*)_bp; if(_v){ CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_v}; int _idx=tabla_buscar(est,_cs); if(_idx>=0){ if(!registrar_prestamo(est,_idx,es_mut)){ sem_error(est,ERR_MEM_BORROW_CONFLICT,idx,_cs); } } } }")
                // M21.4: restriccion OUTLIVES (paridad _inferir_tipo Manual 4.3)
                inseguro:
                    asm("{ int _lt = est->proximo_lifetime;")
                    asm("    ((int*)est->lt_kind.datos)[0] = LT_LOCAL; ((int*)est->lt_ambito.datos)[0] = 0;")
                    asm("    ((int*)est->lt_kind.datos)[_lt] = LT_LOCAL; ((int*)est->lt_ambito.datos)[_lt] = est->tabla->nivel_actual;")
                    asm("    region_agregar_restriccion(est->region_graph, REGION_OUTLIVES, 0, _lt, idx);")
                    asm("    est->proximo_lifetime = _lt + 1; }")
        retornar
    // NODO_BINARIA (12): recursar en operadores
    si tipo == NODO_BINARIA:
        analizar_expr(est, nodo_expr(est, idx))
        analizar_expr(est, nodo_hijo_izq(est, idx))
        retornar
    // NODO_UNARIA (13)
    si tipo == NODO_UNARIA:
        analizar_expr(est, nodo_expr(est, idx))
        retornar
    // NODO_LLAMADA (14): argumentos en cadena desde slot [6]
    si tipo == NODO_LLAMADA:
        arg = nodo_expr(est, idx)
        r2 = 1
        mientras r2 == 1:
            si arg <= 0:
                r2 = 0
                romper
            analizar_expr(est, arg)
            inseguro:
                asm("arg = est->nodos[arg].hermano")
        retornar
    // NODO_INDICE (29)
    si tipo == NODO_INDICE:
        analizar_expr(est, nodo_expr(est, idx))
        retornar
    retornar

// --- Struct info management ---
funcion registrar_estructura(est: AnalizadorSemanticoEst, nombre: cadena, idx_nodo: entero) -> nulo:
    // Check for duplicate
    i = 0
    r = 1
    mientras r == 1:
        inseguro:
            asm("r = (i < est->total_estructuras) ? 1 : 0")
            si r == 0:
                romper
            asm("int _eq = 1;")
            asm("for (int _si = 0; _si < 256; _si++) { if (nombre.datos[_si] != est->info_estructuras[i].nombre.datos[_si]) { _eq = 0; break; } if (nombre.datos[_si] == 0) break; }")
            asm("if (_eq) {")
            asm("    sem_error(est, ERR_SEM_REDEFINICION, idx_nodo, nombre);")
            asm("    return;")
            asm("}")
            asm("i = i + 1")
    // Store struct info (propiedad del nombre: copia propia, Manual 3 S3.3)
    inseguro:
        asm("char* _nmost = nombre.datos ? strdup(nombre.datos) : (char*)\"\";")
        asm("est->info_estructuras[est->total_estructuras].nombre = (CadenaSegura){.longitud = (int)strlen(_nmost), .datos = _nmost}")
        asm("est->info_estructuras[est->total_estructuras].total_campos = 0")
        asm("est->total_estructuras = est->total_estructuras + 1")

// --- Regex-free pattern parser for match cases ---
// Pattern format: "tag_name(var_name)" or "_"
funcion parsear_patron_coincidir(patron: cadena, tag_nombre: cadena, var_nombre: cadena) -> entero:
    // Returns 0 = wildcard, 1 = tag(var), -1 = error
    // First check if wildcard "_"
    inseguro:
        asm("if (patron.datos[0] == '_' && patron.datos[1] == 0) { return 0; }")
        asm("// Extract tag name before '('")
        asm("int _i = 0;")
        asm("char _tag[64]; int _tp = 0;")
        asm("while (patron.datos[_i] != 0 && patron.datos[_i] != '(') { _tag[_tp++] = patron.datos[_i]; _i++; }")
        asm("_tag[_tp] = 0;")
        asm("if (patron.datos[_i] != '(') { return -1; }")
        asm("_i++; // skip '('")
        asm("char _var[64]; int _vp = 0;")
        asm("while (patron.datos[_i] != 0 && patron.datos[_i] != ')') { _var[_vp++] = patron.datos[_i]; _i++; }")
        asm("_var[_vp] = 0;")
        asm("if (patron.datos[_i] != ')') { return -1; }")
        asm("// Copy results using strdup to own memory")
        asm("tag_nombre = (CadenaSegura){ .longitud = _tp, .datos = strdup(_tag) };")
        asm("var_nombre = (CadenaSegura){ .longitud = _vp, .datos = strdup(_var) };")
    retornar 1

// --- Main analysis functions ---

funcion analizar_sentencia(est: AnalizadorSemanticoEst, idx_nodo: entero) -> nulo:
    si idx_nodo < 0:
        retornar
    tipo = nodo_tipo(est, idx_nodo)
    linea = nodo_linea(est, idx_nodo)

    // AsignacionVariable
    si tipo == NODO_ASIGNACION:
        inseguro:
            asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[idx_nodo].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[idx_nodo])<<32; } const char* _v=(const char*)_bp; if(_v){ CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_v}; if(tabla_buscar(est,_cs)<0) sem_error(est,ERR_SEM_VAR_NO_DECLARADA,idx_nodo,_cs); } }")
        // M21.4: analizar RHS para prestamos (Manual 4 S4.2)
        analizar_expr(est, nodo_expr(est, idx_nodo))
        retornar

    // DeclaracionVariable
    si tipo == NODO_DECLARACION:
        inseguro:
            asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[idx_nodo].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[idx_nodo])<<32; } const char* _v=(const char*)_bp; if(_v){ CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_v}; if(tabla_buscar(est,_cs)>=0){ sem_error(est,ERR_SEM_REDEFINICION,idx_nodo,_cs); }else{ CadenaSegura _t={.longitud=5,.datos=\"entero\"}; tabla_declarar(est,_cs,_t,idx_nodo,0);")
            asm("    // M21.3: LT_LOCAL lifetime counter increment (full constraint gen in M21.4)")
            asm("    est->proximo_lifetime = est->proximo_lifetime + 1;")
            asm("} } }")
        // M21.4: analizar inicializador para prestamos (Manual 4 S4.2)
        analizar_expr(est, nodo_expr(est, idx_nodo))
        retornar

    // SentenciaSi
    si tipo == NODO_SI:
        // M21.4: analizar condicion para prestamos (Manual 4 S4.2, slot [6])
        analizar_expr(est, nodo_expr(est, idx_nodo))
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est->nodos[stmt].hermano")
        tabla_salir_scope(est)
        retornar

    // SentenciaMientras
    si tipo == NODO_MIENTRAS:
        // M21.4: analizar condicion para prestamos (Manual 4 S4.2, slot [6])
        analizar_expr(est, nodo_expr(est, idx_nodo))
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est->nodos[stmt].hermano")
        tabla_salir_scope(est)
        retornar

    // BloqueInseguro
    si tipo == NODO_INSEGURO:
        tabla_entrar_scope(est)
        prev = est.dentro_de_inseguro
        est.dentro_de_inseguro = verdadero
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est->nodos[stmt].hermano")
        est.dentro_de_inseguro = prev
        tabla_salir_scope(est)
        retornar

    // NodoCoincidir
    si tipo == NODO_COINCIDIR:
        est.en_coincidir = verdadero
        casos = nodo_hijo_izq(est, idx_nodo)
        idx_caso = casos
        // Inicializar flags de variantes para validacion exhaustiva (Manual 2 S2.4)
        tiene_wildcard = falso
        tiene_ok = falso
        tiene_err = falso
        tiene_algun = falso
        tiene_ninguno = falso
        r = 1
        mientras r == 1:
            si idx_caso <= 0:
                r = 0
                romper
            // Parse pattern without regex
            tag_nombre = ""
            var_nombre = ""
            res = 0
            inseguro:
                asm("int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[idx_caso].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[idx_caso])<<32; } CadenaSegura _patron_s = { .longitud = 255, .datos = (const char*)_bp };")
                asm("res = parsear_patron_coincidir(_patron_s, tag_nombre, var_nombre);")
                asm("// Manual 2 S2.4: marcar variantes para validacion de exhaustividad")
                asm("if(res==1){ if(tag_nombre.datos){ if(strcmp(tag_nombre.datos,\"ok\")==0) tiene_ok=1; if(strcmp(tag_nombre.datos,\"err\")==0) tiene_err=1; if(strcmp(tag_nombre.datos,\"algun\")==0) tiene_algun=1; if(strcmp(tag_nombre.datos,\"ninguno\")==0) tiene_ninguno=1; } }")
            si res == 0:
                tiene_wildcard = verdadero
                // wildcard _
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                    inseguro:
                        asm("stmt_c = est->nodos[stmt_c].hermano")
                tabla_salir_scope(est)
            si res == 1:
                // tag(var) pattern
                tabla_declarar(est, var_nombre, "int", idx_caso, falso)
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                    inseguro:
                        asm("stmt_c = est->nodos[stmt_c].hermano")
                tabla_salir_scope(est)
            inseguro:
                asm("idx_caso = est->nodos[idx_caso].hermano")
        // Validacion de exhaustividad post-bucle (Manual 2 S2.4)
        si tiene_wildcard == falso:
            si (tiene_ok == verdadero y tiene_err == falso) o (tiene_ok == falso y tiene_err == verdadero):
                sem_error(est, ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED, idx_nodo, "coincidir no exhaustivo: faltan variantes ok/err")
            si (tiene_algun == verdadero y tiene_ninguno == falso) o (tiene_algun == falso y tiene_ninguno == verdadero):
                sem_error(est, ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED, idx_nodo, "coincidir no exhaustivo: faltan variantes algun/ninguno")
        est.en_coincidir = falso
        retornar

    // SentenciaExpr - analizar expr para prestamos
    si tipo == NODO_EXPR:
        analizar_expr(est, nodo_expr(est, idx_nodo))
        retornar

    // LogLlamada
    si tipo == NODO_LOG:
        retornar

    // SentenciaRetornar - analizar expr para prestamos (Manual 4 S4.2)
    si tipo == NODO_RETORNAR:
        analizar_expr(est, nodo_expr(est, idx_nodo))
        retornar

    // For other types, just traverse body
    // SentenciaRomper, SentenciaSiguiente, etc.
    retornar

// --- First pass: register struct definitions ---
funcion analizar_paso_estructuras(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_ESTRUCTURA:
            nombre = ""
            inseguro:
                asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[stmt].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[stmt])<<32; } const char* _v=(const char*)_bp; if(_v){ char* _dup=strdup(_v); CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_dup}; nombre=_cs; } }")
            registrar_estructura(est, nombre, stmt)
        inseguro:
            asm("stmt = est->nodos[stmt].hermano")

// --- Second pass: register functions and extern declarations ---
funcion analizar_paso_funciones(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    nombre = ""
    inseguro:
        asm("nombre.datos = NULL;")
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            inseguro:
                asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[stmt].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[stmt])<<32; } const char* _v=(const char*)_bp; if(_v){ char* _dup=strdup(_v); CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_dup}; nombre=_cs; } }")
            si es_builtin(nombre) == falso:
                ok = tabla_declarar(est, nombre, "int", stmt, falso)
                si ok == falso:
                    sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
        si tipo == NODO_EXTERNO:
            nombre = ""
            inseguro:
                asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[stmt].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[stmt])<<32; } const char* _v=(const char*)_bp; if(_v){ char* _dup=strdup(_v); CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_dup}; nombre=_cs; } }")
            ok = tabla_declarar(est, nombre, "int", stmt, falso)
            si ok == falso:
                sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
        inseguro:
            asm("stmt = est->nodos[stmt].hermano")

// --- Third pass: analyze function bodies ---
funcion analizar_paso_cuerpos(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            inseguro:
                asm("{ int* _phi=(int*)est->asignaciones_campos_campo.datos; uintptr_t _bp=(uintptr_t)(unsigned)est->nodos[stmt].ptr_str; if(_phi){ _bp|=((uintptr_t)(unsigned)_phi[stmt])<<32; } const char* _v=(const char*)_bp; if(_v){ char* _dup=strdup(_v); CadenaSegura _cs={.longitud=(int)strlen(_v),.datos=_dup}; nombre=_cs; } }")
            si es_builtin(nombre) == falso:
                tabla_entrar_scope(est)
                est.func_actual = nombre
                // M21.4: Initialize lifetime tracking for this function scope (Manual 4.3)
                inseguro:
                    asm("est->proximo_lifetime = 0;")
                    asm("est->region_graph->total_constraints = 0;")
                    asm("for (int _ui = 0; _ui < est->uf->max; _ui++) { ((int*)est->uf->parent.datos)[_ui] = -1; ((int*)est->uf->rank.datos)[_ui] = 0; }")
                    asm("((int*)est->lt_kind.datos)[0] = LT_LOCAL; ((int*)est->lt_ambito.datos)[0] = 0;")
                // Analyze function body
                cuerpo = nodo_hijo_izq(est, stmt)
                stmt_cuerpo = cuerpo
                r2 = 1
                mientras r2 == 1:
                    si stmt_cuerpo <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_cuerpo)
                    inseguro:
                        asm("stmt_cuerpo = est->nodos[stmt_cuerpo].hermano")
                // M21.4: Resolver grafo de regiones (Manual 4.3) — paridad M21.3
                inseguro:
                    asm("if (est->region_graph->total_constraints > 0) {")
                    asm("    region_resolver(est->region_graph, est->uf, est);")
                    asm("}")
                tabla_salir_scope(est)
                est.func_actual = ""
        inseguro:
            asm("stmt = est->nodos[stmt].hermano")

// --- Main entry point ---
funcion analizar(est: AnalizadorSemanticoEst) -> nulo:
    idx_programa = 0
    inseguro:
        asm("idx_programa = 0")
        asm("// Buscar el nodo raiz NODO_PROGRAMA")
        asm("for (int _i = 0; _i < est->total_nodos; _i++) {")
        asm("    if (est->nodos[_i].tipo_nodo == 1) { idx_programa = _i; break; }")
        asm("}")
    si idx_programa < 0:
        retornar
    analizar_paso_estructuras(est, idx_programa)
    analizar_paso_funciones(est, idx_programa)
    analizar_paso_cuerpos(est, idx_programa)

// --- Constructor ---
funcion analizador_nuevo(nodos: SemNodo, total: entero) -> AnalizadorSemanticoEst:
    est = AnalizadorSemanticoEst()
    inseguro:
        asm("est.nodos = (struct SemNodo*)&nodos")
        asm("est.total_nodos = total")
        asm("est.tabla->nivel_actual = 0")
        asm("est.tabla->total_entradas = 0")
    est.func_retorno = ""
    est.func_actual = ""
    est.en_coincidir = falso
    est.dentro_de_inseguro = falso
    est.hay_error = falso
    est.total_estructuras = 0
    est.total_asignaciones = 0
    retornar est
