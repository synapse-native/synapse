        asm("if (strcmp(nombre.datos, \"suma\") == 0) { return verdadero; }")
        asm("if (strcmp(nombre.datos, \"producto\") == 0) { return verdadero; }")
        asm("if (strcmp(nombre.datos, \"relu\") == 0) { return verdadero; }")
        asm("if (strcmp(nombre.datos, \"tokenizar\") == 0) { return verdadero; }")
