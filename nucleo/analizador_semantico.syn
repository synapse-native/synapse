// --- Struct info management ---
funcion registrar_estructura(est: AnalizadorSemanticoEst, nombre: cadena, idx_nodo: entero) -> nulo:
    // Check for duplicate
    i = 0
    r = 1
    mientras r == 1:
        inseguro:
            asm("r = (i < est.total_estructuras) ? 1 : 0")
            si r == 0:
                romper
            asm("int _eq = 1;")
            asm("for (int _si = 0; _si < 256; _si++) { if (((const char*)nombre)[_si] != ((const char*)est.info_estructuras[i].nombre)[_si]) { _eq = 0; break; } if (((const char*)nombre)[_si] == 0) break; }")
            asm("if (_eq) {")
            asm("    sem_error(est, ERR_SEM_REDEFINICION, idx_nodo, nombre);")
            asm("    retornar;")
            asm("}")
            asm("i = i + 1")
    // Store struct info
    inseguro:
        asm("est.info_estructuras[est.total_estructuras].nombre = nombre")
        asm("est.info_estructuras[est.total_estructuras].total_campos = 0")
        asm("est.total_estructuras = est.total_estructuras + 1")

// --- Regex-free pattern parser for match cases ---
// Pattern format: "tag_name(var_name)" or "_"
funcion parsear_patron_coincidir(patron: cadena, tag_nombre: cadena, var_nombre: cadena) -> entero:
    // Returns 0 = wildcard, 1 = tag(var), -1 = error
    // First check if wildcard "_"
    inseguro:
        asm("if (((const char*)patron)[0] == '_' && ((const char*)patron)[1] == 0) { retornar 0 }")
        asm("// Extract tag name before '('")
        asm("int _i = 0;")
        asm("char _tag[64]; int _tp = 0;")
        asm("while (((const char*)patron)[_i] != 0 && ((const char*)patron)[_i] != '(') { _tag[_tp++] = ((const char*)patron)[_i]; _i++; }")
        asm("_tag[_tp] = 0;")
        asm("if (((const char*)patron)[_i] != '(') { retornar -1 }")
        asm("_i++; // skip '('")
        asm("char _var[64]; int _vp = 0;")
        asm("while (((const char*)patron)[_i] != 0 && ((const char*)patron)[_i] != ')') { _var[_vp++] = ((const char*)patron)[_i]; _i++; }")
        asm("_var[_vp] = 0;")
        asm("if (((const char*)patron)[_i] != ')') { retornar -1 }")
        asm("// Copy results")
        asm("int _tk = 0; while (_tag[_tk]) { ((char*)tag_nombre)[_tk] = _tag[_tk]; _tk++; } ((char*)tag_nombre)[_tk] = 0;")
        asm("int _vk = 0; while (_var[_vk]) { ((char*)var_nombre)[_vk] = _var[_vk]; _vk++; } ((char*)var_nombre)[_vk] = 0;")
    retornar 1

// --- Main analysis functions ---

funcion analizar_sentencia(est: AnalizadorSemanticoEst, idx_nodo: entero) -> nulo:
    si idx_nodo < 0:
        retornar
    tipo = nodo_tipo(est, idx_nodo)
    linea = nodo_linea(est, idx_nodo)

    // AsignacionVariable
    si tipo == NODO_ASIGNACION:
        inseguro:
            asm("// Asignacion: buscar variable, inferir tipo, declarar si no existe")
        retornar

    // DeclaracionVariable
    si tipo == NODO_DECLARACION:
        retornar

    // SentenciaSi
    si tipo == NODO_SI:
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est.nodos[stmt].hermano")
        tabla_salir_scope(est)
        retornar

    // SentenciaMientras
    si tipo == NODO_MIENTRAS:
        tabla_entrar_scope(est)
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est.nodos[stmt].hermano")
        tabla_salir_scope(est)
        retornar

    // BloqueInseguro
    si tipo == NODO_INSEGURO:
        tabla_entrar_scope(est)
        prev = est.dentro_de_inseguro
        est.dentro_de_inseguro = verdadero
        cuerpo = nodo_hijo_izq(est, idx_nodo)
        stmt = cuerpo
        r = 1
        mientras r == 1:
            si stmt <= 0:
                r = 0
                romper
            analizar_sentencia(est, stmt)
            inseguro:
                asm("stmt = est.nodos[stmt].hermano")
        est.dentro_de_inseguro = prev
        tabla_salir_scope(est)
        retornar

    // NodoCoincidir
    si tipo == NODO_COINCIDIR:
        est.en_coincidir = verdadero
        casos = nodo_hijo_izq(est, idx_nodo)
        idx_caso = casos
        r = 1
        mientras r == 1:
            si idx_caso <= 0:
                r = 0
                romper
            // Parse pattern without regex
            tag_nombre = ""
            var_nombre = ""
            res = 0
            inseguro:
                asm("// parsear patron del caso via parsear_patron_coincidir")
                asm("res = parsear_patron_coincidir(")
                asm("    est.nodos[idx_caso].ptr_str, tag_nombre, var_nombre)")
            si res == 0:
                // wildcard _
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                    inseguro:
                        asm("stmt_c = est.nodos[stmt_c].hermano")
                tabla_salir_scope(est)
            si res == 1:
                // tag(var) pattern
                tabla_declarar(est, var_nombre, "int", idx_caso, falso)
                tabla_entrar_scope(est)
                cuerpo_caso = nodo_hijo_izq(est, idx_caso)
                stmt_c = cuerpo_caso
                r2 = 1
                mientras r2 == 1:
                    si stmt_c <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_c)
                    inseguro:
                        asm("stmt_c = est.nodos[stmt_c].hermano")
                tabla_salir_scope(est)
            inseguro:
                asm("idx_caso = est.nodos[idx_caso].hermano")
        est.en_coincidir = falso
        retornar

    // SentenciaExpr - just infer type and discard
    si tipo == NODO_EXPR:
        retornar

    // LogLlamada
    si tipo == NODO_LOG:
        retornar

    // For other types, just traverse body
    // SentenciaRetornar, SentenciaRomper, SentenciaSiguiente, etc.
    retornar

// --- First pass: register struct definitions ---
funcion analizar_paso_estructuras(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_ESTRUCTURA:
            nombre = ""
            inseguro:
                asm("// Obtener nombre de estructura del nodo")
            registrar_estructura(est, nombre, stmt)
        inseguro:
            asm("stmt = est.nodos[stmt].hermano")

// --- Second pass: register functions and extern declarations ---
funcion analizar_paso_funciones(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            inseguro:
                asm("// Obtener nombre de funcion del nodo")
            si es_builtin(nombre) == falso:
                ok = tabla_declarar(est, nombre, "int", stmt, falso)
                si ok == falso:
                    sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
        si tipo == NODO_EXTERNO:
            nombre = ""
            inseguro:
                asm("// Obtener nombre externo del nodo")
            ok = tabla_declarar(est, nombre, "int", stmt, falso)
            si ok == falso:
                sem_error(est, ERR_SEM_REDEFINICION, stmt, nombre)
        inseguro:
            asm("stmt = est.nodos[stmt].hermano")

// --- Third pass: analyze function bodies ---
funcion analizar_paso_cuerpos(est: AnalizadorSemanticoEst, idx_programa: entero) -> nulo:
    stmt = nodo_hijo_izq(est, idx_programa)
    r = 1
    mientras r == 1:
        si stmt <= 0:
            r = 0
            romper
        tipo = nodo_tipo(est, stmt)
        si tipo == NODO_FUNCION:
            nombre = ""
            inseguro:
                asm("// Obtener nombre de funcion y analizar cuerpo")
            si es_builtin(nombre) == falso:
                tabla_entrar_scope(est)
                est.func_actual = nombre
                // Analyze function body
                cuerpo = nodo_hijo_izq(est, stmt)
                stmt_cuerpo = cuerpo
                r2 = 1
                mientras r2 == 1:
                    si stmt_cuerpo <= 0:
                        r2 = 0
                        romper
                    analizar_sentencia(est, stmt_cuerpo)
                    inseguro:
                        asm("stmt_cuerpo = est.nodos[stmt_cuerpo].hermano")
                tabla_salir_scope(est)
                est.func_actual = ""
        inseguro:
            asm("stmt = est.nodos[stmt].hermano")

// --- Main entry point ---
funcion analizar(est: AnalizadorSemanticoEst) -> nulo:
    idx_programa = 0
    inseguro:
        asm("idx_programa = 0")
        asm("// Buscar el nodo raiz NODO_PROGRAMA")
        asm("for (int _i = 0; _i < est.total_nodos; _i++) {")
        asm("    if (est.nodos[_i].tipo_nodo == 1) { idx_programa = _i; break; }")
        asm("}")
    si idx_programa < 0:
        retornar
    analizar_paso_estructuras(est, idx_programa)
    analizar_paso_funciones(est, idx_programa)
    analizar_paso_cuerpos(est, idx_programa)

// --- Constructor ---
funcion analizador_nuevo(nodos: SemNodo, total: entero) -> AnalizadorSemanticoEst:
    est = AnalizadorSemanticoEst()
    est.nodos = nodos
    est.total_nodos = total
    inseguro:
        asm("est.tabla->nivel_actual = 0")
        asm("est.tabla->total_entradas = 0")
    est.func_retorno = ""
    est.func_actual = ""
    est.en_coincidir = falso
    est.dentro_de_inseguro = falso
    est.hay_error = falso
    est.total_estructuras = 0
    est.total_asignaciones = 0
    retornar est
