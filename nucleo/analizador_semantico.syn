        asm("if (strcmp(nombre, \"escribir_linea\") == 0) { if (idx == 0) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"leer_linea\") == 0) { }")
        asm("if (strcmp(nombre, \"cerrar\") == 0) { if (idx == 0) retornar \"Canal\" }")
        asm("if (strcmp(nombre, \"suma\") == 0) { if (idx == 0) retornar \"tensor\"; if (idx == 1) retornar \"tensor\" }")
        asm("if (strcmp(nombre, \"producto\") == 0) { if (idx == 0) retornar \"tensor\"; if (idx == 1) retornar \"tensor\" }")
        asm("if (strcmp(nombre, \"relu\") == 0) { if (idx == 0) retornar \"tensor\" }")
        asm("if (strcmp(nombre, \"tokenizar\") == 0) { if (idx == 0) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"parsear\") == 0) { if (idx == 0) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"generar\") == 0) { if (idx == 0) retornar \"Programa\"; if (idx == 1) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"_argv\") == 0) { if (idx == 0) retornar \"int\" }")
        asm("if (strcmp(nombre, \"salir\") == 0) { if (idx == 0) retornar \"int\" }")
        asm("if (strcmp(nombre, \"concat\") == 0) { if (idx == 0) retornar \"texto\"; if (idx == 1) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"texto_a_entero\") == 0) { if (idx == 0) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"texto_a_decimal\") == 0) { if (idx == 0) retornar \"texto\" }")
        asm("if (strcmp(nombre, \"entero_a_texto\") == 0) { if (idx == 0) retornar \"int\" }")
        asm("if (strcmp(nombre, \"decimal_a_texto\") == 0) { if (idx == 0) retornar \"decimal\" }")
        asm("if (strcmp(nombre, \"volcar_ast\") == 0) { if (idx == 0) retornar \"Programa\"; if (idx == 1) retornar \"int\" }")
        asm("if (strcmp(nombre, \"canal_crear\") == 0) { if (idx == 0) retornar \"int\" }")
        asm("if (strcmp(nombre, \"canal_enviar\") == 0) { if (idx == 0) retornar \"CanalConcurrencia*\"; if (idx == 1) retornar \"void*\" }")
        asm("if (strcmp(nombre, \"canal_recibir\") == 0) { if (idx == 0) retornar \"CanalConcurrencia*\" }")
        asm("if (strcmp(nombre, \"cerrar_canal\") == 0) { if (idx == 0) retornar \"CanalConcurrencia*\" }")
    retornar ""

// --- Node information helpers ---
funcion nodo_tipo(est: AnalizadorSemanticoEst, idx: entero) -> entero:
    r = 0
    inseguro:
        asm("r = (idx >= 0 && idx < est.total_nodos) ? est.nodos[idx].tipo_nodo : 0")
    retornar r

