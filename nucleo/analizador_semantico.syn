constante NODO_DECIMAL = 10
constante NODO_CADENA_LIT = 11
constante NODO_BINARIA = 12
constante NODO_UNARIA = 13
constante NODO_LLAMADA = 14
constante NODO_PARAMETRO = 15
constante NODO_ESTRUCTURA = 16
constante NODO_IMPORTAR = 17
constante NODO_LANZAR = 18
constante NODO_ESCUCHAR = 19
constante NODO_ROMPER = 20
constante NODO_SIGUIENTE = 21
constante NODO_BOOLEANO = 22
constante NODO_CONSTANTE = 23
constante NODO_INSEGURO = 24
constante NODO_IMPORTAR_C = 25
