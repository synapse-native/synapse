constante NODO_CONTRATO = 46

// --- Error code constants (mirror diagnostics.syn) ---
constante ERR_SEM_VAR_NO_DECLARADA = 14
constante ERR_SEM_TIPO_INCOMPATIBLE = 15
constante ERR_SEM_TIPO_RETORNO = 16
constante ERR_SEM_FUNC_NO_DEFINIDA = 17
constante ERR_SEM_REDEFINICION = 18
constante ERR_SEM_ARGUMENTOS_INVALIDOS = 19
constante ERR_SEM_ESTRUCTURA_NO_DEFINIDA = 20
constante ERR_SEM_CAMPO_NO_EXISTE = 21
constante ERR_SEM_VAR_MOVIDA = 22
constante ERR_SEM_ASM_FUERA_INSEGURO = 31
constante ERR_SEM_CONSTANTE_INMUTABLE = 32
constante ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED = 33
constante ERR_MEM_LIFETIME_MISMATCH = 34
constante ERR_MEM_LIFETIME_CYCLE = 35

// --- Property constants ---
constante PROPIEDAD_VIVO = 1
constante PROPIEDAD_MOVIDO = 2

// --- Struct definitions ---
estructura SemNodo:
    tipo_nodo: entero
    linea: entero
    columna: entero
    valor_int: entero
    valor_dec: decimal
    ptr_str: entero
    len_str: entero
    hijo_izq: entero
    hijo_der: entero
    hermano: entero
    ptr_extra: entero

estructura SemSimbolo:
    nombre: cadena
    tipo: cadena
    nivel_ambito: entero
    propiedad: entero
    es_constante: booleano
    linea: entero
    columna: entero

estructura SemTablaSimbolos:
    entradas: SemSimbolo
    total_entradas: entero
    nivel_actual: entero
    max_entradas: entero

estructura SemEstructuraInfo:
    nombre: cadena
    campos_nombre: cadena
    campos_tipo: cadena
    total_campos: entero

// M21.4: Borrow tracking entries (Manual 4 S4.2)
estructura SemPrestamo:
    idx_simbolo: entero
    es_mutable: booleano
    nivel_ambito: entero

estructura AnalizadorSemanticoEst:
    nodos: SemNodo
    total_nodos: entero
    tabla: SemTablaSimbolos
    func_retorno: cadena
    func_actual: cadena
    en_coincidir: booleano
    dentro_de_inseguro: booleano
    hay_error: booleano
    info_estructuras: SemEstructuraInfo
    total_estructuras: entero
    asignaciones_campos_var: cadena
    asignaciones_campos_campo: cadena
    asignaciones_campos_tipo: cadena
    total_asignaciones: entero
    // M21.3: Lifetime tracking state (Manual 4.3)
    // region_graph y uf_lifetimes usan estaticos globales via asm
    proximo_lifetime: entero
    // M21.4: Borrow tracking (Manual 4 S4.2)
    prestamos: SemPrestamo
    total_prestamos: entero
    // M21.4: Lifetime region graph (Manual 4.3) — wired desde principal.syn
    region_graph: RegionGraph
    uf: UnionFind
    lt_kind: cadena
    lt_ambito: cadena

// --- Error reporting helper ---
funcion sem_error(est: AnalizadorSemanticoEst, codigo: entero, idx_nodo: entero, mensaje: cadena) -> nulo:
    linea = 0
    columna = 0
    inseguro:
        asm("linea = (idx_nodo >= 0 && idx_nodo < est->total_nodos) ? est->nodos[idx_nodo].linea : 0")
        asm("columna = (idx_nodo >= 0 && idx_nodo < est->total_nodos) ? est->nodos[idx_nodo].columna : 0")
    est.hay_error = verdadero
    inseguro:
        asm("// sem_error: reportado")

// --- Symbol table operations ---
funcion tabla_declarar(est: AnalizadorSemanticoEst, nombre: cadena, tipo: cadena, idx_nodo: entero, es_constante: booleano) -> booleano:
    // Check if already declared in current scope
    linea = 0
    columna = 0
    inseguro:
        asm("linea = (idx_nodo >= 0) ? est->nodos[idx_nodo].linea : 0")
        asm("columna = (idx_nodo >= 0) ? est->nodos[idx_nodo].columna : 0")
    // Search for existing symbol with same name in current scope
    i = 0
    encontrado = falso
    r = 1
    mientras r == 1:
        inseguro:
            asm("r = (i < est->tabla->total_entradas) ? 1 : 0")
            si r == 0:
                romper
            asm("if (est->tabla->entradas[i].nivel_ambito == est->tabla->nivel_actual) {")
            asm("    int _eq = 1;")
            asm("    for (int _si = 0; _si < 256; _si++) { if (((const char*)nombre.datos)[_si] != ((const char*)est->tabla->entradas[i].nombre.datos)[_si]) { _eq = 0; break; } if (((const char*)nombre.datos)[_si] == 0) break; }")
            asm("    if (_eq) { encontrado = verdadero; }")
            asm("}")
            asm("i = i + 1")
    si encontrado == verdadero:
        retornar falso
    // Guard: la tabla de simbolos nunca debe desbordar su limite (Manual 3 S3.2/S3.3)
    inseguro:
        asm("if (est->tabla->total_entradas >= est->tabla->max_entradas) { return 0; }")
    // Add new symbol
    inseguro:
        asm("// Propiedad del nombre: copia propia (evita use-after-free si el llamador libera su buffer)")
        asm("char* _nmown = nombre.datos ? strdup(nombre.datos) : (char*)\"\";")
        asm("est->tabla->entradas[est->tabla->total_entradas].nombre = (CadenaSegura){.longitud = (int)strlen(_nmown), .datos = _nmown}")
        asm("est->tabla->entradas[est->tabla->total_entradas].tipo = tipo")
        asm("est->tabla->entradas[est->tabla->total_entradas].nivel_ambito = est->tabla->nivel_actual")
        asm("est->tabla->entradas[est->tabla->total_entradas].propiedad = 1")
        asm("est->tabla->entradas[est->tabla->total_entradas].es_constante = es_constante")
        asm("est->tabla->entradas[est->tabla->total_entradas].linea = linea")
        asm("est->tabla->entradas[est->tabla->total_entradas].columna = columna")
        asm("est->tabla->total_entradas = est->tabla->total_entradas + 1")
    retornar verdadero

funcion tabla_buscar(est: AnalizadorSemanticoEst, nombre: cadena) -> entero:
    i = 0
    r = 1
    mientras r == 1:
        inseguro:
            asm("r = (i < est->tabla->total_entradas) ? 1 : 0")
            si r == 0:
                romper
            asm("int _eq = 1;")
            asm("for (int _si = 0; _si < 256; _si++) {")
            asm("    char _a = nombre.datos[_si];")
            asm("    char _b = est->tabla->entradas[i].nombre.datos[_si];")
            asm("    if (_a != _b) { _eq = 0; break; }")
            asm("    if (_a == 0) break;")
            asm("}")
            asm("if (_eq) { return i; }")
            asm("i = i + 1")
    retornar -1

funcion tabla_entrar_scope(est: AnalizadorSemanticoEst) -> nulo:
    inseguro:
        asm("est->tabla->nivel_actual = est->tabla->nivel_actual + 1")

funcion tabla_salir_scope(est: AnalizadorSemanticoEst) -> nulo:
    inseguro:
        asm("while (est->tabla->total_entradas > 0) {")
        asm("    if (est->tabla->entradas[est->tabla->total_entradas - 1].nivel_ambito < est->tabla->nivel_actual) break;")
        asm("    est->tabla->total_entradas = est->tabla->total_entradas - 1;")
        asm("}")
        // M21.4: pop de prestamos del scope saliente (Manual 4 S4.2)
        asm("while (est->total_prestamos > 0) {")
        asm("    if (est->prestamos[est->total_prestamos - 1].nivel_ambito < est->tabla->nivel_actual) break;")
        asm("    est->total_prestamos = est->total_prestamos - 1;")
        asm("}")
        asm("est->tabla->nivel_actual = est->tabla->nivel_actual - 1")

funcion tabla_marcar_movido(est: AnalizadorSemanticoEst, nombre: cadena) -> nulo:
    idx = tabla_buscar(est, nombre)
    si idx >= 0:
        inseguro:
            asm("est->tabla->entradas[idx].propiedad = 2")

funcion tabla_esta_movido(est: AnalizadorSemanticoEst, nombre: cadena) -> booleano:
    idx = tabla_buscar(est, nombre)
    si idx >= 0:
        r = 0
        inseguro:
            asm("r = (est->tabla->entradas[idx].propiedad == 2) ? 1 : 0")
        si r == 1:
            retornar verdadero
    retornar falso

// --- Type normalization ---
funcion tipo_normalizado(tipo: cadena) -> cadena:
    si tipo == "entero" o tipo == "int":
        retornar "int"
    si tipo == "decimal" o tipo == "real" o tipo == "flotante":
        retornar "decimal"
    si tipo == "booleano" o tipo == "logico":
        retornar "booleano"
    si tipo == "texto" o tipo == "cadena":
        retornar "texto"
    si tipo == "nulo" o tipo == "vacio":
        retornar "nulo"
    si tipo == "tensor":
        retornar "tensor"
    si tipo == "CanalConcurrencia*":
        retornar "CanalConcurrencia*"
    retornar tipo

// --- Builtin function types ---
funcion es_builtin(nombre: cadena) -> booleano:
    inseguro:
        asm("if (strcmp(nombre.datos, \"reserva\") == 0) { return verdadero; }")
        asm("if (strcmp(nombre.datos, \"libera\") == 0) { return verdadero; }")
        asm("if (strcmp(nombre.datos, \"crear_tensor\") == 0) { return verdadero; }")
