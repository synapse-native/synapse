#lang: es

// Results stored in these temp fields for caller to save
funcion parsear_bloque_contrato(est: ParserEst) -> entero:
    r2 = 1
    expr = 0
    mientras r2 == 1:
        t = token_mirar(est)
        si t == T_NUEVALINEA:
            token_avanzar(est)
            siguiente
        si t == T_INDENTAR:
            token_avanzar(est)
            mientras r2 == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r2 = 0
                    romper
                expr = parsear_expresion(est)
                si expr != 0:
                    si est.contr_primera_temp == 0:
                        est.contr_primera_temp = expr
                        est.contr_ultima_temp = expr
                    sino:
                        inseguro:
                            asm("est.nodos[est.contr_ultima_temp].hermano = expr")
                        est.contr_ultima_temp = expr
                    est.contr_cuenta_temp = est.contr_cuenta_temp + 1
                siguiente
        sino:
            r2 = 0
    retornar 1

// Helper: Parse function parameters
funcion parsear_parametros(est: ParserEst) -> entero:
    r = 0
    si token_mirar(est) != T_PAREN_DER:
        r = 1
        mientras r == 1:
            linea_p = token_linea(est, est.posicion)
            col_p = token_columna(est, est.posicion)
            si token_mirar(est) == T_IDENTIFICADOR:
                token_avanzar(est)
                si token_esperar(est, T_DOSPUNTOS) == 0:
                    retornar 0
                si token_mirar(est) == T_IDENTIFICADOR:
                    token_avanzar(est)
                    nodo_p = parser_nuevo_nodo(est, NODO_PARAMETRO, linea_p, col_p)
                    si token_mirar(est) == T_COMA:
                        token_avanzar(est)
                        siguiente
                    sino:
                        r = 0
                sino:
                    r = 0
            sino:
                r = 0
        retornar 1

// Helper: Parse return type
funcion parsear_tipo_retorno(est: ParserEst) -> entero:
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    retornar 1

// Helper: Parse requiere/garantiza contracts
funcion parsear_contratos(est: ParserEst, nodo_func: entero) -> entero:
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_NUEVALINEA:
            token_avanzar(est)
            siguiente
        si t == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_REQUIERE:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    // Initialize state for requiere
                    est.contr_primera_temp = 0
                    est.contr_ultima_temp = 0
                    est.contr_cuenta_temp = 0
                    parsear_bloque_contrato(est)
                    // Save requiere results
                    est.contr_primera_requiere = est.contr_primera_temp
                    est.contr_ultima_requiere = est.contr_ultima_temp
                    est.contr_cuenta_requiere = est.contr_cuenta_temp
                si t == T_GARANTIZA:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    // Initialize state for garantiza
                    est.contr_primera_temp = 0
                    est.contr_ultima_temp = 0
                    est.contr_cuenta_temp = 0
                    parsear_bloque_contrato(est)
                    // Save garantiza results
                    est.contr_primera_garantiza = est.contr_primera_temp
                    est.contr_ultima_garantiza = est.contr_ultima_temp
                    est.contr_cuenta_garantiza = est.contr_cuenta_temp
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                r = 0
        sino:
            r = 0
    // Store contract descriptor node if any contracts
    si est.contr_primera_requiere != 0 o est.contr_primera_garantiza != 0:
        contrato = parser_nuevo_nodo(est, NODO_CONTRATO, est.contr_linea, est.contr_col)
        inseguro:
            asm("est.nodos[contrato].hijo_izq = est.contr_primera_requiere")
            asm("est.nodos[contrato].hijo_der = est.contr_primera_garantiza")
            asm("est.nodos[contrato].valor_int = est.contr_cuenta_requiere")
            asm("est.nodos[nodo_func].ptr_extra = contrato")
    retornar 1

// Helper: Parse return type
funcion parsear_tipo_retorno(est: ParserEst) -> entero:
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    retornar 1

// Helper: Parse function body
funcion parsear_cuerpo_funcion(est: ParserEst, nodo_func: entero) -> entero:
    r = 1
    stmt = 0
    si token_mirar(est) == T_INDENTAR:
        token_avanzar(est)
        mientras r == 1:
            t = token_mirar(est)
            si t == T_NUEVALINEA:
                token_avanzar(est)
                siguiente
            si t == T_DESINDENTAR:
                token_avanzar(est)
                r = 0
                romper
            si t == T_FIN:
                r = 0
                romper
            stmt = parsear_sentencia(est)
            siguiente
    retornar 1

// Main function parser - refactored
funcion parsear_funcion(est: ParserEst) -> entero:
    r = 0
    expr = 0
    si token_esperar(est, T_FUNCION) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        parser_error(est, "Se esperaba nombre de funcion", token_linea(est, est.posicion), token_columna(est, est.posicion))
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo_func = parser_nuevo_nodo(est, NODO_FUNCION, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    // parametros
    parsear_parametros(est)
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    // tipo retorno
    parsear_tipo_retorno(est)
    // requiere: / garantiza: blocks
    parsear_contratos(est, nodo_func)
    // cuerpo
    parsear_cuerpo_funcion(est, nodo_func)
    retornar nodo_func

// ---- Other statement parsers ----
funcion parsear_si(est: ParserEst) -> entero:
    t = 0
    stmt = 0
    r = 1
    si token_esperar(est, T_IF) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_SI, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    r = 1
    si token_mirar(est) == T_ELSE:
        token_avanzar(est)
        si token_esperar(est, T_DOSPUNTOS) == 0:
            retornar 0
        si token_mirar(est) == T_NUEVALINEA:
            token_avanzar(est)
            si token_mirar(est) == T_INDENTAR:
                token_avanzar(est)
                mientras r == 1:
                    t = token_mirar(est)
                    si t == T_NUEVALINEA:
                        token_avanzar(est)
                        siguiente
                    si t == T_DESINDENTAR:
                        token_avanzar(est)
                        r = 0
                        romper
                    si t == T_FIN:
                        r = 0
                        romper
                    stmt = parsear_sentencia(est)
                    siguiente
    retornar nodo

funcion parsear_mientras(est: ParserEst) -> entero:
    si token_esperar(est, T_MIENTRAS) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_MIENTRAS, linea, col)
    cond = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_izq = cond")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo

funcion parsear_para(est: ParserEst) -> entero:
    si token_esperar(est, T_PARA) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_VACIO, linea, col)
    parsear_asignacion(est)
    si token_esperar(est, T_PUNTOCOMA) == 0:
        retornar 0
    parsear_expresion(est)
    si token_esperar(est, T_PUNTOCOMA) == 0:
        retornar 0
    parsear_asignacion(est)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo

funcion parsear_retornar(est: ParserEst) -> entero:
    si token_esperar(est, T_RETORNAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_RETORNAR, linea, col)
    t = token_mirar(est)
    si t != T_NUEVALINEA:
        si t != T_DESINDENTAR:
            si t != T_FIN:
                expr = parsear_expresion(est)
                inseguro:
                    asm("est.nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_lanzar(est: ParserEst) -> entero:
    si token_esperar(est, T_LANZAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_LANZAR, linea, col)
    expr = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_escuchar(est: ParserEst) -> entero:
    si token_esperar(est, T_ESCUCHAR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ESCUCHAR, linea, col)
    parsear_expresion(est)
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    expr = parsear_expresion(est)
    retornar nodo

funcion parsear_asignacion(est: ParserEst) -> entero:
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    nodo = parser_nuevo_nodo(est, NODO_ASIGNACION, linea, col)
    si token_mirar(est) == T_IDENTIFICADOR y token_tipo(est, est.posicion + 1) == T_FLECHA:
        expr = parsear_recibir_canal(est)
    sino:
        expr = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_der = expr")
    retornar nodo

funcion parsear_estructura_def(est: ParserEst) -> entero:
    si token_esperar(est, T_ESTRUCTURA) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_ESTRUCTURA, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                si t == T_IDENTIFICADOR:
                    token_avanzar(est)
                    si token_esperar(est, T_DOSPUNTOS) == 0:
                        retornar 0
                    si token_mirar(est) == T_IDENTIFICADOR:
                        token_avanzar(est)
                siguiente
            retornar nodo
    retornar nodo

funcion parsear_constante(est: ParserEst) -> entero:
    si token_esperar(est, T_CONSTANTE) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_CONSTANTE, linea, col)
    si token_mirar(est) == T_DOSPUNTOS:
        token_avanzar(est)
        si token_mirar(est) == T_IDENTIFICADOR:
            token_avanzar(est)
    si token_esperar(est, T_ASIGNAR) == 0:
        retornar 0
    expr = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_izq = expr")
    retornar nodo

funcion parsear_asm(est: ParserEst) -> entero:
    si token_esperar(est, T_ASM) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ASM, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    si token_mirar(est) == T_CADENA:
        inseguro:
            asm("est.nodos[nodo].ptr_str = est.tokens[est.posicion].ptr_valor")
            asm("est.nodos[nodo].len_str = est.tokens[est.posicion].len_valor")
        token_avanzar(est)
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    retornar nodo

funcion parsear_inseguro(est: ParserEst) -> entero:
    si token_esperar(est, T_INSEGURO) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_INSEGURO, linea, col)
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                stmt = parsear_sentencia(est)
                siguiente
    retornar nodo

funcion parsear_importar_c(est: ParserEst) -> entero:
    si token_esperar(est, T_IMPORTAR_C) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_IMPORTAR_C, linea, col)
    si token_mirar(est) == T_CADENA:
        token_avanzar(est)
    retornar nodo

funcion parsear_externo(est: ParserEst) -> entero:
    si token_esperar(est, T_EXTERNO) == 0:
        retornar 0
    si token_esperar(est, T_FUNCION) == 0:
        retornar 0
    t = token_mirar(est)
    si t != T_IDENTIFICADOR:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    token_avanzar(est)
    nodo = parser_nuevo_nodo(est, NODO_EXTERNO, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_PAREN_DER:
            r = 0
            romper
        si t == T_IDENTIFICADOR:
            token_avanzar(est)
            si token_esperar(est, T_DOSPUNTOS) == 0:
                retornar 0
            si token_mirar(est) == T_IDENTIFICADOR:
                token_avanzar(est)
            si token_mirar(est) == T_POR:
                token_avanzar(est)
            si token_mirar(est) == T_COMA:
                token_avanzar(est)
                siguiente
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    retornar nodo

funcion parsear_coincidir(est: ParserEst) -> entero:
    si token_esperar(est, T_COINCIDIR) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_COINCIDIR, linea, col)
    expr = parsear_expresion(est)
    inseguro:
        asm("est.nodos[nodo].hijo_izq = expr")
    si token_esperar(est, T_DOSPUNTOS) == 0:
        retornar 0
    si token_mirar(est) == T_NUEVALINEA:
        token_avanzar(est)
        si token_mirar(est) == T_INDENTAR:
            token_avanzar(est)
            r = 1
            mientras r == 1:
                t = token_mirar(est)
                si t == T_NUEVALINEA:
                    token_avanzar(est)
                    siguiente
                si t == T_DESINDENTAR:
                    token_avanzar(est)
                    r = 0
                    romper
                si t == T_FIN:
                    r = 0
                    romper
                si t == T_IDENTIFICADOR:
                    linea_c = token_linea(est, est.posicion)
                    col_c = token_columna(est, est.posicion)
                    token_avanzar(est)
                    nodo_caso = parser_nuevo_nodo(est, NODO_CASO, linea_c, col_c)
                    si token_mirar(est) == T_PAREN_IZQ:
                        token_avanzar(est)
                        si token_mirar(est) == T_IDENTIFICADOR:
                            token_avanzar(est)
                        si token_esperar(est, T_PAREN_DER) == 0:
                            retornar 0
                    si token_esperar(est, T_FLECHA_DER) == 0:
                        retornar 0
                    r2 = 1
                    mientras r2 == 1:
                        t = token_mirar(est)
                        si t == T_NUEVALINEA:
                            r2 = 0
                            romper
                        si t == T_DESINDENTAR:
                            r2 = 0
                            romper
                        si t == T_FIN:
                            r2 = 0
                            romper
                        stmt = parsear_sentencia(est)
                        siguiente
                siguiente
    retornar nodo

funcion parsear_enviar_canal(est: ParserEst) -> entero:
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_ENVIAR_CANAL, linea, col)
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_FLECHA_IZQ) == 0:
        retornar 0
    expr = parsear_expresion(est)
    retornar nodo

funcion parsear_crear_canal(est: ParserEst) -> entero:
    si token_esperar(est, T_CANAL) == 0:
        retornar 0
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_CANAL_CREAR, linea, col)
    si token_esperar(est, T_PAREN_IZQ) == 0:
        retornar 0
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_mirar(est) == T_COMA:
        token_avanzar(est)
        expr = parsear_expresion(est)
        inseguro:
            asm("est.nodos[nodo].hijo_izq = expr")
    si token_esperar(est, T_PAREN_DER) == 0:
        retornar 0
    retornar nodo

funcion parsear_recibir_canal(est: ParserEst) -> entero:
    linea = token_linea(est, est.posicion)
    col = token_columna(est, est.posicion)
    nodo = parser_nuevo_nodo(est, NODO_RECIBIR_CANAL, linea, col)
    si token_mirar(est) == T_IDENTIFICADOR:
        token_avanzar(est)
    si token_esperar(est, T_FLECHA) == 0:
        retornar 0
    retornar nodo

// ---- Main parse function ----
funcion parsear(tokens: TokenExt, total: entero) -> entero:
    est = ParserEst()
    est.tokens = tokens
    est.total_tokens = total
    est.posicion = 0
    est.total_nodos = 0
    est.hay_error = falso
    est.error_mensaje = ""

    // Program node
    prog = parser_nuevo_nodo(est, NODO_PROGRAMA, 0, 0)
    ultimo_stmt = 0

    r = 1
    mientras r == 1:
        t = token_mirar(est)
        si t == T_FIN:
            r = 0
            romper
        stmt = parsear_sentencia(est)
        si est.hay_error == verdadero:
            retornar -1
        si stmt != 0:
            si ultimo_stmt == 0:
                inseguro:
                    asm("est.nodos[prog].hijo_izq = stmt")
                ultimo_stmt = stmt
            sino:
                inseguro:
                    asm("est.nodos[ultimo_stmt].hermano = stmt")
                ultimo_stmt = stmt
        sino:
            token_avanzar(est)

    si est.hay_error == verdadero:
        retornar -1

    retornar prog
