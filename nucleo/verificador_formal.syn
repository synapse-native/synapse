#lang: es
// nucleo/verificador_formal.syn — Módulo de Verificación Formal (M10.1)
//
// Subconjunto de verificación para modo --safe. Se ejecuta después del
// análisis semántico y antes de la generación de código.
//
// Responsabilidades (paridad compilador/verificador_formal.py):
//   1. Prohibir bucles 'mientras' sin cota estática comprobable (E-700)
//   2. Prohibir efectos secundarios mutables globales (E-701)
//   3. Verificar terminación por inducción estructural en funciones
//      recursivas (E-702)
//   4. Validación estática de contratos requiere/garantiza como
//      pre/postcondiciones (E-703)
//
// REESCRITURA 2026-08 (M10.1 nativo): la versión anterior usaba
// construcciones del dialecto que no compilaban ('es nulo', cast sintáctico,
// subcadena sobre texto) y no tenía paridad estructural con el S1. Esta
// versión accede al AST tipado (ast_nodes.syn) directamente en C vía asm()
// sobre struct Programa* (patrón puente_ast.syn / generator.syn). Cada pasada
// re-recorre el AST (sin estado compartido entre bloques asm, que quedan
// confinados en su propio scope C) y devuelve el número de errores hallados.
//
// La función de entrada verificar() devuelve 0 si el código es válido; el
// pipeline nativo (nucleo/principal.syn) la invoca desde generar_etapa cuando
// el flag --safe está activo y aborta la compilación si el conteo es > 0.

importar tokens
importar ast_nodes
importar errores
importar tabla_simbolos

// ================================================================
// Función principal de verificación
// ================================================================
// Retorna el número de errores de verificación (0 = válido en modo --safe).

funcion verificar(ast: puntero, modo_safe: booleano) -> entero:
    requiere:
        ast != nulo
    garantiza:
        _resultado_ >= 0
    total = 0
    si modo_safe:
        total = _ver_bucles_acotados(ast)
        total = total + _ver_mutaciones_globales(ast)
        total = total + _ver_recursion(ast)
        total = total + _ver_contratos(ast)
    retornar total

// ================================================================
// Pasada 2: bucles 'mientras' con cota estática (E-700)
// ================================================================

funcion _ver_bucles_acotados(ast: puntero) -> entero:
    requiere:
        ast != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct Programa* _p = (struct Programa*)ast;")
        asm("if (!_p) return errs;")
        asm("struct ListaNodo* _c = _p->sentencias;")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos && strcmp(_s->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_s;")
        asm("        char* _fn = _f->nombre.datos ? _f->nombre.datos : (char*)\"\";")
        asm("        errs += _ver_inspeccionar_bucles(_f->cuerpo, _fn);")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

funcion _ver_inspeccionar_bucles(cuerpo: puntero, nombre_func: puntero) -> entero:
    requiere:
        nombre_func != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct ListaNodo* _c = (struct ListaNodo*)cuerpo;")
        asm("char* _fn = (char*)nombre_func;")
        asm("if (!_fn) _fn = (char*)\"\";")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos) {")
        asm("        const char* _t = _s->tipo.datos;")
        asm("        if (strcmp(_t, \"SentenciaMientras\") == 0) {")
        asm("            struct SentenciaMientras* _w = (struct SentenciaMientras*)_s;")
        asm("            if (!_ver_tiene_cota(_w->condicion)) {")
        asm("                fprintf(stderr, \"[Synapse] Error de verificacion (E-700): bucle 'mientras' sin cota estatica comprobable en funcion '%s' en modo --safe\\n\", _fn);")
        asm("                errs++;")
        asm("            }")
        asm("            errs += _ver_inspeccionar_bucles(_w->cuerpo, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaPara\") == 0) {")
        asm("            struct SentenciaPara* _pa = (struct SentenciaPara*)_s;")
        asm("            errs += _ver_inspeccionar_bucles(_pa->cuerpo, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaSi\") == 0) {")
        asm("            struct SentenciaSi* _si = (struct SentenciaSi*)_s;")
        asm("            errs += _ver_inspeccionar_bucles(_si->cuerpo, _fn);")
        asm("            if (_si->cuerpo_sino) errs += _ver_inspeccionar_bucles(_si->cuerpo_sino, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"BloqueInseguro\") == 0) {")
        asm("            struct BloqueInseguro* _bi = (struct BloqueInseguro*)_s;")
        asm("            errs += _ver_inspeccionar_bucles(_bi->cuerpo, _fn);")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

// Criterio: la condición contiene un operador de comparación (<, >, <=, >=,
// ==, !=), posiblemente anidado dentro de operadores lógicos (y, o).
// Un 'mientras verdadero:' (sin comparación) se sigue rechazando, pero
// 'mientras i < len_texto:' o 'mientras t != T_MAYOR o x > 0:' se aceptan.

funcion _ver_tiene_cota(cond: puntero) -> entero:
    requiere:
        cond != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct Nodo* _e = (struct Nodo*)cond;")
        asm("if (!_e || !_e->tipo.datos) { r = 0; } else if (strcmp(_e->tipo.datos, \"OpBinaria\") == 0) {")
        asm("    struct OpBinaria* _op = (struct OpBinaria*)_e;")
        asm("    if (_op->operador && _op->operador->lexema.datos) {")
        asm("        const char* _oc = _op->operador->lexema.datos;")
        asm("        int _es_cmp = (strcmp(_oc, \"<\") == 0 || strcmp(_oc, \">\") == 0 || strcmp(_oc, \"<=\") == 0 || strcmp(_oc, \">=\") == 0 || strcmp(_oc, \"==\") == 0 || strcmp(_oc, \"!=\") == 0);")
        asm("        int _es_logico = (strcmp(_oc, \"y\") == 0 || strcmp(_oc, \"o\") == 0 || strcmp(_oc, \"&&\") == 0 || strcmp(_oc, \"||\") == 0);")
        asm("        if (_es_cmp) { r = 1; }")
        asm("        else if (_es_logico) { r = (_ver_tiene_cota(_op->izquierdo) || _ver_tiene_cota(_op->derecho)) ? 1 : 0; }")
        asm("    }")
        asm("}")
    retornar r

// ================================================================
// Pasada 3: mutaciones globales y efectos en funciones puras (E-701)
// ================================================================

funcion _ver_mutaciones_globales(ast: puntero) -> entero:
    requiere:
        ast != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct Programa* _p = (struct Programa*)ast;")
        asm("if (!_p) return errs;")
        asm("struct ListaNodo* _c = _p->sentencias;")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos) {")
        asm("        const char* _t = _s->tipo.datos;")
        asm("        if (strcmp(_t, \"AsignacionVariable\") == 0) {")
        asm("            struct AsignacionVariable* _av = (struct AsignacionVariable*)_s;")
        asm("            if (!_av->es_constante) {")
        asm("                char* _nm = _av->nombre.datos ? _av->nombre.datos : (char*)\"(desconocida)\";")
        asm("                fprintf(stderr, \"[Synapse] Error de verificacion (E-701): mutacion de variable global '%s' prohibida en modo --safe\\n\", _nm);")
        asm("                errs++;")
        asm("            }")
        asm("        }")
        asm("        else if (strcmp(_t, \"DefinicionFuncion\") == 0) {")
        asm("            struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_s;")
        asm("            char* _fn = _f->nombre.datos ? _f->nombre.datos : (char*)\"\";")
        asm("            if (_ver_comprobar_pureza(_fn)) {")
        asm("                errs += _ver_funcion_sin_efectos(_f->cuerpo, _fn);")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

// Funciones puras por convención de nombre: sufijo '_pura' o prefijo 'pura_'.

funcion _ver_comprobar_pureza(nombre: puntero) -> entero:
    requiere:
        nombre != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("char* _nm = (char*)nombre;")
        asm("if (!_nm) { r = 0; } else {")
        asm("    int _l = (int)strlen(_nm);")
        asm("    if (_l >= 5 && strcmp(_nm + _l - 5, \"_pura\") == 0) { r = 1; }")
        asm("    else if (strncmp(_nm, \"pura_\", 5) == 0) { r = 1; }")
        asm("}")
    retornar r

funcion _ver_funcion_sin_efectos(cuerpo: puntero, nombre_func: puntero) -> entero:
    requiere:
        nombre_func != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct ListaNodo* _c = (struct ListaNodo*)cuerpo;")
        asm("char* _fn = (char*)nombre_func;")
        asm("if (!_fn) _fn = (char*)\"\";")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos) {")
        asm("        const char* _t = _s->tipo.datos;")
        asm("        if (strcmp(_t, \"AsignacionCampo\") == 0) {")
        asm("            fprintf(stderr, \"[Synapse] Error de verificacion (E-701): asignacion a campo prohibida en funcion pura '%s' en modo --safe\\n\", _fn); errs++;")
        asm("        }")
        asm("        else if (strcmp(_t, \"BloqueInseguro\") == 0) {")
        asm("            fprintf(stderr, \"[Synapse] Error de verificacion (E-701): bloque 'inseguro' prohibido en funcion pura '%s' en modo --safe\\n\", _fn); errs++;")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaLanzar\") == 0) {")
        asm("            fprintf(stderr, \"[Synapse] Error de verificacion (E-701): sentencia 'lanzar' prohibida en funcion pura '%s' en modo --safe\\n\", _fn); errs++;")
        asm("        }")
        asm("        if (strcmp(_t, \"SentenciaSi\") == 0) {")
        asm("            struct SentenciaSi* _si = (struct SentenciaSi*)_s;")
        asm("            errs += _ver_funcion_sin_efectos(_si->cuerpo, _fn);")
        asm("            if (_si->cuerpo_sino) errs += _ver_funcion_sin_efectos(_si->cuerpo_sino, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaMientras\") == 0) {")
        asm("            struct SentenciaMientras* _w = (struct SentenciaMientras*)_s;")
        asm("            errs += _ver_funcion_sin_efectos(_w->cuerpo, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaPara\") == 0) {")
        asm("            struct SentenciaPara* _pa = (struct SentenciaPara*)_s;")
        asm("            errs += _ver_funcion_sin_efectos(_pa->cuerpo, _fn);")
        asm("        }")
        asm("        else if (strcmp(_t, \"BloqueInseguro\") == 0) {")
        asm("            struct BloqueInseguro* _bi = (struct BloqueInseguro*)_s;")
        asm("            errs += _ver_funcion_sin_efectos(_bi->cuerpo, _fn);")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

// ================================================================
// Pasada 4: terminación por inducción estructural (E-702)
// ================================================================

funcion _ver_recursion(ast: puntero) -> entero:
    requiere:
        ast != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct Programa* _p = (struct Programa*)ast;")
        asm("if (!_p) return errs;")
        asm("struct ListaNodo* _c = _p->sentencias;")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos && strcmp(_s->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_s;")
        asm("        char* _fn = _f->nombre.datos ? _f->nombre.datos : (char*)\"\";")
        asm("        if (_ver_buscar_llamada_recursiva(_f->cuerpo, _fn)) {")
        asm("            if (!_ver_tiene_convergencia(_f)) {")
        asm("                fprintf(stderr, \"[Synapse] Error de verificacion (E-702): funcion '%s' recursiva sin convergencia estructural comprobable en modo --safe\\n\", _fn);")
        asm("                errs++;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

funcion _ver_buscar_llamada_recursiva(cuerpo: puntero, nombre_func: puntero) -> entero:
    requiere:
        nombre_func != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct ListaNodo* _c = (struct ListaNodo*)cuerpo;")
        asm("char* _fn = (char*)nombre_func;")
        asm("if (!_fn) _fn = (char*)\"\";")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos) {")
        asm("        const char* _t = _s->tipo.datos;")
        asm("        if (strcmp(_t, \"SentenciaRetornar\") == 0) {")
        asm("            struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)_s;")
        asm("            if (_rt->expr && _ver_es_llamada_a(_rt->expr, _fn)) { r = 1; }")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaExpr\") == 0) {")
        asm("            struct SentenciaExpr* _se = (struct SentenciaExpr*)_s;")
        asm("            if (_se->expr && _ver_es_llamada_a(_se->expr, _fn)) { r = 1; }")
        asm("        }")
        asm("        else if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_s;")
        asm("            if (_lf->nombre.datos && strcmp(_lf->nombre.datos, _fn) == 0) { r = 1; }")
        asm("        }")
        asm("        if (r == 0) {")
        asm("            if (strcmp(_t, \"SentenciaSi\") == 0) {")
        asm("                struct SentenciaSi* _si = (struct SentenciaSi*)_s;")
        asm("                r = _ver_buscar_llamada_recursiva(_si->cuerpo, _fn);")
        asm("                if (r == 0 && _si->cuerpo_sino) r = _ver_buscar_llamada_recursiva(_si->cuerpo_sino, _fn);")
        asm("            }")
        asm("            else if (strcmp(_t, \"SentenciaMientras\") == 0) {")
        asm("                struct SentenciaMientras* _w = (struct SentenciaMientras*)_s;")
        asm("                r = _ver_buscar_llamada_recursiva(_w->cuerpo, _fn);")
        asm("            }")
        asm("            else if (strcmp(_t, \"SentenciaPara\") == 0) {")
        asm("                struct SentenciaPara* _pa = (struct SentenciaPara*)_s;")
        asm("                r = _ver_buscar_llamada_recursiva(_pa->cuerpo, _fn);")
        asm("            }")
        asm("            else if (strcmp(_t, \"BloqueInseguro\") == 0) {")
        asm("                struct BloqueInseguro* _bi = (struct BloqueInseguro*)_s;")
        asm("                r = _ver_buscar_llamada_recursiva(_bi->cuerpo, _fn);")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    if (r) return r;")
        asm("    _c = _c->cola;")
        asm("}")
    retornar r

funcion _ver_es_llamada_a(expr: puntero, nombre_func: puntero) -> entero:
    requiere:
        nombre_func != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct Nodo* _e = (struct Nodo*)expr;")
        asm("char* _fn = (char*)nombre_func;")
        asm("if (!_fn) _fn = (char*)\"\";")
        asm("if (_e && _e->tipo.datos && strcmp(_e->tipo.datos, \"LlamadaFuncion\") == 0) {")
        asm("    struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_e;")
        asm("    if (_lf->nombre.datos && strcmp(_lf->nombre.datos, _fn) == 0) { r = 1; }")
        asm("}")
    retornar r

// Convergencia estructural: un patrón if/else donde el caso base (if) no
// llama recursivamente y el caso recursivo (sino) sí llama a la función.
// También se acepta un if anidado dentro del caso base con el mismo patrón.

funcion _ver_tiene_convergencia(func: puntero) -> entero:
    requiere:
        func != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct DefinicionFuncion* _f = (struct DefinicionFuncion*)func;")
        asm("char* _fn = _f->nombre.datos ? _f->nombre.datos : (char*)\"\";")
        asm("struct ListaNodo* _c = _f->cuerpo;")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos && strcmp(_s->tipo.datos, \"SentenciaSi\") == 0) {")
        asm("        struct SentenciaSi* _si = (struct SentenciaSi*)_s;")
        asm("            if (_ver_tiene_caso_base(_si->cuerpo, _fn)) {")
        asm("            if ((_si->cuerpo_sino && _ver_buscar_llamada_recursiva(_si->cuerpo_sino, _fn)) || (!_si->cuerpo_sino && _ver_buscar_llamada_recursiva(_c->cola, _fn))) { r = 1; }")
        asm("            struct ListaNodo* _ic = _si->cuerpo;")
        asm("            while (_ic) {")
        asm("                struct Nodo* _is = _ic->cabeza;")
        asm("                if (_is && _is->tipo.datos && strcmp(_is->tipo.datos, \"SentenciaSi\") == 0) {")
        asm("                    struct SentenciaSi* _sub = (struct SentenciaSi*)_is;")
        asm("                    if (_ver_tiene_caso_base(_sub->cuerpo, _fn) && ((_sub->cuerpo_sino && _ver_buscar_llamada_recursiva(_sub->cuerpo_sino, _fn)) || (!_sub->cuerpo_sino && _ver_buscar_llamada_recursiva(_ic->cola, _fn)))) { r = 1; }")
        asm("                }")
        asm("                _ic = _ic->cola;")
        asm("            }")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar r

// Un caso base no contiene llamadas recursivas directas (solo sentencias
// directas del cuerpo, sin recursar en sub-bloques — paridad S1).

funcion _ver_tiene_caso_base(cuerpo: puntero, nombre_func: puntero) -> entero:
    requiere:
        nombre_func != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 1
    inseguro:
        asm("struct ListaNodo* _c = (struct ListaNodo*)cuerpo;")
        asm("char* _fn = (char*)nombre_func;")
        asm("if (!_fn) _fn = (char*)\"\";")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos) {")
        asm("        const char* _t = _s->tipo.datos;")
        asm("        if (strcmp(_t, \"SentenciaRetornar\") == 0) {")
        asm("            struct SentenciaRetornar* _rt = (struct SentenciaRetornar*)_s;")
        asm("            if (_rt->expr && _ver_es_llamada_a(_rt->expr, _fn)) { r = 0; }")
        asm("        }")
        asm("        else if (strcmp(_t, \"SentenciaExpr\") == 0) {")
        asm("            struct SentenciaExpr* _se = (struct SentenciaExpr*)_s;")
        asm("            if (_se->expr && _ver_es_llamada_a(_se->expr, _fn)) { r = 0; }")
        asm("        }")
        asm("        else if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("            struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_s;")
        asm("            if (_lf->nombre.datos && strcmp(_lf->nombre.datos, _fn) == 0) { r = 0; }")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar r

// ================================================================
// Pasada 5: contratos requiere/garantiza (E-703)
// ================================================================

funcion _ver_contratos(ast: puntero) -> entero:
    requiere:
        ast != nulo
    garantiza:
        _resultado_ >= 0
    errs = 0
    inseguro:
        asm("struct Programa* _p = (struct Programa*)ast;")
        asm("if (!_p) return errs;")
        asm("struct ListaNodo* _c = _p->sentencias;")
        asm("while (_c) {")
        asm("    struct Nodo* _s = _c->cabeza;")
        asm("    if (_s && _s->tipo.datos && strcmp(_s->tipo.datos, \"DefinicionFuncion\") == 0) {")
        asm("        struct DefinicionFuncion* _f = (struct DefinicionFuncion*)_s;")
        asm("        char* _fn = _f->nombre.datos ? _f->nombre.datos : (char*)\"\";")
        asm("        int _es_void = _f->tipo_retorno.datos && (strcmp(_f->tipo_retorno.datos, \"nulo\") == 0 || strcmp(_f->tipo_retorno.datos, \"void\") == 0);")
        asm("        struct ListaNodo* _r = _f->requiere;")
        asm("        while (_r) {")
        asm("            if (_r->cabeza && !_ver_expr_booleana_valida(_r->cabeza)) {")
        asm("                fprintf(stderr, \"[Synapse] Error de verificacion (E-703): contrato invalido en funcion '%s': 'requiere' debe ser una condicion logica\\n\", _fn); errs++;")
        asm("            }")
        asm("            _r = _r->cola;")
        asm("        }")
        asm("        struct ListaNodo* _g = _f->garantiza;")
        asm("        while (_g) {")
        asm("            if (_g->cabeza) {")
        asm("                if (!_ver_expr_booleana_valida(_g->cabeza)) {")
        asm("                    fprintf(stderr, \"[Synapse] Error de verificacion (E-703): contrato invalido en funcion '%s': 'garantiza' debe ser una condicion logica\\n\", _fn); errs++;")
        asm("                }")
        asm("                if (_es_void && _ver_menciona_resultado(_g->cabeza)) {")
        asm("                    fprintf(stderr, \"[Synapse] Error de verificacion (E-703): contrato invalido en funcion '%s': 'garantiza' menciona '_resultado_' pero la funcion retorna nulo\\n\", _fn); errs++;")
        asm("                }")
        asm("            }")
        asm("            _g = _g->cola;")
        asm("        }")
        asm("    }")
        asm("    _c = _c->cola;")
        asm("}")
    retornar errs

// Condición booleana válida para contratos: comparaciones como raíz (con
// subexpresiones internas arbitrarias), operadores lógicos &&/||, literales,
// identificadores y llamadas sin efectos de I/O. Rechaza aritmética pura como
// condición y efectos secundarios (paridad S1 _es_expresion_booleana_valida).

funcion _ver_expr_booleana_valida(expr: puntero) -> entero:
    requiere:
        expr != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct Nodo* _e = (struct Nodo*)expr;")
        asm("if (!_e || !_e->tipo.datos) { r = 0; } else {")
        asm("    const char* _t = _e->tipo.datos;")
        asm("    if (strcmp(_t, \"LiteralNumero\") == 0 || strcmp(_t, \"LiteralDecimal\") == 0 || strcmp(_t, \"LiteralBooleano\") == 0 || strcmp(_t, \"LiteralNulo\") == 0) { r = 1; }")
        asm("    else if (strcmp(_t, \"Identificador\") == 0) { r = 1; }")
        asm("    else if (strcmp(_t, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_e;")
        asm("        const char* _oc = _op->operador && _op->operador->lexema.datos ? _op->operador->lexema.datos : \"\";")
        asm("        if (strcmp(_oc, \"==\") == 0 || strcmp(_oc, \"!=\") == 0 || strcmp(_oc, \"<\") == 0 || strcmp(_oc, \">\") == 0 || strcmp(_oc, \"<=\") == 0 || strcmp(_oc, \">=\") == 0) {")
        asm("            r = (_ver_expr_contrato_interna(_op->izquierdo) && _ver_expr_contrato_interna(_op->derecho)) ? 1 : 0;")
        asm("        }")
        asm("        else if (strcmp(_oc, \"&&\") == 0 || strcmp(_oc, \"||\") == 0) {")
        asm("            r = (_ver_expr_booleana_valida(_op->izquierdo) && _ver_expr_booleana_valida(_op->derecho)) ? 1 : 0;")
        asm("        }")
        asm("        else if (strcmp(_oc, \"+\") == 0 || strcmp(_oc, \"-\") == 0 || strcmp(_oc, \"*\") == 0 || strcmp(_oc, \"/\") == 0 || strcmp(_oc, \"%\") == 0) { r = 0; }")
        asm("        else { r = (_ver_expr_booleana_valida(_op->izquierdo) && _ver_expr_booleana_valida(_op->derecho)) ? 1 : 0; }")
        asm("    }")
        asm("    else if (strcmp(_t, \"OpUnaria\") == 0) {")
        asm("        struct OpUnaria* _ou = (struct OpUnaria*)_e;")
        asm("        const char* _oc = _ou->operador && _ou->operador->lexema.datos ? _ou->operador->lexema.datos : \"\";")
        asm("        r = (strcmp(_oc, \"!\") == 0 || strcmp(_oc, \"-\") == 0) ? 1 : 0;")
        asm("    }")
        asm("    else if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_e;")
        asm("        char* _nm = _lf->nombre.datos ? _lf->nombre.datos : (char*)\"\";")
        asm("        if (strcmp(_nm, \"escribir\") == 0 || strcmp(_nm, \"escribir_linea\") == 0 || strcmp(_nm, \"leer\") == 0 || strcmp(_nm, \"leer_linea\") == 0 || strcmp(_nm, \"abrir\") == 0 || strcmp(_nm, \"cerrar_archivo\") == 0 || strcmp(_nm, \"lanzar\") == 0) { r = 0; } else { r = 1; }")
        asm("    }")
        asm("}")
    retornar r

// Expresión interna de contrato (dentro de una comparación): permite
// aritmética, literales, identificadores y llamadas sin efectos (paridad S1
// _es_expresion_contrato_interna).

funcion _ver_expr_contrato_interna(expr: puntero) -> entero:
    requiere:
        expr != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct Nodo* _e = (struct Nodo*)expr;")
        asm("if (!_e || !_e->tipo.datos) { r = 0; } else {")
        asm("    const char* _t = _e->tipo.datos;")
        asm("    if (strcmp(_t, \"LiteralNumero\") == 0 || strcmp(_t, \"LiteralDecimal\") == 0 || strcmp(_t, \"LiteralBooleano\") == 0 || strcmp(_t, \"LiteralNulo\") == 0 || strcmp(_t, \"Identificador\") == 0) { r = 1; }")
        asm("    else if (strcmp(_t, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_e;")
        asm("        const char* _oc = _op->operador && _op->operador->lexema.datos ? _op->operador->lexema.datos : \"\";")
        asm("        if (strcmp(_oc, \"+\") == 0 || strcmp(_oc, \"-\") == 0 || strcmp(_oc, \"*\") == 0 || strcmp(_oc, \"/\") == 0 || strcmp(_oc, \"%\") == 0 || strcmp(_oc, \"==\") == 0 || strcmp(_oc, \"!=\") == 0 || strcmp(_oc, \"<\") == 0 || strcmp(_oc, \">\") == 0 || strcmp(_oc, \"<=\") == 0 || strcmp(_oc, \">=\") == 0 || strcmp(_oc, \"&&\") == 0 || strcmp(_oc, \"||\") == 0) {")
        asm("            r = (_ver_expr_contrato_interna(_op->izquierdo) && _ver_expr_contrato_interna(_op->derecho)) ? 1 : 0;")
        asm("        } else { r = 0; }")
        asm("    }")
        asm("    else if (strcmp(_t, \"OpUnaria\") == 0) {")
        asm("        struct OpUnaria* _ou = (struct OpUnaria*)_e;")
        asm("        const char* _oc = _ou->operador && _ou->operador->lexema.datos ? _ou->operador->lexema.datos : \"\";")
        asm("        r = (strcmp(_oc, \"!\") == 0 || strcmp(_oc, \"-\") == 0) ? 1 : 0;")
        asm("    }")
        asm("    else if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_e;")
        asm("        char* _nm = _lf->nombre.datos ? _lf->nombre.datos : (char*)\"\";")
        asm("        if (strcmp(_nm, \"escribir\") == 0 || strcmp(_nm, \"escribir_linea\") == 0 || strcmp(_nm, \"leer\") == 0 || strcmp(_nm, \"leer_linea\") == 0 || strcmp(_nm, \"abrir\") == 0 || strcmp(_nm, \"cerrar_archivo\") == 0 || strcmp(_nm, \"lanzar\") == 0) { r = 0; } else { r = 1; }")
        asm("    }")
        asm("}")
    retornar r

// Verifica si una expresión menciona la variable especial '_resultado_'
// (paridad S1 _menciona_resultado).

funcion _ver_menciona_resultado(expr: puntero) -> entero:
    requiere:
        expr != nulo
    garantiza:
        _resultado_ == 0 o _resultado_ == 1
    r = 0
    inseguro:
        asm("struct Nodo* _e = (struct Nodo*)expr;")
        asm("if (_e && _e->tipo.datos) {")
        asm("    const char* _t = _e->tipo.datos;")
        asm("    if (strcmp(_t, \"Identificador\") == 0) {")
        asm("        struct Identificador* _id = (struct Identificador*)_e;")
        asm("        if (_id->nombre.datos && strcmp(_id->nombre.datos, \"_resultado_\") == 0) { r = 1; }")
        asm("    }")
        asm("    else if (strcmp(_t, \"OpBinaria\") == 0) {")
        asm("        struct OpBinaria* _op = (struct OpBinaria*)_e;")
        asm("        r = (_ver_menciona_resultado(_op->izquierdo) || _ver_menciona_resultado(_op->derecho)) ? 1 : 0;")
        asm("    }")
        asm("    else if (strcmp(_t, \"OpUnaria\") == 0) {")
        asm("        struct OpUnaria* _ou = (struct OpUnaria*)_e;")
        asm("        r = _ver_menciona_resultado(_ou->expr);")
        asm("    }")
        asm("    else if (strcmp(_t, \"LlamadaFuncion\") == 0) {")
        asm("        struct LlamadaFuncion* _lf = (struct LlamadaFuncion*)_e;")
        asm("        struct ListaNodo* _arg = _lf->argumentos;")
        asm("        while (_arg) {")
        asm("            if (_arg->cabeza && _ver_menciona_resultado(_arg->cabeza)) { r = 1; }")
        asm("            _arg = _arg->cola;")
        asm("        }")
        asm("    }")
        asm("}")
    retornar r