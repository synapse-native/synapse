// ============================================================
// FUNCIÓN PRINCIPAL — Bucle del LSP
// ============================================================

funcion principal() -> entero:
    let ejecutando = 1
    let uri_actual = ""
    mientras ejecutando == 1:
        let content_length = leer_cabecera()
        si content_length <= 0:
            romper

        let body = leer_mensaje(content_length)
        si strlen_s(body) == 0:
            romper

        // Extract ID directly from raw body BEFORE desde_texto(body) frees it.
        // desde_texto() -> RAII frees body. usar funciones con body como param
        // tambien libera body. Asi que extraemos inline con builtins.
        let id_val = -1
        let patron_id = "\"id\":"
        let patron_len_id = 5
        let body_len = strlen_s(body)
        let idx_id = strstr_f(body, patron_id)
        si idx_id >= 0:
            let id_start = idx_id + patron_len_id
            let id_pos = id_start
            mientras id_pos < body_len:
                let c = subcadena(body, id_pos, 1)
                si cmp_texto(c, " ") != 0:
                    romper
                id_pos = id_pos + 1
            let id_fin = id_pos
            mientras id_fin < body_len:
                let c = subcadena(body, id_fin, 1)
                si cmp_texto(c, "0") >= 0:
                    si cmp_texto(c, "9") <= 0:
                        id_fin = id_fin + 1
                    sino:
                        romper
                sino:
                    si cmp_texto(c, "-") == 0:
                        si id_fin == id_pos:
                            id_fin = id_fin + 1
                        sino:
                            romper
                    sino:
                        romper
            si id_fin > id_pos:
                id_val = extraer_entero(subcadena(body, id_pos, id_fin - id_pos))

        // cumple Manual 8 1.2: dispatch via strstr_f sobre body raw
        // (evita use-after-free: cmp_texto libera args; method_str no needed)
        let msg = desde_texto(body)
        let params_nodo = obtener_campo(msg, "params")
        let params_str = strcpy_f(_json_a_texto(params_nodo))

        // cumple Manual 8 1.2: dispatch via strstr_f sobre body raw
        // (evita use-after-free: cmp_texto libera method_str en 1ra llamada)
        si strstr_f(body, "\"initialize\"") >= 0:
            handle_initialize(id_val)
        si strstr_f(body, "\"shutdown\"") >= 0:
            handle_shutdown(id_val)
        si strstr_f(body, "\"exit\"") >= 0:
            si id_val >= 0:
                handle_unknown(id_val)
        si strstr_f(body, "\"textDocument/didOpen\"") >= 0:
            uri_actual = strcpy_f(extraer_uri(params_str))
            lsp_doc_store(extraer_texto_doc(params_str))
            let diag = "{\"uri\":" + json_string(uri_actual) + ",\"diagnostics\":[]}"
            enviar_respuesta(construir_notificacion("textDocument/publishDiagnostics", diag))
        si strstr_f(body, "\"textDocument/didChange\"") >= 0:
            lsp_doc_store(extraer_texto_doc(params_str))
        si strstr_f(body, "\"textDocument/didClose\"") >= 0:
            lsp_doc_clear()
            uri_actual = ""
            let diag = "{\"uri\":" + json_string(uri_actual) + ",\"diagnostics\":[]}"
            enviar_respuesta(construir_notificacion("textDocument/publishDiagnostics", diag))
        si strstr_f(body, "\"textDocument/hover\"") >= 0:
            let doc = reemplazar(lsp_doc_get(), "\\n", "\n")
            handle_hover(id_val, doc, params_str)
        si strstr_f(body, "\"textDocument/completion\"") >= 0:
            let items = lsp_build_completion_items()
            enviar_respuesta(construir_respuesta(id_val, "{\"isIncomplete\":false,\"items\":" + items + "}"))
        si strstr_f(body, "\"textDocument/definition\"") >= 0:
            let doc = reemplazar(lsp_doc_get(), "\\n", "\n")
            handle_definition(id_val, uri_actual, doc, params_str)
        si strstr_f(body, "\"textDocument/codeAction\"") >= 0:
            let doc = reemplazar(lsp_doc_get(), "\\n", "\n")
            handle_code_action(id_val, doc, params_str)
        si strstr_f(body, "\"textDocument/formatting\"") >= 0:
            let doc = reemplazar(lsp_doc_get(), "\\n", "\n")
            handle_formatting(id_val, doc, params_str)
        si strstr_f(body, "\"textDocument/signatureHelp\"") >= 0:
            let doc = reemplazar(lsp_doc_get(), "\\n", "\n")
            handle_signature_help(id_val, doc, params_str)
        si strstr_f(body, "\"workspace/didChangeConfiguration\"") >= 0:
            handle_did_change_configuration(params_str)
        // cumple Manual 8 2.3: comandos IA
        si strstr_f(body, "\"synapse/aiStatus\"") >= 0:
            handle_ai_status(id_val)
        si strstr_f(body, "\"synapse/aiTranspile\"") >= 0:
            handle_ai_transpile(id_val, params_str)
        si strstr_f(body, "\"synapse/aiBindings\"") >= 0:
            handle_ai_bindings(id_val, params_str)
        si strstr_f(body, "\"synapse/aiComplete\"") >= 0:
            handle_ai_complete(id_val, params_str)
        si strstr_f(body, "\"synapse/aiFix\"") >= 0:
            handle_ai_fix(id_val, params_str)

        liberar_nodo(msg)

    retornar 0
