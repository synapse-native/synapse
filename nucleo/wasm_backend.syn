# -------------------------------------------------------------------
# Imports/Exports for JS interop
# -------------------------------------------------------------------

# Exportar una función: (export "nombre" (func $nombre))
funcion wasm_exportar_funcion(est: EstadoWasm, nombre: texto) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "(export \"" + nombre + "\" (func $" + nombre + "))"
    wasm_emitir(est, linea)

# Exportar la memoria: (export "memory" (memory 0))
funcion wasm_exportar_memoria(est: EstadoWasm, num_paginas: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "(memory " + texto(num_paginas) + ")"
    wasm_emitir(est, linea)
    linea2 = "(export \"memory\" (memory 0))"
    wasm_emitir(est, linea2)

# Importar una función de JS:
# (import "env" "func_name" (func $func_name (param i32) (result i32)))
funcion wasm_importar_funcion(est: EstadoWasm, modulo: texto, nombre: texto,
    requiere:
        est != nulo
    garantiza:
        verdadero
    num_params: entero, num_results: entero) -> nulo:
    linea = "(import \"" + modulo + "\" \"" + nombre + "\" (func $" + nombre
    i = 0
    mientras i < num_params:
        linea = linea + " (param i32)"
        i = i + 1
    si num_results > 0:
        linea = linea + " (result i32)"
    linea = linea + "))"
    wasm_emitir(est, linea)

# -------------------------------------------------------------------
# Global variables
# -------------------------------------------------------------------
funcion wasm_global_get(est: EstadoWasm, nombre: texto) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "global.get $" + nombre
    wasm_emitir(est, linea)

funcion wasm_global_set(est: EstadoWasm, nombre: texto) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "global.set $" + nombre
    wasm_emitir(est, linea)

# Declarar un global mutable:
# (global $name (mut i32) (i32.const 0))
funcion wasm_declarar_global(est: EstadoWasm, nombre: texto, tipo: texto, valor_inicial: texto) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "(global $" + nombre + " (mut " + tipo + ") (" + tipo + ".const " + valor_inicial + "))"
    wasm_emitir(est, linea)

# -------------------------------------------------------------------
# Declarar función con tipos mixtos (i32, i64, f64)
# -------------------------------------------------------------------
funcion wasm_declarar_funcion_tipos(est: EstadoWasm, nombre: texto,
    requiere:
        est != nulo
    garantiza:
        verdadero
    tipos_params: texto, num_results: entero, tipo_result: texto) -> nulo:
    linea = "(func $" + nombre + " " + tipos_params
    si num_results > 0:
        linea = linea + " (result " + tipo_result + ")"
    linea = linea + ""
    wasm_emitir(est, linea)
    wasm_indentar(est)

# -------------------------------------------------------------------
# Declarar variable local con tipo específico
# -------------------------------------------------------------------
funcion wasm_declarar_local_tipo(est: EstadoWasm, nombre: texto, tipo: texto) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "(local $" + nombre + " " + tipo + ")"
    wasm_emitir(est, linea)

# -------------------------------------------------------------------
# Programas de ejemplo extendidos
# -------------------------------------------------------------------

# Programa WASM con i64: retorna a + b como i64
funcion wasm_programa_i64(est: EstadoWasm, a: entero, b: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    wasm_iniciar_modulo(est)
    wasm_declarar_funcion_tipos(est, "main", "", 1, "i64")
    wasm_const_i64(est, a)
    wasm_const_i64(est, b)
    wasm_i64_add(est)
    wasm_retorno(est)
    wasm_finalizar_funcion(est)
    wasm_finalizar_modulo(est)

# Programa WASM con f64: retorna a + b como f64
funcion wasm_programa_f64(est: EstadoWasm, a: decimal, b: decimal) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    wasm_iniciar_modulo(est)
    wasm_declarar_funcion_tipos(est, "main", "", 1, "f64")
    wasm_const_f64(est, a)
    wasm_const_f64(est, b)
    wasm_f64_add(est)
    wasm_retorno(est)
    wasm_finalizar_funcion(est)
    wasm_finalizar_modulo(est)

# Programa WASM con memoria: almacena y carga un i32
funcion wasm_programa_memoria(est: EstadoWasm, valor: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    wasm_iniciar_modulo(est)
    wasm_exportar_memoria(est, 1)
    wasm_declarar_funcion(est, "main", 0, 1)
    # Store valor en dirección 0
    wasm_const_i32(est, valor)
    wasm_const_i32(est, 0)
    wasm_i32_store(est, 0, 4)
    # Load desde dirección 0
    wasm_const_i32(est, 0)
    wasm_i32_load(est, 0, 4)
    wasm_retorno(est)
    wasm_finalizar_funcion(est)
    wasm_finalizar_modulo(est)

# Programa WASM con importaciones de JS y exportaciones
funcion wasm_programa_js_interop(est: EstadoWasm) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    wasm_iniciar_modulo(est)
    # Importar console_log desde "env"
    wasm_importar_funcion(est, "env", "console_log", 1, 0)
    # Declarar función main que llama a console_log
    wasm_declarar_funcion(est, "main", 0, 0)
    wasm_const_i32(est, 42)
    wasm_llamar(est, "console_log")
    wasm_finalizar_funcion(est)
    # Exportar main
    wasm_exportar_funcion(est, "main")
    wasm_finalizar_modulo(est)
