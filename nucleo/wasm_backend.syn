    linea = "i32.store offset=" + texto(offset) + " align=" + texto(align)
    wasm_emitir(est, linea)

funcion wasm_i64_load(est: EstadoWasm, offset: entero, align: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "i64.load offset=" + texto(offset) + " align=" + texto(align)
    wasm_emitir(est, linea)

funcion wasm_i64_store(est: EstadoWasm, offset: entero, align: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "i64.store offset=" + texto(offset) + " align=" + texto(align)
    wasm_emitir(est, linea)

funcion wasm_f64_load(est: EstadoWasm, offset: entero, align: entero) -> nulo:
    requiere:
        est != nulo
    garantiza:
        verdadero
    linea = "f64.load offset=" + texto(offset) + " align=" + texto(align)
    wasm_emitir(est, linea)

funcion wasm_f64_store(est: EstadoWasm, offset: entero, align: entero) -> nulo:
