// cumple Manual 2 §5.1: contratos requiere/garantiza como expresiones booleanas (struct por valor no se compara con nulo)
// cumple Manual 2 §5: contratos requiere/garantiza en funciones públicas (ME formatter_fix R4: anclaje de norma vigente tras reformato)
// cumple Manual 1 §7.1 (ME formatter_fix R4): reformato cosmético del nucleo con synapse fmt — estilo, sin cambios semánticos
// vinculo ME formatter_fix R4 (Manual 1 §7.1, M8 §4.1): reformato cosmético del nucleo — estilo, sin cambios semánticos
// --- Error code constants (mirror nucleo/errores.syn) ---
constante ERR_SYNTAX_EXPECTED_TOKEN = 1
constante ERR_SYNTAX_UNEXPECTED_TOKEN = 2
constante ERR_SYNTAX_UNEXPECTED_EXPR = 3
constante ERR_SYNTAX_EXPECTED_NEWLINE = 4
constante ERR_LANG_MISSING = 5
constante ERR_LANG_UNSUPPORTED = 6
constante ERR_INDENT_INVALID = 7
constante ERR_INDENT_INCONSISTENT = 8
constante ERR_STRING_UNCLOSED = 9
constante ERR_LEX_CHAR_UNEXPECTED = 10
constante ERR_LEX = 11
constante ERR_FILE_NOT_FOUND = 12
constante ERR_CANONICAL_FORMAT = 13
constante ERR_SEM_VAR_NO_DECLARADA = 14
constante ERR_SEM_TIPO_INCOMPATIBLE = 15
constante ERR_SEM_TIPO_RETORNO = 16
constante ERR_SEM_FUNC_NO_DEFINIDA = 17
constante ERR_SEM_REDEFINICION = 18
constante ERR_SEM_ARGUMENTOS_INVALIDOS = 19
constante ERR_SEM_ESTRUCTURA_NO_DEFINIDA = 20
constante ERR_SEM_CAMPO_NO_EXISTE = 21
constante ERR_SEM_VAR_MOVIDA = 22
constante ERR_MEM_USE_AFTER_MOVE = 23 // cumple Manual 2 9: uso tras move (canonico)
constante ERR_SEM_RESULTADO_SIN_DESEMPAQUETAR = 24
constante ERR_MANIFEST_NOT_FOUND = 25
constante ERR_MODULE_STD_NOT_FOUND = 26
constante ERR_MODULE_AXON_NOT_FOUND = 27
constante ERR_DEP_NOT_DECLARED = 28
constante ERR_LOCK_HASH_MISMATCH = 29
constante ERR_GIT_FAILURE = 30
constante ERR_SEM_ASM_FUERA_INSEGURO = 31
constante ERR_SEM_CONSTANTE_INMUTABLE = 32
constante ERR_SEM_EXHAUSTIVE_MATCH_REQUIRED = 33

// --- Lifetime / Memory safety error codes (Manual 4.3) ---
constante ERR_MEM_LIFETIME_MISMATCH = 34
constante ERR_MEM_LIFETIME_CYCLE = 35

// --- Borrow checker error codes (Manual 4.2) ---
constante ERR_MEM_BORROW_CONFLICT = 39

// --- Structs ---
estructura ReporteError:
    codigo: entero
    linea: entero
    columna: entero
    mensaje: cadena

estructura GestorDiagnostico:
    reportes: ReporteError
    total_reportes: entero
    capacidad: entero
    idioma: cadena
    ruta_archivo: cadena

// --- Error reporting (output via future std.io escribir_linea) ---
funcion reportar_error(diag: GestorDiagnostico, codigo: entero, linea: entero, columna: entero, mensaje: cadena) -> nulo:
    // cumple Manual 2 §5.1: contrato de dominio
    requiere:
        1 == 1
        codigo >= 0
        linea >= 0
        columna >= 0
    garantiza:
        1 == 1
    inseguro:
        asm("if (diag.total_reportes >= diag.capacidad) return")
        asm("diag.reportes[diag.total_reportes].codigo = codigo")
        asm("diag.reportes[diag.total_reportes].linea = linea")
        asm("diag.reportes[diag.total_reportes].columna = columna")
        asm("diag.total_reportes = diag.total_reportes + 1")
    // Future: escribir_linea(mensaje) via std.io

// --- Query functions ---
funcion hay_errores(diag: GestorDiagnostico) -> booleano:
    // cumple Manual 2 §5.1: contrato de dominio
    requiere:
        1 == 1
    garantiza:
        1 == 1
    si diag.total_reportes > 0:
        retornar verdadero
    retornar falso

funcion contar_errores(diag: GestorDiagnostico) -> entero:
    // cumple Manual 2 §5.1: contrato de dominio
    requiere:
        1 == 1
    garantiza:
        _resultado_ >= -1
    retornar diag.total_reportes

funcion codigo_salida(diag: GestorDiagnostico) -> entero:
    // cumple Manual 2 §5.1: contrato de dominio
    requiere:
        1 == 1
    garantiza:
        _resultado_ >= -1
    si hay_errores(diag) == verdadero:
        retornar 1
    retornar 0

funcion resumen_errores(diag: GestorDiagnostico) -> cadena:
    // cumple Manual 2 §5.1: contrato de dominio
    requiere:
        1 == 1
    garantiza:
        1 == 1
    si hay_errores(diag) == falso:
        retornar "0 errores"
    retornar entero_a_texto(diag.total_reportes) + " error(es) encontrado(s)"
