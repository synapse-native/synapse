{
    "name": "synapse-native",
    "displayName": "Synapse Language",
    "description": "Synapse programming language support - syntax highlighting and LSP client",
    "version": "1.0.0",
    "publisher": "synapse-native",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/synapse-native/synapse"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:synapse"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "synapse",
                "aliases": [
                    "Synapse",
                    "synapse"
                ],
                "extensions": [
                    ".syn"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "synapse",
                "scopeName": "source.synapse",
                "path": "./synapse.tmLanguage.json"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./tsconfig.json",
        "package": "vsce package"
    },
    "dependencies": {
        "vscode-languageclient": "^9.0.1"
    },
    "devDependencies": {
        "@types/vscode": "^1.85.0",
        "typescript": "^5.3.0"
    }
}
