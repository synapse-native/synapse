#lang: es
// opensyn/permisos.syn — Matriz de permisos + sandbox (M7 §7.3)
// cumple Manual 7 §7.3: "Sandboxing: El servidor de inferencia se ejecuta con permisos mínimos"
// cumple Manual 7 §1.1: sandboxing local — los TOOLS del agente solo acceden al workspace, sin red externa
// cumple Manual 7 §1.1: "Cero telemetría: No envía datos a ningún servidor externo."

importar std.io
importar std.texto
importar std.sistema

// ============================================================
// Constantes
// ============================================================

constante PERMISO_ALLOW = 0
constante PERMISO_ASK = 1
constante PERMISO_DENY = 2
constante MAX_HERRAMIENTAS = 8

// ============================================================
// Estructuras (arrays planos — Synapse no soporta [Struct] nativo)
// ============================================================

estructura MatrizPermisos:
    cantidades: entero
    workspace_path: texto

// ============================================================
// R6: Nombre de herramienta por índice (M7 §7.3)
// ============================================================

// Retorna el nombre de la herramienta en el índice dado.
// cumple Manual 7 §1.1: agente local con permisos mínimos, escrituras confinadas al workspace del usuario
funcion nombre_herramienta(idx: entero) -> texto:
    requiere:
        idx >= 0 y idx < MAX_HERRAMIENTAS
    garantiza:
        longitud(_resultado_) > 0 // cumple Manual 2 §5.1
    si idx == 0: retornar "listar"
    si idx == 1: retornar "leer"
    si idx == 2: retornar "git"
    si idx == 3: retornar "plan"
    si idx == 4: retornar "editar"
    si idx == 5: retornar "compilar"
    si idx == 6: retornar "diagnosticar"
    si idx == 7: retornar "delegar"
    retornar ""

// ============================================================
// R6: Nivel de permiso por índice (M7 §7.3)
// ============================================================

// Retorna el nivel (ALLOW/ASK/DENY) de la herramienta en el índice dado.
// cumple Manual 7 §1.1: agente local con permisos mínimos, escrituras confinadas al workspace del usuario
funcion nivel_permiso(idx: entero) -> entero:
    requiere:
        idx >= 0 y idx < MAX_HERRAMIENTAS
    garantiza:
        _resultado_ >= PERMISO_ALLOW y _resultado_ <= PERMISO_DENY // cumple Manual 2 §5.1
    // listar=ALLOW, leer=ALLOW, git=ALLOW, plan=ASK, editar=ASK,
    // compilar=ALLOW, diagnosticar=ALLOW, delegar=ALLOW
    si idx == 0: retornar PERMISO_ALLOW
    si idx == 1: retornar PERMISO_ALLOW
    si idx == 2: retornar PERMISO_ALLOW
    si idx == 3: retornar PERMISO_ASK
    si idx == 4: retornar PERMISO_ASK
    si idx == 5: retornar PERMISO_ALLOW
    si idx == 6: retornar PERMISO_ALLOW
    si idx == 7: retornar PERMISO_ALLOW
    retornar PERMISO_DENY

// ============================================================
// R6: Verificar permiso de herramienta (M7 §7.3)
// ============================================================

// Verifica si una herramienta está permitida.
// Retorna PERMISO_ALLOW, PERMISO_ASK o PERMISO_DENY.
// cumple Manual 7 §1.1: el servidor local se ejecuta con los permisos mínimos del usuario
funcion verificar_permiso_herramienta(matriz: MatrizPermisos, herramienta: texto) -> entero:
    requiere:
        matriz.cantidades > 0
        longitud(herramienta) > 0
    garantiza:
        _resultado_ >= PERMISO_ALLOW y _resultado_ <= PERMISO_DENY // cumple Manual 2 §5.1
    i = 0
    mientras i < MAX_HERRAMIENTAS:
        nombre = nombre_herramienta(i)
        si str_eq_f(nombre, _syn_strcpy(herramienta)):
            retornar nivel_permiso(i)
        i = i + 1
    retornar PERMISO_DENY

// ============================================================
// R6: Verificar ruta en workspace (M7 §7.3)
// ============================================================

// Verifica que una ruta está dentro del workspace (confinamiento).
// Valida que el caracter post-prefijo sea separador o fin de cadena.
// cumple Manual 7 §1.1: escrituras confinadas al workspace del usuario (sin rutas del sistema)
funcion es_ruta_en_workspace(ruta: texto, workspace: texto) -> booleano:
    requiere:
        longitud(ruta) > 0
        longitud(workspace) > 0
    garantiza:
        _resultado_ == verdadero o _resultado_ == falso // cumple Manual 2 §5.1
    longitud_ws = longitud(workspace)
    longitud_ruta = longitud(ruta)
    si longitud_ruta < longitud_ws:
        retornar falso
    i = 0
    mientras i < longitud_ws:
        si ruta[i] != workspace[i]:
            retornar falso
        i = i + 1
    // Validar separador post-prefijo (anti-bypass)
    si longitud_ruta == longitud_ws:
        retornar verdadero
    // cumple Manual 7 §1.1: el sandbox valida rutas dentro del workspace del usuario (agente local, sin nube).
    // cumple Manual 2 §3: 'siguiente' es palabra reservada (T_SIGUIENTE); se renombra el identificador.
    // cumple Manual 7 §2.3: reglas de sintaxis estricta de Synapse en el agente (indexar texto produce texto; comparar contra caracter, no contra codigo ASCII).
    car_sep = ruta[longitud_ws]
    si car_sep == "/" o car_sep == "\\":
        retornar verdadero
    retornar falso

// ============================================================
// R6: Verificar permiso completo (M7 §7.3)
// ============================================================

// Verificación completa: herramienta + ruta en workspace (solo escritura).
// Retorna PERMISO_ALLOW, PERMISO_ASK o PERMISO_DENY.
// cumple Manual 7 §1.1: sandboxing local — permisos mínimos + workspace only
funcion verificar_permiso_completo(matriz: MatrizPermisos, herramienta: texto, ruta: texto) -> entero:
    requiere:
        matriz.cantidades > 0
        longitud(herramienta) > 0
    garantiza:
        _resultado_ >= PERMISO_ALLOW y _resultado_ <= PERMISO_DENY // cumple Manual 2 §5.1
    nivel = verificar_permiso_herramienta(matriz, _syn_strcpy(herramienta))
    si nivel == PERMISO_DENY:
        retornar PERMISO_DENY
    // Confinar al workspace para herramientas de escritura (ASK) y lectura
    // con ruta explícita — previene lectura de archivos sensibles del sistema.
    si longitud(ruta) > 0:
        si nivel == PERMISO_ASK:
            en_workspace = es_ruta_en_workspace(_syn_strcpy(ruta), _syn_strcpy(matriz.workspace_path))
            si en_workspace == falso:
                retornar PERMISO_DENY
        // Para herramientas ALLOW con ruta explícita (leer, listar),
        // verificar que no accedan a rutas del sistema fuera del workspace
        si nivel == PERMISO_ALLOW:
            // Permitir cwd y subdirectorios del workspace
            en_workspace = es_ruta_en_workspace(_syn_strcpy(ruta), _syn_strcpy(matriz.workspace_path))
            si en_workspace == falso:
                // Permitir si es una ruta relativa sin prefijo de unidad
                tiene_unidad = 0
                si longitud(ruta) >= 2:
                    segundo = subcadena(ruta, 1, 1)
                    si segundo == ":":
                        tiene_unidad = 1
                si tiene_unidad == 1:
                    retornar PERMISO_DENY
    retornar nivel

// ============================================================
// R6: Nombre legible del nivel (M7 §7.3)
// ============================================================

// Retorna el nombre legible de un nivel de permiso.
// cumple Manual 7 §1.1: feedback claro al usuario cuando un TOOL es denegado por el sandbox
funcion nombre_permiso(nivel: entero) -> texto:
    requiere:
        nivel >= PERMISO_ALLOW y nivel <= PERMISO_DENY
    garantiza:
        longitud(_resultado_) > 0 // cumple Manual 2 §5.1
    si nivel == PERMISO_ALLOW:
        retornar "allow"
    si nivel == PERMISO_ASK:
        retornar "ask"
    retornar "deny"

// ============================================================
// R6: Crear matriz (M7 §7.3)
// ============================================================

// Crea la matriz de permisos por defecto.
// cumple Manual 7 §1.1: agente local con permisos mínimos, escrituras confinadas al workspace del usuario
funcion matriz_permisos_crear() -> MatrizPermisos:
    requiere:
        verdadero
    garantiza:
        _resultado_.cantidades == MAX_HERRAMIENTAS // cumple Manual 2 §5.1
    matriz = MatrizPermisos()
    matriz.cantidades = MAX_HERRAMIENTAS
    matriz.workspace_path = _syn_obtener_cwd()
    retornar matriz

// ============================================================
// Funciones auxiliares (puentes al runtime)
// ============================================================

// Comparación de cadenas byte a byte.
// cumple Manual 2 §12: toda función pública tiene contrato
funcion str_eq_f(a: texto, b: texto) -> booleano:
    requiere:
        longitud(a) > 0
        longitud(b) > 0
    garantiza:
        _resultado_ == verdadero o _resultado_ == falso // cumple Manual 2 §5.1
    si longitud(a) != longitud(b):
        retornar falso
    i = 0
    mientras i < longitud(a):
        si a[i] != b[i]:
            retornar falso
        i = i + 1
    retornar verdadero
