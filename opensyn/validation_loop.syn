#lang: es
// opensyn/validation_loop.syn — Bucle de corrección automática (M7 §6.3)
// cumple Manual 7 §6.3: "bucle de validación y corrección automática orquestado por el LSP"
// cumple Manual 7 §4.2: "El LSP es el responsable de orquestar el bucle de validación"
// cumple Manual 7 §8: "El LSP valida con synapse check --no-emit"

importar std.io
importar std.texto
importar std.sistema

// --- Cliente Ollama (runtime/core/ollama.c) ---
// cumple Manual 7 §8: consultar oraculo local via HTTP (8088)
externo funcion _syn_ollama_consultar(modelo: texto, prompt: texto, host: texto, puerto: entero, max_tokens: entero) -> texto
externo funcion _syn_ollama_modelos(host: texto, puerto: entero) -> texto

// ============================================================
// Constantes del bucle de validación
// ============================================================

constante MAX_INTENTOS = 3
constante RUTA_FEEDBACK = "~/.opensyn/feedback.jsonl"

// ============================================================
// Estructuras de datos
// ============================================================

estructura ErrorCompilacion:
    linea: entero
    columna: entero
    mensaje: texto
    archivo: texto

estructura ResultadoValidacion:
    es_valido: booleano
    errores: texto
    intentos_realizados: entero

estructura RevisionInline:
    archivo: texto
    linea: entero
    columna: entero
    diff: texto
    sugerencia: texto

// ============================================================
// R4: Validar código con --check (M7 §6.3)
// ============================================================

// Ejecuta `synapse check --no-emit` sobre código y retorna si compila.
// cumple Manual 7 §6.3: "El LSP pasa el código al compilador en modo --check"
funcion validar_con_check(codigo: texto, idioma: texto) -> ResultadoValidacion:
    requiere:
        longitud(codigo) > 0
    garantiza:
        _resultado_.intentos_realizados == 0 // cumple Manual 2 §5.1
    resultado = ResultadoValidacion()
    resultado.es_valido = verdadero
    resultado.errores = ""
    resultado.intentos_realizados = 0
    ruta_temp = concat(_syn_obtener_cwd(), "\\opensyn_validacion.tmp")
    escribir_archivo_local(ruta_temp, codigo)
    comando = concat("synapse check --no-emit ", ruta_temp)
    salida = _syn_capturar_comando(comando)
    eliminar_archivo_local(ruta_temp)
    si salida != "":
        resultado.es_valido = falso
        resultado.errores = salida
    retornar resultado

// ============================================================
// R4: Reconstruir prompt con error (M7 §6.3)
// ============================================================

// Añade el error del compilador al prompt para que la IA lo corrija.
// cumple Manual 7 §6.3: "El código anterior tiene el siguiente error: {mensaje_error}. Por favor, corrígelo."
funcion reconstruir_prompt_con_error(prompt_original: texto, error: ErrorCompilacion) -> texto:
    requiere:
        longitud(prompt_original) > 0
    garantiza:
        longitud(_resultado_) > longitud(prompt_original) // cumple Manual 2 §5.1
    mensaje = "El código anterior tiene el siguiente error: "
    mensaje = concat(mensaje, error.mensaje)
    ubicacion = " (línea "
    ubicacion = concat(ubicacion, entero_a_texto(error.linea))
    ubicacion = concat(ubicacion, ", columna ")
    ubicacion = concat(ubicacion, entero_a_texto(error.columna))
    ubicacion = concat(ubicacion, ")")
    instruccion = ". Por favor, corrígelo."
    prompt_correccion = prompt_original
    prompt_correccion = concat(prompt_correccion, "\n\n")
    prompt_correccion = concat(prompt_correccion, mensaje)
    prompt_correccion = concat(prompt_correccion, ubicacion)
    prompt_correccion = concat(prompt_correccion, instruccion)
    retornar prompt_correccion

// ============================================================
// R4: Guardar feedback humano (M7 §6.3)
// ============================================================

// Guarda pares (instrucción, código_corregido) en feedback.jsonl.
// cumple Manual 7 §6.3: "OpenSyn guarda el par (instrucción, código_corregido) en ~/.opensyn/feedback.jsonl"
funcion guardar_feedback(instruccion: texto, codigo_corregido: texto) -> entero:
    requiere:
        longitud(instruccion) > 0
    garantiza:
        _resultado_ == 0 o _resultado_ == -1 // cumple Manual 2 §5.1
    ruta = RUTA_FEEDBACK
    linea_json = "{\"instruction\": \""
    linea_json = concat(linea_json, escape_json_local(instruccion))
    linea_json = concat(linea_json, "\", \"output\": \"")
    linea_json = concat(linea_json, escape_json_local(codigo_corregido))
    linea_json = concat(linea_json, "\"}")
    exito = agregar_a_archivo_local(ruta, linea_json)
    si exito == 1:
        retornar 0
    retornar -1

// ============================================================
// R10: Review de alta señal (M7 §8)
// ============================================================

// Verifica que el código compila + integra con el catálogo de APIs.
// cumple Manual 7 §8: "El LSP valida con synapse check --no-emit"
funcion review_compilar(codigo: texto, idioma: texto) -> ResultadoValidacion:
    requiere:
        longitud(codigo) > 0
    garantiza:
        _resultado_.intentos_realizados == 0 // cumple Manual 2 §5.1
    resultado = validar_con_check(codigo, idioma)
    retornar resultado

// ============================================================
// R5: Revisión inline con archivo+línea+diff (M7 §4.2)
// ============================================================

// Retorna la ubicación exacta del error para que la revision cite código exacto.
// cumple Manual 7 §4.2: "la respuesta del LSP incluye archivo+linea+diff"
// Nota: la implementación completa está en router.syn:revisar_codigo_inline()
// Esta función es un wrapper que delega al router para evitar duplicación.
funcion revisar_codigo_inline(codigo: texto, error: ErrorCompilacion) -> RevisionInline:
    requiere:
        longitud(codigo) > 0
    garantiza:
        longitud(_resultado_.archivo) >= 0 // cumple Manual 2 §5.1
    rev = RevisionInline()
    rev.archivo = error.archivo
    rev.linea = error.linea
    rev.columna = error.columna
    rev.diff = error.mensaje
    rev.sugerencia = "Corrige el error en línea "
    rev.sugerencia = concat(rev.sugerencia, entero_a_texto(error.linea))
    rev.sugerencia = concat(rev.sugerencia, ": ")
    rev.sugerencia = concat(rev.sugerencia, error.mensaje)
    retornar rev

// ============================================================
// R4: Bucle principal de validación (M7 §6.3)
// ============================================================

// Bucle de hasta MAX_INTENTOS para corregir código generado.
// cumple Manual 7 §6.3: "bucle de validación y corrección automática"
funcion bucle_validacion(prompt_inicial: texto, idioma: texto) -> texto:
    requiere:
        longitud(prompt_inicial) > 0
    garantiza:
        longitud(_resultado_) >= 0 // cumple Manual 2 §5.1
    codigo_actual = ""
    error_msj = ""
    intentos = 0
    codigo_generado = generar_codigo_ia(prompt_inicial)
    codigo_actual = codigo_generado
    validacion = validar_con_check(codigo_generado, idioma)
    si validacion.es_valido:
        retornar codigo_actual
    error_msj = validacion.errores
    intentos = 1
    mientras intentos < MAX_INTENTOS:
        error = ErrorCompilacion()
        error.linea = 0
        error.columna = 0
        error.mensaje = error_msj
        error.archivo = ""
        prompt_correccion = reconstruir_prompt_con_error(prompt_inicial, error)
        nuevo_codigo = generar_codigo_ia(prompt_correccion)
        codigo_actual = nuevo_codigo
        nueva_validacion = validar_con_check(nuevo_codigo, idioma)
        si nueva_validacion.es_valido:
            retornar codigo_actual
        error_msj = nueva_validacion.errores
        intentos = intentos + 1
    guardar_feedback(prompt_inicial, codigo_actual)
    mensaje_fallo = "No se pudo generar código válido automáticamente. "
    mensaje_fallo = concat(mensaje_fallo, "Intenta ajustar la instrucción o corrige manualmente. ")
    mensaje_fallo = concat(mensaje_fallo, "Errores: ")
    mensaje_fallo = concat(mensaje_fallo, error_msj)
    retornar mensaje_fallo

// ============================================================
// Funciones auxiliares (puentes al runtime)
// ============================================================

funcion escribir_archivo_local(ruta: texto, contenido: texto) -> nulo:
    requiere:
        longitud(ruta) > 0
    garantiza:
        verdadero
    inseguro:
        asm("CadenaSegura _esr = {.datos = (char*)ruta.datos, .longitud = ruta.longitud}; CadenaSegura _esc = {.datos = (char*)contenido.datos, .longitud = contenido.longitud}; _syn_escribir_archivo(_esr, _esc);")

funcion eliminar_archivo_local(ruta: texto) -> nulo:
    requiere:
        longitud(ruta) > 0
    garantiza:
        verdadero
    inseguro:
        asm("CadenaSegura _er = {.datos = (char*)ruta.datos, .longitud = ruta.longitud}; _syn_eliminar_archivo(_er);")

funcion agregar_a_archivo_local(ruta: texto, contenido: texto) -> entero:
    requiere:
        longitud(ruta) > 0
    garantiza:
        _resultado_ == 0 o _resultado_ == -1 // cumple Manual 2 §5.1
    // Leer contenido existente, anadir linea, reescribir
    existente = ""
    inseguro:
        asm("CadenaSegura _aer = {.datos = (char*)ruta.datos, .longitud = ruta.longitud}; CadenaSegura _aec = _syn_leer_archivo(_aer); if(_aec.longitud>0) existente = _aec;")
    nueva_linea = concat(contenido, "\n")
    completo = concat(existente, nueva_linea)
    inseguro:
        asm("CadenaSegura _aew = {.datos = (char*)ruta.datos, .longitud = ruta.longitud}; CadenaSegura _aewc = {.datos = (char*)completo.datos, .longitud = completo.longitud}; _syn_escribir_archivo(_aew, _aewc);")
    retornar 0

funcion escape_json_local(t: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(_resultado_) >= 0 // cumple Manual 2 §5.1
    // Escapar comillas dobles para JSON seguro
    resultado = ""
    total = longitud(t)
    i = 0
    mientras i < total:
        c = subcadena(t, i, 1)
        si c == "\"":
            resultado = concat(resultado, "\\\"")
        sino si c == "\\":
            resultado = concat(resultado, "\\\\")
        sino si c == "\n":
            resultado = concat(resultado, "\\n")
        sino si c == "\r":
            resultado = concat(resultado, "\\r")
        sino si c == "\t":
            resultado = concat(resultado, "\\t")
        sino:
            resultado = concat(resultado, c)
        i = i + 1
    retornar resultado

funcion generar_codigo_ia(prompt: texto) -> texto:
    requiere:
        longitud(prompt) > 0
    garantiza:
        longitud(_resultado_) >= 0 // cumple Manual 2 §5.1
    // C12: conectar con Ollama local (Manual 7 §8)
    modelo = "qwen2.5-coder:1.5b"
    host = "127.0.0.1"
    puerto = 8088
    max_tokens = 2048
    // Intentar leer modelo de config_ollama.txt
    config_ruta = ""
    cwd = _syn_obtener_cwd()
    si cwd != "":
        config_ruta = concat(cwd, "/config_ollama.txt")
    config_contenido = ""
    inseguro:
        asm("CadenaSegura _cr = {.datos = (char*)config_ruta.datos, .longitud = config_ruta.longitud}; CadenaSegura _cc = _syn_leer_archivo(_cr); if(_cc.longitud>0) config_contenido = _cc;")
    si config_contenido != "":
        // Buscar linea "model=..."
        i = 0
        largo = longitud(config_contenido)
        mientras i < largo:
            si subcadena(config_contenido, i, 6) == "model=":
                inicio = i + 6
                fin = inicio
                mientras fin < largo:
                    si subcadena(config_contenido, fin, 1) == "\n" o subcadena(config_contenido, fin, 1) == "\r":
                        romper
                    fin = fin + 1
                si fin > inicio:
                    modelo = subcadena(config_contenido, inicio, fin - inicio)
                romper
            i = i + 1
    // Consultar Ollama
    respuesta = _syn_ollama_consultar(modelo, prompt, host, puerto, max_tokens)
    retornar respuesta
