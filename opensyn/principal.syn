#lang: es
// opensyn/principal.syn — Interruptor de Soberania (v1.1.0)
// First-Run Experience: .synapse_config decide modo compilador vs oraculo IA
//   - Modo Lenguaje Puro: compila archivos .syn directamente
//   - Modo Oraculo: genera y compila codigo via LLM local

importar std.io
importar std.sistema
importar std.oraculo
importar std.modelo
importar std.texto
importar std.tiempo
// R149-R9: modulo local del agente (matriz de permisos + sandbox, Manual 7 §7.3)
importar permisos
// ME r204: herramientas de escritura/edicion del agente (Manual 7 §1.1/§7.3).
importar herramientas
// ME r217_loop_integracion: cableado de validation_loop y pipeline al loop vivo.
// cumple Manual 7 §2.1
importar validation_loop
importar pipeline_multiagente
// ME r254_sesiones_undo (reasignado de r218_sesiones_undo): sesiones
// reanudables con checkpoint, reanudar y revertir en el loop vivo.
// cumple Manual 7 §4.3
importar run_manager

constante ARCHIVO_CONFIG = ".synapse_config"

// --- Cliente Ollama local (runtime/core/ollama.c) ---
// cumple Manual 7 §2.1: consulta al oraculo local via HTTP (8088)
// (declaraciones externas provistas por `importar validation_loop`, ME r217)
// --- Herramientas del agente (Manual 7 §2.3: contexto del codigo local) ---
// cumple Manual 7 §2.3: std.texto ya exporta _syn_texto_longitud.
