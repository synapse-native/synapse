#lang: es
// opensyn/principal.syn — Interruptor de Soberania (v1.1.0)
// First-Run Experience: .synapse_config decide modo compilador vs oraculo IA
//   - Modo Lenguaje Puro: compila archivos .syn directamente
//   - Modo Oraculo: genera y compila codigo via LLM local

importar std.io
importar std.sistema
importar std.oraculo
importar std.modelo
importar std.texto

constante ARCHIVO_CONFIG = ".synapse_config"

// --- Cliente Ollama local (runtime/core/ollama.c) ---
// cumple Manual 7 §8: consulta al oraculo local via HTTP (11434)
externo funcion _syn_ollama_consultar(modelo: texto, prompt: texto, host: texto, puerto: entero, max_tokens: entero) -> texto

// --- Funciones auxiliares de configuracion ---

funcion leer_modo_config() -> texto:
    // cumple Manual 7 §8: buscar config en cwd, luego en HOME y en app (instalador pre-configura)
    contenido = leer_archivo(ARCHIVO_CONFIG)
    si contenido == "":
        // Fallback via _syn_leer_archivo directo (bypass _validar_ruta_segura cwd-only) — cumple Manual 7 §8
        home = obtener_env("USERPROFILE")
        ruta_home = concat(home, "\\.synapse_config")
        inseguro:
            asm("CadenaSegura _rh = {.datos = (char*)ruta_home.datos, .longitud = ruta_home.longitud}; CadenaSegura _ch = _syn_leer_archivo(_rh); contenido = _ch;")
        si contenido == "":
            inseguro:
                asm("CadenaSegura _rp = {.datos = (char*)\"C:\\\\Program Files\\\\Synapse\\\\.synapse_config\", .longitud = 38}; CadenaSegura _cp = _syn_leer_archivo(_rp); if(_cp.longitud>0) contenido = _cp;")
        si contenido == "":
            inseguro:
                asm("CadenaSegura _rp2 = {.datos = (char*)\"C:\\\\Program Files\\\\Synapse\\\\opensyn\\\\.synapse_config\", .longitud = 45}; CadenaSegura _cp2 = _syn_leer_archivo(_rp2); if(_cp2.longitud>0) contenido = _cp2;")
    // Ollama config creado por instalador implica modo oraculo aunque no haya .synapse_config aun
    si contenido == "":
        es_ollama = 0
        inseguro:
            asm("CadenaSegura _ro = {.datos = (char*)\"C:\\\\Program Files\\\\Synapse\\\\opensyn\\\\config_ollama.txt\", .longitud = 46}; if(_syn_existe_archivo(_ro)==1) es_ollama=1;")
        si es_ollama == 1:
            retornar "oraculo"
        home2 = obtener_env("USERPROFILE")
        ruta_ollama_home = concat(home2, "\\.opensyn\\config_ollama.txt")
        es_ollama2 = 0
        inseguro:
            asm("CadenaSegura _rh2 = {.datos = (char*)ruta_ollama_home.datos, .longitud = ruta_ollama_home.longitud}; if(_syn_existe_archivo(_rh2)==1) es_ollama2=1;")
        si es_ollama2 == 1:
            retornar "oraculo"
    si contenido == "":
        retornar ""
    si contenido == "modo_oraculo=verdadero" o contenido == "modo_oraculo=true":
        retornar "oraculo"
    retornar "compilador"

funcion guardar_modo_config(modo: texto) -> entero:
    linea = concat("modo_oraculo=", modo)
    retornar escribir_archivo(ARCHIVO_CONFIG, linea)

// --- Menu de Inicializacion de Entorno Soberano ---

funcion mostrar_menu_bienvenida() -> texto:
    escribir_linea("============================================")
    escribir_linea("  OPEN Synapse v1.1.0  -  ENTORNO SOBERANO")
    escribir_linea("============================================")
    escribir_linea("")
    escribir_linea("  Synapse: lenguaje de sistemas soberano")
    escribir_linea("  con compilacion nativa a C.")
    escribir_linea("")
    escribir_linea("  Selecciona tu modo de operacion:")
    escribir_linea("")
    escribir_linea("    [1] Modo Lenguaje Puro")
    escribir_linea("        Compilador Synapse standalone.")
    escribir_linea("        Ideal para desarrolladores C/Rust.")
    escribir_linea("        Sin consumo extra de recursos.")
    escribir_linea("")
    escribir_linea("    [2] Modo Oraculo (IA Local)")
    escribir_linea("        Orquestador autonomo con LLM local.")
    escribir_linea("        El modelo escribe y corrige codigo")
    escribir_linea("        por ti. Requiere modelo GGUF.")
    escribir_linea("")
    escribir_linea("  Opcion [1/2]: ")

    entrada = leer_linea()

    mientras entrada != "1" y entrada != "2":
        escribir_linea("  Entrada invalida. Ingresa 1 o 2.")
        escribir_linea("  Opcion [1/2]: ")
        entrada = leer_linea()

    retornar entrada

// --- Modo Compilador Puro ---

funcion modo_compilador() -> entero:
    escribir_linea("")
    escribir_linea("=== Synapse: Modo Lenguaje Puro ===")
    escribir_linea("")

    si _argc() < 2:
        escribir_linea("Uso: opensyn <archivo.syn>")
        escribir_linea("")
        escribir_linea("Ejemplos:")
        escribir_linea("  opensyn programa.syn")
        escribir_linea("  opensyn main.syn")
        escribir_linea("")
        escribir_linea("Tambien disponible via Python:")
        escribir_linea("  python main.py <archivo.syn>")
        escribir_linea("")
        escribir_linea("Documentacion: https://synapse-native.github.io/synapse/")
        escribir_linea("")
        retornar 0

    ruta = _argv(1)
    escribir_linea(concat("  Compilando: ", ruta))
    escribir_linea("")

    fuente = leer_archivo(ruta)
    si fuente == "":
        escribir_linea(concat("  [Error] No se pudo leer: ", ruta))
        retornar 1

    res = compilar_codigo(fuente)
    si res == 0:
        codigo_c = obtener_codigo_generado()
        nombre_c = concat(ruta, ".c")
        escribir_archivo(nombre_c, codigo_c)
        escribir_linea("  [OK] Compilacion exitosa.")
        escribir_linea(concat("  [OK] Codigo C generado: ", nombre_c))
        escribir_linea("")
        escribir_linea("  Para compilar a binario nativo:")
        escribir_linea(concat(concat("    gcc -o programa.exe ", nombre_c), " synapse_rt.o -lws2_32"))
        escribir_linea("")
        retornar 0

    error_msg = obtener_error_compilacion()
    linea_err = obtener_linea_error()
    escribir_linea(concat(concat(concat("  [Error] Linea ", entero_a_texto(linea_err)), ": "), error_msg))
    escribir_linea("")
    retornar 1

// --- Configuracion Ollama (config_ollama.txt que escribe el instalador) ---

funcion leer_archivo_sin_validar(ruta: texto) -> texto:
    requiere:
        longitud(ruta) > 0
    garantiza:
        longitud(resultado) >= 0
    contenido = ""
    inseguro:
        asm("CadenaSegura _rl = {.datos = (char*)ruta.datos, .longitud = ruta.longitud}; CadenaSegura _cl = _syn_leer_archivo(_rl); if(_cl.longitud>0) contenido = _cl;")
    retornar contenido

funcion leer_config_ollama() -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(resultado) >= 0
    // cumple Manual 9 §5: el instalador escribe config_ollama.txt con ollama=1 + model=
    // leer_archivo() valida la ruta contra cwd y rechaza relativas; leer absoluta via asm.
    contenido = ""
    cwd_act = _syn_obtener_cwd()
    si cwd_act != "":
        ruta_cwd = concat(cwd_act, "/config_ollama.txt")
        contenido = leer_archivo_sin_validar(ruta_cwd)
    si contenido == "":
        home = obtener_env("USERPROFILE")
        ruta_home = concat(home, "\\.opensyn\\config_ollama.txt")
        contenido = leer_archivo_sin_validar(ruta_home)
    si contenido == "":
        ruta_app = "C:\\Program Files\\Synapse\\opensyn\\config_ollama.txt"
        contenido = leer_archivo_sin_validar(ruta_app)
    retornar contenido

funcion obtener_modelo_config(config: texto) -> texto:
    requiere:
        verdadero
    garantiza:
        longitud(resultado) >= 0
    si config == "":
        retornar ""
    idx = strstr_f(config, "model=")
    si idx < 0:
        retornar ""
    inicio = idx + 6
    total = strlen_s(config)
    fin = inicio
    mientras fin < total:
        letra = subcadena(config, fin, 1)
        si letra == "\r" o letra == "\n":
            romper
        fin = fin + 1
    si fin <= inicio:
        retornar ""
    retornar subcadena(config, inicio, fin - inicio)

// --- Modo Oraculo (IA Local) ---

funcion modo_oraculo() -> entero:
    escribir_linea("")
    escribir_linea("=== OpenSyn: Modo Oraculo (IA Local) ===")
    escribir_linea("")
    // cumple Manual 7 §8 + Manual 9 §5: Ollama primero (config_ollama.txt del
    // instalador, http://localhost:11434); GGUF local como respaldo.
    config = leer_config_ollama()
    si config != "":
        // Chat interactivo real con Ollama (no es un placeholder)
        modelo = obtener_modelo_config(config)
        si modelo == "":
            modelo = "qwen-coder"
        escribir_linea("  [OK] Ollama detectada — http://localhost:11434")
        escribir_linea(concat("  [OK] Modelo: ", modelo))
        escribir_linea("")
        escribir_linea("  [Chat] Escribe tu prompt y presiona Enter (salir para terminar):")
        escribir_linea("")
        escribir_linea(concat("  Hola! Soy OpenSyn. ¿En qué puedo ayudarte a codificar en Synapse? (modelo: ", concat(modelo, ")")))
        escribir_linea("")
        mientras verdadero:
            escribir_linea("  Tu> ")
            prompt = leer_linea()
            si prompt == "salir" o prompt == "exit":
                escribir_linea("")
                escribir_linea("  Hasta luego!")
                escribir_linea("")
                retornar 0
            si prompt == "":
                siguiente
            respuesta = _syn_ollama_consultar(modelo, prompt, "127.0.0.1", 11434, 1024)
            si respuesta == "":
                escribir_linea("  [Error] No hubo respuesta de Ollama. Verifica que este activo:")
                escribir_linea("    ollama serve")
            sino:
                escribir_linea("")
                escribir_linea(concat("  OpenSyn> ", respuesta))
            escribir_linea("")
        retornar 0

    // --- Sin configuracion Ollama: buscar modelo GGUF local ---
    escribir_linea("  [*] Ollama no detectado; buscando modelo GGUF local...")
    escribir_linea("")
    ruta_modelo = "modelo_synapse.gguf"
    ctx = _syn_modelo_cargar(ruta_modelo)
    si ctx == nulo:
        ctx = _syn_modelo_cargar("C:\\Program Files\\Synapse\\opensyn\\models\\deepseek-coder-1.3b-Q4_K_M.gguf")
    si ctx == nulo:
        ctx = _syn_modelo_cargar("C:\\Program Files\\Synapse\\opensyn\\models\\codellama-7b-Q4_K_M.gguf")
    si ctx == nulo:
        escribir_linea("  [!] No se encontro 'modelo_synapse.gguf' ni en {app}\\opensyn\\models")
        escribir_linea("  [!] El modo Oraculo requiere un modelo GGUF o Ollama.")
        escribir_linea("")
        escribir_linea("  Descarga un modelo compatible (ej. Qwen2.5-Coder-0.5B)")
        escribir_linea("  y colocalo como 'modelo_synapse.gguf' en la raiz.")
        escribir_linea("  O usa Ollama: ollama run qwen-coder")
        escribir_linea("")
        escribir_linea("  Luego ejecuta: opensyn")
        escribir_linea("")
        si _argc() >= 2 y _argv(1) == "--download-model":
            escribir_linea("  [*] Iniciando descarga del modelo por defecto...")
            res = ejecutar_comando("python opensyn/download_model.py")
            si res == 0:
                escribir_linea("  [OK] Modelo descargado. Re-ejecuta el orquestador.")
                retornar 0
            escribir_linea("  [Error] Fallo la descarga automatica.")
            retornar 1
        retornar 1

    escribir_linea("  [OK] Modelo cargado exitosamente.")
    escribir_linea("")

    prompt = "Escribe un programa en Synapse que abra un archivo llamado 'reporte.txt', escriba la frase 'Soberania Digital' dentro de el, y lo cierre. Usa la libreria std.fs y std.io."

    escribir_linea("[Oraculo] Iniciando generacion de codigo...")
    escribir_linea(concat("  Prompt: ", prompt))
    escribir_linea("")

    codigo_generado = generar_codigo(ctx, prompt, 3)
    _syn_modelo_cerrar(ctx)

    escribir_linea("")
    si codigo_generado != "":
        escribir_linea("  [OK] Codigo generado y compilado exitosamente.")
        res_guardar = escribir_archivo("generado.syn", codigo_generado)
        si res_guardar == 0:
            escribir_linea("  [OK] Codigo fuente guardado en 'generado.syn'")
        retornar 0

    escribir_linea("  [Error] No se pudo generar codigo valido tras 3 intentos.")
    retornar 1

// --- Subcommands del Orquestador ---

// cumple Manual 7 §8: status muestra el estado del entorno Soberania
// cumple Manual 2 §12: contratos requiere/garantiza
funcion cmd_status() -> entero:
    requiere:
        verdadero
    garantiza:
        resultado == 0 o resultado == 1
    escribir_linea("=== OpenSyn: Estado del Sistema ===")
    escribir_linea("")

    // Verificar configuracion
    si existe_archivo(".synapse_config"):
        config = leer_archivo(".synapse_config")
        escribir_linea(concat("  Config: ", config))
    sino:
        escribir_linea("  Config: No configurado (primera ejecucion)")

    // Verificar runtime Synapse
    escribir_linea("  Synapse runtime: OK (compilado y ejecutandose)")

    // Verificar modelo IA (opcional)
    si existe_archivo("modelo_synapse.gguf"):
        escribir_linea("  Modelo IA: modelo_synapse.gguf [OK]")
    sino:
        escribir_linea("  Modelo IA: No encontrado (modo IA deshabilitado)")

    // Verificar directorio de trabajo
    cwd = _syn_obtener_cwd()
    escribir_linea(concat("  Directorio: ", cwd))

    escribir_linea("")
    escribir_linea("  Comandos disponibles:")
    escribir_linea("    opensyn <archivo.syn>   - Compilar archivo Synapse")
    escribir_linea("    opensyn chat [modelo]   - Iniciar agente IA conversacional")
    escribir_linea("    opensyn explain <arch>  - Explicar codigo con IA")
    escribir_linea("    opensyn generate <txt>  - Generar codigo con IA")
    escribir_linea("    opensyn status          - Mostrar este estado")
    escribir_linea("")
    retornar 0

// cumple Manual 7 §8: chat inicia el agente conversacional
// cumple Manual 2 §12: contratos requiere/garantiza
funcion cmd_chat(modelo: texto) -> entero:
    requiere:
        verdadero
    garantiza:
        resultado == 0 o resultado == 1
    escribir_linea("=== OpenSyn: Modo Chat ===")
    escribir_linea("")

    si modelo == "" o modelo == "chat":
        modelo = "modelo_synapse.gguf"

    si no existe_archivo(modelo):
        escribir_linea(concat("  [!] Modelo no encontrado: ", modelo))
        escribir_linea("  [!] Descarga un modelo GGUF y colocalo como 'modelo_synapse.gguf'")
        retornar 1

    ctx = _syn_modelo_cargar(modelo)
    si ctx == nulo:
        escribir_linea("  [Error] No se pudo cargar el modelo")
        retornar 1

    escribir_linea("  [OK] Modelo cargado. Escribe 'salir' para terminar.")
    escribir_linea("")

    // Loop de chat simple
    temp = 0.7
    top_p = 0.9
    mientras verdadero:
        prompt = leer_linea()
        si prompt == "salir":
            _syn_modelo_cerrar(ctx)
            retornar 0
        si prompt == "":
            escribir_linea("")
            // skip empty input

        respuesta = generar_texto(ctx, prompt, 256, temp, 40, top_p)
        escribir_linea(respuesta)

    _syn_modelo_cerrar(ctx)
    retornar 0

// cumple Manual 7 §8: explain usa IA para explicar codigo
// cumple Manual 2 §12: contratos requiere/garantiza
funcion cmd_explain(ruta: texto) -> entero:
    requiere:
        verdadero
    garantiza:
        resultado == 0 o resultado == 1
    escribir_linea("=== OpenSyn: Explicacion de Codigo ===")
    escribir_linea("")

    si ruta == "":
        escribir_linea("  Uso: opensyn explain <archivo.syn>")
        retornar 1

    fuente = leer_archivo(ruta)
    si fuente == "":
        escribir_linea(concat("  [Error] No se pudo leer: ", ruta))
        retornar 1

    ctx = _syn_modelo_cargar("modelo_synapse.gguf")
    si ctx == nulo:
        escribir_linea("  [Error] Modelo modelo_synapse.gguf no encontrado")
        retornar 1

    prompt = concat("Explica el siguiente codigo Synapse:\n\n", fuente)
    escribir_linea("[Oraculo] Analizando codigo...")
    escribir_linea("")

    temp_exp = 0.3
    top_p_exp = 0.9
    explicacion = generar_texto(ctx, prompt, 512, temp_exp, 40, top_p_exp)
    escribir_linea(explicacion)

    _syn_modelo_cerrar(ctx)
    retornar 0

// cumple Manual 7 §8: generate usa IA para generar codigo nuevo
// cumple Manual 2 §12: contratos requiere/garantiza
funcion cmd_generate(instruccion: texto) -> entero:
    requiere:
        verdadero
    garantiza:
        resultado == 0 o resultado == 1
    escribir_linea("=== OpenSyn: Generacion de Codigo ===")
    escribir_linea("")

    si instruccion == "":
        escribir_linea("  Uso: opensyn generate <instruccion>")
        retornar 1

    ctx = _syn_modelo_cargar("modelo_synapse.gguf")
    si ctx == nulo:
        escribir_linea("  [Error] Modelo modelo_synapse.gguf no encontrado")
        retornar 1

    codigo = generar_codigo(ctx, instruccion, 3)
    _syn_modelo_cerrar(ctx)

    escribir_linea("")
    si codigo != "":
        escribir_linea("  [OK] Codigo generado y compilado.")
        res = escribir_archivo("generado.syn", codigo)
        si res == 0:
            escribir_linea("  [OK] Guardado en 'generado.syn'")
        retornar 0

    escribir_linea("  [Error] No se pudo generar codigo valido en 3 intentos.")
    retornar 1

// --- Punto de entrada principal ---

funcion principal() -> entero:
    escribir_linea("=== OpenSyn v1.1.0 — Orquestador Autonomo ===")
    escribir_linea("")

    // cumple Manual 7 §8: agente conversacional con capacidades de codigo
    // Routing de subcommands
    si _argc() >= 2:
        comando = _argv(1)

        si comando == "status":
            retornar cmd_status()

        si comando == "chat":
            retornar cmd_chat(_argv(2))

        si comando == "explain":
            retornar cmd_explain(_argv(2))

        si comando == "generate":
            retornar cmd_generate(_argv(2))

    // Leer configuracion existente
    modo = leer_modo_config()

    si modo == "":
        // Primera ejecucion: mostrar menu de bienvenida
        opcion = mostrar_menu_bienvenida()

        si opcion == "2":
            guardar_modo_config("verdadero")
            escribir_linea("")
            escribir_linea("  [OK] Preferencia guardada: Modo Oraculo")
            retornar modo_oraculo()

        guardar_modo_config("falso")
        escribir_linea("")
        escribir_linea("  [OK] Preferencia guardada: Modo Lenguaje Puro")
        escribir_linea("  [OK] Synapse funcionara como compilador standalone.")
        escribir_linea("  [OK] Para cambiar de modo, elimina .synapse_config")
        escribir_linea("       y ejecuta opensyn nuevamente.")
        escribir_linea("")
        retornar modo_compilador()

    si modo == "oraculo":
        escribir_linea("  [OK] Modo: Oraculo (IA Local)")
        escribir_linea("  [OK] Para cambiar: elimina .synapse_config y re-ejecuta")
        escribir_linea("")
        retornar modo_oraculo()

    // modo == "compilador"
    escribir_linea("  [OK] Modo: Lenguaje Puro")
    escribir_linea("  [OK] Para cambiar: elimina .synapse_config y re-ejecuta")
    escribir_linea("")
    retornar modo_compilador()
