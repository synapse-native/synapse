externo funcion _syn_capturar_comando(cmd: texto) -> texto
// cumple Manual 2 §12: builder incremental (evita el aliasing de concat en comandos largos)
externo funcion _syn_texto_builder_crear() -> entero
externo funcion _syn_texto_builder_anexar(id: entero, frag: texto) -> nulo
externo funcion _syn_texto_builder_construir(id: entero) -> texto
externo funcion _syn_texto_builder_liberar(id: entero) -> nulo
// --- Consola real + ANSI (Manual 9 §2.5: banner/prompt estilo OpenCode) ---
externo funcion _syn_es_consola() -> entero
externo funcion _syn_ansi(sgr: entero) -> texto
// --- TUI pantalla completa (Manual 7 1.1/8 + Manual 9 2.5) ---
externo funcion _syn_tui_iniciar() -> entero
externo funcion _syn_tui_finalizar() -> entero
externo funcion _syn_tui_repintar(modelo: texto) -> nulo
