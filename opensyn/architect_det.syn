#lang: es
// opensyn/architect_det.syn - Architect determinista: DFS invertido + ciclos
// cumple Manual 6 §1.1: grafo construido desde el AST canonico SemNodo[]
// cumple Manual 2 §5.1: contratos requiere/garantiza en funciones publicas
// Referencia funcional Manual FASE 32 §4.4: analisis de impacto sin LLM, DFS invertido + Tarjan
// Referencia funcional Manual FASE 32 §4.6: impacto directo/indirecto y deteccion de ciclos O(V+E)

importar std.texto
importar nucleo.grafo_conocimiento

// ============================================================
// ESTRUCTURAS
// ============================================================

estructura NodoAfectado:
    id: texto
    archivo: texto
    distancia: entero
    tipo_relacion: texto

estructura ContratoCritico:
    nodo_id: texto
    razon: texto
    nivel_riesgo: texto

estructura Ciclo:
    nodos: Lista<texto>
    longitud: entero

estructura MetricasImpacto:
    total_afectados: entero
    profundidad_maxima: entero
    contratos_criticos: entero
    ciclos_potenciales: entero

// H-R207-1: codegen emite campos ADT anidados como puntero; se aplana
// MetricasImpacto en AnalisisImpacto para evitar puntero colgante.
estructura AnalisisImpacto:
    nodos_afectados: Lista<NodoAfectado>
    contratos_criticos: Lista<ContratoCritico>
    ciclos: Lista<Ciclo>
    metricas_total_afectados: entero
    metricas_profundidad_maxima: entero
    metricas_contratos_criticos: entero
    metricas_ciclos_potenciales: entero

estructura DFSEntrada:
    id: texto
    archivo: texto
    distancia: entero
    tipo: texto

// ============================================================
// ANALISIS DE IMPACTO COMPLETO
// ============================================================

// Referencia funcional Manual FASE 32 §4.4: impacto directo/indirecto
funcion analizar_impacto_completo(archivo: texto, grafo: GrafoProyecto) -> AnalisisImpacto:
    requiere:
        longitud(archivo) > 0
    garantiza:
        _resultado_.metricas_total_afectados >= 0
    let nodos_afectados = Lista<NodoAfectado>()
    let contratos_criticos = Lista<ContratoCritico>()
    let ciclos_detectados = Lista<Ciclo>()
    let ids_afectados = Mapa<texto, booleano>()

    para nodo en grafo.nodos:
        si nodo.archivo == archivo:
            // DFS invertido: nodos que dependen de este nodo.
            let dependientes = dfs_invertido(nodo.id, grafo)
            para dep en dependientes:
                si ids_afectados.contiene(dep.id) == falso:
                    ids_afectados.poner(dep.id, verdadero)
                    nodos_afectados.agregar(NodoAfectado(
                        dep.id,
                        dep.archivo,
                        dep.distancia,
                        "dependiente"
                    ))

            // Contratos criticos: APIs publicas con mas de 5 dependientes.
            si nodo.num_dependientes > 5:
                contratos_criticos.agregar(ContratoCritico(
                    nodo.id,
                    "API publica usada por " + a_texto(nodo.num_dependientes) + " modulos",
                    nodo.nivel_riesgo
                ))

            // Ciclos que contienen este nodo.
            let ciclo = detectar_ciclo_tarjan(nodo.id, grafo)
            si ciclo.longitud > 0:
                ciclos_detectados.agregar(ciclo)

    let max_prof = 0
    para afectado en nodos_afectados:
        si afectado.distancia > max_prof:
            max_prof = afectado.distancia

    retornar AnalisisImpacto(
        nodos_afectados,
        contratos_criticos,
        ciclos_detectados,
        longitud(nodos_afectados),
        max_prof,
        longitud(contratos_criticos),
        longitud(ciclos_detectados)
    )

// ============================================================
// DFS INVERTIDO - recorrer dependientes
// ============================================================

// Referencia funcional Manual FASE 32 §4.4: DFS sobre aristas invertidas
funcion dfs_invertido(id_inicio: texto, grafo: GrafoProyecto) -> Lista<DFSEntrada>:
    requiere:
        longitud(id_inicio) > 0
    garantiza:
        longitud(_resultado_) >= 0
    let visitados = Mapa<texto, booleano>()
    let distancias = Mapa<texto, entero>()
    let resultados = Lista<DFSEntrada>()
    let pila_ids = Lista<texto>()
    pila_ids.agregar(id_inicio)
    distancias.poner(id_inicio, 0)

    mientras longitud(pila_ids) > 0:
        let actual = elemento_texto(pila_ids, longitud(pila_ids) - 1)
        pila_ids.eliminar(longitud(pila_ids) - 1)
        si visitados.contiene(actual) == falso:
            visitados.poner(actual, verdadero)
            let dist = distancias[actual]
            para arista en grafo.aristas:
                si arista.destino_id == actual:
                    let dep_id = arista.origen_id
                    si dep_id != id_inicio:
                        si visitados.contiene(dep_id) == falso:
                            resultados.agregar(DFSEntrada(
                                dep_id,
                                archivo_de_nodo(grafo, dep_id),
                                dist + 1,
                                arista.tipo
                            ))
                            distancias.poner(dep_id, dist + 1)
                            pila_ids.agregar(dep_id)
    retornar resultados

// ============================================================
// DETECCION DE CICLOS - Tarjan simplificado para el nodo de inicio
// ============================================================

// Referencia funcional Manual FASE 32 §4.4: ciclo que contiene id_inicio
funcion detectar_ciclo_tarjan(id_inicio: texto, grafo: GrafoProyecto) -> Ciclo:
    requiere:
        longitud(id_inicio) > 0
    garantiza:
        _resultado_.longitud >= 0
    let visitados = Mapa<texto, booleano>()
    let pila = Lista<texto>()
    let ciclo = buscar_ciclo_desde(id_inicio, id_inicio, grafo, visitados, pila)
    si longitud(ciclo) > 0:
        retornar Ciclo(ciclo, longitud(ciclo))
    let vacio = Lista<texto>()
    retornar Ciclo(vacio, 0)

// cumple Manual 2 §5.1: contrato de la busqueda recursiva de ciclo
funcion buscar_ciclo_desde(
    inicio: texto,
    actual: texto,
    grafo: GrafoProyecto,
    visitados: Mapa<texto, booleano>,
    pila: Lista<texto>
) -> Lista<texto>:
    requiere:
        longitud(inicio) > 0 y longitud(actual) > 0
    garantiza:
        longitud(_resultado_) >= 0
    visitados.poner(actual, verdadero)
    pila.agregar(actual)
    para arista en grafo.aristas:
        si arista.origen_id == actual:
            let vecino = arista.destino_id
            si vecino == inicio:
                retornar copiar_lista_texto(pila)
            si visitados.contiene(vecino) == falso:
                let encontrado = buscar_ciclo_desde(inicio, vecino, grafo, visitados, pila)
                si longitud(encontrado) > 0:
                    retornar encontrado
    pila.eliminar(longitud(pila) - 1)
    retornar Lista<texto>()

// ============================================================
// AUXILIARES
// ============================================================

// cumple Manual 6 §1.1: el archivo se obtiene del nodo canonico del grafo
funcion archivo_de_nodo(grafo: GrafoProyecto, id_nodo: texto) -> texto:
    requiere:
        longitud(id_nodo) > 0
    garantiza:
        longitud(_resultado_) >= 0
    para nodo en grafo.nodos:
        si nodo.id == id_nodo:
            retornar nodo.archivo
    retornar extraer_archivo(id_nodo)

// cumple Manual 6 §1.1: fallback determinista para IDs "archivo.funcion"
funcion extraer_archivo(id_nodo: texto) -> texto:
    requiere:
        longitud(id_nodo) > 0
    garantiza:
        longitud(_resultado_) > 0
    let ultimo_punto = -1
    let i = 0
    mientras i < longitud(id_nodo):
        si subcadena(id_nodo, i, 1) == ".":
            ultimo_punto = i
        i = i + 1
    si ultimo_punto > 0:
        retornar subcadena(id_nodo, 0, ultimo_punto)
    retornar id_nodo

// cumple Manual 2 §5.1: lectura de pila sin exponer el indice al analizador
funcion elemento_texto(lista: Lista<texto>, indice: entero) -> texto:
    requiere:
        indice >= 0
    garantiza:
        longitud(_resultado_) >= 0
    let i = 0
    para valor en lista:
        si i == indice:
            retornar valor
        i = i + 1
    retornar ""

// cumple Manual 2 §5.1: copia de camino para no devolver la pila mutable
funcion copiar_lista_texto(lista: Lista<texto>) -> Lista<texto>:
    requiere:
        longitud(lista) >= 0
    garantiza:
        longitud(_resultado_) == longitud(lista)
    let copia = Lista<texto>()
    para valor en lista:
        copia.agregar(valor)
    retornar copia
