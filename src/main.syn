#lang: es
// main.syn — Punto de entrada del compilador Synapse
// Fase 9: La Singularidad

importar std.toml
importar std.io
importar std.err

funcion _leer_archivo(ruta: texto) -> texto:
    f = abrir(ruta, "r")
    resultado = leer(f)
    cerrar(->f)
    retornar resultado

funcion _campo_str(nodo: NodoToml, clave: texto) -> texto:
    campo = obtener_campo(nodo, clave)
    si campo.tipo == 2:
        retornar campo.valor_str
    retornar ""

funcion principal() -> nulo:
    escribir_linea("Synapse v2.0 — Auto-hospedado")
    escribir_linea("Cargando manifiesto axon.toml...")

    toml_str = _leer_archivo("axon.toml")
    doc = desde_texto(toml_str)

    proy = obtener_campo(doc, "proyecto")
    nombre = _campo_str(proy, "nombre")
    version = _campo_str(proy, "version")
    entrada = _campo_str(proy, "punto_entrada")

    escribir_linea("Proyecto: " + nombre + " v" + version)
    escribir_linea("Entrada: " + entrada)
    escribir_linea("[OK] Manifiesto cargado correctamente")
